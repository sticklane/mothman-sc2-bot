  "correctness_findings": [
    {
      "id": "correctness_finding_1_ecc_exceptional_points",
      "source_refs": [
        "MicrosoftQuantumCrypto/EllipticCurves.qs:390-433,452-492,720-814",
        "MicrosoftQuantumCrypto/Tests/EllipticCurveTests.qs:147,162,638",
        "qualtran/bloqs/cryptography/ecc/ec_add.py:196-225,665-695,830-870"
      ],
      "hazard": "Distinct-point chord addition fails on P=O, P=Q, P=-Q, and the subtle reverse-uncomputation zero-divisor P+Q=-Q (`x3 = x2`), while Qualtran's Litinski ECAdd required 5 multi-controlled-zero bugfixes (arXiv:2506.03318) and 10n+2w+5 qubits, and QuantumEllipticCurves' SignedWindow table still includes O at index 0.",
      "lakefillq_fix": "Pre-scaled nonzero signed odd-window recoding (`+-1, +-3, ..., +-(2^w-1)`, `0` identity table entries) paired with static trajectory-verified offset `S_init = s0*G + [(2^{Mw}-1)*2^{-1} mod l]*P` (or explicit 1-ancilla exceptional guard on full-order small test curves)."
    },
    {
      "id": "correctness_finding_2_kaliski_divstep_zero_input",
      "source_refs": [
        "MicrosoftQuantumCrypto/ModularArithmetic.qs:2177-2229",
        "qualtran/bloqs/mod_arithmetic/mod_division.py:571-596,661"
      ],
      "hazard": "On x=0 (`x2 - x1 = 0`), Kaliski binary GCD stalls at `(u,v,r,s)=(p,0,0,1)`, so terminal `u ^= 1; s ^= p` leaves dirty non-zero ancillas `u = s = p - 1 != 0` unless guarded; Qualtran's unpebbled implementation also retains 4n junk qubits.",
      "lakefillq_fix": "Single-bit `is_zero` conditional `(u <-> s)` terminal swap + total zero-extension `0^{-1} |-> 0` over packed `(u,r)/(v,s)` zippers with s=4 Kralovic `Jump-16` pebbles (742 Bernstein-Yang divstep bound at n=256)."
    },
    {
      "id": "correctness_finding_3_coset_and_rns_crt_wraparound",
      "source_refs": [
        "src/facto/algorithm/prep/_execution_config.py:183-190",
        "src/facto/algorithm/estimates/_cost_config.py:37-58",
        "src/quantumthreattracker/algorithms/rsa/chevignard_utils/estimations.py:49-54,212-254"
      ],
      "hazard": "Insufficient coset carry runway `c_pad` (`2^{c_pad} <= K_steps`), under-sized RNS dynamic range `L = prod(p_i) < N^m`, or heuristic `0.65*l` multi-sum truncation causes silent wraparound that corrupts the QFT period.",
      "lakefillq_fix": "Static dependent-type runway checker enforcing `c_pad = 34` for RSA-2048 (`504,300` steps) and `c_pad = 36` (`+2` bits for 4x inner steps = `2,015,560`) for RSA-4096, plus verified `L >= N^m` and AM-GM mask-bit validation."
    }
  ],
  "optimization_findings": [
    {
      "id": "optimization_finding_1_signed_odd_window_plus_law_u4",
      "mechanism": "Nonzero signed odd-window recoding (`2*c - (2^w - 1)`) halves QROAM table entries from `2^w` to `2^{w-1}` using `w-1` zero-TempAND CNOTs + controlled `y -> p - y` negation, enabling `w = 5` on ECC-256 with the exact same `16`-entry table as unsigned `w = 4` (`128 -> 112` point additions) plus `Law U4` Berry-Gidney `M_X` 1-bit phase-table uncomputation (`21` QROAM TempANDs/window vs `300`)."
    },
    {
      "id": "optimization_finding_2_constant_modulus_ghz_lookup_coset_fusion",
      "mechanism": "Fuses classical modulus conditional addition `+(ctrl ? p : 0)` (`ghz_lookup`) and `mx_rz()` expected-half wraparound uncomputation (`_detailed_example_code.py:197-202`) with signed Booth `512`-entry (`2^{5+4}`) lookup tables across ECC-256, RSA-2048, and RSA-4096."
    },
    {
      "id": "optimization_finding_3_distributed_complete_projective_and_zero_carry_qrns",
      "mechanism": "Eliminates cross-QPU `divstep` barriers in distributed ECC-256 (`M* = 4` on `Q_cap = 400 Q`) via Renes-Costello-Batina [Eurocrypt 2016] complete projective `(X : Y : Z)` addition (`501,984 -> 9,744` logical ebits, `51.52x` reduction) and eliminates cross-QPU carry ebits in distributed RSA-2048 (`M* = 6`, `31,140` logical ebits, `0` carry ebits) and RSA-4096 (`M* = 8`, `87,192` logical ebits, `0` carry ebits) via partitioned `0`-carry `QRNS` + `Law U4` GHZ `M_X` 0-ebit cat-disentangling."
    }
  ],
