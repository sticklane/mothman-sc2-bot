       (define links-new (append links (list pair)))
       (define uw-new (list-set uwires t `(uwire QFree ,ac ,zt)))
       (values 0 1 1 links-new uw-new ok?)]
       [`(g-cat-disentangle ,c ,t)
        (match-define `(uwire ,mc ,ac ,zc) (list-ref uwires c))
        (match-define `(uwire ,mt ,at ,zt) (list-ref uwires t))
