;; -----------------------------------------------------------------------------
;; S47, Pass M23 & Issue F67 (25,000 trials):
;; Inner-Loop FPGA/ASIC Privilege-Boundary Violation (`Pass M23`)
;; - Issue F67: A cloud user or mid-loop runtime program (`'user-cloud-outer-loop` or
;;   `'coprocessor-mid-loop`) attempts to inject or reconfigure a Loop 1
;;   `'provider-inner-loop-blueprint` (`240ns` CMOS ASIC / `273ns` GARI / `506ns` XLS /
;;   `550ns` NN-FPGA) bitstream at runtime, violating hardware-provider cryostat/controller
;;   privilege isolation and deterministic 240–550ns QEC timing!
;; - Also tests `coreqds-well-typed?` rejecting `@provider-inner-loop-blueprint` AST nodes
;;   inside `fold-tree` / `ec-fault-tolerant-lift` when compiled for user/mid-loop privilege!
;; -----------------------------------------------------------------------------
(define (fuzz-find-f67-inner-loop-fpga-asic-privilege-boundary-violation-pass-m23 [trials 25000])
  (define m23-privilege-placement-verified 0)
  (define unprivileged-inner-loop-mutant-caught 0)
  (define coreqds-combinator-privilege-check-verified 0)

  (for ([i (in-range trials)])
    (define h (bitwise-and (+ (* i 2654435761) 1013904223) #x7fffffff))
    (define caller-tier
      (if (zero? (bitwise-and h 1)) 'user-cloud-outer-loop 'coprocessor-mid-loop))
    (define code-d (+ 3 (* 2 (bitwise-and (arithmetic-shift h -1) 3))))
    (define var-idx (bitwise-and (arithmetic-shift h -3) 1023))

    ;; 1. Pass M23 & S47 demote unprivileged inner-loop requests to coprocessor-mid-loop!
    (define m23-wt (pass-m23-privilege-tier-placement-guard caller-tier 'provider-inner-loop-blueprint #t))
    (define s47-wt (s47-privilege-tier-loop1-to-loop3-guard caller-tier 'provider-inner-loop-blueprint #t))
    (when (and (hash-ref m23-wt 'verified?)
               (not (hash-ref m23-wt 'privilege-boundary-violation?))
               (eq? (hash-ref m23-wt 'effective-loop-tier) 'coprocessor-mid-loop)
               (hash-ref s47-wt 'verified?))
      (set! m23-privilege-placement-verified (add1 m23-privilege-placement-verified)))

    ;; 2. Mutant F67: unguarded placement allows user/coprocessor caller to target Loop 1 inner-loop blueprint!
