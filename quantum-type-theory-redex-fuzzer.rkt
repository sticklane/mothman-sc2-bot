;; S78, Pass M44, OQP-45, TODAY-23 & Issue F98 (25,000 procedural trials):
;; Information-Theoretic Circuit Lower-Bound Optimality & Peephole Irreducibility
;; (`S78`, `Pass M44`, `OQP-45`, `TODAY-23`)
;; -----------------------------------------------------------------------------
(define (fuzz-find-f98-circuit-lower-bound-optimality-and-oqp45-audit [trials 25000])
  (define lower-bound-optimality-verified 0)
  (define bloated-unoptimized-mutant-caught 0)
  (define oqp45-and-today23-verified 0)
  (define oqp45 (oqp45-translation-validated-peephole-optimal-qsvt-grover #t))
  (define today23 (TranslationValidated_Optimal_CoreQDS2_16q 16))
  (define base-ok? (and (hash-ref oqp45 'verified?) (hash-ref today23 'verified?)))

  (for ([i (in-range trials)])
    (define h (bitwise-and (+ (* i 2654435761) 791234567) #x7fffffff))
    (define w0 (modulo h 4))
    (define w1 (+ 4 (modulo (arithmetic-shift h -3) 4)))
    (define w2 (+ 8 (modulo (arithmetic-shift h -6) 4)))
    (define ast
      (list 'within-apply
            (focus-zipper 'left (list 'var w0))
            (adt-construct 'OptimalNode
              (focus-zipper 'right (list 'var w1)))))
    (define raw-gates (compile-coreqds-to-revir ast))
    (define opt-gates (optimize-revir-netlist raw-gates))
    (define lb-res (verify-circuit-lower-bound-optimality ast raw-gates opt-gates))

    ;; 1. Verify optimized circuit satisfies information-theoretic lower bound & irreducibility!
    (when (and (hash-ref lb-res 'verified?)
               (hash-ref lb-res 'irreducible-optimal?)
               (hash-ref lb-res 'kak-su4-3cx-bound-satisfied?)
               (hash-ref lb-res 'toffoli-multiplicative-bound-satisfied?))
      (set! lower-bound-optimality-verified (add1 lower-bound-optimality-verified)))

    ;; 2. Mutant F98: injecting redundant H-H pair violates peephole irreducibility in lower-bound check!
    (define bloated-gates
      (append (list (list 'gate 'H (list w2) 0)
                    (list 'gate 'H (list w2) 0))
              opt-gates))
    (define lb-mut (verify-circuit-lower-bound-optimality ast raw-gates bloated-gates))
    (when (not (hash-ref lb-mut 'verified?))
      (set! bloated-unoptimized-mutant-caught (add1 bloated-unoptimized-mutant-caught)))

    ;; 3. Verify OQP-45 & TODAY-23 (16q)
    (when base-ok?
      (set! oqp45-and-today23-verified (add1 oqp45-and-today23-verified))))

  (hash 'issue-id 'F98-circuit-lower-bound-optimality-and-oqp45-audit
        'suite-id 'S78-PassM44-OQP45-TODAY23-Circuit-Lower-Bound-Optimality
        'trials trials
        'lower-bound-optimality-verified lower-bound-optimality-verified
        'bloated-unoptimized-mutant-caught bloated-unoptimized-mutant-caught
        'oqp45-and-today23-verified oqp45-and-today23-verified
        'today23-physical-qubits 16
        'verified? (and (= lower-bound-optimality-verified trials)
                        (= bloated-unoptimized-mutant-caught trials)
                        (= oqp45-and-today23-verified trials))))

