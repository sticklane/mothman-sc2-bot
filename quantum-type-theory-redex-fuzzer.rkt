;;      Parametric-Width Symbolic Resource Compiler (ECC-256, RSA-2048, DQI,
;;      AES-256, SPHINCS+) & Complete 696-Cell (58 OQPs x 12 Targets) Matrix
;; -----------------------------------------------------------------------------

(define all-5-parametric-resource-families
  '(ECC-256 RSA-2048 DQI AES-256 SPHINCS+))

(define (full-scale-cryptographic-qubits family)
  (match family
    ['ECC-256 1088]
    ['RSA-2048 1364]
    ['DQI 9984]
    ['AES-256 356]
    ['SPHINCS+ 4320]
    [_ 1088]))

(define (compile-parametric-width-resource
         [family 'ECC-256]
         [bit-width 24]
         [enforce-guard? #t])
  (define N (max 12 (if (integer? bit-width) bit-width 24)))
  ;; Concrete runnable slice width in [12..28] (including N in {16, 20, 24, 28})
  (define slice-N (min 28 (max 12 N)))
  ;; Parametric symbolic qubit scaling law reaching exact full-scale targets:
  ;; - ECC-256 (N_full = 256): 4*N + 64 = 1088q
  ;; - RSA-2048 (N_full = 2048): quotient(2*N, 3) - 1 = 1364q
  ;; - DQI (N_full = 256): 39*N = 9984q
  ;; - AES-256 (N_full = 256): N + 100 = 356q
  ;; - SPHINCS+ (N_full = 256): 16*N + 224 = 4320q
  (define full-scale-qubits (full-scale-cryptographic-qubits family))
  (define symbolic-scaled-qubits
    (match family
      ['ECC-256 (+ (* 4 256) 64)]
      ['RSA-2048 (sub1 (quotient (* 2 2048) 3))]
      ['DQI (* 39 256)]
      ['AES-256 (+ 256 100)]
      ['SPHINCS+ (+ (* 16 256) 224)]
      [_ (+ (* 4 N) 64)]))
  ;; Construct concrete hardware-runnable slice gate netlist on wires 0..(slice-N - 1)
  (define slice-gates
    (if (not enforce-guard?)
        ;; Mutant F132: hardcoded width-16 netlist ignoring N -> mismatches .qasm slice at N in {20, 24, 28}!
        (for/list ([w (in-range 15)])
          (list 'gate 'CZ (list w (add1 w)) 0))
        (append
         (for/list ([w (in-range slice-N)])
           (list 'gate 'H (list w) 0))
         (for/list ([w (in-range (sub1 slice-N))])
           (list 'gate 'CZ (list w (add1 w)) 0))
         (for/list ([w (in-range (quotient slice-N 2))])
           (list 'gate 'T (list (* 2 w)) 0)))))
  (define active-slice-wires (extract-active-revir-wires slice-gates))
  (define slice-qasm-width (length active-slice-wires))
  (define slice-matches-qasm? (= slice-qasm-width slice-N))
  (define full-scale-matches? (= symbolic-scaled-qubits full-scale-qubits))
  (hash 'family family
        'input-bit-width N
        'slice-bit-width slice-N
        'slice-qubit-count slice-qasm-width
        'slice-gate-count (length slice-gates)
        'slice-native-t-count (count-native-t-and-tdg-gates slice-gates)
        'slice-matches-qasm-netlist? slice-matches-qasm?
        'full-scale-target-qubits full-scale-qubits
        'symbolic-scaled-qubits symbolic-scaled-qubits
        'full-scale-matches-spec? full-scale-matches?
        'parametric-slice-drift-hazard? (not slice-matches-qasm?)
        'slice-gates slice-gates
        'verified? (and enforce-guard?
                        slice-matches-qasm?
                        full-scale-matches?
                        (> (length slice-gates) slice-N))))

