(define (oqp27-cudaq-opnic-midloop-pauli-frame round-trip-us transmon-t2-us next-gate-clifford? [async-pauli-frame? #t])
  (define safe-rtt (max 2 round-trip-us))
  (define safe-t2 (max 50 transmon-t2-us))
  ;; Blocking physical qubits for safe-rtt us during Clifford suffixes causes T2 idle stall;
  ;; async Pauli-frame tracking updates the classical frame in 0ns physical stall!
  (define eff-physical-stall-us
    (if (and async-pauli-frame? next-gate-clifford?)
        0
        safe-rtt))
  (define t2-decoherence-stall? (> eff-physical-stall-us 0))
  (hash 'oqp-id 'OQP-27-CudaQ-OPNIC-MidLoop-Pauli-Frame
        'loop-tier 'coprocessor-mid-loop
        'coprocessor-rtt-us safe-rtt
        'transmon-t2-us safe-t2
        'tensor-core-speedup-x 35
        'effective-physical-stall-us eff-physical-stall-us
        't2-decoherence-stall? t2-decoherence-stall?
        'verified? (not t2-decoherence-stall?)))

(define (oqp28-alphaqubit2-tpu-midloop-decoder code-distance [route-large-d-to-tpu? #t])
  (define safe-d (max 3 code-distance))
  ;; NN-FPGA (124ns raw / 550ns windowed) fits LUT budget only for d <= 5;
  ;; d in {7, 9, 11} must route to mid-loop TPU AlphaQubit 2!
  (define selected-backend
    (if (and (> safe-d 5) route-large-d-to-tpu?)
        'tpu-alphaqubit2-d11
        'fpga-550ns-nn-windowed))
  (define selected-tier
    (if (eq? selected-backend 'tpu-alphaqubit2-d11)
        'coprocessor-mid-loop
        'provider-inner-loop-blueprint))
  (define tier-info (execution-loop-privilege-tier selected-tier selected-backend safe-d #f))
  (define lut-overflow? (not (hash-ref tier-info 'verified?)))
  (hash 'oqp-id 'OQP-28-AlphaQubit2-TPU-MidLoop-Decoder
        'code-distance safe-d
        'selected-backend selected-backend
        'selected-loop-tier selected-tier
        'nn-fpga-lut-overflow? lut-overflow?
        'verified? (not lut-overflow?)))

(define (oqp29-provider-innerloop-240ns-asic-vs-273ns-gari dynamic-code-deformation? [auto-select-reconfigurable-fpga? #t])
  (define backend
    (if (and dynamic-code-deformation? auto-select-reconfigurable-fpga?)
        'fpga-273ns-gari
        'asic-240ns-collision-clustering))
  (define tier-info
    (execution-loop-privilege-tier 'provider-inner-loop-blueprint backend 5 dynamic-code-deformation?))
  (hash 'oqp-id 'OQP-29-Provider-InnerLoop-240ns-ASIC-vs-273ns-GARI
