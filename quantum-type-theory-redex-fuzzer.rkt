;; -----------------------------------------------------------------------------
;; Simplification S9: Certifying `IxQMonad -> VOQC -> Stim/BB-qLDPC` Compiler Pipeline
;; (`compile-ixqmonad-to-stim-bb`):
;;   1. Desugars surface `IxQMonad` (`qdo`, `with-qfree`, `with-pebble-ckpt`) to `GradedCircuit`
;;   2. Runs certified commutator-checked `voqc-optimize-canonical`
;;   3. Verifies `Synthesize-Certified-Compiler-Grade` & `certified-compiler-restoration-law-holds?`
;;   4. Erases grades via `erase-to-netlist`
;;   5. Emits a deterministic `Stim` circuit (`QUBIT_COORDS`, `TICK`, `DETECTOR`,
;;      `DEPOLARIZE1`, `DEPOLARIZE2`) mapped onto the [[288, 12, 18]] Bivariate Bicycle torus!
;; -----------------------------------------------------------------------------
(define (gate->stim-lines g [noise-p 0.001])
  (match g
    [`(g-id) '()]
    [`(g-x ,w)
     (list (format "X ~a" w)
           (format "DEPOLARIZE1(~a) ~a" noise-p w))]
    [`(g-z ,w)
     (list (format "Z ~a" w)
           (format "DEPOLARIZE1(~a) ~a" noise-p w))]
    [`(g-h ,w)
     (list (format "H ~a" w)
           (format "DEPOLARIZE1(~a) ~a" noise-p w))]
    [`(g-cnot ,c ,t)
     (list (format "CX ~a ~a" c t)
           (format "DEPOLARIZE2(~a) ~a ~a" noise-p c t))]
    [`(g-cz ,c1 ,c2)
     (list (format "CZ ~a ~a" c1 c2)
           (format "DEPOLARIZE2(~a) ~a ~a" noise-p c1 c2))]
    [(or `(g-ccx ,c1 ,c2 ,t) `(g-compute-and ,c1 ,c2 ,t) `(g-and-compute ,c1 ,c2 ,t)
         `(g-rccx ,c1 ,c2 ,t) `(g-rccx-dag ,c1 ,c2 ,t))
     (list (format "# TOFFOLI_AND ~a ~a ~a" c1 c2 t)
           (format "CX ~a ~a" c2 t)
           (format "DEPOLARIZE2(~a) ~a ~a" noise-p c1 t))]
    [(or `(g-hmr-cz ,t ,c1 ,c2 ,_) `(g-hmr-cz ,t ,c1 ,c2))
     (list "TICK"
           (format "MX ~a" t)
           (format "CZ rec[-1] ~a" c1)
           (format "CZ rec[-1] ~a" c2))]
    [`(g-zone-shuttle ,w ,z)
     (list "TICK"
           (format "# SHUTTLE ~a ~a" w z))]
    [`(g-twirl-step ,w ,pol)
     (if (eq? pol 'TwirlOdd)
         (list (format "X ~a" w)
               (format "DEPOLARIZE1(~a) ~a" noise-p w))
         (list "TICK"))]
    [`(g-tele-cnot ,c ,t)
     (list "TICK"
           (format "CX ~a ~a" c t)
           (format "DEPOLARIZE2(~a) ~a ~a" noise-p c t))]
    [`(g-cat-entangle ,c ,t)
     (list "TICK"
           (format "CX ~a ~a" c t)
           (format "DEPOLARIZE2(~a) ~a ~a" noise-p c t))]
    [`(g-cat-disentangle ,c ,t)
     (list "TICK"
           (format "MX ~a" t)
           (format "CZ rec[-1] ~a" c))]
    [`(g-skew-add-cs ,w)
     (list (format "X ~a" w)
           (format "DEPOLARIZE1(~a) ~a" noise-p w))]
    [`(g-consolidate-cs ,w)
     (list "TICK"
           (format "DEPOLARIZE1(~a) ~a" noise-p w))]
    [`(g-cmp-gt ,c1 ,c2 ,t)
     (list (format "CX ~a ~a" c1 t)
           (format "DEPOLARIZE2(~a) ~a ~a" noise-p c1 c2))]
    [`(g-cswap ,c ,c1 ,c2)
     (list (format "CX ~a ~a" c1 c2)
           (format "DEPOLARIZE2(~a) ~a ~a" noise-p c c1))]
    [`(g-fpga-feedforward ,w ,d)
     (list "TICK"
           (format "# FPGA_FEEDFORWARD_NS ~a ~a" w d))]
    [`(g-qec-barrier)
     (list "TICK")]
    [`(g-stim-detector ,w)
     (list (format "MR ~a" w)
           (format "DETECTOR(~a, 0) rec[-1]" w))]
    [`(g-css-round-begin ,mode)
     (list "TICK"
           (format "# CSS_ROUND_BEGIN ~a" mode))]
    [`(g-css-round-end ,mode)
     (list "TICK"
           (format "# CSS_ROUND_END ~a" mode))]
    [`(g-bb-torus-shift ,a ,b)
     (list "TICK"
           (format "# BB_288_12_18_TORUS_SHIFT ~a ~a" a b))]
    [`(g-kuperberg-collimate ,w1 ,r1 ,w2 ,r2)
     (list "TICK"
           (format "# KUPERBERG_COLLIMATE ~a (rank ~a) ~a (rank ~a)" w1 r1 w2 r2)
           (format "CX ~a ~a" w1 w2))]
    [`(g-inject-fault ,w ,k)
     (list (format "# INJECT_FAULT wire=~a fault=e_~a" w k)
           (format "X_ERROR(~a) ~a" noise-p w))]
    [`(g-flag-clear ,w1 ,w2)
     (list (format "MR ~a" w2)
           (format "DETECTOR(~a, 0) rec[-1]" w2)
           (format "R ~a" w1))]
    [`(g-cultivate-step ,w ,r)
     (list "TICK"
           (format "# CULTIVATE_STEP wire=~a rank=~a" w r))]
    [`(g-inject-magic-t ,w ,r)
     (list "TICK"
           (format "# INJECT_MAGIC_T wire=~a rank=~a" w r)
           (format "S ~a" w))]
    [`(g-ppm-bus ,l ,r)
     (list "TICK"
           (format "# PPM_BUS [~a..~a]" l r)
           (format "MXX ~a ~a" l r))]
    [`(g-gauge-open ,w)
     (list "TICK"
           (format "# GAUGE_OPEN ~a" w))]
    [`(g-gauge-fix ,w)
     (list "TICK"
           (format "# GAUGE_FIX ~a" w))]
    [`(g-code-switch-transversal-t ,w)
     (list "TICK"
           (format "# CODE_SWITCH_TRANSVERSAL_T ~a" w))]
    [`(g-native-ccz ,c1 ,c2 ,c3)
     (list (format "# NATIVE_CCZ ~a ~a ~a" c1 c2 c3)
           (format "CZ ~a ~a" c1 c2))]
    [`(g-native-iswap ,q1 ,q2)
     (list (format "ISWAP ~a ~a" q1 q2)
           (format "DEPOLARIZE2(~a) ~a ~a" noise-p q1 q2))]
    [`(g-rzz ,q1 ,q2 ,theta)
     (list (format "# RZZ(~a) ~a ~a" theta q1 q2)
           (format "DEPOLARIZE2(~a) ~a ~a" noise-p q1 q2))]
    [`(g-virtual-rz ,q ,theta)
     (list (format "# VIRTUAL_RZ(~a) ~a" theta q))]
    [`(g-meas ,kind ,q)
     (list (format "# MEAS ~a ~a" kind q)
           (if (eq? kind 'meas-mcmr-reuse)
               (format "MR ~a" q)
               (format "M ~a" q)))]
    [`(g-seq ,g1 ,g2)
     (append (gate->stim-lines g1 noise-p)
             (gate->stim-lines g2 noise-p))]))

(define (compile-ixqmonad-to-stim-bb surf-or-circ
                                     [init-anfs (initial-anf-env 4 '(3))]
                                     [init-zones (make-list 4 'EntanglingZone)]
                                     [aux-wires '(3)]
                                     [noise-p 0.001])
  (define raw-circ
    (if (surface-qterm? surf-or-circ)
        (desugar-qdo-raw surf-or-circ)
        surf-or-circ))
  (define opt-circ (voqc-optimize-canonical raw-circ))
  (define cert-grade (Synthesize-Certified-Compiler-Grade opt-circ init-anfs init-zones))
  (define cert-ok? (certified-compiler-restoration-law-holds? cert-grade init-anfs aux-wires))
  (define netlist (if cert-ok? (erase-to-netlist-raw opt-circ) '()))
  (define num-wires (length init-anfs))
  (define coord-lines
    (for/list ([w (in-range num-wires)])
      (format "QUBIT_COORDS(~a, ~a) ~a" (modulo w 12) (modulo (quotient w 12) 6) w)))
  (define body-lines
    (apply append (for/list ([g (in-list netlist)]) (gate->stim-lines g noise-p))))
  (define all-lines (append coord-lines (list "TICK") body-lines))
  (define stim-text (string-join all-lines "\n"))
  (hash 'desugared-circuit raw-circ
        'optimized-circuit opt-circ
        'certified-grade cert-grade
        'certified-ok? cert-ok?
        'erased-netlist netlist
        'stim-lines all-lines
        'stim-source stim-text
        'unoptimized-gate-count (circuit-gate-count raw-circ)
        'optimized-gate-count (circuit-gate-count opt-circ)))

;; -----------------------------------------------------------------------------
;; Simplification S10: SMT-LIB2 `QF_BV` & Symbolic F_2[x] Refinement Plugin Solver
;; (`emit-smtlib2-qfree-anf-obligation`, `discharge-refinement-plugin-vc`):
;; Translates the Canonical 5-Field Wire Law (S8) + `CSSRoundState` (F16) +
;; Stim Detector / Liquid Haskell / Gospel Subtyping VCs (F14-F15) into an
;; SMT-LIB2 `QF_BV` verification condition and discharges it via exact symbolic
;; polynomial normalization in F_2[x_0, ..., x_{n-1}].
;; -----------------------------------------------------------------------------
(define (anf-mono->smtlib2 m)
  (match m
    ['() "#b1"]
    [(list w) (format "x_~a" w)]
    [(cons w rest)
     (format "(bvand x_~a ~a)" w (anf-mono->smtlib2 rest))]))

(define (anf-poly->smtlib2 poly)
  (define norm (anf-normalize poly))
  (match norm
    ['() "#b0"]
    [(list m) (anf-mono->smtlib2 m)]
    [(cons m rest)
     (format "(bvxor ~a ~a)" (anf-mono->smtlib2 m) (anf-poly->smtlib2 rest))]))

(define (emit-smtlib2-qfree-anf-obligation certg init-anfs aux-wires)
  (match-define `(cert-grade (toffolis ,_) (depth ,_) (ebits ,_) (latency-ns ,lat)
                             (css-round ,css) (live-links ,links)
                             (wire-states ,cwires) (ok? ,ok?)) certg)
  (define num-wires (length init-anfs))
  (define decls
    (for/list ([w (in-range num-wires)])
      (format "(declare-const x_~a (_ BitVec 1))" w)))
  (define wire-deltas
    (for/list ([w (in-list aux-wires)])
      (define a (cwire-anf (list-ref cwires w)))
      (define ia (list-ref init-anfs w))
      (define delta (anf-xor a ia))
      (format "(= ~a #b0)" (anf-poly->smtlib2 delta))))
  (define tag-conjuncts
    (list (if ok? "true" "false")
          (if (eq? css 'CSSClosed) "true" "false")
          (if (null? links) "true" "false")
          (format "(<= ~a ~a)" lat qec-cycle-budget-ns)))
  (define full-invariant
    (format "(and ~a)"
            (string-join (append tag-conjuncts wire-deltas) " ")))
  (string-join
   (append
    (list "(set-logic QF_BV)"
          ";; Phase-4 Liquid Haskell / Gospel Refinement Plugin Verification Condition (S10)")
    decls
    (list (format "(assert (not ~a))" full-invariant)
          "(check-sat)"))
   "\n"))

(define (discharge-refinement-plugin-vc c
                                        [init-anfs (initial-anf-env 4 '(3))]
                                        [init-zones (make-list 4 'EntanglingZone)]
                                        [aux-wires '(3)])
  (define certg (Synthesize-Certified-Compiler-Grade c init-anfs init-zones))
  (define smt-query (emit-smtlib2-qfree-anf-obligation certg init-anfs aux-wires))
  (define valid? (certified-compiler-restoration-law-holds? certg init-anfs aux-wires))
  (hash 'smt-status (if valid? 'unsat-valid 'sat-counterexample)
        'vc-discharged? valid?
        'smtlib2-query smt-query
        'certified-grade certg))


;; =============================================================================
;; 5. Operational Semantics for All Intrinsic QDS Terms (eval-qds)
;; =============================================================================

;; 1. CanonicalSkewNum operational semantics (O(1) carry-free inc/dec)
(define (skew-tail->list tail [prev-rank 0])
  (match tail
    ['mt-tail '()]
    [`(cons-tail ,gap ,rest)
     (define r (+ prev-rank 1 gap))
     (cons r (skew-tail->list rest r))]))

(define (list->skew-tail ranks [prev-rank 0])
  (match ranks
    ['() 'mt-tail]
    [(cons r rest)
     (define gap (max 0 (- r prev-rank 1)))
     `(cons-tail ,gap ,(list->skew-tail rest r))]))

(define (canonical-skew->ranks s)
  (match s
    ['skew-zero '()]
    [`(skew-single ,r0 ,tail)
     (cons r0 (skew-tail->list tail r0))]
    [`(skew-double ,r0 ,tail)
     (list* r0 r0 (skew-tail->list tail r0))]))

(define (ranks->canonical-skew ranks)
  (match ranks
    ['() 'skew-zero]
    [(list r0) `(skew-single ,r0 mt-tail)]
    [(list* r0 r1 rest) #:when (= r0 r1)
     `(skew-double ,r0 ,(list->skew-tail rest r0))]
    [(cons r0 rest)
     `(skew-single ,r0 ,(list->skew-tail rest r0))]))

(define (canonical-skew-val s)
  (for/sum ([k (in-list (canonical-skew->ranks s))])
    (- (arithmetic-shift 1 (+ k 1)) 1)))

(define (canonical-skew-inc s)
  (match s
    ['skew-zero '(skew-single 0 mt-tail)]
    [`(skew-single ,r0 ,tail)
     (if (= r0 0)
         `(skew-double 0 ,tail)
         `(skew-single 0 (cons-tail ,(- r0 1) ,tail)))]
    [`(skew-double ,r0 ,tail)
     (match tail
       ['mt-tail `(skew-single ,(+ r0 1) mt-tail)]
       [`(cons-tail 0 ,rest) `(skew-double ,(+ r0 1) ,rest)]
       [`(cons-tail ,g ,rest) `(skew-single ,(+ r0 1) (cons-tail ,(- g 1) ,rest))])]))

(define (canonical-skew-dec s)
  (match s
    ['skew-zero 'skew-zero]
    [`(skew-double 0 ,tail)
     `(skew-single 0 ,tail)]
    [`(skew-double ,r0 ,tail) #:when (> r0 0)
     `(skew-double ,(- r0 1) (cons-tail 0 ,tail))]
    [`(skew-single 0 mt-tail) 'skew-zero]
    [`(skew-single 0 (cons-tail ,g ,rest))
     `(skew-single ,(+ g 1) ,rest)]
    [`(skew-single ,r0 ,tail) #:when (> r0 0)
     (define new-tail
       (match tail
         ['mt-tail 'mt-tail]
         [`(cons-tail ,g ,rest) `(cons-tail ,(+ g 1) ,rest)]))
     `(skew-double ,(- r0 1) ,new-tail)]))

;; 4. IntrinsicBraunTree operational semantics (O(log s) insert preserving 0 <= |L|-|R| <= 1)
(define (braun-size t)
  (match t
    ['braun-mt 0]
    [`(braun-node ,sz ,_ ,_ ,_) sz]))

(define (braun-insert-op t x)
  (match t
    ['braun-mt `(braun-node 1 ,x braun-mt braun-mt)]
    [`(braun-node ,sz ,v ,L ,R)
     `(braun-node ,(+ sz 1) ,v ,(braun-insert-op R x) ,L)]))

(define (braun-invariant-valid? t)
  (match t
    ['braun-mt #t]
    [`(braun-node ,sz ,_ ,L ,R)
     (define szL (braun-size L))
     (define szR (braun-size R))
     (and (= sz (+ 1 szL szR))
          (<= 0 (- szL szR) 1)
          (braun-invariant-valid? L)
          (braun-invariant-valid? R))]))

;; 5. IntrinsicFingerNode monoid measure caching (2-bit Generate/Propagate carry monoid)
(define (gp-combine m1 m2)
  (match-define `(gp-measure ,g1 ,p1) m1)
  (match-define `(gp-measure ,g2 ,p2) m2)
  `(gp-measure ,(bitwise-ior g2 (bitwise-and p2 g1))
               ,(bitwise-and p1 p2)))

(define (finger-node-measure fn)
  (match fn
    [`(finger-leaf ,m ,_) m]
    [`(finger-node2 ,m ,_ ,_) m]
    [`(finger-node3 ,m ,_ ,_ ,_) m]))

(define (finger-node-valid? fn)
  (match fn
    [`(finger-leaf ,_ ,_) #t]
    [`(finger-node2 ,m ,a ,b)
     (and (finger-node-valid? a)
          (finger-node-valid? b)
          (equal? m (gp-combine (finger-node-measure a) (finger-node-measure b))))]
    [`(finger-node3 ,m ,a ,b ,c)
     (and (finger-node-valid? a)
          (finger-node-valid? b)
          (finger-node-valid? c)
          (equal? m (gp-combine (gp-combine (finger-node-measure a) (finger-node-measure b))
                                (finger-node-measure c))))]))

;; 6. CritBitTrie history-independent insert & zero-tombstone delete (Bernstein 2-pass Crit-Bit)
(define (cb-index x y)
  (define diff (bitwise-xor x y))
  (if (zero? diff) 0 (arithmetic-shift 1 (- (integer-length diff) 1))))

(define (cb-prefix x mask)
  (bitwise-and x (bitwise-not (- (* 2 mask) 1))))

(define (cb-nearest-leaf t x)
  (match t
    [`(crit-lf ,y) y]
    [`(crit-br ,_ ,m ,L ,R)
     (if (zero? (bitwise-and x m))
         (cb-nearest-leaf L x)
         (cb-nearest-leaf R x))]))

(define (cb-insert t x)
  (match t
    ['crit-mt `(crit-lf ,x)]
    [_
     (define y (cb-nearest-leaf t x))
     (if (= x y)
         t
         (let* ([m-new (cb-index x y)]
                [p-new (cb-prefix x m-new)])
           (let loop ([node t])
             (match node
               [`(crit-br ,p ,m ,L ,R) #:when (> m m-new)
                (if (zero? (bitwise-and x m))
                    `(crit-br ,p ,m ,(loop L) ,R)
                    `(crit-br ,p ,m ,L ,(loop R)))]
               [_
                (if (zero? (bitwise-and x m-new))
                    `(crit-br ,p-new ,m-new (crit-lf ,x) ,node)
                    `(crit-br ,p-new ,m-new ,node (crit-lf ,x)))]))))]))

(define (cb-delete t x)
  (match t
    ['crit-mt 'crit-mt]
    [`(crit-lf ,y) (if (= x y) 'crit-mt t)]
    [`(crit-br ,p ,m ,L ,R)
     (if (zero? (bitwise-and x m))
         (let ([L-new (cb-delete L x)])
           (if (equal? L-new 'crit-mt) R `(crit-br ,p ,m ,L-new ,R)))
         (let ([R-new (cb-delete R x)])
           (if (equal? R-new 'crit-mt) L `(crit-br ,p ,m ,L ,R-new))))]))

;; Operational evaluation of QDSOp
(define (eval-qds-raw op)
  (match op
    [`(qds-skew-inc ,s) (canonical-skew-inc s)]
    [`(qds-skew-dec ,s) (canonical-skew-dec s)]
    [`(qds-arena-alloc (bounded-arena ,free ,used ,slots) ,k)
     (if (and (> free 0) (not (member k slots)))
         `(bounded-arena ,(- free 1) ,(+ used 1) ,(cons k slots))
         `(bounded-arena ,free ,used ,slots))]
    [`(qds-arena-free (bounded-arena ,free ,used ,slots) ,k)
     (if (and (> used 0) (member k slots))
         `(bounded-arena ,(+ free 1) ,(- used 1) ,(remove k slots))
         `(bounded-arena ,free ,used ,slots))]
    [`(qds-rtq-snoc (rt-queue ,f ,r ,s) ,x)
     ;; Okasaki real-time queue schedule tick: if sched is empty, rotate(f, x:r, '())
     (define r-new (cons x r))
     (match s
       [(cons _ s-tail) `(rt-queue ,f ,r-new ,s-tail)]
       ['()
        (define f-rot (append f (reverse r-new)))
        `(rt-queue ,f-rot () ,f-rot)])]
    [`(qds-rtq-uncons (rt-queue (cons ,_ ,f-tail) ,r ,s))
     (match s
       [(cons _ s-tail) `(rt-queue ,f-tail ,r ,s-tail)]
       ['()
        (define f-rot (append f-tail (reverse r)))
        `(rt-queue ,f-rot () ,f-rot)])]
    [`(qds-braun-insert ,t ,x) (braun-insert-op t x)]
    [`(qds-finger-measure ,fn)
     (match-define `(gp-measure ,g ,p) (finger-node-measure fn))
     `(skew-single ,(+ (* 2 g) p) mt-tail)]
    [`(qds-crit-insert ,t ,x) (cb-insert t x)]
    [`(qds-crit-delete ,t ,x) (cb-delete t x)]
    [`(qds-consolidate (qcs ,_ ,digits))
     ;; Consolidate redundant carry-save digits into canonical zeroless representation
     (define total
       (for/sum ([d (in-list digits)] [idx (in-naturals)])
         (* d (- (arithmetic-shift 1 (+ idx 1)) 1))))
     `(qcs CanonicalZeroless (,total))]
    [`(qds-session-cost ,sess)
     ;; Count net ebits consumed by a ChoreographicSession
     (define (count-ebits s)
       (match s
         ['sess-end 0]
         [`(sess-alloc-ebit ,k ,rest) (+ k (count-ebits rest))]
         [`(sess-cat-entangle ,_ ,_ ,rest) (+ 1 (count-ebits rest))]
         [`(sess-cat-disentangle ,_ ,_ ,rest) (count-ebits rest)]
         [`(sess-local-diag ,_ ,rest) (count-ebits rest)]))
     `(skew-single ,(count-ebits sess) mt-tail)]
    [`(qds-stream-tick (clocked-stream ,horizon ,pol ,acc) ,step-err)
     (define next-pol (if (eq? pol 'TwirlEven) 'TwirlOdd 'TwirlEven))
     `(clocked-stream ,(+ horizon 1) ,next-pol ,(cons step-err acc))]
    ;; QDS-10: CatenableDeque O(1) append via rotated front/rear lists
    [`(qds-cat-deque-append (cat-deque ,f1 ,r1) (cat-deque ,f2 ,r2))
     `(cat-deque ,(append f1 (reverse r1)) ,(append r2 (reverse f2)))]
    ;; QDS-11: SegmentedBitmask bitwise XOR across 64-bit word lanes
    [`(qds-seg-bitmask-xor (seg-bitmask ,w1) (seg-bitmask ,w2))
     (define len (min (length w1) (length w2)))
     `(seg-bitmask ,(for/list ([a (in-list (take w1 len))]
                               [b (in-list (take w2 len))])
                      (bitwise-xor a b)))]
    ;; QDS-12: LazyPebbleTree recursive binomial pebbling schedule construction
    [`(qds-pebble-tree-build ,s ,p)
     (let build ([steps s] [pebbles p])
       (if (or (<= steps 1) (<= pebbles 1))
           'pebble-leaf
           (let ([half (quotient steps 2)])
             `(pebble-node ,steps ,pebbles
                           ,(build half (- pebbles 1))
                           ,(build (- steps half) pebbles)))))]
    ;; QDS-13: PersistentUnionFind union with rank update
    [`(qds-puf-union (puf-forest ,nodes) ,x ,y)
     (define updated
       (for/list ([nd (in-list nodes)])
         (match nd
           [`(puf-node ,id ,parent ,rk)
            (if (= id x)
                `(puf-node ,id ,y ,(+ rk 1))
                nd)])))
     `(puf-forest ,updated)]
    ;; Simplification S11: QContainer generic structural catamorphism fold
    [`(qds-qcontainer-fold ,qc)
     (eval-qcontainer-fold-raw qc)]))

;; Simplification S11: Generic Quantum Container (QContainer S P M) structural fold
(define (eval-qcontainer-fold-raw qc)
  (match qc
    [`(qcontainer (shape ,_sh) (arity ,_n) (measure ,m) (payload ,xs))
     `(finger-leaf ,m ,(for/sum ([x (in-list xs)]) x))]))

(define-metafunction QuantumTypeTheoryL
  eval-qcontainer-fold : QContainer -> QDSTerm
  [(eval-qcontainer-fold QContainer_0) ,(eval-qcontainer-fold-raw (term QContainer_0))])

