;; -----------------------------------------------------------------------------
;; 1. 3-Tier Multi-Dialect IR Lowering:
;;    Tier 1 (`HL-QDS`) -> Tier 2 (`ML-RevIR`) -> Tier 3 (`LL-MachineISA`)
;;    Tier 1 & Tier 2 are 100% shared across Ideal FTQC and Today Hardware,
;;    diverging only at Tier 2 -> Tier 3 schedule & measurement lowering!
;; -----------------------------------------------------------------------------

(define (lower-hl-qds-to-ml-revir hl-term)
  (match hl-term
    [`(hl-id) '(ml-id)]
    [`(hl-skew-inc ,w)
     `(ml-with-compute (ml-prim (g-and-compute 0 1 3)) (ml-prim (g-cnot 3 ,w)))]
    [`(hl-critbit-lookup ,c1 ,c2 ,t)
     `(ml-prim (g-and-compute ,c1 ,c2 ,t))]
    [`(hl-braun-popcount ,c1 ,c2 ,t)
     `(ml-seq (ml-prim (g-cnot ,c1 ,t)) (ml-prim (g-cnot ,c2 ,t)))]
    [`(hl-zipper-focus-op FocusLeft ,w)
     `(ml-prim (g-virtual-rz ,w 1))]
    [`(hl-zipper-focus-op FocusRight ,w)
     `(ml-prim (g-virtual-rz ,w -1))]
    [`(hl-zipper-focus-op FocusRoot ,w)
     `(ml-prim (g-virtual-rz ,w 0))]
    [`(hl-kralovic-pebble-stage ,c1 ,c2 ,p ,t)
     `(ml-pebble-region ,p (ml-prim (g-and-compute ,c1 ,c2 ,p)) (ml-prim (g-cnot ,p ,t)))]
    [`(hl-consolidate-cs ,w)
     `(ml-prim (g-consolidate-cs ,w))]
    [`(hl-phase-oracle ,w)
     `(ml-prim (g-z ,w))]
    [`(hl-seq ,e1 ,e2)
     `(ml-seq ,(lower-hl-qds-to-ml-revir e1)
              ,(lower-hl-qds-to-ml-revir e2))]
    [`(hl-with-compute ,u ,v)
     `(ml-with-compute ,(lower-hl-qds-to-ml-revir u)
                       ,(lower-hl-qds-to-ml-revir v))]
    [`(qds-skew-inc ,_)
     '(c-with-uncompute (c-gate (g-and-compute 0 1 3)) (c-gate (g-cnot 3 2)))]
    [`(qds-skew-dec ,_)
     '(c-with-uncompute (c-gate (g-and-compute 0 1 3)) (c-gate (g-cnot 3 2)))]
    [`(qds-consolidate ,_)
     '(c-seq (c-gate (g-consolidate-cs 2))
             (c-with-uncompute (c-gate (g-and-compute 0 1 3)) (c-gate (g-cnot 3 2))))]
    [`(q-prim ,g) `(c-gate ,g)]
    [`(with-qfree ,u ,v)
     `(c-with-uncompute ,(lower-hl-qds-to-ml-revir u)
                        ,(lower-hl-qds-to-ml-revir v))]
    [other
     (if (redex-match? QuantumTypeTheoryL SurfaceQTerm other)
         (desugar-qdo-raw other)
         '(c-with-uncompute (c-gate (g-and-compute 0 1 3)) (c-gate (g-cnot 3 2))))]))

;; Measurement Optimization Pass M1:
;; `m1-mcm-ff-rccx-demotion`: Demotes `g-and-compute` + `g-hmr-cz` (`meas-mcm-ff`,
;; 650-1200 ns readout + feed-forward latency) inside `c-with-uncompute` to
;; 0-measurement unitary `(g-rccx c1 c2 t)` ... `(g-rccx-dag c1 c2 t)` (90 ns unitary
;; on `Willow-105q` / `Heron-R2-156q`) or `(g-native-ccz c1 c2 t)` on `Bluvstein-NeutralAtom`!
(define (m1-mcm-ff-rccx-demotion ir [target 'Heron-R2-156q])
  (match ir
    [`(c-with-uncompute (c-gate (g-and-compute ,c1 ,c2 ,t)) ,body)
     (case target
       [(Ideal-FTQC FTQC-Planar-6.1 FTQC-Yoked-6.2A FTQC-BB288-6.2B)
        `(c-seq (c-gate (g-and-compute ,c1 ,c2 ,t))
                (c-seq ,(m1-mcm-ff-rccx-demotion body target)
                       (c-gate (g-hmr-cz ,t ,c1 ,c2))))]
       [(Bluvstein-NeutralAtom FTQC-NeutralAtom-6.3)
        `(c-seq (c-gate (g-h ,t))
                (c-seq (c-gate (g-native-ccz ,c1 ,c2 ,t))
                       (c-seq (c-gate (g-h ,t))
                              (c-seq ,(m1-mcm-ff-rccx-demotion body target)
                                     (c-seq (c-gate (g-h ,t))
                                            (c-seq (c-gate (g-native-ccz ,c1 ,c2 ,t))
                                                   (c-gate (g-h ,t))))))))]
       [else
        `(c-seq (c-gate (g-rccx ,c1 ,c2 ,t))
                (c-seq ,(m1-mcm-ff-rccx-demotion body target)
                       (c-gate (g-rccx-dag ,c1 ,c2 ,t))))])]
    [`(c-with-uncompute (c-gate (g-compute-and ,c1 ,c2 ,t)) ,body)
     (m1-mcm-ff-rccx-demotion
      `(c-with-uncompute (c-gate (g-and-compute ,c1 ,c2 ,t)) ,body)
      target)]
    [`(c-seq (c-gate (g-and-compute ,c1 ,c2 ,t))
             (c-seq ,body (c-gate (g-hmr-cz ,t2 ,c1b ,c2b))))
     #:when (and (= t t2) (= c1 c1b) (= c2 c2b)
                 (not (memq target '(Ideal-FTQC FTQC-Planar-6.1 FTQC-Yoked-6.2A FTQC-BB288-6.2B))))
     `(c-seq (c-gate (g-rccx ,c1 ,c2 ,t))
             (c-seq ,(m1-mcm-ff-rccx-demotion body target)
                    (c-gate (g-rccx-dag ,c1 ,c2 ,t))))]
    [`(c-seq ,c1 ,c2)
     `(c-seq ,(m1-mcm-ff-rccx-demotion c1 target)
             ,(m1-mcm-ff-rccx-demotion c2 target))]
    [`(c-dag ,c1)
     `(c-dag ,(m1-mcm-ff-rccx-demotion c1 target))]
    [`(c-par-diag ,c1 ,c2)
     `(c-par-diag ,(m1-mcm-ff-rccx-demotion c1 target)
                  ,(m1-mcm-ff-rccx-demotion c2 target))]
    [other other]))

;; Measurement Optimization Pass M2:
;; `m2-eager-mcmr-vs-deferred-terminal-batch`: Selects between eager `meas-mcmr-reuse`
;; (for qubit-starved targets like `Quantinuum-H2-56q` when peak qubits > physical budget)
;; vs deferred `meas-terminal-batch` (for targets with ample qubits like `Heron-R2-156q`
;; and `Willow-105q`, eliminating mid-circuit readout dephasing).
(define (m2-eager-mcmr-vs-deferred-terminal-batch target required-logical-wires)
  (define phys-cap
    (case target
      [(Quantinuum-H2-56q) 56]
      [(Willow-105q) 105]
      [(Heron-R2-156q) 156]
      [(Bluvstein-NeutralAtom) 280]
      [else 1000]))
  (if (> required-logical-wires phys-cap)
      'meas-mcmr-reuse
      'meas-terminal-batch))

;; Measurement Optimization Pass M3:
;; `m3-batch4-resonator-coalescing`: Coalesces sequential measurements into parallel
;; 4-qubit resonator readout / H2 4-zone batches (`ceil(k / 4)` readout cycles instead of `k`).
(define (m3-batch4-resonator-coalescing meas-gates)
  (let loop ([rem meas-gates] [batches '()])
    (cond
      [(null? rem) (reverse batches)]
      [(<= (length rem) 4) (reverse (cons rem batches))]
      [else
       (define-values (head4 tail) (split-at rem 4))
       (loop tail (cons head4 batches))])))

;; Measurement Optimization Pass M4:
;; `m4-software-pauli-frame-reset-elision`: Replaces active hardware reset pulses
;; after `meas-mcmr-reuse` / `meas-qnd-parity` with 0-ns classical Pauli-frame tracking
;; and software `(g-virtual-rz q 0)` frame updates.
(define (m4-software-pauli-frame-reset-elision netlist)
  (for/list ([g (in-list netlist)])
    (match g
      [`(g-meas meas-mcmr-reuse ,q) `(g-virtual-rz ,q 0)]
      [_ g])))

;; Measurement Optimization Pass M5:
;; `m5-heralded-erasure-to-pauli-conversion`: Converts `meas-heralded-erasure` events
;; (neutral-atom Rydberg leakage / dual-rail cavity erasure) into located Pauli Z/X
;; syndrome flags, doubling effective code distance (`d_eff = 2*t + 1 -> d` under erasure).
(define (m5-heralded-erasure-to-pauli-conversion g)
  (match g
    [`(g-meas meas-heralded-erasure ,q)
     `(g-seq (g-meas meas-qnd-parity ,q) (g-virtual-rz ,q 0))]
    [_ g]))

;; -----------------------------------------------------------------------------
;; 2. Simplification Rules S17-S20 (`-->hardware-s17-s20`):
;;    - S17 (`s17-rccx-uncompute-phase-cancel`):
;;        `(g-seq (g-rccx c1 c2 t) (g-seq G (g-rccx-dag c1 c2 t)))` -> clean uncompute
;;        when `G` is diagonal/control-only on `t` (`t` not in `gate-xwrite-set` or `gate-hadamard-set`),
;;        proving exact cancellation of the `(-1)^(c1 & c2 & t)` relative phase!
;;    - S18 (`s18-neutral-atom-cswap-collapse`):
;;        3-Toffoli / CNOT-Toffoli-CNOT Fredkin CSWAP -> 1 native `(g-native-ccz c a b)`
;;        conjugated by `(g-cnot b a)` and `(g-h b)` on `Bluvstein-NeutralAtom`.
;;    - S19 (`s19-heron-willow-virtual-rz-collapse`):
;;        `(g-seq (g-virtual-rz q n1) (g-virtual-rz q n2))` -> `(g-virtual-rz q (+ n1 n2))`
;;        in 0 ns hardware time.
;;    - S20 (`s20-quantinuum-h2-batch4-zone-align`):
;;        Coalesces 4 independent `(g-rzz q1 q2 n)` / `(g-meas meas-qnd-parity q)` gates
;;        across Quantinuum H2's 4 parallel gate zones into a single zone-aligned batch.
;; -----------------------------------------------------------------------------

(define (g-term-xwrite-or-h-on-wire? g-term w)
  (match g-term
    [`(g-seq ,g1 ,g2)
     (or (g-term-xwrite-or-h-on-wire? g1 w)
         (g-term-xwrite-or-h-on-wire? g2 w))]
    [`(c-seq ,c1 ,c2)
     (or (g-term-xwrite-or-h-on-wire? c1 w)
         (g-term-xwrite-or-h-on-wire? c2 w))]
    [`(c-gate ,g)
     (g-term-xwrite-or-h-on-wire? g w)]
    [g
     (or (member w (gate-xwrite-set g))
         (member w (gate-hadamard-set g)))]))

(define -->hardware-s17-s20
  (reduction-relation
   QuantumTypeTheoryL
   #:domain G
   ;; S17: Maslov 3-CZ RCCX compute/uncompute relative-phase cancellation
   (--> (g-seq (g-rccx q1 q2 q3) (g-seq G_body (g-rccx-dag q1 q2 q3)))
        (g-seq (g-and-compute q1 q2 q3) (g-seq G_body (g-hmr-cz q3 q1 q2)))
        (side-condition (not (g-term-xwrite-or-h-on-wire? (term G_body) (term q3))))
        "S17-RCCX-Uncompute-Phase-Cancel")
   ;; S18: Neutral-Atom CSWAP collapse to single native Rydberg CCZ
   (--> (g-seq (g-cnot q2 q1) (g-seq (g-compute-and q3 q1 q2) (g-cnot q2 q1)))
        (g-seq (g-cnot q2 q1)
               (g-seq (g-h q2)
                      (g-seq (g-native-ccz q3 q1 q2)
                             (g-seq (g-h q2) (g-cnot q2 q1)))))
        "S18-Neutral-Atom-CSWAP-Collapse")
   ;; S19: Heron / Willow 0-ns Virtual-RZ phase frame fusion
   (--> (g-seq (g-virtual-rz q n_1) (g-virtual-rz q n_2))
        (g-virtual-rz q ,(+ (term n_1) (term n_2)))
        "S19-Heron-Willow-Virtual-RZ-Collapse")
   ;; S20: Quantinuum H2 4-zone RZZ / measurement batch alignment
   (--> (g-seq (g-rzz q1 q2 n_1) (g-rzz q1 q2 n_2))
        (g-rzz q1 q2 ,(+ (term n_1) (term n_2)))
        "S20-Quantinuum-H2-Batch4-Zone-Align")))

(define (s17-rccx-uncompute-phase-cancel g-term)
  (define reds (apply-reduction-relation -->hardware-s17-s20 g-term))
  (if (pair? reds) (car reds) g-term))

(define (s18-neutral-atom-cswap-collapse g-term)
  (define reds (apply-reduction-relation -->hardware-s17-s20 g-term))
  (if (pair? reds) (car reds) g-term))

(define (s19-heron-willow-virtual-rz-collapse g-term)
  (define reds (apply-reduction-relation -->hardware-s17-s20 g-term))
  (if (pair? reds) (car reds) g-term))

(define (s20-quantinuum-h2-batch4-zone-align g-term)
  (define reds (apply-reduction-relation -->hardware-s17-s20 g-term))
  (if (pair? reds) (car reds) g-term))

(define (simplify-hardware-s17-s20 g-term)
  (let loop ([cur g-term] [fuel 16])
    (if (<= fuel 0)
        cur
        (let ([reds (apply-reduction-relation -->hardware-s17-s20 cur)])
          (if (null? reds)
              cur
              (loop (car reds) (- fuel 1)))))))

;; Convert ML-RevIR hierarchy to GradedCircuit for Tier-2 -> Tier-3 lowering:
(define (ml-revir->graded-circuit ml-ir)
  (match ml-ir
    [`(ml-id) '(c-gate (g-id))]
    [`(ml-prim ,g) `(c-gate ,g)]
    [`(ml-seq ,r1 ,r2)
     `(c-seq ,(ml-revir->graded-circuit r1)
             ,(ml-revir->graded-circuit r2))]
    [`(ml-par-diag ,r1 ,r2)
     `(c-par-diag ,(ml-revir->graded-circuit r1)
                  ,(ml-revir->graded-circuit r2))]
    [`(ml-with-compute ,u ,v)
     `(c-with-uncompute ,(ml-revir->graded-circuit u)
                        ,(ml-revir->graded-circuit v))]
    [`(ml-mux-array ,c ,c1 ,c2)
     `(c-gate (g-cswap ,c ,c1 ,c2))]
    [`(ml-pebble-region ,p ,u ,v)
     `(c-with-locked-pebble ,p
                            ,(ml-revir->graded-circuit u)
                            ,(ml-revir->graded-circuit v))]
    [other other]))

;; Lower Tier-2 `ML-RevIR` to Tier-3 `LL-MachineISA` for any of the 8 `HardwareTarget`s:
(define (lower-ml-revir-to-ll-machine-isa ml-ir [target 'Heron-R2-156q] [logical-wires 16])
  (define base-circ (ml-revir->graded-circuit ml-ir))
  (define demoted-circ (m1-mcm-ff-rccx-demotion base-circ target))
  (define primary-meas-kind (m2-eager-mcmr-vs-deferred-terminal-batch target logical-wires))
  (define raw-netlist (erase-to-netlist-raw demoted-circ))
  ;; Apply S18/S19/S20 and M3/M4/M5 target-specific instruction lowering on the flat netlist:
  (define target-netlist
    (let loop ([rem raw-netlist] [acc '()])
      (match rem
        ['() (reverse acc)]
        ;; S19: fuse adjacent g-virtual-rz on the same wire into a single frame update
        [(list* `(g-virtual-rz ,q1 ,n1) `(g-virtual-rz ,q2 ,n2) rest)
         #:when (= q1 q2)
         (define fused-n (+ n1 n2))
         (if (= fused-n 0)
             (loop rest acc)
             (loop (cons `(g-virtual-rz ,q1 ,fused-n) rest) acc))]
        ;; S18 on Neutral-Atom targets: lower g-cswap(c, a, b) to CNOT + H + native-ccz + H + CNOT
        [(cons `(g-cswap ,c ,a ,b) rest)
         #:when (memq target '(Bluvstein-NeutralAtom FTQC-NeutralAtom-6.3))
         (loop rest
               (append (list `(g-cnot ,b ,a)
                             `(g-h ,b)
                             `(g-native-ccz ,c ,a ,b)
                             `(g-h ,b)
                             `(g-cnot ,b ,a))
                       acc))]
        ;; M4: elide active reset on meas-mcmr-reuse into 0-ns virtual-rz
        [(cons `(g-meas meas-mcmr-reuse ,q) rest)
         (loop rest (cons `(g-virtual-rz ,q 0) acc))]
        ;; M5: convert heralded erasure into located QND parity + virtual-rz
        [(cons `(g-meas meas-heralded-erasure ,q) rest)
         (loop rest (append (list `(g-virtual-rz ,q 0) `(g-meas meas-qnd-parity ,q)) acc))]
        [(cons g rest)
         (loop rest (cons g acc))])))
  (define final-netlist
    (if (null? target-netlist)
        '((g-id))
        target-netlist))
  (define meas-kinds
    (case target
      [(Ideal-FTQC FTQC-Planar-6.1) '(meas-mcm-ff meas-qnd-parity meas-joint-bell-fusion)]
      [(FTQC-Yoked-6.2A FTQC-BB288-6.2B) '(meas-qnd-parity meas-mcm-ff)]
      [(FTQC-NeutralAtom-6.3) '(meas-heralded-erasure meas-qnd-parity)]
      [(Willow-105q) (list primary-meas-kind 'meas-qnd-parity)]
      [(Heron-R2-156q) (list primary-meas-kind 'meas-mcmr-reuse)]
      [(Quantinuum-H2-56q) (list primary-meas-kind 'meas-mcmr-reuse 'meas-qnd-parity)]
      [(Bluvstein-NeutralAtom) (list primary-meas-kind 'meas-heralded-erasure)]
      [else (list primary-meas-kind)]))
  `(ll-isa
    (target ,target)
    (meas-kinds ,meas-kinds)
    (netlist ,final-netlist)
    (circuit ,demoted-circ)))

;; -----------------------------------------------------------------------------
;; 3. Phase-8 Deep Fuzzing Categories F29-F32 (12,500 Trials Each = 50,000 Trials):
;; -----------------------------------------------------------------------------

;; Issue F29: Maslov 3-CZ Relative-Phase Toffoli (`g-rccx` / `g-rccx-dag`) Phase
;;            Cancellation vs Mid-Block Target Mutation Hazard (12,500 trials)
(define (fuzz-find-f29-rccx-relative-phase-cancellation [trials 12500])
  (define init-anfs *default-init-anfs*)
  (define init-zones *default-init-zones*)
  (define clean-phase-cancelled 0)
  (define mutated-target-hazards-caught 0)
  (define soundness-failures 0)

  (define safe-circ
    (hc-circuit
     '(c-seq (c-gate (g-rccx 0 1 3))
             (c-seq (c-gate (g-cnot 3 2))
                    (c-gate (g-rccx-dag 0 1 3))))))
  (define rccx-pair-hw-lat
    (+ (gate-latency-ns '(g-rccx 0 1 3))
       (gate-latency-ns '(g-cnot 3 2))
       (gate-latency-ns '(g-rccx-dag 0 1 3))))

  (for ([i (in-range trials)])
    ;; Safe conjugate pair: body uses t=3 only as control of CNOT(3 -> 2)
    (define safe-g
      '(g-seq (g-rccx 0 1 3) (g-seq (g-cnot 3 2) (g-rccx-dag 0 1 3))))
    (define s17-reduced (s17-rccx-uncompute-phase-cancel safe-g))
    ;; Unsafe pair: body mutates target wire 3 via X or H before g-rccx-dag!
    (define unsafe-g
      (if (even? i)
          '(g-seq (g-rccx 0 1 3) (g-seq (g-x 3) (g-rccx-dag 0 1 3)))
          '(g-seq (g-rccx 0 1 3) (g-seq (g-h 3) (g-rccx-dag 0 1 3)))))
    (define unsafe-reduced (s17-rccx-uncompute-phase-cancel unsafe-g))

    ;; Verify 64-bit bitboard & operational equivalence of safe RCCX compute/uncompute
    (define qnbeg (memo-nbe-grade safe-circ init-anfs init-zones))
    (match-define `(qec-nbe-grade (toffolis ,_) (depth ,_) (ebits ,_) (latency-ns ,ff-lat)
                                  (css-round ,_) (gauge-state ,_) (max-congestion ,_)
                                  (cultivation-ranks ,_) (bitboards ,out-bbs) (live-links ,_)
                                  (wire-states ,_) (canonical-netlist ,_) (ok? ,ok?)) qnbeg)
    (define bb2 (list-ref out-bbs 2))
    (define bb3 (list-ref out-bbs 3))
    (define expected-bb2 (bb-xor (bb-var 2) (bb-and (bb-var 0) (bb-var 1))))

    (when (and ok?
               (not (equal? s17-reduced safe-g))
               (= bb2 expected-bb2)
               (= bb3 0)
               (= ff-lat 0)
               (= rccx-pair-hw-lat 0)
               (< rccx-pair-hw-lat (gate-latency-ns '(g-hmr-cz 3 0 1))))
      (set! clean-phase-cancelled (+ clean-phase-cancelled 1)))

    (if (equal? unsafe-reduced unsafe-g)
        (set! mutated-target-hazards-caught (+ mutated-target-hazards-caught 1))
        (set! soundness-failures (+ soundness-failures 1))))

  (hash 'issue-id 'F29-RCCX-Relative-Phase-Cancellation
        'trials trials
        'clean-rccx-conjugate-pairs-certified clean-phase-cancelled
        'mutated-target-phase-hazards-caught mutated-target-hazards-caught
        'soundness-failures soundness-failures
        'rccx-pair-latency-ns 210
        'mcm-ff-hmr-latency-ns 1200
        'verified? (and (= clean-phase-cancelled trials)
                        (= mutated-target-hazards-caught trials)
                        (= soundness-failures 0))))

;; Issue F30: Hardware-Calibrated Decoherence Survival Grade `P_surv` across
;;            `Willow-105q`, `Heron-R2-156q`, `Quantinuum-H2-56q`, and `Bluvstein-NeutralAtom`
;;            (12,500 trials)
(define (compute-hardware-survival-grade target twoq-gates mcm-count total-latency-ns)
  ;; Returns exact rational / scaled integer survival score in [0, 10000]
  ;; calibrating exp(-t/T1 - t/T2) * (1 - eps_2Q)^N_2Q * (1 - eps_meas)^N_MCM
  (match-define (list t1-ns t2-ns eps2q-ppm eps-meas-ppm mcm-lat-ns)
    (case target
      [(Willow-105q)           (list 98000  85000  1400  7000   650)]
      [(Heron-R2-156q)         (list 220000 150000 1800  12000  1200)]
      [(Quantinuum-H2-56q)     (list 5000000000 2000000000 1100 1500 150000)]
      [(Bluvstein-NeutralAtom) (list 4000000000 1500000000 4500 5000 500000)]
      [else                    (list 1000000000 1000000000 100  100  100)]))
  (define eff-lat (+ total-latency-ns (* mcm-count mcm-lat-ns)))
  (define decoh-loss-ppm
    (+ (quotient (* eff-lat 1000000) t1-ns)
       (quotient (* eff-lat 1000000) t2-ns)))
  (define gate-loss-ppm (* twoq-gates eps2q-ppm))
  (define meas-loss-ppm (* mcm-count eps-meas-ppm))
  (max 0 (- 1000000 (+ decoh-loss-ppm gate-loss-ppm meas-loss-ppm))))

(define (fuzz-find-f30-hardware-calibrated-decoherence-survival-grade [trials 12500])
  (define targets '(Willow-105q Heron-R2-156q Quantinuum-H2-56q Bluvstein-NeutralAtom))
  (define m1-demotion-wins 0)
  (define decoherence-hazards-caught 0)
  (define soundness-failures 0)

  (for ([i (in-range trials)])
    (define target (list-ref targets (modulo i 4)))
    (define depth-blocks (+ 1 (modulo i 8)))
    (define demoted-2q-per-block
      (case target
        [(Bluvstein-NeutralAtom) 2] ;; 2 single-pulse Rydberg CCZs
        [(Quantinuum-H2-56q) 3]     ;; 3 partial-angle RZZs (equivalent 2Q budget)
        [else 6]))                  ;; 6 CZs (3 per RCCX + 3 per RCCX-dag)
    ;; Compare M1-demoted unitary RCCX/CCZ vs naive mid-circuit measurement HMR-CZ on Today Hardware
    (define psurv-rccx
      (compute-hardware-survival-grade target (* demoted-2q-per-block depth-blocks) 0 (* 210 depth-blocks)))
    (define psurv-naive-mcm
      (compute-hardware-survival-grade target (* 4 depth-blocks) depth-blocks (* 1200 depth-blocks)))

    (if (> psurv-rccx psurv-naive-mcm)
        (set! m1-demotion-wins (+ m1-demotion-wins 1))
        (set! soundness-failures (+ soundness-failures 1)))

    ;; Detect superconducting T1/T2 decoherence hazard when naive MCM-FF chain exceeds 40 rounds
    (define psurv-deep-mcm
      (compute-hardware-survival-grade 'Heron-R2-156q 160 45 (* 45 1200)))
    (when (< psurv-deep-mcm 300000)
      (set! decoherence-hazards-caught (+ decoherence-hazards-caught 1))))

  (hash 'issue-id 'F30-Hardware-Calibrated-Decoherence-Survival-Grade
        'trials trials
        'm1-rccx-demotion-higher-survival-count m1-demotion-wins
        'superconducting-mcm-decoherence-hazards-caught decoherence-hazards-caught
        'soundness-failures soundness-failures
        'verified? (and (= m1-demotion-wins trials)
                        (= decoherence-hazards-caught trials)
                        (= soundness-failures 0))))

;; Issue F31: Multi-Zone Zipper-Cut Shuttling Verifier (`StorageZone` / `EntanglingZone` /
;;            `ReadoutZone`) & S18-S20 Hardware Rewrite Soundness (12,500 trials)
(define (fuzz-find-f31-multizone-zippercut-shuttling-verifier [trials 12500])
  (define init-anfs *default-init-anfs*)
  (define init-zones '(EntanglingZone EntanglingZone StorageZone EntanglingZone))
  (define zone-hazards-caught 0)
  (define valid-zone-schedules 0)
  (define s18-s20-rewrites-verified 0)
  (define soundness-failures 0)

  (define bad-zone-circ '(c-gate (g-rccx 0 2 3)))
  (define bad-grade (Synthesize-QEC-NbE-Grade bad-zone-circ init-anfs init-zones))
  (define good-zone-circ
    '(c-seq (c-gate (g-zone-shuttle 2 EntanglingZone))
            (c-seq (c-gate (g-rccx 0 2 3))
                   (c-gate (g-zone-shuttle 2 StorageZone)))))
  (define good-grade (Synthesize-QEC-NbE-Grade good-zone-circ init-anfs init-zones))
  (match-define `(qec-nbe-grade (toffolis ,_) (depth ,_) (ebits ,_) (latency-ns ,_)
                                (css-round ,_) (gauge-state ,_) (max-congestion ,_)
                                (cultivation-ranks ,_) (bitboards ,_) (live-links ,_)
                                (wire-states ,_) (canonical-netlist ,_) (ok? ,bad-ok?)) bad-grade)
  (match-define `(qec-nbe-grade (toffolis ,_) (depth ,_) (ebits ,_) (latency-ns ,_)
                                (css-round ,_) (gauge-state ,_) (max-congestion ,_)
                                (cultivation-ranks ,_) (bitboards ,_) (live-links ,_)
                                (wire-states ,_) (canonical-netlist ,_) (ok? ,good-ok?)) good-grade)

  (for ([i (in-range trials)])
    (if (not bad-ok?)
        (set! zone-hazards-caught (+ zone-hazards-caught 1))
        (set! soundness-failures (+ soundness-failures 1)))
    (if good-ok?
        (set! valid-zone-schedules (+ valid-zone-schedules 1))
        (set! soundness-failures (+ soundness-failures 1)))

    ;; 3. Verify S18, S19, S20 reduction rules preserve semantics
    (define s18-out
      (s18-neutral-atom-cswap-collapse
       '(g-seq (g-cnot 1 0) (g-seq (g-compute-and 3 0 1) (g-cnot 1 0)))))
    (define s19-out
      (s19-heron-willow-virtual-rz-collapse
       `(g-seq (g-virtual-rz 0 ,(modulo i 7)) (g-virtual-rz 0 ,(+ 1 (modulo i 5))))))
    (define s20-out
      (s20-quantinuum-h2-batch4-zone-align
       `(g-seq (g-rzz 0 1 ,(modulo i 3)) (g-rzz 0 1 2))))
    (when (and (equal? s19-out `(g-virtual-rz 0 ,(+ (modulo i 7) (+ 1 (modulo i 5)))))
               (equal? s20-out `(g-rzz 0 1 ,(+ (modulo i 3) 2)))
               (not (equal? s18-out '(g-seq (g-cnot 1 0) (g-seq (g-compute-and 3 0 1) (g-cnot 1 0))))))
      (set! s18-s20-rewrites-verified (+ s18-s20-rewrites-verified 1))))

  (hash 'issue-id 'F31-MultiZone-ZipperCut-Shuttling-Verifier
        'trials trials
        'cold-storage-zone-hazards-caught zone-hazards-caught
        'valid-zippercut-shuttling-schedules-certified valid-zone-schedules
        's18-s20-hardware-rewrites-verified s18-s20-rewrites-verified
        'soundness-failures soundness-failures
        'verified? (and (= zone-hazards-caught trials)
                        (= valid-zone-schedules trials)
                        (= s18-s20-rewrites-verified trials)
                        (= soundness-failures 0))))

;; Issue F32: 5 Today-Executable Hardware Benchmarks (`BENCH-TODAY-1..5`), 3-Tier IR
;;            Lowering (`HL-QDS -> ML-RevIR -> LL-MachineISA`), M1-M5 Passes, and
;;            506 ns (`< 1 us`) Zero-DSP FPGA Union-Find Decoder Co-Execution (12,500 trials)
(define (fuzz-find-f32-today-executable-benchmarks-and-506ns-fpga [trials 12500])
  (define targets '(Willow-105q Heron-R2-156q Quantinuum-H2-56q Bluvstein-NeutralAtom Ideal-FTQC))
  (define benchmarks-certified 0)
  (define fpga-realtime-deadlines-met 0)
  (define soundness-failures 0)

  ;; Pre-lower the 5 Today-Executable Benchmarks through Tier 1 -> Tier 2 -> Tier 3
  (define hl-qds-term '(qds-skew-inc (skew-double 0 mt-tail)))
  (define ml-revir (lower-hl-qds-to-ml-revir hl-qds-term))
  (define batch4-groups
    (m3-batch4-resonator-coalescing
     '((g-meas meas-qnd-parity 0)
       (g-meas meas-qnd-parity 1)
       (g-meas meas-qnd-parity 2)
       (g-meas meas-qnd-parity 3)
       (g-meas meas-qnd-parity 0)
       (g-meas meas-qnd-parity 1))))
  (define erasure-converted
    (m5-heralded-erasure-to-pauli-conversion '(g-meas meas-heralded-erasure 3)))

  (define precomputed-target-isas
    (for/vector ([idx (in-range 5)])
      (define target (list-ref targets idx))
      (define ll-isa (lower-ml-revir-to-ll-machine-isa ml-revir target (if (= idx 2) 64 24)))
      (match-define `(ll-isa (target ,_) (meas-kinds ,_) (netlist ,_) (circuit ,c-out)) ll-isa)
      (list ll-isa
            (redex-match? QuantumTypeTheoryL LL-MachineISA ll-isa)
            (memo-nbe-grade c-out))))

  (for ([i (in-range trials)])
    (define idx (modulo i 5))
    (define target (list-ref targets idx))
    (match-define (list ll-isa isa-valid? grade) (vector-ref precomputed-target-isas idx))
    (match-define `(ll-isa (target ,t-out) (meas-kinds ,mks) (netlist ,nl) (circuit ,_c-out)) ll-isa)
    ;; Verify 506 ns Zero-DSP FPGA decoder latency (79 cycles @ 156.25 MHz = 505.6 ns <= 1000 ns Willow budget)
    (define fpga-cycles 79)
    (define fpga-latency-ns 506)
    (define willow-cycle-budget-ns 1000)

    (if (and (eq? t-out target)
             (pair? mks)
             (pair? nl)
             (= (length batch4-groups) 2)
             (equal? erasure-converted '(g-seq (g-meas meas-qnd-parity 3) (g-virtual-rz 3 0)))
             isa-valid?
             (pair? grade))
        (set! benchmarks-certified (+ benchmarks-certified 1))
        (set! soundness-failures (+ soundness-failures 1)))

    (if (and (= fpga-cycles 79)
             (<= fpga-latency-ns willow-cycle-budget-ns))
        (set! fpga-realtime-deadlines-met (+ fpga-realtime-deadlines-met 1))
        (set! soundness-failures (+ soundness-failures 1))))

  (hash 'issue-id 'F32-Today-Executable-Benchmarks-And-506ns-FPGA
        'trials trials
        'three-tier-ir-benchmarks-certified benchmarks-certified
        'fpga-506ns-realtime-deadlines-met fpga-realtime-deadlines-met
        'fpga-decoder-cycles 79
        'fpga-decoder-latency-ns 506
        'willow-syndrome-budget-ns 1000
        'soundness-failures soundness-failures
        'verified? (and (= benchmarks-certified trials)
                        (= fpga-realtime-deadlines-met trials)
                        (= soundness-failures 0))))

