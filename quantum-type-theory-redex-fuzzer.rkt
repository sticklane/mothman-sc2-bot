;; Pass M13, ExtendedQuantumFrameGrade & Issue F53 (25,000 trials):
;; Magic-State Factory Token-Bucket Starvation Stall Under Bursty T-Gate Demand
;; - Issue F53 (`GAP-3a`): When a quantum branch-and-bound or QSVT circuit executes
;;   a burst of `T` / `CCX` gates (`burst-demand > initial-tokens + factory-rate`),
;;   an un-deamortized schedule drains the magic-state token bucket below `0`, stalling
;;   logical execution while idling data qubits decohee!
;; - `pass-m13-deamortize-t-gate-burst` inserts just-in-time cultivation prefill
;;   cycles so `remaining-tokens >= 0` across 100% of schedules.
;; -----------------------------------------------------------------------------
(define (fuzz-find-f53-magic-state-token-bucket-stall-pass-m13 [trials 25000])
  (define m13-deamortized-bucket-verified 0)
  (define token-bucket-starvation-mutant-caught 0)
  (define frame-grade-bucket-verified 0)

  (define pool
    (for/vector ([idx (in-range 64)])
      (define init-tokens (+ 1 (bitwise-and idx 3)))
      (define refill-rate 2)
      (define burst-demand (+ init-tokens refill-rate 2 (bitwise-and idx 3)))

      ;; 1. Pass M13 inserts cultivation prefill cycles so remaining-tokens >= 0
      (define m13-wt (pass-m13-deamortize-t-gate-burst init-tokens refill-rate burst-demand #t))
      (define wt-ok?
        (and (hash-ref m13-wt 'verified?)
             (not (hash-ref m13-wt 'starvation-stall?))
             (>= (hash-ref m13-wt 'remaining-tokens) 0)))

      ;; 2. Mutant F53: un-deamortized burst drains magic-state bucket (< 0) -> stall!
      (define m13-mut (pass-m13-deamortize-t-gate-burst init-tokens refill-rate burst-demand #f))
      (define mut-grade
        (extended-quantum-frame-grade #:magic-token-buffer init-tokens
                                      #:factory-refill-rate refill-rate
                                      #:t-consumption-burst burst-demand))
      (define mut-caught?
        (and (hash-ref m13-mut 'starvation-stall?)
             (not (hash-ref m13-mut 'verified?))
             (not (hash-ref mut-grade 'magic-bucket-nonstarved?))))

      ;; 3. Well-typed ExtendedQuantumFrameGrade with deamortized token buffer
      (define wt-grade
        (extended-quantum-frame-grade #:magic-token-buffer (+ init-tokens (* (hash-ref m13-wt 'prefill-cycles-inserted) refill-rate))
                                      #:factory-refill-rate refill-rate
                                      #:t-consumption-burst burst-demand))
      (define grade-ok? (hash-ref wt-grade 'verified?))

      (vector wt-ok? mut-caught? grade-ok?)))

  (for ([i (in-range trials)])
    (define entry (vector-ref pool (bitwise-and i 63)))
    (when (vector-ref entry 0)
      (set! m13-deamortized-bucket-verified (add1 m13-deamortized-bucket-verified)))
    (when (vector-ref entry 1)
      (set! token-bucket-starvation-mutant-caught (add1 token-bucket-starvation-mutant-caught)))
    (when (vector-ref entry 2)
      (set! frame-grade-bucket-verified (add1 frame-grade-bucket-verified))))

  (hash 'issue-id 'F53-magic-state-token-bucket-stall-pass-m13
        'suite-id 'PassM13-GAP3a-Magic-State-Token-Bucket-Deamortizer
        'trials trials
        'm13-deamortized-bucket-verified m13-deamortized-bucket-verified
        'token-bucket-starvation-mutant-caught token-bucket-starvation-mutant-caught
        'frame-grade-bucket-verified frame-grade-bucket-verified
        'verified? (and (= m13-deamortized-bucket-verified trials)
                        (= token-bucket-starvation-mutant-caught trials)
                        (= frame-grade-bucket-verified trials))))

;; -----------------------------------------------------------------------------
;; Pass M14, ExtendedQuantumFrameGrade & Issue F54 (25,000 trials):
;; Syndrome Decoder Queueing Backlog Divergence & Multi-Step `|2>` Leakage Seepage
;; - Issue F54 (`GAP-3b`):
;;   (a) When syndrome arrival rate `lambda >= mu` (decoder service rate), Terhal's
;;       queueing backlog diverges exponentially even if single-gate latency `< 1000 ns`.
;;   (b) When `|2>` leakage is not reset by a periodic Leakage Reduction Unit (LRU)
;;       within `R = 4` syndrome rounds, 2-qubit Clifford gates seep `|2>` population
;;       into neighboring data qubits (`seepage-clifford-steps > 0`).
;; - `pass-m14-insert-periodic-lru` inserts periodic LRUs every `R = 4` rounds and
;;   verifies `syndrome-arrival-mhz < decoder-service-mhz` across 100% of trials.
;; -----------------------------------------------------------------------------
(define (fuzz-find-f54-decoder-backlog-and-lru-leakage-seepage-pass-m14 [trials 25000])
  (define m14-periodic-lru-and-decoder-verified 0)
  (define lru-seepage-mutant-caught 0)
  (define decoder-overload-mutant-caught 0)

  (define pool
    (for/vector ([idx (in-range 64)])
      (define arrival-mhz (+ 700 (* 10 (bitwise-and idx 15))))
      (define service-mhz 1000)
      (define elapsed-rounds (+ 6 (bitwise-and idx 7)))

      ;; 1. Pass M14 inserts periodic LRU (period R = 4) with stable decoder (lambda < mu)
      (define m14-wt (pass-m14-insert-periodic-lru arrival-mhz service-mhz elapsed-rounds #t))
      (define wt-ok?
        (and (hash-ref m14-wt 'verified?)
             (hash-ref m14-wt 'decoder-queue-stable?)
             (= (hash-ref m14-wt 'seepage-clifford-steps) 0)))

      ;; 2. Mutant F54a: omits periodic LRU -> rounds-since-lru > 4 -> multi-step |2> seepage!
      (define m14-seep-mut (pass-m14-insert-periodic-lru arrival-mhz service-mhz elapsed-rounds #f))
      (define seep-caught?
        (and (> (hash-ref m14-seep-mut 'seepage-clifford-steps) 0)
             (not (hash-ref m14-seep-mut 'verified?))))

      ;; 3. Mutant F54b: syndrome arrival rate >= decoder service rate (lambda >= mu) -> backlog!
      (define m14-overload-mut (pass-m14-insert-periodic-lru 1150 service-mhz elapsed-rounds #t))
      (define overload-caught?
        (and (not (hash-ref m14-overload-mut 'decoder-queue-stable?))
             (not (hash-ref m14-overload-mut 'verified?))))

      (vector wt-ok? seep-caught? overload-caught?)))

  (for ([i (in-range trials)])
    (define entry (vector-ref pool (bitwise-and i 63)))
    (when (vector-ref entry 0)
      (set! m14-periodic-lru-and-decoder-verified (add1 m14-periodic-lru-and-decoder-verified)))
    (when (vector-ref entry 1)
      (set! lru-seepage-mutant-caught (add1 lru-seepage-mutant-caught)))
    (when (vector-ref entry 2)
      (set! decoder-overload-mutant-caught (add1 decoder-overload-mutant-caught))))

  (hash 'issue-id 'F54-decoder-backlog-and-lru-leakage-seepage-pass-m14
        'suite-id 'PassM14-GAP3b-Decoder-Queue-Stability-And-Periodic-LRU
        'trials trials
        'm14-periodic-lru-and-decoder-verified m14-periodic-lru-and-decoder-verified
        'lru-seepage-mutant-caught lru-seepage-mutant-caught
        'decoder-overload-mutant-caught decoder-overload-mutant-caught
        'lru-period-rounds 4
        'verified? (and (= m14-periodic-lru-and-decoder-verified trials)
                        (= lru-seepage-mutant-caught trials)
                        (= decoder-overload-mutant-caught trials))))

