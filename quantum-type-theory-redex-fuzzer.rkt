  (define eff-cert
    (cond
      [(hash? cert-spec) cert-spec]
      [enforce-guard?
       (hash 'theorem-name 'thm_asap_parallel_critical_path_le_serial
             'uninterpreted-inequality-binders 0
             'parameterless-scalar-constant-defs 0
             'trivial-true-or-refl-conclusions 0
             'tautological-hypothesis-echos 0
             'vacuous-contradiction-premises 0
             'unused-circuit-ast-parameters 0
             'hardcoded-table-literal-theorems 0
             'unverified-sorry-or-axiom-holes 0
             'comparator-small-proof-gates<=11? #t)]
      [else
       ;; Mutant F131: injects uninterpreted inequality binder hypothesis (h_le : a <= b)
       ;; and parameterless scalar constant def (def c : Nat := 1088)
       (hash 'theorem-name 'thm_mutant_uninterpreted_binder_and_scalar_const
             'uninterpreted-inequality-binders 2
             'parameterless-scalar-constant-defs 3
             'trivial-true-or-refl-conclusions 0
             'tautological-hypothesis-echos 1
             'vacuous-contradiction-premises 0
             'unused-circuit-ast-parameters 1
             'hardcoded-table-literal-theorems 1
             'unverified-sorry-or-axiom-holes 0
             'comparator-small-proof-gates<=11? #f)]))
  (define p1-uninterp-ineq (hash-ref eff-cert 'uninterpreted-inequality-binders 0))
  (define p2-scalar-defs (hash-ref eff-cert 'parameterless-scalar-constant-defs 0))
  (define p3-trivial-concl (hash-ref eff-cert 'trivial-true-or-refl-conclusions 0))
  (define p4-hyp-echo (hash-ref eff-cert 'tautological-hypothesis-echos 0))
  (define p5-vacuous (hash-ref eff-cert 'vacuous-contradiction-premises 0))
  (define p6-unused-params (hash-ref eff-cert 'unused-circuit-ast-parameters 0))
  (define p7-hardcoded-lit (hash-ref eff-cert 'hardcoded-table-literal-theorems 0))
  (define p8-sorry-axiom (hash-ref eff-cert 'unverified-sorry-or-axiom-holes 0))
  (define comp-small-proof? (hash-ref eff-cert 'comparator-small-proof-gates<=11? #t))
  (define total-violations
    (+ p1-uninterp-ineq p2-scalar-defs p3-trivial-concl p4-hyp-echo
       p5-vacuous p6-unused-params p7-hardcoded-lit p8-sorry-axiom))
  (hash 'validator-id 'GRH-8-Pattern-Zero-Drift-Proof-Validator
        'theorem-name (hash-ref eff-cert 'theorem-name 'thm_verified)
        'uninterpreted-inequality-binders p1-uninterp-ineq
        'parameterless-scalar-constant-defs p2-scalar-defs
        'zero-uninterpreted-inequality-binders? (zero? p1-uninterp-ineq)
        'zero-parameterless-scalar-defs? (zero? p2-scalar-defs)
        'total-grh-pattern-violations total-violations
        'all-8-grh-patterns-clean? (zero? total-violations)
        'comparator-small-proof-valid? comp-small-proof?
        'grh-proof-drift-hazard? (or (> total-violations 0) (not comp-small-proof?))
        'verified? (and enforce-guard?
                        (zero? p1-uninterp-ineq)
                        (zero? p2-scalar-defs)
                        (zero? total-violations)
                        comp-small-proof?)))

