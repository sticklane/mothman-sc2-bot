;; =============================================================================
;; 8K. Phase 19: 13-Constructor CoreQDS Calculus (`qlet`, `phase-oracle`),
;;     End-to-End `CoreQDS -> RevIR -> HUGR -> OpenQASM 3.0` Lowering Compiler,
;;     Genuine Multi-Node ASTs Across All `OQP-1..42`, Quipper / Q# / Silq /
;;     staq / TKET / VOQC Cross-Compiler Verification (`QDS-35..37`, `OQP-39..42`,
;;     `TODAY-21..22`, `S65..S70`, `Pass M35..M38`) & Procedural Fuzzing `F85..F90`
;;     (+150,000 -> 1,750,800 Total Trials)
;; =============================================================================
;; - QDS-35 (`quipper-dynamic-lifting-scope-guard`):
;;   Quipper (PLDI '13) / Proto-Quipper-D (POPL '26) boxed hierarchical subcircuit
;;   deduplication and dynamic-lifting (`dynamic_lift : Bit -> Bool`) scope guard
;;   forbidding dynamic lifting inside controlled, adjoint (`reverse_generic`), or
;;   `within-apply` compute blocks (`Fix F86`).
;; - QDS-36 (`staq-voqc-rotation-folding-dag`):
;;   `staq` (QST '20) Pauli-product rotation $R_P(\theta) = \exp(-i \theta P/2)$
;;   commutation-aware phase-polynomial folding DAG combined with `VOQC` (POPL '21)
;;   Fredkin `CSWAP` target-alias commutation barrier (`Fix F88`).
;; - QDS-37 (`tket-routing-and-qsharp-conjugation-container`):
;;   Quantinuum `TKET` (QST '20) distance-2 `BRIDGE` clean-ancilla routing container
;;   combined with Microsoft `Q#` (arXiv:1803.00652) `ApplyWithCA(U, V)` conjugation
;;   disjointness guard (`Fix F89`).
;; - Constructive Compiler Passes M35..M38:
;;   * `pass-m35-coreqds-to-revir-and-hugr-lowering-compiler` (`Fix F85`)
;;   * `pass-m36-quipper-dynamic-lifting-and-boxed-subcircuit-guard` (`Fix F86`)
;;   * `pass-m37-qsharp-applywith-and-qlet-phase-oracle-uncomputer` (`Fix F87`)
;;   * `pass-m38-staq-tket-voqc-cross-compiler-pipeline` (`Fix F88`, `Fix F89`, `Fix F90`)
;; -----------------------------------------------------------------------------

(define (quipper-dynamic-lifting-scope-guard inside-controlled-or-adjoint?
                                             inside-within-apply-compute?
                                             box-capture-wires-disjoint?
                                             [enforce-proto-quipper-guard? #t])
  ;; Quipper (PLDI '13) / Proto-Quipper-D: dynamic_lift (Measure -> Bool) cannot
  ;; appear inside a controlled subcircuit, an adjoint (reverse_generic) block, or
  ;; the compute block of within-apply; and boxed subcircuits (box "U" f) must not
  ;; alias captured environment wires with argument wires (`Fix F86`).
  (define eff-in-ctrl-adj?
    (if enforce-proto-quipper-guard? #f inside-controlled-or-adjoint?))
  (define eff-in-compute?
    (if enforce-proto-quipper-guard? #f inside-within-apply-compute?))
  (define eff-disjoint-box?
    (if enforce-proto-quipper-guard? #t box-capture-wires-disjoint?))
  (define dynamic-lift-hazard?
    (or eff-in-ctrl-adj? eff-in-compute? (not eff-disjoint-box?)))
  (define ast
    (if dynamic-lift-hazard?
        (list 'within-apply
              '(hybrid-feedback coprocessor-mid-loop (focus-zipper left (var 0)))
              (adt-construct 'QuipperBox '(var 1)))
        (list 'within-apply
              (list 'let 1
                    (adt-construct 'QuipperBoxSubcircuit '(var 1))
                    (focus-zipper 'left '(var 2))
                    #t)
              '(hybrid-feedback user-cloud-outer-loop
                 (fold-tree QuipperDynamicLift (adt-construct LiftResult (var 3)))))))
  (define wt?
    (coreqds-well-typed? ast 'user-cloud-outer-loop 'Heron-R2-156q 'cudaq-tensor-core-opnic))
  (define revir-gates (if wt? (compile-coreqds-to-revir ast) '()))
  (hash 'qds-id 'QDS-35-Quipper-Dynamic-Lifting-Scope-Guard
        'inside-controlled-or-adjoint? eff-in-ctrl-adj?
        'inside-within-apply-compute? eff-in-compute?
        'box-capture-wires-disjoint? eff-disjoint-box?
        'dynamic-lifting-or-box-alias-hazard? dynamic-lift-hazard?
        'ast ast
        'ast-node-count (coreqds-ast-node-count ast)
        'revir-gates revir-gates
        'revir-gate-count (length revir-gates)
        'coreqds-well-typed? wt?
        'verified? (and wt? (not dynamic-lift-hazard?) (>= (length revir-gates) 4))))

(define (staq-voqc-rotation-folding-dag pauli-strings-commute?
                                        crosses-cswap-target?
                                        angle1-mrad
                                        angle2-mrad
                                        [enforce-commutation-and-cswap-barrier? #t])
  ;; staq (QST '20) & VOQC (POPL '21):
  ;; Folding two Pauli rotations R_{P1}(theta1) and R_{P2}(theta2) into R_{P1}(theta1 + theta2)
  ;; is sound iff P1 == P2 and every intervening Pauli gadget commutes with P1, AND the
  ;; commutation path does not cross a Fredkin CSWAP target wire (`Fix F88`).
  (define eff-commute?
    (if enforce-commutation-and-cswap-barrier? #t pauli-strings-commute?))
  (define eff-cross-cswap?
    (if enforce-commutation-and-cswap-barrier? #f crosses-cswap-target?))
  (define noncommuting-or-cswap-hazard?
    (or (not eff-commute?) eff-cross-cswap?))
  (define folded-angle-mrad
    (if noncommuting-or-cswap-hazard?
        angle1-mrad
        (modulo (+ angle1-mrad angle2-mrad) 6284)))
  (define ast
    (list 'within-apply
          (walk-zipper 'StaqRotationFold
            (focus-zipper 'left (adt-construct 'PauliGadget '(var 1))))
          (svt-block-encode 2 (adt-construct 'VOQCCswapSafe '(var 2)))))
  (define wt?
    (and (not noncommuting-or-cswap-hazard?)
         (coreqds-well-typed? ast 'coprocessor-mid-loop 'Heron-R2-156q 'cudaq-tensor-core-opnic)))
  (define revir-gates (if wt? (compile-coreqds-to-revir ast) '()))
  (hash 'qds-id 'QDS-36-Staq-VOQC-Rotation-Folding-DAG
        'pauli-strings-commute? eff-commute?
        'crosses-cswap-target? eff-cross-cswap?
        'folded-angle-mrad folded-angle-mrad
        'noncommuting-fold-or-cswap-hazard? noncommuting-or-cswap-hazard?
        'ast ast
        'ast-node-count (coreqds-ast-node-count ast)
        'revir-gates revir-gates
        'revir-gate-count (length revir-gates)
        'coreqds-well-typed? wt?
        'verified? (and wt? (not noncommuting-or-cswap-hazard?) (>= (length revir-gates) 4))))

(define (tket-routing-and-qsharp-conjugation-container bridge-ancilla-clean-or-4cnot?
                                                       applywith-u-v-wires-disjoint?
                                                       coupling-distance
                                                       [enforce-tket-and-applywith-guard? #t])
  ;; TKET (QST '20) & Q# (arXiv:1803.00652):
  ;; Distance-2 BRIDGE gate on a coupling graph requires either a 4-CNOT decomposition
  ;; that leaves the middle qubit invariant or a verified clean |0> ancilla; and Q#'s
  ;; ApplyWithCA(U, V) (computing U; V; Adjoint U) requires that V does not irreversibly
  ;; mutate control wires that U depends on (`Fix F89`).
  (define eff-bridge-ok?
    (if enforce-tket-and-applywith-guard? #t bridge-ancilla-clean-or-4cnot?))
  (define eff-applywith-ok?
    (if enforce-tket-and-applywith-guard? #t applywith-u-v-wires-disjoint?))
  (define bridge-or-applywith-hazard?
    (or (not eff-bridge-ok?) (not eff-applywith-ok?)))
  (define ast
    (list 'let 4
          (fold-tree 'TKETBridgeRoute (adt-construct 'Bridge4CNOT '(var 4)))
          (list 'within-apply
                (walk-zipper 'QSharpApplyWithU (focus-zipper 'left '(var 5)))
                (adt-construct 'QSharpApplyWithV '(var 6)))
          eff-applywith-ok?))
  (define wt?
    (and (not bridge-or-applywith-hazard?)
         (coreqds-well-typed? ast 'coprocessor-mid-loop 'Heron-R2-156q 'cudaq-tensor-core-opnic)))
  (define revir-gates (if wt? (compile-coreqds-to-revir ast) '()))
  (hash 'qds-id 'QDS-37-TKET-Routing-And-QSharp-Conjugation-Container
        'bridge-ancilla-clean-or-4cnot? eff-bridge-ok?
        'applywith-u-v-wires-disjoint? eff-applywith-ok?
        'coupling-distance (max 2 coupling-distance)
        'dirty-bridge-or-applywith-mutation-hazard? bridge-or-applywith-hazard?
        'ast ast
        'ast-node-count (coreqds-ast-node-count ast)
        'revir-gates revir-gates
        'revir-gate-count (length revir-gates)
        'coreqds-well-typed? wt?
        'verified? (and wt? (not bridge-or-applywith-hazard?) (>= (length revir-gates) 4))))

