         (if (eq? m2 'Superpos)
             (list-set uw1 c2 `(uwire ,m2 ,(anf-xor a2 (list (xphase-mono c2))) ,z2))
             uw1))
       (values 0 1 0 links uw2 ok?)]
      [(or `(g-ccx ,c1 ,c2 ,t) `(g-compute-and ,c1 ,c2 ,t) `(g-and-compute ,c1 ,c2 ,t)
           `(g-rccx ,c1 ,c2 ,t) `(g-rccx-dag ,c1 ,c2 ,t))
