(define (pass-m39-coreqds2-beta-env-and-multi-branch-qmatch-elaborator
         bound-var
         clauses
         [enforce-guard? #t])
  (define safe-var (max 1 (modulo (abs bound-var) 4)))
  (define eff-clauses
    (if enforce-guard?
        (list (list '(0 0) (focus-zipper 'left '(var 5)))
              (list '(0 1) (adt-construct 'Branch01 '(var 5)))
              (list '(1 0) (focus-zipper 'right '(var 5)))
              (list '(1 1) (adt-construct 'Branch11 '(var 5))))
        clauses))
  (define pat-list (map first eff-clauses))
  (define ortho? (patterns-pairwise-orthogonal? pat-list))
  (define exhaust? (patterns-exhaustive? pat-list))
  (define ast
    (list 'app
          (list 'fn safe-var
                (fold-tree '(var 7)
                            (list 'match (list 'var safe-var) eff-clauses)
                            '(var 6)))
          (walk-zipper 2
                        (focus-zipper 'left '(var 2))
                        (focus-zipper 'right '(var 3))
                        '(var 4))))
  (define norm-ast (beta-normalize-coreqds ast))
  (define env-res (compile-coreqds-env-lowered '(var 2) (hash 2 2) 16))
  (define wt?
    (coreqds-strict-well-typed?
     norm-ast '(1 2 3 4 5 6 7 8) 'coprocessor-mid-loop 'Heron-R2-156q 'cudaq-tensor-core-opnic))
  (define revir-gates (if wt? (compile-coreqds-to-revir norm-ast) '()))
  (define netlist-check (if wt? (verify-compiled-revir-netlist revir-gates) (hash 'verified? #f 'gate-count 0)))
  (hash 'pass-id 'M39-CoreQDS2-Beta-Env-And-Multi-Branch-QMatch-Elaborator
        'orthogonal-clauses? ortho?
        'exhaustive-clauses? exhaust?
        'spurious-qvar-gates (hash-ref env-res 'spurious-qvar-gates)
        'ast ast
        'beta-normalized-ast norm-ast
        'ast-node-count (coreqds-ast-node-count norm-ast)
        'revir-gates revir-gates
        'revir-gate-count (hash-ref netlist-check 'gate-count)
        'coreqds-strict-well-typed? wt?
        'verified? (and wt?
                        ortho?
                        exhaust?
                        (zero? (hash-ref env-res 'spurious-qvar-gates))
                        (hash-ref netlist-check 'verified?)
                        (>= (hash-ref netlist-check 'gate-count) 6))))

(define (s71-coreqds2-beta-env-and-multi-branch-qmatch-guard bound-var clauses [enforce-guard? #t])
  (pass-m39-coreqds2-beta-env-and-multi-branch-qmatch-elaborator bound-var clauses enforce-guard?))

(define (s72-coreqds2-qfree-arithmetic-and-computed-basis-port-guard
         qfree-pred-ast
         in-vecs
         out-vecs
         in-ports
         out-ports
         [enforce-guard? #t])
  (define eff-pred
    (if enforce-guard?
        (qeq (qadd-mod (qxor '(var 1) (qconst 1))
                       (qand '(var 2) (qnot '(var 3)))
                       16)
             (qlt '(var 1) '(var 2)))
        qfree-pred-ast))
  (define eff-in-vecs (if enforce-guard? '((1 0) (0 1)) in-vecs))
  (define eff-out-vecs (if enforce-guard? '((1 1) (1 -1)) out-vecs))
  (define eff-in-ports (if enforce-guard? '(1 2 3 4) in-ports))
  (define eff-out-ports (if enforce-guard? '(1 2 3 4) out-ports))
  (define qfree-ok? (qfree-expr? eff-pred))
  (define basis-ok? (basis-vectors-orthogonal-and-complete? eff-in-vecs eff-out-vecs))
  (define ast
    (hugr-tailloop-ports
     eff-in-ports eff-out-ports '(5 6) '(5 6) 1
     (list 'within-apply
           (basis-translate-vecs eff-in-vecs eff-out-vecs)
           (phase-oracle eff-pred 12 'coprocessor-mid-loop))))
  (define wt?
    (coreqds-strict-well-typed?
     ast '(1 2 3 4 5 6 7 8 12) 'coprocessor-mid-loop 'Heron-R2-156q 'cudaq-tensor-core-opnic))
  (define revir-gates (if wt? (compile-coreqds-to-revir ast) '()))
  (define netlist-check (if wt? (verify-compiled-revir-netlist revir-gates) (hash 'verified? #f 'gate-count 0)))
  (hash 'suite-id 'S72-CoreQDS2-Qfree-Arithmetic-And-Computed-Basis-Port-Guard
        'qfree-expr? qfree-ok?
        'computed-basis-valid? basis-ok?
        'ast ast
        'ast-node-count (coreqds-ast-node-count ast)
        'revir-gates revir-gates
        'revir-gate-count (hash-ref netlist-check 'gate-count)
        'coreqds-strict-well-typed? wt?
        'verified? (and wt?
                        qfree-ok?
                        basis-ok?
                        (hash-ref netlist-check 'verified?)
                        (>= (hash-ref netlist-check 'gate-count) 6))))

(define (pass-m40-coreqds2-twist-entanglement-purity-and-slice-borrow-verifier
         uncompute-qlet?
         arr-len
         off1 len1
         off2 len2
         [enforce-guard? #t])
  (define eff-unc? (if enforce-guard? #t uncompute-qlet?))
  (define eff-off1 (if enforce-guard? 0 off1))
  (define eff-len1 (if enforce-guard? 4 len1))
  (define eff-off2 (if enforce-guard? 4 off2))
  (define eff-len2 (if enforce-guard? 4 len2))
  (define eff-arr (if enforce-guard? (max 8 arr-len) arr-len))
  (define ast
    (list 'let 1
          (qand '(var 1) '(var 2))
          (list 'within-apply
                (focus-zipper 'left '(var 3))
                (adt-construct 'PureSlice '(var 4)))
          eff-unc?))
  (define purity-res (coreqds-entanglement-purity-check ast '(1 2 3 4) '(16 17 18 19)))
  (define borrow-res (verify-qarray-slice-borrow eff-arr eff-off1 eff-len1 eff-off2 eff-len2 1 1))
  (define wt?
    (coreqds-strict-well-typed?
     ast '(1 2 3 4 5 6 7 8) 'coprocessor-mid-loop 'Heron-R2-156q 'cudaq-tensor-core-opnic))
  (hash 'pass-id 'M40-CoreQDS2-Twist-Entanglement-Purity-And-Slice-Borrow-Verifier
        'ast ast
        'separable-pure-at-exit? (hash-ref purity-res 'separable-pure-at-exit?)
        'schmidt-rank (hash-ref purity-res 'schmidt-rank)
        'disjoint-slices? (hash-ref borrow-res 'disjoint-slices?)
        'presburger-vc-discharged? (hash-ref borrow-res 'presburger-vc-discharged?)
        'coreqds-strict-well-typed? wt?
        'verified? (and wt?
                        (hash-ref purity-res 'verified?)
                        (hash-ref borrow-res 'verified?))))

(define (s73-coreqds2-twist-purity-and-presburger-slice-borrow-guard
         uncompute-qlet? arr-len off1 len1 off2 len2 [enforce-guard? #t])
  (pass-m40-coreqds2-twist-entanglement-purity-and-slice-borrow-verifier
   uncompute-qlet? arr-len off1 len1 off2 len2 enforce-guard?))

(define (s74-coreqds2-qdata-inductive-decl-and-surface-parser-roundtrip-guard
         qdata-decl
         surface-prog
         [enforce-guard? #t])
  (define eff-decl
    (if enforce-guard?
        '(data-decl BraunTree ((Leaf Qubit) (Node BraunTree Qubit BraunTree)))
        qdata-decl))
  (define eff-surface
    (if enforce-guard?
        '(surface-let-qfree 1
           (surface-xor (surface-wire 1) (surface-const 1))
           (surface-within
             (surface-focus left (surface-wire 2))
             apply
             (surface-qmatch (surface-wire 3)
               (((0) -> (surface-adt Leaf (surface-wire 4)))
                ((1) -> (surface-adt Node (surface-wire 4)))))))
        surface-prog))
  (define decl-res (verify-qdata-inductive-decl eff-decl))
  (define parsed-ast (parse-surface-coreqds eff-surface))
  (define unparsed-sexp (unparse-surface-coreqds parsed-ast))
  (define reparsed-ast (parse-surface-coreqds unparsed-sexp))
  (define roundtrip-eq? (equal? parsed-ast reparsed-ast))
  (define wt?
    (coreqds-strict-well-typed?
     parsed-ast '(1 2 3 4 5 6 7 8) 'coprocessor-mid-loop 'Heron-R2-156q 'cudaq-tensor-core-opnic))
  (hash 'suite-id 'S74-CoreQDS2-QData-Inductive-Decl-And-Surface-Parser-Roundtrip-Guard
        'qdata-verified? (hash-ref decl-res 'verified?)
        'strictly-positive? (hash-ref decl-res 'strictly-positive?)
        'parsed-ast parsed-ast
        'roundtrip-isomorphic? roundtrip-eq?
        'coreqds-strict-well-typed? wt?
        'verified? (and (hash-ref decl-res 'verified?)
                        roundtrip-eq?
                        wt?)))

(define (oqp43-coreqds2-multi-branch-qmatch-and-qfree-oracle-grover [enforce-guard? #t])
  (define m39 (pass-m39-coreqds2-beta-env-and-multi-branch-qmatch-elaborator 1 '() enforce-guard?))
  (define s72 (s72-coreqds2-qfree-arithmetic-and-computed-basis-port-guard #f '() '() '() '() enforce-guard?))
  (define combined-ast
    (list 'within-apply
          (hash-ref m39 'beta-normalized-ast)
          (hash-ref s72 'ast)))
  (define revir-gates (if enforce-guard? (compile-coreqds-to-revir combined-ast) '()))
  (hash 'oqp-id 'OQP-43-CoreQDS2-Multi-Branch-QMatch-And-Qfree-Oracle-Grover
        'ast combined-ast
        'ast-node-count (coreqds-ast-node-count combined-ast)
        'revir-gates revir-gates
        'revir-gate-count (length revir-gates)
        'verified? (and (hash-ref m39 'verified?)
                        (hash-ref s72 'verified?)
                        (>= (length revir-gates) 8))))

(define (oqp44-coreqds2-qdata-inductive-twist-purity-and-slice-borrow [enforce-guard? #t])
  (define m40 (pass-m40-coreqds2-twist-entanglement-purity-and-slice-borrow-verifier
               enforce-guard? 16 0 4 4 4 enforce-guard?))
  (define s74 (s74-coreqds2-qdata-inductive-decl-and-surface-parser-roundtrip-guard '() '() enforce-guard?))
  (define combined-ast
