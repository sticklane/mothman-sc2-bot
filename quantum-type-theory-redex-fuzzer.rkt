;; -----------------------------------------------------------------------------
;; QDS-14 (`realtime-quantum-queue`):
;; Okasaki Real-Time Queue `(F, R, S)` with Incremental Lazy Rotation Schedule S.
;; - In `'realtime` mode, invariant `|S| = |F| - |R|` advances the rotation schedule
;;   by at most `2` constant-time pointer/CSWAP ticks per `snoc`/`tail` step
;;   (`worst-case-ticks = 2`), guaranteeing branch-uniform timing in superposition.
;; - In `'bankers-amortized` mode, when `|F| < |R|` on one branch of a quantum
;;   superposition (`in-superpos? = #t`), reversing `R` spikes to `O(N)` ticks
;;   (`worst-case-ticks = (+ f-len r-len)`), leaking branch length via clock/idle
;;   decoherence (`Issue F47a`).
;; -----------------------------------------------------------------------------
(define (realtime-quantum-queue f-len r-len sched-len in-superpos? [mode 'realtime])
  (define inv-holds?
    (and (eq? mode 'realtime)
         (>= f-len r-len)
         (= sched-len (- f-len r-len))))
  (define worst-case-ticks
    (if inv-holds?
        2
        (max 2 (+ f-len r-len))))
  (define superposition-clock-spike?
    (and in-superpos? (> worst-case-ticks 2)))
  (hash 'qds-id 'QDS-14-RealTime-Quantum-Queue
        'mode mode
        'f-len f-len
        'r-len r-len
        'sched-len sched-len
        'in-superpos? in-superpos?
        'schedule-invariant-holds? inv-holds?
        'worst-case-ticks worst-case-ticks
        'superposition-clock-spike? superposition-clock-spike?
        'constant-time-coherent? (and inv-holds? (= worst-case-ticks 2) (not superposition-clock-spike?))))

;; -----------------------------------------------------------------------------
;; QDS-15 (`egraph-quantum-container`):
;; Equality-Saturation / `DialEgg` Reversible E-Graph Container with Topological
;; Rank Witness (`child-rank < parent-rank`).
;; - Enforces strict rank decrease `child-rank < parent-rank` and rejects self-inverse
;;   commutation cycles (`CNOT ; CNOT` or `RCCX ; RCCX-dag` expansion loops),
;;   guaranteeing strongly normalizing e-graph extraction (`Issue F47b`).
;; -----------------------------------------------------------------------------
(define (egraph-quantum-container parent-rank child-rank [self-inverse-loop? #f])
  (define rank-decreases? (< child-rank parent-rank))
  (define acyclic-terminating? (and rank-decreases? (not self-inverse-loop?)))
  (hash 'qds-id 'QDS-15-EGraph-Quantum-Container
        'parent-rank parent-rank
        'child-rank child-rank
        'rank-delta (- parent-rank child-rank)
        'rank-decreases? rank-decreases?
        'self-inverse-loop? self-inverse-loop?
        'acyclic-terminating? acyclic-terminating?))

;; -----------------------------------------------------------------------------
;; QDS-16 (`orthogonal-case-zipper`):
;; Qunity-Style Superposed Pattern-Matching Zipper with Disjoint & Exhaustive
;; Orthogonal Projector Masks (`focus-mask`, `complement-mask`, `domain-mask`)
;; and Clean Branch-Ancilla Uncomputation (`branch-ancilla-residual = 0`).
;; - Prevents non-unitary amplitude norm blowup / collapse when case-splitting in
;;   quantum superposition (`Issue F45`).
;; -----------------------------------------------------------------------------
(define (orthogonal-case-zipper focus-mask complement-mask domain-mask [branch-ancilla-residual 0])
  (define disjoint-projectors? (= (bitwise-and focus-mask complement-mask) 0))
  (define exhaustive-partition?
    (and (> domain-mask 0)
         (= (bitwise-ior focus-mask complement-mask) domain-mask)))
  (define clean-ancilla-uncompute? (= branch-ancilla-residual 0))
  (hash 'qds-id 'QDS-16-Orthogonal-Case-Zipper
        'focus-mask focus-mask
        'complement-mask complement-mask
        'domain-mask domain-mask
        'branch-ancilla-residual branch-ancilla-residual
        'disjoint-projectors? disjoint-projectors?
        'exhaustive-partition? exhaustive-partition?
        'clean-ancilla-uncompute? clean-ancilla-uncompute?
        'orthogonal-unitary? (and disjoint-projectors?
                                  exhaustive-partition?
                                  clean-ancilla-uncompute?)))

