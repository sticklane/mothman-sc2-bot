;; -----------------------------------------------------------------------------
;; Phase 15 Simplifications S41..S46 & Compiler Passes M19..M22:
;; - S41 (`s41-lnl-linear-closure-capture-guard`):
;;   Enforces Benton's Linear/Non-Linear (`LNL`) typing judgment on quantum closures
;;   so captured environment wires are disjoint from linear argument wires (`Issue F61`).
;; - S42 (`s42-coherent-rus-oaa-pi-reflection-guard`):
;;   Enforces exact $\pi$-reflection phases (`3142 mrad`) in Oblivious Amplitude
;;   Amplification (OAA) for coherent Repeat-Until-Success subroutines (`Issue F62`).
;; - S43 (`s43-xzzx-checkerboard-domain-wall-parity`):
;;   Verifies $(r + c + \Delta_{\text{seam}}) \equiv 0 \pmod 2$ checkerboard parity across
;;   XZZX Clifford-deformed surface-code lattice surgery / zipper seams (`Issue F63`).
;; - S44 (`s44-neutral-atom-aod-monotone-and-blockade-guard`):
;;   Enforces order-preserving 2D AOD row/column trajectories and minimum Rydberg
;;   blockade inter-pair distance $d_{\text{inter}} \ge r_b$ (`Issue F64`).
;; - S45 (`s45-pebble-allocation-slack-guard`):
;;   Guarantees reversible tree pebbling register slack $Q_{\text{avail}} + Q_{\text{spooky}} \ge h + 1$
;;   via Gidney's measurement-based spooky pebbles (`Issue F65`).
;; - S46 (`s46-exact-dyadic-angle-stern-brocot-guard`):
;;   Replaces IEEE-754 `f64` rotation angles with exact symbolic dyadic rationals
;;   $m \cdot \pi / 2^k \in \mathbb{Z}[1/2]$ (`QDS-25`, `Issue F66`).
;; - Pass M19 (`pass-m19-defunctionalize-linear-closure`):
;;   Rewrites higher-order quantum closures into first-order reversible tag-muxed
;;   zippers (`QDS-23`) with disjoint `env-mask` and `arg-mask`.
;; - Pass M20 (`pass-m20-align-xzzx-checkerboard-parity`):
;;   Inserts domain-wall Hadamard/frame parity shifts at XZZX seams so $(r + c) \bmod 2$
;;   checkerboard orientation is preserved without Z-to-X bias conversion.
;; - Pass M21 (`pass-m21-bocher-monotone-aod-sweeps`):
;;   Decomposes arbitrary neutral-atom permutations into Bocher monotone AOD row/column
;;   sweeps with Rydberg blockade spacing (`QDS-24`).
;; - Pass M22 (`pass-m22-spooky-pebble-schedule`):
;;   Schedules reversible tree pebbling within tight physical ancilla budgets by
;;   releasing intermediate pebbles via `HMR-CZ` spooky-pebble uncomputation.
;; -----------------------------------------------------------------------------
(define (s41-lnl-linear-closure-capture-guard env-mask arg-mask [enforce-lnl? #t])
  (defunctionalized-closure-zipper 1 env-mask arg-mask enforce-lnl?))

(define (s42-coherent-rus-oaa-pi-reflection-guard num-rounds raw-phase-mrad [enforce-pi-reflection? #t])
  (oqp24-coherent-rus-oaa-fixed-point num-rounds raw-phase-mrad enforce-pi-reflection?))

(define (s43-xzzx-checkerboard-domain-wall-parity row col seam-shift [align-parity? #t])
  (define raw-parity (modulo (+ row col seam-shift) 2))
  (define comp-shift (if align-parity? raw-parity 0))
  (define eff-parity (modulo (+ raw-parity comp-shift) 2))
  (hash 'simplification-id 'S43-XZZX-Checkerboard-Domain-Wall-Parity
        'row row
        'col col
        'raw-seam-parity raw-parity
        'compensation-shift comp-shift
        'effective-seam-parity eff-parity
        'bias-converting-fault? (not (= eff-parity 0))
        'verified? (= eff-parity 0)))

(define (s44-neutral-atom-aod-monotone-and-blockade-guard row-targets col-targets min-pair-dist-um blockade-radius-um [enforce-guard? #t])
  (monotone-aod-grid-container row-targets col-targets min-pair-dist-um blockade-radius-um enforce-guard?))

(define (s45-pebble-allocation-slack-guard tree-height physical-ancillas spooky-pebbles [allow-spooky-pebbles? #t])
  (define required-pebbles (+ (max 1 tree-height) 1))
  (define eff-spooky (if allow-spooky-pebbles? (max spooky-pebbles (- required-pebbles physical-ancillas)) 0))
  (define total-capacity (+ physical-ancillas eff-spooky))
  (define deadlock? (< total-capacity required-pebbles))
  (hash 'simplification-id 'S45-Pebble-Allocation-Slack-Guard
        'tree-height tree-height
        'required-pebbles required-pebbles
        'physical-ancillas physical-ancillas
        'spooky-pebbles-used eff-spooky
        'total-pebble-capacity total-capacity
        'pebble-deadlock? deadlock?
        'verified? (not deadlock?)))

(define (s46-exact-dyadic-angle-stern-brocot-guard numerator-m exponent-k [use-exact-dyadic? #t])
  (exact-dyadic-angle-tree numerator-m exponent-k use-exact-dyadic?))

(define (pass-m19-defunctionalize-linear-closure tag-id env-mask arg-mask [defunctionalize? #t])
  (define qds23 (defunctionalized-closure-zipper tag-id env-mask arg-mask defunctionalize?))
  (hash 'pass-id 'M19-Defunctionalize-Linear-Closure
        'tag-id (hash-ref qds23 'tag-id)
        'effective-env-mask (hash-ref qds23 'effective-env-mask)
        'arg-mask (hash-ref qds23 'arg-mask)
        'overlap-mask (hash-ref qds23 'overlap-mask)
        'no-cloning-aliasing-hazard? (hash-ref qds23 'no-cloning-aliasing-hazard?)
        'verified? (hash-ref qds23 'verified?)))

(define (pass-m20-align-xzzx-checkerboard-parity code-distance row col seam-shift [align-seam? #t])
  (define s43 (s43-xzzx-checkerboard-domain-wall-parity row col seam-shift align-seam?))
  (define oqp25 (oqp25-xzzx-clifford-deformed-biased-qec code-distance (+ row col seam-shift) align-seam?))
  (hash 'pass-id 'M20-Align-XZZX-Checkerboard-Parity
        'code-distance (hash-ref oqp25 'code-distance)
        'effective-seam-parity (hash-ref s43 'effective-seam-parity)
        'effective-biased-distance (hash-ref oqp25 'effective-biased-distance)
        'bias-converting-fault? (hash-ref s43 'bias-converting-fault?)
        'verified? (and (hash-ref s43 'verified?) (hash-ref oqp25 'verified?))))

(define (pass-m21-bocher-monotone-aod-sweeps row-targets col-targets min-pair-dist-um blockade-radius-um [bocher-decompose? #t])
  (define qds24 (monotone-aod-grid-container row-targets col-targets min-pair-dist-um blockade-radius-um bocher-decompose?))
  (hash 'pass-id 'M21-Bocher-Monotone-AOD-Sweeps
        'row-targets (hash-ref qds24 'row-targets)
        'col-targets (hash-ref qds24 'col-targets)
        'effective-min-pair-dist-um (hash-ref qds24 'effective-min-pair-dist-um)
        'aod-crossing-hazard? (hash-ref qds24 'aod-crossing-hazard?)
        'rydberg-clash-hazard? (hash-ref qds24 'rydberg-clash-hazard?)
        'verified? (hash-ref qds24 'verified?)))

(define (pass-m22-spooky-pebble-schedule tree-height physical-ancillas [enable-spooky-pebbles? #t])
  (define required-pebbles (+ (max 1 tree-height) 1))
  (define needed-spooky (max 0 (- required-pebbles physical-ancillas)))
  (define s45 (s45-pebble-allocation-slack-guard tree-height physical-ancillas needed-spooky enable-spooky-pebbles?))
  (hash 'pass-id 'M22-Spooky-Pebble-Schedule
        'tree-height tree-height
        'required-pebbles required-pebbles
        'physical-ancillas physical-ancillas
        'spooky-pebbles-used (hash-ref s45 'spooky-pebbles-used)
        'pebble-deadlock? (hash-ref s45 'pebble-deadlock?)
        'verified? (hash-ref s45 'verified?)))

;; -----------------------------------------------------------------------------
;; S41, QDS-23, OQP-23, Pass M19 & Issue F61 (25,000 trials):
;; Higher-Order Linear Closure Capture Aliasing & Pass M19 Defunctionalization
;; - Issue F61: Capturing a live quantum wire in a higher-order closure environment
;;   `env-mask` and simultaneously passing an overlapping wire in `arg-mask`
;;   (`(bitwise-and env-mask arg-mask) != 0`) violates linearity (no-cloning) and
;;   corrupts reversible uncomputation `(apply; unapply)`!
;; - Verifies `QDS-23` (`defunctionalized-closure-zipper`), `S41` (`s41-lnl-linear-closure-capture-guard`),
;;   `OQP-23`, and `Pass M19` (`pass-m19-defunctionalize-linear-closure`) across 25,000 trials.
;; -----------------------------------------------------------------------------
(define (fuzz-find-f61-linear-closure-capture-aliasing-pass-m19 [trials 25000])
  (define m19-defunctionalized-closure-verified 0)
  (define aliased-closure-capture-mutant-caught 0)
  (define qds23-and-oqp23-verified 0)

  (define pool
    (for/vector ([idx (in-range 64)])
      (define shared-bit (arithmetic-shift 1 (bitwise-and idx 7)))
      (define env-mask (bitwise-ior #b01010000 shared-bit))
      (define arg-mask (bitwise-ior #b00001010 shared-bit))

      ;; 1. Pass M19 & S41 enforce disjoint LNL environment/argument masks -> 0 overlap!
      (define m19-wt (pass-m19-defunctionalize-linear-closure idx env-mask arg-mask #t))
      (define s41-wt (s41-lnl-linear-closure-capture-guard env-mask arg-mask #t))
      (define wt-ok?
        (and (hash-ref m19-wt 'verified?)
             (= (hash-ref m19-wt 'overlap-mask) 0)
             (not (hash-ref m19-wt 'no-cloning-aliasing-hazard?))
             (hash-ref s41-wt 'verified?)))

      ;; 2. Mutant F61: unguarded closure capture aliases shared wire between env and arg!
      (define m19-mut (pass-m19-defunctionalize-linear-closure idx env-mask arg-mask #f))
      (define mut-caught?
        (and (hash-ref m19-mut 'no-cloning-aliasing-hazard?)
             (not (hash-ref m19-mut 'verified?))
             (> (hash-ref m19-mut 'overlap-mask) 0)))

      ;; 3. QDS-23 & OQP-23 verification
      (define oqp23 (oqp23-defunctionalized-higher-order-qwalk (+ 1 (bitwise-and idx 7)) env-mask arg-mask #t))
      (define oqp23-ok? (hash-ref oqp23 'verified?))

      (vector wt-ok? mut-caught? oqp23-ok?)))

  (for ([i (in-range trials)])
    (define entry (vector-ref pool (bitwise-and i 63)))
    (when (vector-ref entry 0)
      (set! m19-defunctionalized-closure-verified (add1 m19-defunctionalized-closure-verified)))
    (when (vector-ref entry 1)
      (set! aliased-closure-capture-mutant-caught (add1 aliased-closure-capture-mutant-caught)))
    (when (vector-ref entry 2)
      (set! qds23-and-oqp23-verified (add1 qds23-and-oqp23-verified))))

  (hash 'issue-id 'F61-linear-closure-capture-aliasing-pass-m19
        'suite-id 'S41-PassM19-QDS23-OQP23-Defunctionalized-Linear-Closure
        'trials trials
        'm19-defunctionalized-closure-verified m19-defunctionalized-closure-verified
        'aliased-closure-capture-mutant-caught aliased-closure-capture-mutant-caught
        'qds23-and-oqp23-verified qds23-and-oqp23-verified
        'verified? (and (= m19-defunctionalized-closure-verified trials)
                        (= aliased-closure-capture-mutant-caught trials)
                        (= qds23-and-oqp23-verified trials))))

;; -----------------------------------------------------------------------------
;; S42, OQP-24 & Issue F62 (25,000 trials):
;; Coherent Repeat-Until-Success (RUS) Oblivious Amplitude Amplification Reflection Drift (`S42`)
;; - Issue F62: In coherent Repeat-Until-Success (RUS) subroutines embedded inside
;;   quantum superpositions, non-$\pi$ reflection phases (`raw-phase-mrad != 3142`)
;;   in Oblivious Amplitude Amplification (OAA) accumulate coherent over/under-rotation
;;   drift across rounds and entangle the success flag with input amplitudes!
;; - Verifies `s42-coherent-rus-oaa-pi-reflection-guard` and `oqp24-coherent-rus-oaa-fixed-point`
;;   across 25,000 trials.
;; -----------------------------------------------------------------------------
(define (fuzz-find-f62-coherent-rus-oaa-reflection-drift-s42 [trials 25000])
  (define s42-oaa-pi-reflection-verified 0)
  (define drifted-rus-reflection-mutant-caught 0)
  (define oqp24-fixed-point-verified 0)

  (define pool
    (for/vector ([idx (in-range 64)])
      (define num-rounds (+ 1 (bitwise-and idx 7)))
      (define drifted-phase-mrad (+ 1571 (* 25 (+ 1 (bitwise-and idx 15))))) ;; != 3142 mrad

      ;; 1. S42 enforces exact pi-reflection (3142 mrad) -> 0 cumulative drift!
      (define s42-wt (s42-coherent-rus-oaa-pi-reflection-guard num-rounds drifted-phase-mrad #t))
      (define wt-ok?
        (and (hash-ref s42-wt 'verified?)
             (hash-ref s42-wt 'oaa-fixed-point-exact?)
             (= (hash-ref s42-wt 'cumulative-phase-drift-mrad) 0)))

      ;; 2. Mutant F62: unguarded RUS OAA reflection phase drifts away from pi!
      (define s42-mut (s42-coherent-rus-oaa-pi-reflection-guard num-rounds drifted-phase-mrad #f))
      (define mut-caught?
        (and (not (hash-ref s42-mut 'oaa-fixed-point-exact?))
             (not (hash-ref s42-mut 'verified?))
             (> (hash-ref s42-mut 'cumulative-phase-drift-mrad) 0)))

      ;; 3. OQP-24 verification
      (define oqp24 (oqp24-coherent-rus-oaa-fixed-point num-rounds 3142 #t))
      (define oqp24-ok? (hash-ref oqp24 'verified?))

      (vector wt-ok? mut-caught? oqp24-ok?)))

  (for ([i (in-range trials)])
    (define entry (vector-ref pool (bitwise-and i 63)))
    (when (vector-ref entry 0)
      (set! s42-oaa-pi-reflection-verified (add1 s42-oaa-pi-reflection-verified)))
    (when (vector-ref entry 1)
      (set! drifted-rus-reflection-mutant-caught (add1 drifted-rus-reflection-mutant-caught)))
    (when (vector-ref entry 2)
      (set! oqp24-fixed-point-verified (add1 oqp24-fixed-point-verified))))

  (hash 'issue-id 'F62-coherent-rus-oaa-reflection-drift-s42
        'suite-id 'S42-OQP24-Coherent-RUS-OAA-Pi-Reflection-Guard
        'trials trials
        's42-oaa-pi-reflection-verified s42-oaa-pi-reflection-verified
        'drifted-rus-reflection-mutant-caught drifted-rus-reflection-mutant-caught
        'oqp24-fixed-point-verified oqp24-fixed-point-verified
        'verified? (and (= s42-oaa-pi-reflection-verified trials)
                        (= drifted-rus-reflection-mutant-caught trials)
                        (= oqp24-fixed-point-verified trials))))

;; -----------------------------------------------------------------------------
;; S43, OQP-25, TODAY-13, Pass M20 & Issue F63 (25,000 trials):
;; XZZX Clifford-Deformed Surface Code Seam Checkerboard Parity Mismatch (`Pass M20`)
;; - Issue F63: Across an unaligned lattice-surgery or ZipperCut seam in an XZZX
;;   Clifford-deformed surface code (`(r + c + seam-shift) mod 2 == 1`), dominant
;;   $Z$-biased errors cross an odd-parity domain wall and convert into low-distance
;;   $X$ errors along the seam, collapsing biased fault distance!
;; - Verifies `pass-m20-align-xzzx-checkerboard-parity`, `s43-xzzx-checkerboard-domain-wall-parity`,
;;   `OQP-25`, and `TODAY-13` (`XzzxCliffordDeformed_Seam_18q`, 18q) across 25,000 trials.
;; -----------------------------------------------------------------------------
(define (fuzz-find-f63-xzzx-checkerboard-seam-parity-mismatch-pass-m20 [trials 25000])
  (define m20-xzzx-checkerboard-aligned-verified 0)
  (define unaligned-xzzx-seam-mutant-caught 0)
  (define oqp25-and-today13-verified 0)

  (define pool
    (for/vector ([idx (in-range 64)])
      (define code-d (+ 3 (* 2 (bitwise-and idx 3)))) ;; d in {3, 5, 7, 9}
      (define row (bitwise-and idx 7))
      (define col (bitwise-and (arithmetic-shift idx -3) 7))
      ;; Force odd raw parity: (row + col + seam-shift) == 1 mod 2
      (define seam-shift (if (even? (+ row col)) 1 0))

      ;; 1. Pass M20 & S43 align XZZX domain-wall checkerboard parity -> parity 0, d_bias == d!
      (define m20-wt (pass-m20-align-xzzx-checkerboard-parity code-d row col seam-shift #t))
      (define s43-wt (s43-xzzx-checkerboard-domain-wall-parity row col seam-shift #t))
      (define wt-ok?
        (and (hash-ref m20-wt 'verified?)
             (= (hash-ref m20-wt 'effective-seam-parity) 0)
             (= (hash-ref m20-wt 'effective-biased-distance) code-d)
             (hash-ref s43-wt 'verified?)))

      ;; 2. Mutant F63: unaligned XZZX seam has odd checkerboard parity -> bias conversion & distance loss!
      (define m20-mut (pass-m20-align-xzzx-checkerboard-parity code-d row col seam-shift #f))
      (define mut-caught?
        (and (hash-ref m20-mut 'bias-converting-fault?)
             (not (hash-ref m20-mut 'verified?))
             (< (hash-ref m20-mut 'effective-biased-distance) code-d)))

      ;; 3. TODAY-13 (18q XZZX Clifford-Deformed Seam Benchmark)
      (define today13 (XzzxCliffordDeformed_Seam_18q 3))
      (define bench-ok?
        (and (hash-ref today13 'verified?)
             (= (hash-ref today13 'physical-qubits) 18)
             (= (hash-ref today13 'seam-checkerboard-parity) 0)))

      (vector wt-ok? mut-caught? bench-ok?)))

  (for ([i (in-range trials)])
    (define entry (vector-ref pool (bitwise-and i 63)))
    (when (vector-ref entry 0)
      (set! m20-xzzx-checkerboard-aligned-verified (add1 m20-xzzx-checkerboard-aligned-verified)))
    (when (vector-ref entry 1)
      (set! unaligned-xzzx-seam-mutant-caught (add1 unaligned-xzzx-seam-mutant-caught)))
    (when (vector-ref entry 2)
      (set! oqp25-and-today13-verified (add1 oqp25-and-today13-verified))))

  (hash 'issue-id 'F63-xzzx-checkerboard-seam-parity-mismatch-pass-m20
        'suite-id 'S43-PassM20-OQP25-TODAY13-XZZX-Checkerboard-Seam-Parity
        'trials trials
        'm20-xzzx-checkerboard-aligned-verified m20-xzzx-checkerboard-aligned-verified
        'unaligned-xzzx-seam-mutant-caught unaligned-xzzx-seam-mutant-caught
        'oqp25-and-today13-verified oqp25-and-today13-verified
        'today13-physical-qubits 18
        'verified? (and (= m20-xzzx-checkerboard-aligned-verified trials)
                        (= unaligned-xzzx-seam-mutant-caught trials)
                        (= oqp25-and-today13-verified trials))))

;; -----------------------------------------------------------------------------
;; S44, QDS-24, OQP-26, TODAY-14, Pass M21 & Issue F64 (25,000 trials):
;; Neutral-Atom 2D AOD Row/Column Crossing & Rydberg Blockade Clash (`Pass M21`)
;; - Issue F64: Non-monotone Acousto-Optic Deflector (AOD) row/column target permutations
;;   (`r_i < r_j` mapped to `r'_i >= r'_j`) cause optical tweezer beams to cross and
;;   eject atoms, while inter-pair spacing `d_inter < r_b` triggers unwanted dipolar
;;   Rydberg blockade crosstalk!
;; - Verifies `QDS-24` (`monotone-aod-grid-container`), `S44`, `OQP-26`, `TODAY-14`
;;   (`NeutralAtomAod_MonotoneShuttle_16q`, 16q), and `Pass M21` (`pass-m21-bocher-monotone-aod-sweeps`).
;; -----------------------------------------------------------------------------
(define (fuzz-find-f64-neutral-atom-aod-crossing-and-rydberg-clash-pass-m21 [trials 25000])
  (define m21-monotone-aod-and-blockade-verified 0)
  (define crossed-or-clashed-aod-mutant-caught 0)
  (define qds24-oqp26-and-today14-verified 0)

  (define pool
    (for/vector ([idx (in-range 64)])
      ;; Non-monotone row/col targets and sub-blockade spacing (d_inter = 4 um < r_b = 8 um)
      (define crossed-rows (list (+ 3 (bitwise-and idx 3)) 1 5 7))
      (define crossed-cols (list 0 (+ 4 (bitwise-and idx 3)) 2 8))
      (define unsafe-dist-um (+ 2 (bitwise-and idx 3))) ;; in {2..5} um < 8 um
      (define blockade-um 8)

      ;; 1. Pass M21 & QDS-24 decompose into monotone AOD sweeps and enforce d_inter >= r_b!
      (define m21-wt (pass-m21-bocher-monotone-aod-sweeps crossed-rows crossed-cols unsafe-dist-um blockade-um #t))
      (define s44-wt (s44-neutral-atom-aod-monotone-and-blockade-guard crossed-rows crossed-cols unsafe-dist-um blockade-um #t))
      (define wt-ok?
        (and (hash-ref m21-wt 'verified?)
             (not (hash-ref m21-wt 'aod-crossing-hazard?))
             (not (hash-ref m21-wt 'rydberg-clash-hazard?))
             (hash-ref s44-wt 'verified?)))

      ;; 2. Mutant F64: unguarded AOD shuttle crosses tweezer rows/cols and violates blockade radius!
      (define m21-mut (pass-m21-bocher-monotone-aod-sweeps crossed-rows crossed-cols unsafe-dist-um blockade-um #f))
      (define mut-caught?
        (and (or (hash-ref m21-mut 'aod-crossing-hazard?)
                 (hash-ref m21-mut 'rydberg-clash-hazard?))
             (not (hash-ref m21-mut 'verified?))))

      ;; 3. OQP-26 & TODAY-14 (16q Neutral-Atom Monotone AOD Shuttle)
      (define today14 (NeutralAtomAod_MonotoneShuttle_16q 16))
      (define bench-ok?
        (and (hash-ref today14 'verified?)
             (= (hash-ref today14 'physical-qubits) 16)
             (not (hash-ref today14 'aod-crossing-hazard?))
             (not (hash-ref today14 'rydberg-clash-hazard?))))

      (vector wt-ok? mut-caught? bench-ok?)))

  (for ([i (in-range trials)])
    (define entry (vector-ref pool (bitwise-and i 63)))
    (when (vector-ref entry 0)
      (set! m21-monotone-aod-and-blockade-verified (add1 m21-monotone-aod-and-blockade-verified)))
    (when (vector-ref entry 1)
      (set! crossed-or-clashed-aod-mutant-caught (add1 crossed-or-clashed-aod-mutant-caught)))
