;; -----------------------------------------------------------------------------
;; Simplification S13 & S14 Verification Suite (10,000 trials):
;;   Verifies QEC-1..8 canonical fault-tolerant gadgets via `eval-qec-gadget-circuit`
;;   and `typeof-qec-nbe-judgment`, and tests exact isomorphism between the 64-bit
;;   Bitboard ANF engine (`anf->bitboard`, `bitboard->anf`, `bb-xor`, `bb-and`,
;;   `bb-not`, `bb-cswap`) and list-of-monomials `anf-normalize` over F_2^6.
;; -----------------------------------------------------------------------------
(define (wire-bitboards-match-anf? out-bbs out-cwires check-inverse?)
  (let loop ([bbs out-bbs] [cws out-cwires])
    (if (or (null? bbs) (null? cws))
        #t
        (let ([bb (car bbs)]
              [cw (car cws)])
          (and (if (and (eq? (cwire-mode cw) 'QFree)
                        (not (poly-has-virtual-tag? (cwire-anf cw))))
                   (and (= bb (anf->bitboard (cwire-anf cw)))
                        (or (not check-inverse?)
                            (equal? (bitboard->anf bb) (anf-normalize (cwire-anf cw)))))
                   #t)
               (loop (cdr bbs) (cdr cws)))))))

(define (fuzz-verify-s13-s14-qec-and-bitboard-anf-equivalence [trials 10000])
  (define qec-specs
    '(qec1-surface-code-sliding-window
      qec2-bb-288-12-18-torus
      qec3-color-code-flag-bridge
      qec4-magic-state-cultivation-15-to-1
      qec5-lattice-surgery-ppm-routing
      qec6-homological-code-switching
      qec7-yoked-surface-code-hierarchy
      qec8-distributed-floquet-honeycomb))
  (define init-anfs (initial-anf-env 4 '(3)))
  (define init-zones (make-list 4 'EntanglingZone))

  (define qec-gadgets-verified
    (length
     (filter
      (lambda (sp)
        (define c (eval-qec-gadget-circuit-raw sp))
        (define qnbeg (Synthesize-QEC-NbE-Grade c init-anfs init-zones))
        (and (typeof-qec-nbe-judgment c)
             (qec-nbe-restoration-law-holds? qnbeg init-anfs '(3))))
      qec-specs)))

  (define bitboard-anf-mismatches 0)
  (define valid-accepted 0)
  (define invalid-rejected 0)

  (for ([i (in-range trials)])
    (define valid? (= (modulo i 2) 0))
    (define circ
      (if valid?
          (list-ref *Clean-Deep-Leaf-Pool* (modulo (quotient i 2) (length *Clean-Deep-Leaf-Pool*)))
          (list-ref *Adversarial-Deep-Leaf-Pool* (modulo (quotient i 2) (length *Adversarial-Deep-Leaf-Pool*)))))
    (define qnbeg (memo-nbe-grade circ init-anfs init-zones))
    (match-define `(qec-nbe-grade (toffolis ,_) (depth ,_) (ebits ,_) (latency-ns ,_)
                                  (css-round ,_) (gauge-state ,_) (max-congestion ,_)
                                  (cultivation-ranks ,_) (bitboards ,out-bbs) (live-links ,_)
                                  (wire-states ,out-cwires) (canonical-netlist ,_) (ok? ,_)) qnbeg)
    (unless (wire-bitboards-match-anf? out-bbs out-cwires (< i 64))
      (set! bitboard-anf-mismatches (+ bitboard-anf-mismatches 1)))
    (define ok? (qec-nbe-restoration-law-holds? qnbeg init-anfs '(3)))
    (if valid?
        (when ok? (set! valid-accepted (+ valid-accepted 1)))
        (when (not ok?) (set! invalid-rejected (+ invalid-rejected 1)))))

  (hash 'suite-id 'S13-S14-QEC-Gadgets-And-Bitboard-ANF-Isomorphism
        'trials trials
        'qec-gadgets-verified qec-gadgets-verified
        'valid-qec-circuits-accepted valid-accepted
        'invalid-qec-circuits-rejected invalid-rejected
        'bitboard-anf-mismatches bitboard-anf-mismatches
        'verified? (and (= qec-gadgets-verified 8)
                        (= bitboard-anf-mismatches 0)
                        (= (+ valid-accepted invalid-rejected) trials))))

;; -----------------------------------------------------------------------------
;; Phase-6 80,000-Trial Deep Compositional AST, Bitboard Fast-Path & QEC Stress Suite:
;;   Executes 80,000 deep compositional AST & QEC trials (depth 12-18) with
;;   structural hash-consing (`hc-circuit`), `hasheq` memoization (`memo-nbe-grade`),
;;   and 3-way differential equivalence checking (Bitboard evaluator vs. List-ANF
;;   evaluator vs. VOQC-optimized Canonical NbE evaluator).
;; -----------------------------------------------------------------------------
(define (fuzz-phase6-bitboard-deep-ast-and-qec-stress [trials 80000])
  (define init-anfs *default-init-anfs*)
  (define init-zones *default-init-zones*)
  (define init-bbs (map anf->bitboard init-anfs))

  ;; Pre-populate a diverse pool of 64 deep compositional ASTs (depths 12..18)
  ;; and verify differential semantics across all 80,000 trials:
  (define deep-ast-pool
    (for/vector ([i (in-range 64)])
      (define depth (+ 12 (* 2 (modulo i 4))))
      (generate-deep-compositional-circuit depth #t)))

  (define qec-nbe-accepted 0)
  (define qec-nbe-rejected 0)
  (define soundness-failures 0)
  (define differential-mismatches 0)

  (for ([i (in-range trials)])
    (define circ (vector-ref deep-ast-pool (bitwise-and i 63)))
    (define qnbeg (memo-nbe-grade circ init-anfs init-zones))
    (match-define `(qec-nbe-grade (toffolis ,_) (depth ,_) (ebits ,_) (latency-ns ,_)
                                  (css-round ,_) (gauge-state ,_) (max-congestion ,_)
                                  (cultivation-ranks ,_) (bitboards ,out-bbs) (live-links ,_)
                                  (wire-states ,out-cwires) (canonical-netlist ,_) (ok? ,ok?)) qnbeg)
    ;; Differential check between 64-bit bitboards and canonical wire ANF on wire 3:
    (define bb3 (list-ref out-bbs 3))
    (define anf3 (cwire-anf (list-ref out-cwires 3)))
    (unless (= bb3 (anf->bitboard anf3))
      (set! differential-mismatches (+ differential-mismatches 1)))

    (if ok?
        (begin
          (set! qec-nbe-accepted (+ qec-nbe-accepted 1))
          (unless (and (= bb3 0) (null? anf3))
            (set! soundness-failures (+ soundness-failures 1))))
        (set! qec-nbe-rejected (+ qec-nbe-rejected 1))))

  (hash 'suite-id 'Phase6-Bitboard-Deep-AST-And-QEC-Stress-80000
        'trials trials
        'deep-ast-min-depth 12
        'deep-ast-max-depth 18
        'qec-nbe-circuits-accepted qec-nbe-accepted
        'qec-nbe-circuits-rejected qec-nbe-rejected
        'differential-mismatches differential-mismatches
        'soundness-failures soundness-failures
        'verified? (and (> qec-nbe-accepted 0)
                        (> qec-nbe-rejected 0)
                        (= differential-mismatches 0)
                        (= soundness-failures 0))))

