        (match-define `(uwire ,m1 ,a1 ,z1) (list-ref uwires c1))
        (match-define `(uwire ,m2 ,a2 ,z2) (list-ref uwires c2))
        (match-define `(uwire ,mt ,at ,zt) (list-ref uwires t))
        (define distinct? (and (not (= c1 c2)) (not (= c1 t)) (not (= c2 t))))
        (define ok?
