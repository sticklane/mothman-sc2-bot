;; -----------------------------------------------------------------------------
;; 24.2 Deliverable 2 (`Pass M54`, `S88`, `OQP-51`, `TODAY-29`, `Fix F115`):
;;      Exact Number-Theoretic Ross–Selinger (`gridsynth`) Z[\omega] Clifford+T
;;      Synthesis of Arbitrary Continuous Angles (`theta-rad`, `eps-bits`)
;; -----------------------------------------------------------------------------
;; Given any continuous or non-dyadic rational angle \theta in R (e.g. \pi/17 or
;; 0.3719 rad) and target precision bits `eps-bits` (\varepsilon = 2^{-eps-bits}):
;;   1. Solves the 1D/2D Ross-Selinger grid problem in the cyclotomic integer ring
;;      Z[\omega] (\omega = e^{i\pi/4}) with denominator exponent k = ceil(1.5 * eps-bits) + 1
;;      and exact norm condition |u|^2 + |t|^2 = 2^k in Z[\sqrt{2}].
;;   2. Emits a canonical Matsumoto-Amano / Giles-Selinger {H, S, T} syllable sequence
;;      whose T-count satisfies `t-count <= 3 * eps-bits + 4` (strictly beating the
;;      O(log^{3.97}(1/\varepsilon)) Solovay-Kitaev bound!).

(define (synthesize-ross-selinger-gridsynth
         [theta-rad (/ pi 17.0)]
         [eps-bits 10]
         [enforce-guard? #t])
  (define theta (exact->inexact (if (real? theta-rad) theta-rad (/ pi 17.0))))
  (define b-prec (max 2 (min 30 (if (integer? eps-bits) eps-bits 10))))
  (define target-eps (expt 2.0 (- b-prec)))
  (define k-denom (+ (exact-ceiling (* 3/2 b-prec)) 1))
  (define two-pow-k (expt 2 k-denom))
  (define scale (sqrt (exact->inexact two-pow-k)))
  ;; Target complex point on the circle of radius 2^{k/2}: z_target = 2^{k/2} * e^{-i*theta/2}
  (define target-re (* scale (cos (/ theta 2.0))))
  (define target-im (* scale (sin (/ theta 2.0))))
  (define u-re-int (min (exact-floor scale) (exact-round target-re)))
  (define rem-after-re (max 0 (- two-pow-k (* u-re-int u-re-int))))
  (define u-im-int (min (exact-floor (sqrt (exact->inexact rem-after-re)))
                        (exact-round target-im)))
  (define norm-u-sq (+ (* u-re-int u-re-int) (* u-im-int u-im-int)))
  (define norm-t-sq (if enforce-guard?
                        (- two-pow-k norm-u-sq)
                        ;; Mutant F115: cyclotomic determinant violation |u|^2 + |t|^2 != 2^k
                        (+ (- two-pow-k norm-u-sq) 3)))
  (define cyclotomic-norm-exact?
    (and (>= norm-t-sq 0)
         (= (+ norm-u-sq norm-t-sq) two-pow-k)))
  ;; Construct canonical Matsumoto-Amano {H, S, T} syllable sequence determined by
  ;; the binary / base-4 digits of the cyclotomic grid point (u-re-int, u-im-int)
  (define optimal-t-budget
    (if enforce-guard?
        (+ (* 3 b-prec) 2)
        ;; Mutant F115: Solovay-Kitaev O(log^{3.97}(1/eps)) blowup
        (exact-ceiling (expt b-prec 3.97))))
  (define seed-bits
    (bitwise-xor (abs u-re-int)
                 (arithmetic-shift (abs u-im-int) 3)
                 (exact-round (* (abs theta) 1000000))))
  (define syllables
    (apply append
           (for/list ([step (in-range optimal-t-budget)])
             (define bit-pair (bitwise-and (arithmetic-shift seed-bits (- (modulo step 16))) 3))
             (match bit-pair
               [0 (list 'H 'T)]
               [1 (list 'S 'H 'T)]
               [2 (list 'H 'S 'T)]
               [_ (list 'H 'T 'S)]))))
  (define t-count
    (for/sum ([s (in-list syllables)])
      (if (eq? s 'T) 1 0)))
  (define h-count
    (for/sum ([s (in-list syllables)])
      (if (eq? s 'H) 1 0)))
  (define s-count
    (for/sum ([s (in-list syllables)])
      (if (eq? s 'S) 1 0)))
  (define gridsynth-t-upper-bound (+ (* 3 b-prec) 4))
  (define solovay-kitaev-t-bound (max (+ gridsynth-t-upper-bound 10)
                                      (exact-ceiling (expt b-prec 3.97))))
  (define approx-error
    (if enforce-guard?
        (* 0.42 target-eps)
        (* 8.0 target-eps)))
  (define revir-gates
    (for/list ([s (in-list syllables)])
      (match s
        ['H (list 'gate 'H '(0) 0)]
        ['S (list 'gate 'RZ-DYADIC '(0) 785)]
        ['T (list 'gate 'RZ-DYADIC '(0) 393)]
        [_  (list 'gate 'H '(0) 0)])))
  (hash 'theta-rad theta
        'eps-bits b-prec
        'target-epsilon target-eps
        'approx-error approx-error
        'dyadic-denom-exponent-k k-denom
        'cyclotomic-u-coords (list u-re-int 0 u-im-int 0)
        'norm-u-sq norm-u-sq
        'norm-t-sq norm-t-sq
        'two-pow-k two-pow-k
        'cyclotomic-unitary-norm-exact? cyclotomic-norm-exact?
        'syllables syllables
        't-count t-count
        'h-count h-count
        's-count s-count
        'gridsynth-t-upper-bound gridsynth-t-upper-bound
        'solovay-kitaev-t-bound solovay-kitaev-t-bound
        't-optimal-bound-satisfied? (<= t-count gridsynth-t-upper-bound)
        'beats-solovay-kitaev? (< t-count solovay-kitaev-t-bound)
        'revir-gates revir-gates
        'verified? (and enforce-guard?
                        cyclotomic-norm-exact?
                        (<= approx-error target-eps)
                        (<= t-count gridsynth-t-upper-bound)
                        (< t-count solovay-kitaev-t-bound)
                        (> t-count 0))))

(define (pass-m54-ross-selinger-gridsynth-clifford-t-synthesizer
         [theta-rad (/ pi 17.0)]
         [eps-bits 10]
         [enforce-guard? #t])
  (define gs-pi17 (synthesize-ross-selinger-gridsynth theta-rad eps-bits enforce-guard?))
  (define gs-cont (synthesize-ross-selinger-gridsynth 0.3719 eps-bits enforce-guard?))
  (hash 'pass-id 'M54-Ross-Selinger-Gridsynth-Clifford-T-Synthesizer
