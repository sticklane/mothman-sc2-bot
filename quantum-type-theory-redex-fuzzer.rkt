         (and (eq? cssv cssu)
              (null? (set-intersect (circuit-xwrite-set v) u-all))
              (null? (set-intersect (circuit-hadamard-set v) u-all))
              (for/and ([w (in-list u-all)])
                (equal? (list-ref cwv w) (list-ref cwu w)))))
       (define-values (tud dud eud latud cssud lud cwud okud) (synth (circuit-dag u) cwv lv latv cssv))
       (define u-restored?
         (for/and ([w (in-list u-writes)])
           (equal? (list-ref cwud w) (list-ref cwires w))))
       (values (+ tu tv tud) (+ du dv dud) (+ eu ev eud)
               latud cssud lud cwud
               (and u-qfree? oku okv v-preserves-u? okud u-restored?))]
