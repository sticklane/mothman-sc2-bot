;; 8I. Phase 17: High-Level Quantum Language Literature Synthesis (Cobble PLDI '26,
;;     Spire PLDI '24, QCM OOPSLA '24, Qunity OOPSLA '25, Qwerty/ASDF CGO '25,
;;     Guppy PLanQC '25, Yang & Yuan PLanQC '26), QDS-29..31, OQP-31..34,
;;     TODAY-17..18, Simplifications S53..S58, Passes M27..M30 &
;;     Fuzz Categories F73..F78 (+150,000 -> 1,450,800 Total Trials)
;; =============================================================================

(define check-f73-cobble-subnormalization-fusion-safe?
  (case-lambda
    [(alpha-num alpha-den gates)
     (and (> alpha-num 0)
          (> alpha-den 0)
          (>= alpha-num alpha-den)
          (> gates 0))]
    [(alpha-num alpha-den gates cloned-postselect-ancilla?)
     (and (> alpha-num 0)
          (> alpha-den 0)
          (>= alpha-num alpha-den)
          (> gates 0)
          (not cloned-postselect-ancilla?))]
    [(alpha-num alpha-den gates cloned-postselect-ancilla? cse-cost-inflated?)
     (and (> alpha-num 0)
          (> alpha-den 0)
          (>= alpha-num alpha-den)
          (> gates 0)
          (not cloned-postselect-ancilla?)
          (not cse-cost-inflated?))]
    [(pre-alpha-num pre-alpha-den pre-gates post-alpha-num post-alpha-den post-gates)
     (and (> pre-alpha-num 0)
          (> pre-alpha-den 0)
          (> post-alpha-num 0)
          (> post-alpha-den 0)
          (>= post-alpha-num post-alpha-den)
          (> pre-gates 0)
          (> post-gates 0)
          (<= (* post-alpha-num post-gates pre-alpha-den)
              (* pre-alpha-num pre-gates post-alpha-den)))]
    [(pre-alpha-num pre-alpha-den pre-gates post-alpha-num post-alpha-den post-gates cloned-postselect-ancilla?)
     (and (> pre-alpha-num 0)
          (> pre-alpha-den 0)
          (> post-alpha-num 0)
          (> post-alpha-den 0)
          (>= post-alpha-num post-alpha-den)
          (> pre-gates 0)
          (> post-gates 0)
          (not cloned-postselect-ancilla?)
          (<= (* post-alpha-num post-gates pre-alpha-den)
              (* pre-alpha-num pre-gates post-alpha-den)))]))

(define (check-f75-qcm-injective-join-predicate-safe? injective-join-predicate?
                                                     landauer-history-tape?
                                                     [residual-garbage-ancillas 0])
  (and (eq? injective-join-predicate? #t)
       (eq? landauer-history-tape? #f)
       (zero? residual-garbage-ancillas)))

(define (subnormalized-block-encoding-tree num-terms
                                           poly-deg
                                           alpha-num
                                           alpha-den
                                           raw-gates
                                           [fuse-sum-and-poly? #t]
                                           [cloned-postselect-ancilla? #f])
  (define safe-terms (max 2 num-terms))
  (define safe-deg (max 1 poly-deg))
  (define safe-den (max 1 alpha-den))
  (define safe-num (max safe-den alpha-num))
  (define safe-gates (max 6 raw-gates))
  (define fused-alpha-num
    (if (and fuse-sum-and-poly? (not cloned-postselect-ancilla?))
        safe-num
        (* 2 safe-num)))
  (define fused-alpha-den safe-den)
  (define fused-gates
    (if (and fuse-sum-and-poly? (not cloned-postselect-ancilla?))
        (max 2 (quotient (* safe-gates 2) 3))
        (+ safe-gates safe-terms)))
  (define eff-cloned?
    (if fuse-sum-and-poly?
        cloned-postselect-ancilla?
        #t))
  (define safe-fusion?
    (check-f73-cobble-subnormalization-fusion-safe?
     safe-num safe-den safe-gates
     fused-alpha-num fused-alpha-den fused-gates
     eff-cloned?))
  (hash 'qds-id 'QDS-29-Subnormalized-Block-Encoding-Tree
        'num-lcu-terms safe-terms
        'polynomial-degree safe-deg
        'alpha-num safe-num
        'alpha-den safe-den
        'raw-gates safe-gates
        'fused-alpha-num fused-alpha-num
        'fused-alpha-den fused-alpha-den
        'fused-gates fused-gates
        'cloned-postselect-ancilla? eff-cloned?
        'alpha-gate-product-reduced? (< (* fused-alpha-num fused-gates) (* safe-num safe-gates))
        'subnormalization-inflation-hazard? (not safe-fusion?)
        'verified? safe-fusion?))

(define (direct-sum-subspace-zipper branch-dims [use-direct-sum-encoding? #t])
  (define safe-dims
    (if (and (list? branch-dims) (pair? branch-dims))
        (map (lambda (d) (max 2 d)) branch-dims)
        (list 4 4 4 4)))
  (define num-branches (length safe-dims))
  (define total-dim (apply + safe-dims))
  (define direct-sum-qubits
    (exact-ceiling (/ (log (max 2 total-dim)) (log 2))))
  (define max-branch-qubits
    (apply max (map (lambda (d) (exact-ceiling (/ (log (max 2 d)) (log 2)))) safe-dims)))
  (define onehot-total-qubits (+ num-branches max-branch-qubits))
  (define allocated-qubits
    (if use-direct-sum-encoding?
        direct-sum-qubits
        onehot-total-qubits))
  (define onehot-explosion? (> allocated-qubits direct-sum-qubits))
  (hash 'qds-id 'QDS-30-Direct-Sum-Subspace-Zipper
        'branch-dims safe-dims
        'num-branches num-branches
        'total-subspace-dim total-dim
        'direct-sum-qubits direct-sum-qubits
        'onehot-total-qubits onehot-total-qubits
        'allocated-qubits allocated-qubits
        'onehot-ancilla-explosion? onehot-explosion?
        'verified? (not onehot-explosion?)))

(define (logarithmic-assertion-counter-tree num-assertions
                                            num-rounds
                                            [use-logarithmic-counter? #t]
                                            [list-all-non-disjoint? #f]
                                            [loop-tier 'user-cloud-outer-loop])
  (define safe-n (max 8 num-assertions))
  (define safe-t (max 1 num-rounds))
  (define ratio-ceil (quotient (+ safe-n safe-t -1) safe-t))
  (define log-bound-ancillas
    (+ 1 (exact-ceiling (/ (log (+ 1 ratio-ceil)) (log 2)))))
  (define linear-ancillas safe-n)
  (define counter-ancillas
    (if use-logarithmic-counter?
        log-bound-ancillas
        linear-ancillas))
  (define eff-non-disjoint?
    (if use-logarithmic-counter?
        list-all-non-disjoint?
        #t))
  (define ast
    (list 'within-apply
          (walk-zipper 'GroverCoin (focus-zipper 'left '(var 1)))
          (assert-log-counter safe-n safe-t counter-ancillas log-bound-ancillas eff-non-disjoint? loop-tier)))
  (define wt?
    (coreqds-well-typed? ast loop-tier 'Heron-R2-156q 'cudaq-tensor-core-opnic))
  (define revir-gates (if wt? (compile-coreqds-to-revir ast) '()))
  (define linear-blowup? (> counter-ancillas log-bound-ancillas))
  (hash 'qds-id 'QDS-31-Logarithmic-Assertion-Counter-Tree
        'num-assertions safe-n
        'num-rounds safe-t
        'counter-ancillas counter-ancillas
        'log-bound-ancillas log-bound-ancillas
        'linear-ancillas linear-ancillas
        'list-all-non-disjoint? eff-non-disjoint?
        'loop-tier loop-tier
        'linear-ancilla-blowup? linear-blowup?
        'ast ast
        'ast-node-count (coreqds-ast-node-count ast)
        'revir-gates revir-gates
        'revir-gate-count (length revir-gates)
        'coreqds-well-typed? wt?
        'verified? (and wt? (not linear-blowup?) (not eff-non-disjoint?) (>= (length revir-gates) 4))))

(define (oqp31-cobble-sum-and-polynomial-fusion-block-encoding num-terms
                                                               poly-deg
                                                               alpha-num
                                                               alpha-den
                                                               raw-gates
                                                               [fuse-sum-and-poly? #t])
  (define qds29
    (subnormalized-block-encoding-tree
     num-terms poly-deg alpha-num alpha-den raw-gates fuse-sum-and-poly? (not fuse-sum-and-poly?)))
  (define ast
    (list 'let 1
          (fold-tree 'CobbleLCUTree (adt-construct 'LCUNode '(var 1)))
          (svt-block-encode (max 2 poly-deg)
            (walk-zipper 'HornerShift (focus-zipper 'left '(var 2))))
          fuse-sum-and-poly?))
  (define wt?
    (coreqds-well-typed? ast 'coprocessor-mid-loop 'Heron-R2-156q 'cudaq-tensor-core-opnic))
  (define revir-gates (if wt? (compile-coreqds-to-revir ast) '()))
  (hash 'oqp-id 'OQP-31-Cobble-Sum-And-Polynomial-Fusion-Block-Encoding
        'num-lcu-terms (hash-ref qds29 'num-lcu-terms)
        'polynomial-degree (hash-ref qds29 'polynomial-degree)
        'fused-alpha-num (hash-ref qds29 'fused-alpha-num)
        'fused-alpha-den (hash-ref qds29 'fused-alpha-den)
        'fused-gates (hash-ref qds29 'fused-gates)
        'ast ast
        'ast-node-count (coreqds-ast-node-count ast)
        'revir-gates revir-gates
        'revir-gate-count (length revir-gates)
        'coreqds-well-typed? wt?
        'alpha-gate-product-reduced? (hash-ref qds29 'alpha-gate-product-reduced?)
        'subnormalization-inflation-hazard? (hash-ref qds29 'subnormalization-inflation-hazard?)
        'verified? (and (hash-ref qds29 'verified?) wt? (>= (length revir-gates) 4))))

(define (oqp32-spire-source-level-control-flow-t-hoisting num-branches
                                                          shared-t-per-branch
                                                          [hoist-at-source-level? #t])
  (define safe-branches (max 2 num-branches))
  (define safe-t (max 2 shared-t-per-branch))
  (define post-lowering-t-count (* safe-branches safe-t 2))
  (define hoisted-t-count safe-t)
  (define effective-t-count
    (if hoist-at-source-level?
        hoisted-t-count
        post-lowering-t-count))
  (define t-complexity-blowup? (> effective-t-count hoisted-t-count))
  (define ast
    (list 'within-apply
          (list 'let 1
                (adt-construct 'SpireSharedT '(var 1))
                (focus-zipper 'left '(var 2))
                hoist-at-source-level?)
          (match-orthogonal #b0011 #b1100
            (fold-tree 'SpireBranchTree (adt-construct 'BranchLeaf '(var 3))))))
  (define wt?
    (coreqds-well-typed? ast 'coprocessor-mid-loop 'Heron-R2-156q 'cudaq-tensor-core-opnic))
  (define revir-gates (if wt? (compile-coreqds-to-revir ast) '()))
  (hash 'oqp-id 'OQP-32-Spire-Source-Level-Control-Flow-T-Hoisting
        'num-branches safe-branches
        'shared-t-per-branch safe-t
        'post-lowering-t-count post-lowering-t-count
        'effective-t-count effective-t-count
        'ast ast
        'ast-node-count (coreqds-ast-node-count ast)
        'revir-gates revir-gates
        'revir-gate-count (length revir-gates)
        'coreqds-well-typed? wt?
        't-complexity-blowup? t-complexity-blowup?
        'verified? (and (not t-complexity-blowup?) wt? (>= (length revir-gates) 4))))

(define (oqp33-qunity-direct-sum-and-qwerty-basis-translation branch-dims
                                                              b-in-orthogonal?
                                                              b-out-orthogonal?
                                                              spans-equal?
                                                              [enforce-direct-sum-and-ortho? #t])
  (define qds30 (direct-sum-subspace-zipper branch-dims enforce-direct-sum-and-ortho?))
  (define total-dim (hash-ref qds30 'total-subspace-dim))
