;; -----------------------------------------------------------------------------
;; 27.2 Deliverable 2 (Pass M62, S96, Fix F126):
;;      Chordal SSA Dense Qubit Compaction (Zero Dead Declared Qubits)
;; -----------------------------------------------------------------------------

(define (extract-active-revir-wires gates)
  (if (not (list? gates))
      '()
      (sort
       (remove-duplicates
        (apply append
               (for/list ([g (in-list gates)])
                 (match g
                   [(list 'gate _ ws _)
                    (filter (lambda (w) (and (integer? w) (>= w 0))) ws)]
                   [_ '()]))))
       <)))

(define (count-unused-declared-qubits gates)
  (define active-ws (extract-active-revir-wires gates))
  (if (null? active-ws)
      0
      (let ([declared-width (add1 (apply max active-ws))])
        (- declared-width (length active-ws)))))

(define (compact-revir-active-wires-dense gates [enforce-guard? #t])
  (cond
    [(not (list? gates)) '()]
    [(not enforce-guard?)
     ;; Mutant F126: leaves sparse uncompacted wire indices with dead declared qubits!
     (for/list ([g (in-list gates)])
       (match g
         [(list 'gate op ws phase)
          (list 'gate op
                (for/list ([w (in-list ws)])
                  (if (and (integer? w) (>= w 2)) (+ w 3) w))
                phase)]
         [_ g]))]
    [else
     (define active-ws (extract-active-revir-wires gates))
     (define wire-map
       (for/hash ([w (in-list active-ws)]
                  [dense-idx (in-naturals)])
         (values w dense-idx)))
     (for/list ([g (in-list gates)])
       (match g
         [(list 'gate op ws phase)
          (list 'gate op
                (for/list ([w (in-list ws)])
                  (hash-ref wire-map w w))
                phase)]
         [_ g]))]))

(define (pass-m62-chordal-ssa-dense-qubit-compaction
         [gates '()]
         [enforce-guard? #t])
  (define raw-gates
    (if (and (list? gates) (pair? gates))
        gates
        (compile-coreqds-to-revir (oqp-coreqds-ast 55))))
  (define active-before (extract-active-revir-wires raw-gates))
  (define declared-before
    (if (null? active-before) 0 (add1 (apply max active-before))))
  (define unused-before (count-unused-declared-qubits raw-gates))
  (define compacted-gates
    (compact-revir-active-wires-dense raw-gates enforce-guard?))
  (define active-after (extract-active-revir-wires compacted-gates))
  (define declared-after
    (if (null? active-after) 0 (add1 (apply max active-after))))
  (define unused-after (count-unused-declared-qubits compacted-gates))
  (hash 'pass-id 'M62-Chordal-SSA-Dense-Qubit-Compaction
        'simplification-id 'S96-Zero-Dead-Declared-Qubits-Guard
        'declared-qubits-before declared-before
        'active-qubits-before (length active-before)
        'unused-qubit-count-before unused-before
        'declared-qubit-count declared-after
        'active-qubit-count (length active-after)
        'unused-qubit-count unused-after
        'active-wires-contiguous? (equal? active-after (range (length active-after)))
        'zero-dead-declared-qubits? (zero? unused-after)
        'dead-qubit-allocation-waste-hazard? (> unused-after 0)
        'compacted-gates compacted-gates
        'verified? (and enforce-guard?
                        (zero? unused-after)
                        (= declared-after (length active-after))
                        (equal? active-after (range (length active-after)))
                        (> declared-after 0))))

(define (s96-zero-dead-declared-qubits-guard
         [gates '()]
         [enforce-guard? #t])
  (pass-m62-chordal-ssa-dense-qubit-compaction gates enforce-guard?))

;; -----------------------------------------------------------------------------
;; 27.3 Deliverable 3 (QDS-42, Pass M63, S97, OQP-55, TODAY-33, Fix F127):
;;      Desogus Gate II "Short-Last" Multi-Channel Ancilla & EPR Reserve Zipper
;;      vs "Beholder" Pairwise Double-Charging Failure Boundary
;; -----------------------------------------------------------------------------

(define (qds42-short-last-multichannel-ancilla-ebit-reserve-zipper
         [pool-reserve 8]
         [channel-demands '(3 2 2)]
         [enforce-guard? #t])
  (define eff-reserve
    (if (and (integer? pool-reserve) (> pool-reserve 0)) pool-reserve 8))
  (define eff-channels
    (if (and (list? channel-demands) (pair? channel-demands))
        channel-demands
        '(3 2 2)))
  ;; Beholder pairwise check: only verifies each individual channel c_i against R: (R - c_i >= 1)
  (define beholder-pairwise-ok?
    (for/and ([c (in-list eff-channels)])
      (>= (- eff-reserve c) 1)))
  ;; Short-Last recursive list-fold reserve zipper: folds (R_k = R_{k-1} - c_k) across all channels
  ;; and enforces terminal reserve R - sum(channels) >= 1 (at least 1 unallocated safety unit).
  (define total-channel-demand (foldl + 0 eff-channels))
  (define terminal-reserve (- eff-reserve total-channel-demand))
  (define short-last-list-ok? (>= terminal-reserve 1))
  ;; Witness counterexample for Beholder double-charging on R: two channels each demanding
  ;; floor(R/2) + 1 pass pairwise (since R - (floor(R/2)+1) >= 1 for R >= 4),
  ;; yet their sum is 2*floor(R/2) + 2 > R, yielding negative reserve!
  (define c-half (add1 (quotient eff-reserve 2)))
  (define double-charge-channels (list c-half c-half))
  (define beholder-accepts-double-charge?
    (for/and ([c (in-list double-charge-channels)])
      (>= (- eff-reserve c) 1)))
  (define double-charge-terminal-reserve
    (- eff-reserve (foldl + 0 double-charge-channels)))
  (define short-last-rejects-double-charge?
    (< double-charge-terminal-reserve 1))
  (define accepted-by-active-policy?
    (if enforce-guard?
        short-last-list-ok?
        beholder-pairwise-ok?))
  (hash 'qds-id 'QDS-42-ShortLastMultiChannelAncillaEbitReserveZipper
        'pool-reserve eff-reserve
        'channel-demands eff-channels
        'channel-count (length eff-channels)
        'total-channel-demand total-channel-demand
        'terminal-reserve terminal-reserve
        'beholder-pairwise-only-ok? beholder-pairwise-ok?
        'short-last-list-reserve-ok? short-last-list-ok?
        'beholder-accepts-double-charge-counterexample? beholder-accepts-double-charge?
        'double-charge-counterexample-terminal-reserve double-charge-terminal-reserve
        'short-last-rejects-double-charge-counterexample? short-last-rejects-double-charge?
        'beholder-double-charging-hazard? (and (not enforce-guard?)
                                               beholder-accepts-double-charge?
                                               (< double-charge-terminal-reserve 0))
        'accepted? accepted-by-active-policy?
        'verified? (and enforce-guard?
                        short-last-list-ok?
                        beholder-accepts-double-charge?
                        (< double-charge-terminal-reserve 0)
                        short-last-rejects-double-charge?)))

(define (pass-m63-short-last-list-reserve-vs-beholder-double-charging
         [pool-reserve 8]
         [channel-demands '(3 2 2)]
         [enforce-guard? #t])
  (define q42
    (qds42-short-last-multichannel-ancilla-ebit-reserve-zipper
