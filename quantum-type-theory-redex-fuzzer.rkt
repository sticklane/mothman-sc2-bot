(define (oqp30-coreqds-within-apply-inductive-adt-elaboration num-ctors branching-factor [enforce-pure-within-apply? #t])
  (define qds26 (inductive-polynomial-adt-zipper num-ctors branching-factor '(#b01 #b01) enforce-pure-within-apply?))
  (define qds28 (within-apply-reversible-scope-stack #f #t #b0110 enforce-pure-within-apply?))
  (define sample-ast
    (fold-tree
     'BraunADT
     (list 'within-apply
           (walk-zipper 'HadCoin (svt-block-encode 3 '(var 0)))
           (if enforce-pure-within-apply?
               '(focus-zipper left (var 1))
               '(hybrid-feedback coprocessor-mid-loop (var 1))))))
  (define elab (core-qds-elaborator sample-ast 'coprocessor-mid-loop 'Heron-R2-156q 'cudaq-tensor-core-opnic))
  (hash 'oqp-id 'OQP-30-CoreQDS-Within-Apply-Inductive-ADT-Elaboration
        'mcbride-derivative-holes (hash-ref qds26 'mcbride-derivative-holes)
        'orthogonal-qmatch? (hash-ref qds26 'orthogonal-qmatch?)
        'exact-adjoint-uncompute? (hash-ref qds28 'exact-adjoint-uncompute?)
        'elaborated-to-hl-qds? (hash-ref elab 'elaborated-to-hl-qds?)
        'verified? (and (hash-ref qds26 'verified?)
                        (hash-ref qds28 'verified?)
                        (hash-ref elab 'verified?))))

