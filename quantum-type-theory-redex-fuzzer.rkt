  (for ([i (in-range trials)])
    (define h (bitwise-and (+ (* i 2654435761) 173205081) #x7fffffff))
    (define num-ctors (+ 2 (bitwise-and h 7)))
    (define branch-k (+ 1 (bitwise-and (arithmetic-shift h -3) 7)))
    (define poly-deg (+ 2 (bitwise-and (arithmetic-shift h -6) 15)))
    (define var-idx (bitwise-and (arithmetic-shift h -10) 1023))

    ;; 1. Well-typed CoreQDS composition of all 4 combinators (fold-tree, walk-zipper,
    ;;    svt-block-encode, ec-fault-tolerant-lift) + within-apply!
    (define valid-ast
      (ec-fault-tolerant-lift 5 #f
        (fold-tree 'InductiveADT
          (list 'within-apply
                (walk-zipper 'GroverCoin (svt-block-encode poly-deg (list 'var var-idx)))
                '(hybrid-feedback coprocessor-mid-loop (focus-zipper left (var 1)))))))
    (define m26-wt (pass-m26-coreqds-within-apply-elaborator num-ctors branch-k #t))
    (define elab-wt (core-qds-elaborator valid-ast 'coprocessor-mid-loop 'Heron-R2-156q 'cudaq-tensor-core-opnic))
    (when (and (hash-ref m26-wt 'verified?)
               (hash-ref elab-wt 'verified?)
               (not (hash-ref m26-wt 'mid-compute-measurement-collapse?))
               (hash-ref m26-wt 'exact-adjoint-uncompute?))
      (set! m26-coreqds-within-apply-verified (add1 m26-coreqds-within-apply-verified)))

    ;; 2. Mutant F72: 4 families of incompatible concept combinations that MUST be 100% rejected:
    (define mut-within-ast
      (list 'within-apply
            (list 'hybrid-feedback 'coprocessor-mid-loop (list 'var var-idx))
            '(var 1)))
    (define mut-qsvt-ast
      (svt-block-encode poly-deg (list 'hybrid-feedback 'coprocessor-mid-loop (list 'var var-idx))))
    (define mut-qwalk-ast
      (walk-zipper 'Coin (list 'hybrid-feedback 'coprocessor-mid-loop (list 'var var-idx))))
    (define mut-aod-supercond-ast
      (fold-tree 'Tree '(aod-shuttle (0 2 4) (1 3 5) (var 0))))
    (define m26-mut (pass-m26-coreqds-within-apply-elaborator num-ctors branch-k #f))
    (when (and (hash-ref m26-mut 'mid-compute-measurement-collapse?)
               (not (hash-ref m26-mut 'verified?))
               (not (coreqds-well-typed? mut-within-ast 'coprocessor-mid-loop 'Heron-R2-156q 'cudaq-tensor-core-opnic))
               (not (coreqds-well-typed? mut-qsvt-ast 'coprocessor-mid-loop 'Heron-R2-156q 'cudaq-tensor-core-opnic))
               (not (coreqds-well-typed? mut-qwalk-ast 'coprocessor-mid-loop 'Heron-R2-156q 'cudaq-tensor-core-opnic))
               (not (coreqds-well-typed? mut-aod-supercond-ast 'coprocessor-mid-loop 'Heron-R2-156q 'cudaq-tensor-core-opnic))
               (coreqds-well-typed? mut-aod-supercond-ast 'coprocessor-mid-loop 'Bluvstein-NeutralAtom 'cudaq-tensor-core-opnic))
      (set! incompatible-combinator-mutant-caught (add1 incompatible-combinator-mutant-caught)))

    ;; 3. QDS-26, QDS-28 & OQP-30 verification
    (define oqp30 (oqp30-coreqds-within-apply-inductive-adt-elaboration num-ctors branch-k #t))
    (when (hash-ref oqp30 'verified?)
      (set! qds26-qds28-and-oqp30-verified (add1 qds26-qds28-and-oqp30-verified))))

  (hash 'issue-id 'F72-coreqds-within-apply-mid-compute-measurement-collapse-pass-m26
