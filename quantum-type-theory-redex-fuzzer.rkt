;; 8b. Phase-6 Deep Compositional AST Generator, QEC Campaigns (F21-F24, S13-S14),
;;     and 80,000-Trial Bitboard & Deep-AST Stress Suite (Scaling to 200,800 Trials)
;; =============================================================================

;; Reconvergent diamond control-fanout DAGs (w0 -> w1, w2 -> w3) and multi-round QEC blocks:
(define *diamond-dag-clean*
  (hc-circuit
   '(c-with-uncompute
     (c-seq (c-gate (g-cnot 0 2))
            (c-seq (c-gate (g-compute-and 0 1 3))
                   (c-gate (g-cnot 2 3))))
     (c-seq (c-gate (g-z 3)) (c-gate (g-z 3))))))

(define *multi-round-qec-loop-r2*
  (hc-circuit
   '(c-seq
     (c-seq (c-gate (g-css-round-begin Superpos))
            (c-seq (c-gate (g-css-round-end Superpos))
                   (c-gate (g-qec-barrier))))
     (c-seq (c-gate (g-css-round-begin QFree))
            (c-seq (c-gate (g-css-round-end QFree))
                   (c-seq (c-gate (g-qec-barrier))
                          (c-gate (g-stim-detector 3))))))))

(define *Clean-Deep-Leaf-Pool*
  (map hc-circuit
       (list
        *diamond-dag-clean*
        *multi-round-qec-loop-r2*
        (eval-qec-gadget-circuit-raw 'qec1-surface-code-sliding-window)
        (eval-qec-gadget-circuit-raw 'qec2-bb-288-12-18-torus)
        (eval-qec-gadget-circuit-raw 'qec3-color-code-flag-bridge)
        (eval-qec-gadget-circuit-raw 'qec4-magic-state-cultivation-15-to-1)
        (eval-qec-gadget-circuit-raw 'qec5-lattice-surgery-ppm-routing)
        (eval-qec-gadget-circuit-raw 'qec6-homological-code-switching)
        (eval-qec-gadget-circuit-raw 'qec7-yoked-surface-code-hierarchy)
        (eval-qec-gadget-circuit-raw 'qec8-distributed-floquet-honeycomb))))

(define *Adversarial-Deep-Leaf-Pool*
  (map hc-circuit
       (list
        ;; F21: Unflagged mid-schedule hook error spreading to weight-2 data error
        '(c-seq (c-gate (g-inject-fault 2 0))
                (c-seq (c-gate (g-cnot 2 0))
                       (c-seq (c-gate (g-cnot 2 1))
                              (c-gate (g-qec-barrier)))))
        ;; F22: Under-cultivated magic state T injection (rank 1 < target 2)
        '(c-seq (c-gate (g-cultivate-step 2 1))
                (c-gate (g-inject-magic-t 2 2)))
        ;; F23: Overlapping lattice-surgery PPM bus intervals [0,2] and [1,3] in c-par-diag
        '(c-par-diag (c-gate (g-ppm-bus 0 2))
                     (c-gate (g-ppm-bus 1 3)))
        ;; F24: Homological code switch while boundary gauge is open
        '(c-seq (c-gate (g-gauge-open 2))
                (c-gate (g-code-switch-transversal-t 2)))
        ;; F17: Unconsolidated carry-save inside with-qfree
        '(c-with-uncompute
          (c-gate (g-skew-add-cs 3))
          (c-gate (g-z 2)))
        ;; F19: Mismatched Kuperberg collimation rank
        '(c-with-uncompute
          (c-gate (g-kuperberg-collimate 0 1 3 3))
          (c-gate (g-z 2))))))

;; Grammar-driven recursive AST generator (`generate-deep-compositional-circuit`):
;; Builds depth 12-18 compositional ASTs nesting `c-with-uncompute`, `c-par-diag`,
;; `c-with-locked-pebble`, `c-voqc-opt`, multi-round QEC loops (R = 2..4), and
;; reconvergent diamond control-fanout DAGs with structural hash-consing (`hc-circuit`).
(define (generate-deep-compositional-circuit [target-depth 14] [allow-adversarial? #t])
  (define leaf-base
    (if (and allow-adversarial? (= (rand-int 0 1) 1))
        (rand-choice *Adversarial-Deep-Leaf-Pool*)
        (rand-choice *Clean-Deep-Leaf-Pool*)))
  (let loop ([d target-depth] [curr leaf-base])
    (if (<= d 4)
        (hc-circuit curr)
        (case (rand-int 0 4)
          [(0)
           (loop (- d 2)
                 (hc-circuit
                  `(c-with-uncompute
                    (c-gate (g-compute-and 0 1 3))
                    (c-seq (c-gate (g-z 3)) (c-gate (g-z 3))))))]
          [(1)
           (loop (- d 2)
                 (hc-circuit
                  `(c-with-locked-pebble 3
                     (c-gate (g-cnot 0 3))
                     (c-par-diag (c-gate (g-ppm-bus 1 2)) (c-gate (g-ppm-bus 1 2))))))]
          [(2)
           (loop (- d 2)
                 (hc-circuit `(c-voqc-opt (c-seq ,curr ,(rand-choice *Clean-Deep-Leaf-Pool*)))))]
          [(3)
           (loop (- d 2)
                 (hc-circuit `(c-seq ,*diamond-dag-clean* ,curr)))]
          [else
           (loop (- d 2)
                 (hc-circuit `(c-seq ,*multi-round-qec-loop-r2* ,curr)))]))))

;; -----------------------------------------------------------------------------
;; Issue F21: Flag-Qubit Hook-Error Propagation & Fault-Weight Under-Counting
;;            (`F21-QEC-Hook-Error-Spread-Unflagged`, 2,500 trials)
;; -----------------------------------------------------------------------------
(define (fuzz-find-f21-qec-hook-error-spread-unflagged [trials 2500])
  (define counterexamples-found 0)
  (define qec-nbe-soundness-failures 0)
  (define first-bloated #f)
  (define first-shrunk #f)

  (define (bad-f21? c)
    (define init-anfs (initial-anf-env 4 '(3)))
    (define init-zones (make-list 4 'EntanglingZone))
    ;; Cert-compiler (Phase-4) accepts unflagged hook-error spread, while runtime has weight-2 data fault!
    (match-define `(cert-grade (toffolis ,_) (depth ,_) (ebits ,_) (latency-ns ,_)
                               (css-round ,_) (live-links ,_) (wire-states ,_) (ok? ,cert-ok?))
      (Synthesize-Certified-Compiler-Grade c init-anfs init-zones))
    (and cert-ok?
         (let ()
           (define init-st `(wire-state (vals (0 0 0 0)) (anf ,init-anfs) (phase 1) (zones ,init-zones)))
           (match-define `(wire-state (vals ,_) (anf ,out-anfs) (phase ,_) (zones ,_))
             (eval-circuit-raw c init-st))
           (unflagged-hook-error-spread? out-anfs))))

  (for ([_ (in-range trials)])
    (define core
      '(c-seq (c-gate (g-inject-fault 2 0))
              (c-seq (c-gate (g-cnot 2 0))
                     (c-seq (c-gate (g-cnot 2 1))
                            (c-gate (g-qec-barrier))))))
    (define bloated
      `(c-seq (c-seq (c-gate (g-x 0)) (c-gate (g-x 0)))
              (c-seq ,core
                     (c-seq (c-gate (g-z 1)) (c-gate (g-z 1))))))
    (when (bad-f21? bloated)
      (set! counterexamples-found (+ counterexamples-found 1))
      (unless first-bloated
        (set! first-bloated bloated)
        (set! first-shrunk (shrink-circuit bloated bad-f21?))))
    (define init-anfs (initial-anf-env 4 '(3)))
    (define init-zones (make-list 4 'EntanglingZone))
    (define qnbeg (Synthesize-QEC-NbE-Grade bloated init-anfs init-zones))
    (when (qec-nbe-restoration-law-holds? qnbeg init-anfs '(3))
      (set! qec-nbe-soundness-failures (+ qec-nbe-soundness-failures 1))))

  ;; Verify that flagged & cleared bridge gadget (qec3) is accepted by QEC-NbE:
  (define clean-qec3 (eval-qec-gadget-circuit-raw 'qec3-color-code-flag-bridge))
  (define clean-qec3-ok?
    (qec-nbe-restoration-law-holds?
     (Synthesize-QEC-NbE-Grade clean-qec3 (initial-anf-env 4 '(3)) (make-list 4 'EntanglingZone))
     (initial-anf-env 4 '(3))
     '(3)))

  (hash 'issue-id 'F21-QEC-Hook-Error-Spread-Unflagged
        'trials trials
        'counterexamples-found-in-pre-phase6 counterexamples-found
        'qec-nbe-soundness-failures qec-nbe-soundness-failures
        'flagged-color-code-bridge-accepted? clean-qec3-ok?
        'bloated-gate-count (if first-bloated (circuit-gate-count first-bloated) 0)
        'shrunk-gate-count (if first-shrunk (circuit-gate-count first-shrunk) 0)
        'shrunk-minimal-witness first-shrunk
        'verified? (and (= counterexamples-found trials)
                        (= qec-nbe-soundness-failures 0)
                        clean-qec3-ok?
                        first-shrunk
                        (<= (circuit-gate-count first-shrunk) 4))))

;; -----------------------------------------------------------------------------
;; Issue F22: Magic-State Cultivation Post-Selection Escape & Binomial Rank Underflow
;;            (`F22-QEC-Magic-State-Cultivation-PostSelect-Leak`, 2,500 trials)
;; -----------------------------------------------------------------------------
(define (fuzz-find-f22-qec-magic-state-cultivation-postselect-leak [trials 2500])
  (define counterexamples-found 0)
  (define qec-nbe-soundness-failures 0)
  (define first-bloated #f)
  (define first-shrunk #f)

  (define (bad-f22? c)
    (define init-anfs (initial-anf-env 4 '(3)))
    (define init-zones (make-list 4 'EntanglingZone))
    (match-define `(cert-grade (toffolis ,_) (depth ,_) (ebits ,_) (latency-ns ,_)
                               (css-round ,_) (live-links ,_) (wire-states ,_) (ok? ,cert-ok?))
      (Synthesize-Certified-Compiler-Grade c init-anfs init-zones))
    (and cert-ok?
         (let ()
           (define init-st `(wire-state (vals (0 0 0 0)) (anf ,init-anfs) (phase 1) (zones ,init-zones)))
           (match-define `(wire-state (vals ,_) (anf ,out-anfs) (phase ,out-ph) (zones ,_))
             (eval-circuit-raw c init-st))
           (or (< out-ph 0) (not (null? (list-ref out-anfs 3)))))))

  (for ([_ (in-range trials)])
