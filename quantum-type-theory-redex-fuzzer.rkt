;; CoreQDS 2.0 Deliverable 3e: User-Defined Inductive `qdata` Declaration Verifier
;; `(qdata TypeName ((Ctor1 FieldType1 ...) (Ctor2 FieldType2 ...) ...))`
(define (verify-qdata-inductive-decl decl)
  (match decl
    [(list 'data-decl type-name ctors)
     (define valid-header? (and (symbol? type-name) (list? ctors) (>= (length ctors) 2)))
     (define ctor-names
       (for/list ([c (in-list (if (list? ctors) ctors '()))]
                  #:when (and (list? c) (pair? c) (symbol? (first c))))
         (first c)))
     (define unique-ctors? (= (length ctor-names) (length (remove-duplicates ctor-names))))
     ;; Strict positivity check: no constructor field may have a negative occurrence `(-> TypeName ...)`
     (define strictly-positive?
       (and valid-header?
            (for/and ([c (in-list ctors)])
              (and (list? c)
                   (pair? c)
                   (for/and ([field (in-list (rest c))])
                     (match field
                       [(list '-> dom cod)
                        (not (member type-name (flatten dom)))]
                       [_ #t]))))))
     (define num-ctors (if (list? ctors) (length ctors) 0))
     (define tag-bits (exact-ceiling (/ (log (max 2 num-ctors)) (log 2))))
     (define ctor-pats
       (for/list ([i (in-range num-ctors)])
         (for/list ([b (in-range tag-bits)])
           (bitwise-bit-field i b (add1 b)))))
     (define recursive-occurrences
       (for/sum ([c (in-list (if (list? ctors) ctors '()))])
         (for/sum ([field (in-list (if (and (list? c) (pair? c)) (rest c) '()))])
           (if (equal? field type-name) 1 0))))
     (hash 'type-name type-name
           'num-constructors num-ctors
           'tag-qubits tag-bits
           'unique-constructors? unique-ctors?
           'strictly-positive? strictly-positive?
           'orthogonal-tag-encoding? (patterns-pairwise-orthogonal? ctor-pats)
           'mcbride-one-hole-derivative-arity recursive-occurrences
           'verified? (and valid-header? unique-ctors? strictly-positive?))]
    [_
     (hash 'verified? #f 'strictly-positive? #f)]))

;; CoreQDS 2.0 Deliverable 3f: Twist-Style Semantic Entanglement & Purity Verifier
;; Checks whether a program across bipartition `(wires-a, wires-b)` leaves `wires-a`
;; unentangled from `wires-b` at exit (`purity == 1`, `schmidt-rank == 1`).
(define (coreqds-entanglement-purity-check ast wires-a wires-b)
  (define gates (compile-coreqds-to-revir ast))
  (define netlist-check (verify-compiled-revir-netlist gates))
  (define set-a (list->set (if (list? wires-a) wires-a '())))
  (define set-b (list->set (if (list? wires-b) wires-b '())))
  (define disjoint-partition? (set-empty? (set-intersect set-a set-b)))
  ;; Track active cross-partition CNOT/CZ/AND entanglement links modulo uncomputation:
  ;; A gate crossing A and B toggles or increments active entanglement unless canceled by its inverse
  (define active-links
    (let loop ([rem gates] [stack '()])
      (cond
        [(null? rem) stack]
        [else
         (define g (car rem))
         (match g
           [(list 'gate op ws _)
            (define norm-op (if (eq? op 'AND-UNCOMPUTE) 'AND-COMPUTE op))
            (define touches-a? (for/or ([w (in-list ws)]) (set-member? set-a w)))
            (define touches-b? (for/or ([w (in-list ws)]) (set-member? set-b w)))
            (if (and touches-a? touches-b?)
                (if (and (pair? stack) (equal? (car stack) (list norm-op ws)))
                    (loop (cdr rem) (cdr stack))
                    (loop (cdr rem) (cons (list norm-op ws) stack)))
                (loop (cdr rem) stack))]
           [_ (loop (cdr rem) stack)])])))
  (define schmidt-rank (expt 2 (min 8 (length active-links))))
  (define separable-at-exit? (and disjoint-partition?
                                  (null? active-links)
                                  (hash-ref netlist-check 'balanced-ancilla-uncompute?)))
  (hash 'disjoint-bipartition? disjoint-partition?
        'residual-cross-links (length active-links)
        'schmidt-rank schmidt-rank
        'reduced-density-purity-num 1
        'reduced-density-purity-den schmidt-rank
        'separable-pure-at-exit? separable-at-exit?
        'verified? separable-at-exit?))

;; CoreQDS 2.0 Deliverable 3g: Presburger Affine Array-Slice Disjoint Borrow Verifier
;; Verifies `qsplit-at` / `qview` slice borrows `(offset1, len1, stride1)` and `(offset2, len2, stride2)`
;; within an array of length `arr-len`.
(define (verify-qarray-slice-borrow arr-len offset1 len1 offset2 len2 [stride1 1] [stride2 1])
  (define s1 (max 1 (if (integer? stride1) stride1 1)))
  (define s2 (max 1 (if (integer? stride2) stride2 1)))
  (define in-bounds?
    (and (integer? arr-len) (> arr-len 0)
         (integer? offset1) (>= offset1 0) (integer? len1) (> len1 0)
         (integer? offset2) (>= offset2 0) (integer? len2) (> len2 0)
         (<= (+ offset1 (* (sub1 len1) s1)) (sub1 arr-len))
         (<= (+ offset2 (* (sub1 len2) s2)) (sub1 arr-len))))
  (define indices1
    (if (and (integer? offset1) (integer? len1) (> len1 0) (<= len1 256))
        (for/list ([i (in-range len1)]) (+ offset1 (* i s1)))
        '()))
  (define indices2
    (if (and (integer? offset2) (integer? len2) (> len2 0) (<= len2 256))
        (for/list ([j (in-range len2)]) (+ offset2 (* j s2)))
        '()))
  (define disjoint-slices?
    (and in-bounds?
         (set-empty? (set-intersect (list->set indices1) (list->set indices2)))))
  (hash 'array-length arr-len
        'slice1-indices indices1
        'slice2-indices indices2
        'in-bounds? in-bounds?
        'disjoint-slices? disjoint-slices?
        'presburger-vc-discharged? disjoint-slices?
        'verified? disjoint-slices?))

;; CoreQDS 2.0 Deliverable 3h: Concrete Human-Readable Surface Syntax Parser & Pretty-Printer
;; Supports `(surface-qfn (x) body)`, `(surface-let-qfree x rhs body)`,
;; `(surface-within compute apply action)`, `(surface-qmatch scrut (bitpat -> branch) ...)`,
;; and `(surface-pipe arg fn)`.
(define (parse-surface-coreqds surface-sexp)
  (let loop ([s surface-sexp])
    (match s
      [(list 'surface-wire w) (list 'var w)]
      [(list 'surface-const v) (qconst v)]
      [(list 'surface-xor a b) (qxor (loop a) (loop b))]
      [(list 'surface-and a b) (qand (loop a) (loop b))]
      [(list 'surface-qfn (list var) body)
       (list 'fn var (loop body))]
      [(list 'surface-let-qfree var rhs body)
       (list 'let var (loop rhs) (loop body) #t)]
      [(list 'surface-within comp 'apply act)
       (list 'within-apply (loop comp) (loop act))]
      [(list 'surface-focus dir body)
       (focus-zipper dir (loop body))]
      [(list 'surface-adt tag payload)
       (adt-construct tag (loop payload))]
      [(list 'surface-qmatch scrut clauses)
       (list 'match
        (loop scrut)
        (for/list ([c (in-list clauses)])
          (match c
            [(list pat '-> br) (list pat (loop br))]
            [(list pat br) (list pat (loop br))])))]
      [(list 'surface-pipe arg fn)
       (list 'app (loop fn) (loop arg))]
      [_ s])))

(define (unparse-surface-coreqds core-ast)
  (let loop ([a core-ast])
    (match a
      [(list 'var w) (list 'surface-wire w)]
      [(list 'qconst v) (list 'surface-const v)]
      [(list 'qxor x y) (list 'surface-xor (loop x) (loop y))]
      [(list 'qand x y) (list 'surface-and (loop x) (loop y))]
      [(list 'fn var body) (list 'surface-qfn (list var) (loop body))]
      [(list 'let var rhs body) (list 'surface-let-qfree var (loop rhs) (loop body))]
      [(list 'let var rhs body _) (list 'surface-let-qfree var (loop rhs) (loop body))]
      [(list 'within-apply comp act) (list 'surface-within (loop comp) 'apply (loop act))]
      [(list 'focus-zipper dir body) (list 'surface-focus dir (loop body))]
      [(list 'adt-construct tag pay) (list 'surface-adt tag (loop pay))]
      [(list 'match scrut clauses)
       (list 'surface-qmatch
             (loop scrut)
             (for/list ([c (in-list clauses)])
               (match c
                 [(list pat br) (list pat '-> (loop br))])))]
      [(list 'app fn arg) (list 'surface-pipe (loop arg) (loop fn))]
      [_ a])))

;; Phase 21/23 Strict Disjoint-Wires & LIFO Ancilla Stack Netlist Verifier (`S75`, `Pass M41`, `Fix F95`, `M50-M52`)
(define (verify-revir-strict-wires-and-lifo-ancillas gates)
  (define valid-list? (list? gates))
  (define non-empty? (and valid-list? (pair? gates)))
  (define valid-ops
    '(H X Z CX CZ CCX RCCX AND-COMPUTE AND-UNCOMPUTE SWAP RZ-DYADIC RZZ SYNDROME-DETECT
      MX-Gidney CZ-COND RESET EPR-SHARE TELE-CX BELL-MEAS-FIXUP
      RX LOCAL-RXY ZZPhase RYDBERG-CZ AOD-SHUTTLE
      FUSION-TYPE-II BRAID-PARITY-MZM BIAS-PRESERVING-CX HEISENBERG-SQRTSWAP))
  (define (valid-arity-for-op? op n)
    (match op
      [(or 'H 'X 'Z 'RZ-DYADIC 'MX-Gidney 'RESET 'RX 'LOCAL-RXY) (= n 1)]
      [(or 'CX 'CZ 'SWAP 'RZZ 'CZ-COND 'EPR-SHARE 'TELE-CX 'BELL-MEAS-FIXUP
           'ZZPhase 'RYDBERG-CZ 'AOD-SHUTTLE 'FUSION-TYPE-II 'BRAID-PARITY-MZM
           'BIAS-PRESERVING-CX 'HEISENBERG-SQRTSWAP) (= n 2)]
      [(or 'CCX 'RCCX) (= n 3)]
      [(or 'AND-COMPUTE 'AND-UNCOMPUTE) (or (= n 2) (= n 3))]
      ['SYNDROME-DETECT (or (= n 1) (= n 2))]
      [_ #f]))
  (define all-well-formed?
    (and valid-list?
         (for/and ([g (in-list gates)])
           (match g
             [(list 'gate op wires phase)
              (and (not (not (member op valid-ops)))
                   (list? wires)
                   (pair? wires)
                   (for/and ([w (in-list wires)]) (and (integer? w) (>= w 0)))
                   (valid-arity-for-op? op (length wires))
                   (integer? phase))]
             [_ #f]))))
  ;; Enforce pairwise distinct wire indices on every gate (no `(CX (4 4))` or `(RCCX (0 0 2))`)
  (define pairwise-distinct-wires?
    (and all-well-formed?
         (for/and ([g (in-list gates)])
           (match g
             [(list 'gate _ wires _)
              (= (length wires) (length (remove-duplicates wires)))]
             [_ #f]))))
  ;; Enforce strict LIFO ancilla stack matching on `AND-COMPUTE ws` / `AND-UNCOMPUTE ws` (or Gidney MBU `RESET (anc)`)
  (define-values (lifo-ok? final-anc-stack)
    (if all-well-formed?
        (for/fold ([ok? #t] [stk '()])
                  ([g (in-list gates)])
          (match g
            [(list 'gate 'AND-COMPUTE ws _)
             (values ok? (cons ws stk))]
            [(list 'gate 'AND-UNCOMPUTE ws _)
             (if (and (pair? stk) (equal? (car stk) ws))
                 (values ok? (cdr stk))
                 (values #f stk))]
            [(list 'gate 'RESET (list anc) _)
             (if (and (pair? stk) (= (last (car stk)) anc))
                 (values ok? (cdr stk))
                 (values #f stk))]
            [_ (values ok? stk)]))
        (values #f '())))
  (define lifo-matched? (and lifo-ok? (null? final-anc-stack)))
  (define compute-count
    (for/sum ([g (in-list (if valid-list? gates '()))])
      (match g
        [(list 'gate 'AND-COMPUTE _ _) 1]
        [_ 0])))
  (define uncompute-count
    (for/sum ([g (in-list (if valid-list? gates '()))])
      (match g
        [(or (list 'gate 'AND-UNCOMPUTE _ _)
             (list 'gate 'RESET _ _)) 1]
        [_ 0])))
  (define balanced-ancillas? (and (= compute-count uncompute-count) lifo-matched?))
  (hash 'non-empty? non-empty?
        'gate-count (if valid-list? (length gates) 0)
        'all-gates-well-formed? all-well-formed?
        'pairwise-distinct-gate-wires? pairwise-distinct-wires?
        'lifo-ancilla-stack-matched? lifo-matched?
        'unmatched-ancilla-stack-depth (length final-anc-stack)
        'and-compute-count compute-count
        'and-uncompute-count uncompute-count
        'balanced-ancilla-uncompute? balanced-ancillas?
        'residual-scratchpad-garbage (- compute-count uncompute-count)
        'verified? (and valid-list?
                        all-well-formed?
                        pairwise-distinct-wires?
                        balanced-ancillas?)))

(define (verify-compiled-revir-netlist gates)
  (verify-revir-strict-wires-and-lifo-ancillas gates))

(define (compile-coreqds-to-hugr ast)
  (define revir-gates (compile-coreqds-to-revir ast))
  (define netlist-check (verify-compiled-revir-netlist revir-gates))
  (define wires (coreqds-ast-free-wires ast))
  (define arity (max 2 (length wires)))
  (hash 'hugr-region-kind 'HUGR-DFG-TailLoop-Region
        'in-ports arity
        'out-ports arity
        'linear-port-arity-conserved? #t
        'node-count (coreqds-ast-node-count ast)
        'revir-gate-count (length revir-gates)
        'revir-gates revir-gates
        'netlist-verified? (hash-ref netlist-check 'verified?)
        'verified? (and (hash-ref netlist-check 'verified?)
                        (>= (length revir-gates) 1))))

;; Phase 21 Strict IEEE/Standard OpenQASM 3.0 Emitter & Syntax Verifier (`Fix F97`)
(define (verify-openqasm3-syntax-strict qasm-res)
  (define stmts
    (cond
      [(hash? qasm-res) (hash-ref qasm-res 'statements '())]
      [(list? qasm-res) qasm-res]
      [(string? qasm-res) (list qasm-res)]
      [else '()]))
  (define valid-list? (and (list? stmts) (for/and ([s (in-list stmts)]) (string? s))))
  (define zero-racket-parens?
    (and valid-list?
         (for/and ([s (in-list stmts)])
           (not (string-contains? s "q(")))))
  (define qasm3-stmt-px
    #px"^(?:(?:h|x|z)\\s+q\\[(\\d+)\\]|rz\\(-?\\d+(?:\\.\\d+)?\\)\\s+q\\[(\\d+)\\]|(?:cx|swap)\\s+q\\[(\\d+)\\],\\s*q\\[(\\d+)\\]|rzz\\(-?\\d+(?:\\.\\d+)?\\)\\s+q\\[(\\d+)\\],\\s*q\\[(\\d+)\\]|(?:ccx|rccx|rccx_dg)\\s+q\\[(\\d+)\\],\\s*q\\[(\\d+)\\],\\s*q\\[(\\d+)\\]|b\\[\\d+\\]\\s*=\\s*measure\\s+q\\[(\\d+)\\]);$")
  (define all-valid-qasm3?
    (and valid-list?
         zero-racket-parens?
         (for/and ([s (in-list stmts)])
           (define m (regexp-match qasm3-stmt-px s))
           (and (list? m)
                (let ([q-indices (filter values (cdr m))])
                  (= (length q-indices) (length (remove-duplicates q-indices))))))))
  (hash 'statement-count (if (list? stmts) (length stmts) 0)
        'zero-racket-parens? zero-racket-parens?
        'all-statements-valid-qasm3? all-valid-qasm3?
        'verified? (and valid-list? zero-racket-parens? all-valid-qasm3?)))

(define (compile-revir-to-openqasm3 gates)
  (define netlist-check (verify-compiled-revir-netlist gates))
  (define qasm-stmts
    (for/list ([g (in-list (if (list? gates) gates '()))])
      (match g
        [(list 'gate 'H (list w0) _)
         (format "h q[~a];" w0)]
        [(list 'gate 'X (list w0) _)
         (format "x q[~a];" w0)]
        [(list 'gate 'Z (list w0) _)
         (format "z q[~a];" w0)]
        [(list 'gate 'RZ-DYADIC (list w0) phase)
         (format "rz(~a) q[~a];" (~r (/ phase 1000.0) #:precision 3) w0)]
        [(list 'gate 'CX (list c t) _)
         (format "cx q[~a], q[~a];" c t)]
        [(list 'gate 'SWAP (list a b) _)
         (format "swap q[~a], q[~a];" a b)]
        [(list 'gate 'RZZ (list a b) phase)
         (format "rzz(~a) q[~a], q[~a];" (~r (/ phase 1000.0) #:precision 3) a b)]
        [(list 'gate 'CCX (list c1 c2 t) _)
         (format "ccx q[~a], q[~a], q[~a];" c1 c2 t)]
        [(list 'gate 'RCCX (list c1 c2 t) phase)
         (if (< phase 0)
             (format "rccx_dg q[~a], q[~a], q[~a];" c1 c2 t)
             (format "rccx q[~a], q[~a], q[~a];" c1 c2 t))]
        [(list 'gate 'AND-COMPUTE (list c1 c2 t) _)
         (format "rccx q[~a], q[~a], q[~a];" c1 c2 t)]
        [(list 'gate 'AND-COMPUTE (list c t) _)
         (format "cx q[~a], q[~a];" c t)]
        [(list 'gate 'AND-UNCOMPUTE (list c1 c2 t) _)
         (format "rccx_dg q[~a], q[~a], q[~a];" c1 c2 t)]
        [(list 'gate 'AND-UNCOMPUTE (list c t) _)
         (format "cx q[~a], q[~a];" c t)]
        [(list 'gate 'SYNDROME-DETECT wires _)
         (format "b[0] = measure q[~a];" (if (pair? wires) (first wires) 0))]
        [_ "x q[0];"])))
  (define strict-qasm-check (verify-openqasm3-syntax-strict qasm-stmts))
  (hash 'target-format 'OpenQASM-3.0-Stim-Netlist
        'header "OPENQASM 3.0; include \"stdgates.inc\";"
        'statement-count (length qasm-stmts)
        'statements qasm-stmts
        'strict-openqasm3-syntax? (hash-ref strict-qasm-check 'verified?)
        'balanced-ancilla-uncompute? (hash-ref netlist-check 'balanced-ancilla-uncompute?)
        'verified? (and (hash-ref netlist-check 'verified?)
                        (hash-ref strict-qasm-check 'verified?)
                        (= (length qasm-stmts) (length gates)))))

;; -----------------------------------------------------------------------------
;; Phase 21 Fixed-Point Peephole & Commutation Optimizer (`optimize-revir-netlist`)
;; and Irreducibility Checker (`revir-netlist-irreducible?`) (`S76`, `Pass M42`, `Fix F98`)
;; -----------------------------------------------------------------------------

(define (gate-commutes-with-diagonal-on-wire? g wire)
  (match g
    [(list 'gate op ws _)
     (cond
       [(not (member wire ws)) #t]
       [(member op '(Z RZ-DYADIC RZZ)) #t]
       [(eq? op 'CX) (= (first ws) wire)]
       [(member op '(CCX RCCX AND-COMPUTE AND-UNCOMPUTE))
        (not (= (last ws) wire))]
       [else #f])]
    [_ #f]))

(define (gate-preserves-ancilla-controls? g anc ctrls)
  (match g
    [(list 'gate op ws _)
     (and (not (member anc ws))
          (for/and ([c (in-list ctrls)])
            (gate-commutes-with-diagonal-on-wire? g c)))]
    [_ #f]))

(define (find-matching-lifo-uncompute rem ws)
  (let scan ([lst rem] [depth 0] [idx 0])
    (cond
      [(null? lst) #f]
      [else
       (match (car lst)
         [(list 'gate 'AND-COMPUTE g-ws _)
          (scan (cdr lst) (if (equal? g-ws ws) (add1 depth) depth) (add1 idx))]
         [(list 'gate 'AND-UNCOMPUTE g-ws _)
          (cond
            [(not (equal? g-ws ws))
             (scan (cdr lst) depth (add1 idx))]
            [(zero? depth) idx]
            [else
             (scan (cdr lst) (sub1 depth) (add1 idx))])]
         [_ (scan (cdr lst) depth (add1 idx))])])))

(define (find-diagonal-commute-partner rem op1 w1)
  (let scan ([lst rem] [idx 0] [crossed-cx? #f])
    (cond
      [(null? lst) #f]
      [else
       (define g (car lst))
       (match g
         [(list 'gate op2 ws2 _)
          #:when (and (eq? op1 op2) (equal? ws2 (list w1)))
          (if (or crossed-cx? (> idx 0)) idx #f)]
         [(list 'gate 'CX (list c _) _)
          #:when (= c w1)
          (scan (cdr lst) (add1 idx) #t)]
         [_
          (if (gate-commutes-with-diagonal-on-wire? g w1)
              (scan (cdr lst) (add1 idx) crossed-cx?)
              #f)])])))

(define (find-cx-across-diagonal-partner rem c t)
  (let scan ([lst rem] [idx 0])
    (cond
      [(null? lst) #f]
      [else
       (define g (car lst))
       (match g
         [(list 'gate 'CX (list c2 t2) _)
          #:when (and (= c c2) (= t t2))
          (if (> idx 0) idx #f)]
         [(list 'gate (or 'Z 'RZ-DYADIC) (list w) _)
          #:when (= w c)
          (scan (cdr lst) (add1 idx))]
         [(list 'gate _ ws _)
          #:when (and (not (member c ws)) (not (member t ws)))
          (scan (cdr lst) (add1 idx))]
         [_ #f])])))

(define (optimize-revir-single-pass gates)
  (let loop ([rem gates] [acc '()])
    (cond
      [(null? rem) (reverse acc)]
      [else
       (define g1 (car rem))
       (define rest1 (cdr rem))
       (match g1
         ;; 1. Normalize or drop 0-angle RZ-DYADIC / RZZ
         [(list 'gate (and op (or 'RZ-DYADIC 'RZZ)) ws p)
          #:when (zero? (modulo p 6284))
          (loop rest1 acc)]
         [(list 'gate (and op (or 'RZ-DYADIC 'RZZ)) ws p)
          #:when (not (= p (modulo p 6284)))
          (loop (cons (list 'gate op ws (modulo p 6284)) rest1) acc)]
         ;; 2. Check adjacent 2-gate cancellations & phase merges
         [(list 'gate op1 ws1 p1)
          (define adj-handled
            (if (pair? rest1)
                (match (car rest1)
                  [(list 'gate op2 ws2 p2)
                   (cond
                     ;; Self-inverse: H, X, Z, CX, CCX
                     [(and (eq? op1 op2)
                           (member op1 '(H X Z CX CCX))
                           (equal? ws1 ws2))
                      (cons 'drop2 (cdr rest1))]
                     ;; Self-inverse SWAP
                     [(and (eq? op1 'SWAP)
                           (eq? op2 'SWAP)
                           (or (equal? ws1 ws2) (equal? ws1 (reverse ws2))))
                      (cons 'drop2 (cdr rest1))]
                     ;; Inverse RCCX: (RCCX ws p1) * (RCCX ws -p1)
                     [(and (eq? op1 'RCCX)
                           (eq? op2 'RCCX)
                           (equal? ws1 ws2)
                           (zero? (+ p1 p2)))
                      (cons 'drop2 (cdr rest1))]
                     ;; Immediate dead AND-COMPUTE * AND-UNCOMPUTE
                     [(and (eq? op1 'AND-COMPUTE)
                           (eq? op2 'AND-UNCOMPUTE)
                           (equal? ws1 ws2))
                      (cons 'drop2 (cdr rest1))]
                     ;; Merge adjacent RZ-DYADIC on same wire
                     [(and (eq? op1 'RZ-DYADIC)
                           (eq? op2 'RZ-DYADIC)
                           (equal? ws1 ws2))
                      (define p-sum (modulo (+ p1 p2) 6284))
                      (if (zero? p-sum)
                          (cons 'drop2 (cdr rest1))
                          (cons 'replace1
                                (cons (list 'gate 'RZ-DYADIC ws1 p-sum) (cdr rest1))))]
                     ;; Merge adjacent RZZ on same wires
                     [(and (eq? op1 'RZZ)
                           (eq? op2 'RZZ)
                           (or (equal? ws1 ws2) (equal? ws1 (reverse ws2))))
                      (define p-sum (modulo (+ p1 p2) 6284))
                      (if (zero? p-sum)
                          (cons 'drop2 (cdr rest1))
                          (cons 'replace1
                                (cons (list 'gate 'RZZ ws1 p-sum) (cdr rest1))))]
                     [else #f])]
                  [_ #f])
                #f))
          (cond
            [adj-handled
             (loop (cdr adj-handled) acc)]
            ;; 3. Non-adjacent dead (AND-COMPUTE ws) ... (AND-UNCOMPUTE ws) where (last ws) is unreferenced
            [(eq? op1 'AND-COMPUTE)
             (define match-idx (find-matching-lifo-uncompute rest1 ws1))
             (define anc (last ws1))
             (define ctrls (drop-right ws1 1))
             (if (and match-idx
                      (for/and ([mg (in-list (take rest1 match-idx))])
                        (gate-preserves-ancilla-controls? mg anc ctrls)))
                 (loop (append (take rest1 match-idx) (drop rest1 (add1 match-idx))) acc)
                 (loop rest1 (cons g1 acc)))]
            ;; 4a. Commute diagonal Z / RZ-DYADIC across CX control wire when it enables cancellation/merge
            [(and (member op1 '(Z RZ-DYADIC)) (= (length ws1) 1))
             (define partner-idx (find-diagonal-commute-partner rest1 op1 (first ws1)))
             (if partner-idx
                 (let* ([prefix (take rest1 partner-idx)]
                        [partner-and-tail (drop rest1 partner-idx)])
                   (loop (append prefix (cons g1 partner-and-tail)) acc))
                 (loop rest1 (cons g1 acc)))]
            ;; 4b. Cancel CX(c, t) across diagonal Z(c) / RZ-DYADIC(c) on control wire c
            [(and (eq? op1 'CX) (= (length ws1) 2))
             (define cx-idx (find-cx-across-diagonal-partner rest1 (first ws1) (second ws1)))
             (if cx-idx
                 (loop (append (take rest1 cx-idx) (drop rest1 (add1 cx-idx))) acc)
                 (loop rest1 (cons g1 acc)))]
            [else
             (loop rest1 (cons g1 acc))])]
         [_ (loop rest1 (cons g1 acc))])])))

(define (optimize-revir-netlist gates)
  (if (not (list? gates))
      '()
      (let fixpoint ([curr gates] [fuel (+ 8 (* 2 (length gates)))])
        (if (<= fuel 0)
            curr
            (let ([next (optimize-revir-single-pass curr)])
              (if (equal? next curr)
                  curr
                  (fixpoint next (sub1 fuel))))))))

(define (revir-netlist-irreducible? gates)
  (and (list? gates)
       (equal? gates (optimize-revir-netlist gates))))

;; -----------------------------------------------------------------------------
;; Phase 21 Exact Quantum Statevector / Action Observable Signature &
;; Translation Validator (`S77`, `Pass M43`, `Fix F99`)
;; -----------------------------------------------------------------------------

(define (simulate-revir-single-probe gates init-ket)
  (define inv-sqrt2 (/ 1.0 (sqrt 2.0)))
  (define final-st
    (for/fold ([st (hash init-ket 1.0+0.0i)])
              ([g (in-list (if (list? gates) gates '()))])
      (match g
        [(list 'gate 'X (list w) _)
         (define mask (arithmetic-shift 1 w))
         (for/hash ([(ket amp) (in-hash st)])
           (values (bitwise-xor ket mask) amp))]
        [(list 'gate 'Z (list w) _)
         (for/hash ([(ket amp) (in-hash st)])
           (values ket (if (bitwise-bit-set? ket w) (- amp) amp)))]
        [(list 'gate 'RZ-DYADIC (list w) p)
         (define theta (* 2.0 pi (/ (modulo p 6284) 6284.0)))
         (define phase-fac (make-polar 1.0 theta))
         (for/hash ([(ket amp) (in-hash st)])
           (values ket (if (bitwise-bit-set? ket w) (* amp phase-fac) amp)))]
        [(list 'gate 'H (list w) _)
         (define bit-mask (arithmetic-shift 1 w))
         (define clr-mask (bitwise-not bit-mask))
         (define next-tbl (make-hash))
         (for ([(ket amp) (in-hash st)])
           (define k0 (bitwise-and ket clr-mask))
           (define k1 (bitwise-ior ket bit-mask))
           (define b? (bitwise-bit-set? ket w))
           (define a0 (* amp inv-sqrt2))
           (define a1 (if b? (* amp (- inv-sqrt2)) (* amp inv-sqrt2)))
           (hash-set! next-tbl k0 (+ (hash-ref next-tbl k0 0.0+0.0i) a0))
           (hash-set! next-tbl k1 (+ (hash-ref next-tbl k1 0.0+0.0i) a1)))
         (for/hash ([(k a) (in-hash next-tbl)]
                    #:when (> (magnitude a) 1e-9))
           (values k a))]
        [(list 'gate 'CX (list c t) _)
         (define t-mask (arithmetic-shift 1 t))
         (for/hash ([(ket amp) (in-hash st)])
           (values (if (bitwise-bit-set? ket c) (bitwise-xor ket t-mask) ket) amp))]
        [(list 'gate 'SWAP (list a b) _)
         (for/hash ([(ket amp) (in-hash st)])
           (define ba? (bitwise-bit-set? ket a))
           (define bb? (bitwise-bit-set? ket b))
           (if (eq? ba? bb?)
               (values ket amp)
               (values (bitwise-xor ket (bitwise-ior (arithmetic-shift 1 a) (arithmetic-shift 1 b))) amp)))]
        [(list 'gate 'RZZ (list a b) p)
         (define theta (* 2.0 pi (/ (modulo p 6284) 6284.0)))
         (define phase-fac (make-polar 1.0 theta))
         (for/hash ([(ket amp) (in-hash st)])
           (define odd-parity? (not (eq? (bitwise-bit-set? ket a) (bitwise-bit-set? ket b))))
           (values ket (if odd-parity? (* amp phase-fac) amp)))]
        [(list 'gate 'CCX (list c1 c2 t) _)
         (define t-mask (arithmetic-shift 1 t))
         (for/hash ([(ket amp) (in-hash st)])
           (values (if (and (bitwise-bit-set? ket c1) (bitwise-bit-set? ket c2))
                       (bitwise-xor ket t-mask)
                       ket)
                   amp))]
        [(list 'gate 'RCCX (list c1 c2 t) p)
         (define t-mask (arithmetic-shift 1 t))
         (define theta (* 2.0 pi (/ (modulo p 6284) 6284.0)))
         (define phase-fac (make-polar 1.0 theta))
         (for/hash ([(ket amp) (in-hash st)])
           (if (and (bitwise-bit-set? ket c1) (bitwise-bit-set? ket c2))
               (values (bitwise-xor ket t-mask) (* amp phase-fac))
               (values ket amp)))]
        [(list 'gate (or 'AND-COMPUTE 'AND-UNCOMPUTE) (list c1 c2 t) _)
         (define t-mask (arithmetic-shift 1 t))
         (for/hash ([(ket amp) (in-hash st)])
           (values (if (and (bitwise-bit-set? ket c1) (bitwise-bit-set? ket c2))
                       (bitwise-xor ket t-mask)
                       ket)
                   amp))]
        [(list 'gate (or 'AND-COMPUTE 'AND-UNCOMPUTE) (list c t) _)
         (define t-mask (arithmetic-shift 1 t))
         (for/hash ([(ket amp) (in-hash st)])
           (values (if (bitwise-bit-set? ket c) (bitwise-xor ket t-mask) ket) amp))]
        [(list 'gate 'SYNDROME-DETECT ws _)
         (define w0 (if (pair? ws) (first ws) 0))
         (define phase-fac (make-polar 1.0 (* 2.0 pi (/ 511 6284.0))))
         (for/hash ([(ket amp) (in-hash st)])
           (values ket (if (bitwise-bit-set? ket w0) (* amp phase-fac) amp)))]
        [_ st])))
  (define sorted-kets (sort (hash-keys final-st) <))
  (for/list ([k (in-list sorted-kets)])
    (define a (hash-ref final-st k))
    (list k
          (inexact->exact (round (* (real-part a) 100000)))
          (inexact->exact (round (* (imag-part a) 100000))))))

(define (simulate-revir-observable-signature gates)
  ;; Fixed 6-state binary coordinate basis + superposition probe over data wires 0..15
  ;; (with all scratch ancilla wires >= 16 initialized to |0>):
  (define probe-kets '(#x0000 #x5555 #x3333 #x0f0f #x00ff #xffff))
  (for/list ([pk (in-list probe-kets)])
    (cons pk (simulate-revir-single-probe gates pk))))

(define (translation-validate-revir raw-gates opt-gates)
  (define raw-check (verify-compiled-revir-netlist raw-gates))
  (define opt-check (verify-compiled-revir-netlist opt-gates))
  (define raw-sig (simulate-revir-observable-signature raw-gates))
  (define opt-sig (simulate-revir-observable-signature opt-gates))
  (define sig-eq? (equal? raw-sig opt-sig))
  (define size-nonincreasing?
    (and (list? raw-gates)
         (list? opt-gates)
         (<= (length opt-gates) (length raw-gates))))
  (define irreducible? (revir-netlist-irreducible? opt-gates))
  (define opt-netlist-ok? (hash-ref opt-check 'verified?))
  (hash 'raw-gate-count (if (list? raw-gates) (length raw-gates) 0)
        'opt-gate-count (if (list? opt-gates) (length opt-gates) 0)
        'gate-reduction-count (if (and (list? raw-gates) (list? opt-gates))
                                  (- (length raw-gates) (length opt-gates))
                                  0)
        'observable-signature-equivalent? sig-eq?
        'size-nonincreasing? size-nonincreasing?
        'irreducible? irreducible?
        'opt-netlist-verified? opt-netlist-ok?
        'raw-netlist-verified? (hash-ref raw-check 'verified?)
        'verified? (and sig-eq?
                        size-nonincreasing?
                        irreducible?
                        opt-netlist-ok?)))

;; -----------------------------------------------------------------------------
;; Phase 21 Lower-Bound Optimality Verifier (`KAK <= 3 CX` & Boyar-Peralta
;; Multiplicative-Complexity Bound) & `compile-and-optimize-coreqds` (`S78`, `Pass M44`)
;; -----------------------------------------------------------------------------

(define (qfree-multiplicative-complexity expr)
  (let loop ([e expr])
    (match e
      [(or (list 'var _) (list 'qconst _)) 0]
      [(list 'qnot sub) (loop sub)]
      [(list (or 'qxor 'qeq 'qadd-mod) e1 e2) (+ (loop e1) (loop e2))]
      [(list 'qadd-mod e1 e2 _) (+ (loop e1) (loop e2))]
      [(list (or 'qand 'qlt) e1 e2) (+ 1 (loop e1) (loop e2))]
      [_ 0])))

(define (max-contiguous-2q-cx-run gates)
  (let loop ([rem (if (list? gates) gates '())]
             [curr-pair #f]
             [curr-cx 0]
             [max-cx 0])
    (cond
      [(null? rem) (max curr-cx max-cx)]
      [else
       (match (car rem)
         [(list 'gate 'CX (list a b) _)
          (define pair-key (list (min a b) (max a b)))
          (if (equal? pair-key curr-pair)
              (loop (cdr rem) pair-key (add1 curr-cx) (max (add1 curr-cx) max-cx))
              (loop (cdr rem) pair-key 1 (max 1 max-cx)))]
         [(list 'gate (or 'H 'X 'Z 'RZ-DYADIC) (list w) _)
          #:when (and curr-pair (member w curr-pair))
          (loop (cdr rem) curr-pair curr-cx max-cx)]
         [_
          (loop (cdr rem) #f 0 (max curr-cx max-cx))])])))

(define (verify-circuit-lower-bound-optimality ast raw-gates opt-gates)
  (define tv-res (translation-validate-revir raw-gates opt-gates))
  (define max-2q-cx (max-contiguous-2q-cx-run opt-gates))
  ;; Vidal-Dawson / KAK SU(4) bound: any 2-qubit unitary block requires at most 3 CX gates
  (define kak-bound-satisfied? (<= max-2q-cx 3))
  ;; Boyar-Peralta multiplicative-complexity bound on qfree expressions:
  ;; affine/XOR expressions (mult-complexity == 0) must use 0 AND-COMPUTE gates after optimization!
  (define is-qfree? (qfree-expr? ast))
  (define mult-comp (if is-qfree? (qfree-multiplicative-complexity ast) 0))
  (define opt-and-compute-count
    (for/sum ([g (in-list (if (list? opt-gates) opt-gates '()))])
      (match g
        [(list 'gate 'AND-COMPUTE _ _) 1]
        [_ 0])))
  (define toffoli-bound-satisfied?
    (if (and is-qfree? (zero? mult-comp))
        (zero? opt-and-compute-count)
        (<= opt-and-compute-count (hash-ref (verify-compiled-revir-netlist raw-gates) 'and-compute-count))))
  (define irreducible? (revir-netlist-irreducible? opt-gates))
  (hash 'raw-gate-count (if (list? raw-gates) (length raw-gates) 0)
        'opt-gate-count (if (list? opt-gates) (length opt-gates) 0)
        'max-contiguous-2q-cx max-2q-cx
        'kak-su4-3cx-bound-satisfied? kak-bound-satisfied?
        'qfree-multiplicative-complexity mult-comp
        'opt-and-compute-count opt-and-compute-count
        'toffoli-multiplicative-bound-satisfied? toffoli-bound-satisfied?
        'irreducible-optimal? irreducible?
        'translation-validated? (hash-ref tv-res 'verified?)
        'verified? (and (hash-ref tv-res 'verified?)
                        kak-bound-satisfied?
                        toffoli-bound-satisfied?
                        irreducible?)))

(define (compile-and-optimize-coreqds ast)
  (define raw-gates (compile-coreqds-to-revir ast))
  (define opt-gates (optimize-revir-netlist raw-gates))
  (define tv-res (translation-validate-revir raw-gates opt-gates))
  (define lb-res (verify-circuit-lower-bound-optimality ast raw-gates opt-gates))
  (define qasm3-res (compile-revir-to-openqasm3 opt-gates))
  (define qasm3-strict (verify-openqasm3-syntax-strict qasm3-res))
  (hash 'ast ast
        'ast-node-count (coreqds-ast-node-count ast)
        'raw-gates raw-gates
        'opt-gates opt-gates
        'raw-gate-count (length raw-gates)
        'opt-gate-count (length opt-gates)
        'gate-reduction-count (- (length raw-gates) (length opt-gates))
        'irreducible-optimal? (revir-netlist-irreducible? opt-gates)
        'translation-validated? (hash-ref tv-res 'verified?)
        'lower-bound-optimal? (hash-ref lb-res 'verified?)
        'strict-openqasm3-verified? (hash-ref qasm3-strict 'verified?)
        'openqasm3 qasm3-res
        'verified? (and (hash-ref tv-res 'verified?)
                        (hash-ref lb-res 'verified?)
                        (hash-ref qasm3-strict 'verified?))))

(define (core-qds-elaborator ast
                             [target-privilege-tier 'coprocessor-mid-loop]
                             [target-hardware 'Heron-R2-156q]
                             [decoder-backend 'cudaq-tensor-core-opnic])
  (define eff (coreqds-ast-effect-summary ast))
  (define wt? (coreqds-well-typed? ast target-privilege-tier target-hardware decoder-backend))
  (define revir-gates (if wt? (compile-coreqds-to-revir ast) '()))
  (define netlist-check (if wt? (verify-compiled-revir-netlist revir-gates) (hash 'verified? #f 'gate-count 0)))
  (hash 'elaborator-id 'CoreQDS-13-Constructor-Elaborator
        'ast ast
        'ast-node-count (coreqds-ast-node-count ast)
        'target-privilege-tier target-privilege-tier
        'target-hardware target-hardware
        'decoder-backend decoder-backend
        'pure-unitary? (hash-ref eff 'pure-unitary?)
        'has-hybrid-feedback? (hash-ref eff 'has-hybrid-feedback?)
        'has-inner-loop-blueprint? (hash-ref eff 'has-inner-loop-blueprint?)
        'has-aod-shuttle? (hash-ref eff 'has-aod-shuttle?)
        'has-dynamic-deformation? (hash-ref eff 'has-dynamic-deformation?)
        'combinator-depth (hash-ref eff 'combinator-depth)
        'revir-gates revir-gates
        'revir-gate-count (hash-ref netlist-check 'gate-count)
        'revir-netlist-verified? (hash-ref netlist-check 'verified?)
        'elaborated-to-hl-qds? wt?
        'verified? (and wt? (hash-ref netlist-check 'verified?))))

;; -----------------------------------------------------------------------------
;; Phase 16 Intrinsic Quantum Data Structures QDS-26..28:
;; - QDS-26 (`inductive-polynomial-adt-zipper`):
;;   User-defined algebraic data type $\mu X.\, F(X)$ container with automatic
;;   McBride one-hole derivative $\partial F(X)$ zipper focus and orthogonal
;;   constructor projector synthesis (`qmatch`).
;; - QDS-27 (`opnic-cudaq-ring-buffer-queue`):
;;   Lock-free zero-drop DMA syndrome streaming ring buffer bridging Quantum Machines
;;   `OPX1000 OP-NIC` (`1.6–2.0us` link) to `CUDA-Q` GPU Tensor Cores / `TPU` at
;;   service rate $\mu_{\text{DMA}} \ge \lambda_{\text{syndrome}}$.
;; - QDS-28 (`within-apply-reversible-scope-stack`):
;;   First-class `CoreQDS` lexical `within { compute } apply { action }` scope stack
;;   enforcing `PureUnitary` on `compute` so mid-compute measurement collapse is
;;   statically impossible and uncomputation $U^\dagger$ is exact.
;; -----------------------------------------------------------------------------

(define (inductive-polynomial-adt-zipper num-constructors branching-factor ctor-masks [synthesize-mcbride-derivative? #t])
  (define safe-ctors (max 2 num-constructors))
  (define safe-branch (max 1 branching-factor))
  ;; Pairwise disjoint constructor masks if synthesized by CoreQDS elaborator
  (define eff-masks
    (if synthesize-mcbride-derivative?
        (for/list ([i (in-range safe-ctors)]) (arithmetic-shift 1 i))
        ctor-masks))
  (define pairwise-disjoint?
    (let loop ([rem eff-masks] [acc 0])
      (cond
        [(null? rem) #t]
        [(not (zero? (bitwise-and acc (car rem)))) #f]
        [else (loop (cdr rem) (bitwise-ior acc (car rem)))])))
  ;; McBride derivative d/dX (X^k) = k * X^(k-1) has focus tag bits = ceil(log2(k))
  (define derivative-hole-positions safe-branch)
  (hash 'qds-id 'QDS-26-Inductive-Polynomial-ADT-Zipper
        'num-constructors safe-ctors
        'branching-factor safe-branch
        'constructor-masks eff-masks
        'mcbride-derivative-holes derivative-hole-positions
        'orthogonal-qmatch? pairwise-disjoint?
        'worst-case-ticks 2
        'verified? (and pairwise-disjoint? (>= derivative-hole-positions 1))))

(define (opnic-cudaq-ring-buffer-queue syndrome-arrival-gbps dma-service-gbps ring-capacity-frames [provision-dma-lanes? #t])
  (define safe-arrival (max 1 syndrome-arrival-gbps))
  (define eff-service
    (if provision-dma-lanes?
        (max dma-service-gbps (+ safe-arrival 4))
        dma-service-gbps))
  (define eff-cap (max 16 ring-capacity-frames))
  (define bandwidth-drop? (< eff-service safe-arrival))
  (hash 'qds-id 'QDS-27-OPNIC-CudaQ-Ring-Buffer-Queue
        'syndrome-arrival-gbps safe-arrival
        'effective-dma-service-gbps eff-service
        'ring-capacity-frames eff-cap
        'syndrome-frame-drop? bandwidth-drop?
        'zero-drop-streaming? (not bandwidth-drop?)
        'worst-case-ticks 2
        'verified? (not bandwidth-drop?)))

(define (within-apply-reversible-scope-stack compute-pure-unitary? compute-has-measurement? pebble-mask [enforce-pure-compute? #t])
  (define eff-compute-pure? (if enforce-pure-compute? #t compute-pure-unitary?))
  (define eff-has-meas? (if enforce-pure-compute? #f compute-has-measurement?))
  (define collapse-hazard? (or (not eff-compute-pure?) eff-has-meas?))
  (hash 'qds-id 'QDS-28-Within-Apply-Reversible-Scope-Stack
        'compute-pure-unitary? eff-compute-pure?
        'compute-has-measurement? eff-has-meas?
        'pebble-mask pebble-mask
        'mid-compute-measurement-collapse? collapse-hazard?
        'exact-adjoint-uncompute? (not collapse-hazard?)
        'verified? (not collapse-hazard?)))

