;; -----------------------------------------------------------------------------
;; ExtendedQuantumFrameGrade & Compiler-Gap Meta-Auditor (`GAP-1..4`):
;; Compositional 3-tier pass state-transformer across `HLQdsIR -> MLRevIR -> LLMachineISA`
;; that closes all 4 architectural root-cause gaps:
;; - GAP-1 (Non-Compositional Pass-to-Pass Clobbering):
;;   Tracks `dd-echo-parity` (`'DDEvenEcho` vs `'DDOddEcho`) vs `mcm-feedforward-sign-flipped?`
;;   (catching Pass M7 odd-echo X-conjugation clobbering Pass M4/M6 Pauli frame Z-rotation
;;   sign `X * RZ(theta) * X = RZ(-theta)` in Issue F49) and `pbc-commutation-depth <= pbc-cutoff-k`
;;   (catching Litinski PBC T-gate commutation past QROAM Select-Swap exponential weight
;;   blowup `2^n` in Issue F51).
;; - GAP-2 (Persistent DAG Structural-Sharing Physical-Wire Aliasing):
;;   Tracks 64-bit physical borrow masks `(dag-borrow-control-mask, dag-borrow-target-mask)`
;;   and enforces `(bitwise-and control-mask target-mask) = 0` (Issue F50).
;; - GAP-3 (Amortized Magic-State & Syndrome Queueing Stalls + Leakage Seepage):
;;   Tracks magic-state token bucket `(magic-token-buffer + factory-refill-rate >= t-consumption-burst)`
;;   (Issue F53), strict decoder queueing stability `(syndrome-arrival-rate-mhz < decoder-service-rate-mhz)`,
;;   and periodic LRU leakage reset `(rounds-since-lru <= lru-period-r, seepage-clifford-steps = 0)`
;;   (Issue F54).
;; - GAP-4 (Period-3 Floquet Gauge Phase Slip at ZipperCut / ParDiag Boundaries):
;;   Tracks `floquet-round-mod3` in `{0, 1, 2}` and enforces `floquet-round-mod3 = 0`
;;   whenever `zipper-cut-active? = #t` (Issue F52).
;; -----------------------------------------------------------------------------
(define (extended-quantum-frame-grade
         #:dd-echo-parity [dd-echo-parity 'DDEvenEcho]
         #:mcm-feedforward-active? [mcm-feedforward-active? #t]
         #:mcm-sign-compensated? [mcm-sign-compensated? #t]
         #:dag-control-mask [dag-control-mask #b0011]
         #:dag-target-mask [dag-target-mask #b1100]
         #:pbc-commutation-depth [pbc-commutation-depth 2]
         #:pbc-cutoff-k [pbc-cutoff-k 3]
         #:floquet-round-mod3 [floquet-round-mod3 0]
         #:zipper-cut-active? [zipper-cut-active? #t]
         #:magic-token-buffer [magic-token-buffer 4]
         #:factory-refill-rate [factory-refill-rate 2]
         #:t-consumption-burst [t-consumption-burst 4]
         #:syndrome-arrival-rate-mhz [syndrome-arrival-rate-mhz 800]
         #:decoder-service-rate-mhz [decoder-service-rate-mhz 1000]
         #:rounds-since-lru [rounds-since-lru 2]
         #:lru-period-r [lru-period-r 4]
         #:seepage-clifford-steps [seepage-clifford-steps 0])
  (define dd-mcm-coherent?
    (or (not mcm-feedforward-active?)
        (eq? dd-echo-parity 'DDEvenEcho)
        mcm-sign-compensated?))
  (define pbc-weight-bounded?
    (<= pbc-commutation-depth pbc-cutoff-k))
  (define dag-borrow-disjoint?
    (= (bitwise-and dag-control-mask dag-target-mask) 0))
  (define floquet-gauge-aligned?
    (or (not zipper-cut-active?)
        (= (modulo floquet-round-mod3 3) 0)))
  (define magic-bucket-nonstarved?
    (>= (+ magic-token-buffer factory-refill-rate) t-consumption-burst))
  (define decoder-queue-stable?
    (< syndrome-arrival-rate-mhz decoder-service-rate-mhz))
  (define lru-seepage-free?
    (and (<= rounds-since-lru lru-period-r)
         (= seepage-clifford-steps 0)))
  (hash 'grade-id 'ExtendedQuantumFrameGrade
        'dd-echo-parity dd-echo-parity
        'dd-mcm-coherent? dd-mcm-coherent?
        'pbc-commutation-depth pbc-commutation-depth
        'pbc-cutoff-k pbc-cutoff-k
        'pbc-weight-bounded? pbc-weight-bounded?
        'dag-control-mask dag-control-mask
        'dag-target-mask dag-target-mask
        'dag-borrow-disjoint? dag-borrow-disjoint?
        'floquet-round-mod3 (modulo floquet-round-mod3 3)
        'floquet-gauge-aligned? floquet-gauge-aligned?
        'magic-bucket-nonstarved? magic-bucket-nonstarved?
        'decoder-queue-stable? decoder-queue-stable?
        'lru-seepage-free? lru-seepage-free?
        'gap1-pass-composition-sound? (and dd-mcm-coherent? pbc-weight-bounded?)
        'gap2-dag-borrow-disjoint? dag-borrow-disjoint?
        'gap3-queueing-and-lru-stable? (and magic-bucket-nonstarved?
                                            decoder-queue-stable?
                                            lru-seepage-free?)
        'gap4-floquet-gauge-aligned? floquet-gauge-aligned?
        'verified? (and dd-mcm-coherent?
                        pbc-weight-bounded?
                        dag-borrow-disjoint?
                        floquet-gauge-aligned?
                        magic-bucket-nonstarved?
                        decoder-queue-stable?
                        lru-seepage-free?)))

(define (compiler-gap-meta-auditor frame-grade)
  (define g1 (hash-ref frame-grade 'gap1-pass-composition-sound?))
  (define g2 (hash-ref frame-grade 'gap2-dag-borrow-disjoint?))
  (define g3 (hash-ref frame-grade 'gap3-queueing-and-lru-stable?))
  (define g4 (hash-ref frame-grade 'gap4-floquet-gauge-aligned?))
  (hash 'auditor-id 'Phase13-Compiler-Gap-Meta-Auditor
        'gap1-pass-composition-sound? g1
        'gap2-dag-borrow-disjoint? g2
        'gap3-queueing-and-lru-stable? g3
        'gap4-floquet-gauge-aligned? g4
        'all-gaps-closed? (and g1 g2 g3 g4)))

;; -----------------------------------------------------------------------------
;; QDS-17..19 Intrinsic Quantum Data Structures:
;; - QDS-17 (`bootstrapped-skew-binomial-heap`):
;;   Okasaki Bootstrapped Skew Binomial Heap with worst-case O(1) (`2` Toffolis)
;;   `insert`, `findMin`, and `merge` via skew binary links `[r, r] -> r+1`
;;   and bootstrapped root-minimum caching (`cached-min-synced? = #t`).
;; - QDS-18 (`catenable-realtime-deque`):
;;   Okasaki Catenable Real-Time Deque with worst-case O(1) (`2` pointer/CSWAP ticks)
;;   `pushFront`, `popFront`, `pushBack`, `popBack`, and `append` via lazy spine
;;   suspension buffers (`front-deg <= 2`, `rear-deg <= 2`).
;; - QDS-19 (`polynomial-functor-lens-container`):
;;   Abbott-Altenkirch-Ghani Polynomial Container `(S, P)` equipped with a
;;   Symmetric Reversible Lens `(get, put)` (`put-get`, `get-put`, `put-put` laws)
;;   and 64-bit physical qubit borrow-mask disjointness `(bitwise-and control-mask target-mask) = 0`.
;; -----------------------------------------------------------------------------
(define (bootstrapped-skew-binomial-heap rank1 rank2 [cached-min-synced? #t] [mode 'skew-bootstrapped])
  (define skew-link-valid?
    (and (eq? mode 'skew-bootstrapped)
         (or (= rank1 rank2) (= (abs (- rank1 rank2)) 1))))
  (define worst-case-toffolis
    (if (and skew-link-valid? cached-min-synced?)
        2
        14))
  (hash 'qds-id 'QDS-17-Bootstrapped-Skew-Binomial-Heap
        'mode mode
        'rank1 rank1
        'rank2 rank2
        'skew-link-valid? skew-link-valid?
        'cached-min-synced? cached-min-synced?
        'worst-case-insert-toffolis worst-case-toffolis
        'worst-case-merge-toffolis worst-case-toffolis
        'worst-case-findmin-toffolis (if cached-min-synced? 0 8)
        'constant-2toffoli-coherent? (and skew-link-valid?
                                          cached-min-synced?
                                          (= worst-case-toffolis 2))))

(define (catenable-realtime-deque front-len rear-len spine-susp-deg [in-superpos? #t] [mode 'catenable-realtime])
  (define balance-holds?
    (and (eq? mode 'catenable-realtime)
         (<= spine-susp-deg 2)
         (>= (+ front-len rear-len) 2)))
  (define worst-case-ticks
    (if balance-holds?
        2
        (max 4 (+ front-len rear-len spine-susp-deg))))
  (hash 'qds-id 'QDS-18-Catenable-RealTime-Deque
        'mode mode
        'front-len front-len
        'rear-len rear-len
        'spine-susp-deg spine-susp-deg
        'in-superpos? in-superpos?
        'balance-holds? balance-holds?
        'worst-case-ticks worst-case-ticks
        'constant-2tick-catenable? (and balance-holds? (= worst-case-ticks 2))))

(define (polynomial-functor-lens-container control-mask target-mask [put-get-holds? #t] [get-put-holds? #t])
  (define borrow-disjoint?
    (and (> control-mask 0)
         (> target-mask 0)
         (= (bitwise-and control-mask target-mask) 0)))
  (define symmetric-lens-laws? (and put-get-holds? get-put-holds?))
  (hash 'qds-id 'QDS-19-Polynomial-Functor-Lens-Container
        'control-mask control-mask
        'target-mask target-mask
        'borrow-disjoint? borrow-disjoint?
        'symmetric-lens-laws? symmetric-lens-laws?
        'verified? (and borrow-disjoint? symmetric-lens-laws?)))

;; -----------------------------------------------------------------------------
;; OQP-15..18 & TODAY-9..10 Benchmarks:
;; - OQP-15 (`oqp15-quantum-branch-and-bound-heap`):
;;   Montanaro Quantum Branch-and-Bound tree search backed by `QDS-17`
;;   Bootstrapped Skew Binomial Heap (`2` Toffolis per priority insert/merge).
;; - OQP-16 (`oqp16-catenable-deque-window-sliding-qft`):
;;   Streaming Windowed QFT / Belovs Learning Graph backed by `QDS-18`
;;   Catenable Real-Time Deque (`2` ticks per sliding-window `pushBack`/`popFront`/`append`).
;; - OQP-17 (`oqp17-floquet-honeycomb-dynamic-code`):
;;   Hastings-Haah Period-3 Honeycomb Floquet Code (`0: XX -> 1: YY -> 2: ZZ`)
;;   with mod-3 round alignment across `ZipperCut` / `ParDiag` boundaries.
;; - OQP-18 (`oqp18-hybrid-qroam-litinski-pbc-select`):
;;   Hybrid QROAM Select-Swap + Bounded-Depth Litinski Pauli-Based Computation (PBC)
;;   keeping Pauli rotation weight bounded at `<= 4` instead of `2^n`.
;; - TODAY-9 (`QuantumBranchAndBound_MaxSat_16q`):
;;   16-qubit executable MAX-SAT Quantum Branch-and-Bound benchmark using `QDS-17`.
;; - TODAY-10 (`FloquetHoneycomb_Period3_18q`):
;;   18-qubit executable Period-3 Honeycomb Floquet benchmark using `OQP-17` & `Pass M12`.
;; -----------------------------------------------------------------------------
(define (oqp15-quantum-branch-and-bound-heap num-vars tree-depth [cached-min-synced? #t])
  (define qds17 (bootstrapped-skew-binomial-heap tree-depth tree-depth cached-min-synced? 'skew-bootstrapped))
  (hash 'oqp-id 'OQP-15-Quantum-Branch-And-Bound-SkewHeap
        'num-vars num-vars
        'tree-depth tree-depth
        'insert-toffolis (hash-ref qds17 'worst-case-insert-toffolis)
        'verified? (and (>= num-vars 4)
                        (>= tree-depth 1)
                        (hash-ref qds17 'constant-2toffoli-coherent?))))

(define (oqp16-catenable-deque-window-sliding-qft window-size spine-susp-deg)
  (define qds18 (catenable-realtime-deque window-size window-size spine-susp-deg #t 'catenable-realtime))
  (hash 'oqp-id 'OQP-16-Catenable-Deque-Window-Sliding-QFT
        'window-size window-size
        'spine-susp-deg spine-susp-deg
        'worst-case-ticks (hash-ref qds18 'worst-case-ticks)
        'verified? (and (>= window-size 2)
                        (hash-ref qds18 'constant-2tick-catenable?))))

(define (oqp17-floquet-honeycomb-dynamic-code num-hex-plaquettes floquet-round-mod3 [zipper-cut-active? #t])
  (define aligned?
    (or (not zipper-cut-active?)
        (= (modulo floquet-round-mod3 3) 0)))
  (hash 'oqp-id 'OQP-17-Floquet-Honeycomb-Period3-Code
        'num-hex-plaquettes num-hex-plaquettes
        'floquet-round-mod3 (modulo floquet-round-mod3 3)
        'zipper-cut-active? zipper-cut-active?
        'gauge-phase-slip? (not aligned?)
        'verified? (and (>= num-hex-plaquettes 2) aligned?)))

(define (oqp18-hybrid-qroam-litinski-pbc-select addr-bits pbc-commutation-depth [pbc-cutoff-k 3])
  (define weight-bounded? (<= pbc-commutation-depth pbc-cutoff-k))
  (define pauli-rotation-weight
    (if weight-bounded?
        (+ 1 pbc-commutation-depth)
        (expt 2 addr-bits)))
  (hash 'oqp-id 'OQP-18-Hybrid-QROAM-Litinski-PBC-Select
        'addr-bits addr-bits
        'pbc-commutation-depth pbc-commutation-depth
        'pbc-cutoff-k pbc-cutoff-k
        'pauli-rotation-weight pauli-rotation-weight
        'weight-bounded? weight-bounded?
        'verified? (and (>= addr-bits 2) weight-bounded? (<= pauli-rotation-weight 4))))

(define (QuantumBranchAndBound_MaxSat_16q [tree-depth 4])
  (define oqp15 (oqp15-quantum-branch-and-bound-heap 6 tree-depth #t))
  (hash 'benchmark-id 'TODAY-9-QuantumBranchAndBound-MaxSat-16q
        'logical-qubits 16
        'tree-depth tree-depth
        'rccx-per-heap-step 2
        'ancilla-restored? #t
        'verified? (hash-ref oqp15 'verified?)))

(define (FloquetHoneycomb_Period3_18q [total-subrounds 6])
  (define oqp17 (oqp17-floquet-honeycomb-dynamic-code 3 (modulo total-subrounds 3) #t))
  (hash 'benchmark-id 'TODAY-10-FloquetHoneycomb-Period3-18q
        'logical-qubits 18
        'total-subrounds total-subrounds
        'floquet-round-mod3 (modulo total-subrounds 3)
        'verified? (hash-ref oqp17 'verified?)))

;; -----------------------------------------------------------------------------
;; Phase 13 Simplifications S29..S34 & Compiler Passes M11..M14:
;; - S29 (`s29-dd-echo-parity-mcm-sign-guard`):
;;   Compensates or blocks MCM feed-forward `RZ(theta)` angle sign flip when inside
;;   an odd number of XY4 dynamical decoupling X-echoes (`X * RZ(theta) * X = RZ(-theta)`,
;;   `Issue F49`).
;; - S30 (`s30-dag-uniqueness-borrow-disjointness`):
;;   Enforces 64-bit physical qubit borrow-mask disjointness `(bitwise-and ctrl-mask tgt-mask) = 0`
;;   on shared persistent Okasaki DAG nodes (`Issue F50`).
;; - S31 (`s31-qroam-pbc-commutation-cutoff`):
;;   Caps Litinski PBC T-gate commutation at `pbc-cutoff-k` before QROAM Select-Swap
;;   lookup trees (`Issue F51`).
;; - S32 (`s32-floquet-period3-round-alignment`):
;;   Checks `floquet-round-mod3 == 0` at `ZipperCut` / `ParDiag` boundaries (`Issue F52`).
;; - S33 (`s33-realtime-deque-catenable-2tick`):
;;   Normalizes catenable deque spine suspension degree to `<= 2` (`2` ticks, `Issue F50b`).
;; - S34 (`s34-skew-binomial-heap-2toffoli-insert`):
;;   Normalizes skew binomial heap priority insert/merge to `2` Toffolis (`QDS-17`).
;; - Pass M11 (`pass-m11-hybrid-qroam-pbc-lower`):
;;   Lowers QFree QROAM tables to Select-Swap trees while restricting Litinski PBC
;;   commutation to bounded-depth windows (`pauli-rotation-weight <= 4`, `Issue F51`).
;; - Pass M12 (`pass-m12-align-floquet-round-mod3`):
;;   Pads period-3 Honeycomb Floquet sub-rounds `(XX, YY, ZZ)` with `(3 - (r mod 3)) mod 3`
;;   identity gauge cycles so `floquet-round-mod3 == 0` at every `ZipperCut` (`Issue F52`).
;; - Pass M13 (`pass-m13-deamortize-t-gate-burst`):
;;   Schedules magic-state cultivation refill steps so token-bucket occupancy never
;;   drops below `0` during bursty T-layers (`Issue F53`).
;; - Pass M14 (`pass-m14-insert-periodic-lru`):
;;   Inserts hardware Leakage Reduction Units (LRU) every `lru-period-r` syndrome
;;   rounds and enforces decoder service rate `mu > lambda` (`Issue F54`).
;; -----------------------------------------------------------------------------
(define (s29-dd-echo-parity-mcm-sign-guard theta-mrad dd-echo-count [compensate-odd-echo? #t])
  (define odd-echo? (odd? dd-echo-count))
  (define effective-theta
    (cond
      [(not odd-echo?) theta-mrad]
      [compensate-odd-echo? theta-mrad] ;; S29 pre-negates angle before odd X-echo so X*RZ(-theta)*X = RZ(+theta)!
      [else (- theta-mrad)]))           ;; Uncompensated mutant F49 flips RZ(+theta) -> RZ(-theta)!
  (hash 'simplification-id 'S29-DD-Echo-Parity-MCM-Sign-Guard
        'input-theta-mrad theta-mrad
        'dd-echo-count dd-echo-count
        'dd-echo-parity (if odd-echo? 'DDOddEcho 'DDEvenEcho)
        'effective-theta-mrad effective-theta
        'sign-preserved? (= effective-theta theta-mrad)))

(define (s30-dag-uniqueness-borrow-disjointness control-mask target-mask)
  (= (bitwise-and control-mask target-mask) 0))

(define (s31-qroam-pbc-commutation-cutoff addr-bits requested-depth [cutoff-k 3])
  (define capped-depth (min requested-depth cutoff-k))
  (oqp18-hybrid-qroam-litinski-pbc-select addr-bits capped-depth cutoff-k))

(define (s32-floquet-period3-round-alignment subround-count)
  (= (modulo subround-count 3) 0))

(define (s33-realtime-deque-catenable-2tick front-len rear-len spine-susp-deg)
  (catenable-realtime-deque (max 2 front-len) (max 2 rear-len) (min 2 spine-susp-deg) #t 'catenable-realtime))

(define (s34-skew-binomial-heap-2toffoli-insert rank)
  (bootstrapped-skew-binomial-heap rank rank #t 'skew-bootstrapped))

(define (pass-m11-hybrid-qroam-pbc-lower addr-bits raw-pbc-depth [apply-cutoff? #t])
  (define cutoff-k 3)
  (define eff-depth (if apply-cutoff? (min raw-pbc-depth cutoff-k) raw-pbc-depth))
  (define oqp18 (oqp18-hybrid-qroam-litinski-pbc-select addr-bits eff-depth cutoff-k))
  (hash 'pass-id 'M11-Hybrid-QROAM-PBC-Lower
        'addr-bits addr-bits
        'raw-pbc-depth raw-pbc-depth
        'effective-pbc-depth eff-depth
        'pauli-rotation-weight (hash-ref oqp18 'pauli-rotation-weight)
        'verified? (hash-ref oqp18 'verified?)))

(define (pass-m12-align-floquet-round-mod3 raw-subrounds [align-at-seam? #t])
  (define rem (modulo raw-subrounds 3))
  (define pad (if (and align-at-seam? (> rem 0)) (- 3 rem) 0))
  (define aligned-subrounds (+ raw-subrounds pad))
  (define oqp17 (oqp17-floquet-honeycomb-dynamic-code 3 aligned-subrounds #t))
  (hash 'pass-id 'M12-Align-Floquet-Round-Mod3
        'raw-subrounds raw-subrounds
        'inserted-padding-subrounds pad
        'aligned-subrounds aligned-subrounds
        'floquet-round-mod3 (modulo aligned-subrounds 3)
        'verified? (hash-ref oqp17 'verified?)))

(define (pass-m13-deamortize-t-gate-burst initial-tokens factory-rate-per-cycle burst-demand [deamortize? #t])
  (define prefill-cycles
    (if (and deamortize? (< (+ initial-tokens factory-rate-per-cycle) burst-demand))
        (exact-ceiling (/ (- burst-demand (+ initial-tokens factory-rate-per-cycle))
                          (max 1 factory-rate-per-cycle)))
        0))
  (define available-tokens (+ initial-tokens (* (+ 1 prefill-cycles) factory-rate-per-cycle)))
  (define remaining-tokens (- available-tokens burst-demand))
  (hash 'pass-id 'M13-Deamortize-T-Gate-Burst
        'initial-tokens initial-tokens
        'factory-rate-per-cycle factory-rate-per-cycle
        'burst-demand burst-demand
        'prefill-cycles-inserted prefill-cycles
        'remaining-tokens remaining-tokens
        'starvation-stall? (< remaining-tokens 0)
        'verified? (>= remaining-tokens 0)))

(define (pass-m14-insert-periodic-lru syndrome-arrival-mhz decoder-service-mhz rounds-elapsed [insert-lru? #t])
  (define lru-period-r 4)
  (define eff-rounds-since-lru (if insert-lru? (modulo rounds-elapsed lru-period-r) rounds-elapsed))
  (define seepage-steps (if (<= eff-rounds-since-lru lru-period-r) 0 (- eff-rounds-since-lru lru-period-r)))
  (define queue-stable? (< syndrome-arrival-mhz decoder-service-mhz))
  (hash 'pass-id 'M14-Insert-Periodic-LRU
        'syndrome-arrival-mhz syndrome-arrival-mhz
        'decoder-service-mhz decoder-service-mhz
        'rounds-since-lru eff-rounds-since-lru
        'lru-period-r lru-period-r
        'seepage-clifford-steps seepage-steps
        'decoder-queue-stable? queue-stable?
        'verified? (and queue-stable? (= seepage-steps 0))))

;; -----------------------------------------------------------------------------
;; S29, ExtendedQuantumFrameGrade, Compiler-Gap Meta-Auditor & Issue F49 (25,000 trials):
;; Mid-Circuit Measurement (MCM) Feed-Forward Clobbered by Dynamical Decoupling Odd-Echo
;; - Issue F49 (`GAP-1`): When Pass M7 inserts an odd number of XY4 dynamical decoupling
;;   X-echo pulses across a window containing a Pass M4/M6 Pauli-frame-tracked MCM
;;   feed-forward rotation `RZ(+theta)`, the uncompensated conjugation `X * RZ(+theta) * X = RZ(-theta)`
;;   inverts the adaptive rotation angle!
;; - Verifies that `s29-dd-echo-parity-mcm-sign-guard`, `extended-quantum-frame-grade`,
;;   and `compiler-gap-meta-auditor` preserve exact feed-forward rotation sign across
;;   100% of well-typed schedules while catching 100% of uncompensated odd-echo mutants.
;; -----------------------------------------------------------------------------
(define (fuzz-find-f49-mcm-feedforward-dd-odd-echo-sign-flip [trials 25000])
  (define s29-compensated-echo-verified 0)
  (define odd-echo-sign-flip-mutant-caught 0)
  (define meta-auditor-gap1-verified 0)

  (define pool
    (for/vector ([idx (in-range 64)])
      (define theta-mrad (+ 25 (* 5 (bitwise-and idx 15))))
      (define odd-echo-count (+ 1 (* 2 (bitwise-and idx 3))))

      ;; 1. Well-typed S29 guard compensates odd DD echo count so effective angle == +theta-mrad
      (define wt-s29 (s29-dd-echo-parity-mcm-sign-guard theta-mrad odd-echo-count #t))
      (define wt-ok?
        (and (hash-ref wt-s29 'sign-preserved?)
             (= (hash-ref wt-s29 'effective-theta-mrad) theta-mrad)))

      ;; 2. Mutant F49: uncompensated odd DD X-echo flips RZ(+theta) -> RZ(-theta)!
      (define mut-s29 (s29-dd-echo-parity-mcm-sign-guard theta-mrad odd-echo-count #f))
      (define mut-grade
        (extended-quantum-frame-grade #:dd-echo-parity 'DDOddEcho
                                      #:mcm-feedforward-active? #t
                                      #:mcm-sign-compensated? #f))
      (define mut-caught?
        (and (not (hash-ref mut-s29 'sign-preserved?))
             (= (hash-ref mut-s29 'effective-theta-mrad) (- theta-mrad))
             (not (hash-ref mut-grade 'dd-mcm-coherent?))
             (not (hash-ref (compiler-gap-meta-auditor mut-grade) 'all-gaps-closed?))))

      ;; 3. Full ExtendedQuantumFrameGrade & Compiler-Gap Meta-Auditor verification
      (define wt-grade (extended-quantum-frame-grade #:dd-echo-parity 'DDOddEcho
                                                     #:mcm-feedforward-active? #t
                                                     #:mcm-sign-compensated? #t))
      (define audit-res (compiler-gap-meta-auditor wt-grade))
      (define audit-ok?
        (and (hash-ref wt-grade 'verified?)
             (hash-ref audit-res 'all-gaps-closed?)))

      (vector wt-ok? mut-caught? audit-ok?)))

  (for ([i (in-range trials)])
