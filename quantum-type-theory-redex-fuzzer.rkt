;; S57, OQP-33, Pass M30 & Issue F77 (25,000 trials):
;; Qwerty / ASDF (CGO '25) Basis Translation `b_in >> b_out` Span or Orthogonality
;; Mismatch (`Pass M30`)
;; -----------------------------------------------------------------------------
(define (fuzz-find-f77-qwerty-basis-translation-span-or-orthogonality-mismatch-pass-m30 [trials 25000])
  (define m30-qwerty-basis-verified 0)
  (define span-or-ortho-mismatch-mutant-caught 0)
  (define coreqds-basis-typecheck-verified 0)

  (for ([i (in-range trials)])
    (define h (bitwise-and (+ (* i 2654435761) 316227766) #x7fffffff))
    (define dim (+ 2 (bitwise-and h 255)))
    (define delta (+ 1 (bitwise-and (arithmetic-shift h -8) 15)))

    ;; 1. Well-typed Pass M30 and CoreQDS basis-translate with orthonormal span-equal bases!
    (define m30-wt (pass-m30-qwerty-basis-translation-synthesizer #f #f #f dim (+ dim delta) #t))
    (define s57-wt (s57-qwerty-orthonormal-basis-span-preservation-guard #t #t #t dim dim #t))
    (define valid-ast (basis-translate #t #t #t dim dim))
    (when (and (hash-ref m30-wt 'verified?)
               (not (hash-ref m30-wt 'span-or-orthogonality-mismatch?))
               (hash-ref s57-wt 'verified?)
               (coreqds-well-typed? valid-ast 'coprocessor-mid-loop 'Heron-R2-156q 'cudaq-tensor-core-opnic))
      (set! m30-qwerty-basis-verified (add1 m30-qwerty-basis-verified)))

    ;; 2. Mutant F77: non-orthogonal input/output basis, unequal spans, or mismatched dimensions!
    (define m30-mut (pass-m30-qwerty-basis-translation-synthesizer #f #t #f dim (+ dim delta) #f))
    (define mut-nonortho-in  (basis-translate #f #t #t dim dim))
    (define mut-nonortho-out (basis-translate #t #f #t dim dim))
    (define mut-span-mismatch (basis-translate #t #t #f dim dim))
    (define mut-dim-mismatch  (basis-translate #t #t #t dim (+ dim delta)))
    (when (and (hash-ref m30-mut 'span-or-orthogonality-mismatch?)
               (not (hash-ref m30-mut 'verified?))
               (not (coreqds-well-typed? mut-nonortho-in 'coprocessor-mid-loop 'Heron-R2-156q 'cudaq-tensor-core-opnic))
               (not (coreqds-well-typed? mut-nonortho-out 'coprocessor-mid-loop 'Heron-R2-156q 'cudaq-tensor-core-opnic))
               (not (coreqds-well-typed? mut-span-mismatch 'coprocessor-mid-loop 'Heron-R2-156q 'cudaq-tensor-core-opnic))
               (not (coreqds-well-typed? mut-dim-mismatch 'coprocessor-mid-loop 'Heron-R2-156q 'cudaq-tensor-core-opnic)))
      (set! span-or-ortho-mismatch-mutant-caught (add1 span-or-ortho-mismatch-mutant-caught)))

    ;; 3. Compositional embedding of basis-translate inside walk-zipper
    (define walk-basis-ast (walk-zipper 'QwertyCoin valid-ast))
    (when (coreqds-well-typed? walk-basis-ast 'coprocessor-mid-loop 'Heron-R2-156q 'cudaq-tensor-core-opnic)
      (set! coreqds-basis-typecheck-verified (add1 coreqds-basis-typecheck-verified))))

  (hash 'issue-id 'F77-qwerty-basis-translation-span-or-orthogonality-mismatch-pass-m30
        'suite-id 'S57-PassM30-OQP33-Qwerty-Basis-Translation-Synthesizer
        'trials trials
        'm30-qwerty-basis-verified m30-qwerty-basis-verified
        'span-or-ortho-mismatch-mutant-caught span-or-ortho-mismatch-mutant-caught
        'coreqds-basis-typecheck-verified coreqds-basis-typecheck-verified
        'verified? (and (= m30-qwerty-basis-verified trials)
                        (= span-or-ortho-mismatch-mutant-caught trials)
                        (= coreqds-basis-typecheck-verified trials))))

