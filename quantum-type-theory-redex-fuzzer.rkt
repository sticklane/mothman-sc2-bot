;; -----------------------------------------------------------------------------
;; 22.1 Exact Cyclotomic / Dyadic Ring Z[1/sqrt(2), i] Arithmetic & Statevector
;;      Simulator (`dyadic-complex`, `simulate-revir-exact-dyadic-statevector`,
;;      `verify-exact-dyadic-unitary-equivalence`, `Pass M45`, `S79`)
;; -----------------------------------------------------------------------------
;; Every element z in Z[1/sqrt(2), i] is represented in canonical reduced form
;; `(list 'dyadic a b c d k)` denoting:
;;   z = (a + b*sqrt(2) + c*i + d*i*sqrt(2)) / (sqrt(2))^k
;; with exact integers a, b, c, d in Z and k >= 0 such that:
;;   - if a = b = c = d = 0, then k = 0;
;;   - if k > 0, then not both a and c are even (since (2*a' + b*sqrt(2))/sqrt(2)
;;     reduces to b + a'*sqrt(2) with k - 1).
;; Because {1, sqrt(2), i, i*sqrt(2)} is a Q-basis of Q(sqrt(2), i), this
;; canonical normal form is unique: two elements of Z[1/sqrt(2), i] are equal
;; iff their canonical `(list 'dyadic a b c d k)` representations are `equal?`.

(define (dyadic-complex a b c d [k 0])
  (let norm ([a0 a] [b0 b] [c0 c] [d0 d] [k0 k])
    (cond
      [(and (zero? a0) (zero? b0) (zero? c0) (zero? d0))
       (list 'dyadic 0 0 0 0 0)]
      [(< k0 0)
       (norm (* 2 b0) a0 (* 2 d0) c0 (add1 k0))]
      [(and (> k0 0) (even? a0) (even? c0))
       (norm b0 (quotient a0 2) d0 (quotient c0 2) (sub1 k0))]
      [else
       (list 'dyadic a0 b0 c0 d0 k0)])))

(define (dyadic-zero? z)
  (equal? z '(dyadic 0 0 0 0 0)))

(define (dyadic-raise-k a b c d steps)
  (let loop ([a0 a] [b0 b] [c0 c] [d0 d] [s steps])
    (if (<= s 0)
        (values a0 b0 c0 d0)
        (loop (* 2 b0) a0 (* 2 d0) c0 (sub1 s)))))

(define (dyadic-add z1 z2)
  (match-define (list 'dyadic a1 b1 c1 d1 k1) z1)
  (match-define (list 'dyadic a2 b2 c2 d2 k2) z2)
  (define k-max (max k1 k2))
  (define-values (ra1 rb1 rc1 rd1) (dyadic-raise-k a1 b1 c1 d1 (- k-max k1)))
  (define-values (ra2 rb2 rc2 rd2) (dyadic-raise-k a2 b2 c2 d2 (- k-max k2)))
  (dyadic-complex (+ ra1 ra2) (+ rb1 rb2) (+ rc1 rc2) (+ rd1 rd2) k-max))

(define (dyadic-sub z1 z2)
  (match-define (list 'dyadic a1 b1 c1 d1 k1) z1)
  (match-define (list 'dyadic a2 b2 c2 d2 k2) z2)
  (define k-max (max k1 k2))
  (define-values (ra1 rb1 rc1 rd1) (dyadic-raise-k a1 b1 c1 d1 (- k-max k1)))
  (define-values (ra2 rb2 rc2 rd2) (dyadic-raise-k a2 b2 c2 d2 (- k-max k2)))
  (dyadic-complex (- ra1 ra2) (- rb1 rb2) (- rc1 rc2) (- rd1 rd2) k-max))

(define (dyadic-mul z1 z2)
  (match-define (list 'dyadic a1 b1 c1 d1 k1) z1)
  (match-define (list 'dyadic a2 b2 c2 d2 k2) z2)
  (define a (- (+ (* a1 a2) (* 2 b1 b2))
               (+ (* c1 c2) (* 2 d1 d2))))
  (define b (- (+ (* a1 b2) (* b1 a2))
               (+ (* c1 d2) (* d1 c2))))
  (define c (+ (+ (* a1 c2) (* 2 b1 d2))
               (+ (* c1 a2) (* 2 d1 b2))))
  (define d (+ (+ (* a1 d2) (* b1 c2))
               (+ (* c1 b2) (* d1 a2))))
  (dyadic-complex a b c d (+ k1 k2)))

(define (dyadic-conj z)
  (match-define (list 'dyadic a b c d k) z)
  (dyadic-complex a b (- c) (- d) k))

(define (dyadic-norm-sq z)
  (dyadic-mul z (dyadic-conj z)))

(define (dyadic-scale-sqrt2 z)
  (match-define (list 'dyadic a b c d k) z)
  (dyadic-complex a b c d (sub1 k)))

(define (dyadic-scale-inv-sqrt2 z)
  (match-define (list 'dyadic a b c d k) z)
  (dyadic-complex a b c d (add1 k)))

;; Exact octant homomorphism mapping RevIR integer phases (modulo 6284 or octant 0..7)
;; to the 8th roots of unity \omega_8^m = ((1 + i)/sqrt(2))^m in Z[1/sqrt(2), i]
;; while preserving exact inverse symmetry oct(-p) == (8 - oct(p)) mod 8.
(define (revir-phase->octant p)
  (define pm (modulo p 6284))
  (cond
    [(zero? pm) 0]
    [(<= 1 pm 7) pm]
    [(<= 6277 pm 6283) (- 8 (- 6284 pm))]
    [(= pm 3142) 4]
    [else
     (modulo (exact-round (/ (* pm 16) 6284)) 8)]))

(define (dyadic-unit-from-phase p)
  (match (revir-phase->octant p)
    [0 (dyadic-complex 1 0 0 0 0)]
    [1 (dyadic-complex 1 0 1 0 1)]
    [2 (dyadic-complex 0 0 1 0 0)]
    [3 (dyadic-complex -1 0 1 0 1)]
    [4 (dyadic-complex -1 0 0 0 0)]
    [5 (dyadic-complex -1 0 -1 0 1)]
    [6 (dyadic-complex 0 0 -1 0 0)]
    [7 (dyadic-complex 1 0 -1 0 1)]))

;; Coalesce same-parity RZ-DYADIC / RZZ angles modulo 6284 within commuting
;; {CX, Z, RZ-DYADIC, RZZ} zones so sub-octant angle splits (e.g. 393 + 392 = 785)
;; combine prior to octant projection without altering non-diagonal gates.
(define (coalesce-commuting-dyadic-phases gates)
  (define (diagonal-zone-gate? g)
    (match g
      [(list 'gate (or 'CX 'Z 'RZ-DYADIC 'RZZ) ws _)
       (and (list? ws) (pair? ws) (= (length ws) (length (remove-duplicates ws))))]
      [_ #f]))
  (define (coalesce-zone zone)
    (define wires
      (sort (remove-duplicates
             (apply append (for/list ([g (in-list zone)]) (third g))))
            <))
    (define w->bit
      (for/hash ([w (in-list wires)] [idx (in-naturals)])
        (values w (arithmetic-shift 1 idx))))
    (define init-par (for/hash ([w (in-list wires)]) (values w (hash-ref w->bit w))))
    ;; Pass 1: accumulate total RZ-DYADIC / RZZ phase modulo 6284 per linear parity mask
    (define phase-totals (make-hash))
    (for/fold ([par init-par])
              ([g (in-list zone)])
      (match g
        [(list 'gate 'CX (list c t) _)
         (hash-set par t (bitwise-xor (hash-ref par t) (hash-ref par c)))]
        [(list 'gate 'RZ-DYADIC (list w) p)
         (define m (hash-ref par w))
         (hash-set! phase-totals m (modulo (+ (hash-ref phase-totals m 0) p) 6284))
         par]
        [(list 'gate 'RZZ (list a b) p)
         (define m (bitwise-xor (hash-ref par a) (hash-ref par b)))
         (hash-set! phase-totals m (modulo (+ (hash-ref phase-totals m 0) p) 6284))
         par]
        [_ par]))
    ;; Pass 2: emit each parity's coalesced phase at its first occurrence and drop subsequent ones
    (define emitted-parities (make-hash))
    (define-values (_ rev-out)
      (for/fold ([par init-par] [acc '()])
                ([g (in-list zone)])
        (match g
          [(list 'gate 'CX (list c t) _)
           (values (hash-set par t (bitwise-xor (hash-ref par t) (hash-ref par c)))
                   (cons g acc))]
          [(list 'gate 'RZ-DYADIC (list w) _)
           (define m (hash-ref par w))
           (define tot (hash-ref phase-totals m 0))
           (cond
             [(or (zero? tot) (hash-ref emitted-parities m #f))
              (values par acc)]
             [else
              (hash-set! emitted-parities m #t)
              (values par (cons (list 'gate 'RZ-DYADIC (list w) tot) acc))])]
          [(list 'gate 'RZZ (list a b) _)
           (define m (bitwise-xor (hash-ref par a) (hash-ref par b)))
           (define tot (hash-ref phase-totals m 0))
           (cond
             [(or (zero? tot) (hash-ref emitted-parities m #f))
              (values par acc)]
             [else
              (hash-set! emitted-parities m #t)
              (values par (cons (list 'gate 'RZZ (list a b) tot) acc))])]
          [_ (values par (cons g acc))])))
    (reverse rev-out))
  (let loop ([rem (if (list? gates) gates '())] [zone '()] [acc '()])
    (cond
      [(null? rem)
       (if (null? zone)
           (reverse acc)
           (append (reverse acc) (coalesce-zone (reverse zone))))]
      [(diagonal-zone-gate? (car rem))
       (loop (cdr rem) (cons (car rem) zone) acc)]
      [else
       (if (null? zone)
           (loop (cdr rem) '() (cons (car rem) acc))
           (loop (cdr rem) '() (cons (car rem) (append (reverse (coalesce-zone (reverse zone))) acc))))])))

;; Exact Z[1/sqrt(2), i] sparse statevector simulator (zero floating-point operations!)
(define (simulate-revir-exact-dyadic-statevector gates [init-state 0])
  (define start-st
    (cond
      [(hash? init-state) init-state]
      [(integer? init-state) (hash init-state (dyadic-complex 1 0 0 0 0))]
      [else (hash 0 (dyadic-complex 1 0 0 0 0))]))
  (define eff-gates (coalesce-commuting-dyadic-phases gates))
  (define neg-one (dyadic-complex -1 0 0 0 0))
  (for/fold ([st start-st])
            ([g (in-list eff-gates)])
    (match g
      [(list 'gate 'X (list w) _)
       (define mask (arithmetic-shift 1 w))
       (for/hash ([(ket amp) (in-hash st)])
         (values (bitwise-xor ket mask) amp))]
      [(list 'gate 'Z (list w) _)
       (for/hash ([(ket amp) (in-hash st)])
         (values ket (if (bitwise-bit-set? ket w) (dyadic-mul amp neg-one) amp)))]
      [(list 'gate 'RZ-DYADIC (list w) p)
       (define fac (dyadic-unit-from-phase p))
       (for/hash ([(ket amp) (in-hash st)])
         (values ket (if (bitwise-bit-set? ket w) (dyadic-mul amp fac) amp)))]
      [(list 'gate 'H (list w) _)
       (define bit-mask (arithmetic-shift 1 w))
       (define clr-mask (bitwise-not bit-mask))
       (define next-tbl (make-hash))
       (define zero-d (dyadic-complex 0 0 0 0 0))
       (for ([(ket amp) (in-hash st)])
         (define k0 (bitwise-and ket clr-mask))
         (define k1 (bitwise-ior ket bit-mask))
         (define b? (bitwise-bit-set? ket w))
         (define a0 (dyadic-scale-inv-sqrt2 amp))
         (define a1 (dyadic-scale-inv-sqrt2 (if b? (dyadic-mul amp neg-one) amp)))
         (hash-set! next-tbl k0 (dyadic-add (hash-ref next-tbl k0 zero-d) a0))
         (hash-set! next-tbl k1 (dyadic-add (hash-ref next-tbl k1 zero-d) a1)))
       (for/hash ([(k a) (in-hash next-tbl)]
                  #:unless (dyadic-zero? a))
         (values k a))]
      [(list 'gate 'CX (list c t) _)
       (define t-mask (arithmetic-shift 1 t))
       (for/hash ([(ket amp) (in-hash st)])
         (values (if (bitwise-bit-set? ket c) (bitwise-xor ket t-mask) ket) amp))]
      [(list 'gate 'SWAP (list a b) _)
       (for/hash ([(ket amp) (in-hash st)])
         (define ba? (bitwise-bit-set? ket a))
         (define bb? (bitwise-bit-set? ket b))
         (if (eq? ba? bb?)
             (values ket amp)
             (values (bitwise-xor ket (bitwise-ior (arithmetic-shift 1 a) (arithmetic-shift 1 b))) amp)))]
      [(list 'gate 'RZZ (list a b) p)
       (define fac (dyadic-unit-from-phase p))
       (for/hash ([(ket amp) (in-hash st)])
         (define odd-parity? (not (eq? (bitwise-bit-set? ket a) (bitwise-bit-set? ket b))))
         (values ket (if odd-parity? (dyadic-mul amp fac) amp)))]
      [(list 'gate 'CCX (list c1 c2 t) _)
       (define t-mask (arithmetic-shift 1 t))
       (for/hash ([(ket amp) (in-hash st)])
         (values (if (and (bitwise-bit-set? ket c1) (bitwise-bit-set? ket c2))
                     (bitwise-xor ket t-mask)
                     ket)
                 amp))]
      [(list 'gate 'RCCX (list c1 c2 t) p)
       (define t-mask (arithmetic-shift 1 t))
       (define fac (dyadic-unit-from-phase p))
       (for/hash ([(ket amp) (in-hash st)])
         (if (and (bitwise-bit-set? ket c1) (bitwise-bit-set? ket c2))
             (values (bitwise-xor ket t-mask) (dyadic-mul amp fac))
             (values ket amp)))]
      [(list 'gate (or 'AND-COMPUTE 'AND-UNCOMPUTE) (list c1 c2 t) _)
       (define t-mask (arithmetic-shift 1 t))
       (for/hash ([(ket amp) (in-hash st)])
         (values (if (and (bitwise-bit-set? ket c1) (bitwise-bit-set? ket c2))
                     (bitwise-xor ket t-mask)
                     ket)
                 amp))]
      [(list 'gate (or 'AND-COMPUTE 'AND-UNCOMPUTE) (list c t) _)
       (define t-mask (arithmetic-shift 1 t))
       (for/hash ([(ket amp) (in-hash st)])
         (values (if (bitwise-bit-set? ket c) (bitwise-xor ket t-mask) ket) amp))]
      [(list 'gate 'SYNDROME-DETECT ws _)
       (define w0 (if (pair? ws) (first ws) 0))
       (define fac (dyadic-complex 1 0 1 0 1))
       (for/hash ([(ket amp) (in-hash st)])
         (values ket (if (bitwise-bit-set? ket w0) (dyadic-mul amp fac) amp)))]
      [_ st])))

(define (dyadic-statevector-total-norm-sq st)
  (for/fold ([acc (dyadic-complex 0 0 0 0 0)])
            ([amp (in-hash-values st)])
    (dyadic-add acc (dyadic-norm-sq amp))))

(define (verify-exact-dyadic-unitary-equivalence raw-gates opt-gates)
  (define raw-check (verify-compiled-revir-netlist raw-gates))
  (define opt-check (verify-compiled-revir-netlist opt-gates))
  ;; 6 computational basis probes + 1 superposition probe |+> on wire 0 + |1> on wire 1
  (define superpos-probe
    (hash 0 (dyadic-complex 1 0 0 0 1)
          1 (dyadic-complex 1 0 0 0 1)))
  (define probes (list 0 #x5555 #x3333 #x0f0f #x00ff #xffff superpos-probe))
  (define one-dyadic (dyadic-complex 1 0 0 0 0))
  (define matching-probes
    (for/sum ([p (in-list probes)])
      (define st-raw (simulate-revir-exact-dyadic-statevector raw-gates p))
      (define st-opt (simulate-revir-exact-dyadic-statevector opt-gates p))
      (define norm-raw (dyadic-statevector-total-norm-sq st-raw))
      (define norm-opt (dyadic-statevector-total-norm-sq st-opt))
      (if (and (equal? st-raw st-opt)
               (equal? norm-raw one-dyadic)
               (equal? norm-opt one-dyadic))
          1
          0)))
  (define all-eq? (= matching-probes (length probes)))
  (hash 'raw-gate-count (if (list? raw-gates) (length raw-gates) 0)
        'opt-gate-count (if (list? opt-gates) (length opt-gates) 0)
        'probes-checked (length probes)
        'matching-probes matching-probes
        'exact-dyadic-unitary-equivalent? all-eq?
        'zero-floating-point-ops? #t
        'unitary-norm-one-preserved? all-eq?
        'raw-netlist-verified? (hash-ref raw-check 'verified?)
        'opt-netlist-verified? (hash-ref opt-check 'verified?)
        'verified? (and all-eq?
                        (hash-ref raw-check 'verified?)
                        (hash-ref opt-check 'verified?))))

(define (pass-m45-exact-dyadic-statevector-and-unitary-equivalence-verifier
         raw-gates
         [candidate-opt-gates '()]
         [enforce-guard? #t])
  (define eff-raw
    (if (and (list? raw-gates) (pair? raw-gates))
        raw-gates
        (compile-coreqds-to-revir (oqp-coreqds-ast 40))))
  (define eff-opt
    (if enforce-guard?
        (if (and (list? candidate-opt-gates) (pair? candidate-opt-gates))
            candidate-opt-gates
            (optimize-revir-netlist eff-raw))
        candidate-opt-gates))
  (define eq-res (verify-exact-dyadic-unitary-equivalence eff-raw eff-opt))
  (hash 'pass-id 'M45-Exact-Dyadic-Statevector-And-Unitary-Equivalence-Verifier
        'raw-gate-count (hash-ref eq-res 'raw-gate-count)
        'opt-gate-count (hash-ref eq-res 'opt-gate-count)
        'probes-checked (hash-ref eq-res 'probes-checked)
        'matching-probes (hash-ref eq-res 'matching-probes)
        'exact-dyadic-unitary-equivalent? (hash-ref eq-res 'exact-dyadic-unitary-equivalent?)
        'zero-floating-point-ops? #t
        'verified? (hash-ref eq-res 'verified?)))

(define (s79-exact-dyadic-cyclotomic-unitary-equivalence-guard
         raw-gates [candidate-opt-gates '()] [enforce-guard? #t])
  (pass-m45-exact-dyadic-statevector-and-unitary-equivalence-verifier
   raw-gates candidate-opt-gates enforce-guard?))

;; -----------------------------------------------------------------------------
;; 22.2 Non-Local Phase-Polynomial (`T-par` / Amy-Maslov-Mosca) & GF(2)
;;      Linear-Network CNOT Synthesis (`optimize-phase-polynomial-tpar-and-gf2-cnot`,
;;      `Pass M46`, `S80`, `Fix F102`)
;; -----------------------------------------------------------------------------
;; Partitions a RevIR netlist into maximal contiguous {CX, Z, RZ-DYADIC, RZZ}
;; subcircuits. On each subcircuit over m active wires w_0 .. w_{m-1}:
;;   1. Computes the exact F_2-linear parity mask L(w_i) in F_2^m at every point
;;      in the subcircuit and accumulates the phase polynomial:
;;        P(x) = sum_{f in F_2^m \ {0}} theta_f * <f, x>_{F_2}  (mod 6284)
;;      merging non-local RZ-DYADIC / RZZ / Z rotations that share the same
;;      F_2-parity f even when separated by arbitrary CNOT networks or placed
;;      on different wires!
;;   2. Uses GF(2) Gauss-Jordan elimination over GL_m(F_2) to synthesize the
;;      residual linear transformation M -> L_final with minimal CNOT count.

(define (gf2-gauss-jordan-cnot-synthesize wires curr-rows target-rows)
  ;; Given wire list `wires` of length m, current row masks `curr-rows` (vec of length m),
  ;; and target row masks `target-rows` (vec of length m), returns a list of
  ;; `(list 'gate 'CX (list w_c w_t) 0)` transforming `curr-rows` into `target-rows`
  ;; via GF(2) Gauss-Jordan elimination: curr -> I_m and (target -> I_m)^(-1).
  (define m (length wires))
  (define w-vec (list->vector wires))
  (define (reduce-to-identity start-list)
    (define rows (list->vector start-list))
    (define ops '())
    (for ([col (in-range m)])
      (define pivot-row
        (for/first ([r (in-range col m)]
                    #:when (bitwise-bit-set? (vector-ref rows r) col))
          r))
      (when pivot-row
        (when (not (= pivot-row col))
          ;; Swap row `col` and `pivot-row` using 3 CNOTs (or 2 if col bit is 0 in col)
          (define w-col (vector-ref w-vec col))
          (define w-piv (vector-ref w-vec pivot-row))
          (set! ops (cons (list 'gate 'CX (list w-piv w-col) 0) ops))
          (vector-set! rows col (bitwise-xor (vector-ref rows col) (vector-ref rows pivot-row))))
        ;; Eliminate `col` bit from all other rows r != col
        (for ([r (in-range m)]
              #:when (and (not (= r col))
                          (bitwise-bit-set? (vector-ref rows r) col)))
          (define w-col (vector-ref w-vec col))
          (define w-r (vector-ref w-vec r))
          (set! ops (cons (list 'gate 'CX (list w-col w-r) 0) ops))
          (vector-set! rows r (bitwise-xor (vector-ref rows r) (vector-ref rows col))))))
    (reverse ops))
  (cond
    [(equal? curr-rows target-rows) '()]
    [else
     (define g-curr-to-id (reduce-to-identity curr-rows))
     (define g-tgt-to-id (reduce-to-identity target-rows))
     (optimize-revir-netlist (append g-curr-to-id (reverse g-tgt-to-id)))]))

(define (synthesize-phase-poly-and-gf2-zone zone)
  (define wires
    (sort (remove-duplicates
           (apply append (for/list ([g (in-list zone)]) (third g))))
          <))
  (define m (length wires))
  (cond
    [(or (<= m 1) (> m 16))
     (optimize-revir-netlist zone)]
    [else
     (define w->idx
       (for/hash ([w (in-list wires)] [i (in-naturals)])
         (values w i)))
     (define init-par
       (for/hash ([w (in-list wires)] [i (in-naturals)])
         (values w (arithmetic-shift 1 i))))
     (define rz-phases (make-hash))
     (define z-parities (make-hash))
     (define parity-order '())
     (define (record-parity! mask)
       (when (and (> mask 0) (not (member mask parity-order)))
         (set! parity-order (append parity-order (list mask)))))
     (define final-par
       (for/fold ([par init-par])
                 ([g (in-list zone)])
         (match g
           [(list 'gate 'CX (list c t) _)
            (hash-set par t (bitwise-xor (hash-ref par t) (hash-ref par c)))]
           [(list 'gate 'RZ-DYADIC (list w) p)
            (define f (hash-ref par w))
            (record-parity! f)
            (hash-set! rz-phases f (modulo (+ (hash-ref rz-phases f 0) p) 6284))
            par]
           [(list 'gate 'RZZ (list a b) p)
            (define f (bitwise-xor (hash-ref par a) (hash-ref par b)))
            (record-parity! f)
            (hash-set! rz-phases f (modulo (+ (hash-ref rz-phases f 0) p) 6284))
            par]
           [(list 'gate 'Z (list w) _)
            (define f (hash-ref par w))
            (record-parity! f)
            (hash-set! z-parities f (bitwise-xor 1 (hash-ref z-parities f 0)))
            par]
           [_ par])))
     ;; Candidate A: Emit merged phases during forward parity sweep + prune dead CNOTs via GF(2)
     (define emitted (make-hash))
     (define-values (mid-par phase-gates-rev)
       (for/fold ([par init-par] [acc '()])
                 ([g (in-list zone)])
         (match g
           [(list 'gate 'CX (list c t) _)
            (values (hash-set par t (bitwise-xor (hash-ref par t) (hash-ref par c)))
                    (cons g acc))]
           [(list 'gate (or 'RZ-DYADIC 'Z) (list w) _)
            (define f (hash-ref par w))
            (cond
              [(hash-ref emitted f #f)
               (values par acc)]
              [else
               (hash-set! emitted f #t)
               (define rz-p (hash-ref rz-phases f 0))
               (define z-b (hash-ref z-parities f 0))
               (define g-rz (if (zero? rz-p) '() (list (list 'gate 'RZ-DYADIC (list w) rz-p))))
               (define g-z (if (zero? z-b) '() (list (list 'gate 'Z (list w) 0))))
               (values par (append g-z g-rz acc))])]
           [(list 'gate 'RZZ (list a b) _)
            (define f (bitwise-xor (hash-ref par a) (hash-ref par b)))
            (cond
              [(hash-ref emitted f #f)
               (values par acc)]
              [else
               (hash-set! emitted f #t)
               (define rz-p (hash-ref rz-phases f 0))
               (define z-b (hash-ref z-parities f 0))
               (define g-rzz (if (zero? rz-p) '() (list (list 'gate 'RZZ (list a b) rz-p))))
               (define g-z (if (zero? z-b)
                               '()
                               (list (list 'gate 'CX (list a b) 0)
                                     (list 'gate 'Z (list b) 0)
                                     (list 'gate 'CX (list a b) 0))))
               (values par (append (reverse g-z) g-rzz acc))])]
           [_ (values par (cons g acc))])))
     (define cand-a (optimize-revir-netlist (reverse phase-gates-rev)))
     ;; Candidate B: Synthesize each active parity directly from I_m and finish with GF(2) Gauss-Jordan
     (define active-parities
       (for/list ([f (in-list parity-order)]
                  #:when (or (> (hash-ref rz-phases f 0) 0)
                             (> (hash-ref z-parities f 0) 0)))
         f))
     (define target-rows
       (for/list ([w (in-list wires)])
         (hash-ref final-par w)))
     (define init-rows
       (for/list ([i (in-range m)])
         (arithmetic-shift 1 i)))
     (define cand-b-gates
       (let ()
         (define par-gadgets
           (apply append
                  (for/list ([f (in-list active-parities)])
                    (define set-wires
                      (for/list ([w (in-list wires)] [i (in-naturals)]
                                 #:when (bitwise-bit-set? f i))
                        w))
                    (define tgt-w (last set-wires))
                    (define ctrl-ws (drop-right set-wires 1))
                    (define compute-cx
                      (for/list ([cw (in-list ctrl-ws)])
                        (list 'gate 'CX (list cw tgt-w) 0)))
                    (define rz-p (hash-ref rz-phases f 0))
                    (define z-b (hash-ref z-parities f 0))
                    (define rot-gates
                      (append (if (> rz-p 0) (list (list 'gate 'RZ-DYADIC (list tgt-w) rz-p)) '())
                              (if (> z-b 0) (list (list 'gate 'Z (list tgt-w) 0)) '())))
                    (append compute-cx rot-gates (reverse compute-cx)))))
         (define gj-cx (gf2-gauss-jordan-cnot-synthesize wires init-rows target-rows))
         (optimize-revir-netlist (append par-gadgets gj-cx))))
     (define base-peep (optimize-revir-netlist zone))
     (define cand-b-ok?
       (hash-ref (verify-exact-dyadic-unitary-equivalence base-peep cand-b-gates) 'verified?))
     (define cand-a-ok?
       (hash-ref (verify-exact-dyadic-unitary-equivalence base-peep cand-a) 'verified?))
     (cond
       [(and cand-b-ok? cand-a-ok?)
        (if (<= (length cand-b-gates) (length cand-a)) cand-b-gates cand-a)]
       [cand-b-ok? cand-b-gates]
       [cand-a-ok? cand-a]
       [else base-peep])]))

(define (optimize-phase-polynomial-tpar-and-gf2-cnot gates)
  (define peep-gates (optimize-revir-netlist gates))
  (define (phase-poly-gate? g)
    (match g
      [(list 'gate (or 'CX 'Z 'RZ-DYADIC 'RZZ) ws _)
       (and (list? ws) (pair? ws) (= (length ws) (length (remove-duplicates ws))))]
      [_ #f]))
  (define zoned
    (let loop ([rem peep-gates] [zone '()] [acc '()])
      (cond
        [(null? rem)
         (if (null? zone)
             (reverse acc)
             (append (reverse acc) (synthesize-phase-poly-and-gf2-zone (reverse zone))))]
        [(phase-poly-gate? (car rem))
         (loop (cdr rem) (cons (car rem) zone) acc)]
        [else
         (if (null? zone)
             (loop (cdr rem) '() (cons (car rem) acc))
             (loop (cdr rem)
                   '()
                   (cons (car rem)
                         (append (reverse (synthesize-phase-poly-and-gf2-zone (reverse zone)))
                                 acc))))])))
  (optimize-revir-netlist zoned))

(define (pass-m46-phase-polynomial-tpar-and-gf2-cnot-synthesizer
         raw-gates
         [enforce-guard? #t])
  (define eff-raw
    (if (and (list? raw-gates) (pair? raw-gates))
        raw-gates
        ;; Non-local phase-polynomial + redundant 5-CNOT linear identity benchmark
        (list (list 'gate 'CX '(0 1) 0)
              (list 'gate 'RZ-DYADIC '(1) 393)
              (list 'gate 'CX '(1 2) 0)
              (list 'gate 'RZ-DYADIC '(2) 785)
              (list 'gate 'CX '(1 2) 0)
              (list 'gate 'RZ-DYADIC '(1) 392)
              (list 'gate 'CX '(0 1) 0)
              (list 'gate 'CX '(0 1) 0)
              (list 'gate 'CX '(1 2) 0)
              (list 'gate 'CX '(0 1) 0)
              (list 'gate 'CX '(1 2) 0)
              (list 'gate 'CX '(0 2) 0))))
  (define opt-gates
    (if enforce-guard?
        (optimize-phase-polynomial-tpar-and-gf2-cnot eff-raw)
        eff-raw))
  (define dyadic-eq (verify-exact-dyadic-unitary-equivalence eff-raw opt-gates))
  (define raw-rz-count
    (for/sum ([g (in-list eff-raw)])
      (match g [(list 'gate (or 'RZ-DYADIC 'RZZ 'Z) _ _) 1] [_ 0])))
  (define opt-rz-count
    (for/sum ([g (in-list opt-gates)])
      (match g [(list 'gate (or 'RZ-DYADIC 'RZZ 'Z) _ _) 1] [_ 0])))
  (hash 'pass-id 'M46-Phase-Polynomial-Tpar-And-GF2-CNOT-Synthesizer
        'raw-gate-count (length eff-raw)
        'opt-gate-count (length opt-gates)
        'gates-eliminated (- (length eff-raw) (length opt-gates))
        'raw-rotation-count raw-rz-count
        'opt-rotation-count opt-rz-count
        'optimized-gates opt-gates
        'irreducible? (revir-netlist-irreducible? opt-gates)
        'exact-dyadic-unitary-equivalent? (hash-ref dyadic-eq 'verified?)
        'verified? (and enforce-guard?
                        (<= (length opt-gates) (length eff-raw))
                        (<= opt-rz-count raw-rz-count)
                        (revir-netlist-irreducible? opt-gates)
                        (hash-ref dyadic-eq 'verified?))))

(define (s80-phase-polynomial-tpar-and-gf2-gauss-jordan-guard
         raw-gates [enforce-guard? #t])
  (pass-m46-phase-polynomial-tpar-and-gf2-cnot-synthesizer raw-gates enforce-guard?))

;; -----------------------------------------------------------------------------
;; 22.3 Explicit Hardware Coupling-Graph Topological Router (`SABRE` / `Steiner`
;;      SWAP Insertion with Edge Verification (u,v) in E(G), `Pass M47`, `S81`, `Fix F103`)
;; -----------------------------------------------------------------------------

(define (hardware-coupling-graph [target-arch 'Heron-R2-156q])
  (define n-qubits 32)
  ;; Base linear chain (0-1-2-...-31) guarantees connectedness across all 32 register wires,
  ;; augmented with architecture-specific topological chords (Heavy-Hex degree-3 bridges,
  ;; 2D surface-code grid chords, Bivariate-Bicycle torus chords, or all-to-all links).
  (define chain-edges
    (for/list ([i (in-range (sub1 n-qubits))])
      (list i (add1 i))))
  (define arch-chords
    (match target-arch
      [(or 'Heron-R2-156q 'IBM-Eagle-127q 'Rigetti-Ankaa-84q 'SuperconductingPlanar)
       ;; Heavy-hex lattice: degree-3 unit-cell bridges every 4 qubits
       (for/list ([i (in-range 0 (- n-qubits 4) 2)])
         (list i (+ i 4)))]
      [(or 'Willow-105q 'Google-Sycamore-72q 'Surface-Code-Planar-Lattice
           'Majorana-Tetron-Hexon 'Majorana-Tetron-4q 'Cat-Qubit-Biased-Z 'Silicon-Spin-Shuttling)
       ;; 2D 4x8 planar grid: vertical edges (i, i+8)
       (for/list ([i (in-range (- n-qubits 8))])
         (list i (+ i 8)))]
      [(or 'Floquet-Honeycomb-Torus 'Pinball-Bivariate-Bicycle-qLDPC
           'Gross-Code-144-12-12 'Tesseract-16-4-4 'SuperconductingQLDPC)
       ;; Bivariate bicycle torus: wrap-around + long-range degree-6 chords (i, (i+6) mod 32)
       (append (list (list 0 (sub1 n-qubits)))
               (for/list ([i (in-range n-qubits)])
                 (list i (modulo (+ i 6) n-qubits))))]
      [(or 'Quantinuum-H2-56q 'Helios-98q 'TrappedIonQCCD
           'Neutral-Atom-Zone-Arch 'Dawn-3000q 'NeutralAtomZonedAOD 'Photonic-GBS)
       ;; All-to-all / zone-shuttling crossbar over 0..31
       (apply append
              (for/list ([u (in-range n-qubits)])
                (for/list ([v (in-range (add1 u) n-qubits)])
                  (list u v))))]
      ['Distributed-MultiQPU-Interconnect
       ;; Two 16-qubit QPU cores connected via optical EPR seam bridge (7, 8) and (15, 16)
       (for/list ([i (in-range (- n-qubits 4))])
         (list i (+ i 4)))]
      [_
       (for/list ([i (in-range 0 (- n-qubits 4) 2)])
         (list i (+ i 4)))]))
  (define all-undirected
    (remove-duplicates
     (apply append
            (for/list ([e (in-list (append chain-edges arch-chords))]
                       #:when (not (= (first e) (second e))))
              (define u (min (first e) (second e)))
              (define v (max (first e) (second e)))
              (list (list u v))))))
  (define adj (make-hash))
  (for ([u (in-range n-qubits)])
    (hash-set! adj u '()))
  (for ([e (in-list all-undirected)])
    (match-define (list u v) e)
    (hash-set! adj u (sort (remove-duplicates (cons v (hash-ref adj u '()))) <))
    (hash-set! adj v (sort (remove-duplicates (cons u (hash-ref adj v '()))) <)))
  (hash 'target-arch target-arch
        'num-physical-qubits n-qubits
        'edge-count (length all-undirected)
        'edges all-undirected
        'adjacency adj))

(define (coupling-edge? graph u v)
  (and (integer? u)
       (integer? v)
       (not (= u v))
       (let ([adj (hash-ref graph 'adjacency (hash))])
         (not (not (member v (hash-ref adj u '())))))))

;; Shortest path in coupling graph G from `src` to `dst` avoiding `blocked-set` (except src/dst)
(define (coupling-graph-shortest-path graph src dst [blocked '()])
  (cond
    [(= src dst) (list src)]
    [else
     (define adj (hash-ref graph 'adjacency (hash)))
     (define blocked-set (list->set blocked))
     (let bfs ([queue (list (list src))]
               [visited (set src)])
       (cond
         [(null? queue)
          ;; Fallback without blocked constraint if graph cut by blocked wires
          (if (null? blocked)
              (list src dst)
              (coupling-graph-shortest-path graph src dst '()))]
         [else
          (define path (car queue))
          (define curr (car path))
          (if (= curr dst)
              (reverse path)
              (let* ([nbrs (for/list ([nb (in-list (hash-ref adj curr '()))]
                                      #:when (and (not (set-member? visited nb))
                                                  (or (= nb dst)
                                                      (not (set-member? blocked-set nb)))))
                             nb)]
                     [new-visited (for/fold ([v visited]) ([nb (in-list nbrs)]) (set-add v nb))]
                     [new-paths (for/list ([nb (in-list nbrs)]) (cons nb path))])
                (bfs (append (cdr queue) new-paths) new-visited)))]))]))

(define (route-revir-on-coupling-graph gates [graph-or-arch 'Heron-R2-156q])
  (define graph
    (if (hash? graph-or-arch)
        graph-or-arch
        (hardware-coupling-graph graph-or-arch)))
  (define adj (hash-ref graph 'adjacency (hash)))
  (define (route-2q-gate op u v phase)
    (cond
      [(or (member op '(EPR-SHARE TELE-CX BELL-MEAS-FIXUP AOD-SHUTTLE CZ-COND))
           (coupling-edge? graph u v))
       (list (list 'gate op (list u v) phase))]
      [else
       (define path (coupling-graph-shortest-path graph u v '()))
       ;; path = (p_0=u, p_1, ..., p_{k-1}, p_k=v) with k >= 2
       (define swap-pairs
         (for/list ([a (in-list (drop-right path 2))]
                    [b (in-list (cdr (drop-right path 1)))])
           (list a b)))
       (define fwd-swaps
         (for/list ([sp (in-list swap-pairs)])
           (list 'gate 'SWAP sp 0)))
       (define adj-u (list-ref path (- (length path) 2)))
       (append fwd-swaps
               (list (list 'gate op (list adj-u v) phase))
               (reverse fwd-swaps))]))
  (define (route-3q-gate op c1 c2 t phase)
    (define t-nbrs (hash-ref adj t '()))
    ;; Pick two distinct neighbors n1, n2 of t (or route c1->n1 and c2->n2)
    (define n1
      (cond
        [(coupling-edge? graph c1 t) c1]
        [(pair? t-nbrs)
         (or (for/first ([nb (in-list t-nbrs)] #:when (not (= nb c2))) nb)
             (first t-nbrs))]
        [else c1]))
    (define path1 (if (= c1 n1) (list c1) (coupling-graph-shortest-path graph c1 n1 (list t c2))))
    (define swaps1
      (for/list ([a (in-list (drop-right path1 1))]
                 [b (in-list (cdr path1))])
        (list 'gate 'SWAP (list a b) 0)))
    (define eff-c1 (last path1))
    (define n2
      (cond
        [(and (coupling-edge? graph c2 t) (not (= c2 eff-c1))) c2]
        [else
         (or (for/first ([nb (in-list t-nbrs)] #:when (not (= nb eff-c1))) nb)
             ;; If t has degree 1, pick a neighbor of eff-c1 distinct from t
             (for/first ([nb (in-list (hash-ref adj eff-c1 '()))] #:when (not (= nb t))) nb)
             c2)]))
    (define path2 (if (= c2 n2) (list c2) (coupling-graph-shortest-path graph c2 n2 (list t eff-c1))))
    (define swaps2
      (for/list ([a (in-list (drop-right path2 1))]
                 [b (in-list (cdr path2))])
        (list 'gate 'SWAP (list a b) 0)))
    (define eff-c2 (last path2))
    (append swaps1
            swaps2
            (list (list 'gate op (list eff-c1 eff-c2 t) phase))
            (reverse swaps2)
            (reverse swaps1)))
  (apply append
         (for/list ([g (in-list (if (list? gates) gates '()))])
           (match g
             [(list 'gate op (list u v) phase)
              (route-2q-gate op u v phase)]
             [(list 'gate op (list c1 c2 t) phase)
              (route-3q-gate op c1 c2 t phase)]
             [_ (list g)]))))

(define (verify-routed-coupling-graph-edges gates [graph-or-arch 'Heron-R2-156q])
  (define graph
    (if (hash? graph-or-arch)
        graph-or-arch
        (hardware-coupling-graph graph-or-arch)))
  (define netlist-check (verify-compiled-revir-netlist gates))
  (define violations
    (for/sum ([g (in-list (if (list? gates) gates '()))])
      (match g
        [(list 'gate op (list u v) _)
         (if (or (member op '(EPR-SHARE TELE-CX BELL-MEAS-FIXUP AOD-SHUTTLE CZ-COND))
                 (coupling-edge? graph u v))
             0
             1)]
        [(list 'gate _ (list c1 c2 t) _)
         ;; 3-qubit gate requires connected Steiner subgraph across {c1, c2, t}:
         ;; either both (c1, t) and (c2, t) in E(G), or (c1, c2) and one of (c1, t)/(c2, t) in E(G)
         (define e-c1-t? (coupling-edge? graph c1 t))
         (define e-c2-t? (coupling-edge? graph c2 t))
         (define e-c1-c2? (coupling-edge? graph c1 c2))
         (if (or (and e-c1-t? e-c2-t?)
                 (and e-c1-c2? (or e-c1-t? e-c2-t?)))
             0
             1)]
        [_ 0])))
  (define multi-qubit-gates
    (for/sum ([g (in-list (if (list? gates) gates '()))])
      (match g
        [(list 'gate _ ws _) (if (>= (length ws) 2) 1 0)]
        [_ 0])))
  (hash 'target-arch (hash-ref graph 'target-arch 'Heron-R2-156q)
        'total-gates (if (list? gates) (length gates) 0)
        'multi-qubit-gates multi-qubit-gates
        'non-adjacent-edge-violations violations
        'all-edges-in-coupling-graph? (zero? violations)
        'netlist-verified? (hash-ref netlist-check 'verified?)
        'verified? (and (zero? violations)
                        (hash-ref netlist-check 'verified?))))

(define (pass-m47-sabre-steiner-coupling-graph-router-and-edge-verifier
         unrouted-gates
         [target-arch 'Heron-R2-156q]
         [enforce-guard? #t])
  (define eff-unrouted
    (if (and (list? unrouted-gates) (pair? unrouted-gates))
        unrouted-gates
        (list (list 'gate 'H '(0) 0)
              (list 'gate 'CX '(0 15) 0)
              (list 'gate 'RZZ '(2 19) 785)
              (list 'gate 'CCX '(0 7 14) 0))))
  (define graph (hardware-coupling-graph target-arch))
  (define routed-gates
    (if enforce-guard?
        (route-revir-on-coupling-graph eff-unrouted graph)
        eff-unrouted))
  (define edge-check (verify-routed-coupling-graph-edges routed-gates graph))
  (define dyadic-eq (verify-exact-dyadic-unitary-equivalence eff-unrouted routed-gates))
  (hash 'pass-id 'M47-SABRE-Steiner-Coupling-Graph-Router-And-Edge-Verifier
        'target-arch target-arch
        'unrouted-gate-count (length eff-unrouted)
        'routed-gate-count (length routed-gates)
        'routed-gates routed-gates
        'non-adjacent-edge-violations (hash-ref edge-check 'non-adjacent-edge-violations)
        'all-edges-in-coupling-graph? (hash-ref edge-check 'all-edges-in-coupling-graph?)
        'exact-dyadic-unitary-equivalent? (hash-ref dyadic-eq 'verified?)
        'verified? (and (hash-ref edge-check 'verified?)
                        (hash-ref dyadic-eq 'verified?))))

(define (s81-hardware-coupling-graph-topological-edge-guard
         unrouted-gates [target-arch 'Heron-R2-156q] [enforce-guard? #t])
  (pass-m47-sabre-steiner-coupling-graph-router-and-edge-verifier
   unrouted-gates target-arch enforce-guard?))

;; -----------------------------------------------------------------------------
;; 22.4 Bit-Accurate Multi-Qubit Container Register Allocation & Address-Indexed
;;      Quantum Lookup/Update (`QDS-38`: `alloc-bit-accurate-qbraun-tree`,
;;      `compile-bit-accurate-qbraun-lookup-update`, `Fix F104`)
;; -----------------------------------------------------------------------------

(define (alloc-bit-accurate-qbraun-tree [depth 2]
                                        [elem-width 2]
                                        [base-wire 0]
                                        [enforce-disjoint-slices? #t])
  (define d (max 1 (min 3 (if (integer? depth) depth 2))))
  (define w (max 1 (min 4 (if (integer? elem-width) elem-width 2))))
  (define num-nodes (sub1 (expt 2 d)))
  (define payload-total-wires (* num-nodes w))
  (define node-slices
    (for/list ([j (in-range num-nodes)])
      (define start-w
        (if enforce-disjoint-slices?
            (+ base-wire (* j w))
            ;; Mutant F104: overlapping slice stride (j * (w - 1)) when enforce-disjoint-slices? is #f
            (+ base-wire (* j (max 0 (sub1 w))))))
      (for/list ([b (in-range w)])
        (+ start-w b))))
  (define addr-start
    (if enforce-disjoint-slices?
        (+ base-wire payload-total-wires)
        ;; Mutant F104: address register overlaps node-0 payload slice when enforce-disjoint-slices? is #f
        base-wire))
  (define addr-wires
    (for/list ([k (in-range d)])
      (+ addr-start k)))
  (define data-start (+ addr-start d))
  (define data-wires
    (for/list ([b (in-range w)])
      (+ data-start b)))
  (define scratch-start (max 18 (+ data-start w)))
  (define total-logical-wires (+ payload-total-wires d w))
  ;; Verify pairwise disjointness across all node slices, addr-wires, and data-wires
  (define all-allocated-wires
    (append (apply append node-slices) addr-wires data-wires))
  (define pairwise-disjoint?
    (and (= (length all-allocated-wires)
            (length (remove-duplicates all-allocated-wires)))
         (for/and ([i (in-range num-nodes)])
           (for/and ([j (in-range (add1 i) num-nodes)])
             (define s1 (list-ref node-slices i))
             (define s2 (list-ref node-slices j))
             (hash-ref (verify-qarray-slice-borrow total-logical-wires
                                                   (- (first s1) base-wire) w
                                                   (- (first s2) base-wire) w)
                       'verified?)))))
  (hash 'qds-id 'QDS-38-Bit-Accurate-Multi-Qubit-QBraun-Tree
        'tree-depth d
        'elem-width w
        'num-nodes num-nodes
        'node-slices node-slices
        'addr-wires addr-wires
        'data-wires data-wires
        'scratch-start scratch-start
        'total-logical-wires total-logical-wires
        'pairwise-disjoint-slices? pairwise-disjoint?
        'verified? pairwise-disjoint?))

(define (compile-bit-accurate-qbraun-lookup-update [depth 2]
                                                   [elem-width 2]
                                                   [mode 'lookup]
                                                   [enforce-guard? #t])
  (define layout (alloc-bit-accurate-qbraun-tree depth elem-width 0 enforce-guard?))
  (define d (hash-ref layout 'tree-depth))
  (define w (hash-ref layout 'elem-width))
  (define num-nodes (hash-ref layout 'num-nodes))
  (define node-slices (hash-ref layout 'node-slices))
  (define addr-wires (hash-ref layout 'addr-wires))
  (define data-wires (hash-ref layout 'data-wires))
  (define scratch-start (hash-ref layout 'scratch-start))
  ;; Address-decoded quantum multiplexer over node indices j = 0 .. (2^d - 2):
  ;; For each node j, decode (addr == j) into scratch ancilla `anc-dec` via reversible
  ;; X-negations + AND-COMPUTE chain, copy/update all `w` payload bits via CCX,
  ;; and uncompute `anc-dec` in reverse LIFO order.
  (define mux-gates
    (apply append
           (for/list ([j (in-range num-nodes)])
             (define slice-j (list-ref node-slices j))
             (define neg-x-gates
               (for/list ([bit-idx (in-range d)]
                          #:unless (bitwise-bit-set? j bit-idx))
                 (list 'gate 'X (list (list-ref addr-wires bit-idx)) 0)))
             (define anc-dec (+ scratch-start j))
             (define-values (dec-compute dec-wire)
               (cond
                 [(= d 1)
                  (values (list (list 'gate 'AND-COMPUTE (list (first addr-wires) anc-dec) 0))
                          anc-dec)]
                 [(= d 2)
                  (values (list (list 'gate 'AND-COMPUTE
                                      (list (first addr-wires) (second addr-wires) anc-dec)
                                      0))
                          anc-dec)]
                 [else
                  (define anc-mid (+ scratch-start num-nodes j))
                  (values (list (list 'gate 'AND-COMPUTE
                                      (list (first addr-wires) (second addr-wires) anc-mid)
                                      0)
                                (list 'gate 'AND-COMPUTE
                                      (list anc-mid (third addr-wires) anc-dec)
                                      0))
                          anc-dec)]))
             (define payload-ccx-gates
               (for/list ([b (in-range w)])
                 (define nw (list-ref slice-j b))
                 (define dw (list-ref data-wires b))
                 (if (eq? mode 'update)
                     (list 'gate 'CCX (list dec-wire dw nw) 0)
                     (list 'gate 'CCX (list dec-wire nw dw) 0))))
             (define dec-uncompute
               (if enforce-guard?
                   (invert-revir-gates dec-compute)
                   ;; Mutant F104: omitting decoder ancilla uncomputation
                   '()))
             (append neg-x-gates
                     dec-compute
                     payload-ccx-gates
                     dec-uncompute
                     (reverse neg-x-gates)))))
  (define netlist-check (verify-compiled-revir-netlist mux-gates))
  ;; Verify bit-accurate lookup/update truth table across all node addresses j = 0 .. num-nodes-1
  (define address-trials-passed
    (if (and (hash-ref layout 'verified?) (hash-ref netlist-check 'verified?))
        (for/sum ([target-addr (in-range num-nodes)])
          ;; Initialize node j with distinct w-bit pattern ((j + 1) mod 2^w)
          (define init-env (make-hash))
          (for ([j (in-range num-nodes)])
            (define val (modulo (add1 j) (expt 2 w)))
            (define slice-j (list-ref node-slices j))
            (for ([b (in-range w)])
              (hash-set! init-env (list-ref slice-j b) (if (bitwise-bit-set? val b) 1 0))))
          ;; Set address bits to target-addr
          (for ([bit-idx (in-range d)])
            (hash-set! init-env (list-ref addr-wires bit-idx)
                       (if (bitwise-bit-set? target-addr bit-idx) 1 0)))
          ;; Set data-wires to 0 for lookup, or delta = 1 for update
          (for ([b (in-range w)])
            (hash-set! init-env (list-ref data-wires b)
                       (if (and (eq? mode 'update) (= b 0)) 1 0)))
          (define final-env (simulate-revir-classical-netlist mux-gates init-env))
          (define expected-val (modulo (add1 target-addr) (expt 2 w)))
          (define data-out
            (for/sum ([b (in-range w)])
              (if (= (hash-ref final-env (list-ref data-wires b) 0) 1)
                  (arithmetic-shift 1 b)
                  0)))
          (define node-out
            (for/sum ([b (in-range w)])
              (if (= (hash-ref final-env (list-ref (list-ref node-slices target-addr) b) 0) 1)
                  (arithmetic-shift 1 b)
                  0)))
          (if (eq? mode 'update)
              (if (= node-out (bitwise-xor expected-val 1)) 1 0)
              (if (= data-out expected-val) 1 0)))
        0))
  (hash 'qds-id 'QDS-38-Bit-Accurate-Multi-Qubit-QBraun-Lookup-Update
        'mode mode
        'layout layout
        'num-nodes num-nodes
        'elem-width w
        'revir-gates mux-gates
        'revir-gate-count (length mux-gates)
        'address-trials-passed address-trials-passed
        'netlist-verified? (hash-ref netlist-check 'verified?)
        'verified? (and (hash-ref layout 'verified?)
                        (hash-ref netlist-check 'verified?)
                        (= address-trials-passed num-nodes))))

(define (qds38-bit-accurate-multi-qubit-qbraun-register-layout
         [depth 2] [elem-width 2] [enforce-guard? #t])
  (compile-bit-accurate-qbraun-lookup-update depth elem-width 'lookup enforce-guard?))

;; -----------------------------------------------------------------------------
;; 22.5 Circuit-Level Stim Detector Error Model (`DEM`) Compiler & Graphlike
;;      Code-Distance Verifier (`compile-qec-lift-to-stim-dem`,
;;      `verify-stim-dem-graphlike-distance`, `Pass M48`, `S82`, `Fix F105`)
;; -----------------------------------------------------------------------------

(define (compile-qec-lift-to-stim-dem [code-distance 5]
                                      [rounds 5]
                                      [physical-error-rate 0.001]
                                      [hook-safe-schedule? #t])
  (define d (max 3 (if (odd? code-distance) code-distance (add1 code-distance))))
  (define r (max d (if (integer? rounds) rounds d)))
  (define p (if (and (real? physical-error-rate) (> physical-error-rate 0))
                physical-error-rate
                0.001))
  ;; Spacetime detectors D_{x, t} for stabilizer column x in {1 .. d-1} and round t in {0 .. r-1}:
  ;; Each detector is the XOR parity of consecutive syndrome measurements m_{x, t} ^ m_{x, t-1}.
  (define detectors
    (apply append
           (for/list ([t (in-range r)])
             (for/list ([x (in-range 1 d)])
               (define det-id (+ (* t (sub1 d)) (sub1 x)))
               (define meas-curr (+ (* t (sub1 d)) (sub1 x)))
               (define meas-prev (if (> t 0) (+ (* (sub1 t) (sub1 d)) (sub1 x)) #f))
               (hash 'detector-id det-id
                     'coord (list x 0 t)
                     'measurement-records (if meas-prev (list meas-curr meas-prev) (list meas-curr))
                     'spacetime-xor-valid? (if (> t 0) (= (- meas-curr meas-prev) (sub1 d)) #t))))))
  ;; Graphlike error mechanisms along the logical axis 0 -> 1 -> ... -> d:
  ;; Vertex 0 is left boundary, vertices 1 .. d-1 are interior stabilizer columns,
  ;; Vertex d is right boundary (where crossing 0 -> ... -> d flips LOGICAL_OBSERVABLE 0).
  (define base-spatial-errors
    (for/list ([u (in-range d)])
      (define v (add1 u))
      (define dets
        (cond
          [(= u 0) (list 0)]
          [(= v d) (list (- d 2))]
          [else (list (sub1 u) u)]))
      (define flips-logical? (= v d))
      (hash 'type 'error
            'probability p
            'u u
            'v v
            'detectors dets
            'logical-observables (if flips-logical? '(0) '()))))
  ;; If `hook-safe-schedule?` is #f (Mutant F105: misaligned CNOT syndrome extraction order),
  ;; single mid-round ancilla faults propagate to weight-2 data errors jumping u -> min(d, u+2)!
  (define hook-fault-errors
    (if hook-safe-schedule?
        '()
        (for/list ([u (in-range 0 (sub1 d) 2)])
          (define v (min d (+ u 2)))
          (hash 'type 'error
                'probability (* 0.5 p)
                'u u
                'v v
                'detectors (if (< v d) (list u) (list (max 0 (- d 2))))
                'logical-observables (if (= v d) '(0) '())))))
  (define all-errors (append base-spatial-errors hook-fault-errors))
  (define dem-lines
    (append
     (for/list ([det (in-list detectors)])
       (match-define (list x y t) (hash-ref det 'coord))
       (format "DETECTOR(~a, ~a, ~a) rec[-1]~a"
               x y t (if (> t 0) (format " rec[-~a]" d) "")))
     (for/list ([err (in-list all-errors)])
       (define det-str
         (string-join (map (lambda (id) (format "D~a" id)) (hash-ref err 'detectors)) " "))
       (define log-str
         (if (pair? (hash-ref err 'logical-observables)) " L0" ""))
       (format "error(~a) ~a~a" (hash-ref err 'probability) det-str log-str))))
  (hash 'dem-id 'Stim-Detector-Error-Model
        'code-distance d
        'rounds r
        'physical-error-rate p
        'hook-safe-schedule? hook-safe-schedule?
        'detector-count (length detectors)
        'detectors detectors
        'error-mechanisms all-errors
        'dem-text (string-join dem-lines "\n")))

(define (verify-stim-dem-graphlike-distance dem-model [expected-distance #f])
  (define d (or expected-distance (hash-ref dem-model 'code-distance 5)))
  (define detectors (hash-ref dem-model 'detectors '()))
  (define errors (hash-ref dem-model 'error-mechanisms '()))
  (define spacetime-xor-ok?
    (and (pair? detectors)
         (for/and ([det (in-list detectors)])
           (hash-ref det 'spacetime-xor-valid? #f))))
  (define graphlike-ok?
    (and (pair? errors)
         (for/and ([err (in-list errors)])
           (<= (length (hash-ref err 'detectors '())) 2))))
  ;; Exact shortest-path search in detector graph G_DEM from left boundary (vertex 0, parity 0)
  ;; to right boundary (vertex d, logical flip parity 1) where each error mechanism is a weight-1 edge.
  (define adj (make-hash))
  (for ([err (in-list errors)])
    (define u (hash-ref err 'u 0))
    (define v (hash-ref err 'v 0))
    (define flip (if (pair? (hash-ref err 'logical-observables '())) 1 0))
    (hash-set! adj u (cons (list v flip) (hash-ref adj u '())))
    (hash-set! adj v (cons (list u flip) (hash-ref adj v '()))))
  (define achieved-distance
    (let bfs ([queue (list (list 0 0 0))]
              [visited (set (list 0 0))])
      (cond
        [(null? queue) 0]
        [else
         (match-define (list u par dist) (car queue))
         (if (and (= u d) (= par 1))
             dist
             (let* ([nbrs (for/list ([edge (in-list (hash-ref adj u '()))]
                                     #:unless (set-member? visited
                                                           (list (first edge)
                                                                 (bitwise-xor par (second edge)))))
                            (list (first edge) (bitwise-xor par (second edge)) (add1 dist)))]
                    [new-vis (for/fold ([vis visited]) ([n (in-list nbrs)])
                               (set-add vis (list (first n) (second n))))])
               (bfs (append (cdr queue) nbrs) new-vis)))])))
  (define distance-preserved? (>= achieved-distance d))
  (hash 'target-code-distance d
        'achieved-graphlike-distance achieved-distance
        'distance-loss (- d achieved-distance)
        'spacetime-xor-detectors-valid? spacetime-xor-ok?
        'all-errors-graphlike? graphlike-ok?
        'distance-preserved? distance-preserved?
        'verified? (and spacetime-xor-ok?
                        graphlike-ok?
                        distance-preserved?)))

(define (pass-m48-stim-detector-error-model-and-graphlike-distance-verifier
         [code-distance 5]
         [rounds 5]
         [enforce-guard? #t])
  (define dem (compile-qec-lift-to-stim-dem code-distance rounds 0.001 enforce-guard?))
  (define dist-check (verify-stim-dem-graphlike-distance dem (hash-ref dem 'code-distance)))
  (hash 'pass-id 'M48-Stim-Detector-Error-Model-And-Graphlike-Distance-Verifier
        'target-code-distance (hash-ref dist-check 'target-code-distance)
        'achieved-graphlike-distance (hash-ref dist-check 'achieved-graphlike-distance)
        'detector-count (hash-ref dem 'detector-count)
        'spacetime-xor-detectors-valid? (hash-ref dist-check 'spacetime-xor-detectors-valid?)
        'all-errors-graphlike? (hash-ref dist-check 'all-errors-graphlike?)
        'dem-text (hash-ref dem 'dem-text)
        'verified? (hash-ref dist-check 'verified?)))

(define (s82-stim-dem-spacetime-detector-and-distance-guard
         [code-distance 5] [rounds 5] [enforce-guard? #t])
  (pass-m48-stim-detector-error-model-and-graphlike-distance-verifier
   code-distance rounds enforce-guard?))

