(define (pass-m56-lakefill-kernel-denotational-equivalence-and-624-matrix-verifier
         [ast #f]
         [enforce-guard? #t])
  (define eff-ast (or ast (oqp-coreqds-ast 52)))
  (define k-ast (elaborate-coreqds20-to-lakefill-kernel6 eff-ast enforce-guard?))
  (define surf-gates (compile-coreqds-to-revir eff-ast))
  (define kern-gates (compile-lakefill-kernel6-to-revir k-ast enforce-guard?))
  (define dyadic-eq (verify-exact-dyadic-unitary-equivalence surf-gates kern-gates))
  ;; Verify all 20 surface constructor representatives preserve exact unitary equivalence
  (define all-20-equiv?
    (and enforce-guard?
         (for/and ([r (in-list (all-20-coreqds-surface-constructor-representatives))])
           (define kr (elaborate-coreqds20-to-lakefill-kernel6 r #t))
           (define sg (compile-coreqds-to-revir r))
           (define kg (compile-lakefill-kernel6-to-revir kr #t))
           (and (equal? sg kg)
                (hash-ref (verify-exact-dyadic-unitary-equivalence sg kg) 'verified?)))))
  (hash 'pass-id 'M56-Lakefill-Kernel-Denotational-Equivalence-And-624-Matrix-Verifier
        'surface-gate-count (length surf-gates)
        'kernel6-gate-count (length kern-gates)
        'gate-streams-identical? (equal? surf-gates kern-gates)
        'exact-dyadic-unitary-equivalent? (hash-ref dyadic-eq 'verified?)
        'all-20-ctors-unitary-equivalent? all-20-equiv?
        'lakefill-kernel6-only? (lakefill-kernel6-only? k-ast)
        'verified? (and enforce-guard?
                        (lakefill-kernel6-only? k-ast)
                        (equal? surf-gates kern-gates)
                        (hash-ref dyadic-eq 'verified?)
                        all-20-equiv?)))

(define (s90-lakefill-surface-to-kernel-equivalence-and-624-matrix-guard
         [ast #f]
