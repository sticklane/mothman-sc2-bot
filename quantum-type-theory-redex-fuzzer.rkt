    (for*/list ([fam (in-list all-5-parametric-resource-families)]
                [w (in-list slice-widths)])
      (compile-parametric-width-resource fam w enforce-guard?)))
  (define all-slices-verified?
    (for/and ([r (in-list family-results)]) (hash-ref r 'verified?)))
  (define ecc-res (compile-parametric-width-resource 'ECC-256 bit-width enforce-guard?))
  (define rsa-res (compile-parametric-width-resource 'RSA-2048 bit-width enforce-guard?))
  (define dqi-res (compile-parametric-width-resource 'DQI bit-width enforce-guard?))
  (define aes-res (compile-parametric-width-resource 'AES-256 bit-width enforce-guard?))
  (define sphincs-res (compile-parametric-width-resource 'SPHINCS+ bit-width enforce-guard?))
  (define cat58 (all-oqp-1-to-58-compiled-programs))
  (hash 'pass-id 'M68-Parametric-Width-Symbolic-Resource-Compiler
        'simplification-id 'S102-Parametric-Width-Slice-And-696-Matrix-Guard
        'families all-5-parametric-resource-families
        'slice-widths-tested slice-widths
        'ecc-256-full-qubits (hash-ref ecc-res 'symbolic-scaled-qubits)
        'rsa-2048-full-qubits (hash-ref rsa-res 'symbolic-scaled-qubits)
