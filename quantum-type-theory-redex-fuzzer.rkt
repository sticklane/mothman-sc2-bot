                  'Heron-R2-156q))
            (define k6-ast (elaborate-coreqds20-to-lakefill-kernel6 ast #t))
            (define k6-only? (lakefill-kernel6-only? k6-ast))
            (define raw-gates (compile-coreqds-to-revir ast))
            (define k6-gates (compile-lakefill-kernel6-to-revir k6-ast #t))
            (define env-res (compile-coreqds-env-lowered ast rho-env 16))
            (define tpar-gates (optimize-phase-polynomial-tpar-and-gf2-cnot k6-gates))
            (define routed-gates (route-revir-on-coupling-graph tpar-gates target-hw))
            (define rebased-gates (rebase-revir-to-native-machine-isa tpar-gates target-hw #t))
            (define mbu-gates (rewrite-revir-multishot-gidney-mbu k6-gates #t))
            (define tele-gates (rewrite-revir-multimachine-zipper-telegate k6-gates 4 #t))
            (define surf-k6-eq (verify-exact-dyadic-unitary-equivalence raw-gates k6-gates))
            (define dyadic-eq (verify-exact-dyadic-unitary-equivalence k6-gates tpar-gates))
            (define edge-check (verify-routed-coupling-graph-edges rebased-gates target-hw))
            (define strict-wt?
              (coreqds-strict-well-typed? ast default-env target-tier target-hw 'cudaq-tensor-core-opnic))
            (hash 'oqp-index idx
                  'ast ast
                  'lakefill-kernel6-ast k6-ast
                  'lakefill-kernel6-only? k6-only?
                  'undesugared-surface-ctor-count (count-undesugared-surface-ctors k6-ast)
                  'ast-node-count (coreqds-ast-node-count ast)
                  'has-dummy-qvar0-body? (coreqds-has-dummy-qvar0-body? ast)
                  'coreqds-strict-well-typed? strict-wt?
                  'raw-gates raw-gates
                  'kernel6-gates k6-gates
                  'raw-gate-count (length raw-gates)
                  'kernel6-gate-count (length k6-gates)
                  'surface-to-kernel6-unitary-equivalent? (hash-ref surf-k6-eq 'verified?)
                  'env-gates (hash-ref env-res 'gates)
                  'spurious-qvar-gates (hash-ref env-res 'spurious-qvar-gates)
                  'tpar-gate-count (length tpar-gates)
                  'routed-gate-count (length routed-gates)
                  'rebased-gate-count (length rebased-gates)
                  'unrebased-cx-count (count-unrebased-generic-cx-gates rebased-gates)
                  'mbu-mid-circuit-measurements (count-revir-mid-circuit-measurements mbu-gates)
                  'telegate-ebit-bell-pairs (count-ebit-bell-pairs tele-gates)
                  'telegate-direct-cross-module-gates (count-direct-cross-module-gates tele-gates 4)
                  'exact-dyadic-unitary-equivalent? (hash-ref dyadic-eq 'verified?)
                  'routed-coupling-edges-valid? (hash-ref edge-check 'verified?)
                  'verified? (and strict-wt?
                                  k6-only?
                                  (zero? (count-undesugared-surface-ctors k6-ast))
                                  (equal? raw-gates k6-gates)
                                  (hash-ref surf-k6-eq 'verified?)
                                  (hash-ref env-res 'verified?)
                                  (zero? (hash-ref env-res 'spurious-qvar-gates))
                                  (zero? (count-unrebased-generic-cx-gates rebased-gates))
                                  (zero? (count-direct-cross-module-gates tele-gates 4))
                                  (hash-ref dyadic-eq 'verified?)
                                  (hash-ref edge-check 'verified?)))))
        (define distinct-asts (length (remove-duplicates (map (lambda (e) (hash-ref e 'ast)) entries))))
        (define distinct-k6-asts (length (remove-duplicates (map (lambda (e) (hash-ref e 'lakefill-kernel6-ast)) entries))))
        (define distinct-netlists (length (remove-duplicates (map (lambda (e) (hash-ref e 'raw-gates)) entries))))
        (define all-ok?
          (and (= (length entries) 52)
               (= distinct-asts 52)
               (= distinct-k6-asts 52)
               (= distinct-netlists 52)
               (for/and ([e (in-list entries)])
                 (and (hash-ref e 'verified?)
                      (>= (hash-ref e 'ast-node-count) 5)
                      (not (hash-ref e 'has-dummy-qvar0-body?))))))
        (define res
          (hash 'total-oqp-programs (length entries)
                'distinct-ast-count distinct-asts
                'distinct-kernel6-ast-count distinct-k6-asts
                'distinct-netlist-count distinct-netlists
                'all-52-verified? all-ok?
                'entries entries
                'verified? all-ok?))
        (set! *cached-oqp-1-to-52-catalog* res)
        res)))

