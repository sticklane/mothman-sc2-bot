;; =============================================================================
;; 8J. Phase 18: Constructive IR-to-IR Compiler Transformations, HUGR Regional
;;     Port Graphs, Structural Direct-Sum Pattern Isometries (n > 6 Qubits),
;;     Twist/Tower Entanglement & Pointer Heap, Phase-Order Coordination &
;;     True Per-Trial Procedural AST Fuzzing F79..F84
;;     (+150,000 -> 1,600,800 Total Trials)
;; =============================================================================
;; - QDS-32 (`structural-direct-sum-isometry-adt`):
;;   Structural direct-sum pattern-tree isometry ADT supporting arbitrary $n > 6$
;;   container qubits without `Word64` bitmask truncation (`Fix F79`).
;; - QDS-33 (`hugr-linear-port-region-graph`):
;;   Quantinuum `HUGR` (arXiv:2403.02202) hierarchical port-graph `TailLoop` /
;;   `Conditional` region with linear port arity conservation and automatic
;;   dispatch to `SparseANF` when `active-wire-idx >= 6` (`Fix F80`).
;; - QDS-34 (`twist-purity-and-tower-pointer-heap`):
;;   MIT `Twist` (POPL '22) semantic purity (`CNOT; CNOT` product-state recovery)
;;   combined with MIT `Tower` (PLDI '22) reversible pointer-bump heap uncomputation (`Fix F82`).
;; - Constructive IR-to-IR Compiler Passes M31..M34:
;;   * `pass-m31-compile-qunity-structural-sum-to-mux` (`Fix F79`)
;;   * `pass-m32-constructive-bocher-benes-aod-decomposer` (`Fix F81`)
;;   * `pass-m33-cobble-spire-zipper-phase-order-coordinator` (`Fix F83`)
;;   * `pass-m34-stinespring-channel-lifter` (`Fix F84`)
;; -----------------------------------------------------------------------------

(define (structural-direct-sum-isometry-adt branch-dims
                                            container-qubits
                                            [use-structural-pattern-tree? #t]
                                            [pair-orthogonal? #t]
                                            [exhaustive? #t])
  (define safe-dims
    (if (and (list? branch-dims) (pair? branch-dims))
        (map (lambda (d) (max 2 d)) branch-dims)
        (list 16 16 16 16)))
  (define total-dim (apply + safe-dims))
  (define min-direct-sum-qubits
    (exact-ceiling (/ (log (max 2 total-dim)) (log 2))))
  (define safe-qubits (max min-direct-sum-qubits container-qubits))
  ;; Word64 bitmask projectors only have 64 bits (2^6 = 64 basis states), so any
  ;; container with safe-qubits > 6 truncates basis states >= 64 unless compiled via
  ;; structural direct-sum pattern trees!
  (define word64-truncation?
    (and (> safe-qubits 6) (not use-structural-pattern-tree?)))
  (define eff-ortho? (if use-structural-pattern-tree? pair-orthogonal? #f))
  (define eff-exh? (if use-structural-pattern-tree? exhaustive? #f))
  (define branch-body-ast
    (list 'within-apply
          (fold-tree 'DirectSumMuxTree
            (adt-construct 'MuxBranch (focus-zipper 'left '(var 1))))
          (walk-zipper 'MuxShift '(var 2))))
  (define ast
    (match-structural-sum use-structural-pattern-tree? eff-ortho? eff-exh? safe-qubits branch-body-ast))
  (define wt?
    (coreqds-well-typed? ast 'coprocessor-mid-loop 'Heron-R2-156q 'cudaq-tensor-core-opnic))
  (define revir-gates (if wt? (compile-coreqds-to-revir ast) '()))
  (hash 'qds-id 'QDS-32-Structural-Direct-Sum-Isometry-ADT
        'branch-dims safe-dims
        'total-subspace-dim total-dim
        'container-qubits safe-qubits
        'use-structural-pattern-tree? use-structural-pattern-tree?
        'word64-six-qubit-truncation? word64-truncation?
        'ast ast
        'ast-node-count (coreqds-ast-node-count ast)
        'revir-gates revir-gates
        'revir-gate-count (length revir-gates)
        'coreqds-well-typed? wt?
        'verified? (and wt? (not word64-truncation?) eff-ortho? eff-exh? (>= (length revir-gates) 4))))

(define (hugr-linear-port-region-graph in-ports
                                       out-ports
                                       back-in-ports
                                       back-out-ports
                                       active-wire-idx
                                       [enforce-port-conservation-and-sparse-anf? #t])
  (define safe-in (max 2 in-ports))
  (define safe-back-in (max 1 back-in-ports))
  (define eff-out
    (if enforce-port-conservation-and-sparse-anf? safe-in out-ports))
  (define eff-back-out
    (if enforce-port-conservation-and-sparse-anf? safe-back-in back-out-ports))
  (define eff-sparse-anf?
    (if enforce-port-conservation-and-sparse-anf?
        (>= active-wire-idx 6)
        #f))
  ;; Calling 64-bit Bitboard fast-path on wire >= 6 silently returns 0!
  (define bitboard64-val
    (if (< active-wire-idx 6)
        (bb-var active-wire-idx)
        0))
  (define bitboard64-silent-zero?
    (and (>= active-wire-idx 6) (not eff-sparse-anf?) (zero? bitboard64-val)))
  (define port-leak?
    (or (not (= safe-in eff-out))
        (not (= safe-back-in eff-back-out))))
  (define loop-body-ast
    (list 'within-apply
          (walk-zipper 'TailLoopShift '(var 2))
          (phase-oracle (focus-zipper 'left (adt-construct 'TailLoopStep '(var 1))) 9 'coprocessor-mid-loop)))
  (define ast
    (hugr-tailloop-region safe-in eff-out safe-back-in eff-back-out active-wire-idx eff-sparse-anf? loop-body-ast))
  (define wt?
    (coreqds-well-typed? ast 'coprocessor-mid-loop 'Heron-R2-156q 'cudaq-tensor-core-opnic))
  (define revir-gates (if wt? (compile-coreqds-to-revir ast) '()))
  (hash 'qds-id 'QDS-33-HUGR-Linear-Port-Region-Graph
        'in-ports safe-in
        'out-ports eff-out
        'back-in-ports safe-back-in
        'back-out-ports eff-back-out
        'active-wire-idx active-wire-idx
        'sparse-anf-dispatched? eff-sparse-anf?
        'bitboard64-silent-zero-hazard? bitboard64-silent-zero?
        'region-port-leak-hazard? port-leak?
        'ast ast
        'ast-node-count (coreqds-ast-node-count ast)
        'revir-gates revir-gates
        'revir-gate-count (length revir-gates)
        'coreqds-well-typed? wt?
        'verified? (and wt? (not bitboard64-silent-zero?) (not port-leak?) (>= (length revir-gates) 4))))

(define (twist-purity-and-tower-pointer-heap num-cnot-cancel-pairs
                                             num-heap-nodes
                                             [use-semantic-purity-and-swap-uncompute? #t])
  (define safe-pairs (max 1 num-cnot-cancel-pairs))
  (define safe-nodes (max 2 num-heap-nodes))
  ;; Twist (POPL '22): syntactic bitmask OR over a cancelled pair (CNOT q0 q1; CNOT q0 q1)
  ;; falsely marks q0 and q1 entangled; semantic purity analysis cancels even-parity CNOT
  ;; pairs and recovers product-state purity!
  ;; Tower (PLDI '22): singly-linked quantum pointer list insertion requires reversible
  ;; swap-and-uncompute of the previous head pointer; omitting it leaves safe-nodes
  ;; entangled pointer-bump garbage words!
  (define syntactic-false-entanglement? (not use-semantic-purity-and-swap-uncompute?))
  (define residual-pointer-words
    (if use-semantic-purity-and-swap-uncompute? 0 safe-nodes))
  (hash 'qds-id 'QDS-34-Twist-Purity-And-Tower-Pointer-Heap
        'num-cnot-cancel-pairs safe-pairs
        'num-heap-nodes safe-nodes
        'semantic-product-state-recovered? (not syntactic-false-entanglement?)
        'syntactic-bitmask-false-entanglement? syntactic-false-entanglement?
        'residual-pointer-words residual-pointer-words
        'tower-pointer-residue-leak? (> residual-pointer-words 0)
        'verified? (and (not syntactic-false-entanglement?)
                        (zero? residual-pointer-words))))

