(define (verify-cross-target-12arch-and-5layout-state-equivalence
         [oqp-idx 58]
         [enforce-guard? #t])
  (define ast (oqp-coreqds-ast oqp-idx))
  (define ref-gates (compile-coreqds-to-revir ast))
  (define ref-state-probes
    (for/list ([p (in-list '(0 #x5555 #x3333 #x0f0f))])
      (simulate-revir-exact-dyadic-statevector ref-gates p)))
  ;; 1. Route across all 5 coupling-graph layouts and verify exact output statevector equivalence
  (define layout-checks
    (for/list ([layout (in-list all-5-hardware-coupling-layouts)])
      (define routed
        (if enforce-guard?
            (route-non-adjacent-2q-along-dense-chain ref-gates layout)
            ;; Mutant: rewrites non-adjacent control wire u -> (sub1 v) WITHOUT SWAP conjugation!
            (cons (list 'gate 'X '(0) 0) ref-gates)))
      (define edge-ok? (hash-ref (verify-routed-coupling-graph-edges routed layout) 'verified?))
      (define eq-res (verify-exact-dyadic-unitary-equivalence ref-gates routed))
      (define probes-match?
        (equal? ref-state-probes
                (for/list ([p (in-list '(0 #x5555 #x3333 #x0f0f))])
                  (simulate-revir-exact-dyadic-statevector routed p))))
      (and edge-ok?
           (hash-ref eq-res 'verified?)
           probes-match?)))
  (define all-5-layouts-eq? (for/and ([ok? (in-list layout-checks)]) ok?))
  ;; 2. Verify across all 12 target architectures (3 Regimes x 4 Machine Families)
  (define arch-12-checks
    (for*/list ([reg (in-list all-3-quantum-execution-regimes)]
                [mach (in-list all-4-quantum-machine-families)])
      (define routed-mach
        (if enforce-guard?
            (route-non-adjacent-2q-along-dense-chain ref-gates mach)
            (cons (list 'gate 'X '(0) 0) ref-gates)))
      (define eq-mach (verify-exact-dyadic-unitary-equivalence ref-gates routed-mach))
      (define cell (compile-post-route-peephole-dense-pcc-cell oqp-idx reg mach enforce-guard?))
      (and (hash-ref eq-mach 'verified?)
           (hash-ref cell 'verified?))))
  (define all-12-targets-eq? (for/and ([ok? (in-list arch-12-checks)]) ok?))
  (hash 'oqp-index oqp-idx
        'layouts-tested all-5-hardware-coupling-layouts
        'layout-count (length all-5-hardware-coupling-layouts)
        'target-arch-count 12
        'all-5-layouts-state-equivalent? all-5-layouts-eq?
        'all-12-targets-state-equivalent? all-12-targets-eq?
        'cross-layout-state-divergence-hazard? (not (and all-5-layouts-eq? all-12-targets-eq?))
        'verified? (and enforce-guard?
                        all-5-layouts-eq?
                        all-12-targets-eq?)))

