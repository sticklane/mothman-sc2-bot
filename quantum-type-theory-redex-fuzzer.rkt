         (for/and ([ce (in-list counterexamples)])
           (hash-ref ce 'verified?))))
  (define rand-env '(1 2 3 4 5 6 7 8))

  (for ([i (in-range trials)])
    (define h (bitwise-and (+ (* i 2654435761) 451987653) #x7fffffff))
    (define depth (+ 3 (modulo h 4)))

    ;; 1. Recursively generate a genuine multi-node 13-constructor CoreQDS AST and lower it!
    (define proc-ast (generate-random-coreqds-ast h depth rand-env #t #f))
