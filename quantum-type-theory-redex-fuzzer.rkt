        'm35-multi-node-lowering-verified m35-multi-node-lowering-verified
        'dummy-qvar0-stub-mutant-caught dummy-qvar0-stub-mutant-caught
        'all-42-oqp-catalog-verified all-42-oqp-catalog-verified
        'forbidden-counterexamples-verified (length counterexamples)
        'verified? (and (= m35-multi-node-lowering-verified trials)
