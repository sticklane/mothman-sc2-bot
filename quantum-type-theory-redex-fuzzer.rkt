;; -----------------------------------------------------------------------------
;; S59, QDS-32, OQP-35, Pass M31 & Issue F79 (25,000 procedural trials):
;; `Word64` Pattern Bitmask 6-Qubit Cap vs Structural Direct-Sum Pattern Isometry (`Pass M31`)
;; - Issue F79: `match-orthogonal` represents branch projectors as 64-bit integer
;;   bitmasks (`m1`, `m2`), which only index $2^6 = 64$ basis states (at most 6 qubits)
;;   and silently truncate superposed ADTs on $7 \le n \le 128$ qubits!
;; - Verifies `pass-m31-compile-qunity-structural-sum-to-mux`, `structural-direct-sum-isometry-adt`
;;   (`QDS-32`), `match-structural-sum`, `OQP-35`, and `S59` across 25,000 genuine per-trial
;;   procedurally generated ASTs and widths $n \in [7..128]$.
;; -----------------------------------------------------------------------------
(define (fuzz-find-f79-word64-pattern-bitmask-six-qubit-cap-pass-m31 [trials 25000])
  (define m31-structural-sum-mux-verified 0)
  (define word64-six-qubit-truncation-mutant-caught 0)
  (define qds32-and-oqp35-verified 0)

  (for ([i (in-range trials)])
    (define h (bitwise-and (+ (* i 2654435761) 346410161) #x7fffffff))
    (define container-qubits (+ 7 (modulo h 122))) ;; 7..128 qubits (> 6-qubit Word64 cap!)
    (define d1 (+ 4 (bitwise-and h 63)))
    (define d2 (+ 4 (bitwise-and (arithmetic-shift h -6) 63)))
    (define d3 (+ 4 (bitwise-and (arithmetic-shift h -12) 63)))
    (define d4 (+ 4 (bitwise-and (arithmetic-shift h -18) 63)))
    (define branches
      (list (list 'Left d1 0)
            (list 'Mid d2 1)
            (list 'Right d3 2)
            (list 'Leaf d4 3)))

    ;; 1. Constructive Pass M31 & QDS-32 compile arbitrary-width n > 6 structural sum to mux AST!
    (define m31-wt (pass-m31-compile-qunity-structural-sum-to-mux branches container-qubits #t))
    (define s59-wt (s59-structural-direct-sum-pattern-isometry-guard (list d1 d2 d3 d4) container-qubits #t))
    (when (and (hash-ref m31-wt 'verified?)
               (not (hash-ref m31-wt 'word64-six-qubit-truncation?))
               (= (hash-ref m31-wt 'mux-branch-count) 4)
               (hash-ref s59-wt 'verified?))
      (set! m31-structural-sum-mux-verified (add1 m31-structural-sum-mux-verified)))

    ;; 2. Mutant F79: falling back to Word64 bitmask projectors at container-qubits >= 7 truncates basis states!
    (define m31-mut (pass-m31-compile-qunity-structural-sum-to-mux branches container-qubits #f))
    (define mut-ast (match-structural-sum #f #f #t container-qubits (list 'var (bitwise-and h 511))))
    (when (and (hash-ref m31-mut 'word64-six-qubit-truncation?)
               (not (hash-ref m31-mut 'verified?))
               (not (coreqds-well-typed? mut-ast 'coprocessor-mid-loop 'Heron-R2-156q 'cudaq-tensor-core-opnic)))
      (set! word64-six-qubit-truncation-mutant-caught (add1 word64-six-qubit-truncation-mutant-caught)))

    ;; 3. OQP-35 verification
    (define oqp35 (oqp35-structural-direct-sum-pattern-mux-arbitrary-width branches container-qubits #t))
    (when (hash-ref oqp35 'verified?)
      (set! qds32-and-oqp35-verified (add1 qds32-and-oqp35-verified))))

  (hash 'issue-id 'F79-word64-pattern-bitmask-six-qubit-cap-pass-m31
        'suite-id 'S59-PassM31-QDS32-OQP35-Structural-Direct-Sum-Pattern-Mux
        'trials trials
        'm31-structural-sum-mux-verified m31-structural-sum-mux-verified
        'word64-six-qubit-truncation-mutant-caught word64-six-qubit-truncation-mutant-caught
        'qds32-and-oqp35-verified qds32-and-oqp35-verified
        'verified? (and (= m31-structural-sum-mux-verified trials)
                        (= word64-six-qubit-truncation-mutant-caught trials)
                        (= qds32-and-oqp35-verified trials))))

;; -----------------------------------------------------------------------------
;; S60, QDS-33, OQP-36, TODAY-19 & Issue F80 (25,000 procedural trials):
;; Flat Gate-List `anf-bitboard64-var-mask` Silent Zero at $v \ge 6$ & `HUGR`
;; `TailLoop` Region Port Leak (`QDS-33`)
;; - Issue F80: Calling `anf-bitboard64-var-mask` on wire index $v \ge 6$ silently
;;   returns `0` (`#x0000000000000000`), annihilating ANF phase polynomials on wires
;;   $\ge 6$ unless dispatched to `SparseANF`, while flat gate-lists without `HUGR`
;;   `TailLoop` port-arity conservation leak qubits across loop back-edges!
;; - Verifies `hugr-linear-port-region-graph` (`QDS-33`), `hugr-tailloop-region`,
;;   `OQP-36`, `TODAY-19` (`16q`), and `S60` across 25,000 procedural trials.
;; -----------------------------------------------------------------------------
(define (fuzz-find-f80-flat-gatelist-bitboard64-silent-zero-and-region-loop-leak [trials 25000])
  (define qds33-hugr-region-and-sparse-anf-verified 0)
  (define bitboard64-silent-zero-or-port-leak-mutant-caught 0)
  (define oqp36-and-today19-verified 0)
  (define today19 (Hugr_TailLoop_Rus_Dyadic_Qsvt_16q 16))
  (define today19-ok?
    (and (hash-ref today19 'verified?)
         (= (hash-ref today19 'physical-qubits) 16)))

  (for ([i (in-range trials)])
    (define h (bitwise-and (+ (* i 2654435761) 360555127) #x7fffffff))
    (define in-ports (+ 4 (bitwise-and h 63)))
    (define back-ports (+ 2 (bitwise-and (arithmetic-shift h -6) 31)))
    (define wire-idx (+ 6 (modulo (arithmetic-shift h -11) 122))) ;; wire 6..127 (>= 6!)

    ;; 1. QDS-33 & S60 enforce linear port conservation and dispatch wire >= 6 to SparseANF!
    (define qds33-wt (hugr-linear-port-region-graph in-ports in-ports back-ports back-ports wire-idx #t))
    (define s60-wt (s60-hugr-tailloop-port-arity-and-sparse-anf-guard in-ports in-ports back-ports back-ports wire-idx #t))
    (when (and (hash-ref qds33-wt 'verified?)
               (hash-ref qds33-wt 'sparse-anf-dispatched?)
               (not (hash-ref qds33-wt 'bitboard64-silent-zero-hazard?))
               (not (hash-ref qds33-wt 'region-port-leak-hazard?))
               (hash-ref s60-wt 'verified?))
      (set! qds33-hugr-region-and-sparse-anf-verified (add1 qds33-hugr-region-and-sparse-anf-verified)))

    ;; 2. Mutant F80: unguarded 64-bit bitboard at wire >= 6 returns silent 0 and mismatched loop ports leak qubits!
    (define qds33-mut (hugr-linear-port-region-graph in-ports (+ in-ports 1) back-ports (+ back-ports 1) wire-idx #f))
    (define mut-ast-zero (hugr-tailloop-region in-ports in-ports back-ports back-ports wire-idx #f '(var 0)))
    (define mut-ast-port (hugr-tailloop-region in-ports (+ in-ports 1) back-ports back-ports wire-idx #t '(var 0)))
    (when (and (hash-ref qds33-mut 'bitboard64-silent-zero-hazard?)
               (hash-ref qds33-mut 'region-port-leak-hazard?)
               (not (hash-ref qds33-mut 'verified?))
               (not (coreqds-well-typed? mut-ast-zero 'coprocessor-mid-loop 'Heron-R2-156q 'cudaq-tensor-core-opnic))
               (not (coreqds-well-typed? mut-ast-port 'coprocessor-mid-loop 'Heron-R2-156q 'cudaq-tensor-core-opnic)))
      (set! bitboard64-silent-zero-or-port-leak-mutant-caught (add1 bitboard64-silent-zero-or-port-leak-mutant-caught)))

    ;; 3. OQP-36 & TODAY-19 (16q) verification
    (when today19-ok?
      (set! oqp36-and-today19-verified (add1 oqp36-and-today19-verified))))

  (hash 'issue-id 'F80-flat-gatelist-bitboard64-silent-zero-and-region-loop-leak
        'suite-id 'S60-QDS33-OQP36-TODAY19-HUGR-TailLoop-Port-Conservation
        'trials trials
        'qds33-hugr-region-and-sparse-anf-verified qds33-hugr-region-and-sparse-anf-verified
