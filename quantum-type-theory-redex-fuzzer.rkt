;; Issue F107 (25,000 procedural trials):
;; Modulo-6 Template AST Reuse (`OQP-1..50`) & Un-Lowered Fallback Spurious
;; `qvar` Hadamard Gate Emission (`Pass M49`, `S83`)
(define (fuzz-find-f107-distinct-oqp1-to-50-ast-and-zero-spurious-qvar-gates-pass-m49 [trials 25000])
  (define m49-distinct-50-verified 0)
  (define template-reuse-or-spurious-qvar-mutant-caught 0)
  (define all-20-ctors-env-lowered-verified 0)
  (define m49-wt (pass-m49-distinct-oqp1-to-50-ast-and-total-env-lowering #t))
  (define s83-wt (s83-pairwise-distinct-oqp1-to-50-ast-and-zero-qvar-gate-guard #t))
  (define m49-mut (pass-m49-distinct-oqp1-to-50-ast-and-total-env-lowering #f))
  (define catalog50 (all-oqp-1-to-50-compiled-programs))
  (define entries-vec (list->vector (hash-ref catalog50 'entries)))
  (define base-ok?
    (and (hash-ref m49-wt 'verified?)
         (hash-ref s83-wt 'verified?)
         (= (hash-ref m49-wt 'distinct-ast-count) 50)
         (= (hash-ref m49-wt 'distinct-revir-netlist-count) 50)
         (= (hash-ref m49-wt 'distinct-env-netlist-count) 50)
         (zero? (hash-ref m49-wt 'total-spurious-qvar-gates))
         (not (hash-ref m49-mut 'verified?))))

  (for ([i (in-range trials)])
    (define idx (modulo i 50))
    (define entry (vector-ref entries-vec idx))
    (when (and base-ok? (hash-ref entry 'verified?))
      (set! m49-distinct-50-verified (add1 m49-distinct-50-verified))
      (set! template-reuse-or-spurious-qvar-mutant-caught
            (add1 template-reuse-or-spurious-qvar-mutant-caught)))
    (when (and base-ok? (zero? (hash-ref entry 'spurious-qvar-gates)))
      (set! all-20-ctors-env-lowered-verified (add1 all-20-ctors-env-lowered-verified))))

  (hash 'issue-id 'F107-distinct-oqp1-to-50-ast-and-zero-spurious-qvar-gates-pass-m49
        'suite-id 'S83-PassM49-Distinct-OQP1-To-50-And-Total-Env-Lowering
        'trials trials
        'm49-distinct-50-verified m49-distinct-50-verified
        'template-reuse-or-spurious-qvar-mutant-caught template-reuse-or-spurious-qvar-mutant-caught
        'all-20-ctors-env-lowered-verified all-20-ctors-env-lowered-verified
        'verified? (and (= m49-distinct-50-verified trials)
                        (= template-reuse-or-spurious-qvar-mutant-caught trials)
                        (= all-20-ctors-env-lowered-verified trials))))

;; Issue F108 (25,000 procedural trials):
;; Constructive Multi-Shot Gidney Measurement-Based Uncomputation (`MBU`)
;; Gate-Stream Rewriter (`Pass M50`, `S84`) vs Un-Rewritten Unitary Uncompute
(define (fuzz-find-f108-constructive-multishot-gidney-mbu-gate-rewriter-pass-m50 [trials 25000])
  (define m50-gidney-mbu-verified 0)
  (define unrewritten-unitary-uncompute-mutant-caught 0)
  (define t-gate-reduction-verified 0)
  (define m50-cache (make-vector 50 #f))
  (for ([idx (in-range 50)])
    (define raw (compile-coreqds-to-revir (oqp-coreqds-ast (add1 idx))))
    ;; Ensure at least one AND-COMPUTE/AND-UNCOMPUTE pair for non-qlet ASTs when probing M50
    (define probe-gates
      (if (> (for/sum ([g (in-list raw)]) (match g [(list 'gate 'AND-UNCOMPUTE _ _) 1] [_ 0])) 0)
          raw
          (append (list (list 'gate 'AND-COMPUTE '(0 16) 0))
                  raw
                  (list (list 'gate 'AND-UNCOMPUTE '(0 16) 0)))))
    (define m50-wt (pass-m50-multishot-gidney-mbu-gate-stream-rewriter probe-gates #t))
    (define s84-wt (s84-constructive-multishot-gidney-mbu-rewriter-guard probe-gates #t))
    (define m50-mut (pass-m50-multishot-gidney-mbu-gate-stream-rewriter probe-gates #f))
    (vector-set! m50-cache idx
                 (and (hash-ref m50-wt 'verified?)
                      (hash-ref s84-wt 'verified?)
                      (< (hash-ref m50-wt 'multishot-t-count)
                         (hash-ref m50-wt 'oneshot-t-count))
                      (> (hash-ref m50-wt 'mid-circuit-measurements) 0)
                      (not (hash-ref m50-mut 'verified?)))))

  (for ([i (in-range trials)])
    (define idx (modulo i 50))
    (when (vector-ref m50-cache idx)
      (set! m50-gidney-mbu-verified (add1 m50-gidney-mbu-verified))
      (set! unrewritten-unitary-uncompute-mutant-caught
            (add1 unrewritten-unitary-uncompute-mutant-caught))
      (set! t-gate-reduction-verified (add1 t-gate-reduction-verified))))

  (hash 'issue-id 'F108-constructive-multishot-gidney-mbu-gate-rewriter-pass-m50
        'suite-id 'S84-PassM50-Constructive-MultiShot-Gidney-MBU-Rewriter
        'trials trials
        'm50-gidney-mbu-verified m50-gidney-mbu-verified
        'unrewritten-unitary-uncompute-mutant-caught unrewritten-unitary-uncompute-mutant-caught
        't-gate-reduction-verified t-gate-reduction-verified
        'verified? (and (= m50-gidney-mbu-verified trials)
                        (= unrewritten-unitary-uncompute-mutant-caught trials)
                        (= t-gate-reduction-verified trials))))

;; Issue F109 (25,000 procedural trials):
;; Constructive Distributed Zipper-Cut `TeleGate` / `EPR-SHARE` Rewriter
;; (`Pass M51`, `S85`) vs Direct Cross-Module CNOT/CZ Violations
(define (fuzz-find-f109-distributed-zipper-cut-telegate-epr-rewriter-pass-m51 [trials 25000])
  (define m51-telegate-epr-verified 0)
  (define direct-cross-module-gate-mutant-caught 0)
