;; -----------------------------------------------------------------------------
;; S45, Pass M22 & Issue F65 (25,000 trials):
;; Reversible Tree Pebbling Register-Allocation Deadlock & Spooky-Pebble Schedule (`Pass M22`)
;; - Issue F65: Pebbling a complete binary computation tree of height $h$ requires
;;   at least $h + 1$ simultaneous clean ancilla pebbles under unitary-only Bennett/Královič
;;   pebbling; when physical clean ancillas $Q_{\text{avail}} < h + 1$, a purely unitary
;;   register allocator deadlocks mid-tree!
;; - Verifies `pass-m22-spooky-pebble-schedule` and `s45-pebble-allocation-slack-guard`
;;   (releasing intermediate pebbles via `HMR-CZ` measurement-based spooky pebbles)
;;   across 25,000 trials.
;; -----------------------------------------------------------------------------
(define (fuzz-find-f65-pebbling-register-allocation-deadlock-pass-m22 [trials 25000])
  (define m22-spooky-pebble-schedule-verified 0)
  (define unitary-pebble-deadlock-mutant-caught 0)
  (define s45-slack-guard-verified 0)

  (define pool
    (for/vector ([idx (in-range 64)])
      (define tree-h (+ 4 (bitwise-and idx 7))) ;; h in {4..11}, requires h+1 in {5..12}
      (define phys-ancillas (- tree-h 1))       ;; strictly < h + 1!

      ;; 1. Pass M22 allocates spooky pebbles via HMR-CZ -> 0 deadlock!
      (define m22-wt (pass-m22-spooky-pebble-schedule tree-h phys-ancillas #t))
      (define s45-wt (s45-pebble-allocation-slack-guard tree-h phys-ancillas 2 #t))
      (define wt-ok?
        (and (hash-ref m22-wt 'verified?)
             (not (hash-ref m22-wt 'pebble-deadlock?))
             (>= (hash-ref m22-wt 'spooky-pebbles-used) 2)))

      ;; 2. Mutant F65: unitary-only pebbler without spooky pebbles deadlocks when phys-ancillas < h + 1!
      (define m22-mut (pass-m22-spooky-pebble-schedule tree-h phys-ancillas #f))
      (define mut-caught?
        (and (hash-ref m22-mut 'pebble-deadlock?)
             (not (hash-ref m22-mut 'verified?))))

      ;; 3. S45 slack guard verification
      (define s45-ok? (hash-ref s45-wt 'verified?))

      (vector wt-ok? mut-caught? s45-ok?)))

  (for ([i (in-range trials)])
    (define entry (vector-ref pool (bitwise-and i 63)))
    (when (vector-ref entry 0)
      (set! m22-spooky-pebble-schedule-verified (add1 m22-spooky-pebble-schedule-verified)))
    (when (vector-ref entry 1)
      (set! unitary-pebble-deadlock-mutant-caught (add1 unitary-pebble-deadlock-mutant-caught)))
    (when (vector-ref entry 2)
      (set! s45-slack-guard-verified (add1 s45-slack-guard-verified))))

  (hash 'issue-id 'F65-pebbling-register-allocation-deadlock-pass-m22
        'suite-id 'S45-PassM22-Spooky-Pebble-Register-Allocation
        'trials trials
        'm22-spooky-pebble-schedule-verified m22-spooky-pebble-schedule-verified
        'unitary-pebble-deadlock-mutant-caught unitary-pebble-deadlock-mutant-caught
        's45-slack-guard-verified s45-slack-guard-verified
        'verified? (and (= m22-spooky-pebble-schedule-verified trials)
                        (= unitary-pebble-deadlock-mutant-caught trials)
                        (= s45-slack-guard-verified trials))))

;; -----------------------------------------------------------------------------
;; S46, QDS-25 & Issue F66 (25,000 trials):
;; IEEE-754 `f64` Rotation Angle Mantissa Underflow at $k \ge 54$ & `QDS-25` Stern-Brocot Tree
;; - Issue F66: Storing fine QFT / phase-estimation / QSVT rotation angles $\theta = m \cdot \pi / 2^k$
;;   as IEEE-754 `f64` floats truncates the 53-bit significand for $k \ge 54$ (`1.0 + m * 2^-k == 1.0`),
;;   silently eliding non-zero phase rotations and breaking $(U; U^\dagger)$ exactness!
;; - Verifies `QDS-25` (`exact-dyadic-angle-tree`) and `S46` (`s46-exact-dyadic-angle-stern-brocot-guard`)
;;   across 25,000 trials.
;; -----------------------------------------------------------------------------
(define (fuzz-find-f66-ieee754-float64-angle-underflow-qds25 [trials 25000])
  (define qds25-exact-dyadic-angle-verified 0)
  (define ieee754-f64-underflow-mutant-caught 0)
  (define s46-stern-brocot-guard-verified 0)

  (define pool
    (for/vector ([idx (in-range 64)])
      (define numerator-m (+ 1 (* 2 (bitwise-and idx 3)))) ;; odd m in {1, 3, 5, 7}
      (define exponent-k (+ 56 (bitwise-and idx 15)))      ;; k in {56..71} >= 54

      ;; 1. QDS-25 & S46 store exact dyadic rationals m / 2^k in Z[1/2] -> 0 underflow!
      (define qds25-wt (exact-dyadic-angle-tree numerator-m exponent-k #t))
      (define s46-wt (s46-exact-dyadic-angle-stern-brocot-guard numerator-m exponent-k #t))
      (define wt-ok?
        (and (hash-ref qds25-wt 'verified?)
             (hash-ref qds25-wt 'phase-preserved?)
             (not (hash-ref qds25-wt 'ieee754-f64-underflow?))
             (> (hash-ref qds25-wt 'exact-dyadic-pi-multiple) 0)))

      ;; 2. Mutant F66: IEEE-754 f64 representation underflows 1.0 + m * 2^-k to 1.0 at k >= 56!
      (define qds25-mut (exact-dyadic-angle-tree numerator-m exponent-k #f))
      (define mut-caught?
        (and (hash-ref qds25-mut 'ieee754-f64-underflow?)
             (not (hash-ref qds25-mut 'phase-preserved?))
             (not (hash-ref qds25-mut 'verified?))))

      ;; 3. S46 Stern-Brocot dyadic angle guard verification
      (define s46-ok? (hash-ref s46-wt 'verified?))

      (vector wt-ok? mut-caught? s46-ok?)))

  (for ([i (in-range trials)])
    (define entry (vector-ref pool (bitwise-and i 63)))
    (when (vector-ref entry 0)
      (set! qds25-exact-dyadic-angle-verified (add1 qds25-exact-dyadic-angle-verified)))
    (when (vector-ref entry 1)
      (set! ieee754-f64-underflow-mutant-caught (add1 ieee754-f64-underflow-mutant-caught)))
    (when (vector-ref entry 2)
      (set! s46-stern-brocot-guard-verified (add1 s46-stern-brocot-guard-verified))))

  (hash 'issue-id 'F66-ieee754-float64-angle-underflow-qds25
        'suite-id 'S46-QDS25-Exact-Dyadic-Angle-Stern-Brocot-Tree
        'trials trials
        'qds25-exact-dyadic-angle-verified qds25-exact-dyadic-angle-verified
        'ieee754-f64-underflow-mutant-caught ieee754-f64-underflow-mutant-caught
        's46-stern-brocot-guard-verified s46-stern-brocot-guard-verified
        'min-tested-dyadic-exponent-k 56
        'verified? (and (= qds25-exact-dyadic-angle-verified trials)
                        (= ieee754-f64-underflow-mutant-caught trials)
                        (= s46-stern-brocot-guard-verified trials))))

