    (vector-set! m53-cache idx
                 (and (hash-ref m53-wt 'verified?)
                      (hash-ref s87-wt 'verified?)
                      (> (hash-ref m53-wt 'zx-nodes-eliminated) 0)
                      (not (hash-ref m53-mut 'verified?)))))

