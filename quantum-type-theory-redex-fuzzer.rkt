        'ast-node-count (coreqds-ast-node-count ast)
        'raw-gate-count (length raw-gates)
        'tpar-opt-gate-count (length tpar-gates)
        'routed-gate-count (length routed-gates)
        'revir-gates tpar-gates
        'revir-gate-count (length tpar-gates)
        'exact-dyadic-unitary-equivalent? (and (hash-ref dyadic-eq 'verified?)
                                               (hash-ref routed-eq 'verified?))
        'all-edges-in-coupling-graph? (hash-ref edge-check 'verified?)
        'verified? (and enforce-guard?
                        (< (length tpar-gates) (length raw-gates))
                        (hash-ref dyadic-eq 'verified?)
                        (hash-ref routed-eq 'verified?)
                        (hash-ref edge-check 'verified?))))

