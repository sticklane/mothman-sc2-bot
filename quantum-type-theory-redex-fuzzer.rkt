(define (contiguous-chain-swap-steps src dst)
  (cond
    [(= src dst) '()]
    [(< src dst)
     (for/list ([k (in-range src dst)])
       (list 'gate 'SWAP (list k (add1 k)) 0))]
    [else
     (for/list ([k (in-range src dst -1)])
       (list 'gate 'SWAP (list k (sub1 k)) 0))]))

(define (route-non-adjacent-2q-along-dense-chain gates [machine 'SuperconductingPlanar])
  (define graph (hardware-coupling-graph machine))
  (define active-ws (extract-active-revir-wires gates))
  (define max-w (if (null? active-ws) 2 (apply max active-ws)))
  (apply append
         (for/list ([g (in-list (if (list? gates) gates '()))])
           (match g
             [(list 'gate op (list u v) phase)
              (cond
                [(or (member op '(EPR-SHARE TELE-CX BELL-MEAS-FIXUP AOD-SHUTTLE CZ-COND))
                     (coupling-edge? graph u v)
                     (= u v))
                 (list g)]
                [else
                 ;; True SWAP-path conjugation along contiguous chain 0..max-w:
                 ;; moves wire u to adj-u (adjacent to v), applies (op adj-u v), and un-swaps!
                 (define adj-u (if (< u v) (sub1 v) (add1 v)))
                 (define fwd-swaps (contiguous-chain-swap-steps u adj-u))
                 (append fwd-swaps
                         (list (list 'gate op (list adj-u v) phase))
                         (reverse fwd-swaps))])]
             [(list 'gate op (list c1 c2 t) phase)
              (define e-c1-t? (coupling-edge? graph c1 t))
              (define e-c2-t? (coupling-edge? graph c2 t))
              (define e-c1-c2? (coupling-edge? graph c1 c2))
              (if (or (and e-c1-t? e-c2-t?)
                      (and e-c1-c2? (or e-c1-t? e-c2-t?))
                      (= c1 c2) (= c1 t) (= c2 t))
                  (list g)
                  (if (< (max c1 c2) t)
                      (let* ([w0 (min c1 c2)]
                             [w1 (max c1 c2)]
                             [sw1 (contiguous-chain-swap-steps w1 (sub1 t))]
                             [sw0 (contiguous-chain-swap-steps w0 (- t 2))]
                             [fwd-swaps (append sw1 sw0)]
                             [eff-c1 (if (< c1 c2) (- t 2) (sub1 t))]
                             [eff-c2 (if (< c1 c2) (sub1 t) (- t 2))])
                        (append fwd-swaps
                                (list (list 'gate op (list eff-c1 eff-c2 t) phase))
                                (reverse fwd-swaps)))
                      (let* ([sorted (sort (list c1 c2 t) <)]
                             [w0 (first sorted)]
                             [w1 (second sorted)]
                             [w2 (third sorted)]
                             [sw0 (contiguous-chain-swap-steps w0 0)]
                             [sw1 (contiguous-chain-swap-steps w1 1)]
                             [sw2 (contiguous-chain-swap-steps w2 2)]
                             [sw-t (cond
                                     [(= t w0) (list (list 'gate 'SWAP '(0 1) 0))]
                                     [(= t w2) (list (list 'gate 'SWAP '(1 2) 0))]
                                     [else '()])]
                             [phys-of (lambda (w)
                                        (cond
                                          [(= t w0) (cond [(= w w0) 1] [(= w w1) 0] [else 2])]
                                          [(= t w2) (cond [(= w w0) 0] [(= w w1) 2] [else 1])]
                                          [else     (cond [(= w w0) 0] [(= w w1) 1] [else 2])]))]
                             [eff-c1 (phys-of c1)]
                             [eff-c2 (phys-of c2)]
                             [fwd-swaps (append sw0 sw1 sw2 sw-t)])
                        (append fwd-swaps
                                (list (list 'gate op (list eff-c1 eff-c2 1) phase))
                                (reverse fwd-swaps)))))]
             [_ (list g)]))))

(define *cached-post-route-dense-pcc-cells* (make-hash))

(define (compile-post-route-peephole-dense-pcc-cell
         [oqp-idx 56]
         [regime 'MultiShotSingleMachine]
         [machine 'SuperconductingPlanar]
         [enforce-guard? #t])
  (hash-ref!
   *cached-post-route-dense-pcc-cells*
   (list oqp-idx regime machine enforce-guard?)
   (lambda ()
     (define surface-ast (oqp-coreqds-ast oqp-idx))
     (define kernel6-ast (elaborate-coreqds20-to-lakefill-kernel6 surface-ast enforce-guard?))
     (define base-cell (compile-coreqds-12-regime-machine-cell kernel6-ast regime machine enforce-guard?))
     (define raw-rebased (hash-ref base-cell 'rebased-gates))
     ;; 1. Apply Pass M61 post-rebase & post-route iterative peephole & 1Q Euler angle fusion,
     ;;    followed by Pass M62 dense wire compaction onto 0..W-1 and contiguous-chain routing
     (define final-gates
       (if (not enforce-guard?)
           (compact-revir-active-wires-dense raw-rebased #f)
           (let loop ([curr (fuse-and-cancel-post-route-revir-gates raw-rebased #t)]
                      [iters 3])
             (define compacted (compact-revir-active-wires-dense curr #t))
             (define chain-routed (route-non-adjacent-2q-along-dense-chain compacted machine))
             (define fused (fuse-and-cancel-post-route-revir-gates chain-routed #t))
             (if (or (<= iters 0)
                     (and (zero? (count-unused-declared-qubits fused))
                          (zero? (count-post-route-adjacent-self-canceling-gates fused))))
                 fused
                 (loop fused (sub1 iters))))))
     (define adj-canceling (count-post-route-adjacent-self-canceling-gates final-gates))
     (define unused-qubits (count-unused-declared-qubits final-gates))
     (define active-qubits (length (extract-active-revir-wires final-gates)))
     (define unrebased-cx (count-unrebased-generic-cx-gates final-gates))
     (define edge-check (verify-routed-coupling-graph-edges final-gates machine))
     (define m63-check (pass-m63-short-last-list-reserve-vs-beholder-double-charging 8 '(3 2 2) enforce-guard?))
     (define oct-check (verify-bilateral-phase-octant-sign-invariance '(1 2 3 5 7) enforce-guard?))
     (define cert
       (hash 'certificate-schema 'PCC-Lakefill-v2-PostRoute-Dense
             'oqp-index oqp-idx
             'regime regime
             'machine-family machine
             'pi-6-kernel-only? (and (lakefill-kernel6-only? kernel6-ast)
                                     (zero? (count-undesugared-surface-ctors kernel6-ast)))
             'pi-u-unitary-gflow-valid? (and (hash-ref base-cell 'verified?)
                                             (hash-ref oct-check 'verified?))
             'pi-g-coupling-isa-valid? (and (zero? unrebased-cx)
                                            (hash-ref edge-check 'verified?)
                                            (zero? adj-canceling)
                                            (zero? unused-qubits))
