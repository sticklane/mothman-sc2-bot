        'rebased-gate-count (hash-ref cell 'rebased-gate-count)
        'unrebased-cx-count (hash-ref cell 'unrebased-cx-count)
        'native-two-qubit-gate-count (hash-ref cell 'native-two-qubit-gate-count)
        'mid-circuit-measurements (hash-ref cell 'mid-circuit-measurements)
        'ebit-bell-pairs (hash-ref cell 'ebit-bell-pairs)
        'direct-cross-module-gates (hash-ref cell 'direct-cross-module-gates)
        'routed-coupling-edges-valid? (hash-ref cell 'routed-coupling-edges-valid?)
        'verified? (hash-ref cell 'verified?)))

