(define (check-true v [msg "Assertion failed"])
  (unless v
    (error 'check-true "~a: expected #t, got ~v" msg v)))

(define (check-equal? a b [msg "Equality assertion failed"])
  (unless (equal? a b)
    (error 'check-equal? "~a: expected ~v == ~v" msg a b)))

