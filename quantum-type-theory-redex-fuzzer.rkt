(define (xy4-dynamical-decoupling-idle-spine
         [idle-spine-wires '(2 3 4 5)]
         [modality 'SuperconductingPlanar]
         [omega-z 1]
         [enforce-guard? #t])
  (define t-idle-ns (idle-window-duration-ns modality))
  (define tau (/ t-idle-ns 4))
  (define eff-wires
    (if (and (list? idle-spine-wires) (pair? idle-spine-wires))
        idle-spine-wires
        '(2 3 4 5)))
  ;; Balanced 4-pulse XY4 spin-echo sequence: (X tau Y tau X tau Y tau)
  (define xy4-pulse-pattern
    (if enforce-guard?
        (list 'X tau 'Y tau 'X tau 'Y tau)
        (list 'I tau 'I tau 'I tau 'I tau)))
  ;; Sign toggles (+1, -1, +1, -1) across the 4 intervals refocus static Z-dephasing:
  ;; (+tau - tau + tau - tau) * omega_Z = 0
  (define sign-toggles
    (if enforce-guard?
        '(1 -1 1 -1)
        '(1 1 1 1)))
  (define net-dephasing-phase
    (* omega-z
       (for/sum ([s (in-list sign-toggles)])
         (* s tau))))
  (hash 'qds-id 'QDS-43-DynamicalDecouplingIdleSpineZipper
        'constructor 'DynamicalDecouplingIdleSpineZipper
        'modality modality
        'idle-window-ns t-idle-ns
        'tau-ns tau
        'idle-spine-wires eff-wires
        'idle-spine-wire-count (length eff-wires)
        'xy4-sequence xy4-pulse-pattern
        'pulse-count 4
        'sign-toggles sign-toggles
        'net-dephasing-phase net-dephasing-phase
        'dephasing-refocused? (zero? net-dephasing-phase)
        'unprotected-idle-dephasing-hazard? (not (zero? net-dephasing-phase))
        'verified? (and enforce-guard?
                        (equal? xy4-pulse-pattern (list 'X tau 'Y tau 'X tau 'Y tau))
                        (zero? net-dephasing-phase))))

