    (when (and strict-ok?
               (hash-ref m35-wt 'verified?)
               (>= (hash-ref m35-wt 'ast-node-count) 5)
               (not (hash-ref m35-wt 'has-dummy-qvar0-body?))
               (>= (hash-ref m35-wt 'revir-gate-count) 4)
               (hash-ref m35-wt 'balanced-ancilla-uncompute?)
               (hash-ref s65-wt 'verified?))
      (set! m35-multi-node-lowering-verified (add1 m35-multi-node-lowering-verified)))

    ;; 2. Mutant F85: both '(var 0) dummy stubs AND mutated recursive CoreQDS trees are 100% caught!
    (define stub-ast '(var 0))
    (define m35-mut (pass-m35-coreqds-to-revir-and-hugr-lowering-compiler stub-ast))
    (define mut-ast (generate-random-coreqds-ast h depth rand-env #f #f))
    (when (and (hash-ref m35-mut 'has-dummy-qvar0-body?)
               (not (hash-ref m35-mut 'verified?))
               (not (coreqds-strict-well-typed? mut-ast rand-env))
               counterexamples-ok?)
      (set! dummy-qvar0-stub-mutant-caught (add1 dummy-qvar0-stub-mutant-caught)))

    ;; 3. Verify OQP-1..42 compiled AST catalog (6 distinct algorithmic families + OQP-31..42)
    (define idx (+ 1 (modulo i 42)))
    (define oqp-ast (oqp-coreqds-ast idx))
    (when (and catalog-ok?
               (>= (coreqds-ast-node-count oqp-ast) 5)
               (not (coreqds-has-dummy-qvar0-body? oqp-ast)))
      (set! all-42-oqp-catalog-verified (add1 all-42-oqp-catalog-verified))))

  (hash 'issue-id 'F85-dummy-qvar0-stub-and-unlowered-metadata-bypass-pass-m35
        'suite-id 'S65-PassM35-CoreQDS-To-RevIR-And-OQP1To42-Lowering
