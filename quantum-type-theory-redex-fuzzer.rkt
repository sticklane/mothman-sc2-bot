      [`(c-seq ,c1 ,c2)
       (define-values (t1 d1 e1 l1 uw1 ok1) (synth c1 uwires links))
       (define-values (t2 d2 e2 l2 uw2 ok2) (synth c2 uw1 l1))
       (values (+ t1 t2) (+ d1 d2) (+ e1 e2) l2 uw2 (and ok1 ok2))]
      [`(c-dag ,inner)
       (define unit-ok? (circuit-unitary-only? inner))
       (define-values (t d e l uw ok) (synth (circuit-dag inner) uwires links))
       (values t d e l uw (and unit-ok? ok))]
      [`(c-with-uncompute ,u ,v)
       (define u-all (circuit-all-wires u))
       (define u-writes (circuit-write-set u))
       (define u-qfree?
         (and (circuit-unitary-qfree? u)
              (for/and ([w (in-list u-all)])
                (and (eq? (uwire-mode (list-ref uwires w)) 'QFree)
                     (not (wire-in-catlinks? w links))))))
       (define-values (tu du eu lu uwu oku) (synth u uwires links))
       (define-values (tv dv ev lv uwv okv) (synth v uwu lu))
       ;; Simplification S2: V may apply diagonal Z/CZ phases on AllWires(U),
       ;; but must preserve the (mode, anf, zone) triple of every wire in AllWires(U)
       ;; and must not perform XWrite or Hadamard on AllWires(U)!
       (define v-preserves-u?
         (and (null? (set-intersect (circuit-xwrite-set v) u-all))
              (null? (set-intersect (circuit-hadamard-set v) u-all))
              (for/and ([w (in-list u-all)])
                (equal? (list-ref uwv w) (list-ref uwu w)))))
       (define-values (tud dud eud lud uwud okud) (synth (circuit-dag u) uwv lv))
       (define u-restored?
         (for/and ([w (in-list u-writes)])
           (equal? (list-ref uwud w) (list-ref uwires w))))
       (values (+ tu tv tud) (+ du dv dud) (+ eu ev eud)
               lud uwud
               (and u-qfree? oku okv v-preserves-u? okud u-restored?))]
      [`(c-with-locked-pebble ,_p ,u ,v)
       ;; Vulnerability F10 in Phase-2: checks ReadSet(U) disjoint from XWriteSet(V),
       ;; but does NOT lock checkpoint target wire p against temporary reuse/measurement in V!
       (define u-reads (circuit-read-set u))
       (define-values (tu du eu lu uwu oku) (synth u uwires links))
       (define-values (tv dv ev lv uwv okv) (synth v uwu lu))
       (define-values (tud dud eud lud uwud okud) (synth (circuit-dag u) uwv lv))
       (define reads-preserved?
         (null? (set-intersect (circuit-xwrite-set v) u-reads)))
       (values (+ tu tv tud) (+ du dv dud) (+ eu ev eud)
               lud uwud
               (and oku okv okud reads-preserved?))]
      [`(c-par-diag ,c1 ,c2)
       (define all1 (circuit-all-wires c1))
       (define all2 (circuit-all-wires c2))
       (define shared (set-intersect all1 all2))
       (define mut1 (append (circuit-xwrite-set c1) (circuit-hadamard-set c1) (circuit-shuttle-set c1)))
       (define mut2 (append (circuit-xwrite-set c2) (circuit-hadamard-set c2) (circuit-shuttle-set c2)))
       ;; T-Par-Diag-Basis-Coherent: shared wires must be read-only Z-basis controls/phases in QFree mode
       (define shared-coherent?
         (and (null? (set-intersect mut1 all2))
              (null? (set-intersect mut2 all1))
              (for/and ([w (in-list shared)])
                (eq? (uwire-mode (list-ref uwires w)) 'QFree))))
       (define-values (t1 d1 e1 l1 uw1 ok1) (synth c1 uwires links))
       (define-values (t2 d2 e2 l12 uw12 ok2) (synth c2 uw1 l1))
       ;; Also verify grade-level order-independence between C1;C2 and C2;C1
       (define-values (_t2a _d2a _e2a l2 uw2 ok2a) (synth c2 uwires links))
       (define-values (_t1a _d1a _e1a l21 uw21 ok1a) (synth c1 uw2 l2))
       (define commute-ok?
         (and (equal? l12 l21) (equal? uw12 uw21) ok1a ok2a))
       (values (+ t1 t2) (max d1 d2) (+ e1 e2)
               l12 uw12
               (and ok1 ok2 shared-coherent? commute-ok?))]
      [`(c-unsafe-widen-refinement ,w ,inner)
       (match-define `(uwire ,_m ,a ,z) (list-ref uwires w))
       (define uw-widened (list-set uwires w `(uwire QFree ,a ,z)))
       (synth inner uw-widened links)]
      [`(c-voqc-opt ,inner)
       (synth (voqc-optimize-naive inner) uwires links)]))

  (define-values (toff depth ebits final-links final-uwires ok?)
    (synth c init-uwires '()))
  ;; Closed-circuit purity requires no leaked live cat-entangled links (L_live == ∅)
  (define closed-ok? (and ok? (null? final-links)))
  `(ugrade
    (toffolis ,toff)
    (depth ,depth)
    (ebits ,ebits)
    (live-links ,final-links)
    (wire-states ,final-uwires)
    (ok? ,closed-ok?)))

;; Single Unified Restoration Law (Simplification S3):
;; Simultaneously subsumes Fixes F1, F2, F3, F4, F5, F6, F7, F8!
(define (unified-restoration-law-holds? ug init-anfs aux-wires)
  (match-define `(ugrade (toffolis ,_) (depth ,_) (ebits ,_)
                         (live-links ,links) (wire-states ,uwires) (ok? ,ok?)) ug)
  (and ok?
       (null? links)
       (for/and ([w (in-list aux-wires)])
         (match-define `(uwire ,mode ,anf ,_zone) (list-ref uwires w))
         (and (eq? mode 'QFree)
              (equal? (anf-normalize anf)
                      (anf-normalize (list-ref init-anfs w)))))))

;; -----------------------------------------------------------------------------
;; Canonical Minimal Type System (`Synthesize-Canonical-Grade`, `typeof-canonical`,
;; Simplification S8):
;; Tracks per-wire 5-tuple `(cwire BasisMode RepState Locked? ANFPoly HardwareZone)`
;; + 4 scalar counters `(toffolis, depth, ebits, latency-ns)` + LIFO `live-links` stack.
;; Provably eliminates ALL 12 Fuzz Vulnerabilities F1..F12 with 0 soundness failures!
;; -----------------------------------------------------------------------------
(define (cwire-mode   cw) (second cw))
(define (cwire-rep    cw) (third cw))
(define (cwire-locked cw) (fourth cw))
(define (cwire-anf    cw) (fifth cw))
(define (cwire-zone   cw) (sixth cw))

(define (cwire-set-locked cw locked?)
  (match-define `(cwire ,m ,r ,_ ,a ,z) cw)
  `(cwire ,m ,r ,locked? ,a ,z))

(define (Synthesize-Canonical-Grade c init-anfs init-zones)
  (define init-cwires
    (map (lambda (a z) `(cwire QFree CanonicalMod #f ,(anf-normalize a) ,z))
         init-anfs init-zones))

  (define (step-gate g cwires links lat)
    (match g
      [`(g-id)
       (values 0 0 0 lat links cwires #t)]
      [`(g-x ,w)
       (match-define `(cwire ,m ,r ,lck ,a ,z) (list-ref cwires w))
       (define ok?
         (and (eq? m 'QFree)
              (eq? r 'CanonicalMod)
              (not lck)
              (not (wire-in-catlinks? w links))))
       (define cw-new (list-set cwires w `(cwire ,m ,r ,lck ,(anf-xor a '(())) ,z)))
       (values 0 1 0 lat links cw-new ok?)]
      [`(g-z ,w)
       (match-define `(cwire ,m ,r ,_lck ,a ,z) (list-ref cwires w))
       ;; Fix F9: Phase gate requires RepState == CanonicalMod!
       (define ok? (eq? r 'CanonicalMod))
       (define a-new (if (eq? m 'Superpos) (anf-xor a (list (xphase-mono w))) a))
       (define cw-new (list-set cwires w `(cwire ,m ,r ,_lck ,a-new ,z)))
       (values 0 1 0 lat links cw-new ok?)]
      [`(g-h ,w)
       (match-define `(cwire ,m ,r ,lck ,a ,z) (list-ref cwires w))
       (define pre-ok?
         (and (eq? r 'CanonicalMod)
              (not lck)
              (not (wire-in-catlinks? w links))))
       (cond
         [(not pre-ok?)
          (values 0 1 0 lat links (list-set cwires w `(cwire Superpos ,r ,lck ,a ,z)) #f)]
         [(eq? m 'QFree)
          (values 0 1 0 lat links (list-set cwires w `(cwire Superpos ,r ,lck ,a ,z)) #t)]
         [else
          (define dz? (poly-has-mono? a (xphase-mono w)))
          (define a-clean
            (if dz?
                (anf-xor (anf-xor a (list (xphase-mono w))) '(()))
                a))
          (values 0 1 0 lat links (list-set cwires w `(cwire QFree ,r ,lck ,a-clean ,z)) #t)])]
      [`(g-cnot ,c-w ,t-w)
       (match-define `(cwire ,mc ,rc ,_lckc ,ac ,zc) (list-ref cwires c-w))
       (match-define `(cwire ,mt ,rt ,lckt ,at ,zt) (list-ref cwires t-w))
       (define ok?
         (and (not (= c-w t-w))
              (eq? mc 'QFree) (eq? mt 'QFree)
              (eq? rc 'CanonicalMod) (eq? rt 'CanonicalMod)
              (not lckt)
              (eq? zc 'EntanglingZone) (eq? zt 'EntanglingZone)
              (not (wire-in-catlinks? c-w links))
              (not (wire-in-catlinks? t-w links))))
       (define cw-new (list-set cwires t-w `(cwire ,mt ,rt ,lckt ,(anf-xor at ac) ,zt)))
       (values 0 1 0 lat links cw-new ok?)]
      [`(g-cz ,c1 ,c2)
       (match-define `(cwire ,m1 ,r1 ,lck1 ,a1 ,z1) (list-ref cwires c1))
       (match-define `(cwire ,m2 ,r2 ,lck2 ,a2 ,z2) (list-ref cwires c2))
       ;; Fix F9: CZ requires RepState == CanonicalMod on both wires!
       (define ok?
         (and (not (= c1 c2))
              (eq? m1 'QFree) (eq? m2 'QFree)
              (eq? r1 'CanonicalMod) (eq? r2 'CanonicalMod)
              (eq? z1 'EntanglingZone) (eq? z2 'EntanglingZone)))
       (define cw1
         (if (eq? m1 'Superpos)
             (list-set cwires c1 `(cwire ,m1 ,r1 ,lck1 ,(anf-xor a1 (list (xphase-mono c1))) ,z1))
             cwires))
       (define cw2
         (if (eq? m2 'Superpos)
             (list-set cw1 c2 `(cwire ,m2 ,r2 ,lck2 ,(anf-xor a2 (list (xphase-mono c2))) ,z2))
             cw1))
       (values 0 1 0 lat links cw2 ok?)]
      [(or `(g-ccx ,c1 ,c2 ,t) `(g-compute-and ,c1 ,c2 ,t) `(g-and-compute ,c1 ,c2 ,t)
           `(g-rccx ,c1 ,c2 ,t) `(g-rccx-dag ,c1 ,c2 ,t))
       (match-define `(cwire ,m1 ,r1 ,_lck1 ,a1 ,z1) (list-ref cwires c1))
       (match-define `(cwire ,m2 ,r2 ,_lck2 ,a2 ,z2) (list-ref cwires c2))
       (match-define `(cwire ,mt ,rt ,lckt ,at ,zt) (list-ref cwires t))
       (define distinct? (and (not (= c1 c2)) (not (= c1 t)) (not (= c2 t))))
       (define ok?
         (and distinct?
              (eq? m1 'QFree) (eq? m2 'QFree) (eq? mt 'QFree)
              (eq? r1 'CanonicalMod) (eq? r2 'CanonicalMod) (eq? rt 'CanonicalMod)
              (not lckt)
              (eq? z1 'EntanglingZone) (eq? z2 'EntanglingZone) (eq? zt 'EntanglingZone)
              (not (wire-in-catlinks? c1 links))
              (not (wire-in-catlinks? c2 links))
              (not (wire-in-catlinks? t links))))
       (define cw-new (list-set cwires t `(cwire ,mt ,rt ,lckt ,(anf-xor at (anf-and a1 a2)) ,zt)))
       (values (if (or (eq? (car g) 'g-rccx) (eq? (car g) 'g-rccx-dag)) 0 1) 1 0 lat links cw-new ok?)]
      [(or `(g-hmr-cz ,t ,c1 ,c2 ,_) `(g-hmr-cz ,t ,c1 ,c2))
       (match-define `(cwire ,mt ,rt ,lckt ,at ,zt) (list-ref cwires t))
       (match-define `(cwire ,m1 ,r1 ,_lck1 ,a1 ,z1) (list-ref cwires c1))
       (match-define `(cwire ,m2 ,r2 ,_lck2 ,a2 ,z2) (list-ref cwires c2))
       (define distinct? (and (not (= c1 c2)) (not (= c1 t)) (not (= c2 t))))
       (define new-lat (+ lat 150))
       (define ok?
         (and distinct?
              (<= new-lat qec-cycle-budget-ns)
              (eq? mt 'QFree) (eq? m1 'QFree) (eq? m2 'QFree)
              (eq? rt 'CanonicalMod) (eq? r1 'CanonicalMod) (eq? r2 'CanonicalMod)
              (not lckt)
              (eq? zt 'EntanglingZone) (eq? z1 'EntanglingZone) (eq? z2 'EntanglingZone)
              (not (wire-in-catlinks? t links))
              (not (wire-in-catlinks? c1 links))
              (not (wire-in-catlinks? c2 links))
              (equal? (anf-normalize at) (anf-normalize (anf-and a1 a2)))))
       (define cw-new (list-set cwires t `(cwire QFree CanonicalMod ,lckt () ,zt)))
       (values 0 1 0 new-lat links cw-new ok?)]
      [`(g-zone-shuttle ,w ,z-target)
       (match-define `(cwire ,m ,r ,lck ,a ,_) (list-ref cwires w))
       (define ok? (not lck))
       (values 0 1 0 lat links (list-set cwires w `(cwire ,m ,r ,lck ,a ,z-target)) ok?)]
      [`(g-twirl-step ,w ,pol)
       (match-define `(cwire ,m ,r ,lck ,a ,z) (list-ref cwires w))
       (define ok?
         (and (eq? m 'QFree)
              (eq? r 'CanonicalMod)
              (not lck)
              (not (wire-in-catlinks? w links))))
       (define a-new (if (eq? pol 'TwirlOdd) (anf-xor a '(())) a))
       (values 0 1 0 lat links (list-set cwires w `(cwire ,m ,r ,lck ,a-new ,z)) ok?)]
      [`(g-tele-cnot ,c-w ,t-w)
       (match-define `(cwire ,mc ,rc ,_lckc ,ac ,zc) (list-ref cwires c-w))
       (match-define `(cwire ,mt ,rt ,lckt ,at ,zt) (list-ref cwires t-w))
       (define new-lat (+ lat 200))
       (define ok?
         (and (not (= c-w t-w))
              (<= new-lat qec-cycle-budget-ns)
              (eq? mc 'QFree) (eq? mt 'QFree)
              (eq? rc 'CanonicalMod) (eq? rt 'CanonicalMod)
              (not lckt)
              (eq? zc 'EntanglingZone) (eq? zt 'EntanglingZone)
              (not (wire-in-catlinks? t-w links))))
       (define cw-new (list-set cwires t-w `(cwire ,mt ,rt ,lckt ,(anf-xor at ac) ,zt)))
       (values 0 1 1 new-lat links cw-new ok?)]
      [`(g-cat-entangle ,c-w ,t-w)
       (match-define `(cwire ,mc ,rc ,_lckc ,ac ,zc) (list-ref cwires c-w))
       (match-define `(cwire ,mt ,rt ,lckt ,at ,zt) (list-ref cwires t-w))
       (define pair (list c-w t-w))
       (define new-lat (+ lat 150))
       (define ok?
         (and (not (= c-w t-w))
              (<= new-lat qec-cycle-budget-ns)
              (eq? mc 'QFree) (eq? mt 'QFree)
              (eq? rc 'CanonicalMod) (eq? rt 'CanonicalMod)
              (not lckt)
              (eq? zc 'EntanglingZone) (eq? zt 'EntanglingZone)
              (null? (anf-normalize at))
              (not (member pair links))
              (not (wire-in-catlinks? t-w links))))
       ;; Fix F12b: Push onto LIFO cat-link stack!
       (define links-new (cons pair links))
       (define cw-new (list-set cwires t-w `(cwire QFree CanonicalMod ,lckt ,ac ,zt)))
       (values 0 1 1 new-lat links-new cw-new ok?)]
      [`(g-cat-disentangle ,c-w ,t-w)
       (match-define `(cwire ,mc ,rc ,_lckc ,ac ,zc) (list-ref cwires c-w))
       (match-define `(cwire ,mt ,rt ,lckt ,at ,zt) (list-ref cwires t-w))
       (define pair (list c-w t-w))
       (define new-lat (+ lat 150))
       ;; Fix F12b: Must match the TOP of the LIFO cat-link stack (prevents FIFO deadlock)!
       (define lifo-top? (and (pair? links) (equal? (car links) pair)))
       (define ok?
         (and lifo-top?
              (<= new-lat qec-cycle-budget-ns)
              (eq? mc 'QFree) (eq? mt 'QFree)
              (eq? rc 'CanonicalMod) (eq? rt 'CanonicalMod)
              (not lckt)
              (eq? zc 'EntanglingZone) (eq? zt 'EntanglingZone)
              (equal? (anf-normalize at) (anf-normalize ac))))
       (define links-new (if lifo-top? (cdr links) (remove pair links)))
       (define cw-new (list-set cwires t-w `(cwire QFree CanonicalMod ,lckt () ,zt)))
       (values 0 1 0 new-lat links-new cw-new (not (not ok?)))]
      [`(g-skew-add-cs ,w)
       ;; Fix F9: Sets RepState = RedundantCS on wire w
       (match-define `(cwire ,m ,_r ,lck ,a ,z) (list-ref cwires w))
       (define ok?
         (and (eq? m 'QFree)
              (not lck)
              (not (wire-in-catlinks? w links))))
       (define cw-new (list-set cwires w `(cwire ,m RedundantCS ,lck ,(anf-xor a '(())) ,z)))
       (values 0 1 0 lat links cw-new ok?)]
      [`(g-consolidate-cs ,w)
       ;; Fix F9: Consolidates RedundantCS -> CanonicalMod (or inverse when run under circuit-dag)
       (match-define `(cwire ,m ,r ,lck ,a ,z) (list-ref cwires w))
       (define ok?
         (and (eq? m 'QFree)
              (not lck)
              (not (wire-in-catlinks? w links))))
       (define cw-new
         (if (eq? r 'RedundantCS)
             (list-set cwires w `(cwire ,m CanonicalMod ,lck ,a ,z))
             (list-set cwires w `(cwire ,m RedundantCS ,lck ,(anf-xor a '(())) ,z))))
       (values 1 1 0 lat links cw-new ok?)]
      [`(g-cmp-gt ,c1 ,c2 ,t)
       ;; Fix F9 & F11: Requires CanonicalMod and updates anf(t) <- at xor a1 xor (a1 * a2)
       (match-define `(cwire ,m1 ,r1 ,_lck1 ,a1 ,z1) (list-ref cwires c1))
       (match-define `(cwire ,m2 ,r2 ,_lck2 ,a2 ,z2) (list-ref cwires c2))
       (match-define `(cwire ,mt ,rt ,lckt ,at ,zt) (list-ref cwires t))
       (define distinct? (and (not (= c1 c2)) (not (= c1 t)) (not (= c2 t))))
       (define ok?
         (and distinct?
              (eq? m1 'QFree) (eq? m2 'QFree) (eq? mt 'QFree)
              (eq? r1 'CanonicalMod) (eq? r2 'CanonicalMod) (eq? rt 'CanonicalMod)
              (not lckt)
              (eq? z1 'EntanglingZone) (eq? z2 'EntanglingZone) (eq? zt 'EntanglingZone)
              (not (wire-in-catlinks? c1 links))
              (not (wire-in-catlinks? c2 links))
              (not (wire-in-catlinks? t links))))
       (define gt-p (anf-xor a1 (anf-and a1 a2)))
       (define cw-new (list-set cwires t `(cwire ,mt ,rt ,lckt ,(anf-xor at gt-p) ,zt)))
       (values 1 1 0 lat links cw-new ok?)]
      [`(g-cswap ,c-w ,c1 ,c2)
       ;; Fix F11: Exact nonlinear Fredkin ANF update delta = ac * (a1 xor a2) in F_2[x]!
       (match-define `(cwire ,mc ,rc ,_lckc ,ac ,zc) (list-ref cwires c-w))
       (match-define `(cwire ,m1 ,r1 ,lck1 ,a1 ,z1) (list-ref cwires c1))
       (match-define `(cwire ,m2 ,r2 ,lck2 ,a2 ,z2) (list-ref cwires c2))
       (define distinct? (and (not (= c-w c1)) (not (= c-w c2)) (not (= c1 c2))))
       (define ok?
         (and distinct?
              (eq? mc 'QFree) (eq? m1 'QFree) (eq? m2 'QFree)
              (eq? rc 'CanonicalMod) (eq? r1 'CanonicalMod) (eq? r2 'CanonicalMod)
              (not lck1) (not lck2)
              (eq? zc 'EntanglingZone) (eq? z1 'EntanglingZone) (eq? z2 'EntanglingZone)
              (not (wire-in-catlinks? c-w links))
              (not (wire-in-catlinks? c1 links))
              (not (wire-in-catlinks? c2 links))))
       (define delta-p (anf-and ac (anf-xor a1 a2)))
       (define cw1 (list-set cwires c1 `(cwire ,m1 ,r1 ,lck1 ,(anf-xor a1 delta-p) ,z1)))
       (define cw2 (list-set cw1    c2 `(cwire ,m2 ,r2 ,lck2 ,(anf-xor a2 delta-p) ,z2)))
       (values 1 1 0 lat links cw2 ok?)]
      [`(g-fpga-feedforward ,w ,d)
       ;; Fix F12a: Accumulates classical feed-forward latency d ns; must stay <= 1,000 ns!
       (match-define `(cwire ,_m ,r ,lck ,_a ,_z) (list-ref cwires w))
       (define new-lat (+ lat d))
       (define ok?
         (and (<= new-lat qec-cycle-budget-ns)
              (eq? r 'CanonicalMod)
              (not lck)))
       (values 0 1 0 new-lat links cwires ok?)]
      [`(g-qec-barrier)
       ;; Fix F12a: Resets cycle latency-ns to 0 when all cat links are closed and wires are CanonicalMod
       (define all-canonical?
         (for/and ([cw (in-list cwires)])
           (eq? (cwire-rep cw) 'CanonicalMod)))
       (define ok?
         (and (<= lat qec-cycle-budget-ns)
              (null? links)
              all-canonical?))
       (values 0 1 0 0 links cwires ok?)]
      ;; Phase-4/5/6 gates in Phase-3 Canonical system (illustrating Phase-3 gaps F14, F16, F19, F21..F24):
      [`(g-stim-detector ,_w)
       ;; Vulnerability F14 in Phase-3: treats DETECTOR as a passive metadata annotation
       ;; without enforcing QFree, CanonicalMod, and Delta_w(x) == 0 at the detector point!
       (values 0 1 0 lat links cwires #t)]
      [`(g-css-round-begin ,_mode)
       ;; Vulnerability F16 in Phase-3: does not track CSSRoundState!
       (values 0 1 0 lat links cwires #t)]
      [`(g-css-round-end ,_mode)
       (values 0 1 0 lat links cwires #t)]
      [`(g-bb-torus-shift ,_a ,_b)
       ;; Vulnerability F16 in Phase-3: allows Bivariate Bicycle torus shift inside open CSS round!
       (values 0 1 0 lat links cwires #t)]
      [`(g-kuperberg-collimate ,w1 ,_r1 ,w2 ,_r2)
       ;; Vulnerability F19 in Phase-3: checks QFree/CanonicalMod/Zone on w1,w2,
       ;; but omits the Kuperberg rank-match condition r1 == r2!
       (match-define `(cwire ,m1 ,rep1 ,_lck1 ,a1 ,z1) (list-ref cwires w1))
       (match-define `(cwire ,m2 ,rep2 ,lck2 ,a2 ,z2) (list-ref cwires w2))
       (define ok?
         (and (not (= w1 w2))
              (eq? m1 'QFree) (eq? m2 'QFree)
              (eq? rep1 'CanonicalMod) (eq? rep2 'CanonicalMod)
              (not lck2)
              (eq? z1 'EntanglingZone) (eq? z2 'EntanglingZone)))
       (values 0 1 0 lat links (list-set cwires w2 `(cwire ,m2 ,rep2 ,lck2 ,(anf-xor a2 a1) ,z2)) ok?)]
      [`(g-inject-fault ,_w ,_k)
       ;; Vulnerability F21 in Phase-3: ignores mid-schedule fault variable e_k!
       (values 0 1 0 lat links cwires #t)]
      [`(g-flag-clear ,w1 ,w2)
       (match-define `(cwire ,m1 ,r1 ,lck1 ,_a1 ,z1) (list-ref cwires w1))
       (match-define `(cwire ,m2 ,r2 ,lck2 ,_a2 ,z2) (list-ref cwires w2))
       (define cw1 (list-set cwires w1 `(cwire ,m1 ,r1 ,lck1 () ,z1)))
       (define cw2 (list-set cw1    w2 `(cwire ,m2 ,r2 ,lck2 () ,z2)))
       (values 0 1 0 lat links cw2 (and (not (= w1 w2)) (not lck1) (not lck2)))]
      [`(g-cultivate-step ,_w ,_r)
       (values 0 1 0 lat links cwires #t)]
      [`(g-inject-magic-t ,_w ,_r)
       ;; Vulnerability F22 in Phase-3: does not track cultivation BinomialRank(w) >= r!
       (values 0 1 0 lat links cwires #t)]
      [`(g-ppm-bus ,_l ,_r)
       ;; Vulnerability F23 in Phase-3: does not check spatial PPM bus interval congestion!
       (values 0 1 0 lat links cwires #t)]
      [`(g-gauge-open ,_w)
       (values 0 1 0 lat links cwires #t)]
      [`(g-gauge-fix ,_w)
       (values 0 1 0 lat links cwires #t)]
      [`(g-code-switch-transversal-t ,_w)
       ;; Vulnerability F24 in Phase-3: does not track GaugeState == ClosedHomologyGauge!
       (values 0 1 0 lat links cwires #t)]
      ;; Phase-8 gates in Phase-3 Canonical system:
      [`(g-native-ccz ,c1 ,c2 ,c3)
       (match-define `(cwire ,m1 ,r1 ,_l1 ,_a1 ,z1) (list-ref cwires c1))
       (match-define `(cwire ,m2 ,r2 ,_l2 ,_a2 ,z2) (list-ref cwires c2))
       (match-define `(cwire ,m3 ,r3 ,_l3 ,_a3 ,z3) (list-ref cwires c3))
       (define distinct? (and (not (= c1 c2)) (not (= c1 c3)) (not (= c2 c3))))
       (define ok?
         (and distinct?
              (eq? m1 'QFree) (eq? m2 'QFree) (eq? m3 'QFree)
              (eq? r1 'CanonicalMod) (eq? r2 'CanonicalMod) (eq? r3 'CanonicalMod)
              (eq? z1 'EntanglingZone) (eq? z2 'EntanglingZone) (eq? z3 'EntanglingZone)))
       (values 0 1 0 lat links cwires ok?)]
      [`(g-native-iswap ,q1 ,q2)
       (match-define `(cwire ,m1 ,r1 ,lck1 ,a1 ,z1) (list-ref cwires q1))
       (match-define `(cwire ,m2 ,r2 ,lck2 ,a2 ,z2) (list-ref cwires q2))
       (define ok?
         (and (not (= q1 q2))
              (eq? m1 'QFree) (eq? m2 'QFree)
              (eq? r1 'CanonicalMod) (eq? r2 'CanonicalMod)
              (not lck1) (not lck2)
              (eq? z1 'EntanglingZone) (eq? z2 'EntanglingZone)))
       (define cw1 (list-set cwires q1 `(cwire ,m1 ,r1 ,lck1 ,a2 ,z1)))
       (define cw2 (list-set cw1    q2 `(cwire ,m2 ,r2 ,lck2 ,a1 ,z2)))
       (values 0 1 0 lat links cw2 ok?)]
      [`(g-rzz ,q1 ,q2 ,_theta)
       (match-define `(cwire ,m1 ,r1 ,_lck1 ,_a1 ,z1) (list-ref cwires q1))
       (match-define `(cwire ,m2 ,r2 ,_lck2 ,_a2 ,z2) (list-ref cwires q2))
       (define ok?
         (and (not (= q1 q2))
              (eq? m1 'QFree) (eq? m2 'QFree)
              (eq? r1 'CanonicalMod) (eq? r2 'CanonicalMod)
              (eq? z1 'EntanglingZone) (eq? z2 'EntanglingZone)))
       (values 0 1 0 lat links cwires ok?)]
      [`(g-virtual-rz ,q ,_theta)
       (match-define `(cwire ,_m ,r ,_lck ,_a ,_z) (list-ref cwires q))
       (values 0 0 0 lat links cwires (eq? r 'CanonicalMod))]
      [`(g-meas ,kind ,q)
       (match-define `(cwire ,m ,r ,lck ,a ,z) (list-ref cwires q))
       (define new-lat (+ lat (gate-latency-ns g)))
       (define ok?
         (and (<= new-lat qec-cycle-budget-ns)
              (eq? m 'QFree)
              (eq? r 'CanonicalMod)
              (not lck)))
       (define cw-new
         (if (eq? kind 'meas-mcmr-reuse)
             (list-set cwires q `(cwire QFree CanonicalMod ,lck () ,z))
             (list-set cwires q `(cwire QFree CanonicalMod ,lck ,a ,z))))
       (values 0 1 0 new-lat links cw-new ok?)]
      [`(g-seq ,g1 ,g2)
       (define-values (t1 d1 e1 lat1 l1 cw1 ok1) (step-gate g1 cwires links lat))
       (define-values (t2 d2 e2 lat2 l2 cw2 ok2) (step-gate g2 cw1 l1 lat1))
       (values (+ t1 t2) (+ d1 d2) (+ e1 e2) lat2 l2 cw2 (and ok1 ok2))]))

  (define (synth circ cwires links lat)
    (match circ
      [`(c-gate ,g) (step-gate g cwires links lat)]
      [`(c-seq ,c1 ,c2)
       (define-values (t1 d1 e1 lat1 l1 cw1 ok1) (synth c1 cwires links lat))
       (define-values (t2 d2 e2 lat2 l2 cw2 ok2) (synth c2 cw1 l1 lat1))
       (values (+ t1 t2) (+ d1 d2) (+ e1 e2) lat2 l2 cw2 (and ok1 ok2))]
      [`(c-dag ,inner)
       (define unit-ok? (circuit-unitary-only? inner))
       (define-values (t d e lat1 l cw ok) (synth (circuit-dag inner) cwires links lat))
       (values t d e lat1 l cw (and unit-ok? ok))]
      [`(c-with-uncompute ,u ,v)
       (define u-all (circuit-all-wires u))
       (define u-writes (circuit-write-set u))
       (define u-qfree?
         (and (circuit-unitary-qfree? u)
              (for/and ([w (in-list u-all)])
                (match-define `(cwire ,m ,r ,lck ,_a ,_z) (list-ref cwires w))
                (and (eq? m 'QFree)
                     (eq? r 'CanonicalMod)
                     (not lck)
                     (not (wire-in-catlinks? w links))))))
       (define-values (tu du eu latu lu cwu oku) (synth u cwires links lat))
       (define-values (tv dv ev latv lv cwv okv) (synth v cwu lu latu))
       (define v-preserves-u?
         (and (null? (set-intersect (circuit-xwrite-set v) u-all))
              (null? (set-intersect (circuit-hadamard-set v) u-all))
              (for/and ([w (in-list u-all)])
                (equal? (list-ref cwv w) (list-ref cwu w)))))
       (define-values (tud dud eud latud lud cwud okud) (synth (circuit-dag u) cwv lv latv))
       (define u-restored?
         (for/and ([w (in-list u-writes)])
           (equal? (list-ref cwud w) (list-ref cwires w))))
       (values (+ tu tv tud) (+ du dv dud) (+ eu ev eud)
               latud lud cwud
               (and u-qfree? oku okv v-preserves-u? okud u-restored?))]
      [`(c-with-locked-pebble ,p ,u ,v)
       ;; Fix F10: Královič binomial pebbling checkpoint lock!
       ;; Computes checkpoint wire p via U, locks p (Locked? = #t) while V executes
       ;; on the suffix, then unlocks p and uncomputes U^dag.
       (define u-all (circuit-all-wires u))
       (define u-writes (circuit-write-set u))
       (define u-qfree?
         (and (circuit-unitary-qfree? u)
              (not (cwire-locked (list-ref cwires p)))
              (for/and ([w (in-list u-all)])
                (match-define `(cwire ,m ,r ,lck ,_a ,_z) (list-ref cwires w))
                (and (eq? m 'QFree)
                     (eq? r 'CanonicalMod)
                     (not lck)
                     (not (wire-in-catlinks? w links))))))
       (define-values (tu du eu latu lu cwu oku) (synth u cwires links lat))
       (define cwu-locked
         (list-update cwu p (lambda (cw) (cwire-set-locked cw #t))))
       (define-values (tv dv ev latv lv cwv-locked okv) (synth v cwu-locked lu latu))
       (define cwv
         (list-update cwv-locked p (lambda (cw) (cwire-set-locked cw (cwire-locked (list-ref cwires p))))))
       (define v-preserves-u?
         (and (not (member p (circuit-write-set v)))
              (null? (set-intersect (circuit-xwrite-set v) u-all))
              (null? (set-intersect (circuit-hadamard-set v) u-all))
              (for/and ([w (in-list u-all)])
                (equal? (list-ref cwv w) (list-ref cwu w)))))
       (define-values (tud dud eud latud lud cwud okud) (synth (circuit-dag u) cwv lv latv))
       (define u-restored?
         (for/and ([w (in-list (remove-duplicates (cons p u-writes) =))])
           (equal? (list-ref cwud w) (list-ref cwires w))))
       (values (+ tu tv tud) (+ du dv dud) (+ eu ev eud)
               latud lud cwud
               (and u-qfree? oku okv v-preserves-u? okud u-restored?))]
      [`(c-par-diag ,c1 ,c2)
       (define all1 (circuit-all-wires c1))
       (define all2 (circuit-all-wires c2))
       (define shared (set-intersect all1 all2))
       (define mut1 (append (circuit-xwrite-set c1) (circuit-hadamard-set c1) (circuit-shuttle-set c1)))
       (define mut2 (append (circuit-xwrite-set c2) (circuit-hadamard-set c2) (circuit-shuttle-set c2)))
       (define shared-coherent?
         (and (null? (set-intersect mut1 all2))
              (null? (set-intersect mut2 all1))
              (for/and ([w (in-list shared)])
                (and (eq? (cwire-mode (list-ref cwires w)) 'QFree)
                     (eq? (cwire-rep  (list-ref cwires w)) 'CanonicalMod)))))
       (define-values (t1 d1 e1 lat1 l1 cw1 ok1) (synth c1 cwires links lat))
       (define-values (t2 d2 e2 lat2 l12 cw12 ok2) (synth c2 cw1 l1 lat))
       (define-values (_t2a _d2a _e2a _lat2a l2 cw2 ok2a) (synth c2 cwires links lat))
       (define-values (_t1a _d1a _e1a _lat1a l21 cw21 ok1a) (synth c1 cw2 l2 lat))
       (define commute-ok?
         (and (equal? l12 l21) (equal? cw12 cw21) ok1a ok2a))
       (values (+ t1 t2) (max d1 d2) (+ e1 e2)
               (max lat1 lat2) l12 cw12
               (and ok1 ok2 shared-coherent? commute-ok?))]
      [`(c-unsafe-widen-refinement ,w ,inner)
       ;; Vulnerability F15 in naive/forgetful refinement subtyping:
       ;; resets RepState(w) := CanonicalMod, Locked?(w) := #f, BasisMode(w) := QFree!
       (match-define `(cwire ,_m ,_r ,lck ,a ,z) (list-ref cwires w))
       (define cw-widened (list-set cwires w `(cwire QFree CanonicalMod #f ,a ,z)))
       (define-values (t1 d1 e1 lat1 l1 cw1 ok1) (synth inner cw-widened links lat))
       (define cw-out (if lck (list-set cw1 w `(cwire QFree CanonicalMod #f ,a ,z)) cw1))
       (values t1 d1 e1 lat1 l1 cw-out ok1)]
      [`(c-voqc-opt ,inner)
       (synth (voqc-optimize-naive inner) cwires links lat)]))

  (define-values (toff depth ebits final-lat final-links final-cwires ok?)
    (synth c init-cwires '() 0))
  (define all-canonical-and-unlocked?
    (for/and ([cw (in-list final-cwires)])
      (and (eq? (cwire-rep cw) 'CanonicalMod)
           (not (cwire-locked cw)))))
  (define closed-ok?
    (and ok?
         (null? final-links)
         (<= final-lat qec-cycle-budget-ns)
         all-canonical-and-unlocked?))
  `(cgrade
    (toffolis ,toff)
    (depth ,depth)
    (ebits ,ebits)
    (latency-ns ,final-lat)
    (live-links ,final-links)
    (wire-states ,final-cwires)
    (ok? ,closed-ok?)))

;; Canonical Minimal Restoration Law (Simplification S8):
;; Simultaneously subsumes ALL 12 Fixes F1..F12!
(define (canonical-restoration-law-holds? cg init-anfs aux-wires)
  (match-define `(cgrade (toffolis ,_) (depth ,_) (ebits ,_) (latency-ns ,lat)
                         (live-links ,links) (wire-states ,cwires) (ok? ,ok?)) cg)
  (and ok?
       (null? links)
       (<= lat qec-cycle-budget-ns)
       (for/and ([cw (in-list cwires)])
         (and (eq? (cwire-rep cw) 'CanonicalMod)
              (not (cwire-locked cw))))
       (for/and ([w (in-list aux-wires)])
         (match-define `(cwire ,mode ,rep ,lck ,anf ,_zone) (list-ref cwires w))
         (and (eq? mode 'QFree)
              (eq? rep 'CanonicalMod)
              (not lck)
              (equal? (anf-normalize anf)
                      (anf-normalize (list-ref init-anfs w)))))))

;; Naive Refinement Plugin (`typeof-naive-plugin`, Issue F15):
;; Models a Liquid Haskell / Gospel subtyping plugin that allows forgetful refinement
;; widening `(c-unsafe-widen-refinement w C)` to drop `RedundantCS`, `Locked? = #t`,
;; or `Superpos` across a module boundary without discharging an SMT F_2[x] VC.
(define (typeof-naive-plugin c [init-anfs (initial-anf-env 4 '(3))] [init-zones (make-list 4 'EntanglingZone)])
  (Synthesize-Canonical-Grade c init-anfs init-zones))

;; -----------------------------------------------------------------------------
;; Phase-4 Certified Compiler Type System (`Synthesize-Certified-Compiler-Grade`,
;; `typeof-certified-compiler`, Fixes F1..F16 & Simplifications S9-S10):
;; Enforces:
;;   - Fix F13: Canonical VOQC optimization (`voqc-optimize-canonical` via `can-commute-past?`)
;;   - Fix F14: Deterministic `Stim` detector precondition (`BasisMode = QFree`,
;;              `RepState = CanonicalMod`, `ANFPoly(w) = init-anf(w)` / `Delta_w(x) = 0`)
;;   - Fix F15: Sound SMT-backed refinement subtyping (`c-unsafe-widen-refinement` allowed
;;              ONLY when wire w already satisfies `QFree`, `CanonicalMod`, `Unlocked`, `Delta_w = 0`)
;;   - Fix F16: `[[288, 12, 18]]` Bivariate Bicycle `CSSRoundState` tracking (`CSSClosed` required
;;              at `g-bb-torus-shift`, `g-qec-barrier`, and circuit exit)
;; -----------------------------------------------------------------------------
(define (Synthesize-Certified-Compiler-Grade c init-anfs init-zones)
  (define init-cwires
    (map (lambda (a z) `(cwire QFree CanonicalMod #f ,(anf-normalize a) ,z))
         init-anfs init-zones))

  (define (step-gate g cwires links lat css-round)
    (match g
      [`(g-stim-detector ,w)
       ;; Fix F14: Stim DETECTOR requires BasisMode = QFree, RepState = CanonicalMod,
       ;; not locked, not in cat-links, and ANFPoly(w) == init_anf(w) (Delta_w(x) == 0)
       ;; and (for syndrome ancillas) clean/deterministic |0>!
       (match-define `(cwire ,m ,r ,lck ,a ,_z) (list-ref cwires w))
       (define init-a (anf-normalize (list-ref init-anfs w)))
       (define norm-a (anf-normalize a))
       (define det-ok?
         (and (eq? m 'QFree)
              (eq? r 'CanonicalMod)
              (not lck)
              (not (wire-in-catlinks? w links))
              (not (poly-has-virtual-tag? norm-a))
              (equal? norm-a init-a)
              (or (null? norm-a) (equal? norm-a (list (list w))))))
       (values 0 1 0 lat css-round links cwires det-ok?)]
      [`(g-css-round-begin ,mode)
       ;; Fix F16: Begin X/Z stabilizer syndrome round; requires CSSRoundState == CSSClosed
       (define all-canonical?
         (for/and ([cw (in-list cwires)])
           (eq? (cwire-rep cw) 'CanonicalMod)))
       (define ok?
         (and (eq? css-round 'CSSClosed)
              (null? links)
              all-canonical?))
       (define css-next
         (if (eq? css-round 'CSSClosed)
             (if (eq? mode 'Superpos) 'CSSOpenX 'CSSOpenZ)
             css-round))
       (values 0 1 0 lat css-next links cwires ok?)]
      [`(g-css-round-end ,mode)
       ;; Fix F16: End X/Z stabilizer syndrome round; requires matching CSSOpenX / CSSOpenZ
       (define expected (if (eq? mode 'Superpos) 'CSSOpenX 'CSSOpenZ))
       (define all-canonical?
         (for/and ([cw (in-list cwires)])
           (eq? (cwire-rep cw) 'CanonicalMod)))
       (define ok?
         (and (eq? css-round expected)
              (null? links)
              all-canonical?))
       (values 0 1 0 lat 'CSSClosed links cwires ok?)]
      [`(g-bb-torus-shift ,a ,b)
       ;; Fix F16: [[288, 12, 18]] Bivariate Bicycle torus automorphism sigma_{a,b}
       ;; requires CSSRoundState == CSSClosed and all wires in QFree + CanonicalMod!
       (define all-qfree-canonical?
         (for/and ([cw (in-list cwires)])
           (and (eq? (cwire-mode cw) 'QFree)
                (eq? (cwire-rep cw) 'CanonicalMod)
                (not (cwire-locked cw)))))
       (define ok?
         (and (eq? css-round 'CSSClosed)
              (null? links)
              all-qfree-canonical?
              (< a 12)
              (< b 6)))
       (values 0 1 0 lat css-round links cwires ok?)]
      [`(g-qec-barrier)
       (define all-canonical?
         (for/and ([cw (in-list cwires)])
           (eq? (cwire-rep cw) 'CanonicalMod)))
       (define ok?
         (and (<= lat qec-cycle-budget-ns)
              (null? links)
              (eq? css-round 'CSSClosed)
              all-canonical?))
       (values 0 1 0 0 css-round links cwires ok?)]
      [_
       ;; Delegate standard Phase 1-3 gates to Synthesize-Canonical-Grade single-gate step
       ;; by running step on current cwires/links/lat:
       (match g
         [`(g-id) (values 0 0 0 lat css-round links cwires #t)]
         [`(g-x ,w)
          (match-define `(cwire ,m ,r ,lck ,a ,z) (list-ref cwires w))
          (define ok? (and (eq? m 'QFree) (eq? r 'CanonicalMod) (not lck) (not (wire-in-catlinks? w links))))
          (values 0 1 0 lat css-round links (list-set cwires w `(cwire ,m ,r ,lck ,(anf-xor a '(())) ,z)) ok?)]
         [`(g-z ,w)
          (match-define `(cwire ,m ,r ,lck ,a ,z) (list-ref cwires w))
          (define ok? (eq? r 'CanonicalMod))
          (define a-new (if (eq? m 'Superpos) (anf-xor a (list (xphase-mono w))) a))
          (values 0 1 0 lat css-round links (list-set cwires w `(cwire ,m ,r ,lck ,a-new ,z)) ok?)]
         [`(g-h ,w)
          (match-define `(cwire ,m ,r ,lck ,a ,z) (list-ref cwires w))
          (define pre-ok? (and (eq? r 'CanonicalMod) (not lck) (not (wire-in-catlinks? w links))))
          (cond
            [(not pre-ok?)
             (values 0 1 0 lat css-round links (list-set cwires w `(cwire Superpos ,r ,lck ,a ,z)) #f)]
            [(eq? m 'QFree)
             (values 0 1 0 lat css-round links (list-set cwires w `(cwire Superpos ,r ,lck ,a ,z)) #t)]
            [else
             (define dz? (poly-has-mono? a (xphase-mono w)))
             (define a-clean (if dz? (anf-xor (anf-xor a (list (xphase-mono w))) '(())) a))
             (values 0 1 0 lat css-round links (list-set cwires w `(cwire QFree ,r ,lck ,a-clean ,z)) #t)])]
         [`(g-cnot ,c-w ,t-w)
          (match-define `(cwire ,mc ,rc ,_lckc ,ac ,zc) (list-ref cwires c-w))
          (match-define `(cwire ,mt ,rt ,lckt ,at ,zt) (list-ref cwires t-w))
          (define ok?
            (and (not (= c-w t-w))
                 (eq? mc 'QFree) (eq? mt 'QFree)
                 (eq? rc 'CanonicalMod) (eq? rt 'CanonicalMod)
                 (not lckt)
                 (eq? zc 'EntanglingZone) (eq? zt 'EntanglingZone)
                 (not (wire-in-catlinks? c-w links))
                 (not (wire-in-catlinks? t-w links))))
          (values 0 1 0 lat css-round links (list-set cwires t-w `(cwire ,mt ,rt ,lckt ,(anf-xor at ac) ,zt)) ok?)]
         [`(g-cz ,c1 ,c2)
          (match-define `(cwire ,m1 ,r1 ,lck1 ,a1 ,z1) (list-ref cwires c1))
          (match-define `(cwire ,m2 ,r2 ,lck2 ,a2 ,z2) (list-ref cwires c2))
          (define ok?
            (and (not (= c1 c2))
                 (eq? m1 'QFree) (eq? m2 'QFree)
                 (eq? r1 'CanonicalMod) (eq? r2 'CanonicalMod)
                 (eq? z1 'EntanglingZone) (eq? z2 'EntanglingZone)))
          (define cw1 (if (eq? m1 'Superpos) (list-set cwires c1 `(cwire ,m1 ,r1 ,lck1 ,(anf-xor a1 (list (xphase-mono c1))) ,z1)) cwires))
          (define cw2 (if (eq? m2 'Superpos) (list-set cw1 c2 `(cwire ,m2 ,r2 ,lck2 ,(anf-xor a2 (list (xphase-mono c2))) ,z2)) cw1))
          (values 0 1 0 lat css-round links cw2 ok?)]
         [(or `(g-ccx ,c1 ,c2 ,t) `(g-compute-and ,c1 ,c2 ,t) `(g-and-compute ,c1 ,c2 ,t)
              `(g-rccx ,c1 ,c2 ,t) `(g-rccx-dag ,c1 ,c2 ,t))
          (match-define `(cwire ,m1 ,r1 ,_lck1 ,a1 ,z1) (list-ref cwires c1))
          (match-define `(cwire ,m2 ,r2 ,_lck2 ,a2 ,z2) (list-ref cwires c2))
          (match-define `(cwire ,mt ,rt ,lckt ,at ,zt) (list-ref cwires t))
          (define distinct? (and (not (= c1 c2)) (not (= c1 t)) (not (= c2 t))))
          (define ok?
            (and distinct?
                 (eq? m1 'QFree) (eq? m2 'QFree) (eq? mt 'QFree)
                 (eq? r1 'CanonicalMod) (eq? r2 'CanonicalMod) (eq? rt 'CanonicalMod)
                 (not lckt)
                 (eq? z1 'EntanglingZone) (eq? z2 'EntanglingZone) (eq? zt 'EntanglingZone)
                 (not (wire-in-catlinks? c1 links))
                 (not (wire-in-catlinks? c2 links))
                 (not (wire-in-catlinks? t links))))
          (values (if (or (eq? (car g) 'g-rccx) (eq? (car g) 'g-rccx-dag)) 0 1)
                  1 0 lat css-round links (list-set cwires t `(cwire ,mt ,rt ,lckt ,(anf-xor at (anf-and a1 a2)) ,zt)) ok?)]
         [(or `(g-hmr-cz ,t ,c1 ,c2 ,_) `(g-hmr-cz ,t ,c1 ,c2))
          (match-define `(cwire ,mt ,rt ,lckt ,at ,zt) (list-ref cwires t))
