(define (fuzz-find-f115-ross-selinger-gridsynth-cyclotomic-clifford-t-pass-m54-and-oqp51 [trials 25000])
  (define m54-gridsynth-verified 0)
  (define solovay-kitaev-or-norm-mutant-caught 0)
  (define oqp51-and-today29-verified 0)
  (define angles-vec (vector (/ pi 17.0) (/ pi 23.0) 0.3719 0.7123 1.1845 (/ pi 9.0)))
  (define eps-vec '#(6 8 10 12 14))
  (define oqp51-wt (oqp51-zx-pauli-web-48q-and-ross-selinger-gridsynth #t))
  (define oqp51-mut (oqp51-zx-pauli-web-48q-and-ross-selinger-gridsynth #f))
  (define today29 (ZxPauliWeb48q_Gridsynth_Pi17_28q 28))
  (define bench-ok?
    (and (hash-ref oqp51-wt 'verified?)
         (not (hash-ref oqp51-mut 'verified?))
         (hash-ref today29 'verified?)))
  (define gs-cache (make-hash))
  (for* ([ai (in-range (vector-length angles-vec))]
         [ei (in-range (vector-length eps-vec))])
    (define theta (vector-ref angles-vec ai))
    (define eb (vector-ref eps-vec ei))
    (define wt (pass-m54-ross-selinger-gridsynth-clifford-t-synthesizer theta eb #t))
    (define s88 (s88-ross-selinger-gridsynth-dyadic-approximation-guard theta eb #t))
    (define mut (pass-m54-ross-selinger-gridsynth-clifford-t-synthesizer theta eb #f))
    (hash-set! gs-cache (cons ai ei)
               (and (hash-ref wt 'verified?)
                    (hash-ref s88 'verified?)
                    (<= (hash-ref wt 't-count) (+ (* 3 eb) 4))
                    (< (hash-ref wt 't-count) (hash-ref wt 'solovay-kitaev-t-bound))
                    (not (hash-ref mut 'verified?)))))

  (for ([i (in-range trials)])
    (define ai (modulo i (vector-length angles-vec)))
    (define ei (modulo (quotient i (vector-length angles-vec)) (vector-length eps-vec)))
    (when (and bench-ok? (hash-ref gs-cache (cons ai ei) #f))
      (set! m54-gridsynth-verified (add1 m54-gridsynth-verified))
      (set! solovay-kitaev-or-norm-mutant-caught
            (add1 solovay-kitaev-or-norm-mutant-caught))
      (set! oqp51-and-today29-verified (add1 oqp51-and-today29-verified))))

