    (when (and catalog46-ok?
               (hash-ref entry 'verified?)
               (hash-ref entry 'translation-validated?)
               (hash-ref entry 'irreducible-optimal?))
      (set! oqp1-to-46-optimal-verified (add1 oqp1-to-46-optimal-verified)))

