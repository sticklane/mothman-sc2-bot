(define (fuzz-find-f85-dummy-qvar0-stub-and-unlowered-metadata-bypass-pass-m35 [trials 25000])
  (define m35-multi-node-lowering-verified 0)
  (define dummy-qvar0-stub-mutant-caught 0)
