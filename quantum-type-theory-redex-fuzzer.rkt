(define all-12-quantum-target-architectures
  '(Heron-R2-156q
    Willow-105q
    Helios-98q
    Dawn-3000q
    Neutral-Atom-Zone-Arch
    Gross-Code-144-12-12
    Tesseract-16-4-4
