    (define m51-mut (pass-m51-distributed-zipper-cut-telegate-rewriter raw 4 #f))
    (vector-set! m51-cache idx
                 (and (hash-ref m51-wt 'verified?)
                      (hash-ref s85-wt 'verified?)
                      (zero? (hash-ref m51-wt 'direct-cross-module-gates))
                      (>= (hash-ref m51-wt 'ebit-bell-pairs) 1)
                      (not (hash-ref m51-mut 'verified?)))))

  (for ([i (in-range trials)])
    (define idx (modulo i 50))
    (when (vector-ref m51-cache idx)
      (set! m51-telegate-epr-verified (add1 m51-telegate-epr-verified))
      (set! direct-cross-module-gate-mutant-caught
            (add1 direct-cross-module-gate-mutant-caught))
      (set! ebit-pair-accounting-verified (add1 ebit-pair-accounting-verified))))

  (hash 'issue-id 'F109-distributed-zipper-cut-telegate-epr-rewriter-pass-m51
        'suite-id 'S85-PassM51-Distributed-Zipper-Cut-TeleGate-EPR-Rewriter
        'trials trials
        'm51-telegate-epr-verified m51-telegate-epr-verified
        'direct-cross-module-gate-mutant-caught direct-cross-module-gate-mutant-caught
