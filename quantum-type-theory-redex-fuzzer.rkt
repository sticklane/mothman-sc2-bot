    (define code-d (+ 3 (* 2 (bitwise-and h 3)))) ;; d in {3, 5, 7, 9}
    (define var-idx (bitwise-and (arithmetic-shift h -2) 2047))

    ;; 1. S49 & OQP-29 route dynamic code deformation to 273ns GARI FPGA (and static to 240ns ASIC)!
    (define s49-dyn (s49-fixed-asic-240ns-code-deformation-guard #t #t))
    (define s49-stat (s49-fixed-asic-240ns-code-deformation-guard #f #t))
    (when (and (hash-ref s49-dyn 'verified?)
               (eq? (hash-ref s49-dyn 'selected-backend) 'fpga-273ns-gari)
               (= (hash-ref s49-dyn 'latency-ns) 273)
               (hash-ref s49-stat 'verified?)
               (eq? (hash-ref s49-stat 'selected-backend) 'asic-240ns-collision-clustering)
               (= (hash-ref s49-stat 'latency-ns) 240))
