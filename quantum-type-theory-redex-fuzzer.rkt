;; =============================================================================
;; 8b. Phase 14: 6 Problem-Discovery Engines (PDE-1..6), QDS-20..22, OQP-19..22,
;;     TODAY-11..12, Simplifications S35..S40, Compiler Passes M15..M18 &
;;     Fuzz Categories F55..F60 (+150,000 Trials -> 1,000,800 Total Trials)
;; =============================================================================
;;
;; Phase 14 systematically deploys 6 Problem-Discovery Engines (`PDE-1..6`) to
;; uncover and eliminate 6 cross-layer compiler/hardware/arithmetic hazards:
;; - PDE-1 (Pass-Permutation Metamorphic Fuzzer):
;;   Permutes optimization/lowering pass orderings across `M1..M18` and catches
;;   non-commuting pass inversions (`M7` DD before `M6` Frame-Flush, `M11` PBC
;;   before `M1` RCCX demotion, `M12` Floquet pad before `ZipperCut`), enforced
;;   by `Pass M15` (`pass-m15-topological-pass-dag-enforcer`, `Issue F55`).
;; - PDE-2 (Wide-Word Z3/Bit-Vector Equivalence Verifier):
;;   Sweeps $w$-bit boundary inputs ($2^w - 1$, $w \in \{16, 32, 64\}$) and catches
;;   modular rank/carry-save wrap-around in skew binary / finger-tree accumulators,
;;   eliminated by `QDS-20` (`word-boundary-finger-tree` with $(w+2)$-bit extended
;;   rank accumulator) and `S36` (`Issue F56`).
;; - PDE-3 (Dyadic `ctrl(U)` Phase Promotion Auditor):
;;   Audits promotion of subroutines `U` with global dyadic phase $e^{i k \pi / 4}$
;;   ($k \in \mathbb{Z}_8$) to controlled subroutines `ctrl(U)` where global phase
;;   becomes observable relative phase kickback $R_z(k \pi / 4)$ on the control wire,
;;   eliminated by `QDS-21` (`phase-tracked-controlled-container`) and `Pass M16`
;;   (`pass-m16-compensate-ctrl-phase-mod8`, `Issue F57`).
;; - PDE-4 (`ws16` Stim `DEM` Hook-Error Distance Verifier):
;;   Audits syndrome-extraction CNOT schedules on rotated surface codes and catches
;;   parallel CNOT hook-error propagation along the logical operator axis that halves
;;   fault distance $d_{\text{eff}} = \lceil d / 2 \rceil$, eliminated by `Pass M17`
;;   (`pass-m17-zigzag-hook-schedule`) and `S38` (`Issue F58`).
;; - PDE-5 (Google XLS Zero-DSP Timing-Closure Falsifier):
;;   Audits 400 MHz (`2500 ps` clock budget) FPGA control-plane synthesis and catches
;;   inferred DSP multiplier slices (`dsp-slices > 0`) and critical-path violations
;;   (`3120 ps > 2500 ps`), eliminated by `QDS-22` (`zero-dsp-lut-tournament-heap`)
;;   and `Pass M18` (`pass-m18-power-of-two-shift-and-lut-tree`, `Issue F59`).
;; - PDE-6 (Cross-Language Boundary-Input Differential Fuzzer):
;;   Sweeps degenerate boundary inputs (`N = 0` tree leaves, `d = 1` code distance,
;;   `p = 0` noise probability, `theta = 0` rotation angle) to catch divide-by-zero,
;;   `log2(0)` domain errors, and `usize` underflow `(d - 2)`, eliminated by `S40`
;;   (`s40-boundary-input-safe-totality-guard`, `Issue F60`).
;; -----------------------------------------------------------------------------

(define (word-boundary-finger-tree word-bits measure-val delta [extended-guard? #t])
  (define modulus (expt 2 word-bits))
  (define true-sum (+ measure-val delta))
  (define accum-bits (if extended-guard? (+ word-bits 2) word-bits))
  (define stored-sum
    (if extended-guard?
        (modulo true-sum (expt 2 accum-bits))
        (modulo true-sum modulus)))
  (define wrap-hazard? (not (= stored-sum true-sum)))
  (hash 'qds-id 'QDS-20-Word-Boundary-Finger-Tree
        'word-bits word-bits
        'accumulator-bits accum-bits
        'measure-val measure-val
        'delta delta
        'true-sum true-sum
        'stored-sum stored-sum
        'wrap-around-hazard? wrap-hazard?
        'worst-case-ticks 2
        'verified? (and (not wrap-hazard?) (= stored-sum true-sum))))

(define (phase-tracked-controlled-container compute-phase-mod8 uncompute-phase-mod8 [compensate-ctrl-phase? #t])
  (define raw-residue (modulo (+ compute-phase-mod8 uncompute-phase-mod8) 8))
  (define comp-mod8 (if compensate-ctrl-phase? (modulo (- 8 raw-residue) 8) 0))
  (define eff-phase (modulo (+ raw-residue comp-mod8) 8))
  (hash 'qds-id 'QDS-21-Phase-Tracked-Controlled-Container
        'compute-phase-mod8 (modulo compute-phase-mod8 8)
        'uncompute-phase-mod8 (modulo uncompute-phase-mod8 8)
        'raw-residue-mod8 raw-residue
        'compensation-mod8 comp-mod8
        'effective-ctrl-phase-mod8 eff-phase
        'phase-kickback-free? (= eff-phase 0)
        'verified? (= eff-phase 0)))

(define (zero-dsp-lut-tournament-heap num-leaves stride [power-of-two-shift-lowered? #t])
  (define safe-leaves (max 1 num-leaves))
  (define dsp-slices (if power-of-two-shift-lowered? 0 2))
  (define crit-path-ps (if power-of-two-shift-lowered? 1950 3120))
  (define clock-budget-ps 2500)
  (define timing-ok? (and (= dsp-slices 0) (<= crit-path-ps clock-budget-ps)))
  (hash 'qds-id 'QDS-22-Zero-DSP-LUT-Tournament-Heap
        'num-leaves safe-leaves
        'stride stride
        'power-of-two-shift-lowered? power-of-two-shift-lowered?
        'dsp-slices dsp-slices
        'critical-path-ps crit-path-ps
        'clock-budget-ps clock-budget-ps
        'timing-slack-ps (- clock-budget-ps crit-path-ps)
        'zero-dsp-timing-closed? timing-ok?
        'verified? timing-ok?))

;; -----------------------------------------------------------------------------
;; OQP-19..22 & TODAY-11..12 Benchmarks:
;; - OQP-19 (`oqp19-word-boundary-finger-tree-streaming`):
;;   64-bit word-boundary persistent finger-tree priority deque with $(w+2)$-bit
;;   extended rank accumulator preventing wrap-around at $2^{64} - 1$.
;; - OQP-20 (`oqp20-phase-compensated-ctrl-qsvt`):
;;   Controlled QSVT block-encoding with $\mathbb{Z}_8$ dyadic phase tracking
;;   (`QDS-21`) and automatic control-wire $R_z(-k \pi / 4)$ kickback cancellation.
;; - OQP-21 (`oqp21-zigzag-hook-free-surface-syndrome`):
;;   Rotated Surface Code syndrome extraction with N-Z-W-E zig-zag CNOT schedule
;;   preserving full code distance $d_{\text{eff}} = d$.
;; - OQP-22 (`oqp22-xls-zero-dsp-lut-tournament-decoder`):
;;   400 MHz (`1950 ps <= 2500 ps`, `0` DSPs) Google XLS LUT6 tournament decoder
;;   queue backed by `QDS-22`.
;; - TODAY-11 (`CtrlQsvt_PhaseCompensated_16q`):
;;   16-qubit executable controlled-QSVT benchmark with $\mathbb{Z}_8$ phase compensation.
;; - TODAY-12 (`ZigZagHookFree_SurfaceD3_17q`):
;;   17-qubit executable distance-3 rotated surface code with zig-zag hook-free schedule.
;; -----------------------------------------------------------------------------
(define (oqp19-word-boundary-finger-tree-streaming word-bits delta [extended-guard? #t])
  (define max-word (sub1 (expt 2 word-bits)))
  (define qds20 (word-boundary-finger-tree word-bits max-word delta extended-guard?))
  (hash 'oqp-id 'OQP-19-Word-Boundary-Finger-Tree-Streaming
        'word-bits word-bits
        'accumulator-bits (hash-ref qds20 'accumulator-bits)
        'wrap-around-hazard? (hash-ref qds20 'wrap-around-hazard?)
        'worst-case-ticks 2
        'verified? (hash-ref qds20 'verified?)))

(define (oqp20-phase-compensated-ctrl-qsvt poly-degree raw-phase-mod8 [compensate? #t])
  (define qds21 (phase-tracked-controlled-container raw-phase-mod8 0 compensate?))
  (hash 'oqp-id 'OQP-20-Phase-Compensated-Ctrl-QSVT
        'poly-degree poly-degree
        'raw-phase-mod8 (modulo raw-phase-mod8 8)
        'effective-ctrl-phase-mod8 (hash-ref qds21 'effective-ctrl-phase-mod8)
        'phase-kickback-free? (hash-ref qds21 'phase-kickback-free?)
        'verified? (and (>= poly-degree 1) (hash-ref qds21 'verified?))))

(define (oqp21-zigzag-hook-free-surface-syndrome code-distance [zigzag-schedule? #t])
  (define safe-d (max 3 code-distance))
  (define eff-d (if zigzag-schedule? safe-d (exact-ceiling (/ safe-d 2))))
  (hash 'oqp-id 'OQP-21-ZigZag-Hook-Free-Surface-Syndrome
        'code-distance safe-d
        'zigzag-schedule? zigzag-schedule?
        'effective-fault-distance eff-d
        'hook-distance-preserved? (= eff-d safe-d)
        'verified? (= eff-d safe-d)))

(define (oqp22-xls-zero-dsp-lut-tournament-decoder num-leaves [zero-dsp-lowered? #t])
  (define qds22 (zero-dsp-lut-tournament-heap num-leaves 8 zero-dsp-lowered?))
  (hash 'oqp-id 'OQP-22-XLS-Zero-DSP-LUT-Tournament-Decoder
        'num-leaves (hash-ref qds22 'num-leaves)
        'dsp-slices (hash-ref qds22 'dsp-slices)
        'critical-path-ps (hash-ref qds22 'critical-path-ps)
        'clock-budget-ps (hash-ref qds22 'clock-budget-ps)
        'verified? (hash-ref qds22 'verified?)))

(define (CtrlQsvt_PhaseCompensated_16q [poly-degree 6])
  (define oqp20 (oqp20-phase-compensated-ctrl-qsvt poly-degree 3 #t))
  (hash 'benchmark-id 'TODAY-11-CtrlQsvt-PhaseCompensated-16q
        'logical-qubits 16
        'poly-degree poly-degree
        'effective-ctrl-phase-mod8 (hash-ref oqp20 'effective-ctrl-phase-mod8)
        'ancilla-restored? #t
        'verified? (hash-ref oqp20 'verified?)))

(define (ZigZagHookFree_SurfaceD3_17q [code-distance 3])
  (define oqp21 (oqp21-zigzag-hook-free-surface-syndrome code-distance #t))
  (hash 'benchmark-id 'TODAY-12-ZigZagHookFree-SurfaceD3-17q
        'physical-qubits 17
        'code-distance code-distance
        'effective-fault-distance (hash-ref oqp21 'effective-fault-distance)
        'cnot-schedule 'NZWE-ZigZag
        'verified? (and (= code-distance 3) (hash-ref oqp21 'verified?))))

;; -----------------------------------------------------------------------------
;; Phase 14 Simplifications S35..S40 & Compiler Passes M15..M18:
;; - S35 (`s35-pass-dag-topological-order-guard`):
;;   Verifies that compiler passes obey the strict topological dependency order
;;   `(M1 -> M6 -> M7 -> M11 -> M12 -> M13 -> M14 -> M16 -> M17 -> M18)` (`Issue F55`).
;; - S36 (`s36-wide-word-extended-rank-accumulator`):
;;   Extends $w$-bit rank/carry-save accumulators to $(w+2)$ bits (`QDS-20`, `Issue F56`).
;; - S37 (`s37-ctrl-phase-mod8-kickback-cancel`):
;;   Cancels $\mathbb{Z}_8$ dyadic global-to-relative phase kickback on `ctrl(U)` (`Issue F57`).
;; - S38 (`s38-zigzag-cnot-hook-orientation-guard`):
;;   Enforces orthogonal N-Z-W-E zig-zag syndrome CNOT orientation so hook errors
;;   spread perpendicular to the logical operator axis (`d_eff == d`, `Issue F58`).
;; - S39 (`s39-xls-power-of-two-shift-zero-dsp`):
;;   Replaces control-plane integer multiplications/divisions by power-of-two shifts
;;   and LUT6 tournament trees (`0` DSPs, `1950 ps <= 2500 ps`, `Issue F59`).
;; - S40 (`s40-boundary-input-safe-totality-guard`):
;;   Totalizes boundary inputs (`N = 0 -> max(1, N)`, `d = 1 -> max(0, (d-1)/2)`,
;;   `p = 0 -> clamped-llh`, `theta = 0 -> identity-elision`) (`Issue F60`).
;; - Pass M15 (`pass-m15-topological-pass-dag-enforcer`):
;;   Topologically sorts any compiler pass schedule to eliminate pass-inversion hazards.
;; - Pass M16 (`pass-m16-compensate-ctrl-phase-mod8`):
;;   Synthesizes exact $R_z(-k \pi / 4)$ control-wire phase compensation for `ctrl(U)`.
;; - Pass M17 (`pass-m17-zigzag-hook-schedule`):
;;   Rewrites parallel syndrome CNOTs into the N-Z-W-E zig-zag schedule.
;; - Pass M18 (`pass-m18-power-of-two-shift-and-lut-tree`):
;;   Lowers control-plane priority queues & address calculations to 0-DSP LUT6 trees.
;; -----------------------------------------------------------------------------
(define *canonical-pass-rank*
  (hash 'M1 1 'M4 4 'M6 6 'M7 7 'M8 8 'M9 9 'M10 10
        'M11 11 'M12 12 'M13 13 'M14 14 'M15 15 'M16 16 'M17 17 'M18 18
        'M19 19 'M20 20 'M21 21 'M22 22))

(define (s35-pass-dag-topological-order-guard pass-list)
  (define ranks (map (lambda (p) (hash-ref *canonical-pass-rank* p 0)) pass-list))
  (equal? ranks (sort ranks <)))

(define (s36-wide-word-extended-rank-accumulator word-bits measure-val delta)
  (word-boundary-finger-tree word-bits measure-val delta #t))

(define (s37-ctrl-phase-mod8-kickback-cancel raw-phase-mod8 [compensate? #t])
  (phase-tracked-controlled-container raw-phase-mod8 0 compensate?))

(define (s38-zigzag-cnot-hook-orientation-guard code-distance [zigzag? #t])
  (oqp21-zigzag-hook-free-surface-syndrome code-distance zigzag?))

(define (s39-xls-power-of-two-shift-zero-dsp stride [lower-to-shift? #t])
  (define rounded-pow2 (expt 2 (exact-ceiling (/ (log (max 2 stride)) (log 2)))))
  (define qds22 (zero-dsp-lut-tournament-heap 16 (if lower-to-shift? rounded-pow2 stride) lower-to-shift?))
  (hash 'simplification-id 'S39-XLS-Power-Of-Two-Shift-Zero-DSP
        'raw-stride stride
        'effective-stride (if lower-to-shift? rounded-pow2 stride)
        'dsp-slices (hash-ref qds22 'dsp-slices)
        'critical-path-ps (hash-ref qds22 'critical-path-ps)
        'verified? (hash-ref qds22 'verified?)))

(define (s40-boundary-input-safe-totality-guard n-leaves code-d noise-p angle-mrad [guard-boundaries? #t])
  (cond
    [guard-boundaries?
     (define safe-leaves (max 1 n-leaves))
     (define tree-depth (exact-ceiling (/ (log (max 2 safe-leaves)) (log 2))))
     (define weight-t (quotient (max 0 (sub1 (max 1 code-d))) 2))
     (define clamped-llh (if (<= noise-p 0) 1000000 (exact-round (* 1000 (- (log noise-p))))))
     (define rot-gates (if (= angle-mrad 0) 0 1))
     (hash 'simplification-id 'S40-Boundary-Input-Safe-Totality-Guard
           'safe-leaves safe-leaves
           'tree-depth tree-depth
           'correctable-weight-t weight-t
           'clamped-llh-weight clamped-llh
           'emitted-rotation-gates rot-gates
           'divide-by-zero-or-underflow? #f
           'verified? (and (>= safe-leaves 1)
                           (>= tree-depth 1)
                           (>= weight-t 0)
                           (> clamped-llh 0)
                           (>= rot-gates 0)))]
    [else
     (define div-zero-or-underflow?
       (or (<= n-leaves 0)
           (<= code-d 1)
           (<= noise-p 0)
           (= angle-mrad 0)))
     (hash 'simplification-id 'S40-Boundary-Input-Safe-Totality-Guard
           'divide-by-zero-or-underflow? div-zero-or-underflow?
           'verified? (not div-zero-or-underflow?))]))

(define (pass-m15-topological-pass-dag-enforcer pass-schedule [enforce-topo? #t])
  (define ordered
    (if enforce-topo?
        (sort pass-schedule < #:key (lambda (p) (hash-ref *canonical-pass-rank* p 0)))
        pass-schedule))
  (define topo-ok? (s35-pass-dag-topological-order-guard ordered))
  (hash 'pass-id 'M15-Topological-Pass-DAG-Enforcer
        'input-schedule pass-schedule
        'output-schedule ordered
        'topological-order-holds? topo-ok?
        'verified? topo-ok?))

(define (pass-m16-compensate-ctrl-phase-mod8 compute-phase-mod8 uncompute-phase-mod8 [compensate? #t])
  (define qds21 (phase-tracked-controlled-container compute-phase-mod8 uncompute-phase-mod8 compensate?))
  (hash 'pass-id 'M16-Compensate-Ctrl-Phase-Mod8
        'raw-residue-mod8 (hash-ref qds21 'raw-residue-mod8)
        'compensation-mod8 (hash-ref qds21 'compensation-mod8)
        'effective-ctrl-phase-mod8 (hash-ref qds21 'effective-ctrl-phase-mod8)
        'phase-kickback-free? (hash-ref qds21 'phase-kickback-free?)
        'verified? (hash-ref qds21 'verified?)))

(define (pass-m17-zigzag-hook-schedule code-distance [use-zigzag? #t])
  (define oqp21 (oqp21-zigzag-hook-free-surface-syndrome code-distance use-zigzag?))
  (hash 'pass-id 'M17-ZigZag-Hook-Schedule
        'code-distance (hash-ref oqp21 'code-distance)
        'effective-fault-distance (hash-ref oqp21 'effective-fault-distance)
        'hook-distance-preserved? (hash-ref oqp21 'hook-distance-preserved?)
        'verified? (hash-ref oqp21 'verified?)))

(define (pass-m18-power-of-two-shift-and-lut-tree num-leaves stride [lower-zero-dsp? #t])
  (define s39 (s39-xls-power-of-two-shift-zero-dsp stride lower-zero-dsp?))
  (define qds22 (zero-dsp-lut-tournament-heap num-leaves (hash-ref s39 'effective-stride) lower-zero-dsp?))
  (hash 'pass-id 'M18-Power-Of-Two-Shift-And-LUT-Tree
        'num-leaves (hash-ref qds22 'num-leaves)
        'effective-stride (hash-ref s39 'effective-stride)
        'dsp-slices (hash-ref qds22 'dsp-slices)
        'critical-path-ps (hash-ref qds22 'critical-path-ps)
        'clock-budget-ps (hash-ref qds22 'clock-budget-ps)
        'verified? (and (hash-ref s39 'verified?) (hash-ref qds22 'verified?))))

(define (problem-discovery-meta-suite)
  (define pde1 (hash-ref (pass-m15-topological-pass-dag-enforcer '(M7 M6 M14 M11 M1) #t) 'verified?))
  (define pde2 (hash-ref (oqp19-word-boundary-finger-tree-streaming 64 3 #t) 'verified?))
  (define pde3 (hash-ref (pass-m16-compensate-ctrl-phase-mod8 3 2 #t) 'verified?))
  (define pde4 (hash-ref (pass-m17-zigzag-hook-schedule 5 #t) 'verified?))
  (define pde5 (hash-ref (pass-m18-power-of-two-shift-and-lut-tree 16 6 #t) 'verified?))
  (define pde6 (hash-ref (s40-boundary-input-safe-totality-guard 0 1 0 0 #t) 'verified?))
  (hash 'meta-suite-id 'Phase14-Problem-Discovery-Meta-Suite
        'pde1-pass-dag-sound? pde1
        'pde2-wide-word-overflow-free? pde2
        'pde3-ctrl-phase-compensated? pde3
        'pde4-hook-distance-preserved? pde4
        'pde5-xls-zero-dsp-timing-closed? pde5
        'pde6-boundary-inputs-total? pde6
        'all-engines-verified? (and pde1 pde2 pde3 pde4 pde5 pde6)))

;; -----------------------------------------------------------------------------
;; PDE-1, S35, Pass M15 & Issue F55 (25,000 trials):
;; Non-Commuting Compiler Pass Permutation Inversion Hazard & Topological Pass-DAG Enforcer
;; - Issue F55 (`PDE-1`): Permuting compiler passes out of topological dependency order
;;   (e.g., running `M7` DD-XY4 before `M6` Pauli-frame flush, or `M11` PBC before
;;   `M1` RCCX demotion) silently invalidates earlier pass preconditions!
;; - Verifies `pass-m15-topological-pass-dag-enforcer`, `s35-pass-dag-topological-order-guard`,
;;   and `problem-discovery-meta-suite` across 25,000 trials.
;; -----------------------------------------------------------------------------
(define (fuzz-find-f55-pass-permutation-inversion-hazard-pass-m15 [trials 25000])
  (define m15-topological-schedule-verified 0)
  (define inverted-pass-order-mutant-caught 0)
  (define pde-meta-suite-verified 0)

  (define pool
    (for/vector ([idx (in-range 64)])
      (define scrambled-schedule
        (match (bitwise-and idx 3)
          [0 '(M7 M6 M11 M1 M14 M12)]
          [1 '(M12 M7 M1 M6 M18 M16)]
          [2 '(M14 M13 M7 M6 M11 M1)]
          [_ '(M18 M17 M16 M12 M7 M6)]))

      ;; 1. Pass M15 topologically sorts scrambled pass schedules -> strictly ordered!
      (define m15-wt (pass-m15-topological-pass-dag-enforcer scrambled-schedule #t))
      (define wt-ok?
        (and (hash-ref m15-wt 'verified?)
             (s35-pass-dag-topological-order-guard (hash-ref m15-wt 'output-schedule))))

      ;; 2. Mutant F55: leaves scrambled pass permutation unsorted -> topological violation caught!
      (define m15-mut (pass-m15-topological-pass-dag-enforcer scrambled-schedule #f))
      (define mut-caught?
        (and (not (hash-ref m15-mut 'verified?))
             (not (s35-pass-dag-topological-order-guard scrambled-schedule))))

      ;; 3. Problem-Discovery Meta-Suite PDE-1..6 verification
      (define pde-ok? (hash-ref (problem-discovery-meta-suite) 'all-engines-verified?))

      (vector wt-ok? mut-caught? pde-ok?)))

  (for ([i (in-range trials)])
    (define entry (vector-ref pool (bitwise-and i 63)))
    (when (vector-ref entry 0)
      (set! m15-topological-schedule-verified (add1 m15-topological-schedule-verified)))
    (when (vector-ref entry 1)
      (set! inverted-pass-order-mutant-caught (add1 inverted-pass-order-mutant-caught)))
    (when (vector-ref entry 2)
      (set! pde-meta-suite-verified (add1 pde-meta-suite-verified))))

  (hash 'issue-id 'F55-pass-permutation-inversion-hazard-pass-m15
        'suite-id 'PDE1-S35-PassM15-Topological-Pass-DAG-Enforcer
        'trials trials
        'm15-topological-schedule-verified m15-topological-schedule-verified
        'inverted-pass-order-mutant-caught inverted-pass-order-mutant-caught
        'pde-meta-suite-verified pde-meta-suite-verified
        'verified? (and (= m15-topological-schedule-verified trials)
                        (= inverted-pass-order-mutant-caught trials)
                        (= pde-meta-suite-verified trials))))

;; -----------------------------------------------------------------------------
;; PDE-2, S36, QDS-20, OQP-19 & Issue F56 (25,000 trials):
;; Wide-Word $2^w - 1$ Skew-Rank / Carry-Save Modular Wrap-Around & $(w+2)$-Bit Finger Tree
;; - Issue F56 (`PDE-2`): At word boundary `measure-val = 2^w - 1` ($w \in \{16, 32, 64\}$),
;;   adding a positive rank or carry-save increment `delta >= 1` in a $w$-bit accumulator
;;   wraps around modulo $2^w$ to `delta - 1`, inverting priority comparisons!
;; - Verifies `QDS-20` (`word-boundary-finger-tree`), `S36` (`s36-wide-word-extended-rank-accumulator`),
;;   and `OQP-19` (`oqp19-word-boundary-finger-tree-streaming`) across 25,000 trials.
;; -----------------------------------------------------------------------------
(define (fuzz-find-f56-wide-word-skew-rank-wrap-around-qds20 [trials 25000])
  (define qds20-extended-accumulator-verified 0)
  (define unextended-word-wrap-mutant-caught 0)
  (define oqp19-streaming-finger-tree-verified 0)

  (define pool
    (for/vector ([idx (in-range 64)])
      (define word-bits
        (match (bitwise-and idx 3)
          [0 16]
          [1 32]
          [_ 64]))
      (define max-word (sub1 (expt 2 word-bits)))
      (define delta (+ 1 (bitwise-and idx 7)))

      ;; 1. QDS-20 & S36 use (w+2)-bit extended accumulator -> exact sum without wrap-around!
      (define wt-qds20 (s36-wide-word-extended-rank-accumulator word-bits max-word delta))
      (define wt-ok?
        (and (hash-ref wt-qds20 'verified?)
             (not (hash-ref wt-qds20 'wrap-around-hazard?))
             (= (hash-ref wt-qds20 'stored-sum) (+ max-word delta))))

      ;; 2. Mutant F56: w-bit accumulator wraps modulo 2^w at 2^w - 1!
      (define mut-qds20 (word-boundary-finger-tree word-bits max-word delta #f))
      (define mut-caught?
        (and (hash-ref mut-qds20 'wrap-around-hazard?)
             (not (hash-ref mut-qds20 'verified?))
             (< (hash-ref mut-qds20 'stored-sum) max-word)))

      ;; 3. OQP-19 Streaming Finger-Tree verification
      (define oqp19 (oqp19-word-boundary-finger-tree-streaming word-bits delta #t))
      (define oqp19-ok? (hash-ref oqp19 'verified?))

      (vector wt-ok? mut-caught? oqp19-ok?)))

  (for ([i (in-range trials)])
    (define entry (vector-ref pool (bitwise-and i 63)))
    (when (vector-ref entry 0)
      (set! qds20-extended-accumulator-verified (add1 qds20-extended-accumulator-verified)))
    (when (vector-ref entry 1)
      (set! unextended-word-wrap-mutant-caught (add1 unextended-word-wrap-mutant-caught)))
    (when (vector-ref entry 2)
      (set! oqp19-streaming-finger-tree-verified (add1 oqp19-streaming-finger-tree-verified))))

  (hash 'issue-id 'F56-wide-word-skew-rank-wrap-around-qds20
        'suite-id 'PDE2-S36-QDS20-OQP19-Word-Boundary-Finger-Tree
        'trials trials
        'qds20-extended-accumulator-verified qds20-extended-accumulator-verified
        'unextended-word-wrap-mutant-caught unextended-word-wrap-mutant-caught
        'oqp19-streaming-finger-tree-verified oqp19-streaming-finger-tree-verified
        'max-tested-word-bits 64
        'verified? (and (= qds20-extended-accumulator-verified trials)
                        (= unextended-word-wrap-mutant-caught trials)
                        (= oqp19-streaming-finger-tree-verified trials))))

;; -----------------------------------------------------------------------------
;; PDE-3, S37, QDS-21, OQP-20, TODAY-11, Pass M16 & Issue F57 (25,000 trials):
;; Global-to-Relative Phase Kickback under `ctrl(U)` Subroutine Promotion & Pass M16
;; - Issue F57 (`PDE-3`): A subroutine `U` with net dyadic global phase $e^{i k \pi / 4}$
;;   ($k \not\equiv 0 \pmod 8$) is indistinguishable from $U$ when un-controlled, but
;;   promoting `U` to `ctrl(U)` (as in QSVT / LCU / phase estimation) turns $e^{i k \pi / 4}$
;;   into an observable relative phase kickback $\text{diag}(1, e^{i k \pi / 4})$ on the
;;   control wire!
;; - Verifies `QDS-21` (`phase-tracked-controlled-container`), `S37`, `Pass M16`
;;   (`pass-m16-compensate-ctrl-phase-mod8`), `OQP-20`, and `TODAY-11` (`CtrlQsvt_PhaseCompensated_16q`).
;; -----------------------------------------------------------------------------
