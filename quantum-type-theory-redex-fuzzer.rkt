;; =============================================================================
;; 2. Symbolic Boolean Polynomial / Algebraic Normal Form (ANF) Engine over F_2
;;    Powers Refinements 4 & 5 and Fuzz Fixes F1..F8 & Simplifications S1..S3
;; =============================================================================

;; Normalize a monomial (list of wire indices): sort and deduplicate (since x_i^2 = x_i in F_2)
(define (mono-normalize m)
  (sort (remove-duplicates m =) <))

(define (mono<? m1 m2)
  (cond
    [(< (length m1) (length m2)) #t]
    [(> (length m1) (length m2)) #f]
    [else
     (let loop ([a m1] [b m2])
       (cond
         [(null? a) #f]
         [(< (car a) (car b)) #t]
         [(> (car a) (car b)) #f]
         [else (loop (cdr a) (cdr b))]))]))

;; Normalize an ANF polynomial (list of monomials) over F_2:
;; identical monomials cancel mod 2 (m xor m = 0)!
(define (anf-normalize poly)
  (define norm-monos (map mono-normalize poly))
  (define sorted (sort norm-monos mono<?))
  (let loop ([rem sorted] [acc '()])
    (match rem
      ['() (reverse acc)]
      [(list m) (reverse (cons m acc))]
      [(list* m1 m2 rest)
       (if (equal? m1 m2)
           (loop rest acc) ;; cancel mod 2!
           (loop (cons m2 rest) (cons m1 acc)))])))

;; Addition in F_2[x_1..x_n] (XOR of ANF polynomials)
(define (anf-xor p1 p2)
  (anf-normalize (append p1 p2)))

;; Multiplication in F_2[x_1..x_n] (distributive AND of ANF polynomials)
(define (anf-and p1 p2)
  (anf-normalize
   (for*/list ([m1 (in-list p1)]
               [m2 (in-list p2)])
     (mono-normalize (append m1 m2)))))

;; Algebraic degree of an ANF polynomial over F_2 (0 for constant 0 or 1)
(define (anf-degree poly)
  (define norm (anf-normalize poly))
  (if (null? norm)
      0
      (apply max (map length norm))))

;; Evaluate an ANF polynomial on a concrete bit assignment vector (vals : list of 0/1)
(define (anf-eval poly vals)
  (define norm (anf-normalize poly))
  (for/fold ([acc 0]) ([m (in-list norm)])
    (define mono-val
      (for/fold ([mv 1]) ([w (in-list m)])
        (if (< w (length vals))
            (bitwise-and mv (list-ref vals w))
            0)))
    (bitwise-xor acc mono-val)))

;; Initial identity ANF basis: wire i starts as polynomial ((i)) = x_i,
;; except clean ancilla wires which start as () = 0.
(define (initial-anf-env num-wires clean-wires)
  (for/list ([i (in-range num-wires)])
    (if (member i clean-wires)
        '()
        (list (list i)))))

;; Symbolic delta Δ_w(x) = anf_w(x) xor initial_anf_w(x) in F_2[x_1..x_n]
(define (compute-anf-deltas cur-anfs init-anfs)
  (map anf-xor cur-anfs init-anfs))

;; Virtual monomial tags for exact stabilizer/superposition/cat-link/carry-save operational semantics
;; inside ANFPoly (using natural number indices >= 100 so WireState grammar is preserved):
(define (superpos-mono w)     (list (+ 100 w)))
(define (xphase-mono w)       (list (+ 200 w)))
(define (catlink-mono c t)    (list (+ 300 (* 10 c) t)))
(define (hmr-fault-mono w)    (list (+ 400 w)))
(define (redundant-cs-mono w) (list (+ 500 w)))

(define (poly-has-mono? poly m)
  (not (not (member m (anf-normalize poly)))))

(define (wire-in-superpos? anfs w)
  (poly-has-mono? (list-ref anfs w) (superpos-mono w)))

(define (wire-has-xphase? anfs w)
  (poly-has-mono? (list-ref anfs w) (xphase-mono w)))

(define (wire-has-redundant-cs? anfs w)
  (poly-has-mono? (list-ref anfs w) (redundant-cs-mono w)))

(define (wire-has-catlink? anfs w)
  (for/or ([m (in-list (anf-normalize (list-ref anfs w)))])
    (and (= (length m) 1)
         (<= 300 (car m) 399)
         (let ([code (- (car m) 300)])
           (or (= (quotient code 10) w)
               (= (remainder code 10) w))))))

(define (any-wire-has-catlink-endpoint? anfs w)
  (for/or ([poly (in-list anfs)])
    (for/or ([m (in-list (anf-normalize poly))])
      (and (= (length m) 1)
           (<= 300 (car m) 399)
           (let ([code (- (car m) 300)])
              (or (= (quotient code 10) w)
                  (= (remainder code 10) w)))))))

;; Check whether an ANF polynomial contains any non-symbolic fault/superposition/cs/catlink tag >= 100
(define (poly-has-virtual-tag? poly)
  (for/or ([m (in-list (anf-normalize poly))])
    (for/or ([idx (in-list m)])
      (>= idx 100))))

;; Fault monomials for symbolic fault variables e_0 (var 4) and e_1 (var 5)
(define (fault-var-idx k) (+ 4 (modulo k 2)))
(define (fault-var-mono k) (list (fault-var-idx k)))

(define (poly-depends-on-var? poly v)
  (for/or ([m (in-list (anf-normalize poly))])
    (member v m)))

(define anf-depends-on-var? poly-depends-on-var?)

(define (anf-clear-fault-vars poly)
  (anf-normalize
   (filter (lambda (m)
             (and (not (member 4 m))
                  (not (member 5 m))))
           (anf-normalize poly))))

;; =============================================================================
;; 2b. Racket CS / `decompose-plug` Fast-Path Optimizations (Simplification S14):
;;     - 64-Bit Unboxed Truth-Table Bitboard ANF & Fault-Polynomial Engine
;;       over (x_0, x_1, x_2, x_3, e_0, e_1) in F_2^6 (2^6 = 64 rows)
;;     - Fast 6-Stage Reed-Muller / Binary Mobius Transform (bitboard <-> ANFPoly)
;;     - Structural Hash-Consing (`hc-circuit`) for O(1) eq? sub-AST sharing
;; =============================================================================

(define bb-mask-all #xFFFFFFFFFFFFFFFF)

(define bb-var-Vec
  (vector #xAAAAAAAAAAAAAAAA   ;; var 0: x_0
          #xCCCCCCCCCCCCCCCC   ;; var 1: x_1
          #xF0F0F0F0F0F0F0F0   ;; var 2: x_2
          #xFF00FF00FF00FF00   ;; var 3: x_3
          #xFFFF0000FFFF0000   ;; var 4: e_0 (fault 0)
          #xFFFFFFFF00000000)) ;; var 5: e_1 (fault 1)

(define (bb-var k)
  (if (and (<= 0 k) (< k 6))
      (vector-ref bb-var-Vec k)
      0))

(define (bb-xor a b)
  (bitwise-xor a b))

(define (bb-and a b)
  (bitwise-and a b))

(define (bb-not a)
  (bitwise-xor a bb-mask-all))

(define (bb-cswap mc ma mb)
  (bitwise-ior (bitwise-and (bb-not mc) ma)
               (bitwise-and mc mb)))

;; O(1) formal partial derivative / variable sensitivity test on a 64-bit bitboard:
;; returns #t iff Boolean function `mask` depends on variable k in {0..5}.
(define (bb-depends-on-var? mask k)
  (define shift (arithmetic-shift 1 k))
  (define low-mask (bb-not (bb-var k)))
  (not (zero? (bitwise-and low-mask
                           (bitwise-xor mask (arithmetic-shift mask (- shift)))))))

;; Convert symbolic ANFPoly over variables {0..5} to exact 64-bit truth-table bitboard
(define (anf->bitboard poly)
  (for/fold ([acc 0]) ([m (in-list (anf-normalize poly))])
    (if (for/or ([idx (in-list m)]) (>= idx 6))
        acc
        (let ([m-mask
               (for/fold ([mm bb-mask-all]) ([idx (in-list m)])
                 (bitwise-and mm (bb-var idx)))])
          (bitwise-xor acc m-mask)))))

;; 6-stage binary Mobius (Reed-Muller) transform converting a 64-bit truth-table
;; bitboard to its 64-bit ANF monomial-coefficient mask using two 32-bit fixnum
;; halves (lo, hi <= #xFFFFFFFF) so all intermediate shifts stay within 61-bit fixnums:
(define (mobius32 x)
  (let* ([m (bitwise-and x #xFFFFFFFF)]
         [m (bitwise-xor m (arithmetic-shift (bitwise-and m #x55555555) 1))]
         [m (bitwise-xor m (arithmetic-shift (bitwise-and m #x33333333) 2))]
         [m (bitwise-xor m (arithmetic-shift (bitwise-and m #x0F0F0F0F) 4))]
         [m (bitwise-xor m (arithmetic-shift (bitwise-and m #x00FF00FF) 8))]
         [m (bitwise-xor m (arithmetic-shift (bitwise-and m #x0000FFFF) 16))])
    (bitwise-and m #xFFFFFFFF)))

(define (row-idx->monomial r)
  (let loop ([k 0])
    (if (= k 6)
        '()
        (if (bitwise-bit-set? r k)
            (cons k (loop (+ k 1)))
            (loop (+ k 1))))))

(define (bitboard->anf mask)
  (define lo (mobius32 (bitwise-and mask #xFFFFFFFF)))
  (define hi (bitwise-xor (mobius32 (bitwise-and (arithmetic-shift mask -32) #xFFFFFFFF)) lo))
  (anf-normalize
   (let loop ([r 0])
     (cond
       [(= r 64) '()]
       [(< r 32)
        (if (bitwise-bit-set? lo r)
            (cons (row-idx->monomial r) (loop (+ r 1)))
            (loop (+ r 1)))]
       [else
        (if (bitwise-bit-set? hi (- r 32))
            (cons (row-idx->monomial r) (loop (+ r 1)))
            (loop (+ r 1)))]))))


(define (initial-bitboard-env num-wires clean-wires)
  (for/list ([i (in-range num-wires)])
    (if (member i clean-wires)
        0
        (bb-var i))))

;; Fast O(1)-per-gate 64-bit bitboard evaluator for QFree + fault-injection circuits
(define (eval-bitboard-qfree c [init-bbs (initial-bitboard-env 4 '(3))])
  (define (step-bb g bbs)
    (match g
      [`(g-id) bbs]
      [`(g-x ,w)
       (list-update bbs w bb-not)]
      [`(g-z ,_) bbs]
      [`(g-cnot ,c-w ,t-w)
       (define bc (list-ref bbs c-w))
       (list-update bbs t-w (lambda (bt) (bb-xor bt bc)))]
      [`(g-cz ,_ ,_) bbs]
      [(or `(g-ccx ,c1 ,c2 ,t)
           `(g-compute-and ,c1 ,c2 ,t)
           `(g-and-compute ,c1 ,c2 ,t)
           `(g-rccx ,c1 ,c2 ,t)
           `(g-rccx-dag ,c1 ,c2 ,t))
       (define prod (bb-and (list-ref bbs c1) (list-ref bbs c2)))
       (list-update bbs t (lambda (bt) (bb-xor bt prod)))]
      [(or `(g-hmr-cz ,t ,_ ,_ ,_)
           `(g-hmr-cz ,t ,_ ,_))
       (list-set bbs t 0)]
      [`(g-native-ccz ,_ ,_ ,_) bbs]
      [`(g-native-iswap ,q1 ,q2)
       (define b1 (list-ref bbs q1))
       (define b2 (list-ref bbs q2))
       (list-set (list-set bbs q1 b2) q2 b1)]
      [`(g-rzz ,_ ,_ ,_) bbs]
      [`(g-virtual-rz ,_ ,_) bbs]
      [`(g-meas ,mk ,q)
       (if (or (eq? mk 'meas-mcm-ff) (eq? mk 'meas-mcmr-reuse))
           (list-set bbs q 0)
           bbs)]
      [`(g-seq ,g1 ,g2)
       (run g2 (run g1 bbs))]
      [`(g-twirl-step ,w ,pol)
       (if (eq? pol 'TwirlOdd) (list-update bbs w bb-not) bbs)]
      [`(g-tele-cnot ,c-w ,t-w)
       (define bc (list-ref bbs c-w))
       (list-update bbs t-w (lambda (bt) (bb-xor bt bc)))]
      [`(g-cat-entangle ,c-w ,t-w)
       (define bc (list-ref bbs c-w))
       (list-update bbs t-w (lambda (bt) (bb-xor bt bc)))]
      [`(g-cat-disentangle ,_ ,t-w)
       (list-set bbs t-w 0)]
      [`(g-skew-add-cs ,w)
       (list-update bbs w bb-not)]
      [`(g-consolidate-cs ,_) bbs]
      [`(g-cmp-gt ,c1 ,c2 ,t)
       (define b1 (list-ref bbs c1))
       (define b2 (list-ref bbs c2))
       (define gt (bb-xor b1 (bb-and b1 b2)))
       (list-update bbs t (lambda (bt) (bb-xor bt gt)))]
      [`(g-cswap ,c-w ,c1 ,c2)
       (define mc (list-ref bbs c-w))
       (define m1 (list-ref bbs c1))
       (define m2 (list-ref bbs c2))
       (define new1 (bb-cswap mc m1 m2))
       (define new2 (bb-cswap mc m2 m1))
       (list-set (list-set bbs c1 new1) c2 new2)]
      [`(g-kuperberg-collimate ,w1 ,_ ,w2 ,_)
       (define b1 (list-ref bbs w1))
       (list-update bbs w2 (lambda (b2) (bb-xor b2 b1)))]
      [`(g-inject-fault ,w ,k)
       (define fk (bb-var (fault-var-idx k)))
       (list-update bbs w (lambda (bw) (bb-xor bw fk)))]
      [`(g-flag-clear ,w1 ,w2)
       (list-set (list-set bbs w1 0) w2 0)]
      [_ bbs]))
  (define (run node bbs)
    (match node
      [`(c-gate ,g) (step-bb g bbs)]
      ;; S18 Neutral-Atom 2-pulse CSWAP collapse: (g-native-ccz q1 q2 q3) ; (g-native-iswap q2 q3)
      [(or `(c-seq (c-gate (g-native-ccz ,q1 ,q2 ,q3)) (c-gate (g-native-iswap ,q2a ,q3a)))
           `(g-seq (g-native-ccz ,q1 ,q2 ,q3) (g-native-iswap ,q2a ,q3a)))
       #:when (and (= q2 q2a) (= q3 q3a))
       (step-bb `(g-cswap ,q1 ,q2 ,q3) bbs)]
      [`(g-seq ,g1 ,g2) (run g2 (run g1 bbs))]
      [`(c-seq ,c1 ,c2) (run c2 (run c1 bbs))]
      [`(c-dag ,inner) (run (circuit-dag inner) bbs)]
      [`(c-with-uncompute ,u ,v)
       (run (circuit-dag u) (run v (run u bbs)))]
      [`(c-with-locked-pebble ,_ ,u ,v)
       (run (circuit-dag u) (run v (run u bbs)))]
      [`(c-par-diag ,c1 ,c2)
       (run c2 (run c1 bbs))]
      [`(c-unsafe-widen-refinement ,_ ,inner)
       (run inner bbs)]
      [`(c-voqc-opt ,inner)
       (run (voqc-optimize-canonical inner) bbs)]
      [(? pair?) (step-bb node bbs)]))
  (run c init-bbs))

;; Structural Hash-Consing (`hc-circuit`, `decompose-plug` `zam-use-hc?` style):
;; Interns every gate and circuit AST node into a global hash table so identical
;; sub-trees share a single canonical pointer for O(1) `eq?` and `hasheq` lookups.
(define hc-intern-table (make-hash))

(define (hc-intern-atom x)
  (hash-ref! hc-intern-table x (lambda () x)))

(define (hc-circuit c)
  (match c
    [`(c-gate ,g)
     (define cg (hc-intern-atom g))
     (hash-ref! hc-intern-table `(c-gate ,cg) (lambda () `(c-gate ,cg)))]
    [`(c-seq ,c1 ,c2)
     (define h1 (hc-circuit c1))
     (define h2 (hc-circuit c2))
     (define key `(c-seq ,h1 ,h2))
     (hash-ref! hc-intern-table key (lambda () key))]
    [`(c-dag ,inner)
     (define hi (hc-circuit inner))
     (define key `(c-dag ,hi))
     (hash-ref! hc-intern-table key (lambda () key))]
    [`(c-with-uncompute ,u ,v)
     (define hu (hc-circuit u))
     (define hv (hc-circuit v))
     (define key `(c-with-uncompute ,hu ,hv))
     (hash-ref! hc-intern-table key (lambda () key))]
    [`(c-with-locked-pebble ,p ,u ,v)
     (define hu (hc-circuit u))
     (define hv (hc-circuit v))
     (define key `(c-with-locked-pebble ,p ,hu ,hv))
     (hash-ref! hc-intern-table key (lambda () key))]
    [`(c-par-diag ,c1 ,c2)
     (define h1 (hc-circuit c1))
     (define h2 (hc-circuit c2))
     (define key `(c-par-diag ,h1 ,h2))
     (hash-ref! hc-intern-table key (lambda () key))]
    [`(c-unsafe-widen-refinement ,w ,inner)
     (define hi (hc-circuit inner))
     (define key `(c-unsafe-widen-refinement ,w ,hi))
     (hash-ref! hc-intern-table key (lambda () key))]
    [`(c-voqc-opt ,inner)
     (define hi (hc-circuit inner))
     (define key `(c-voqc-opt ,hi))
     (hash-ref! hc-intern-table key (lambda () key))]
    [_ (hc-intern-atom c)]))

;; =============================================================================
;; 3. Circuit Access Sets (Read / XWrite / Hadamard / ZPhase / Shuttle / PPM Bus),
;;    Unitary-QFree Predicates, VOQC Gate-Cancellation Optimizers (F13, S9),
;;    AST Shrinker, Surface QDo Desugaring (S5-S7), and Operational Semantics
;; =============================================================================

(define (gate-read-set g)
  (match g
    [`(g-id) '()]
    [`(g-x ,_) '()]
    [`(g-z ,w) (list w)]
    [`(g-h ,w) (list w)]
    [`(g-cnot ,c ,_) (list c)]
    [`(g-cz ,c1 ,c2) (list c1 c2)]
    [`(g-ccx ,c1 ,c2 ,_) (list c1 c2)]
    [`(g-compute-and ,c1 ,c2 ,_) (list c1 c2)]
    [`(g-and-compute ,c1 ,c2 ,_) (list c1 c2)]
    [`(g-rccx ,c1 ,c2 ,_) (list c1 c2)]
    [`(g-rccx-dag ,c1 ,c2 ,_) (list c1 c2)]
    [`(g-native-ccz ,q1 ,q2 ,q3) (list q1 q2 q3)]
    [`(g-native-iswap ,q1 ,q2) (list q1 q2)]
    [`(g-rzz ,q1 ,q2 ,_) (list q1 q2)]
    [`(g-virtual-rz ,q ,_) (list q)]
    [`(g-meas ,_ ,q) (list q)]
    [`(g-seq ,g1 ,g2) (remove-duplicates (append (gate-read-set g1) (gate-read-set g2)) =)]
    [`(g-hmr-cz ,t ,c1 ,c2 ,_) (list t c1 c2)]
    [`(g-hmr-cz ,t ,c1 ,c2) (list t c1 c2)]
    [`(g-zone-shuttle ,_ ,_) '()]
    [`(g-twirl-step ,_ ,_) '()]
    [`(g-tele-cnot ,c ,_) (list c)]
    [`(g-cat-entangle ,c ,_) (list c)]
    [`(g-cat-disentangle ,c ,t) (list c t)]
    [`(g-skew-add-cs ,w) (list w)]
    [`(g-consolidate-cs ,w) (list w)]
    [`(g-cmp-gt ,c1 ,c2 ,_) (list c1 c2)]
    [`(g-cswap ,c ,c1 ,c2) (list c c1 c2)]
    [`(g-fpga-feedforward ,w ,_) (list w)]
    [`(g-qec-barrier) '()]
    [`(g-stim-detector ,w) (list w)]
    [`(g-css-round-begin ,_) '()]
    [`(g-css-round-end ,_) '()]
    [`(g-bb-torus-shift ,_ ,_) '()]
    [`(g-kuperberg-collimate ,w1 ,_ ,w2 ,_) (list w1 w2)]
    [`(g-inject-fault ,w ,_) (list w)]
    [`(g-flag-clear ,w1 ,w2) (list w1 w2)]
    [`(g-cultivate-step ,w ,_) (list w)]
    [`(g-inject-magic-t ,w ,_) (list w)]
    [`(g-ppm-bus ,l ,r) (list (min l 3) (min r 3))]
    [`(g-gauge-open ,w) (list w)]
    [`(g-gauge-fix ,w) (list w)]
    [`(g-code-switch-transversal-t ,w) (list w)]
    [`(g-dd-xy4 ,w) (list w)]))

;; Computational-basis X-write set (mutates Z-basis bit values)
(define (gate-xwrite-set g)
  (match g
    [`(g-id) '()]
    [`(g-x ,w) (list w)]
    [`(g-z ,_) '()]
    [`(g-h ,_) '()]
    [`(g-cnot ,_ ,t) (list t)]
    [`(g-cz ,_ ,_) '()]
    [`(g-ccx ,_ ,_ ,t) (list t)]
    [`(g-compute-and ,_ ,_ ,t) (list t)]
    [`(g-and-compute ,_ ,_ ,t) (list t)]
    [`(g-rccx ,_ ,_ ,t) (list t)]
    [`(g-rccx-dag ,_ ,_ ,t) (list t)]
    [`(g-native-ccz ,_ ,_ ,_) '()]
    [`(g-native-iswap ,q1 ,q2) (list q1 q2)]
    [`(g-rzz ,_ ,_ ,_) '()]
    [`(g-virtual-rz ,_ ,_) '()]
    [`(g-meas ,mk ,q) (if (or (eq? mk 'meas-mcm-ff) (eq? mk 'meas-mcmr-reuse)) (list q) '())]
    [`(g-seq ,g1 ,g2) (remove-duplicates (append (gate-xwrite-set g1) (gate-xwrite-set g2)) =)]
    [`(g-hmr-cz ,t ,_ ,_ ,_) (list t)]
    [`(g-hmr-cz ,t ,_ ,_) (list t)]
    [`(g-zone-shuttle ,_ ,_) '()]
    [`(g-twirl-step ,w ,pol) (if (eq? pol 'TwirlOdd) (list w) '())]
    [`(g-tele-cnot ,_ ,t) (list t)]
    [`(g-cat-entangle ,_ ,t) (list t)]
    [`(g-cat-disentangle ,_ ,t) (list t)]
    [`(g-skew-add-cs ,w) (list w)]
    [`(g-consolidate-cs ,w) (list w)]
    [`(g-cmp-gt ,_ ,_ ,t) (list t)]
    [`(g-cswap ,_ ,c1 ,c2) (list c1 c2)]
    [`(g-fpga-feedforward ,_ ,_) '()]
    [`(g-qec-barrier) '()]
    [`(g-stim-detector ,_) '()]
    [`(g-css-round-begin ,_) '()]
    [`(g-css-round-end ,_) '()]
    [`(g-bb-torus-shift ,_ ,_) '()]
    [`(g-kuperberg-collimate ,_ ,_ ,w2 ,_) (list w2)]
    [`(g-inject-fault ,w ,_) (list w)]
    [`(g-flag-clear ,w1 ,w2) (list w1 w2)]
    [`(g-cultivate-step ,_ ,_) '()]
    [`(g-inject-magic-t ,_ ,_) '()]
    [`(g-ppm-bus ,_ ,_) '()]
    [`(g-gauge-open ,_) '()]
    [`(g-gauge-fix ,_) '()]
    [`(g-code-switch-transversal-t ,_) '()]
    [`(g-dd-xy4 ,_) '()]))

;; Spatial Lattice-Surgery PPM Bus Interval Extraction & Congestion (Issue F23, QEC-6):
(define (circuit-ppm-intervals c)
  (match c
    [`(c-gate (g-ppm-bus ,l ,r)) (list (list (min l r) (max l r)))]
    [`(c-gate ,_) '()]
    [`(c-seq ,c1 ,c2) (append (circuit-ppm-intervals c1) (circuit-ppm-intervals c2))]
    [`(c-dag ,inner) (circuit-ppm-intervals inner)]
    [`(c-with-uncompute ,u ,v) (append (circuit-ppm-intervals u) (circuit-ppm-intervals v))]
    [`(c-with-locked-pebble ,_ ,u ,v) (append (circuit-ppm-intervals u) (circuit-ppm-intervals v))]
    [`(c-par-diag ,c1 ,c2) (append (circuit-ppm-intervals c1) (circuit-ppm-intervals c2))]
    [`(c-unsafe-widen-refinement ,_ ,inner) (circuit-ppm-intervals inner)]
    [`(c-voqc-opt ,inner) (circuit-ppm-intervals inner)]
    ['(c-id) '()]))

(define (bus-intervals-overlap? ints1 ints2)
  (for*/or ([i1 (in-list ints1)]
            [i2 (in-list ints2)])
    (<= (max (first i1) (first i2))
        (min (second i1) (second i2)))))

;; Hadamard / basis-change set (switches between QFree and Superpos)
(define (gate-hadamard-set g)
  (match g
    [`(g-h ,w) (list w)]
    [`(g-seq ,g1 ,g2) (remove-duplicates (append (gate-hadamard-set g1) (gate-hadamard-set g2)) =)]
    [_ '()]))

;; Diagonal Z-phase set (mutates phase in computational basis; flips X-basis state!)
(define (gate-zphase-set g)
  (match g
    [`(g-z ,w) (list w)]
    [`(g-cz ,c1 ,c2) (list c1 c2)]
    [`(g-hmr-cz ,_ ,c1 ,c2 ,_) (list c1 c2)]
    [`(g-hmr-cz ,_ ,c1 ,c2) (list c1 c2)]
    [`(g-rccx ,c1 ,c2 ,t) (list c1 c2 t)]
    [`(g-rccx-dag ,c1 ,c2 ,t) (list c1 c2 t)]
    [`(g-native-ccz ,q1 ,q2 ,q3) (list q1 q2 q3)]
    [`(g-rzz ,q1 ,q2 ,_) (list q1 q2)]
    [`(g-virtual-rz ,q ,_) (list q)]
    [`(g-seq ,g1 ,g2) (remove-duplicates (append (gate-zphase-set g1) (gate-zphase-set g2)) =)]
    [`(g-cat-disentangle ,c ,_) (list c)]
    [`(g-inject-magic-t ,w ,_) (list w)]
    [`(g-code-switch-transversal-t ,w) (list w)]
    [_ '()]))

;; Zone shuttle set
(define (gate-shuttle-set g)
  (match g
    [`(g-zone-shuttle ,w ,_) (list w)]
    [`(g-seq ,g1 ,g2) (remove-duplicates (append (gate-shuttle-set g1) (gate-shuttle-set g2)) =)]
    [_ '()]))

;; Combined WriteSet (XWrite U Hadamard) for backward compatibility
(define (gate-write-set g)
  (remove-duplicates (append (gate-xwrite-set g) (gate-hadamard-set g)) =))

(define (gate-all-wires g)
  (remove-duplicates
   (append (gate-read-set g)
           (gate-write-set g)
           (gate-zphase-set g)
           (gate-shuttle-set g))
   =))

;; Unitary-only predicate (rejects projective measurements, barriers, detectors, and classical feed-forward)
(define (gate-unitary-only? g)
  (match g
    [`(g-hmr-cz ,_ ,_ ,_ ,_) #f]
    [`(g-hmr-cz ,_ ,_ ,_) #f]
    [`(g-meas ,_ ,_) #f]
    [`(g-seq ,g1 ,g2) (and (gate-unitary-only? g1) (gate-unitary-only? g2))]
    [`(g-cat-disentangle ,_ ,_) #f]
    [`(g-fpga-feedforward ,_ ,_) #f]
    [`(g-qec-barrier) #f]
    [`(g-stim-detector ,_) #f]
    [`(g-css-round-begin ,_) #f]
    [`(g-css-round-end ,_) #f]
    [`(g-bb-torus-shift ,_ ,_) #f]
    [`(g-kuperberg-collimate ,_ ,_ ,_ ,_) #f]
    [`(g-inject-fault ,_ ,_) #f]
    [`(g-flag-clear ,_ ,_) #f]
    [`(g-cultivate-step ,_ ,_) #f]
    [`(g-inject-magic-t ,_ ,_) #f]
    [`(g-ppm-bus ,_ ,_) #f]
    [`(g-gauge-open ,_) #f]
    [`(g-gauge-fix ,_) #f]
    [`(g-code-switch-transversal-t ,_) #f]
    [_ #t]))

;; Strictly QFree unitary predicate (classical-basis reversible gates only; no H, no MBU, no cat links)
(define (gate-unitary-qfree? g)
  (match g
    [`(g-h ,_) #f]
    [`(g-hmr-cz ,_ ,_ ,_ ,_) #f]
    [`(g-hmr-cz ,_ ,_ ,_) #f]
    [`(g-meas ,_ ,_) #f]
    [`(g-seq ,g1 ,g2) (and (gate-unitary-qfree? g1) (gate-unitary-qfree? g2))]
    [`(g-cat-entangle ,_ ,_) #f]
    [`(g-cat-disentangle ,_ ,_) #f]
    [`(g-fpga-feedforward ,_ ,_) #f]
    [`(g-qec-barrier) #f]
    [`(g-stim-detector ,_) #f]
    [`(g-css-round-begin ,_) #f]
    [`(g-css-round-end ,_) #f]
    [`(g-bb-torus-shift ,_ ,_) #f]
    [`(g-kuperberg-collimate ,_ ,_ ,_ ,_) #f]
    [`(g-inject-fault ,_ ,_) #f]
    [`(g-flag-clear ,_ ,_) #f]
    [`(g-cultivate-step ,_ ,_) #f]
    [`(g-inject-magic-t ,_ ,_) #f]
    [`(g-ppm-bus ,_ ,_) #f]
    [`(g-gauge-open ,_) #f]
    [`(g-gauge-fix ,_) #f]
    [`(g-code-switch-transversal-t ,_) #f]
    [_ #t]))

(define (lift-gate-set-fn gate-fn)
  (letrec ([visit
            (lambda (c)
              (match c
                [`(c-gate ,g) (remove-duplicates (gate-fn g) =)]
                [`(c-seq ,c1 ,c2) (remove-duplicates (append (visit c1) (visit c2)) =)]
                [`(c-dag ,inner) (visit inner)]
                [`(c-with-uncompute ,u ,v) (remove-duplicates (append (visit u) (visit v)) =)]
                [`(c-with-locked-pebble ,_ ,u ,v) (remove-duplicates (append (visit u) (visit v)) =)]
                [`(c-par-diag ,c1 ,c2) (remove-duplicates (append (visit c1) (visit c2)) =)]
                [`(c-unsafe-widen-refinement ,_ ,inner) (visit inner)]
                [`(c-voqc-opt ,inner) (visit inner)]))])
    visit))

(define circuit-read-set     (lift-gate-set-fn gate-read-set))
(define circuit-xwrite-set   (lift-gate-set-fn gate-xwrite-set))
(define circuit-hadamard-set (lift-gate-set-fn gate-hadamard-set))
(define circuit-zphase-set   (lift-gate-set-fn gate-zphase-set))
(define circuit-shuttle-set  (lift-gate-set-fn gate-shuttle-set))
(define circuit-write-set    (lift-gate-set-fn gate-write-set))

(define (circuit-all-wires c)
  (remove-duplicates
   (append (circuit-read-set c)
           (circuit-write-set c)
           (circuit-zphase-set c)
           (circuit-shuttle-set c))
   =))

(define (circuit-unitary-only? c)
  (match c
    [`(c-gate ,g) (gate-unitary-only? g)]
    [`(c-seq ,c1 ,c2) (and (circuit-unitary-only? c1) (circuit-unitary-only? c2))]
    [`(c-dag ,inner) (circuit-unitary-only? inner)]
    [`(c-with-uncompute ,u ,v) (and (circuit-unitary-only? u) (circuit-unitary-only? v))]
    [`(c-with-locked-pebble ,_ ,u ,v) (and (circuit-unitary-only? u) (circuit-unitary-only? v))]
    [`(c-par-diag ,c1 ,c2) (and (circuit-unitary-only? c1) (circuit-unitary-only? c2))]
    [`(c-unsafe-widen-refinement ,_ ,_) #f]
    [`(c-voqc-opt ,inner) (circuit-unitary-only? inner)]))

(define (circuit-unitary-qfree? c)
  (match c
    [`(c-gate ,g) (gate-unitary-qfree? g)]
    [`(c-seq ,c1 ,c2) (and (circuit-unitary-qfree? c1) (circuit-unitary-qfree? c2))]
    [`(c-dag ,inner) (circuit-unitary-qfree? inner)]
    [`(c-with-uncompute ,u ,v) (and (circuit-unitary-qfree? u) (circuit-unitary-qfree? v))]
    [`(c-with-locked-pebble ,_ ,u ,v) (and (circuit-unitary-qfree? u) (circuit-unitary-qfree? v))]
    [`(c-par-diag ,c1 ,c2) (and (circuit-unitary-qfree? c1) (circuit-unitary-qfree? c2))]
    [`(c-unsafe-widen-refinement ,_ ,_) #f]
    [`(c-voqc-opt ,inner) (circuit-unitary-qfree? inner)]))

(define (gate-dag g)
  (match g
    [`(g-rccx ,q1 ,q2 ,q3) `(g-rccx-dag ,q1 ,q2 ,q3)]
    [`(g-rccx-dag ,q1 ,q2 ,q3) `(g-rccx ,q1 ,q2 ,q3)]
    [`(g-seq ,g1 ,g2) `(g-seq ,(gate-dag g2) ,(gate-dag g1))]
    [`(g-skew-add-cs ,w) `(g-consolidate-cs ,w)]
    [`(g-consolidate-cs ,w) `(g-skew-add-cs ,w)]
    [`(g-css-round-begin ,m) `(g-css-round-end ,m)]
    [`(g-css-round-end ,m) `(g-css-round-begin ,m)]
    [`(g-gauge-open ,w) `(g-gauge-fix ,w)]
    [`(g-gauge-fix ,w) `(g-gauge-open ,w)]
    [_ g]))

(define (circuit-dag c)
  (match c
    [`(c-gate ,g) `(c-gate ,(gate-dag g))]
    [`(c-seq ,c1 ,c2) `(c-seq ,(circuit-dag c2) ,(circuit-dag c1))]
    [`(c-dag ,inner) inner]
    [`(c-with-uncompute ,u ,v) `(c-with-uncompute ,u ,(circuit-dag v))]
    [`(c-with-locked-pebble ,p ,u ,v) `(c-with-locked-pebble ,p ,u ,(circuit-dag v))]
    [`(c-par-diag ,c1 ,c2) `(c-par-diag ,(circuit-dag c1) ,(circuit-dag c2))]
    [`(c-unsafe-widen-refinement ,w ,inner) `(c-unsafe-widen-refinement ,w ,(circuit-dag inner))]
    [`(c-voqc-opt ,inner) `(c-voqc-opt ,(circuit-dag inner))]))

;; -----------------------------------------------------------------------------
;; Phase-4/5 VOQC Gate-Cancellation Optimizers (Issues F13, F18 & Simplifications S9, S12):
;;   - `voqc-optimize-naive`: cancels self-inverse gates G ; ... ; G -> I whenever
;;     neither target nor control is X-written in between, ignoring Z-phase gates
;;     on the target, Hadamard basis changes, Fredkin `g-cswap` 3-wire alias barriers,
;;     `g-hmr-cz`, `g-qec-barrier`, and `g-stim-detector`!
;;   - `voqc-optimize-canonical` (`Simplification S9/S12`): uses exact commutator &
;;     QFree/barrier analysis (`can-commute-past?`) including the 3-wire Fredkin
;;     `g-cswap` barrier (`Fix F18`) so only sound cancellations occur.
;; -----------------------------------------------------------------------------
(define (gate-is-cswap? g)
  (match g
    [`(g-cswap ,_ ,_ ,_) #t]
    [_ #f]))

(define (gate-self-inverse-unitary? g)
  (match g
    [`(g-x ,_) #t]
    [`(g-z ,_) #t]
    [`(g-h ,_) #t]
    [`(g-cnot ,c ,t) (not (= c t))]
    [`(g-cz ,c1 ,c2) (not (= c1 c2))]
    [`(g-ccx ,c1 ,c2 ,t) (and (not (= c1 c2)) (not (= c1 t)) (not (= c2 t)))]
    [`(g-compute-and ,c1 ,c2 ,t) (and (not (= c1 c2)) (not (= c1 t)) (not (= c2 t)))]
    [`(g-cswap ,c ,c1 ,c2) (and (not (= c c1)) (not (= c c2)) (not (= c1 c2)))]
    [_ #f]))

(define (gate-commutable-unitary? g)
  (match g
    [`(g-id) #t]
    [_ (gate-self-inverse-unitary? g)]))

;; Exact commutator & barrier predicate for Simplifications S9 & S12 (Fixes F13, F18):
;; Returns #t iff unitary gate g1 commutes past gate g2 without altering phase,
;; basis coherence, Fredkin CSWAP 3-wire alias barriers (Fix F18), QEC barriers,
;; Stim detectors, or syndrome rounds.
(define (can-commute-past? g1 g2)
  (and (gate-commutable-unitary? g1)
       (gate-commutable-unitary? g2)
       ;; Fix F18: All 3 wires {c, a, b} of g-cswap act as both X- and Z-basis read/write barriers!
       (if (or (gate-is-cswap? g1) (gate-is-cswap? g2))
           (null? (set-intersect (gate-all-wires g1) (gate-all-wires g2)))
           #t)
       (null? (set-intersect (gate-hadamard-set g1) (gate-all-wires g2)))
       (null? (set-intersect (gate-hadamard-set g2) (gate-all-wires g1)))
       (null? (set-intersect (gate-xwrite-set g1)
                             (append (gate-read-set g2)
                                     (gate-zphase-set g2)
                                     (gate-xwrite-set g2))))
       (null? (set-intersect (gate-xwrite-set g2)
                             (append (gate-read-set g1)
                                     (gate-zphase-set g1)
                                     (gate-xwrite-set g1))))))

;; Check that no wire of g has an unclosed carry-save or cat-link (or superposition for CZ/CNOT)
;; in the preceding gate prefix so G ; G == I holds unconditionally in operational semantics.
(define (gate-cancel-prefix-sound? g prefix)
  (define gwires (gate-all-wires g))
  (not
   (for/or ([pg (in-list prefix)])
     (match pg
       [`(g-skew-add-cs ,w) (member w gwires)]
       [`(g-consolidate-cs ,w) (member w gwires)]
       [`(g-cat-entangle ,c ,t) (or (member c gwires) (member t gwires))]
       [`(g-cat-disentangle ,c ,t) (or (member c gwires) (member t gwires))]
       [`(g-h ,w)
        (and (not (equal? g `(g-h ,w)))
             (member w gwires))]
       [`(g-zone-shuttle ,w ,z)
        (and (not (eq? z 'EntanglingZone))
             (member w gwires))]
       [_ #f]))))

(define (flatten-seq-items c)
  (match c
    [`(c-seq ,c1 ,c2) (append (flatten-seq-items c1) (flatten-seq-items c2))]
    [`(c-gate (g-id)) '()]
    [_ (list c)]))

(define (rebuild-seq-items items)
  (match items
    ['() '(c-gate (g-id))]
    [(list single) single]
    [(cons first-item rest-items)
     `(c-seq ,first-item ,(rebuild-seq-items rest-items))]))

(define (naive-can-pass-gate? g gm)
  ;; Vulnerability F13: Naive VOQC only checks that gm does not X-write to
  ;; the wires X-written or read by g, ignoring Z-phase on target, Hadamard,
  ;; g-hmr-cz, g-qec-barrier, g-stim-detector, and CSS syndrome round boundaries!
  (and (null? (set-intersect (gate-xwrite-set g) (gate-xwrite-set gm)))
       (null? (set-intersect (gate-read-set g) (gate-xwrite-set gm)))))

(define (cancel-gates-pass items can-pass? check-prefix?)
  (let loop ([rem items] [prefix-gates '()])
    (match rem
      ['() '()]
      [(cons `(c-gate ,g) rest) #:when (gate-self-inverse-unitary? g)
       (define prefix-ok?
         (if check-prefix?
             (gate-cancel-prefix-sound? g prefix-gates)
             #t))
       (define found-cancel
         (and prefix-ok?
              (let find-match ([scan rest] [mid '()])
                (match scan
                  ['() #f]
                  [(cons `(c-gate ,g2) after) #:when (equal? g g2)
                   (cons (reverse mid) after)]
                  [(cons `(c-gate ,gm) after)
                   (if (can-pass? g gm)
                       (find-match after (cons `(c-gate ,gm) mid))
                       #f)]
                  [_ #f]))))
       (if found-cancel
           (loop (append (car found-cancel) (cdr found-cancel)) prefix-gates)
           (cons `(c-gate ,g) (loop rest (cons g prefix-gates))))]
      [(cons other rest)
       (define extra-gates
         (match other
           [`(c-gate ,g) (list g)]
           [_ '()]))
       (cons other (loop rest (append extra-gates prefix-gates)))])))

(define (voqc-optimize-with can-pass? check-prefix? c)
  (define (opt-node node)
    (match node
      [`(c-gate ,_) node]
      [`(c-seq ,_ ,_)
       (define raw-items (map opt-node (flatten-seq-items node)))
       (define flat-items
         (apply append (map flatten-seq-items raw-items)))
       (define opted-items
         (let fixpoint ([cur flat-items])
           (define next (cancel-gates-pass cur can-pass? check-prefix?))
           (if (equal? next cur)
               cur
               (fixpoint next))))
       (rebuild-seq-items opted-items)]
      [`(c-dag ,inner) `(c-dag ,(opt-node inner))]
      [`(c-with-uncompute ,u ,v) `(c-with-uncompute ,(opt-node u) ,(opt-node v))]
      [`(c-with-locked-pebble ,p ,u ,v) `(c-with-locked-pebble ,p ,(opt-node u) ,(opt-node v))]
      [`(c-par-diag ,c1 ,c2) `(c-par-diag ,(opt-node c1) ,(opt-node c2))]
      [`(c-unsafe-widen-refinement ,w ,inner) `(c-unsafe-widen-refinement ,w ,(opt-node inner))]
      [`(c-voqc-opt ,inner) (opt-node inner)]))
  (opt-node c))

(define (voqc-optimize-naive c)
  (voqc-optimize-with naive-can-pass-gate? #f c))

(define (voqc-optimize-canonical c)
  (voqc-optimize-with can-commute-past? #t c))

;; -----------------------------------------------------------------------------
;; Simplifications S5, S6, S7:
;;   - S5 (`desugar-qdo`): Indexed monadic `qdo` (`seq` & `par` steps) desugars
;;     to core `GradedCircuit` (`c-seq`, `c-par-diag`).
;;   - S6 (`with-qfree`): Single-argument automatic adjoint synthesis desugars
;;     to `(c-with-uncompute U V)` without writing `U^dag` by hand.
;;   - S7 (`erase-to-netlist`): Zero-cost grade erasure flattens any well-typed
;;     `GradedCircuit` to a flat `GateNetlist = (GradedGate ...)` with 0 runtime
;;     overhead and exact operational equivalence!
;; -----------------------------------------------------------------------------
(define (desugar-qdo-raw qt)
  (match qt
    [`(q-prim ,g) `(c-gate ,g)]
    [`(with-qfree ,u ,v)
     `(c-with-uncompute ,(desugar-qdo-raw u) ,(desugar-qdo-raw v))]
    [`(with-pebble-ckpt ,p ,u ,v)
     `(c-with-locked-pebble ,p ,(desugar-qdo-raw u) ,(desugar-qdo-raw v))]
    [`(qdo () ,body)
     (desugar-qdo-raw body)]
    [`(qdo ((seq ,s1) ,rest ...) ,body)
     `(c-seq ,(desugar-qdo-raw s1)
             ,(desugar-qdo-raw `(qdo ,rest ,body)))]
    [`(qdo ((par ,p1 ,p2) ,rest ...) ,body)
     `(c-seq (c-par-diag ,(desugar-qdo-raw p1) ,(desugar-qdo-raw p2))
             ,(desugar-qdo-raw `(qdo ,rest ,body)))]))

(define-metafunction QuantumTypeTheoryL
  desugar-qdo : SurfaceQTerm -> GradedCircuit
  [(desugar-qdo SurfaceQTerm_0) ,(desugar-qdo-raw (term SurfaceQTerm_0))])

(define (let*-qmonad steps body)
  (desugar-qdo-raw `(qdo ,steps ,body)))

(define (with-qfree u v)
  (desugar-qdo-raw `(with-qfree ,u ,v)))

(define (erase-to-netlist-raw c)
  (match c
    [`(c-gate (g-id)) '()]
    [`(c-gate ,g) (list g)]
    [`(c-seq ,c1 ,c2)
     (append (erase-to-netlist-raw c1) (erase-to-netlist-raw c2))]
    [`(c-dag ,inner)
     (erase-to-netlist-raw (circuit-dag inner))]
    [`(c-with-uncompute ,u ,v)
     (append (erase-to-netlist-raw u)
             (erase-to-netlist-raw v)
             (erase-to-netlist-raw (circuit-dag u)))]
    [`(c-with-locked-pebble ,_ ,u ,v)
     (append (erase-to-netlist-raw u)
             (erase-to-netlist-raw v)
             (erase-to-netlist-raw (circuit-dag u)))]
    [`(c-par-diag ,c1 ,c2)
     (append (erase-to-netlist-raw c1) (erase-to-netlist-raw c2))]
    [`(c-unsafe-widen-refinement ,_ ,inner)
     (erase-to-netlist-raw inner)]
    [`(c-voqc-opt ,inner)
     (erase-to-netlist-raw (voqc-optimize-canonical inner))]))

(define (erase-grade c)
  (erase-to-netlist-raw c))

(define-metafunction QuantumTypeTheoryL
  erase-to-netlist : GradedCircuit -> GateNetlist
  [(erase-to-netlist GradedCircuit_0) ,(erase-to-netlist-raw (term GradedCircuit_0))])

;; -----------------------------------------------------------------------------
;; Automatic AST Counterexample Shrinker: (shrink-circuit c pred?)
;; Deterministic fixed-point shrinker with `hasheq` candidate memoization (S14)
;; that reduces any failing circuit AST to a minimal gate witness.
;; -----------------------------------------------------------------------------
(define (circuit-gate-count c)
  (match c
    [`(c-gate (g-id)) 0]
    [`(c-gate ,_) 1]
    [`(c-seq ,c1 ,c2) (+ (circuit-gate-count c1) (circuit-gate-count c2))]
    [`(c-dag ,inner) (circuit-gate-count inner)]
    [`(c-with-uncompute ,u ,v) (+ (* 2 (circuit-gate-count u)) (circuit-gate-count v))]
    [`(c-with-locked-pebble ,_ ,u ,v) (+ (* 2 (circuit-gate-count u)) (circuit-gate-count v))]
    [`(c-par-diag ,c1 ,c2) (+ (circuit-gate-count c1) (circuit-gate-count c2))]
    [`(c-unsafe-widen-refinement ,_ ,inner) (circuit-gate-count inner)]
    [`(c-voqc-opt ,inner) (circuit-gate-count inner)]))

(define (circuit-ast-size c)
  (match c
    [`(c-gate (g-id)) 1]
    [`(c-gate ,_) 2]
    [`(c-seq ,c1 ,c2) (+ 1 (circuit-ast-size c1) (circuit-ast-size c2))]
    [`(c-dag ,inner) (+ 1 (circuit-ast-size inner))]
    [`(c-with-uncompute ,u ,v) (+ 1 (circuit-ast-size u) (circuit-ast-size v))]
    [`(c-with-locked-pebble ,_ ,u ,v) (+ 1 (circuit-ast-size u) (circuit-ast-size v))]
    [`(c-par-diag ,c1 ,c2) (+ 1 (circuit-ast-size c1) (circuit-ast-size c2))]
    [`(c-unsafe-widen-refinement ,_ ,inner) (+ 1 (circuit-ast-size inner))]
    [`(c-voqc-opt ,inner) (+ 1 (circuit-ast-size inner))]))

(define (shrink-candidates c)
  (match c
    [`(c-gate (g-id)) '()]
    [`(c-gate ,_) (list '(c-gate (g-id)))]
    [`(c-seq ,c1 ,c2)
     (append
      (list c1 c2)
      (for/list ([s1 (in-list (shrink-candidates c1))]) `(c-seq ,s1 ,c2))
      (for/list ([s2 (in-list (shrink-candidates c2))]) `(c-seq ,c1 ,s2)))]
    [`(c-dag ,inner)
     (append
      (list inner)
      (for/list ([si (in-list (shrink-candidates inner))]) `(c-dag ,si)))]
    [`(c-with-uncompute ,u ,v)
     (append
      (list u v)
      (for/list ([su (in-list (shrink-candidates u))]) `(c-with-uncompute ,su ,v))
      (for/list ([sv (in-list (shrink-candidates v))]) `(c-with-uncompute ,u ,sv)))]
    [`(c-with-locked-pebble ,p ,u ,v)
     (append
      (list u v)
      (for/list ([su (in-list (shrink-candidates u))]) `(c-with-locked-pebble ,p ,su ,v))
      (for/list ([sv (in-list (shrink-candidates v))]) `(c-with-locked-pebble ,p ,u ,sv)))]
    [`(c-par-diag ,c1 ,c2)
     (append
      (list c1 c2)
      (for/list ([s1 (in-list (shrink-candidates c1))]) `(c-par-diag ,s1 ,c2))
      (for/list ([s2 (in-list (shrink-candidates c2))]) `(c-par-diag ,c1 ,s2)))]
    [`(c-unsafe-widen-refinement ,w ,inner)
     (append
      (list inner)
      (for/list ([si (in-list (shrink-candidates inner))]) `(c-unsafe-widen-refinement ,w ,si)))]
    [`(c-voqc-opt ,inner)
     (append
      (list inner)
      (for/list ([si (in-list (shrink-candidates inner))]) `(c-voqc-opt ,si)))]))

(define (shrink-circuit c pred?)
  (define seen-cache (make-hasheq))
  (define (memo-pred? cand)
    (define hcand (hc-circuit cand))
    (hash-ref! seen-cache hcand (lambda () (pred? hcand))))
  (let loop ([cur (hc-circuit c)])
    (define valid-smaller
      (filter (lambda (cand)
                (and (< (circuit-ast-size cand) (circuit-ast-size cur))
                     (memo-pred? cand)))
              (shrink-candidates cur)))
    (if (null? valid-smaller)
        cur
        (let ([best (argmin (lambda (x)
                              (+ (* 100 (circuit-gate-count x))
                                 (circuit-ast-size x)))
                            valid-smaller)])
          (loop (hc-circuit best))))))

;; -----------------------------------------------------------------------------
;; Operational evaluation of a GradedGate on a WireState (eval-gate-raw)
;; Includes exact H*Z^dz*H = X^dz conjugate phase kickback, superposition
;; coherence tracking, HardwareZone MBU enforcement, live cat-link semantics,
;; Quotient Carry-Save premature phase kickback (F9), Fredkin comparator ANF (F11),
;; Terhal syndrome backlog / LIFO cat-link choreography (F12),
;; Stim deterministic detector verification (F14), and Bivariate Bicycle CSS rounds (F16).
;; -----------------------------------------------------------------------------
(define (inject-wire-fault st w)
  (match-define `(wire-state (vals ,vals) (anf ,anfs) (phase ,ph) (zones ,zs)) st)
  (define safe-w (min w (- (length anfs) 1)))
  (define fmono (hmr-fault-mono safe-w))
  (define new-anfs
    (list-update anfs safe-w
                 (lambda (p)
                   (if (poly-has-mono? p fmono)
                       p
                       (anf-xor p (list fmono))))))
  `(wire-state (vals ,vals) (anf ,new-anfs) (phase ,(- (abs ph))) (zones ,zs)))

(define (eval-gate-raw g st)
  (match-define `(wire-state (vals ,vals) (anf ,anfs) (phase ,ph) (zones ,zs)) st)
  (match g
    [`(g-id) st]
    [`(g-x ,w)
     (if (wire-in-superpos? anfs w)
         ;; In X-basis: X|+> = |+>, X|-> = -|-> (phase kickback (-1)^(b0 xor dz))
         (let* ([eff-minus? (= (bitwise-xor (list-ref vals w)
                                            (if (wire-has-xphase? anfs w) 1 0))
                               1)]
                [new-ph (if eff-minus? (- ph) ph)])
           `(wire-state (vals ,vals) (anf ,anfs) (phase ,new-ph) (zones ,zs)))
         (let ([new-vals (list-update vals w (lambda (b) (bitwise-xor b 1)))]
               [new-anfs (list-update anfs w (lambda (p) (anf-xor p '(()))))])
           `(wire-state (vals ,new-vals) (anf ,new-anfs) (phase ,ph) (zones ,zs))))]
    [`(g-z ,w)
     (cond
       [(wire-has-redundant-cs? anfs w)
        ;; Issue F9: Phase kickback on redundant carry-save wire before consolidation
        ;; assigns branch-dependent phase to equivalent residues!
        (inject-wire-fault st w)]
       [(wire-in-superpos? anfs w)
        ;; In X-basis: Z flips |+> <-> |->, recording relative X-phase flip xphase-mono(w)
        (let ([new-anfs (list-update anfs w (lambda (p) (anf-xor p (list (xphase-mono w)))))])
          `(wire-state (vals ,vals) (anf ,new-anfs) (phase ,ph) (zones ,zs)))]
       [else
        (let* ([b (list-ref vals w)]
               [new-ph (if (= b 1) (- ph) ph)])
          `(wire-state (vals ,vals) (anf ,anfs) (phase ,new-ph) (zones ,zs)))])]
    [`(g-h ,w)
     (cond
       [(or (any-wire-has-catlink-endpoint? anfs w)
            (wire-has-redundant-cs? anfs w))
        ;; Applying Hadamard to a wire with an active cat-link or redundant carry-save corrupts coherence
        (define new-vals (list-update vals w (lambda (b) (bitwise-xor b 1))))
        (define new-anfs (list-update anfs w (lambda (p) (anf-xor p (list (superpos-mono w))))))
        `(wire-state (vals ,new-vals) (anf ,new-anfs) (phase ,(- ph)) (zones ,zs))]
       [(wire-in-superpos? anfs w)
        ;; Exiting X-basis via second H: H * Z^(dz) * H = X^(dz)!
        (define dz? (wire-has-xphase? anfs w))
        (define clean-p
          (let ([p1 (anf-xor (list-ref anfs w) (list (superpos-mono w)))])
            (if dz?
                (anf-xor (anf-xor p1 (list (xphase-mono w))) '(()))
                p1)))
        (define new-vals
          (if dz?
              (list-update vals w (lambda (b) (bitwise-xor b 1)))
              vals))
        (define new-anfs (list-set anfs w clean-p))
        `(wire-state (vals ,new-vals) (anf ,new-anfs) (phase ,ph) (zones ,zs))]
       [else
        ;; Entering X-basis superposition via first H
        (define new-anfs (list-update anfs w (lambda (p) (anf-xor p (list (superpos-mono w))))))
        `(wire-state (vals ,vals) (anf ,new-anfs) (phase ,ph) (zones ,zs))])]
    [`(g-cnot ,c ,t)
     (cond
       [(wire-in-superpos? anfs t)
        ;; Target t is in X-basis: CNOT(c, |->) kicks back Z phase onto control c!
        (define t-minus? (= (bitwise-xor (list-ref vals t)
                                         (if (wire-has-xphase? anfs t) 1 0))
                            1))
        (cond
          [(and t-minus? (wire-in-superpos? anfs c))
           (define new-anfs (list-update anfs c (lambda (p) (anf-xor p (list (xphase-mono c))))))
           `(wire-state (vals ,vals) (anf ,new-anfs) (phase ,ph) (zones ,zs))]
          [t-minus?
           (define bc (list-ref vals c))
           (define new-ph (if (= bc 1) (- ph) ph))
           `(wire-state (vals ,vals) (anf ,anfs) (phase ,new-ph) (zones ,zs))]
          [else st])]
       [else
        ;; Target t is in Z-basis; XOR control c (including any superposition tag on c) into t
        (define bc (list-ref vals c))
        (define pc (list-ref anfs c))
        (define new-vals (list-update vals t (lambda (bt) (bitwise-xor bt bc))))
        (define new-anfs (list-update anfs t (lambda (pt) (anf-xor pt pc))))
        `(wire-state (vals ,new-vals) (anf ,new-anfs) (phase ,ph) (zones ,zs))])]
    [`(g-cz ,c1 ,c2)
     (cond
       [(or (wire-has-redundant-cs? anfs c1)
            (wire-has-redundant-cs? anfs c2))
        ;; Issue F9: CZ phase kickback on un-consolidated redundant carry-save wire!
        (inject-wire-fault st (if (wire-has-redundant-cs? anfs c1) c1 c2))]
       [else
        (define sup1? (wire-in-superpos? anfs c1))
        (define sup2? (wire-in-superpos? anfs c2))
        (define b1 (list-ref vals c1))
        (define b2 (list-ref vals c2))
        (cond
          [(and sup1? sup2?)
           (define a1 (list-update anfs c1 (lambda (p) (anf-xor p (list (xphase-mono c1))))))
           (define a2 (list-update a1   c2 (lambda (p) (anf-xor p (list (xphase-mono c2))))))
           `(wire-state (vals ,vals) (anf ,a2) (phase ,ph) (zones ,zs))]
          [sup1?
           (define a1
             (if (= b2 1)
                 (list-update anfs c1 (lambda (p) (anf-xor p (list (xphase-mono c1)))))
                 (list-update anfs c1 (lambda (p) (anf-xor p (anf-and (list (xphase-mono c1)) (list-ref anfs c2)))))))
           `(wire-state (vals ,vals) (anf ,a1) (phase ,ph) (zones ,zs))]
          [sup2?
           (define a2
             (if (= b1 1)
                 (list-update anfs c2 (lambda (p) (anf-xor p (list (xphase-mono c2)))))
                 (list-update anfs c2 (lambda (p) (anf-xor p (anf-and (list (xphase-mono c2)) (list-ref anfs c1)))))))
           `(wire-state (vals ,vals) (anf ,a2) (phase ,ph) (zones ,zs))]
          [else
           (define new-ph (if (= (bitwise-and b1 b2) 1) (- ph) ph))
           `(wire-state (vals ,vals) (anf ,anfs) (phase ,new-ph) (zones ,zs))])])]
    [(or `(g-ccx ,c1 ,c2 ,t) `(g-compute-and ,c1 ,c2 ,t) `(g-and-compute ,c1 ,c2 ,t))
     (define b1 (list-ref vals c1))
     (define b2 (list-ref vals c2))
     (define p1 (list-ref anfs c1))
     (define p2 (list-ref anfs c2))
     (define prod-b (bitwise-and b1 b2))
     (define prod-p (anf-and p1 p2))
     (define new-vals (list-update vals t (lambda (bt) (bitwise-xor bt prod-b))))
     (define new-anfs (list-update anfs t (lambda (pt) (anf-xor pt prod-p))))
     `(wire-state (vals ,new-vals) (anf ,new-anfs) (phase ,ph) (zones ,zs))]
    [`(g-rccx ,c1 ,c2 ,t)
     ;; Maslov 3-CZ Relative-Phase Margolus Toffoli:
     ;; maps |a, b, c> -> (-1)^(a * b * c_after) |a, b, c xor (a * b)>
     (define b1 (list-ref vals c1))
     (define b2 (list-ref vals c2))
     (define bt (list-ref vals t))
     (define p1 (list-ref anfs c1))
     (define p2 (list-ref anfs c2))
     (define prod-b (bitwise-and b1 b2))
     (define prod-p (anf-and p1 p2))
     (define bt-after (bitwise-xor bt prod-b))
     (define new-vals (list-set vals t bt-after))
     (define new-anfs (list-update anfs t (lambda (pt) (anf-xor pt prod-p))))
     (define new-ph (if (= (bitwise-and prod-b bt-after) 1) (- ph) ph))
     `(wire-state (vals ,new-vals) (anf ,new-anfs) (phase ,new-ph) (zones ,zs))]
    [`(g-rccx-dag ,c1 ,c2 ,t)
     ;; Inverse 3-CZ Relative-Phase Margolus Toffoli:
     ;; maps |a, b, c_before> -> (-1)^(a * b * c_before) |a, b, c_before xor (a * b)>
     (define b1 (list-ref vals c1))
     (define b2 (list-ref vals c2))
     (define bt-before (list-ref vals t))
     (define p1 (list-ref anfs c1))
     (define p2 (list-ref anfs c2))
     (define prod-b (bitwise-and b1 b2))
     (define prod-p (anf-and p1 p2))
     (define bt-after (bitwise-xor bt-before prod-b))
     (define new-vals (list-set vals t bt-after))
     (define new-anfs (list-update anfs t (lambda (pt) (anf-xor pt prod-p))))
     (define new-ph (if (= (bitwise-and prod-b bt-before) 1) (- ph) ph))
     `(wire-state (vals ,new-vals) (anf ,new-anfs) (phase ,new-ph) (zones ,zs))]
    [`(g-native-ccz ,q1 ,q2 ,q3)
     (define b1 (list-ref vals q1))
     (define b2 (list-ref vals q2))
     (define b3 (list-ref vals q3))
     (define new-ph (if (= (bitwise-and b1 (bitwise-and b2 b3)) 1) (- ph) ph))
     `(wire-state (vals ,vals) (anf ,anfs) (phase ,new-ph) (zones ,zs))]
    [`(g-native-iswap ,q1 ,q2)
     (define b1 (list-ref vals q1))
     (define b2 (list-ref vals q2))
     (define p1 (list-ref anfs q1))
     (define p2 (list-ref anfs q2))
     (define new-vals (list-set (list-set vals q1 b2) q2 b1))
     (define new-anfs (list-set (list-set anfs q1 p2) q2 p1))
     `(wire-state (vals ,new-vals) (anf ,new-anfs) (phase ,ph) (zones ,zs))]
    [`(g-rzz ,q1 ,q2 ,n)
     (define b1 (list-ref vals q1))
     (define b2 (list-ref vals q2))
     (define odd-rot? (odd? n))
     (define new-ph (if (and odd-rot? (= (bitwise-xor b1 b2) 1)) (- ph) ph))
     `(wire-state (vals ,vals) (anf ,anfs) (phase ,new-ph) (zones ,zs))]
    [`(g-virtual-rz ,q ,n)
     (define bq (list-ref vals q))
     (define odd-rot? (odd? n))
     (define new-ph (if (and odd-rot? (= bq 1)) (- ph) ph))
     `(wire-state (vals ,vals) (anf ,anfs) (phase ,new-ph) (zones ,zs))]
    [`(g-meas ,mk ,q)
     (if (or (eq? mk 'meas-mcm-ff) (eq? mk 'meas-mcmr-reuse))
         (let ([new-vals (list-set vals q 0)]
               [new-anfs (list-set anfs q '())])
           `(wire-state (vals ,new-vals) (anf ,new-anfs) (phase ,ph) (zones ,zs)))
         st)]
    [`(g-seq ,g1 ,g2)
     (eval-gate-raw g2 (eval-gate-raw g1 st))]
    [`(g-hmr-cz ,t ,c1 ,c2)
     (eval-gate-raw `(g-hmr-cz ,t ,c1 ,c2 0) st)]
    [`(g-hmr-cz ,t ,c1 ,c2 ,m)
     (define zones-ok?
       (and (eq? (list-ref zs t)  'EntanglingZone)
            (eq? (list-ref zs c1) 'EntanglingZone)
            (eq? (list-ref zs c2) 'EntanglingZone)))
     (define qfree-ok?
       (and (not (wire-in-superpos? anfs t))
            (not (wire-in-superpos? anfs c1))
            (not (wire-in-superpos? anfs c2))
            (not (wire-has-redundant-cs? anfs t))
            (not (wire-has-redundant-cs? anfs c1))
            (not (wire-has-redundant-cs? anfs c2))
            (not (any-wire-has-catlink-endpoint? anfs t))
            (not (any-wire-has-catlink-endpoint? anfs c1))
            (not (any-wire-has-catlink-endpoint? anfs c2))))
     (define bt (list-ref vals t))
     (define b1 (list-ref vals c1))
     (define b2 (list-ref vals c2))
     (cond
       [(and zones-ok? qfree-ok?)
        (define kickback-exponent (bitwise-and m (bitwise-xor bt (bitwise-and b1 b2))))
        (define new-ph (if (= kickback-exponent 1) (- ph) ph))
        (define new-vals (list-set vals t 0))
        (define new-anfs (list-set anfs t '()))
        `(wire-state (vals ,new-vals) (anf ,new-anfs) (phase ,new-ph) (zones ,zs))]
       [else
        (define new-vals (list-set vals t 0))
        (define new-anfs (list-set anfs t (list (hmr-fault-mono t))))
        `(wire-state (vals ,new-vals) (anf ,new-anfs) (phase ,(- ph)) (zones ,zs))])]
    [`(g-zone-shuttle ,w ,z-target)
     (define new-zs (list-set zs w z-target))
     `(wire-state (vals ,vals) (anf ,anfs) (phase ,ph) (zones ,new-zs))]
    [`(g-twirl-step ,w ,pol)
     (if (eq? pol 'TwirlOdd)
         (let ([new-vals (list-update vals w (lambda (b) (bitwise-xor b 1)))]
               [new-anfs (list-update anfs w (lambda (p) (anf-xor p '(()))))])
           `(wire-state (vals ,new-vals) (anf ,new-anfs) (phase ,ph) (zones ,zs)))
         st)]
    [`(g-tele-cnot ,c ,t)
     (define bc (list-ref vals c))
     (define pc (list-ref anfs c))
     (define new-vals (list-update vals t (lambda (bt) (bitwise-xor bt bc))))
     (define new-anfs (list-update anfs t (lambda (pt) (anf-xor pt pc))))
     `(wire-state (vals ,new-vals) (anf ,new-anfs) (phase ,ph) (zones ,zs))]
    [`(g-cat-entangle ,c ,t)
     (define bc (list-ref vals c))
     (define pc (list-ref anfs c))
     (define new-vals (list-update vals t (lambda (bt) (bitwise-xor bt bc))))
     (define new-anfs
       (list-update anfs t (lambda (pt) (anf-xor pt (anf-xor pc (list (catlink-mono c t)))))))
     `(wire-state (vals ,new-vals) (anf ,new-anfs) (phase ,ph) (zones ,zs))]
    [`(g-cat-disentangle ,c ,t)
     (define link-m (catlink-mono c t))
     (define has-link? (poly-has-mono? (list-ref anfs t) link-m))
     (define coherent?
       (and has-link?
            (not (wire-in-superpos? anfs c))
            (not (wire-in-superpos? anfs t))))
     (if coherent?
         (let* ([bc (list-ref vals c)]
                [pc (list-ref anfs c)]
                [new-vals (list-update vals t (lambda (bt) (bitwise-xor bt bc)))]
                [new-anfs (list-update anfs t (lambda (pt) (anf-xor pt (anf-xor pc (list link-m)))))])
           `(wire-state (vals ,new-vals) (anf ,new-anfs) (phase ,ph) (zones ,zs)))
         (let ([new-anfs (list-update anfs t (lambda (pt) (anf-xor pt (list (hmr-fault-mono t)))))])
           `(wire-state (vals ,vals) (anf ,new-anfs) (phase ,(- ph)) (zones ,zs))))]
    ;; Phase-3 Gates:
    [`(g-skew-add-cs ,w)
     ;; Carry-save skew step adds 1 in redundant (S, C) representation:
     ;; requires wire w to be in CanonicalMod (not already RedundantCS or Superpos),
     ;; and marks wire w with redundant-cs-mono(w) until consolidated by g-consolidate-cs!
     (if (or (wire-has-redundant-cs? anfs w)
             (wire-in-superpos? anfs w))
         (inject-wire-fault st w)
         (let* ([cs-m (list (redundant-cs-mono w))]
                [cur-p (list-ref anfs w)]
                [p-with-cs (anf-xor (anf-xor cur-p '(())) cs-m)]
                [new-vals (list-update vals w (lambda (b) (bitwise-xor b 1)))]
                [new-anfs (list-set anfs w p-with-cs)])
           `(wire-state (vals ,new-vals) (anf ,new-anfs) (phase ,ph) (zones ,zs))))]
    [`(g-consolidate-cs ,w)
     ;; Consolidates redundant carry-save (S, C) into canonical residue mod M:
     ;; requires wire w to currently hold redundant-cs-mono(w) (RepState == RedundantCS)!
     (define cs-m (list (redundant-cs-mono w)))
     (define cur-p (list-ref anfs w))
     (if (poly-has-mono? cur-p (redundant-cs-mono w))
         (let ([new-anfs (list-set anfs w (anf-xor cur-p cs-m))])
           `(wire-state (vals ,vals) (anf ,new-anfs) (phase ,ph) (zones ,zs)))
         (inject-wire-fault st w))]
    [`(g-cmp-gt ,c1 ,c2 ,t)
     ;; Reversible comparator: t <- t xor (c1 > c2) where (c1 > c2) == c1 xor (c1 * c2) in F_2[x]!
     (if (or (wire-has-redundant-cs? anfs c1)
             (wire-has-redundant-cs? anfs c2)
             (wire-has-redundant-cs? anfs t))
         ;; Comparing un-consolidated redundant carry-save wires produces false inequality!
         (inject-wire-fault st t)
         (let* ([b1 (list-ref vals c1)]
                [b2 (list-ref vals c2)]
                [gt-b (if (and (= b1 1) (= b2 0)) 1 0)]
                [p1 (list-ref anfs c1)]
                [p2 (list-ref anfs c2)]
                [gt-p (anf-xor p1 (anf-and p1 p2))]
                [new-vals (list-update vals t (lambda (bt) (bitwise-xor bt gt-b)))]
                [new-anfs (list-update anfs t (lambda (pt) (anf-xor pt gt-p)))])
           `(wire-state (vals ,new-vals) (anf ,new-anfs) (phase ,ph) (zones ,zs))))]
    [`(g-cswap ,c ,c1 ,c2)
     ;; Fredkin controlled-SWAP:
     ;; anf(c1) <- anf(c1) xor anf(c) * (anf(c1) xor anf(c2))
     ;; anf(c2) <- anf(c2) xor anf(c) * (anf(c1) xor anf(c2))
     (define bc (list-ref vals c))
     (define b1 (list-ref vals c1))
     (define b2 (list-ref vals c2))
     (define delta-b (bitwise-and bc (bitwise-xor b1 b2)))
     (define pc (list-ref anfs c))
     (define p1 (list-ref anfs c1))
     (define p2 (list-ref anfs c2))
     (define delta-p (anf-and pc (anf-xor p1 p2)))
     (define vals1 (list-set vals c1 (bitwise-xor b1 delta-b)))
     (define vals2 (list-set vals1 c2 (bitwise-xor b2 delta-b)))
     (define anfs1 (list-set anfs c1 (anf-xor p1 delta-p)))
     (define anfs2 (list-set anfs1 c2 (anf-xor p2 delta-p)))
     `(wire-state (vals ,vals2) (anf ,anfs2) (phase ,ph) (zones ,zs))]
    [`(g-fpga-feedforward ,_w ,_d)
     st]
    [`(g-qec-barrier)
     st]
    ;; Phase-4 Gates:
    [`(g-stim-detector ,w)
     ;; Issue F14: Stim DETECTOR annotation requires wire w to be deterministically |0>
     ;; in QFree mode, CanonicalMod representation, with ANFPoly(w) in {(), ((w))} and vals[w] == 0!
     (define pw (anf-normalize (list-ref anfs w)))
     (define det-ok?
       (and (not (wire-in-superpos? anfs w))
            (not (wire-has-xphase? anfs w))
            (not (wire-has-redundant-cs? anfs w))
            (not (any-wire-has-catlink-endpoint? anfs w))
            (not (poly-has-virtual-tag? pw))
            (= (list-ref vals w) 0)
            (or (null? pw) (equal? pw (list (list w))))))
     (if det-ok?
         st
         (inject-wire-fault st w))]
    [`(g-css-round-begin ,_mode)
     st]
    [`(g-css-round-end ,_mode)
     st]
    [`(g-bb-torus-shift ,_a ,_b)
     st]
     ;; Phase-5 Gate (OQP-5 Kuperberg Collimation Sieve, Issue F19):
    [`(g-kuperberg-collimate ,w1 ,r1 ,w2 ,r2)
     ;; Issue F19: Kuperberg collimation sieve requires equal trailing-zero ranks r1 == r2,
     ;; distinct wires w1 != w2, QFree mode, CanonicalMod representation, and EntanglingZone!
     (define coll-ok?
       (and (not (= w1 w2))
            (= r1 r2)
            (not (wire-in-superpos? anfs w1))
            (not (wire-in-superpos? anfs w2))
            (not (wire-has-redundant-cs? anfs w1))
            (not (wire-has-redundant-cs? anfs w2))
            (not (any-wire-has-catlink-endpoint? anfs w1))
            (not (any-wire-has-catlink-endpoint? anfs w2))
            (eq? (list-ref zs w1) 'EntanglingZone)
            (eq? (list-ref zs w2) 'EntanglingZone)))
     (if coll-ok?
         (let* ([b1 (list-ref vals w1)]
                [p1 (list-ref anfs w1)]
                [new-vals (list-update vals w2 (lambda (b2) (bitwise-xor b2 b1)))]
                [new-anfs (list-update anfs w2 (lambda (p2) (anf-xor p2 p1)))])
           `(wire-state (vals ,new-vals) (anf ,new-anfs) (phase ,ph) (zones ,zs)))
         (inject-wire-fault st w2))]
    ;; Phase-6 Gates (Issues F21-F24, Simplification S13):
    [`(g-inject-fault ,w ,k)
     ;; Issue F21 (QEC-4): Injects symbolic fault variable e_k (var 4+k) onto wire w
     (define fmono (fault-var-mono k))
     (define new-vals (list-update vals w (lambda (b) (bitwise-xor b 1))))
     (define new-anfs (list-update anfs w (lambda (p) (anf-xor p (list fmono)))))
     `(wire-state (vals ,new-vals) (anf ,new-anfs) (phase ,ph) (zones ,zs))]
    [`(g-flag-clear ,w1 ,w2)
     ;; Issue F21 (QEC-4): Verifies and resets flagged syndrome wire w1 and flag wire w2
     ;; when both caught identical fault polynomial in QFree + CanonicalMod
     (define p1 (anf-normalize (list-ref anfs w1)))
     (define p2 (anf-normalize (list-ref anfs w2)))
     (define clear-ok?
       (and (not (= w1 w2))
            (not (wire-in-superpos? anfs w1))
            (not (wire-in-superpos? anfs w2))
            (not (wire-has-redundant-cs? anfs w1))
            (not (wire-has-redundant-cs? anfs w2))
            (equal? p1 p2)))
     (if clear-ok?
         (let ([vals-clean (list-set (list-set vals w1 0) w2 0)]
               [anfs-clean (list-set (list-set anfs w1 '()) w2 '())])
           `(wire-state (vals ,vals-clean) (anf ,anfs-clean) (phase ,ph) (zones ,zs)))
         (inject-wire-fault st w2))]
    [`(g-cultivate-step ,w ,_r)
     (if (or (wire-in-superpos? anfs w)
             (wire-has-redundant-cs? anfs w)
             (any-wire-has-catlink-endpoint? anfs w)
             (poly-depends-on-var? (list-ref anfs w) 4)
             (poly-depends-on-var? (list-ref anfs w) 5))
         (inject-wire-fault st w)
         st)]
    [`(g-inject-magic-t ,w ,_r)
     (if (or (wire-in-superpos? anfs w)
             (wire-has-redundant-cs? anfs w)
             (any-wire-has-catlink-endpoint? anfs w)
             (poly-depends-on-var? (list-ref anfs w) 4)
             (poly-depends-on-var? (list-ref anfs w) 5)
             (not (eq? (list-ref zs w) 'EntanglingZone)))
         (inject-wire-fault st w)
         st)]
    [`(g-ppm-bus ,l ,r)
     (if (and (<= l r)
              (< r (length anfs))
              (for/and ([w (in-range l (+ r 1))])
                (and (not (wire-has-redundant-cs? anfs w))
                     (eq? (list-ref zs w) 'EntanglingZone))))
         st
         (inject-wire-fault st (min r (- (length anfs) 1))))]
    [`(g-gauge-open ,w)
     (if (or (wire-has-redundant-cs? anfs w)
             (wire-in-superpos? anfs w))
         (inject-wire-fault st w)
         st)]
    [`(g-gauge-fix ,w)
     (if (or (wire-has-redundant-cs? anfs w)
             (wire-in-superpos? anfs w))
         (inject-wire-fault st w)
         st)]
    [`(g-code-switch-transversal-t ,w)
     (if (or (wire-has-redundant-cs? anfs w)
             (wire-in-superpos? anfs w)
             (not (eq? (list-ref zs w) 'EntanglingZone)))
         (inject-wire-fault st w)
         st)]
    [`(g-dd-xy4 ,_w)
     st]))

;; Check whether a single fault variable e_k (var 4 or 5) has spread to >= 2
;; non-flag wires without setting the flag wire (last wire) (Issue F21, QEC-4):
(define (unflagged-hook-error-spread? anfs)
  (define n (length anfs))
  (define flag-w (- n 1))
  (for/or ([k (in-list '(0 1))])
    (define fvar (fault-var-idx k))
    (define data-weight
      (for/sum ([w (in-range flag-w)])
        (if (poly-depends-on-var? (list-ref anfs w) fvar) 1 0)))
    (define flagged? (poly-depends-on-var? (list-ref anfs flag-w) fvar))
    (and (>= data-weight 2) (not flagged?))))

;; Latency cost (in nanoseconds) per gate within a QEC cycle window (T_cycle = 1,000 ns)
(define qec-cycle-budget-ns 1000)

(define (gate-latency-ns g)
  (match g
    [`(g-hmr-cz ,_ ,_ ,_ ,_) 150]
    [`(g-hmr-cz ,_ ,_ ,_) 150]
    [`(g-rccx ,_ ,_ ,_) 0]
    [`(g-rccx-dag ,_ ,_ ,_) 0]
    [`(g-native-ccz ,_ ,_ ,_) 0]
    [`(g-native-iswap ,_ ,_) 0]
    [`(g-rzz ,_ ,_ ,_) 0]
    [`(g-virtual-rz ,_ ,_) 0]
    [`(g-meas ,mk ,_) (if (eq? mk 'meas-mcm-ff) 150 0)]
    [`(g-seq ,g1 ,g2) (+ (gate-latency-ns g1) (gate-latency-ns g2))]
    [`(g-tele-cnot ,_ ,_) 200]
    [`(g-cat-entangle ,_ ,_) 150]
    [`(g-cat-disentangle ,_ ,_) 150]
    [`(g-fpga-feedforward ,_ ,d) d]
    [`(g-qec-barrier) 0]
    [_ 0]))

;; Timed, stack-disciplined, CSS-syndrome, cultivation-rank, PPM-bus & homological-gauge
;; circuit evaluator (tracks Issues F1..F24 & Phase-8 S17..S20)
(define (eval-circuit-timed c st lat stack locked
                            [css-round 'CSSClosed]
                            [gauge-state 'ClosedHomologyGauge]
                            [cult-ranks '(0 0 0 0)])
  (match c
    ['(c-id)
     (values st lat stack css-round gauge-state cult-ranks)]
    ;; S18 Neutral-Atom 2-pulse CSWAP collapse: (g-native-ccz q1 q2 q3) ; (g-native-iswap q2 q3)
    [(or `(c-seq (c-gate (g-native-ccz ,q1 ,q2 ,q3)) (c-gate (g-native-iswap ,q2a ,q3a)))
         `(g-seq (g-native-ccz ,q1 ,q2 ,q3) (g-native-iswap ,q2a ,q3a)))
     #:when (and (= q2 q2a) (= q3 q3a))
     (eval-circuit-timed `(c-gate (g-cswap ,q1 ,q2 ,q3)) st lat stack locked css-round gauge-state cult-ranks)]
    [`(g-seq ,g1 ,g2)
     (define-values (st1 lat1 stack1 css1 gauge1 ranks1)
       (eval-circuit-timed g1 st lat stack locked css-round gauge-state cult-ranks))
     (eval-circuit-timed g2 st1 lat1 stack1 locked css1 gauge1 ranks1)]
    [`(c-gate ,g)
     (define g-touches
       (remove-duplicates
        (append (gate-xwrite-set g) (gate-hadamard-set g) (gate-shuttle-set g))
        =))
     (define locked-overwrite-wires (set-intersect g-touches locked))
     (define st0 (eval-gate-raw g st))
     ;; Check locked checkpoint pebble overwrite (Issue F10)
     (define st1
       (if (null? locked-overwrite-wires)
           st0
           (inject-wire-fault st0 (car locked-overwrite-wires))))
     ;; Update LIFO cat-link stack & check FIFO/mismatched deadlock (Issue F12b)
     (define-values (st2 stack-next)
       (match g
         [`(g-cat-entangle ,c-w ,t-w)
          (values st1 (cons (list c-w t-w) stack))]
         [`(g-cat-disentangle ,c-w ,t-w)
          (define pair (list c-w t-w))
          (if (and (pair? stack) (equal? (car stack) pair))
              (values st1 (cdr stack))
              ;; Non-LIFO / FIFO cat-link disentangle deadlocks endpoint projection!
              (values (inject-wire-fault st1 t-w) (remove pair stack)))]
         [_ (values st1 stack)]))
     ;; Update [[288, 12, 18]] Bivariate Bicycle CSS syndrome round state (Issue F16 & F21)
     (define last-wire (- (length (second (assoc 'vals (cdr st2)))) 1))
     (define cur-anfs (second (assoc 'anf (cdr st2))))
     (define-values (st3 css-next)
       (match g
         [`(g-css-round-begin ,mode)
          (if (eq? css-round 'CSSClosed)
              (values st2 (if (eq? mode 'Superpos) 'CSSOpenX 'CSSOpenZ))
              (values (inject-wire-fault (inject-wire-fault st2 0) last-wire) css-round))]
         [`(g-css-round-end ,mode)
          (define expected (if (eq? mode 'Superpos) 'CSSOpenX 'CSSOpenZ))
          (if (and (eq? css-round expected)
                   (not (unflagged-hook-error-spread? cur-anfs)))
              (values st2 'CSSClosed)
              (values (inject-wire-fault (inject-wire-fault st2 0) last-wire) 'CSSClosed))]
         [`(g-bb-torus-shift ,_a ,_b)
          ;; Issue F16: Executing a Bivariate Bicycle torus automorphism while a CSS
          ;; syndrome round is open scrambles stabilizer parity checks!
          (if (and (eq? css-round 'CSSClosed) (null? stack-next))
              (values st2 css-round)
              (values (inject-wire-fault (inject-wire-fault st2 0) last-wire) css-round))]
         [_ (values st2 css-round)]))
     ;; Update Magic-State Cultivation Ranks (Issue F22) & Homological Gauge State (Issue F24)
     (define-values (st4 gauge-next ranks-next)
       (match g
         [`(g-cultivate-step ,w ,r)
          (define w-clean?
            (and (not (wire-in-superpos? cur-anfs w))
                 (not (wire-has-redundant-cs? cur-anfs w))
                 (not (poly-depends-on-var? (list-ref cur-anfs w) 4))
                 (not (poly-depends-on-var? (list-ref cur-anfs w) 5))))
          (if (and w-clean? (>= r 1))
              (values st3 gauge-state (list-set cult-ranks w r))
              (values (inject-wire-fault (inject-wire-fault st3 w) last-wire)
                      gauge-state
                      (list-set cult-ranks w 0)))]
         [`(g-inject-magic-t ,w ,target-r)
          ;; Issue F22: Injecting magic state T when BinomialRank(w) < target-r or fault leaked!
          (define cur-r (list-ref cult-ranks w))
          (define ok-magic?
            (and (>= target-r 1)
                 (>= cur-r target-r)
                 (not (poly-depends-on-var? (list-ref cur-anfs w) 4))
                 (not (poly-depends-on-var? (list-ref cur-anfs w) 5))))
          (if ok-magic?
              (values st3 gauge-state cult-ranks)
              (values (inject-wire-fault (inject-wire-fault st3 w) last-wire)
                      gauge-state
                      cult-ranks))]
         [`(g-gauge-open ,w)
          (if (eq? gauge-state 'ClosedHomologyGauge)
              (values st3 'OpenBoundaryGauge cult-ranks)
              (values (inject-wire-fault (inject-wire-fault st3 w) last-wire)
                      'OpenBoundaryGauge
                      cult-ranks))]
         [`(g-gauge-fix ,w)
          (if (eq? gauge-state 'OpenBoundaryGauge)
              (values st3 'ClosedHomologyGauge cult-ranks)
              (values (inject-wire-fault (inject-wire-fault st3 w) last-wire)
                      'ClosedHomologyGauge
                      cult-ranks))]
         [`(g-code-switch-transversal-t ,w)
          ;; Issue F24: Executing 2D <-> 3D code switch transversal T while GaugeState == OpenBoundaryGauge!
          (if (and (eq? gauge-state 'ClosedHomologyGauge)
                   (eq? css-next 'CSSClosed))
              (values st3 gauge-state cult-ranks)
              (values (inject-wire-fault (inject-wire-fault st3 w) last-wire)
                      gauge-state
                      cult-ranks))]
         [`(g-inject-fault ,w ,_k)
          ;; Any fault on wire w invalidates its post-selected cultivation rank!
          (values st3 gauge-state (list-set cult-ranks w 0))]
         [_ (values st3 gauge-state cult-ranks)]))
     ;; Update QEC cycle latency & check Terhal backlog > 1,000 ns (Issue F12a)
     (match g
       [`(g-qec-barrier)
        (if (and (<= lat qec-cycle-budget-ns)
                 (null? stack-next)
                 (eq? css-next 'CSSClosed)
                 (eq? gauge-next 'ClosedHomologyGauge)
                 (not (unflagged-hook-error-spread? cur-anfs)))
            (values st4 0 stack-next css-next gauge-next ranks-next)
            (values (inject-wire-fault (inject-wire-fault st4 0) last-wire)
                    lat stack-next css-next gauge-next ranks-next))]
       [`(g-fpga-feedforward ,w ,d)
        (define new-lat (+ lat d))
        (if (> new-lat qec-cycle-budget-ns)
            (values (inject-wire-fault st4 w) new-lat stack-next css-next gauge-next ranks-next)
            (values st4 new-lat stack-next css-next gauge-next ranks-next))]
       [_
        (define new-lat (+ lat (gate-latency-ns g)))
        (if (> new-lat qec-cycle-budget-ns)
            (values (inject-wire-fault st4 0) new-lat stack-next css-next gauge-next ranks-next)
            (values st4 new-lat stack-next css-next gauge-next ranks-next))])]
    [`(c-seq ,c1 ,c2)
     (define-values (st1 lat1 stack1 css1 gauge1 ranks1)
       (eval-circuit-timed c1 st lat stack locked css-round gauge-state cult-ranks))
     (eval-circuit-timed c2 st1 lat1 stack1 locked css1 gauge1 ranks1)]
    [`(c-dag ,inner)
     (eval-circuit-timed (circuit-dag inner) st lat stack locked css-round gauge-state cult-ranks)]
    [`(c-with-uncompute ,u ,v)
     (define-values (st1 lat1 stack1 css1 gauge1 ranks1)
       (eval-circuit-timed u st lat stack locked css-round gauge-state cult-ranks))
     (define-values (st2 lat2 stack2 css2 gauge2 ranks2)
       (eval-circuit-timed v st1 lat1 stack1 locked css1 gauge1 ranks1))
     (eval-circuit-timed (circuit-dag u) st2 lat2 stack2 locked css2 gauge2 ranks2)]
    [`(c-with-locked-pebble ,p ,u ,v)
     (define-values (st1 lat1 stack1 css1 gauge1 ranks1)
       (eval-circuit-timed u st lat stack locked css-round gauge-state cult-ranks))
     (define-values (st2 lat2 stack2 css2 gauge2 ranks2)
       (eval-circuit-timed v st1 lat1 stack1 (remove-duplicates (cons p locked) =) css1 gauge1 ranks1))
     (eval-circuit-timed (circuit-dag u) st2 lat2 stack2 locked css2 gauge2 ranks2)]
    [`(c-par-diag ,c1 ,c2)
     (define-values (st1 lat1 stack1 css1 gauge1 ranks1)
       (eval-circuit-timed c1 st lat stack locked css-round gauge-state cult-ranks))
     (define-values (st2 lat2 stack2 css2 gauge2 ranks2)
       (eval-circuit-timed c2 st1 lat stack1 locked css1 gauge1 ranks1))
     ;; Issue F23: Parallel lattice-surgery PPM bus interval overlap causes a bus routing collision!
     (define bus-collision?
       (bus-intervals-overlap? (circuit-ppm-intervals c1)
                               (circuit-ppm-intervals c2)))
     (define last-w (- (length (second (assoc 'vals (cdr st2)))) 1))
     (define st-out
       (if bus-collision?
           (inject-wire-fault (inject-wire-fault st2 0) last-w)
           st2))
     (values st-out (max lat1 lat2) stack2 css2 gauge2 ranks2)]
    [`(c-unsafe-widen-refinement ,_w ,inner)
     (eval-circuit-timed inner st lat stack locked css-round gauge-state cult-ranks)]
    [`(c-voqc-opt ,inner)
     (eval-circuit-timed (voqc-optimize-canonical inner) st lat stack locked css-round gauge-state cult-ranks)]))

(define (eval-circuit-raw c st)
  (define num-w (length (second (assoc 'vals (cdr st)))))
  (define-values (st-out _lat _stack css-out gauge-out _ranks-out)
    (eval-circuit-timed c st 0 '() '() 'CSSClosed 'ClosedHomologyGauge (make-list num-w 0)))
  (define out-anfs (second (assoc 'anf (cdr st-out))))
  (if (and (eq? css-out 'CSSClosed)
           (eq? gauge-out 'ClosedHomologyGauge)
           (not (unflagged-hook-error-spread? out-anfs)))
      st-out
      (let ([last-w (- num-w 1)])
        (inject-wire-fault (inject-wire-fault st-out 0) last-w))))

(define (eval-netlist-raw gates st)
  (define as-circ
    (if (null? gates)
        '(c-gate (g-id))
        (for/fold ([acc `(c-gate ,(car gates))]) ([g (in-list (cdr gates))])
          `(c-seq ,acc (c-gate ,g)))))
  (eval-circuit-raw as-circ st))


;; PLT Redex Metafunction: eval-circuit
(define-metafunction QuantumTypeTheoryL
  eval-circuit : GradedCircuit WireState -> WireState
  [(eval-circuit GradedCircuit_0 WireState_0)
   ,(eval-circuit-raw (term GradedCircuit_0) (term WireState_0))])

;; PLT Redex Judgment Form: eval-circuit-judgment
(define-judgment-form QuantumTypeTheoryL
  #:mode (eval-circuit-judgment I I O)
  #:contract (eval-circuit-judgment GradedCircuit WireState WireState)
  [(where WireState_out (eval-circuit GradedCircuit_in WireState_in))
   ------------------------------------------------------------------- "E-Circuit"
   (eval-circuit-judgment GradedCircuit_in WireState_in WireState_out)])

