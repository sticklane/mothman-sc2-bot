  (define revir-gates (if enforce-guard? (compile-coreqds-to-revir combined-ast) '()))
  (hash 'oqp-id 'OQP-44-CoreQDS2-QData-Inductive-Twist-Purity-And-Slice-Borrow
        'ast combined-ast
        'ast-node-count (coreqds-ast-node-count combined-ast)
        'revir-gates revir-gates
        'revir-gate-count (length revir-gates)
        'verified? (and (hash-ref m40 'verified?)
