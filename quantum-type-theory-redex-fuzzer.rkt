;; -----------------------------------------------------------------------------
;; 27.4 Deliverable 4 (Pass M64, S98, OQP-56, TODAY-34, Fix F128):
;;      Bilateral Phase-Octant Sign Invariance & Complete 672-Cell
;;      (56 OQPs x 3 Regimes x 4 Machine Families) Post-Route Peephole &
;;      Dense-Compacted PCC-Lakefill Compilation Matrix
;; -----------------------------------------------------------------------------

(define (verify-bilateral-phase-octant-sign-invariance
         [octant-phases '(1 2 3 5 7)]
         [enforce-guard? #t])
  (define eff-phases
    (if (and (list? octant-phases) (pair? octant-phases))
        octant-phases
        '(1 2 3 5 7)))
  ;; In bilateral conjugation U ; V ; U^\dagger, each forward phase +p in Z_8 is paired
  ;; with its exact inverse (-p mod 8) in U^\dagger. Under an asymmetric sign-flip mutant
  ;; (enforce-guard? = #f), U^\dagger applies +p instead of -p, leaving 2*p mod 8 residue!
  (define forward-sum (modulo (foldl + 0 eff-phases) 8))
  (define adjoint-sum
    (if enforce-guard?
        (modulo (foldl + 0 (map (lambda (p) (modulo (- 8 (modulo p 8)) 8)) eff-phases)) 8)
        forward-sum))
  (define net-octant-residue (modulo (+ forward-sum adjoint-sum) 8))
  (hash 'forward-octant-sum forward-sum
        'adjoint-octant-sum adjoint-sum
        'bilateral-phase-octant-residue net-octant-residue
        'bilateral-sign-invariant? (zero? net-octant-residue)
        'asymmetric-phase-sign-flip-hazard? (not (zero? net-octant-residue))
        'verified? (and enforce-guard? (zero? net-octant-residue))))

