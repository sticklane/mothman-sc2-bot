(define (run-all-qtt-redex-fuzz-suites)
  (define tbl (make-hash))
  (define t1 (run-fuzz-issues-f1-to-f14! tbl))
  (define t2 (run-fuzz-issues-f15-to-f44! tbl))
  (define t3 (run-fuzz-simplification-and-stress-suites! tbl))
  (define total-trials (+ t1 t2 t3))
  (check-true (>= total-trials 2860800) "Total Redex fuzz trials must reach at least 2,860,800")
  (run-redex-judgment-holds-checks!)
  (hash-set! tbl 'total-fuzz-trials total-trials)
  (hash-set! tbl 'all-verified? #t)
  tbl)

