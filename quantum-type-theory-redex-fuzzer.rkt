;; Enforces ALL 20 Fuzz-Discovered Laws F1..F20 in a single NbE pass:
;;   - Fix F17: Strict auto-adjoint `with-qfree` / `c-with-uncompute` invertibility:
;;              `(g-skew-add-cs w)` requires `RepState == CanonicalMod` and sets `RedundantCS`;
;;              `(g-consolidate-cs w)` requires `RepState == RedundantCS` and sets `CanonicalMod`;
;;              `c-with-uncompute(u, v)` requires `u` to leave ALL wires in `QFree + CanonicalMod`
;;              and `v` to preserve `RepState` and `ANFPoly` of all wires read/written by `u`.
;;   - Fix F18: 3-wire Fredkin `g-cswap` commutator barrier in `can-commute-past?` and NbE
;;              normalizer (`voqc-optimize-canonical`).
;;   - Fix F19: Kuperberg collimation sieve `(g-kuperberg-collimate w1 r1 w2 r2)` requires
;;              equal trailing-zero ranks `r1 == r2`, `w1 != w2`, `QFree`, `CanonicalMod`,
;;              and `EntanglingZone`.
;;   - Fix F20: Recursive pure `QFree` unitary invertibility across nested `c-par-diag`
;;              inside `c-with-uncompute` / `with-qfree`: rejects `g-tele-cnot` (`ebits > 0`),
;;              `g-cat-entangle`, `g-stim-detector`, `g-css-round-begin`, etc. inside `u`
;;              and enforces `ebits(u) == 0`, `live-links(u) == ()`, `css-round(u) == CSSClosed`.
;; -----------------------------------------------------------------------------
(define (nbe-gate-strictly-invertible-qfree? g)
  (match g
    [`(g-id) #t]
    [`(g-x ,_) #t]
    [`(g-z ,_) #t]
    [`(g-cnot ,c ,t) (not (= c t))]
    [`(g-cz ,c1 ,c2) (not (= c1 c2))]
    [`(g-ccx ,c1 ,c2 ,t) (and (not (= c1 c2)) (not (= c1 t)) (not (= c2 t)))]
    [`(g-compute-and ,c1 ,c2 ,t) (and (not (= c1 c2)) (not (= c1 t)) (not (= c2 t)))]
    [`(g-and-compute ,c1 ,c2 ,t) (and (not (= c1 c2)) (not (= c1 t)) (not (= c2 t)))]
    [`(g-rccx ,c1 ,c2 ,t) (and (not (= c1 c2)) (not (= c1 t)) (not (= c2 t)))]
    [`(g-rccx-dag ,c1 ,c2 ,t) (and (not (= c1 c2)) (not (= c1 t)) (not (= c2 t)))]
    [`(g-native-ccz ,c1 ,c2 ,c3) (and (not (= c1 c2)) (not (= c1 c3)) (not (= c2 c3)))]
    [`(g-native-iswap ,q1 ,q2) (not (= q1 q2))]
    [`(g-rzz ,q1 ,q2 ,_) (not (= q1 q2))]
    [`(g-virtual-rz ,_ ,_) #t]
    [`(g-seq ,g1 ,g2)
     (and (nbe-gate-strictly-invertible-qfree? g1)
          (nbe-gate-strictly-invertible-qfree? g2))]
    [`(g-twirl-step ,_ ,_) #t]
    [`(g-skew-add-cs ,_) #t]
    [`(g-consolidate-cs ,_) #t]
    [`(g-cmp-gt ,c1 ,c2 ,t) (and (not (= c1 c2)) (not (= c1 t)) (not (= c2 t)))]
    [`(g-cswap ,c ,c1 ,c2) (and (not (= c c1)) (not (= c c2)) (not (= c1 c2)))]
    [`(g-kuperberg-collimate ,w1 ,r1 ,w2 ,r2) (and (not (= w1 w2)) (= r1 r2))]
    [_ #f]))

(define (nbe-circuit-strictly-invertible-qfree? c)
  (match c
    [`(c-gate ,g) (nbe-gate-strictly-invertible-qfree? g)]
    [`(c-seq ,c1 ,c2)
     (and (nbe-circuit-strictly-invertible-qfree? c1)
          (nbe-circuit-strictly-invertible-qfree? c2))]
    [`(c-dag ,inner)
     (nbe-circuit-strictly-invertible-qfree? inner)]
    [`(c-with-uncompute ,u ,v)
     (and (nbe-circuit-strictly-invertible-qfree? u)
          (nbe-circuit-strictly-invertible-qfree? v))]
    [`(c-with-locked-pebble ,_ ,u ,v)
     (and (nbe-circuit-strictly-invertible-qfree? u)
          (nbe-circuit-strictly-invertible-qfree? v))]
    [`(c-par-diag ,c1 ,c2)
     (and (nbe-circuit-strictly-invertible-qfree? c1)
          (nbe-circuit-strictly-invertible-qfree? c2))]
    [`(c-unsafe-widen-refinement ,_ ,_) #f]
    [`(c-voqc-opt ,inner)
     (nbe-circuit-strictly-invertible-qfree? inner)]))

(define (cwires-unflagged-hook-error-spread? cwires)
  ;; Issue F21 in cwire representation: data wires 0..1, syndrome wire 2, flag wire 3
  (define flag-anf (cwire-anf (list-ref cwires 3)))
  (for/or ([k (in-list '(0 1))])
    (define fault-var (+ 4 k))
    (define data-fault-weight
      (for/sum ([w (in-list '(0 1))])
        (if (anf-depends-on-var? (cwire-anf (list-ref cwires w)) fault-var) 1 0)))
    (define flag-catches? (anf-depends-on-var? flag-anf fault-var))
    (and (>= data-fault-weight 2)
         (not flag-catches?))))

(define (surface-qterm? x)
  (and (pair? x)
       (not (not (memq (car x) '(q-prim qdo with-qfree with-pebble-ckpt))))))

(define (Synthesize-QEC-NbE-Grade surf-or-circ init-anfs init-zones)
  (define raw-circ
    (if (surface-qterm? surf-or-circ)
        (desugar-qdo-raw surf-or-circ)
        surf-or-circ))
  (define init-cwires
    (map (lambda (a z) `(cwire QFree CanonicalMod #f ,(anf-normalize a) ,z))
         init-anfs init-zones))
  (define init-bbs
    (map anf->bitboard init-anfs))
  (define init-ranks (make-list (length init-anfs) 0))

  (define (step-gate g cwires bbs ranks gauge cong links lat css-round)
    (match g
      [`(g-id)
       (values 0 0 0 lat css-round gauge cong ranks bbs links cwires #t)]
      [`(g-x ,w)
       (match-define `(cwire ,m ,r ,lck ,a ,z) (list-ref cwires w))
       (define ok? (and (eq? m 'QFree) (eq? r 'CanonicalMod) (not lck) (not (wire-in-catlinks? w links))))
       (values 0 1 0 lat css-round gauge cong ranks
               (list-set bbs w (bb-not (list-ref bbs w)))
               links
               (list-set cwires w `(cwire ,m ,r ,lck ,(anf-xor a '(())) ,z))
               ok?)]
      [`(g-z ,w)
       (match-define `(cwire ,m ,r ,lck ,a ,z) (list-ref cwires w))
       (define ok? (eq? r 'CanonicalMod))
       (define a-new (if (eq? m 'Superpos) (anf-xor a (list (xphase-mono w))) a))
       (values 0 1 0 lat css-round gauge cong ranks bbs links
               (list-set cwires w `(cwire ,m ,r ,lck ,a-new ,z))
               ok?)]
      [`(g-h ,w)
       (match-define `(cwire ,m ,r ,lck ,a ,z) (list-ref cwires w))
       (define pre-ok? (and (eq? r 'CanonicalMod) (not lck) (not (wire-in-catlinks? w links))))
       (cond
         [(not pre-ok?)
          (values 0 1 0 lat css-round gauge cong ranks bbs links
                  (list-set cwires w `(cwire Superpos ,r ,lck ,a ,z))
                  #f)]
         [(eq? m 'QFree)
          (values 0 1 0 lat css-round gauge cong ranks bbs links
                  (list-set cwires w `(cwire Superpos ,r ,lck ,a ,z))
                  #t)]
         [else
          (define dz? (poly-has-mono? a (xphase-mono w)))
          (define a-clean (if dz? (anf-xor (anf-xor a (list (xphase-mono w))) '(())) a))
          (define bb-clean (if dz? (bb-not (list-ref bbs w)) (list-ref bbs w)))
          (values 0 1 0 lat css-round gauge cong ranks
                  (list-set bbs w bb-clean)
                  links
                  (list-set cwires w `(cwire QFree ,r ,lck ,a-clean ,z))
                  #t)])]
      [`(g-cnot ,c-w ,t-w)
       (match-define `(cwire ,mc ,rc ,_lckc ,ac ,zc) (list-ref cwires c-w))
       (match-define `(cwire ,mt ,rt ,lckt ,at ,zt) (list-ref cwires t-w))
       (define ok?
         (and (not (= c-w t-w))
              (eq? mc 'QFree) (eq? mt 'QFree)
              (eq? rc 'CanonicalMod) (eq? rt 'CanonicalMod)
              (not lckt)
              (eq? zc 'EntanglingZone) (eq? zt 'EntanglingZone)
              (not (wire-in-catlinks? c-w links))
              (not (wire-in-catlinks? t-w links))))
       (values 0 1 0 lat css-round gauge cong ranks
               (list-set bbs t-w (bb-xor (list-ref bbs t-w) (list-ref bbs c-w)))
               links
               (list-set cwires t-w `(cwire ,mt ,rt ,lckt ,(anf-xor at ac) ,zt))
               ok?)]
      [`(g-cz ,c1 ,c2)
       (match-define `(cwire ,m1 ,r1 ,lck1 ,a1 ,z1) (list-ref cwires c1))
       (match-define `(cwire ,m2 ,r2 ,lck2 ,a2 ,z2) (list-ref cwires c2))
       (define ok?
         (and (not (= c1 c2))
              (eq? m1 'QFree) (eq? m2 'QFree)
              (eq? r1 'CanonicalMod) (eq? r2 'CanonicalMod)
              (eq? z1 'EntanglingZone) (eq? z2 'EntanglingZone)))
       (define cw1 (if (eq? m1 'Superpos) (list-set cwires c1 `(cwire ,m1 ,r1 ,lck1 ,(anf-xor a1 (list (xphase-mono c1))) ,z1)) cwires))
       (define cw2 (if (eq? m2 'Superpos) (list-set cw1 c2 `(cwire ,m2 ,r2 ,lck2 ,(anf-xor a2 (list (xphase-mono c2))) ,z2)) cw1))
       (values 0 1 0 lat css-round gauge cong ranks bbs links cw2 ok?)]
      [(or `(g-ccx ,c1 ,c2 ,t) `(g-compute-and ,c1 ,c2 ,t) `(g-and-compute ,c1 ,c2 ,t)
           `(g-rccx ,c1 ,c2 ,t) `(g-rccx-dag ,c1 ,c2 ,t))
       (match-define `(cwire ,m1 ,r1 ,_lck1 ,a1 ,z1) (list-ref cwires c1))
       (match-define `(cwire ,m2 ,r2 ,_lck2 ,a2 ,z2) (list-ref cwires c2))
       (match-define `(cwire ,mt ,rt ,lckt ,at ,zt) (list-ref cwires t))
       (define distinct? (and (not (= c1 c2)) (not (= c1 t)) (not (= c2 t))))
       (define ok?
         (and distinct?
              (eq? m1 'QFree) (eq? m2 'QFree) (eq? mt 'QFree)
              (eq? r1 'CanonicalMod) (eq? r2 'CanonicalMod) (eq? rt 'CanonicalMod)
              (not lckt)
              (eq? z1 'EntanglingZone) (eq? z2 'EntanglingZone) (eq? zt 'EntanglingZone)
              (not (wire-in-catlinks? c1 links))
              (not (wire-in-catlinks? c2 links))
              (not (wire-in-catlinks? t links))))
       (values (if (or (eq? (car g) 'g-rccx) (eq? (car g) 'g-rccx-dag)) 0 1)
               1 0 lat css-round gauge cong ranks
               (list-set bbs t (bb-xor (list-ref bbs t) (bb-and (list-ref bbs c1) (list-ref bbs c2))))
               links
               (list-set cwires t `(cwire ,mt ,rt ,lckt ,(anf-xor at (anf-and a1 a2)) ,zt))
               ok?)]
      [(or `(g-hmr-cz ,t ,c1 ,c2 ,_) `(g-hmr-cz ,t ,c1 ,c2))
       (match-define `(cwire ,mt ,rt ,lckt ,at ,zt) (list-ref cwires t))
       (match-define `(cwire ,m1 ,r1 ,_lck1 ,a1 ,z1) (list-ref cwires c1))
       (match-define `(cwire ,m2 ,r2 ,_lck2 ,a2 ,z2) (list-ref cwires c2))
       (define distinct? (and (not (= c1 c2)) (not (= c1 t)) (not (= c2 t))))
       (define new-lat (+ lat 150))
       (define ok?
         (and distinct?
              (<= new-lat qec-cycle-budget-ns)
              (eq? mt 'QFree) (eq? m1 'QFree) (eq? m2 'QFree)
              (eq? rt 'CanonicalMod) (eq? r1 'CanonicalMod) (eq? r2 'CanonicalMod)
              (not lckt)
              (eq? zt 'EntanglingZone) (eq? z1 'EntanglingZone) (eq? z2 'EntanglingZone)
              (not (wire-in-catlinks? t links))
              (not (wire-in-catlinks? c1 links))
              (not (wire-in-catlinks? c2 links))
              (= (list-ref bbs t) (bb-and (list-ref bbs c1) (list-ref bbs c2)))
              (equal? (anf-normalize at) (anf-normalize (anf-and a1 a2)))))
       (values 0 1 0 new-lat css-round gauge cong ranks
               (list-set bbs t 0)
               links
               (list-set cwires t `(cwire QFree CanonicalMod ,lckt () ,zt))
               ok?)]
      [`(g-zone-shuttle ,w ,z-target)
       (match-define `(cwire ,m ,r ,lck ,a ,_) (list-ref cwires w))
       (values 0 1 0 lat css-round gauge cong ranks bbs links
               (list-set cwires w `(cwire ,m ,r ,lck ,a ,z-target))
               (not lck))]
      [`(g-twirl-step ,w ,pol)
       (match-define `(cwire ,m ,r ,lck ,a ,z) (list-ref cwires w))
       (define ok? (and (eq? m 'QFree) (eq? r 'CanonicalMod) (not lck) (not (wire-in-catlinks? w links))))
       (define a-new (if (eq? pol 'TwirlOdd) (anf-xor a '(())) a))
       (define bb-new (if (eq? pol 'TwirlOdd) (bb-not (list-ref bbs w)) (list-ref bbs w)))
       (values 0 1 0 lat css-round gauge cong ranks
               (list-set bbs w bb-new)
               links
               (list-set cwires w `(cwire ,m ,r ,lck ,a-new ,z))
               ok?)]
      [`(g-tele-cnot ,c-w ,t-w)
       (match-define `(cwire ,mc ,rc ,_lckc ,ac ,zc) (list-ref cwires c-w))
       (match-define `(cwire ,mt ,rt ,lckt ,at ,zt) (list-ref cwires t-w))
       (define new-lat (+ lat 200))
       (define ok?
         (and (not (= c-w t-w))
              (<= new-lat qec-cycle-budget-ns)
              (eq? mc 'QFree) (eq? mt 'QFree)
              (eq? rc 'CanonicalMod) (eq? rt 'CanonicalMod)
              (not lckt)
              (eq? zc 'EntanglingZone) (eq? zt 'EntanglingZone)
              (not (wire-in-catlinks? t-w links))))
       (values 0 1 1 new-lat css-round gauge cong ranks
               (list-set bbs t-w (bb-xor (list-ref bbs t-w) (list-ref bbs c-w)))
               links
               (list-set cwires t-w `(cwire ,mt ,rt ,lckt ,(anf-xor at ac) ,zt))
               ok?)]
      [`(g-cat-entangle ,c-w ,t-w)
       (match-define `(cwire ,mc ,rc ,_lckc ,ac ,zc) (list-ref cwires c-w))
       (match-define `(cwire ,mt ,rt ,lckt ,at ,zt) (list-ref cwires t-w))
       (define pair (list c-w t-w))
       (define new-lat (+ lat 150))
       (define ok?
         (and (not (= c-w t-w))
              (<= new-lat qec-cycle-budget-ns)
              (eq? mc 'QFree) (eq? mt 'QFree)
              (eq? rc 'CanonicalMod) (eq? rt 'CanonicalMod)
              (not lckt)
              (eq? zc 'EntanglingZone) (eq? zt 'EntanglingZone)
              (null? (anf-normalize at))
              (not (member pair links))
              (not (wire-in-catlinks? t-w links))))
       (values 0 1 1 new-lat css-round gauge cong ranks
               (list-set bbs t-w (list-ref bbs c-w))
               (cons pair links)
               (list-set cwires t-w `(cwire QFree CanonicalMod ,lckt ,ac ,zt))
               ok?)]
      [`(g-cat-disentangle ,c-w ,t-w)
       (match-define `(cwire ,mc ,rc ,_lckc ,ac ,zc) (list-ref cwires c-w))
       (match-define `(cwire ,mt ,rt ,lckt ,at ,zt) (list-ref cwires t-w))
       (define pair (list c-w t-w))
       (define new-lat (+ lat 150))
       (define lifo-top? (and (pair? links) (equal? (car links) pair)))
       (define ok?
         (and lifo-top?
              (<= new-lat qec-cycle-budget-ns)
              (eq? mc 'QFree) (eq? mt 'QFree)
              (eq? rc 'CanonicalMod) (eq? rt 'CanonicalMod)
              (not lckt)
              (eq? zc 'EntanglingZone) (eq? zt 'EntanglingZone)
              (equal? (anf-normalize at) (anf-normalize ac))))
       (define links-new (if lifo-top? (cdr links) (remove pair links)))
       (values 0 1 0 new-lat css-round gauge cong ranks
               (list-set bbs t-w 0)
               links-new
               (list-set cwires t-w `(cwire QFree CanonicalMod ,lckt () ,zt))
               (not (not ok?)))]
      [`(g-cmp-gt ,c1 ,c2 ,t)
       (match-define `(cwire ,m1 ,r1 ,_lck1 ,a1 ,z1) (list-ref cwires c1))
       (match-define `(cwire ,m2 ,r2 ,_lck2 ,a2 ,z2) (list-ref cwires c2))
       (match-define `(cwire ,mt ,rt ,lckt ,at ,zt) (list-ref cwires t))
       (define distinct? (and (not (= c1 c2)) (not (= c1 t)) (not (= c2 t))))
       (define ok?
         (and distinct?
              (eq? m1 'QFree) (eq? m2 'QFree) (eq? mt 'QFree)
              (eq? r1 'CanonicalMod) (eq? r2 'CanonicalMod) (eq? rt 'CanonicalMod)
              (not lckt)
              (eq? z1 'EntanglingZone) (eq? z2 'EntanglingZone) (eq? zt 'EntanglingZone)
              (not (wire-in-catlinks? c1 links))
              (not (wire-in-catlinks? c2 links))
              (not (wire-in-catlinks? t links))))
       (define gt-p (anf-xor a1 (anf-and a1 a2)))
       (define gt-bb (bb-xor (list-ref bbs c1) (bb-and (list-ref bbs c1) (list-ref bbs c2))))
       (values 1 1 0 lat css-round gauge cong ranks
               (list-set bbs t (bb-xor (list-ref bbs t) gt-bb))
               links
               (list-set cwires t `(cwire ,mt ,rt ,lckt ,(anf-xor at gt-p) ,zt))
               ok?)]
      [`(g-cswap ,c-w ,c1 ,c2)
       (match-define `(cwire ,mc ,rc ,_lckc ,ac ,zc) (list-ref cwires c-w))
       (match-define `(cwire ,m1 ,r1 ,lck1 ,a1 ,z1) (list-ref cwires c1))
       (match-define `(cwire ,m2 ,r2 ,lck2 ,a2 ,z2) (list-ref cwires c2))
       (define distinct? (and (not (= c-w c1)) (not (= c-w c2)) (not (= c1 c2))))
       (define ok?
         (and distinct?
              (eq? mc 'QFree) (eq? m1 'QFree) (eq? m2 'QFree)
              (eq? rc 'CanonicalMod) (eq? r1 'CanonicalMod) (eq? r2 'CanonicalMod)
              (not lck1) (not lck2)
              (eq? zc 'EntanglingZone) (eq? z1 'EntanglingZone) (eq? z2 'EntanglingZone)
              (not (wire-in-catlinks? c-w links))
              (not (wire-in-catlinks? c1 links))
              (not (wire-in-catlinks? c2 links))))
       (define delta-p (anf-and ac (anf-xor a1 a2)))
       (define cw1 (list-set cwires c1 `(cwire ,m1 ,r1 ,lck1 ,(anf-xor a1 delta-p) ,z1)))
       (define cw2 (list-set cw1    c2 `(cwire ,m2 ,r2 ,lck2 ,(anf-xor a2 delta-p) ,z2)))
       (define bb1 (bb-cswap (list-ref bbs c-w) (list-ref bbs c1) (list-ref bbs c2)))
       (define bb2 (bb-cswap (list-ref bbs c-w) (list-ref bbs c2) (list-ref bbs c1)))
       (define bbs1 (list-set (list-set bbs c1 bb1) c2 bb2))
       (values 1 1 0 lat css-round gauge cong ranks bbs1 links cw2 ok?)]
      [_ (step-gate-qec g cwires bbs ranks gauge cong links lat css-round)]))

  (define (step-gate-qec g cwires bbs ranks gauge cong links lat css-round)
    (match g
      [`(g-fpga-feedforward ,w ,d)
       (match-define `(cwire ,_m ,r ,lck ,_a ,_z) (list-ref cwires w))
       (define new-lat (+ lat d))
       (define ok? (and (<= new-lat qec-cycle-budget-ns) (eq? r 'CanonicalMod) (not lck)))
       (values 0 1 0 new-lat css-round gauge cong ranks bbs links cwires ok?)]
      [`(g-qec-barrier)
       (define all-canonical? (for/and ([cw (in-list cwires)]) (eq? (cwire-rep cw) 'CanonicalMod)))
       (define ok?
         (and (<= lat qec-cycle-budget-ns)
              (null? links)
              (eq? css-round 'CSSClosed)
              (eq? gauge 'ClosedHomologicalGauge)
              (<= cong 1)
              (not (cwires-unflagged-hook-error-spread? cwires))
              all-canonical?))
       (values 0 1 0 0 css-round gauge cong ranks bbs links cwires ok?)]
      [`(g-stim-detector ,w)
       (match-define `(cwire ,m ,r ,lck ,a ,_z) (list-ref cwires w))
       (define init-a (anf-normalize (list-ref init-anfs w)))
       (define norm-a (anf-normalize a))
       (define det-ok?
         (and (eq? m 'QFree)
              (eq? r 'CanonicalMod)
              (not lck)
              (not (wire-in-catlinks? w links))
              (not (poly-has-virtual-tag? norm-a))
              (equal? norm-a init-a)
              (or (null? norm-a) (equal? norm-a (list (list w))))
              (not (cwires-unflagged-hook-error-spread? cwires))))
       (values 0 1 0 lat css-round gauge cong ranks bbs links cwires det-ok?)]
      [`(g-css-round-begin ,mode)
       (define all-canonical? (for/and ([cw (in-list cwires)]) (eq? (cwire-rep cw) 'CanonicalMod)))
       (define ok? (and (eq? css-round 'CSSClosed) (null? links) all-canonical?))
       (define css-next (if (eq? css-round 'CSSClosed) (if (eq? mode 'Superpos) 'CSSOpenX 'CSSOpenZ) css-round))
       (values 0 1 0 lat css-next gauge cong ranks bbs links cwires ok?)]
      [`(g-css-round-end ,mode)
       (define expected (if (eq? mode 'Superpos) 'CSSOpenX 'CSSOpenZ))
       (define all-canonical? (for/and ([cw (in-list cwires)]) (eq? (cwire-rep cw) 'CanonicalMod)))
       (define ok? (and (eq? css-round expected) (null? links) all-canonical?))
       (values 0 1 0 lat 'CSSClosed gauge cong ranks bbs links cwires ok?)]
      [`(g-bb-torus-shift ,a ,b)
       (define all-qfree-canonical?
         (for/and ([cw (in-list cwires)])
           (and (eq? (cwire-mode cw) 'QFree)
                (eq? (cwire-rep cw) 'CanonicalMod)
                (not (cwire-locked cw)))))
       (define ok? (and (eq? css-round 'CSSClosed) (null? links) all-qfree-canonical? (< a 12) (< b 6)))
       (values 0 1 0 lat css-round gauge cong ranks bbs links cwires ok?)]
      [`(g-skew-add-cs ,w)
       (match-define `(cwire ,m ,r ,lck ,a ,z) (list-ref cwires w))
       (define ok?
         (and (eq? m 'QFree)
              (eq? r 'CanonicalMod)
              (not lck)
              (not (wire-in-catlinks? w links))))
       (values 0 1 0 lat css-round gauge cong ranks
               (list-set bbs w (bb-not (list-ref bbs w)))
               links
               (list-set cwires w `(cwire ,m RedundantCS ,lck ,(anf-xor a '(())) ,z))
               ok?)]
      [`(g-consolidate-cs ,w)
       (match-define `(cwire ,m ,r ,lck ,a ,z) (list-ref cwires w))
       (define ok?
         (and (eq? m 'QFree)
              (eq? r 'RedundantCS)
              (not lck)
              (not (wire-in-catlinks? w links))))
       (values 1 1 0 lat css-round gauge cong ranks bbs links
               (list-set cwires w `(cwire ,m CanonicalMod ,lck ,a ,z))
               ok?)]
      [`(g-kuperberg-collimate ,w1 ,r1 ,w2 ,r2)
       (match-define `(cwire ,m1 ,rep1 ,_lck1 ,a1 ,z1) (list-ref cwires w1))
       (match-define `(cwire ,m2 ,rep2 ,lck2 ,a2 ,z2) (list-ref cwires w2))
       (define ok?
         (and (not (= w1 w2))
              (= r1 r2)
              (eq? m1 'QFree) (eq? m2 'QFree)
              (eq? rep1 'CanonicalMod) (eq? rep2 'CanonicalMod)
              (not lck2)
              (eq? z1 'EntanglingZone) (eq? z2 'EntanglingZone)
              (not (wire-in-catlinks? w1 links))
              (not (wire-in-catlinks? w2 links))))
       (values 0 1 0 lat css-round gauge cong ranks
               (list-set bbs w2 (bb-xor (list-ref bbs w2) (list-ref bbs w1)))
               links
               (list-set cwires w2 `(cwire ,m2 ,rep2 ,lck2 ,(anf-xor a2 a1) ,z2))
               ok?)]
      [`(g-inject-fault ,w ,k)
       (match-define `(cwire ,m ,r ,lck ,a ,z) (list-ref cwires w))
       (define fault-var (+ 4 (modulo k 2)))
       (define ok? (and (eq? m 'QFree) (eq? r 'CanonicalMod) (not lck) (not (wire-in-catlinks? w links))))
       (define a-new (anf-xor a (list (list fault-var))))
       (values 0 1 0 lat css-round gauge cong ranks
               (list-set bbs w (bb-xor (list-ref bbs w) (bb-var fault-var)))
               links
               (list-set cwires w `(cwire ,m ,r ,lck ,a-new ,z))
               ok?)]
      [`(g-flag-clear ,w1 ,w2)
       (match-define `(cwire ,m1 ,r1 ,lck1 ,a1 ,z1) (list-ref cwires w1))
       (match-define `(cwire ,m2 ,r2 ,lck2 ,a2 ,z2) (list-ref cwires w2))
       (define ok?
         (and (not (= w1 w2))
              (eq? m1 'QFree) (eq? m2 'QFree)
              (eq? r1 'CanonicalMod) (eq? r2 'CanonicalMod)
              (not lck1) (not lck2)
              (or (anf-depends-on-var? a2 4) (anf-depends-on-var? a2 5)
                  (and (not (anf-depends-on-var? a1 4)) (not (anf-depends-on-var? a1 5))))))
       (define cwires-clean
         (for/list ([idx (in-range (length cwires))])
           (match-define `(cwire ,m ,r ,lck ,a ,z) (list-ref cwires idx))
           (define a-c (anf-clear-fault-vars a))
           `(cwire ,m ,r ,lck ,(if (or (= idx w1) (= idx w2)) '() a-c) ,z)))
       (define bbs-clean
         (for/list ([cw (in-list cwires-clean)])
           (anf->bitboard (cwire-anf cw))))
       (values 0 1 0 lat css-round gauge cong ranks bbs-clean links cwires-clean ok?)]
      [`(g-cultivate-step ,w ,r)
       (match-define `(cwire ,m ,rep ,lck ,a ,z) (list-ref cwires w))
       (define cur-r (list-ref ranks w))
       (define ok?
         (and (eq? m 'QFree) (eq? rep 'CanonicalMod) (not lck)
              (= r (+ cur-r 1))
              (not (anf-depends-on-var? a 4))
              (not (anf-depends-on-var? a 5))))
       (values 0 1 0 lat css-round gauge cong
               (list-set ranks w r)
               bbs links cwires ok?)]
      [`(g-inject-magic-t ,w ,target-r)
       (match-define `(cwire ,m ,rep ,lck ,a ,z) (list-ref cwires w))
       (define cur-r (list-ref ranks w))
       (define ok?
         (and (eq? m 'QFree) (eq? rep 'CanonicalMod) (not lck)
              (>= cur-r target-r)
              (> target-r 0)
              (not (anf-depends-on-var? a 4))
              (not (anf-depends-on-var? a 5))))
       (values 1 1 0 lat css-round gauge cong
               (list-set ranks w 0)
               bbs links cwires ok?)]
      [`(g-ppm-bus ,l ,r)
       (match-define `(cwire ,ml ,rl ,lckl ,al ,zl) (list-ref cwires l))
       (match-define `(cwire ,mr ,rr ,lckr ,ar ,zr) (list-ref cwires r))
       (define ok?
         (and (<= l r)
              (eq? ml 'QFree) (eq? mr 'QFree)
              (eq? rl 'CanonicalMod) (eq? rr 'CanonicalMod)
              (not lckr)
              (eq? zl 'EntanglingZone) (eq? zr 'EntanglingZone)))
       (define cw1
         (if (= l r)
             cwires
             (list-set cwires r `(cwire ,mr ,rr ,lckr ,(anf-xor ar al) ,zr))))
       (define bbs1
         (if (= l r)
             bbs
             (list-set bbs r (bb-xor (list-ref bbs r) (list-ref bbs l)))))
       (values 0 1 0 lat css-round gauge (max cong 1) ranks bbs1 links cw1 ok?)]
      [`(g-gauge-open ,w)
       (match-define `(cwire ,m ,r ,lck ,_a ,_z) (list-ref cwires w))
       (define ok? (and (eq? m 'QFree) (eq? r 'CanonicalMod) (not lck) (eq? gauge 'ClosedHomologicalGauge)))
       (values 0 1 0 lat css-round 'OpenBoundaryGauge cong ranks bbs links cwires ok?)]
      [`(g-gauge-fix ,w)
       (match-define `(cwire ,m ,r ,lck ,_a ,_z) (list-ref cwires w))
       (define ok? (and (eq? m 'QFree) (eq? r 'CanonicalMod) (not lck) (eq? gauge 'OpenBoundaryGauge)))
       (values 0 1 0 lat css-round 'ClosedHomologicalGauge cong ranks bbs links cwires ok?)]
      [`(g-code-switch-transversal-t ,w)
       (match-define `(cwire ,m ,r ,lck ,_a ,_z) (list-ref cwires w))
       (define ok?
         (and (eq? m 'QFree) (eq? r 'CanonicalMod) (not lck)
              (eq? gauge 'ClosedHomologicalGauge)
              (eq? css-round 'CSSClosed)))
       (values 1 1 0 lat css-round gauge cong ranks bbs links cwires ok?)]
      [`(g-native-ccz ,c1 ,c2 ,c3)
       (match-define `(cwire ,m1 ,r1 ,_l1 ,_a1 ,z1) (list-ref cwires c1))
       (match-define `(cwire ,m2 ,r2 ,_l2 ,_a2 ,z2) (list-ref cwires c2))
       (match-define `(cwire ,m3 ,r3 ,_l3 ,_a3 ,z3) (list-ref cwires c3))
       (define distinct? (and (not (= c1 c2)) (not (= c1 c3)) (not (= c2 c3))))
       (define ok?
         (and distinct?
              (eq? m1 'QFree) (eq? m2 'QFree) (eq? m3 'QFree)
              (eq? r1 'CanonicalMod) (eq? r2 'CanonicalMod) (eq? r3 'CanonicalMod)
              (eq? z1 'EntanglingZone) (eq? z2 'EntanglingZone) (eq? z3 'EntanglingZone)))
       (values 0 1 0 lat css-round gauge cong ranks bbs links cwires ok?)]
      [`(g-native-iswap ,q1 ,q2)
       (match-define `(cwire ,m1 ,r1 ,lck1 ,a1 ,z1) (list-ref cwires q1))
       (match-define `(cwire ,m2 ,r2 ,lck2 ,a2 ,z2) (list-ref cwires q2))
       (define ok?
         (and (not (= q1 q2))
              (eq? m1 'QFree) (eq? m2 'QFree)
              (eq? r1 'CanonicalMod) (eq? r2 'CanonicalMod)
              (not lck1) (not lck2)
              (eq? z1 'EntanglingZone) (eq? z2 'EntanglingZone)))
       (define cw1 (list-set cwires q1 `(cwire ,m1 ,r1 ,lck1 ,a2 ,z1)))
       (define cw2 (list-set cw1    q2 `(cwire ,m2 ,r2 ,lck2 ,a1 ,z2)))
       (define bbs1 (list-set (list-set bbs q1 (list-ref bbs q2)) q2 (list-ref bbs q1)))
       (values 0 1 0 lat css-round gauge cong ranks bbs1 links cw2 ok?)]
      [`(g-rzz ,q1 ,q2 ,_theta)
       (match-define `(cwire ,m1 ,r1 ,_lck1 ,_a1 ,z1) (list-ref cwires q1))
       (match-define `(cwire ,m2 ,r2 ,_lck2 ,_a2 ,z2) (list-ref cwires q2))
       (define ok?
         (and (not (= q1 q2))
              (eq? m1 'QFree) (eq? m2 'QFree)
              (eq? r1 'CanonicalMod) (eq? r2 'CanonicalMod)
              (eq? z1 'EntanglingZone) (eq? z2 'EntanglingZone)))
       (values 0 1 0 lat css-round gauge cong ranks bbs links cwires ok?)]
      [`(g-virtual-rz ,q ,_theta)
       (match-define `(cwire ,_m ,r ,_lck ,_a ,_z) (list-ref cwires q))
       (values 0 0 0 lat css-round gauge cong ranks bbs links cwires (eq? r 'CanonicalMod))]
      [`(g-meas ,kind ,q)
       (match-define `(cwire ,m ,r ,lck ,a ,z) (list-ref cwires q))
       (define new-lat (+ lat (gate-latency-ns g)))
       (define ok? (and (<= new-lat qec-cycle-budget-ns) (eq? m 'QFree) (eq? r 'CanonicalMod) (not lck)))
       (define cw-new
         (if (eq? kind 'meas-mcmr-reuse)
             (list-set cwires q `(cwire QFree CanonicalMod ,lck () ,z))
             (list-set cwires q `(cwire QFree CanonicalMod ,lck ,a ,z))))
       (define bbs-new
         (if (eq? kind 'meas-mcmr-reuse)
             (list-set bbs q 0)
             bbs))
       (values 0 1 0 new-lat css-round gauge cong ranks bbs-new links cw-new ok?)]
      [`(g-seq ,g1 ,g2)
       (define-values (t1 d1 e1 lat1 css1 g1-st cg1 rk1 bb1 l1 cw1 ok1)
         (step-gate g1 cwires bbs ranks gauge cong links lat css-round))
       (define-values (t2 d2 e2 lat2 css2 g2-st cg2 rk2 bb2 l2 cw2 ok2)
         (step-gate g2 cw1 bb1 rk1 g1-st cg1 l1 lat1 css1))
       (values (+ t1 t2) (+ d1 d2) (+ e1 e2) lat2 css2 g2-st (max cg1 cg2) rk2 bb2 l2 cw2 (and ok1 ok2))]))

  (define (synth-with-uncompute u v cwires bbs ranks gauge cong links lat css-round)
    (define u-all (circuit-all-wires u))
    (define u-writes (circuit-write-set u))
    (define u-strictly-invertible?
      (and (nbe-circuit-strictly-invertible-qfree? u)
           (eq? css-round 'CSSClosed)
           (eq? gauge 'ClosedHomologicalGauge)
           (null? links)
           (for/and ([w (in-list u-all)])
             (match-define `(cwire ,m ,r ,lck ,_a ,_z) (list-ref cwires w))
             (and (eq? m 'QFree)
                  (eq? r 'CanonicalMod)
                  (not lck)
                  (not (wire-in-catlinks? w links))))))
    (define-values (tu du eu latu cssu gu cgu rku bbu lu cwu oku)
      (synth u cwires bbs ranks gauge cong links lat css-round))
    (define u-post-canonical?
      (and (= eu 0)
           (null? lu)
           (eq? cssu 'CSSClosed)
           (eq? gu 'ClosedHomologicalGauge)
           (for/and ([cw (in-list cwu)])
             (and (eq? (cwire-mode cw) 'QFree)
                  (eq? (cwire-rep cw) 'CanonicalMod)))))
    (define-values (tv dv ev latv cssv gv cgv rkv bbv lv cwv okv)
      (synth v cwu bbu rku gu cgu lu latu cssu))
    (define v-preserves-u?
      (and (eq? cssv cssu)
           (eq? gv gu)
           (null? lv)
           (null? (set-intersect (circuit-xwrite-set v) u-all))
           (null? (set-intersect (circuit-hadamard-set v) u-all))
           (for/and ([w (in-list u-all)])
             (and (equal? (list-ref cwv w) (list-ref cwu w))
                  (= (list-ref bbv w) (list-ref bbu w))))))
    (define-values (tud dud eud latud cssud gud cgud rkud bbud lud cwud okud)
      (synth (circuit-dag u) cwv bbv rkv gv cgv lv latv cssv))
    (define u-restored?
      (for/and ([w (in-list u-writes)])
        (and (equal? (list-ref cwud w) (list-ref cwires w))
             (= (list-ref bbud w) (list-ref bbs w)))))
    (values (+ tu tv tud) (+ du dv dud) (+ eu ev eud)
            latud cssud gud (max cgu cgv cgud) rkud bbud lud cwud
            (and u-strictly-invertible? oku u-post-canonical? okv v-preserves-u? okud u-restored?)))

  (define (synth-with-locked-pebble p u v cwires bbs ranks gauge cong links lat css-round)
    (define u-all (circuit-all-wires u))
    (define u-writes (circuit-write-set u))
    (define u-strictly-invertible?
      (and (nbe-circuit-strictly-invertible-qfree? u)
           (eq? css-round 'CSSClosed)
           (eq? gauge 'ClosedHomologicalGauge)
           (null? links)
           (not (cwire-locked (list-ref cwires p)))
           (for/and ([w (in-list u-all)])
             (match-define `(cwire ,m ,r ,lck ,_a ,_z) (list-ref cwires w))
             (and (eq? m 'QFree)
                  (eq? r 'CanonicalMod)
                  (not lck)
                  (not (wire-in-catlinks? w links))))))
    (define-values (tu du eu latu cssu gu cgu rku bbu lu cwu oku)
      (synth u cwires bbs ranks gauge cong links lat css-round))
    (define u-post-canonical?
      (and (= eu 0)
           (null? lu)
           (eq? cssu 'CSSClosed)
           (eq? gu 'ClosedHomologicalGauge)
           (for/and ([cw (in-list cwu)])
             (and (eq? (cwire-mode cw) 'QFree)
                  (eq? (cwire-rep cw) 'CanonicalMod)))))
    (define cwu-locked
      (list-update cwu p (lambda (cw) (cwire-set-locked cw #t))))
    (define-values (tv dv ev latv cssv gv cgv rkv bbv lv cwv-locked okv)
      (synth v cwu-locked bbu rku gu cgu lu latu cssu))
    (define cwv
      (list-update cwv-locked p (lambda (cw) (cwire-set-locked cw (cwire-locked (list-ref cwires p))))))
    (define v-preserves-u?
      (and (eq? cssv cssu)
           (eq? gv gu)
           (null? lv)
           (not (member p (circuit-write-set v)))
           (null? (set-intersect (circuit-xwrite-set v) u-all))
           (null? (set-intersect (circuit-hadamard-set v) u-all))
           (for/and ([w (in-list u-all)])
             (and (equal? (list-ref cwv w) (list-ref cwu w))
                  (= (list-ref bbv w) (list-ref bbu w))))))
    (define-values (tud dud eud latud cssud gud cgud rkud bbud lud cwud okud)
      (synth (circuit-dag u) cwv bbv rkv gv cgv lv latv cssv))
    (define u-restored?
      (for/and ([w (in-list (remove-duplicates (cons p u-writes) =))])
        (and (equal? (list-ref cwud w) (list-ref cwires w))
             (= (list-ref bbud w) (list-ref bbs w)))))
    (values (+ tu tv tud) (+ du dv dud) (+ eu ev eud)
            latud cssud gud (max cgu cgv cgud) rkud bbud lud cwud
            (and u-strictly-invertible? oku u-post-canonical? okv v-preserves-u? okud u-restored?)))

  (define (synth-par-diag c1 c2 cwires bbs ranks gauge cong links lat css-round)
    (define all1 (circuit-all-wires c1))
    (define all2 (circuit-all-wires c2))
    (define shared (set-intersect all1 all2))
    (define mut1 (append (circuit-xwrite-set c1) (circuit-hadamard-set c1) (circuit-shuttle-set c1)))
    (define mut2 (append (circuit-xwrite-set c2) (circuit-hadamard-set c2) (circuit-shuttle-set c2)))
    (define bus-overlap?
      (bus-intervals-overlap? (circuit-ppm-intervals c1) (circuit-ppm-intervals c2)))
    (define shared-coherent?
      (and (not bus-overlap?)
           (null? (set-intersect mut1 all2))
           (null? (set-intersect mut2 all1))
           (for/and ([w (in-list shared)])
             (and (eq? (cwire-mode (list-ref cwires w)) 'QFree)
                  (eq? (cwire-rep  (list-ref cwires w)) 'CanonicalMod)))))
    (define-values (t1 d1 e1 lat1 css1 g1 cg1 rk1 bb1 l1 cw1 ok1)
      (synth c1 cwires bbs ranks gauge cong links lat css-round))
    (define-values (t2 d2 e2 lat2 css12 g12 cg12 rk12 bb12 l12 cw12 ok2)
      (synth c2 cw1 bb1 rk1 g1 cg1 l1 lat css1))
    (define-values (_t2a _d2a _e2a _lat2a css2 g2 cg2 rk2 bb2 l2 cw2 ok2a)
      (synth c2 cwires bbs ranks gauge cong links lat css-round))
    (define-values (_t1a _d1a _e1a _lat1a css21 g21 cg21 rk21 bb21 l21 cw21 ok1a)
      (synth c1 cw2 bb2 rk2 g2 cg2 l2 lat css2))
    (define new-cong (if bus-overlap? 2 (max cg1 cg12 cg2 cg21)))
    (define commute-ok?
      (and (equal? l12 l21) (equal? cw12 cw21) (equal? bb12 bb21)
           (equal? rk12 rk21) (eq? css12 css21) (eq? g12 g21) ok1a ok2a))
    (values (+ t1 t2) (max d1 d2) (+ e1 e2)
            (max lat1 lat2) css12 g12 new-cong rk12 bb12 l12 cw12
            (and ok1 ok2 shared-coherent? commute-ok? (<= new-cong 1))))

  (define (synth circ cwires bbs ranks gauge cong links lat css-round)
    (match circ
      [`(c-gate ,g) (step-gate g cwires bbs ranks gauge cong links lat css-round)]
      [`(c-seq ,c1 ,c2)
       (define-values (t1 d1 e1 lat1 css1 g1 cg1 rk1 bb1 l1 cw1 ok1)
         (synth c1 cwires bbs ranks gauge cong links lat css-round))
       (define-values (t2 d2 e2 lat2 css2 g2 cg2 rk2 bb2 l2 cw2 ok2)
         (synth c2 cw1 bb1 rk1 g1 cg1 l1 lat1 css1))
       (values (+ t1 t2) (+ d1 d2) (+ e1 e2) lat2 css2 g2 (max cg1 cg2) rk2 bb2 l2 cw2 (and ok1 ok2))]
      [`(c-dag ,inner)
       (define unit-ok? (circuit-unitary-only? inner))
       (define-values (t d e lat1 css1 g1 cg1 rk1 bb1 l cw ok)
         (synth (circuit-dag inner) cwires bbs ranks gauge cong links lat css-round))
       (values t d e lat1 css1 g1 cg1 rk1 bb1 l cw (and unit-ok? ok))]
      [`(c-with-uncompute ,u ,v)
       (synth-with-uncompute u v cwires bbs ranks gauge cong links lat css-round)]
      [`(c-with-locked-pebble ,p ,u ,v)
       (synth-with-locked-pebble p u v cwires bbs ranks gauge cong links lat css-round)]
      [`(c-par-diag ,c1 ,c2)
       (synth-par-diag c1 c2 cwires bbs ranks gauge cong links lat css-round)]
      [`(c-unsafe-widen-refinement ,w ,inner)
       (match-define `(cwire ,m ,r ,lck ,a ,_z) (list-ref cwires w))
       (define smt-widen-vc-ok?
         (and (eq? m 'QFree)
              (eq? r 'CanonicalMod)
              (not lck)
              (not (wire-in-catlinks? w links))
              (equal? (anf-normalize a) (anf-normalize (list-ref init-anfs w)))))
       (define-values (t1 d1 e1 lat1 css1 g1 cg1 rk1 bb1 l1 cw1 ok1)
         (synth inner cwires bbs ranks gauge cong links lat css-round))
       (values t1 d1 e1 lat1 css1 g1 cg1 rk1 bb1 l1 cw1 (and smt-widen-vc-ok? ok1))]
      [`(c-voqc-opt ,inner)
       (synth (voqc-optimize-canonical inner) cwires bbs ranks gauge cong links lat css-round)]))

  (define norm-circ (voqc-optimize-canonical raw-circ))
  (define-values (toff depth ebits final-lat final-css final-gauge final-cong final-ranks final-bbs final-links final-cwires ok?)
    (synth norm-circ init-cwires init-bbs init-ranks 'ClosedHomologicalGauge 0 '() 0 'CSSClosed))
  (define all-canonical-and-unlocked?
    (for/and ([cw (in-list final-cwires)])
      (and (eq? (cwire-rep cw) 'CanonicalMod)
           (not (cwire-locked cw))
           (not (anf-depends-on-var? (cwire-anf cw) 4))
           (not (anf-depends-on-var? (cwire-anf cw) 5)))))
  (define closed-ok?
    (and ok?
         (eq? final-css 'CSSClosed)
         (eq? final-gauge 'ClosedHomologicalGauge)
         (<= final-cong 1)
         (not (cwires-unflagged-hook-error-spread? final-cwires))
         (null? final-links)
         (<= final-lat qec-cycle-budget-ns)
         all-canonical-and-unlocked?))
  (define netlist
    (if closed-ok?
        (erase-to-netlist-raw norm-circ)
        '()))
  `(qec-nbe-grade
    (toffolis ,toff)
    (depth ,depth)
    (ebits ,ebits)
    (latency-ns ,final-lat)
    (css-round ,final-css)
    (gauge-state ,final-gauge)
    (max-congestion ,final-cong)
    (cultivation-ranks ,final-ranks)
    (bitboards ,final-bbs)
    (live-links ,final-links)
    (wire-states ,final-cwires)
    (canonical-netlist ,netlist)
    (ok? ,closed-ok?)))

(define (qec-nbe-restoration-law-holds? qnbeg init-anfs aux-wires)
  (match-define `(qec-nbe-grade (toffolis ,_) (depth ,_) (ebits ,_) (latency-ns ,lat)
                                (css-round ,css) (gauge-state ,gauge) (max-congestion ,cong)
                                (cultivation-ranks ,_) (bitboards ,_) (live-links ,links)
                                (wire-states ,cwires) (canonical-netlist ,_) (ok? ,ok?)) qnbeg)
  (and ok?
       (eq? css 'CSSClosed)
       (eq? gauge 'ClosedHomologicalGauge)
       (<= cong 1)
       (null? links)
       (<= lat qec-cycle-budget-ns)
       (for/and ([cw (in-list cwires)])
         (and (eq? (cwire-rep cw) 'CanonicalMod)
              (not (cwire-locked cw))))
       (for/and ([w (in-list aux-wires)])
         (match-define `(cwire ,mode ,rep ,lck ,anf ,_zone) (list-ref cwires w))
         (and (eq? mode 'QFree)
              (eq? rep 'CanonicalMod)
              (not lck)
              (equal? (anf-normalize anf)
                      (anf-normalize (list-ref init-anfs w)))))))

;; `hasheq` Memoized NbE Grade Table (Simplification S14):
(define *memo-nbe-grade-table* (make-hasheq))
(define *default-init-anfs* '(((0)) ((1)) ((2)) ()))
(define *default-init-zones* '(EntanglingZone EntanglingZone EntanglingZone EntanglingZone))

(define (memo-nbe-grade circ [init-anfs *default-init-anfs*] [init-zones *default-init-zones*])
  (if (and (equal? init-anfs *default-init-anfs*)
           (equal? init-zones *default-init-zones*)
           (not (surface-qterm? circ)))
      (let ([hc (hc-circuit circ)])
        (hash-ref! *memo-nbe-grade-table* hc
                   (lambda () (Synthesize-QEC-NbE-Grade hc init-anfs init-zones))))
      (Synthesize-QEC-NbE-Grade circ init-anfs init-zones)))

(define (Synthesize-NbE-Grade-legacy surf-or-circ init-anfs init-zones)
  (define raw-circ
    (if (surface-qterm? surf-or-circ)
        (desugar-qdo-raw surf-or-circ)
        surf-or-circ))
  (define init-cwires
    (for/list ([a (in-list init-anfs)]
               [z (in-list init-zones)])
      `(cwire QFree CanonicalMod #f ,(anf-normalize a) ,z)))

  (define (step-gate g cwires links lat css-round)
    (match g
      [`(g-skew-add-cs ,w)
       ;; Fix F17: Requires CanonicalMod on entry and transitions to RedundantCS!
       (match-define `(cwire ,m ,r ,lck ,a ,z) (list-ref cwires w))
       (define ok?
         (and (eq? m 'QFree)
              (eq? r 'CanonicalMod)
              (not lck)
              (not (wire-in-catlinks? w links))))
       (values 0 1 0 lat css-round links
               (list-set cwires w `(cwire ,m RedundantCS ,lck ,(anf-xor a '(())) ,z))
               ok?)]
      [`(g-consolidate-cs ,w)
       ;; Fix F17: Requires RedundantCS on entry and transitions to CanonicalMod!
       (match-define `(cwire ,m ,r ,lck ,a ,z) (list-ref cwires w))
       (define ok?
         (and (eq? m 'QFree)
              (eq? r 'RedundantCS)
              (not lck)
              (not (wire-in-catlinks? w links))))
       (values 1 1 0 lat css-round links
               (list-set cwires w `(cwire ,m CanonicalMod ,lck ,a ,z))
               ok?)]
      [`(g-kuperberg-collimate ,w1 ,r1 ,w2 ,r2)
       ;; Fix F19: Kuperberg collimation sieve requires matching ranks r1 == r2!
       (match-define `(cwire ,m1 ,rep1 ,_lck1 ,a1 ,z1) (list-ref cwires w1))
       (match-define `(cwire ,m2 ,rep2 ,lck2 ,a2 ,z2) (list-ref cwires w2))
       (define ok?
         (and (not (= w1 w2))
              (= r1 r2)
              (eq? m1 'QFree) (eq? m2 'QFree)
              (eq? rep1 'CanonicalMod) (eq? rep2 'CanonicalMod)
              (not lck2)
              (eq? z1 'EntanglingZone) (eq? z2 'EntanglingZone)
              (not (wire-in-catlinks? w1 links))
              (not (wire-in-catlinks? w2 links))))
       (values 0 1 0 lat css-round links
               (list-set cwires w2 `(cwire ,m2 ,rep2 ,lck2 ,(anf-xor a2 a1) ,z2))
               ok?)]
      [_
       ;; Delegate remaining gates to Certified Compiler single-gate semantics:
       (match-define `(cert-grade (toffolis ,t) (depth ,d) (ebits ,e) (latency-ns ,lat1)
                                  (css-round ,css1) (live-links ,l1)
                                  (wire-states ,cw1) (ok? ,ok1))
         ;; Step single gate by invoking step logic directly:
         (let ()
           (match g
             [`(g-id)
              `(cert-grade (toffolis 0) (depth 0) (ebits 0) (latency-ns ,lat)
                           (css-round ,css-round) (live-links ,links) (wire-states ,cwires) (ok? #t))]
             [`(g-x ,w)
              (match-define `(cwire ,m ,r ,lck ,a ,z) (list-ref cwires w))
              (define ok? (and (eq? m 'QFree) (eq? r 'CanonicalMod) (not lck) (not (wire-in-catlinks? w links))))
              `(cert-grade (toffolis 0) (depth 1) (ebits 0) (latency-ns ,lat)
                           (css-round ,css-round) (live-links ,links)
                           (wire-states ,(list-set cwires w `(cwire ,m ,r ,lck ,(anf-xor a '(())) ,z)))
                           (ok? ,ok?))]
             [`(g-z ,w)
              (match-define `(cwire ,m ,r ,lck ,a ,z) (list-ref cwires w))
              (define ok? (eq? r 'CanonicalMod))
              (define a-new (if (eq? m 'Superpos) (anf-xor a (list (xphase-mono w))) a))
              `(cert-grade (toffolis 0) (depth 1) (ebits 0) (latency-ns ,lat)
                           (css-round ,css-round) (live-links ,links)
                           (wire-states ,(list-set cwires w `(cwire ,m ,r ,lck ,a-new ,z)))
                           (ok? ,ok?))]
             [`(g-h ,w)
              (match-define `(cwire ,m ,r ,lck ,a ,z) (list-ref cwires w))
              (define pre-ok? (and (eq? r 'CanonicalMod) (not lck) (not (wire-in-catlinks? w links))))
              (cond
                [(not pre-ok?)
                 `(cert-grade (toffolis 0) (depth 1) (ebits 0) (latency-ns ,lat)
                              (css-round ,css-round) (live-links ,links)
                              (wire-states ,(list-set cwires w `(cwire Superpos ,r ,lck ,a ,z)))
                              (ok? #f))]
                [(eq? m 'QFree)
                 `(cert-grade (toffolis 0) (depth 1) (ebits 0) (latency-ns ,lat)
                              (css-round ,css-round) (live-links ,links)
                              (wire-states ,(list-set cwires w `(cwire Superpos ,r ,lck ,a ,z)))
                              (ok? #t))]
                [else
                 (define dz? (poly-has-mono? a (xphase-mono w)))
                 (define a-clean (if dz? (anf-xor (anf-xor a (list (xphase-mono w))) '(())) a))
                 `(cert-grade (toffolis 0) (depth 1) (ebits 0) (latency-ns ,lat)
                              (css-round ,css-round) (live-links ,links)
                              (wire-states ,(list-set cwires w `(cwire QFree ,r ,lck ,a-clean ,z)))
                              (ok? #t))])]
             [`(g-cnot ,c-w ,t-w)
              (match-define `(cwire ,mc ,rc ,_lckc ,ac ,zc) (list-ref cwires c-w))
              (match-define `(cwire ,mt ,rt ,lckt ,at ,zt) (list-ref cwires t-w))
              (define ok?
                (and (not (= c-w t-w))
                     (eq? mc 'QFree) (eq? mt 'QFree)
                     (eq? rc 'CanonicalMod) (eq? rt 'CanonicalMod)
                     (not lckt)
                     (eq? zc 'EntanglingZone) (eq? zt 'EntanglingZone)
                     (not (wire-in-catlinks? c-w links))
                     (not (wire-in-catlinks? t-w links))))
              `(cert-grade (toffolis 0) (depth 1) (ebits 0) (latency-ns ,lat)
                           (css-round ,css-round) (live-links ,links)
                           (wire-states ,(list-set cwires t-w `(cwire ,mt ,rt ,lckt ,(anf-xor at ac) ,zt)))
                           (ok? ,ok?))]
             [`(g-cz ,c1 ,c2)
              (match-define `(cwire ,m1 ,r1 ,lck1 ,a1 ,z1) (list-ref cwires c1))
              (match-define `(cwire ,m2 ,r2 ,lck2 ,a2 ,z2) (list-ref cwires c2))
              (define ok?
                (and (not (= c1 c2))
                     (eq? m1 'QFree) (eq? m2 'QFree)
                     (eq? r1 'CanonicalMod) (eq? r2 'CanonicalMod)
                     (eq? z1 'EntanglingZone) (eq? z2 'EntanglingZone)))
              (define cw1 (if (eq? m1 'Superpos) (list-set cwires c1 `(cwire ,m1 ,r1 ,lck1 ,(anf-xor a1 (list (xphase-mono c1))) ,z1)) cwires))
              (define cw2 (if (eq? m2 'Superpos) (list-set cw1 c2 `(cwire ,m2 ,r2 ,lck2 ,(anf-xor a2 (list (xphase-mono c2))) ,z2)) cw1))
              `(cert-grade (toffolis 0) (depth 1) (ebits 0) (latency-ns ,lat)
                           (css-round ,css-round) (live-links ,links)
                           (wire-states ,cw2) (ok? ,ok?))]
             [(or `(g-ccx ,c1 ,c2 ,t) `(g-compute-and ,c1 ,c2 ,t) `(g-and-compute ,c1 ,c2 ,t)
                  `(g-rccx ,c1 ,c2 ,t) `(g-rccx-dag ,c1 ,c2 ,t))
              (match-define `(cwire ,m1 ,r1 ,_lck1 ,a1 ,z1) (list-ref cwires c1))
              (match-define `(cwire ,m2 ,r2 ,_lck2 ,a2 ,z2) (list-ref cwires c2))
              (match-define `(cwire ,mt ,rt ,lckt ,at ,zt) (list-ref cwires t))
              (define distinct? (and (not (= c1 c2)) (not (= c1 t)) (not (= c2 t))))
              (define ok?
                (and distinct?
                     (eq? m1 'QFree) (eq? m2 'QFree) (eq? mt 'QFree)
                     (eq? r1 'CanonicalMod) (eq? r2 'CanonicalMod) (eq? rt 'CanonicalMod)
                     (not lckt)
                     (eq? z1 'EntanglingZone) (eq? z2 'EntanglingZone) (eq? zt 'EntanglingZone)
                     (not (wire-in-catlinks? c1 links))
                     (not (wire-in-catlinks? c2 links))
                     (not (wire-in-catlinks? t links))))
              `(cert-grade (toffolis ,(if (or (eq? (car g) 'g-rccx) (eq? (car g) 'g-rccx-dag)) 0 1))
                           (depth 1) (ebits 0) (latency-ns ,lat)
                           (css-round ,css-round) (live-links ,links)
                           (wire-states ,(list-set cwires t `(cwire ,mt ,rt ,lckt ,(anf-xor at (anf-and a1 a2)) ,zt)))
                           (ok? ,ok?))]
             [(or `(g-hmr-cz ,t ,c1 ,c2 ,_) `(g-hmr-cz ,t ,c1 ,c2))
              (match-define `(cwire ,mt ,rt ,lckt ,at ,zt) (list-ref cwires t))
              (match-define `(cwire ,m1 ,r1 ,_lck1 ,a1 ,z1) (list-ref cwires c1))
              (match-define `(cwire ,m2 ,r2 ,_lck2 ,a2 ,z2) (list-ref cwires c2))
              (define distinct? (and (not (= c1 c2)) (not (= c1 t)) (not (= c2 t))))
              (define new-lat (+ lat 150))
              (define ok?
                (and distinct?
                     (<= new-lat qec-cycle-budget-ns)
                     (eq? mt 'QFree) (eq? m1 'QFree) (eq? m2 'QFree)
                     (eq? rt 'CanonicalMod) (eq? r1 'CanonicalMod) (eq? r2 'CanonicalMod)
                     (not lckt)
                     (eq? zt 'EntanglingZone) (eq? z1 'EntanglingZone) (eq? z2 'EntanglingZone)
                     (not (wire-in-catlinks? t links))
                     (not (wire-in-catlinks? c1 links))
                     (not (wire-in-catlinks? c2 links))
                     (equal? (anf-normalize at) (anf-normalize (anf-and a1 a2)))))
              `(cert-grade (toffolis 0) (depth 1) (ebits 0) (latency-ns ,new-lat)
                           (css-round ,css-round) (live-links ,links)
                           (wire-states ,(list-set cwires t `(cwire QFree CanonicalMod ,lckt () ,zt)))
                           (ok? ,ok?))]
             [`(g-zone-shuttle ,w ,z-target)
              (match-define `(cwire ,m ,r ,lck ,a ,_) (list-ref cwires w))
              `(cert-grade (toffolis 0) (depth 1) (ebits 0) (latency-ns ,lat)
                           (css-round ,css-round) (live-links ,links)
                           (wire-states ,(list-set cwires w `(cwire ,m ,r ,lck ,a ,z-target)))
                           (ok? ,(not lck)))]
             [`(g-twirl-step ,w ,pol)
              (match-define `(cwire ,m ,r ,lck ,a ,z) (list-ref cwires w))
              (define ok? (and (eq? m 'QFree) (eq? r 'CanonicalMod) (not lck) (not (wire-in-catlinks? w links))))
              (define a-new (if (eq? pol 'TwirlOdd) (anf-xor a '(())) a))
              `(cert-grade (toffolis 0) (depth 1) (ebits 0) (latency-ns ,lat)
                           (css-round ,css-round) (live-links ,links)
                           (wire-states ,(list-set cwires w `(cwire ,m ,r ,lck ,a-new ,z)))
                           (ok? ,ok?))]
             [`(g-tele-cnot ,c-w ,t-w)
              (match-define `(cwire ,mc ,rc ,_lckc ,ac ,zc) (list-ref cwires c-w))
              (match-define `(cwire ,mt ,rt ,lckt ,at ,zt) (list-ref cwires t-w))
              (define new-lat (+ lat 200))
              (define ok?
                (and (not (= c-w t-w))
                     (<= new-lat qec-cycle-budget-ns)
                     (eq? mc 'QFree) (eq? mt 'QFree)
                     (eq? rc 'CanonicalMod) (eq? rt 'CanonicalMod)
                     (not lckt)
                     (eq? zc 'EntanglingZone) (eq? zt 'EntanglingZone)
                     (not (wire-in-catlinks? t-w links))))
              `(cert-grade (toffolis 0) (depth 1) (ebits 1) (latency-ns ,new-lat)
                           (css-round ,css-round) (live-links ,links)
                           (wire-states ,(list-set cwires t-w `(cwire ,mt ,rt ,lckt ,(anf-xor at ac) ,zt)))
                           (ok? ,ok?))]
             [`(g-cat-entangle ,c-w ,t-w)
              (match-define `(cwire ,mc ,rc ,_lckc ,ac ,zc) (list-ref cwires c-w))
              (match-define `(cwire ,mt ,rt ,lckt ,at ,zt) (list-ref cwires t-w))
              (define pair (list c-w t-w))
              (define new-lat (+ lat 150))
              (define ok?
                (and (not (= c-w t-w))
                     (<= new-lat qec-cycle-budget-ns)
                     (eq? mc 'QFree) (eq? mt 'QFree)
                     (eq? rc 'CanonicalMod) (eq? rt 'CanonicalMod)
                     (not lckt)
                     (eq? zc 'EntanglingZone) (eq? zt 'EntanglingZone)
                     (null? (anf-normalize at))
                     (not (member pair links))
                     (not (wire-in-catlinks? t-w links))))
              `(cert-grade (toffolis 0) (depth 1) (ebits 1) (latency-ns ,new-lat)
                           (css-round ,css-round) (live-links ,(cons pair links))
                           (wire-states ,(list-set cwires t-w `(cwire QFree CanonicalMod ,lckt ,ac ,zt)))
                           (ok? ,ok?))]
             [`(g-cat-disentangle ,c-w ,t-w)
              (match-define `(cwire ,mc ,rc ,_lckc ,ac ,zc) (list-ref cwires c-w))
              (match-define `(cwire ,mt ,rt ,lckt ,at ,zt) (list-ref cwires t-w))
              (define pair (list c-w t-w))
              (define new-lat (+ lat 150))
              (define lifo-top? (and (pair? links) (equal? (car links) pair)))
              (define ok?
                (and lifo-top?
                     (<= new-lat qec-cycle-budget-ns)
                     (eq? mc 'QFree) (eq? mt 'QFree)
                     (eq? rc 'CanonicalMod) (eq? rt 'CanonicalMod)
                     (not lckt)
                     (eq? zc 'EntanglingZone) (eq? zt 'EntanglingZone)
                     (equal? (anf-normalize at) (anf-normalize ac))))
              (define links-new (if lifo-top? (cdr links) (remove pair links)))
              `(cert-grade (toffolis 0) (depth 1) (ebits 0) (latency-ns ,new-lat)
                           (css-round ,css-round) (live-links ,links-new)
                           (wire-states ,(list-set cwires t-w `(cwire QFree CanonicalMod ,lckt () ,zt)))
                           (ok? ,(not (not ok?))))]
             [`(g-cmp-gt ,c1 ,c2 ,t)
              (match-define `(cwire ,m1 ,r1 ,_lck1 ,a1 ,z1) (list-ref cwires c1))
              (match-define `(cwire ,m2 ,r2 ,_lck2 ,a2 ,z2) (list-ref cwires c2))
              (match-define `(cwire ,mt ,rt ,lckt ,at ,zt) (list-ref cwires t))
              (define distinct? (and (not (= c1 c2)) (not (= c1 t)) (not (= c2 t))))
              (define ok?
                (and distinct?
                     (eq? m1 'QFree) (eq? m2 'QFree) (eq? mt 'QFree)
                     (eq? r1 'CanonicalMod) (eq? r2 'CanonicalMod) (eq? rt 'CanonicalMod)
                     (not lckt)
                     (eq? z1 'EntanglingZone) (eq? z2 'EntanglingZone) (eq? zt 'EntanglingZone)
                     (not (wire-in-catlinks? c1 links))
                     (not (wire-in-catlinks? c2 links))
                     (not (wire-in-catlinks? t links))))
              (define gt-p (anf-xor a1 (anf-and a1 a2)))
              `(cert-grade (toffolis 1) (depth 1) (ebits 0) (latency-ns ,lat)
                           (css-round ,css-round) (live-links ,links)
                           (wire-states ,(list-set cwires t `(cwire ,mt ,rt ,lckt ,(anf-xor at gt-p) ,zt)))
                           (ok? ,ok?))]
             [`(g-cswap ,c-w ,c1 ,c2)
              (match-define `(cwire ,mc ,rc ,_lckc ,ac ,zc) (list-ref cwires c-w))
              (match-define `(cwire ,m1 ,r1 ,lck1 ,a1 ,z1) (list-ref cwires c1))
              (match-define `(cwire ,m2 ,r2 ,lck2 ,a2 ,z2) (list-ref cwires c2))
              (define distinct? (and (not (= c-w c1)) (not (= c-w c2)) (not (= c1 c2))))
              (define ok?
                (and distinct?
                     (eq? mc 'QFree) (eq? m1 'QFree) (eq? m2 'QFree)
                     (eq? rc 'CanonicalMod) (eq? r1 'CanonicalMod) (eq? r2 'CanonicalMod)
                     (not lck1) (not lck2)
                     (eq? zc 'EntanglingZone) (eq? z1 'EntanglingZone) (eq? z2 'EntanglingZone)
                     (not (wire-in-catlinks? c-w links))
                     (not (wire-in-catlinks? c1 links))
                     (not (wire-in-catlinks? c2 links))))
              (define delta-p (anf-and ac (anf-xor a1 a2)))
              (define cw1 (list-set cwires c1 `(cwire ,m1 ,r1 ,lck1 ,(anf-xor a1 delta-p) ,z1)))
              (define cw2 (list-set cw1    c2 `(cwire ,m2 ,r2 ,lck2 ,(anf-xor a2 delta-p) ,z2)))
              `(cert-grade (toffolis 1) (depth 1) (ebits 0) (latency-ns ,lat)
                           (css-round ,css-round) (live-links ,links)
                           (wire-states ,cw2) (ok? ,ok?))]
             [`(g-fpga-feedforward ,w ,d)
              (match-define `(cwire ,_m ,r ,lck ,_a ,_z) (list-ref cwires w))
              (define new-lat (+ lat d))
              (define ok? (and (<= new-lat qec-cycle-budget-ns) (eq? r 'CanonicalMod) (not lck)))
              `(cert-grade (toffolis 0) (depth 1) (ebits 0) (latency-ns ,new-lat)
                           (css-round ,css-round) (live-links ,links)
                           (wire-states ,cwires) (ok? ,ok?))]
             [`(g-qec-barrier)
              (define all-canonical? (for/and ([cw (in-list cwires)]) (eq? (cwire-rep cw) 'CanonicalMod)))
              (define ok? (and (<= lat qec-cycle-budget-ns) (null? links) (eq? css-round 'CSSClosed) all-canonical?))
              `(cert-grade (toffolis 0) (depth 1) (ebits 0) (latency-ns 0)
                           (css-round ,css-round) (live-links ,links)
                           (wire-states ,cwires) (ok? ,ok?))]
             [`(g-stim-detector ,w)
              (match-define `(cwire ,m ,r ,lck ,a ,_z) (list-ref cwires w))
              (define init-a (anf-normalize (list-ref init-anfs w)))
              (define norm-a (anf-normalize a))
              (define det-ok?
                (and (eq? m 'QFree)
                     (eq? r 'CanonicalMod)
                     (not lck)
                     (not (wire-in-catlinks? w links))
                     (not (poly-has-virtual-tag? norm-a))
                     (equal? norm-a init-a)
                     (or (null? norm-a) (equal? norm-a (list (list w))))))
              `(cert-grade (toffolis 0) (depth 1) (ebits 0) (latency-ns ,lat)
                           (css-round ,css-round) (live-links ,links)
                           (wire-states ,cwires) (ok? ,det-ok?))]
             [`(g-css-round-begin ,mode)
              (define all-canonical? (for/and ([cw (in-list cwires)]) (eq? (cwire-rep cw) 'CanonicalMod)))
              (define ok? (and (eq? css-round 'CSSClosed) (null? links) all-canonical?))
              (define css-next (if (eq? css-round 'CSSClosed) (if (eq? mode 'Superpos) 'CSSOpenX 'CSSOpenZ) css-round))
              `(cert-grade (toffolis 0) (depth 1) (ebits 0) (latency-ns ,lat)
                           (css-round ,css-next) (live-links ,links)
                           (wire-states ,cwires) (ok? ,ok?))]
             [`(g-css-round-end ,mode)
              (define expected (if (eq? mode 'Superpos) 'CSSOpenX 'CSSOpenZ))
              (define all-canonical? (for/and ([cw (in-list cwires)]) (eq? (cwire-rep cw) 'CanonicalMod)))
              (define ok? (and (eq? css-round expected) (null? links) all-canonical?))
              `(cert-grade (toffolis 0) (depth 1) (ebits 0) (latency-ns ,lat)
                           (css-round CSSClosed) (live-links ,links)
                           (wire-states ,cwires) (ok? ,ok?))]
             [`(g-bb-torus-shift ,a ,b)
              (define all-qfree-canonical?
                (for/and ([cw (in-list cwires)])
                  (and (eq? (cwire-mode cw) 'QFree)
                       (eq? (cwire-rep cw) 'CanonicalMod)
                       (not (cwire-locked cw)))))
              (define ok? (and (eq? css-round 'CSSClosed) (null? links) all-qfree-canonical? (< a 12) (< b 6)))
              `(cert-grade (toffolis 0) (depth 1) (ebits 0) (latency-ns ,lat)
                           (css-round ,css-round) (live-links ,links)
                           (wire-states ,cwires) (ok? ,ok?))]
             [_
              `(cert-grade (toffolis 0) (depth 1) (ebits 0) (latency-ns ,lat)
                           (css-round ,css-round) (live-links ,links)
                           (wire-states ,cwires) (ok? #t))])))
       (values t d e lat1 css1 l1 cw1 ok1)]))

  (define (synth circ cwires links lat css-round)
    (match circ
      [`(c-gate ,g) (step-gate g cwires links lat css-round)]
      [`(c-seq ,c1 ,c2)
       (define-values (t1 d1 e1 lat1 css1 l1 cw1 ok1) (synth c1 cwires links lat css-round))
       (define-values (t2 d2 e2 lat2 css2 l2 cw2 ok2) (synth c2 cw1 l1 lat1 css1))
       (values (+ t1 t2) (+ d1 d2) (+ e1 e2) lat2 css2 l2 cw2 (and ok1 ok2))]
      [`(c-dag ,inner)
       (define unit-ok? (circuit-unitary-only? inner))
       (define-values (t d e lat1 css1 l cw ok) (synth (circuit-dag inner) cwires links lat css-round))
       (values t d e lat1 css1 l cw (and unit-ok? ok))]
      [`(c-with-uncompute ,u ,v)
       ;; Fixes F17 & F20:
       ;; 1. u must be strictly invertible QFree (no tele-cnot ebit consumption, no cat links,
       ;;    no detectors, no CSS round side-effects, no Hadamards across any nested c-par-diag).
       ;; 2. After u executes (`cwu`), EVERY wire must be in `QFree` + `CanonicalMod`,
       ;;    with `eu == 0`, `lu == ()`, and `cssu == CSSClosed`.
       ;; 3. `v` must preserve `(cwire-mode, cwire-rep, cwire-anf, cwire-zone)` of all wires in `u-all`.
       (define u-all (circuit-all-wires u))
       (define u-writes (circuit-write-set u))
       (define u-strictly-invertible?
         (and (nbe-circuit-strictly-invertible-qfree? u)
              (eq? css-round 'CSSClosed)
              (null? links)
              (for/and ([w (in-list u-all)])
                (match-define `(cwire ,m ,r ,lck ,_a ,_z) (list-ref cwires w))
                (and (eq? m 'QFree)
                     (eq? r 'CanonicalMod)
                     (not lck)
                     (not (wire-in-catlinks? w links))))))
       (define-values (tu du eu latu cssu lu cwu oku) (synth u cwires links lat css-round))
       (define u-post-canonical?
         (and (= eu 0)
              (null? lu)
              (eq? cssu 'CSSClosed)
              (for/and ([cw (in-list cwu)])
                (and (eq? (cwire-mode cw) 'QFree)
                     (eq? (cwire-rep cw) 'CanonicalMod)))))
       (define-values (tv dv ev latv cssv lv cwv okv) (synth v cwu lu latu cssu))
       (define v-preserves-u?
         (and (eq? cssv cssu)
              (null? lv)
              (null? (set-intersect (circuit-xwrite-set v) u-all))
              (null? (set-intersect (circuit-hadamard-set v) u-all))
              (for/and ([w (in-list u-all)])
                (equal? (list-ref cwv w) (list-ref cwu w)))))
       (define-values (tud dud eud latud cssud lud cwud okud) (synth (circuit-dag u) cwv lv latv cssv))
       (define u-restored?
         (for/and ([w (in-list u-writes)])
           (equal? (list-ref cwud w) (list-ref cwires w))))
       (values (+ tu tv tud) (+ du dv dud) (+ eu ev eud)
               latud cssud lud cwud
               (and u-strictly-invertible? oku u-post-canonical? okv v-preserves-u? okud u-restored?))]
      [`(c-with-locked-pebble ,p ,u ,v)
       (define u-all (circuit-all-wires u))
       (define u-writes (circuit-write-set u))
       (define u-strictly-invertible?
         (and (nbe-circuit-strictly-invertible-qfree? u)
              (eq? css-round 'CSSClosed)
              (null? links)
              (not (cwire-locked (list-ref cwires p)))
              (for/and ([w (in-list u-all)])
                (match-define `(cwire ,m ,r ,lck ,_a ,_z) (list-ref cwires w))
                (and (eq? m 'QFree)
                     (eq? r 'CanonicalMod)
                     (not lck)
                     (not (wire-in-catlinks? w links))))))
       (define-values (tu du eu latu cssu lu cwu oku) (synth u cwires links lat css-round))
       (define u-post-canonical?
         (and (= eu 0)
              (null? lu)
              (eq? cssu 'CSSClosed)
              (for/and ([cw (in-list cwu)])
                (and (eq? (cwire-mode cw) 'QFree)
                     (eq? (cwire-rep cw) 'CanonicalMod)))))
       (define cwu-locked
         (list-update cwu p (lambda (cw) (cwire-set-locked cw #t))))
       (define-values (tv dv ev latv cssv lv cwv-locked okv) (synth v cwu-locked lu latu cssu))
       (define cwv
         (list-update cwv-locked p (lambda (cw) (cwire-set-locked cw (cwire-locked (list-ref cwires p))))))
       (define v-preserves-u?
         (and (eq? cssv cssu)
              (null? lv)
              (not (member p (circuit-write-set v)))
              (null? (set-intersect (circuit-xwrite-set v) u-all))
              (null? (set-intersect (circuit-hadamard-set v) u-all))
              (for/and ([w (in-list u-all)])
                (equal? (list-ref cwv w) (list-ref cwu w)))))
       (define-values (tud dud eud latud cssud lud cwud okud) (synth (circuit-dag u) cwv lv latv cssv))
       (define u-restored?
         (for/and ([w (in-list (remove-duplicates (cons p u-writes) =))])
           (equal? (list-ref cwud w) (list-ref cwires w))))
       (values (+ tu tv tud) (+ du dv dud) (+ eu ev eud)
               latud cssud lud cwud
               (and u-strictly-invertible? oku u-post-canonical? okv v-preserves-u? okud u-restored?))]
      [`(c-par-diag ,c1 ,c2)
       (define all1 (circuit-all-wires c1))
       (define all2 (circuit-all-wires c2))
       (define shared (set-intersect all1 all2))
       (define mut1 (append (circuit-xwrite-set c1) (circuit-hadamard-set c1) (circuit-shuttle-set c1)))
       (define mut2 (append (circuit-xwrite-set c2) (circuit-hadamard-set c2) (circuit-shuttle-set c2)))
       (define shared-coherent?
         (and (null? (set-intersect mut1 all2))
              (null? (set-intersect mut2 all1))
              (for/and ([w (in-list shared)])
                (and (eq? (cwire-mode (list-ref cwires w)) 'QFree)
                     (eq? (cwire-rep  (list-ref cwires w)) 'CanonicalMod)))))
       (define-values (t1 d1 e1 lat1 css1 l1 cw1 ok1) (synth c1 cwires links lat css-round))
       (define-values (t2 d2 e2 lat2 css12 l12 cw12 ok2) (synth c2 cw1 l1 lat css1))
       (define-values (_t2a _d2a _e2a _lat2a css2 l2 cw2 ok2a) (synth c2 cwires links lat css-round))
       (define-values (_t1a _d1a _e1a _lat1a css21 l21 cw21 ok1a) (synth c1 cw2 l2 lat css2))
       (define commute-ok?
         (and (equal? l12 l21) (equal? cw12 cw21) (eq? css12 css21) ok1a ok2a))
       (values (+ t1 t2) (max d1 d2) (+ e1 e2)
               (max lat1 lat2) css12 l12 cw12
               (and ok1 ok2 shared-coherent? commute-ok?))]
      [`(c-unsafe-widen-refinement ,w ,inner)
       (match-define `(cwire ,m ,r ,lck ,a ,_z) (list-ref cwires w))
       (define smt-widen-vc-ok?
         (and (eq? m 'QFree)
              (eq? r 'CanonicalMod)
              (not lck)
              (not (wire-in-catlinks? w links))
              (equal? (anf-normalize a) (anf-normalize (list-ref init-anfs w)))))
       (define-values (t1 d1 e1 lat1 css1 l1 cw1 ok1)
         (synth inner cwires links lat css-round))
       (values t1 d1 e1 lat1 css1 l1 cw1 (and smt-widen-vc-ok? ok1))]
      [`(c-voqc-opt ,inner)
       (synth (voqc-optimize-canonical inner) cwires links lat css-round)]))

  (define norm-circ (voqc-optimize-canonical raw-circ))
  (define-values (toff depth ebits final-lat final-css final-links final-cwires ok?)
    (synth norm-circ init-cwires '() 0 'CSSClosed))
  (define all-canonical-and-unlocked?
    (for/and ([cw (in-list final-cwires)])
      (and (eq? (cwire-rep cw) 'CanonicalMod)
           (not (cwire-locked cw)))))
  (define closed-ok?
    (and ok?
         (eq? final-css 'CSSClosed)
         (null? final-links)
         (<= final-lat qec-cycle-budget-ns)
         all-canonical-and-unlocked?))
  (define netlist
    (if closed-ok?
        (erase-to-netlist-raw norm-circ)
        '()))
  `(nbe-grade
    (toffolis ,toff)
    (depth ,depth)
    (ebits ,ebits)
    (latency-ns ,final-lat)
    (css-round ,final-css)
    (live-links ,final-links)
    (wire-states ,final-cwires)
    (canonical-netlist ,netlist)
    (ok? ,closed-ok?)))

(define (Synthesize-NbE-Grade surf-or-circ init-anfs init-zones)
  (match-define `(qec-nbe-grade
                  (toffolis ,toff) (depth ,depth) (ebits ,ebits) (latency-ns ,final-lat)
                  (css-round ,final-css) (gauge-state ,_gauge) (max-congestion ,_cong)
                  (cultivation-ranks ,_ranks) (bitboards ,_bbs) (live-links ,final-links)
                  (wire-states ,final-cwires) (canonical-netlist ,netlist) (ok? ,closed-ok?))
    (memo-nbe-grade surf-or-circ init-anfs init-zones))
  `(nbe-grade
    (toffolis ,toff)
    (depth ,depth)
    (ebits ,ebits)
    (latency-ns ,final-lat)
    (css-round ,final-css)
    (live-links ,final-links)
    (wire-states ,final-cwires)
    (canonical-netlist ,netlist)
    (ok? ,closed-ok?)))

(define (nbe-restoration-law-holds? nbeg init-anfs aux-wires)
  (match-define `(nbe-grade (toffolis ,_) (depth ,_) (ebits ,_) (latency-ns ,lat)
                            (css-round ,css) (live-links ,links)
                            (wire-states ,cwires) (canonical-netlist ,_) (ok? ,ok?)) nbeg)
  (and ok?
       (eq? css 'CSSClosed)
       (null? links)
       (<= lat qec-cycle-budget-ns)
       (for/and ([cw (in-list cwires)])
         (and (eq? (cwire-rep cw) 'CanonicalMod)
              (not (cwire-locked cw))))
       (for/and ([w (in-list aux-wires)])
         (match-define `(cwire ,mode ,rep ,lck ,anf ,_zone) (list-ref cwires w))
         (and (eq? mode 'QFree)
              (eq? rep 'CanonicalMod)
              (not lck)
              (equal? (anf-normalize anf)
                      (anf-normalize (list-ref init-anfs w)))))))

;; Single-pass Canonical NbE Operational Evaluator (`eval-canonical-nbe-raw`, Simplification S12):
;; Desugars SurfaceQTerm/GradedCircuit, applies canonical 3-wire-CSWAP-barrier VOQC normalization,
;; erases grades to flat netlist, and evaluates on WireState.
(define (eval-canonical-nbe-raw surf-or-circ st)
  (define raw-circ
    (if (surface-qterm? surf-or-circ)
        (desugar-qdo-raw surf-or-circ)
        surf-or-circ))
  (define opt-circ (voqc-optimize-canonical raw-circ))
  (eval-circuit-raw opt-circ st))

;; Multi-mode Synthesize-Circuit-Grade supporting:
;;   - 'naive     : unguarded baseline (fails F1..F20)
;;   - 'phase1    : Phase-1 refined rules (fixes F1..F4, fails F5..F20)
;;   - 'phase2    : Phase-2 unified rules (fixes F1..F8, fails F9..F20)
;;   - 'refined   : Canonical Minimal rules (fixes F1..F12)
;;   - 'certified : Phase-4 Certified Compiler rules (fixes F1..F16)
;;   - 'nbe       : Phase-5 Single-Pass Canonical NbE rules (fixes ALL F1..F20!)
(define (purity-join p1 p2)
  (cond
    [(or (eq? p1 'Entangled) (eq? p2 'Entangled)) 'Entangled]
    [(or (eq? p1 'SeparableSuperpos) (eq? p2 'SeparableSuperpos)) 'SeparableSuperpos]
    [else 'SeparableBasis]))

(define (Synthesize-Circuit-Grade c init-anfs init-zones [mode 'refined])
  (define num-wires (length init-anfs))
  (define init-parity (make-list num-wires 0))

  ;; Phase-1 / Naive recursive abstract interpretation
  (define (synth-legacy circ anfs zones parity)
    (match circ
      [`(c-gate ,g)
       (match g
         [`(g-id)
          (values 0 0 0 parity anfs zones 'SeparableBasis #t)]
         [`(g-x ,w)
          (define p-new (list-update parity w (lambda (b) (bitwise-xor b 1))))
          (define a-new (list-update anfs w (lambda (p) (anf-xor p '(())))))
          (values 0 1 0 p-new a-new zones 'SeparableBasis #t)]
         [`(g-z ,_w)
          (values 0 1 0 parity anfs zones 'SeparableBasis #t)]
         [`(g-h ,_w)
          ;; Vulnerability F5/F6 in Phase-1: g-h leaves anfs[w] unchanged!
          (values 0 1 0 parity anfs zones 'SeparableSuperpos #t)]
         [`(g-cnot ,c ,t)
          (define z-ok?
            (or (eq? mode 'naive)
                (and (eq? (list-ref zones c) 'EntanglingZone)
                     (eq? (list-ref zones t) 'EntanglingZone))))
          (define p-new (list-update parity t (lambda (b) (bitwise-xor b 1))))
          (define pc (list-ref anfs c))
          (define a-new (list-update anfs t (lambda (pt) (anf-xor pt pc))))
          (values 0 1 0 p-new a-new zones 'Entangled (and (not (= c t)) z-ok?))]
         [`(g-cz ,c1 ,c2)
          (define z-ok?
            (or (eq? mode 'naive)
                (and (eq? (list-ref zones c1) 'EntanglingZone)
                     (eq? (list-ref zones c2) 'EntanglingZone))))
          (values 0 1 0 parity anfs zones 'Entangled (and (not (= c1 c2)) z-ok?))]
         [(or `(g-ccx ,c1 ,c2 ,t) `(g-compute-and ,c1 ,c2 ,t) `(g-and-compute ,c1 ,c2 ,t)
              `(g-rccx ,c1 ,c2 ,t) `(g-rccx-dag ,c1 ,c2 ,t))
          (define distinct? (and (not (= c1 c2)) (not (= c1 t)) (not (= c2 t))))
          (define z-ok?
            (or (eq? mode 'naive)
                (and (eq? (list-ref zones c1) 'EntanglingZone)
                     (eq? (list-ref zones c2) 'EntanglingZone)
                     (eq? (list-ref zones t) 'EntanglingZone))))
          (define p1 (list-ref anfs c1))
          (define p2 (list-ref anfs c2))
          (define prod-p (anf-and p1 p2))
          (define p-new (list-update parity t (lambda (b) (bitwise-xor b 1))))
          (define a-new (list-update anfs t (lambda (pt) (anf-xor pt prod-p))))
          (values (if (or (eq? (car g) 'g-rccx) (eq? (car g) 'g-rccx-dag)) 0 1)
                  1 0 p-new a-new zones 'Entangled (and distinct? z-ok?))]
         [(or `(g-hmr-cz ,t ,c1 ,c2 ,_) `(g-hmr-cz ,t ,c1 ,c2))
          (define distinct? (and (not (= c1 c2)) (not (= c1 t)) (not (= c2 t))))
          (define pt (list-ref anfs t))
          (define pc1 (list-ref anfs c1))
          (define pc2 (list-ref anfs c2))
          (define expected-monomial (anf-and pc1 pc2))
          (define hmr-ok?
            (if (eq? mode 'naive)
                (and distinct?
                     (<= (+ (anf-degree pc1) (anf-degree pc2)) 2)
                     (= (list-ref parity t) 1))
                (and distinct?
                     (equal? (anf-normalize pt) (anf-normalize expected-monomial)))))
          (define p-new (list-set parity t 0))
          (define a-new (list-set anfs t '()))
          (values 0 1 0 p-new a-new zones 'SeparableBasis hmr-ok?)]
         [`(g-zone-shuttle ,w ,z-target)
          (define z-new (list-set zones w z-target))
          (values 0 1 0 parity anfs z-new 'SeparableBasis #t)]
         [`(g-twirl-step ,_ ,_)
          (values 0 1 0 parity anfs zones 'SeparableBasis #t)]
         [`(g-tele-cnot ,c ,t)
          (define p-new (list-update parity t (lambda (b) (bitwise-xor b 1))))
          (define pc (list-ref anfs c))
          (define a-new (list-update anfs t (lambda (pt) (anf-xor pt pc))))
          (values 0 1 1 p-new a-new zones 'Entangled (not (= c t)))]
         [`(g-cat-entangle ,c ,t)
          (define p-new (list-update parity t (lambda (b) (bitwise-xor b 1))))
          (define pc (list-ref anfs c))
          (define a-new (list-update anfs t (lambda (pt) (anf-xor pt pc))))
          (values 0 1 1 p-new a-new zones 'Entangled (not (= c t)))]
         [`(g-cat-disentangle ,c ,t)
          (define p-new (list-set parity t 0))
          (define a-new (list-set anfs t '()))
          (values 0 1 0 p-new a-new zones 'SeparableBasis (not (= c t)))]
         [`(g-skew-add-cs ,w)
          (define p-new (list-update parity w (lambda (b) (bitwise-xor b 1))))
          (define a-new (list-update anfs w (lambda (p) (anf-xor p '(())))))
          (values 0 1 0 p-new a-new zones 'SeparableBasis #t)]
         [`(g-consolidate-cs ,_w)
          (values 1 1 0 parity anfs zones 'SeparableBasis #t)]
         [`(g-cmp-gt ,c1 ,c2 ,t)
          (define p-new (list-update parity t (lambda (b) (bitwise-xor b 1))))
          (define p1 (list-ref anfs c1))
          (define p2 (list-ref anfs c2))
          (define gt-p (anf-xor p1 (anf-and p1 p2)))
          (define a-new (list-update anfs t (lambda (pt) (anf-xor pt gt-p))))
          (values 1 1 0 p-new a-new zones 'Entangled (and (not (= c1 c2)) (not (= c1 t)) (not (= c2 t))))]
         [`(g-cswap ,c ,c1 ,c2)
          ;; Vulnerability F11 in Naive/Phase-1: leaves ANF polynomials unchanged on CSWAP!
          (values 1 1 0 parity anfs zones 'Entangled (and (not (= c c1)) (not (= c c2)) (not (= c1 c2))))]
         [`(g-fpga-feedforward ,_w ,_d)
          (values 0 1 0 parity anfs zones 'SeparableBasis #t)]
         [`(g-qec-barrier)
          (values 0 1 0 parity anfs zones 'SeparableBasis #t)]
         [`(g-stim-detector ,_w)
          (values 0 1 0 parity anfs zones 'SeparableBasis #t)]
         [`(g-css-round-begin ,_mode)
          (values 0 1 0 parity anfs zones 'SeparableBasis #t)]
         [`(g-css-round-end ,_mode)
          (values 0 1 0 parity anfs zones 'SeparableBasis #t)]
         [`(g-bb-torus-shift ,_a ,_b)
          (values 0 1 0 parity anfs zones 'SeparableBasis #t)]
         [`(g-kuperberg-collimate ,w1 ,_r1 ,w2 ,_r2)
          ;; Vulnerability F19 in Naive/Phase-1: ignores rank mismatch r1 != r2!
          (define p-new (list-update parity w2 (lambda (b) (bitwise-xor b 1))))
          (define p1 (list-ref anfs w1))
          (define a-new (list-update anfs w2 (lambda (p2) (anf-xor p2 p1))))
          (values 0 1 0 p-new a-new zones 'Entangled (not (= w1 w2)))]
         [`(g-inject-fault ,_w ,_k)
          ;; Vulnerability F21 in Naive/Phase-1: ignores mid-schedule fault variable e_k!
          (values 0 1 0 parity anfs zones 'SeparableBasis #t)]
         [`(g-flag-clear ,_w1 ,_w2)
          (values 0 1 0 parity anfs zones 'SeparableBasis #t)]
         [`(g-cultivate-step ,_w ,_r)
          (values 0 1 0 parity anfs zones 'SeparableBasis #t)]
         [`(g-inject-magic-t ,_w ,_r)
          ;; Vulnerability F22 in Naive/Phase-1: ignores cultivation rank & post-select leak!
          (values 1 1 0 parity anfs zones 'SeparableBasis #t)]
         [`(g-ppm-bus ,l ,r)
          ;; Vulnerability F23 in Naive/Phase-1: ignores bus routing interval overlap!
          (define p-new (if (= l r) parity (list-update parity r (lambda (b) (bitwise-xor b 1)))))
          (define pl (list-ref anfs l))
          (define a-new (if (= l r) anfs (list-update anfs r (lambda (pr) (anf-xor pr pl)))))
          (values 0 1 0 p-new a-new zones 'Entangled (<= l r))]
         [`(g-gauge-open ,_w)
          (values 0 1 0 parity anfs zones 'SeparableBasis #t)]
         [`(g-gauge-fix ,_w)
          (values 0 1 0 parity anfs zones 'SeparableBasis #t)]
         [`(g-code-switch-transversal-t ,_w)
          ;; Vulnerability F24 in Naive/Phase-1: ignores open homological boundary gauge!
          (values 1 1 0 parity anfs zones 'SeparableBasis #t)]
         [`(g-native-ccz ,c1 ,c2 ,c3)
          (values 0 1 0 parity anfs zones 'Entangled (and (not (= c1 c2)) (not (= c1 c3)) (not (= c2 c3))))]
         [`(g-native-iswap ,q1 ,q2)
          (define a1 (list-ref anfs q1))
          (define a2 (list-ref anfs q2))
          (define a-new (list-set (list-set anfs q1 a2) q2 a1))
          (values 0 1 0 parity a-new zones 'Entangled (not (= q1 q2)))]
         [`(g-rzz ,q1 ,q2 ,_theta)
          (values 0 1 0 parity anfs zones 'Entangled (not (= q1 q2)))]
         [`(g-virtual-rz ,_q ,_theta)
          (values 0 0 0 parity anfs zones 'SeparableBasis #t)]
         [`(g-meas ,kind ,q)
          (define a-new (if (eq? kind 'meas-mcmr-reuse) (list-set anfs q '()) anfs))
          (values 0 1 0 parity a-new zones 'SeparableBasis #t)]
         [`(g-seq ,g1 ,g2)
          (synth-legacy `(c-seq (c-gate ,g1) (c-gate ,g2)) anfs zones parity)])]

      [`(c-seq ,c1 ,c2)
       (define-values (t1 d1 e1 p1 a1 z1 pur1 ok1) (synth-legacy c1 anfs zones parity))
       (define-values (t2 d2 e2 p2 a2 z2 pur2 ok2) (synth-legacy c2 a1 z1 p1))
       (values (+ t1 t2) (+ d1 d2) (+ e1 e2) p2 a2 z2 (purity-join pur1 pur2) (and ok1 ok2))]

      [`(c-dag ,inner)
       (synth-legacy (circuit-dag inner) anfs zones parity)]

      [`(c-with-uncompute ,u ,v)
       (define-values (tu du eu pu au zu puru oku) (synth-legacy u anfs zones parity))
       (define-values (tv dv ev pv av zv purv okv) (synth-legacy v au zu pu))
       (define-values (tud dud eud pud aud zud _purud okud) (synth-legacy (circuit-dag u) av zv pv))
       (define u-reads (circuit-read-set u))
       (define u-writes (circuit-write-set u))
       (define v-xwrites (circuit-xwrite-set v))
       (define alias-ok?
         (if (eq? mode 'naive)
             (for/and ([w (in-list u-writes)])
               (= (list-ref pv w) (list-ref pu w)))
             (and (null? (set-intersect v-xwrites u-reads))
                  (null? (set-intersect v-xwrites u-writes)))))
       (values (+ tu tv tud) (+ du dv dud) (+ eu ev eud)
               pud aud zud (purity-join puru purv)
               (and oku okv okud alias-ok?))]

      [`(c-with-locked-pebble ,_p ,u ,v)
       ;; Vulnerability F10 in Naive/Phase-1: does not lock checkpoint pebble p!
       (define-values (tu du eu pu au zu puru oku) (synth-legacy u anfs zones parity))
       (define-values (tv dv ev pv av zv purv okv) (synth-legacy v au zu pu))
       (define-values (tud dud eud pud aud zud _purud okud) (synth-legacy (circuit-dag u) av zv pv))
       (values (+ tu tv tud) (+ du dv dud) (+ eu ev eud)
               pud aud zud (purity-join puru purv)
               (and oku okv okud))]

      [`(c-par-diag ,c1 ,c2)
       (define-values (t1 d1 e1 p1 a1 z1 pur1 ok1) (synth-legacy c1 anfs zones parity))
       (define-values (t2 d2 e2 p2 a2 z2 pur2 ok2) (synth-legacy c2 a1 z1 p1))
       (define xw1 (circuit-xwrite-set c1))
       (define xw2 (circuit-xwrite-set c2))
       (define cr1 (remove-duplicates (append (circuit-xwrite-set c1) (circuit-read-set c1)) =))
       (define cr2 (remove-duplicates (append (circuit-xwrite-set c2) (circuit-read-set c2)) =))
       (define par-ok?
         (if (eq? mode 'naive)
             (null? (set-intersect xw1 xw2))
             (and (null? (set-intersect xw1 cr2))
                  (null? (set-intersect xw2 cr1)))))
       (values (+ t1 t2) (max d1 d2) (+ e1 e2)
               p2 a2 z2 (purity-join pur1 pur2)
               (and ok1 ok2 par-ok?))]

      [`(c-unsafe-widen-refinement ,_w ,inner)
       (synth-legacy inner anfs zones parity)]

      [`(c-voqc-opt ,inner)
       (synth-legacy (voqc-optimize-naive inner) anfs zones parity)]))

  (define-values (toff depth ebits final-parity final-anfs final-zones purity legacy-ok?)
    (synth-legacy c init-anfs init-zones init-parity))

  (match-define `(ugrade (toffolis ,u-toff) (depth ,u-depth) (ebits ,u-ebits)
                         (live-links ,_u-links) (wire-states ,u-wires) (ok? ,unified-ok?))
    (Synthesize-Unified-Grade c init-anfs init-zones))

  (match-define `(cgrade (toffolis ,c-toff) (depth ,c-depth) (ebits ,c-ebits) (latency-ns ,_c-lat)
                         (live-links ,_c-links) (wire-states ,c-wires) (ok? ,canonical-ok?))
    (Synthesize-Canonical-Grade c init-anfs init-zones))

  (match-define `(cert-grade (toffolis ,cert-toff) (depth ,cert-depth) (ebits ,cert-ebits)
                             (latency-ns ,_cert-lat) (css-round ,_cert-css)
                             (live-links ,_cert-links) (wire-states ,cert-wires) (ok? ,cert-ok?))
    (Synthesize-Certified-Compiler-Grade c init-anfs init-zones))

  (match-define `(nbe-grade (toffolis ,nbe-toff) (depth ,nbe-depth) (ebits ,nbe-ebits)
                            (latency-ns ,_nbe-lat) (css-round ,_nbe-css)
                            (live-links ,_nbe-links) (wire-states ,nbe-wires)
                            (canonical-netlist ,_nbe-net) (ok? ,nbe-ok?))
    (Synthesize-NbE-Grade c init-anfs init-zones))

  (define eff-anfs
    (cond
      [(eq? mode 'nbe) (map cwire-anf nbe-wires)]
      [(eq? mode 'certified) (map cwire-anf cert-wires)]
      [(or (eq? mode 'refined) (eq? mode 'canonical)) (map cwire-anf c-wires)]
      [(eq? mode 'phase2) (map uwire-anf u-wires)]
      [else final-anfs]))
  (define eff-zones
    (cond
      [(eq? mode 'nbe) (map cwire-zone nbe-wires)]
      [(eq? mode 'certified) (map cwire-zone cert-wires)]
      [(or (eq? mode 'refined) (eq? mode 'canonical)) (map cwire-zone c-wires)]
      [(eq? mode 'phase2) (map uwire-zone u-wires)]
      [else final-zones]))
  (define eff-ok?
    (cond
      [(eq? mode 'nbe) nbe-ok?]
      [(eq? mode 'certified) cert-ok?]
      [(or (eq? mode 'refined) (eq? mode 'canonical)) canonical-ok?]
      [(eq? mode 'phase2) unified-ok?]
      [else legacy-ok?]))
  (define deltas (compute-anf-deltas eff-anfs init-anfs))
  (define degs (map anf-degree eff-anfs))
  `(circuit-grade
    (toffolis ,(cond [(eq? mode 'nbe) nbe-toff]
                     [(eq? mode 'certified) cert-toff]
                     [(or (eq? mode 'refined) (eq? mode 'canonical)) c-toff]
                     [(eq? mode 'phase2) u-toff]
                     [else toff]))
    (depth ,(cond [(eq? mode 'nbe) nbe-depth]
                  [(eq? mode 'certified) cert-depth]
                  [(or (eq? mode 'refined) (eq? mode 'canonical)) c-depth]
                  [(eq? mode 'phase2) u-depth]
                  [else depth]))
    (ebits ,(cond [(eq? mode 'nbe) nbe-ebits]
                  [(eq? mode 'certified) cert-ebits]
                  [(or (eq? mode 'refined) (eq? mode 'canonical)) c-ebits]
                  [(eq? mode 'phase2) u-ebits]
                  [else ebits]))
    (z2-parity ,final-parity)
    (f2-delta ,deltas)
    (f2-degree ,degs)
    (zones ,eff-zones)
    (purity ,purity)
    (well-typed? ,eff-ok?)))

