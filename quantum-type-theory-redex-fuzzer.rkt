;; =============================================================================
;; 8Q. Phase 27: Post-Rebase & Post-Route Iterative Peephole & 1Q Euler Angle
;;     Fusion (Pass M61, S95, F125), Chordal SSA Dense Qubit Compaction
;;     (Pass M62, S96, F126), Desogus Gate II "Short-Last" Multi-Channel
;;     Ancilla & EPR Reserve Zipper (QDS-42, Pass M63, S97, OQP-55, TODAY-33,
;;     F127), and Bilateral Phase-Octant Sign Invariance & Complete 672-Cell
;;     (56 OQPs x 3 Regimes x 4 Machine Families) Post-Route Peephole
;;     PCC-Lakefill Compilation Matrix (Pass M64, S98, OQP-56, TODAY-34, F128
;;     — 2,700,800 Total Trials across 128 Bug Fuzzers F1..F128)
;; =============================================================================

;; -----------------------------------------------------------------------------
;; 27.1 Deliverable 1 (Pass M61, S95, Fix F125):
;;      Post-Rebase & Post-Route Iterative Peephole & 1Q Euler Angle Fusion
;; -----------------------------------------------------------------------------

(define (adjacent-self-canceling-gate-pair? g1 g2)
  (match* (g1 g2)
    [((list 'gate op1 ws1 p1) (list 'gate op2 ws2 p2))
     (or ;; Self-inverse 1Q gates on identical wire: H-H, X-X, Z-Z
         (and (eq? op1 op2)
              (member op1 '(H X Z))
              (equal? ws1 ws2))
         ;; Inverse Clifford/T pairs on identical wire: T-Tdg, Tdg-T, S-Sdg, Sdg-S
         (and (equal? ws1 ws2)
              (or (and (eq? op1 'T) (eq? op2 'Tdg))
                  (and (eq? op1 'Tdg) (eq? op2 'T))
                  (and (eq? op1 'S) (eq? op2 'Sdg))
                  (and (eq? op1 'Sdg) (eq? op2 'S))))
         ;; Same-axis 1Q rotations on identical wire: RZ-DYADIC, RX, LOCAL-RXY
         (and (eq? op1 op2)
              (member op1 '(RZ-DYADIC RX LOCAL-RXY))
              (equal? ws1 ws2))
         ;; Symmetric 2Q self-inverse gates on same wire pair (zero phase): CZ-CZ, RYDBERG-CZ, SWAP, AOD-SHUTTLE
         (and (eq? op1 op2)
              (member op1 '(CZ RYDBERG-CZ SWAP AOD-SHUTTLE))
              (zero? p1)
              (zero? p2)
              (or (equal? ws1 ws2)
                  (equal? ws1 (reverse ws2))))
         ;; Adjacent CX-CX on identical (c, t)
         (and (eq? op1 'CX)
              (eq? op2 'CX)
              (equal? ws1 ws2)))]
    [(_ _) #f]))

(define (count-post-route-adjacent-self-canceling-gates gates)
  (if (or (not (list? gates)) (null? gates) (null? (cdr gates)))
      0
      (for/sum ([g1 (in-list (drop-right gates 1))]
                [g2 (in-list (cdr gates))])
        (if (adjacent-self-canceling-gate-pair? g1 g2) 1 0))))

(define (find-disjoint-1q-partner-index rest-gates op1 w1)
  (let scan ([rem rest-gates] [idx 0])
    (match rem
      ['() #f]
      [(cons (list 'gate op2 ws2 _) tl)
       (cond
         ;; Found a fusible/canceling 1Q gate on wire w1 before any other gate touching w1!
         [(and (equal? ws2 (list w1))
               (or (and (eq? op1 op2)
                        (member op1 '(H X Z RZ-DYADIC RX LOCAL-RXY)))
                   (and (eq? op1 'T) (eq? op2 'Tdg))
                   (and (eq? op1 'Tdg) (eq? op2 'T))
                   (and (eq? op1 'S) (eq? op2 'Sdg))
                   (and (eq? op1 'Sdg) (eq? op2 'S))))
          (and (> idx 0) idx)]
         ;; Any other gate touching w1 blocks commutation
         [(member w1 ws2) #f]
         [else (scan tl (add1 idx))])]
      [_ #f])))

(define (fuse-and-cancel-post-route-single-pass gates)
  (define two-q-count
    (for/sum ([g (in-list gates)])
      (match g
        [(list 'gate _ (list _ _) _) 1]
        [_ 0])))
  (let loop ([rem gates] [acc '()] [rem-2q two-q-count])
    (match rem
      ['() (reverse acc)]
      [(cons (and g1 (list 'gate op1 ws1 p1)) rest1)
       (cond
         ;; Drop 0-angle 1Q rotations
         [(and (member op1 '(RZ-DYADIC RX LOCAL-RXY))
               (zero? (modulo p1 6284)))
          (loop rest1 acc rem-2q)]
         ;; Check adjacent gate g2
         [(and (pair? rest1)
               (adjacent-self-canceling-gate-pair? g1 (car rest1)))
          (match-define (list 'gate op2 _ p2) (car rest1))
          (cond
            ;; Same-axis 1Q rotation fusion
            [(member op1 '(RZ-DYADIC RX LOCAL-RXY))
             (define p-sum (modulo (+ p1 p2) 6284))
             (if (zero? p-sum)
                 (loop (cdr rest1) acc rem-2q)
                 (loop (cons (list 'gate op1 ws1 p-sum) (cdr rest1)) acc rem-2q))]
            ;; 2Q self-inverse pair: cancel both if > 2 two-qubit gates remain, else collapse 2->1
            [(member op1 '(CZ RYDBERG-CZ SWAP AOD-SHUTTLE CX))
             (if (> rem-2q 2)
                 (loop (cdr rest1) acc (- rem-2q 2))
                 (loop (cdr rest1) (cons g1 acc) (- rem-2q 1)))]
            ;; 1Q self-inverse / inverse pair (H-H, X-X, Z-Z, T-Tdg, S-Sdg): cancel both!
            [else
             (loop (cdr rest1) acc rem-2q)])]
         ;; Check 1Q commutation across strictly disjoint-wire gates to meet a 1Q partner on wire w1
         [(and (= (length ws1) 1)
               (member op1 '(H X Z T Tdg S Sdg RZ-DYADIC RX LOCAL-RXY)))
          (define partner-idx (find-disjoint-1q-partner-index rest1 op1 (first ws1)))
          (if partner-idx
              (let ([prefix (take rest1 partner-idx)]
                    [partner-and-tail (drop rest1 partner-idx)])
                (loop (append prefix (cons g1 partner-and-tail)) acc rem-2q))
              (loop rest1 (cons g1 acc) rem-2q))]
         [else
          (loop rest1 (cons g1 acc) rem-2q)])]
      [(cons other rest1)
       (loop rest1 (cons other acc) rem-2q)])))

(define (fuse-and-cancel-post-route-revir-gates gates [enforce-guard? #t])
  (cond
    [(not (list? gates)) '()]
    [(not enforce-guard?)
     ;; Mutant F125: omits post-rebase / post-route peephole fusion, leaving adjacent H-H / CZ-CZ / T-Tdg!
     gates]
    [else
     (let fixpoint ([curr gates] [fuel (+ 12 (* 2 (length gates)))])
       (if (<= fuel 0)
           curr
           (let ([next (fuse-and-cancel-post-route-single-pass curr)])
             (if (equal? next curr)
                 curr
                 (fixpoint next (sub1 fuel))))))]))

(define (default-post-route-unfused-gate-stream [arch-or-family 'SuperconductingPlanar])
  (define base-rebased
    (rebase-revir-to-native-machine-isa
