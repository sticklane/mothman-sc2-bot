        'gridsynth-t-upper-bound (hash-ref gs-pi17 'gridsynth-t-upper-bound)
        'solovay-kitaev-t-bound (hash-ref gs-pi17 'solovay-kitaev-t-bound)
        'approx-error (hash-ref gs-pi17 'approx-error)
        'target-epsilon (hash-ref gs-pi17 'target-epsilon)
        'cyclotomic-unitary-norm-exact? (hash-ref gs-pi17 'cyclotomic-unitary-norm-exact?)
        'continuous-03719-verified? (hash-ref gs-cont 'verified?)
        'syllables (hash-ref gs-pi17 'syllables)
        'revir-gates (hash-ref gs-pi17 'revir-gates)
        'verified? (and enforce-guard?
                        (hash-ref gs-pi17 'verified?)
                        (hash-ref gs-cont 'verified?))))

(define (s88-ross-selinger-gridsynth-dyadic-approximation-guard
