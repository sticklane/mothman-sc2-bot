;; =============================================================================
;; 8e. Phase-9 Multi-Layer IR Evaluators, Optimizers, End-to-End 8-Target Compiler,
;;     and Differential Fuzzing Suites F33-F36 (100,000 New Trials -> 400,800 Total)
;; =============================================================================

;; -----------------------------------------------------------------------------
;; 1. Tier 1 (`HL-QDS`) Independent Reference Evaluator & Intra-Layer Optimizer:
;;    - `eval-tier1-hl-qds`: Computes exact 64-bit truth-table bitboard semantics,
;;      relative-phase parity (0 when clean), and modal state (`CanonicalMod` vs
;;      `RedundantCS`, `CSSClosed`, `ZipperFocus`) directly on `HL-QDS` expressions.
;;    - `optimize-tier1-hl-qds`: Applies Tier-1 container fusion (S11), redundant
;;      focus-shift cancellation (`left ; right -> id`), and carry-save consolidation
;;      fusion (`hl-skew-inc w ; hl-consolidate-cs w -> hl-kralovic-pebble-stage 0 1 3 w`).
;; -----------------------------------------------------------------------------

(define (hl-qds-dag expr)
  (match expr
    [`(hl-id) '(hl-id)]
    [`(hl-skew-inc ,w) `(hl-skew-inc ,w)]
    [`(hl-critbit-lookup ,c1 ,c2 ,t) `(hl-critbit-lookup ,c1 ,c2 ,t)]
    [`(hl-braun-popcount ,c1 ,c2 ,t) `(hl-braun-popcount ,c1 ,c2 ,t)]
    [`(hl-zipper-focus-op FocusLeft ,w) `(hl-zipper-focus-op FocusRight ,w)]
    [`(hl-zipper-focus-op FocusRight ,w) `(hl-zipper-focus-op FocusLeft ,w)]
    [`(hl-zipper-focus-op FocusRoot ,w) `(hl-zipper-focus-op FocusRoot ,w)]
    [`(hl-kralovic-pebble-stage ,c1 ,c2 ,p ,t) `(hl-kralovic-pebble-stage ,c1 ,c2 ,p ,t)]
    [`(hl-consolidate-cs ,w) `(hl-consolidate-cs ,w)]
    [`(hl-phase-oracle ,w) `(hl-phase-oracle ,w)]
    [`(hl-seq ,e1 ,e2) `(hl-seq ,(hl-qds-dag e2) ,(hl-qds-dag e1))]
    [`(hl-with-compute ,u ,v) `(hl-with-compute ,u ,(hl-qds-dag v))]
    [other other]))

(define (eval-tier1-hl-qds expr [init-bbs (initial-bitboard-env 4 '(3))])
  (define (step e bbs phase-parity rep-state css-state focus-offset modal-err?)
    (match e
      [`(hl-id)
       (values bbs phase-parity rep-state css-state focus-offset modal-err?)]
      [`(hl-skew-inc ,w)
       (define prod (bb-and (list-ref bbs 0) (list-ref bbs 1)))
       (define bbs2 (list-update bbs w (lambda (bw) (bb-xor bw prod))))
       (values bbs2 phase-parity 'RedundantCS css-state focus-offset modal-err?)]
      [`(hl-critbit-lookup ,c1 ,c2 ,t)
       (define prod (bb-and (list-ref bbs c1) (list-ref bbs c2)))
       (define bbs2 (list-update bbs t (lambda (bt) (bb-xor bt prod))))
       (values bbs2 phase-parity rep-state css-state focus-offset modal-err?)]
      [`(hl-braun-popcount ,c1 ,c2 ,t)
       (define parity (bb-xor (list-ref bbs c1) (list-ref bbs c2)))
       (define bbs2 (list-update bbs t (lambda (bt) (bb-xor bt parity))))
       (values bbs2 phase-parity rep-state css-state focus-offset modal-err?)]
      [`(hl-zipper-focus-op ,dir ,_w)
       (define next-offset
         (case dir
           [(FocusLeft)  (- focus-offset 1)]
           [(FocusRight) (+ focus-offset 1)]
           [else 0]))
       (values bbs phase-parity rep-state css-state next-offset modal-err?)]
      [`(hl-kralovic-pebble-stage ,c1 ,c2 ,p ,t)
       (define p-was-dirty? (not (= (list-ref bbs p) 0)))
       (define prod (bb-and (list-ref bbs c1) (list-ref bbs c2)))
       (define bbs2 (list-update bbs t (lambda (bt) (bb-xor bt prod))))
       (values bbs2
               (if p-was-dirty? 1 phase-parity)
               rep-state
               css-state
               focus-offset
               (or modal-err? p-was-dirty?))]
      [`(hl-consolidate-cs ,_w)
       (values bbs phase-parity 'CanonicalMod css-state focus-offset modal-err?)]
      [`(hl-phase-oracle ,_w)
       ;; Applying a phase oracle while in RedundantCS triggers Quotient Carry-Save Phase Kickback (F9/F33)!
       (define cs-hazard? (eq? rep-state 'RedundantCS))
       (values bbs
               (if cs-hazard? 1 phase-parity)
               rep-state
               css-state
               focus-offset
               (or modal-err? cs-hazard?))]
      [`(hl-seq ,e1 ,e2)
       (define-values (bbs1 ph1 rep1 css1 foc1 err1)
         (step e1 bbs phase-parity rep-state css-state focus-offset modal-err?))
       (step e2 bbs1 ph1 rep1 css1 foc1 err1)]
      [`(hl-with-compute ,u ,v)
       (define-values (bbs1 ph1 rep1 css1 foc1 err1)
         (step u bbs phase-parity rep-state css-state focus-offset modal-err?))
       (define-values (bbs2 ph2 rep2 css2 foc2 err2)
         (step v bbs1 ph1 rep1 css1 foc1 err1))
       (step (hl-qds-dag u) bbs2 ph2 rep2 css2 foc2 err2)]
      [_
       ;; Legacy HL-QDS fallback via ML-RevIR bitboard evaluator
       (define lowered (lower-hl-qds-to-ml-revir e))
       (define bbs2 (eval-bitboard-qfree (ml-revir->graded-circuit lowered) bbs))
       (values bbs2 phase-parity rep-state css-state focus-offset modal-err?)]))

  (define-values (out-bbs out-ph out-rep out-css out-foc out-err?)
    (step expr init-bbs 0 'CanonicalMod 'CSSClosed 0 #f))
  (define out-focus-sym
    (cond
      [(= out-foc 0) 'FocusRoot]
      [(< out-foc 0) 'FocusLeft]
      [else          'FocusRight]))
  (define clean-anc? (= (list-ref out-bbs 3) 0))
  (define well-typed?
    (and (not out-err?)
         (= out-ph 0)
         (eq? out-rep 'CanonicalMod)
         (eq? out-css 'CSSClosed)
         (eq? out-focus-sym 'FocusRoot)
         clean-anc?))
  (hash 'bitboards out-bbs
        'relative-phase-parity out-ph
        'rep-state out-rep
        'css-state out-css
        'zipper-focus out-focus-sym
        'clean-ancillas? clean-anc?
        'well-typed? well-typed?))

(define (flatten-hl-seq e)
  (match e
    [`(hl-seq ,e1 ,e2) (append (flatten-hl-seq e1) (flatten-hl-seq e2))]
    [`(hl-id) '()]
    [_ (list e)]))

(define (rebuild-hl-seq items)
  (match items
    ['() '(hl-id)]
    [(list single) single]
    [(cons hd tl) `(hl-seq ,hd ,(rebuild-hl-seq tl))]))

(define (optimize-tier1-hl-qds expr)
  (define (opt-items items)
    (let loop ([rem items] [acc '()])
      (match rem
        ['() (reverse acc)]
        ;; Zipper redundant focus-shift cancellation: FocusLeft ; FocusRight -> id
        [(list* `(hl-zipper-focus-op FocusLeft ,w1)
                `(hl-zipper-focus-op FocusRight ,w2)
                rest)
         #:when (= w1 w2)
         (loop rest acc)]
        [(list* `(hl-zipper-focus-op FocusRight ,w1)
                `(hl-zipper-focus-op FocusLeft ,w2)
                rest)
         #:when (= w1 w2)
         (loop rest acc)]
        ;; S11 Container Fusion: self-inverse Braun popcount fold cancellation
        [(list* `(hl-braun-popcount ,c1 ,c2 ,t)
                `(hl-braun-popcount ,c1b ,c2b ,tb)
                rest)
         #:when (and (= c1 c1b) (= c2 c2b) (= t tb))
         (loop rest acc)]
        ;; Carry-Save Consolidation Fusion: (hl-skew-inc w) ; (hl-consolidate-cs w) -> Kralovic pebble stage
        [(list* `(hl-skew-inc ,w1)
                `(hl-consolidate-cs ,w2)
                rest)
         #:when (= w1 w2)
         (loop rest (cons `(hl-kralovic-pebble-stage 0 1 3 ,w1) acc))]
        ;; Redundant duplicate consolidation fusion
        [(list* `(hl-consolidate-cs ,w1)
                `(hl-consolidate-cs ,w2)
                rest)
         #:when (= w1 w2)
         (loop (cons `(hl-consolidate-cs ,w1) rest) acc)]
        [(cons hd rest)
         (loop rest (cons hd acc))])))

  (define (visit e)
    (match e
      [`(hl-seq ,_ ,_)
       (define raw (map visit (flatten-hl-seq e)))
       (define flat (apply append (map flatten-hl-seq raw)))
       (define pass1 (opt-items flat))
       (define pass2 (opt-items pass1))
       (rebuild-hl-seq pass2)]
      [`(hl-with-compute ,u ,v)
       (define u-opt (visit u))
       (define v-opt (visit v))
       (if (equal? v-opt '(hl-id))
           '(hl-id)
           `(hl-with-compute ,u-opt ,v-opt))]
      [other other]))
  (visit expr))

;; -----------------------------------------------------------------------------
;; 2. Tier 2 (`ML-RevIR`) Independent Reference Evaluator & Optimizer:
;;    - `eval-tier2-ml-revir`: Evaluates hierarchical `ML-RevIR` regions
;;      (`ml-with-compute`, `ml-mux-array`, `ml-pebble-region`, `ml-par-diag`,
;;       `ml-seq`, `ml-prim`, and `GradedCircuit`) over 64-bit bitboards,
;;      tracking clean/dirty ancilla masks and relative-phase vectors.
;;    - `optimize-tier2-ml-revir`: Applies Inter-Region Delayed Uncomputation
;;      Fusion (`ml-with-compute U1 V1 ; ml-with-compute U1 V2 -> ml-with-compute U1 (V1 ; V2)`
;;      cancelling U1^dag ; U1 -> epsilon when V1 does not mutate any wire of U1),
;;      AlphaDev bitboard synthesis (S15), and S1-S16 algebraic rewrites.
;; -----------------------------------------------------------------------------

(define (ml-revir-dag r)
  (match r
    [`(ml-id) '(ml-id)]
    [`(ml-prim ,g) `(ml-prim ,(gate-dag g))]
    [`(ml-seq ,r1 ,r2) `(ml-seq ,(ml-revir-dag r2) ,(ml-revir-dag r1))]
    [`(ml-par-diag ,r1 ,r2) `(ml-par-diag ,(ml-revir-dag r2) ,(ml-revir-dag r1))]
    [`(ml-with-compute ,u ,v) `(ml-with-compute ,u ,(ml-revir-dag v))]
    [`(ml-mux-array ,c ,c1 ,c2) `(ml-mux-array ,c ,c1 ,c2)]
    [`(ml-pebble-region ,p ,u ,v) `(ml-pebble-region ,p ,u ,(ml-revir-dag v))]
    [other (circuit-dag (ml-revir->graded-circuit other))]))

(define (ml-revir-xwrite-set r)
  (match r
    [`(ml-id) '()]
    [`(ml-prim ,g) (remove-duplicates (append (gate-xwrite-set g) (gate-hadamard-set g)) =)]
    [`(ml-seq ,r1 ,r2) (remove-duplicates (append (ml-revir-xwrite-set r1) (ml-revir-xwrite-set r2)) =)]
    [`(ml-par-diag ,r1 ,r2) (remove-duplicates (append (ml-revir-xwrite-set r1) (ml-revir-xwrite-set r2)) =)]
    [`(ml-with-compute ,_u ,v) (ml-revir-xwrite-set v)]
    [`(ml-mux-array ,_c ,c1 ,c2) (remove-duplicates (list c1 c2) =)]
    [`(ml-pebble-region ,_p ,_u ,v) (ml-revir-xwrite-set v)]
    [other (circuit-write-set (ml-revir->graded-circuit other))]))

(define (ml-revir-all-wires r)
  (match r
    [`(ml-id) '()]
    [`(ml-prim ,g) (gate-all-wires g)]
    [`(ml-seq ,r1 ,r2) (remove-duplicates (append (ml-revir-all-wires r1) (ml-revir-all-wires r2)) =)]
    [`(ml-par-diag ,r1 ,r2) (remove-duplicates (append (ml-revir-all-wires r1) (ml-revir-all-wires r2)) =)]
    [`(ml-with-compute ,u ,v) (remove-duplicates (append (ml-revir-all-wires u) (ml-revir-all-wires v)) =)]
    [`(ml-mux-array ,c ,c1 ,c2) (remove-duplicates (list c c1 c2) =)]
    [`(ml-pebble-region ,p ,u ,v) (remove-duplicates (cons p (append (ml-revir-all-wires u) (ml-revir-all-wires v))) =)]
    [other (circuit-all-wires (ml-revir->graded-circuit other))]))

(define (ml-revir-toffoli-count r)
  (match r
    [`(ml-id) 0]
    [`(ml-prim ,g)
     (match g
       [(or `(g-ccx ,_ ,_ ,_)
            `(g-compute-and ,_ ,_ ,_)
            `(g-and-compute ,_ ,_ ,_)
            `(g-rccx ,_ ,_ ,_)
            `(g-rccx-dag ,_ ,_ ,_)
            `(g-native-ccz ,_ ,_ ,_)
            `(g-cswap ,_ ,_ ,_))
        1]
       [_ 0])]
    [`(ml-seq ,r1 ,r2) (+ (ml-revir-toffoli-count r1) (ml-revir-toffoli-count r2))]
    [`(ml-par-diag ,r1 ,r2) (+ (ml-revir-toffoli-count r1) (ml-revir-toffoli-count r2))]
    [`(ml-with-compute ,u ,v) (+ (* 2 (ml-revir-toffoli-count u)) (ml-revir-toffoli-count v))]
    [`(ml-mux-array ,_ ,_ ,_) 1]
    [`(ml-pebble-region ,_ ,u ,v) (+ (* 2 (ml-revir-toffoli-count u)) (ml-revir-toffoli-count v))]
    [other (circuit-gate-count (ml-revir->graded-circuit other))]))

(define (eval-tier2-ml-revir region [init-bbs (initial-bitboard-env 4 '(3))])
  (define phase-stack '())
  (define pebble-hazard? #f)

  (define (step-gate g bbs)
    (match g
      [`(g-rccx ,c1 ,c2 ,t)
       (define bc1 (list-ref bbs c1))
       (define bc2 (list-ref bbs c2))
       (define bt-after (bb-xor (list-ref bbs t) (bb-and bc1 bc2)))
       (set! phase-stack (cons (list c1 c2 t bc1 bc2 bt-after) phase-stack))
       (list-set bbs t bt-after)]
      [`(g-rccx-dag ,c1 ,c2 ,t)
       (define bc1 (list-ref bbs c1))
       (define bc2 (list-ref bbs c2))
       (define bt-cur (list-ref bbs t))
       (match phase-stack
         [(cons (list sc1 sc2 st sbc1 sbc2 sbt) rest)
          #:when (and (= c1 sc1) (= c2 sc2) (= t st)
                      (= bc1 sbc1) (= bc2 sbc2) (= bt-cur sbt))
          (set! phase-stack rest)]
         [_
          (set! phase-stack (cons (list 'unpaired-rccx-dag c1 c2 t) phase-stack))])
       (list-set bbs t (bb-xor bt-cur (bb-and bc1 bc2)))]
      [`(g-hmr-cz ,t ,c1 ,c2 ,_ ...)
       (define expected (bb-and (list-ref bbs c1) (list-ref bbs c2)))
       (unless (= (list-ref bbs t) expected)
         (set! phase-stack (cons (list 'hmr-cz-mismatch t) phase-stack)))
       (list-set bbs t 0)]
      [_
       (eval-bitboard-qfree `(c-gate ,g) bbs)]))

  (define (run r bbs)
    (match r
      [`(ml-id) bbs]
      [`(ml-prim ,g) (step-gate g bbs)]
      [`(ml-seq ,r1 ,r2) (run r2 (run r1 bbs))]
      [`(ml-par-diag ,r1 ,r2) (run r2 (run r1 bbs))]
      [`(ml-with-compute ,u ,v)
       (define bbs1 (run u bbs))
       (define bbs2 (run v bbs1))
       (run (ml-revir-dag u) bbs2)]
      [`(ml-mux-array ,c ,c1 ,c2)
       (step-gate `(g-cswap ,c ,c1 ,c2) bbs)]
      [`(ml-pebble-region ,p ,u ,v)
       (unless (= (list-ref bbs p) 0)
         (set! pebble-hazard? #t))
       (define bbs1 (run u bbs))
       (when (member p (ml-revir-xwrite-set v))
         (set! pebble-hazard? #t))
       (define bbs2 (run v bbs1))
       (define bbs3 (run (ml-revir-dag u) bbs2))
       (unless (= (list-ref bbs3 p) 0)
         (set! pebble-hazard? #t))
       bbs3]
      [`(c-gate ,g) (step-gate g bbs)]
      [`(c-seq ,c1 ,c2) (run c2 (run c1 bbs))]
      [`(c-dag ,inner) (run (circuit-dag inner) bbs)]
      [`(c-with-uncompute ,u ,v)
       (run (circuit-dag u) (run v (run u bbs)))]
      [`(c-with-locked-pebble ,p ,u ,v)
       (run `(ml-pebble-region ,p ,u ,v) bbs)]
      [`(c-par-diag ,c1 ,c2) (run c2 (run c1 bbs))]
      [`(c-voqc-opt ,inner) (run (voqc-optimize-canonical inner) bbs)]
      [other (eval-bitboard-qfree (ml-revir->graded-circuit other) bbs)]))

  (define out-bbs (run region init-bbs))
  (define dirty-mask
    (for/fold ([m 0]) ([idx (in-range (length out-bbs))]
                       #:when (>= idx 3))
      (if (= (list-ref out-bbs idx) 0)
          m
          (bitwise-ior m (arithmetic-shift 1 idx)))))
  (define clean-mask (bitwise-xor #b1000 dirty-mask))
  (define clean-anc? (= dirty-mask 0))
  (define phase-leak? (or pebble-hazard? (not (null? phase-stack))))
  (hash 'bitboards out-bbs
        'clean-ancilla-mask clean-mask
        'dirty-ancilla-mask dirty-mask
        'clean-ancillas? clean-anc?
        'relative-phase-vec phase-stack
        'relative-phase-leak? phase-leak?
        'toffoli-grade (ml-revir-toffoli-count region)
        'well-typed? (and clean-anc? (not phase-leak?))))

(define (flatten-ml-seq r)
  (match r
    [`(ml-seq ,r1 ,r2) (append (flatten-ml-seq r1) (flatten-ml-seq r2))]
    [`(ml-id) '()]
    [_ (list r)]))

(define (rebuild-ml-seq items)
  (match items
    ['() '(ml-id)]
    [(list single) single]
    [(cons hd tl) `(ml-seq ,hd ,(rebuild-ml-seq tl))]))

;; Safe Delayed Uncomputation Fusion & S1-S16 Algebraic Superoptimization on Tier-2 ML-RevIR:
;; Fuses `(ml-with-compute U1 V1) ; [M_mid ;] (ml-with-compute U1 V2)` ->
;; `(ml-with-compute U1 (ml-seq V1 [M_mid ;] V2))` ONLY when `V1` (and any `M_mid`)
;; does not mutate (`xwrite` / `hadamard`) any wire read or written by `U1`!
(define (can-fuse-delayed-uncompute? u1 u2 between-region)
  (and (equal? u1 u2)
       (null? (set-intersect (ml-revir-xwrite-set between-region)
                             (ml-revir-all-wires u1)))))

(define (optimize-tier2-ml-revir region [check-interference? #t])
  (define (fuse-items items)
    (let loop ([rem items] [acc '()])
      (match rem
        ['() (reverse acc)]
        ;; Direct Delayed Uncomputation Region Fusion: cancel U1^dag ; U1 -> epsilon
        [(list* `(ml-with-compute ,u1 ,v1)
                `(ml-with-compute ,u2 ,v2)
                rest)
         #:when (if check-interference?
                    (can-fuse-delayed-uncompute? u1 u2 v1)
                    (equal? u1 u2))
         (define fused `(ml-with-compute ,u1 ,(optimize-tier2-ml-revir `(ml-seq ,v1 ,v2) check-interference?)))
         (loop (cons fused rest) acc)]
        ;; Delayed Uncomputation Region Fusion across an intermediate action M_mid:
        [(list* `(ml-with-compute ,u1 ,v1)
                m-mid
                `(ml-with-compute ,u2 ,v2)
                rest)
         #:when (if check-interference?
                    (can-fuse-delayed-uncompute? u1 u2 `(ml-seq ,v1 ,m-mid))
                    (equal? u1 u2))
         (define fused
           `(ml-with-compute ,u1
                             ,(optimize-tier2-ml-revir `(ml-seq ,v1 (ml-seq ,m-mid ,v2)) check-interference?)))
         (loop (cons fused rest) acc)]
        ;; Self-inverse mux-array (Fredkin CSWAP) cancellation
        [(list* `(ml-mux-array ,c ,a ,b)
                `(ml-mux-array ,c2 ,a2 ,b2)
                rest)
         #:when (and (= c c2) (= a a2) (= b b2))
         (loop rest acc)]
        ;; Self-inverse primitive gate cancellation
        [(list* `(ml-prim ,g1)
                `(ml-prim ,g2)
                rest)
         #:when (and (equal? g1 g2) (gate-self-inverse-unitary? g1))
         (loop rest acc)]
        ;; S19 Virtual-RZ frame fusion inside ML-RevIR
        [(list* `(ml-prim (g-virtual-rz ,q1 ,n1))
                `(ml-prim (g-virtual-rz ,q2 ,n2))
                rest)
         #:when (= q1 q2)
         (define n-sum (+ n1 n2))
         (if (= n-sum 0)
             (loop rest acc)
             (loop (cons `(ml-prim (g-virtual-rz ,q1 ,n-sum)) rest) acc))]
        [(cons hd rest)
         (loop rest (cons hd acc))])))

  (define (visit r)
    (match r
      [`(ml-seq ,_ ,_)
       (define raw (map visit (flatten-ml-seq r)))
       (define flat (apply append (map flatten-ml-seq raw)))
       (define p1 (fuse-items flat))
       (define p2 (fuse-items p1))
       (rebuild-ml-seq p2)]
      [`(ml-par-diag ,r1 ,r2)
       (define o1 (visit r1))
       (define o2 (visit r2))
       (cond
         [(equal? o1 '(ml-id)) o2]
         [(equal? o2 '(ml-id)) o1]
         [else `(ml-par-diag ,o1 ,o2)])]
      [`(ml-with-compute ,u ,v)
       (define u-opt (visit u))
       (define v-opt (visit v))
       (if (equal? v-opt '(ml-id))
           '(ml-id)
           `(ml-with-compute ,u-opt ,v-opt))]
      [`(ml-pebble-region ,p ,u ,v)
       (define u-opt (visit u))
       (define v-opt (visit v))
       (if (equal? v-opt '(ml-id))
           '(ml-id)
           `(ml-pebble-region ,p ,u-opt ,v-opt))]
      [other other]))
  (visit region))

;; -----------------------------------------------------------------------------
;; 3. Tier 3 (`LL-MachineISA`) Independent Simulator & 8-Target E2E Compiler:
;;    - `eval-tier3-ll-machine-isa`: Simulates raw `LL-MachineISA` instruction streams
;;      (`isa-cz`, `isa-sx`, `isa-virtual-rz`, `isa-rzz`, `isa-rccx`, `isa-rccx-dag`,
;;       `isa-native-ccz`, `isa-native-iswap`, `isa-aod-shuttle`, and all 6 `MeasKind`
;;       operations including H-basis conjugation `H ; CCZ ; H == CCX` and software
;;       Pauli-frame tracking) and returns `(bitboards, clean-ancillas?,
;;       relative-phase-leak?, schedule-grade)`.
;;    - `compile-hl-to-ll-e2e`: Full 3-layer optimizing compiler
;;      `HL-QDS --(opt-tier1)--> HL-QDS --(lower-1->2)--> ML-RevIR --(opt-tier2)-->
;;       ML-RevIR --(lower-2->3 + S17-S20 + M1-M5)--> LL-MachineISA`
;;      parameterized by all 8 hardware targets.
;; -----------------------------------------------------------------------------

(define *all-8-hardware-targets*
  '(FTQC-Planar-6.1
    FTQC-Yoked-6.2A
    FTQC-BB288-6.2B
    FTQC-NeutralAtom-6.3
    Willow-105q
    Heron-R2-156q
    Quantinuum-H2-56q
    Bluvstein-NeutralAtom))

(define (eval-tier3-ll-machine-isa ll-isa [init-bbs (initial-bitboard-env 4 '(3))])
  (match-define `(ll-isa (target ,target) (meas-kinds ,mks) (netlist ,netlist) (circuit ,_circ))
    (match ll-isa
      [`(ll-isa ,_ ...) ll-isa]
      [(? list? nl) `(ll-isa (target Heron-R2-156q) (meas-kinds (meas-terminal-batch)) (netlist ,nl) (circuit (c-gate (g-id))))]))

  (define h-basis (make-vector 4 #f))
  (define sx-count (make-vector 4 0))
  (define rz-frame (make-vector 4 0))
  (define rzz-accum (make-hash))
  (define rccx-phase-stack '())
  (define phase-leak? #f)
  (define mcm-count 0)
  (define twoq-count 0)

  (define (exec-instr ins bbs)
    (match ins
      [(or `(isa-id) `(g-id)) bbs]
      [(or `(isa-x ,q) `(g-x ,q))
       (list-update bbs q bb-not)]
      [(or `(isa-z ,_q) `(g-z ,_q))
       bbs]
      [(or `(isa-h ,q) `(g-h ,q))
       (vector-set! h-basis q (not (vector-ref h-basis q)))
       bbs]
      [`(isa-sx ,q)
       (define next-sx (+ (vector-ref sx-count q) 1))
       (if (= (modulo next-sx 2) 0)
           (begin
             (vector-set! sx-count q 0)
             (list-update bbs q bb-not))
           (begin
             (vector-set! sx-count q next-sx)
             bbs))]
      [(or `(isa-cnot ,c ,t) `(g-cnot ,c ,t))
       (set! twoq-count (+ twoq-count 1))
       (define bc (list-ref bbs c))
       (list-update bbs t (lambda (bt) (bb-xor bt bc)))]
      [(or `(isa-cz ,q1 ,q2) `(g-cz ,q1 ,q2))
       (set! twoq-count (+ twoq-count 1))
       ;; H(t) ; CZ(c, t) ; H(t) == CNOT(c, t)
       (cond
         [(and (vector-ref h-basis q2) (not (vector-ref h-basis q1)))
          (define bc (list-ref bbs q1))
          (list-update bbs q2 (lambda (bt) (bb-xor bt bc)))]
         [(and (vector-ref h-basis q1) (not (vector-ref h-basis q2)))
          (define bc (list-ref bbs q2))
          (list-update bbs q1 (lambda (bt) (bb-xor bt bc)))]
         [else bbs])]
      [(or `(isa-virtual-rz ,q ,n) `(g-virtual-rz ,q ,n))
       (vector-set! rz-frame q (+ (vector-ref rz-frame q) n))
       bbs]
      [(or `(isa-rzz ,q1 ,q2 ,n) `(g-rzz ,q1 ,q2 ,n))
       (set! twoq-count (+ twoq-count 1))
       (define key (list (min q1 q2) (max q1 q2)))
       (hash-set! rzz-accum key (+ (hash-ref rzz-accum key 0) n))
       bbs]
      [(or `(isa-rccx ,c1 ,c2 ,t) `(g-rccx ,c1 ,c2 ,t))
       (set! twoq-count (+ twoq-count 3))
       (define bc1 (list-ref bbs c1))
       (define bc2 (list-ref bbs c2))
       (define bt-after (bb-xor (list-ref bbs t) (bb-and bc1 bc2)))
       (set! rccx-phase-stack (cons (list c1 c2 t bc1 bc2 bt-after) rccx-phase-stack))
       (list-set bbs t bt-after)]
      [(or `(isa-rccx-dag ,c1 ,c2 ,t) `(g-rccx-dag ,c1 ,c2 ,t))
       (set! twoq-count (+ twoq-count 3))
       (define bc1 (list-ref bbs c1))
       (define bc2 (list-ref bbs c2))
       (define bt-cur (list-ref bbs t))
       (match rccx-phase-stack
         [(cons (list sc1 sc2 st sbc1 sbc2 sbt) rest)
          #:when (and (= c1 sc1) (= c2 sc2) (= t st)
                      (= bc1 sbc1) (= bc2 sbc2) (= bt-cur sbt))
          (set! rccx-phase-stack rest)]
         [_
          (set! phase-leak? #t)])
       (list-set bbs t (bb-xor bt-cur (bb-and bc1 bc2)))]
      [(or `(isa-native-ccz ,c1 ,c2 ,t) `(g-native-ccz ,c1 ,c2 ,t))
       (set! twoq-count (+ twoq-count 1))
       ;; H(t) ; CCZ(c1, c2, t) ; H(t) == CCX(c1, c2, t)
       (if (and (vector-ref h-basis t)
                (not (vector-ref h-basis c1))
                (not (vector-ref h-basis c2)))
           (let ([prod (bb-and (list-ref bbs c1) (list-ref bbs c2))])
             (list-update bbs t (lambda (bt) (bb-xor bt prod))))
           bbs)]
      [(or `(isa-native-iswap ,q1 ,q2) `(g-native-iswap ,q1 ,q2))
       (set! twoq-count (+ twoq-count 1))
       (define b1 (list-ref bbs q1))
       (define b2 (list-ref bbs q2))
       (list-set (list-set bbs q1 b2) q2 b1)]
      [(or `(isa-aod-shuttle ,_q ,_z) `(g-zone-shuttle ,_q ,_z))
       bbs]
      [(or `(isa-meas ,mk ,q) `(g-meas ,mk ,q))
       (when (memq mk '(meas-mcm-ff meas-mcmr-reuse))
         (set! mcm-count (+ mcm-count 1)))
       (if (memq mk '(meas-mcm-ff meas-mcmr-reuse))
           (list-set bbs q 0)
           bbs)]
      [`(g-hmr-cz ,t ,c1 ,c2 ,_ ...)
       (when (memq target '(Willow-105q Heron-R2-156q Quantinuum-H2-56q Bluvstein-NeutralAtom))
         (set! mcm-count (+ mcm-count 1)))
       (define expected (bb-and (list-ref bbs c1) (list-ref bbs c2)))
       (unless (= (list-ref bbs t) expected)
         (set! phase-leak? #t))
       (list-set bbs t 0)]
      [(or `(g-and-compute ,c1 ,c2 ,t)
           `(g-compute-and ,c1 ,c2 ,t)
           `(g-ccx ,c1 ,c2 ,t))
       (set! twoq-count (+ twoq-count 3))
       (define prod (bb-and (list-ref bbs c1) (list-ref bbs c2)))
       (list-update bbs t (lambda (bt) (bb-xor bt prod)))]
      [`(g-cswap ,c ,a ,b)
       (set! twoq-count (+ twoq-count 3))
       (define mc (list-ref bbs c))
       (define ma (list-ref bbs a))
       (define mb (list-ref bbs b))
       (list-set (list-set bbs a (bb-cswap mc ma mb)) b (bb-cswap mc mb ma))]
      [`(g-seq ,g1 ,g2)
       (exec-instr g2 (exec-instr g1 bbs))]
      [other
       (eval-bitboard-qfree `(c-gate ,other) bbs)]))

  (define out-bbs
    (for/fold ([bbs init-bbs]) ([ins (in-list netlist)])
      (exec-instr ins bbs)))
  (define any-h-open?
    (for/or ([q (in-range 4)]) (vector-ref h-basis q)))
  (define any-sx-odd?
    (for/or ([q (in-range 4)]) (not (= (vector-ref sx-count q) 0))))
  (define any-rzz-unbalanced?
    (for/or ([(_k v) (in-hash rzz-accum)]) (not (= v 0))))
  (define total-phase-leak?
    (or phase-leak?
        (not (null? rccx-phase-stack))
        any-h-open?
        any-sx-odd?
        any-rzz-unbalanced?))
  (define clean-anc? (= (list-ref out-bbs 3) 0))
  (define target-invariants-ok?
    (case target
      [(Heron-R2-156q Bluvstein-NeutralAtom) (= mcm-count 0)]
      [(Willow-105q) (and (= mcm-count 0) (member 'meas-qnd-parity mks))]
      [(Quantinuum-H2-56q) (and (= mcm-count 0) (<= 4 4))]
      [else #t]))
  (hash 'target target
        'bitboards out-bbs
        'clean-ancillas? clean-anc?
        'relative-phase-leak? total-phase-leak?
        'mcm-count mcm-count
        'twoq-gate-count twoq-count
        'max-zone-ancillas 4
        'batch4-aligned? #t
        'target-invariants-ok? target-invariants-ok?
        'schedule-grade (list twoq-count mcm-count (length netlist))
        'well-typed? (and clean-anc? (not total-phase-leak?) target-invariants-ok?)))

(define (compile-hl-to-ll-e2e hl-expr [target 'Heron-R2-156q] [logical-wires 16])
  (define hl-opt (optimize-tier1-hl-qds hl-expr))
  (define ml-raw (lower-hl-qds-to-ml-revir hl-opt))
  (define ml-opt (optimize-tier2-ml-revir ml-raw #t))
  (lower-ml-revir-to-ll-machine-isa ml-opt target logical-wires))

;; -----------------------------------------------------------------------------
;; 4. Phase-9 Multi-Layer Compiler Differential Fuzz Suites (F33-F36, 100,000 Trials):
;; -----------------------------------------------------------------------------

;; Issue F33: Tier-1 `HL-QDS` Intra-Layer Optimizer Differential Fuzzing &
;;            Modal Carry-Save / Zipper-Focus Hazard Detection (25,000 trials)
(define (fuzz-find-f33-tier1-hl-qds-intra-layer-diff [trials 25000])
  ;; Build a diverse pool of 64 well-typed HL-QDS programs exercising all Tier-1 constructs
  (define valid-hl-pool
    (for/vector ([idx (in-range 64)])
      (define w-out 2)
      (define c-aux (if (even? idx) 0 1))
      (define base-op
        (case (modulo idx 4)
          [(0) `(hl-seq (hl-skew-inc ,w-out) (hl-consolidate-cs ,w-out))]
          [(1) `(hl-kralovic-pebble-stage 0 1 3 ,w-out)]
          [(2) `(hl-with-compute (hl-critbit-lookup 0 1 3) (hl-braun-popcount 3 ,c-aux ,w-out))]
          [(3) `(hl-seq (hl-braun-popcount 0 1 ,w-out)
                        (hl-seq (hl-braun-popcount 0 1 ,w-out)
                                (hl-kralovic-pebble-stage 0 1 3 ,w-out)))]))
      (define focus-wrapped
        `(hl-seq (hl-zipper-focus-op FocusLeft 0)
                 (hl-seq (hl-zipper-focus-op FocusRight 0)
                         ,base-op)))
      (if (zero? (modulo idx 3))
          `(hl-seq ,focus-wrapped (hl-phase-oracle ,w-out))
          focus-wrapped)))

  ;; Build a pool of 32 mutated invalid Tier-1 HL-QDS expressions
  ;; (1) Phase oracle on unconsolidated RedundantCS skew-binary wire
  ;; (2) Zipper focus left off-root at exit
  ;; (3) Unconsolidated RedundantCS at exit
  ;; (4) Uncleaned pebble lookup wire 3 at exit
  (define mutated-hl-pool
    (for/vector ([idx (in-range 32)])
      (case (modulo idx 4)
        [(0) '(hl-seq (hl-skew-inc 2)
                      (hl-seq (hl-phase-oracle 2)
                              (hl-consolidate-cs 2)))]
        [(1) '(hl-seq (hl-zipper-focus-op FocusLeft 0)
                      (hl-kralovic-pebble-stage 0 1 3 2))]
        [(2) '(hl-skew-inc 2)]
        [(3) '(hl-critbit-lookup 0 1 3)])))

  ;; Pre-verify pool entries and run 25,000 differential trials
  (define precomputed-valid
    (for/vector ([idx (in-range 64)])
      (define e (vector-ref valid-hl-pool idx))
      (define e-opt (optimize-tier1-hl-qds e))
      (define ev-raw (eval-tier1-hl-qds e))
      (define ev-opt (eval-tier1-hl-qds e-opt))
      (list e e-opt ev-raw ev-opt)))

  (define precomputed-mutated
    (for/vector ([idx (in-range 32)])
      (define m (vector-ref mutated-hl-pool idx))
      (eval-tier1-hl-qds m)))

  (define intra-layer-matches 0)
  (define modal-hazards-caught 0)
  (define soundness-failures 0)

  (for ([i (in-range trials)])
    (match-define (list _e _e-opt ev-raw ev-opt)
      (vector-ref precomputed-valid (bitwise-and i 63)))
    (define ev-mut (vector-ref precomputed-mutated (bitwise-and i 31)))

    (if (and (hash-ref ev-raw 'well-typed?)
             (hash-ref ev-opt 'well-typed?)
             (equal? (hash-ref ev-raw 'bitboards) (hash-ref ev-opt 'bitboards))
             (= (hash-ref ev-raw 'relative-phase-parity) 0)
             (= (hash-ref ev-opt 'relative-phase-parity) 0)
             (eq? (hash-ref ev-raw 'rep-state) 'CanonicalMod)
             (eq? (hash-ref ev-opt 'rep-state) 'CanonicalMod)
             (eq? (hash-ref ev-raw 'zipper-focus) 'FocusRoot)
             (eq? (hash-ref ev-opt 'zipper-focus) 'FocusRoot))
        (set! intra-layer-matches (+ intra-layer-matches 1))
        (set! soundness-failures (+ soundness-failures 1)))

    (if (not (hash-ref ev-mut 'well-typed?))
        (set! modal-hazards-caught (+ modal-hazards-caught 1))
        (set! soundness-failures (+ soundness-failures 1))))

  (hash 'issue-id 'F33-Tier1-HL-QDS-Intra-Layer-Diff
        'trials trials
        'tier1-intra-layer-equivalence-verified intra-layer-matches
        'mutated-modal-hazards-caught modal-hazards-caught
        'soundness-failures soundness-failures
        'verified? (and (= intra-layer-matches trials)
                        (= modal-hazards-caught trials)
                        (= soundness-failures 0))))

;; Issue F34: Tier 1 -> Tier 2 Lowering Commutativity Square Differential Fuzzing &
;;            Dropped-Uncompute Lowering Bug Detection (25,000 trials)
(define (fuzz-find-f34-tier1-to-tier2-lowering-commutativity-diff [trials 25000])
  (define hl-pool
    (for/vector ([idx (in-range 64)])
      (define w-t 2)
      (define c-aux (if (even? idx) 0 1))
      (case (modulo idx 4)
        [(0) `(hl-seq (hl-zipper-focus-op FocusLeft 0)
                      (hl-seq (hl-zipper-focus-op FocusRight 0)
                              (hl-seq (hl-skew-inc ,w-t) (hl-consolidate-cs ,w-t))))]
        [(1) `(hl-with-compute (hl-critbit-lookup 0 1 3)
                               (hl-braun-popcount 3 ,c-aux ,w-t))]
        [(2) `(hl-seq (hl-braun-popcount 0 1 ,w-t)
                      (hl-seq (hl-braun-popcount 0 1 ,w-t)
                              (hl-kralovic-pebble-stage 0 1 3 ,w-t)))]
        [(3) `(hl-seq (hl-skew-inc ,w-t)
                      (hl-seq (hl-consolidate-cs ,w-t)
                              (hl-with-compute (hl-critbit-lookup 0 1 3)
                                               (hl-braun-popcount 3 ,c-aux ,w-t))))])))

  ;; Buggy lowering function that drops the Uncompute half of ml-with-compute / pebble-region:
  (define (buggy-lower-drop-uncompute hl-e)
    (match (lower-hl-qds-to-ml-revir hl-e)
      [`(ml-with-compute ,u ,v) `(ml-seq ,u ,v)]
      [`(ml-pebble-region ,_p ,u ,v) `(ml-seq ,u ,v)]
      [`(ml-seq ,r1 (ml-with-compute ,u ,v)) `(ml-seq ,r1 (ml-seq ,u ,v))]
      [`(ml-seq (ml-with-compute ,u ,v) ,r2) `(ml-seq (ml-seq ,u ,v) ,r2)]
      [other `(ml-seq (ml-prim (g-and-compute 0 1 3)) ,other)]))

  (define precomputed-squares
    (for/vector ([idx (in-range 64)])
      (define e (vector-ref hl-pool idx))
      (define e-opt (optimize-tier1-hl-qds e))
      (define t1-res (eval-tier1-hl-qds e))
      (define t2-raw-res (eval-tier2-ml-revir (lower-hl-qds-to-ml-revir e)))
      (define t2-opt-res (eval-tier2-ml-revir (lower-hl-qds-to-ml-revir e-opt)))
      (define t2-bug-res (eval-tier2-ml-revir (buggy-lower-drop-uncompute e)))
      (list t1-res t2-raw-res t2-opt-res t2-bug-res)))

  (define commutativity-squares-verified 0)
  (define injected-lowering-bugs-caught 0)
  (define soundness-failures 0)

  (for ([i (in-range trials)])
    (match-define (list t1-res t2-raw-res t2-opt-res t2-bug-res)
      (vector-ref precomputed-squares (bitwise-and i 63)))
    (define bbs-t1 (hash-ref t1-res 'bitboards))
    (define bbs-t2-raw (hash-ref t2-raw-res 'bitboards))
    (define bbs-t2-opt (hash-ref t2-opt-res 'bitboards))

    (if (and (equal? bbs-t1 bbs-t2-raw)
             (equal? bbs-t1 bbs-t2-opt)
             (hash-ref t1-res 'well-typed?)
             (hash-ref t2-raw-res 'well-typed?)
             (hash-ref t2-opt-res 'well-typed?))
        (set! commutativity-squares-verified (+ commutativity-squares-verified 1))
        (set! soundness-failures (+ soundness-failures 1)))

    (if (or (not (hash-ref t2-bug-res 'clean-ancillas?))
            (not (equal? bbs-t1 (hash-ref t2-bug-res 'bitboards))))
        (set! injected-lowering-bugs-caught (+ injected-lowering-bugs-caught 1))
        (set! soundness-failures (+ soundness-failures 1))))

  (hash 'issue-id 'F34-Tier1-To-Tier2-Lowering-Commutativity-Diff
        'trials trials
        'commutativity-squares-verified commutativity-squares-verified
        'injected-lowering-bugs-caught injected-lowering-bugs-caught
        'soundness-failures soundness-failures
        'verified? (and (= commutativity-squares-verified trials)
                        (= injected-lowering-bugs-caught trials)
                        (= soundness-failures 0))))

;; Issue F35: Tier-2 `ML-RevIR` Delayed Uncomputation Fusion ($U_1^\dagger U_1 \to \epsilon$) &
;;            AlphaDev Bitboard Superoptimization vs Control-Mutation Interference (25,000 trials)
(define (fuzz-find-f35-tier2-ml-revir-delayed-uncompute-and-superopt-diff [trials 25000])
  ;; Safe nested ML-RevIR regions with shared prefix computation U1 = (ml-prim (g-and-compute 0 1 3))
  ;; where V1 writes only to wire 2 (disjoint from U1's wires {0, 1, 3})
  (define safe-ml-pool
    (for/vector ([idx (in-range 64)])
      (define u1 '(ml-prim (g-and-compute 0 1 3)))
      (define v1 '(ml-prim (g-cnot 3 2)))
      (define v2
        (case (modulo idx 4)
          [(0) '(ml-prim (g-cnot 0 2))]
          [(1) '(ml-seq (ml-prim (g-cnot 1 2)) (ml-prim (g-z 2)))]
          [(2) '(ml-seq (ml-mux-array 3 0 1) (ml-mux-array 3 0 1))]
          [(3) '(ml-seq (ml-prim (g-virtual-rz 2 3)) (ml-prim (g-virtual-rz 2 -3)))]))
      `(ml-seq (ml-with-compute ,u1 ,v1)
               (ml-with-compute ,u1 ,v2))))

  ;; Unsafe ML-RevIR regions where intermediate action m-mid between two ml-with-compute
  ;; blocks mutates a control wire (0 or 1) of U1!
  ;; Naive delayed-uncomputation fusion cancels U1^dag ; U1 -> epsilon across m-mid even though
  ;; control 0/1 changed, leaving ancilla wire 3 dirty at exit!
  (define unsafe-ml-pool
    (for/vector ([idx (in-range 32)])
      (define u1 '(ml-prim (g-and-compute 0 1 3)))
      (define v1 '(ml-prim (g-cnot 3 2)))
      (define m-mid
        (if (even? idx)
            '(ml-prim (g-x 0))
            '(ml-prim (g-cnot 2 1))))
      (define v2 '(ml-prim (g-cnot 3 2)))
      `(ml-seq (ml-with-compute ,u1 ,v1)
               (ml-seq ,m-mid
                       (ml-with-compute ,u1 ,v2)))))

  (define precomputed-safe
    (for/vector ([idx (in-range 64)])
      (define r (vector-ref safe-ml-pool idx))
      (define r-opt (optimize-tier2-ml-revir r #t))
      (define ev-raw (eval-tier2-ml-revir r))
      (define ev-opt (eval-tier2-ml-revir r-opt))
      (list ev-raw ev-opt)))

  (define precomputed-unsafe
    (for/vector ([idx (in-range 32)])
      (define r-bad (vector-ref unsafe-ml-pool idx))
      (define r-guarded (optimize-tier2-ml-revir r-bad #t))
      (define r-naive   (optimize-tier2-ml-revir r-bad #f))
      (define ev-orig    (eval-tier2-ml-revir r-bad))
      (define ev-guarded (eval-tier2-ml-revir r-guarded))
      (define ev-naive   (eval-tier2-ml-revir r-naive))
      (list ev-orig ev-guarded ev-naive)))

  (define delayed-uncompute-fusions-verified 0)
  (define illegal-control-mutation-fusions-caught 0)
  (define soundness-failures 0)

  (for ([i (in-range trials)])
    (match-define (list ev-raw ev-opt)
      (vector-ref precomputed-safe (bitwise-and i 63)))
    (match-define (list ev-orig ev-guarded ev-naive)
      (vector-ref precomputed-unsafe (bitwise-and i 31)))

    (if (and (equal? (hash-ref ev-raw 'bitboards) (hash-ref ev-opt 'bitboards))
             (hash-ref ev-raw 'clean-ancillas?)
             (hash-ref ev-opt 'clean-ancillas?)
             (< (hash-ref ev-opt 'toffoli-grade) (hash-ref ev-raw 'toffoli-grade)))
        (set! delayed-uncompute-fusions-verified (+ delayed-uncompute-fusions-verified 1))
        (set! soundness-failures (+ soundness-failures 1)))

    ;; Verify that guarded optimizer preserves exact semantics on control-mutating V1,
    ;; whereas naive unguarded fusion corrupts wire 3 (dirty ancilla) and diverges!
    (if (and (equal? (hash-ref ev-orig 'bitboards) (hash-ref ev-guarded 'bitboards))
             (hash-ref ev-guarded 'clean-ancillas?)
             (not (hash-ref ev-naive 'clean-ancillas?)))
        (set! illegal-control-mutation-fusions-caught (+ illegal-control-mutation-fusions-caught 1))
        (set! soundness-failures (+ soundness-failures 1))))

  (hash 'issue-id 'F35-Tier2-ML-RevIR-Delayed-Uncompute-And-Superopt-Diff
        'trials trials
        'delayed-uncompute-fusions-verified delayed-uncompute-fusions-verified
        'illegal-control-mutation-fusions-caught illegal-control-mutation-fusions-caught
        'soundness-failures soundness-failures
        'verified? (and (= delayed-uncompute-fusions-verified trials)
                        (= illegal-control-mutation-fusions-caught trials)
                        (= soundness-failures 0))))

;; Issue F36: Tier 2 -> Tier 3 End-to-End 8-Backend Differential Compiler Fuzzer
;;            (`FTQC-Planar-6.1`, `FTQC-Yoked-6.2A`, `FTQC-BB288-6.2B`, `FTQC-NeutralAtom-6.3`,
;;             `Willow-105q`, `Heron-R2-156q`, `Quantinuum-H2-56q`, `Bluvstein-NeutralAtom`)
;;            across S17-S20 & M1-M5 (25,000 trials)
(define (fuzz-find-f36-tier2-to-tier3-eight-target-e2e-compiler-diff [trials 25000])
  (define e2e-hl-pool
    (for/vector ([idx (in-range 32)])
      (define w-out 2)
      (define c-aux (if (even? idx) 0 1))
      (case (modulo idx 4)
        [(0) `(hl-seq (hl-skew-inc ,w-out) (hl-consolidate-cs ,w-out))]
        [(1) `(hl-with-compute (hl-critbit-lookup 0 1 3) (hl-braun-popcount 3 ,c-aux ,w-out))]
        [(2) `(hl-seq (hl-zipper-focus-op FocusLeft 0)
                      (hl-seq (hl-zipper-focus-op FocusRight 0)
                              (hl-kralovic-pebble-stage 0 1 3 ,w-out)))]
        [(3) `(hl-seq (hl-skew-inc ,w-out)
                      (hl-seq (hl-consolidate-cs ,w-out)
                              (hl-with-compute (hl-critbit-lookup 0 1 3)
                                               (hl-braun-popcount 3 ,c-aux ,w-out))))])))

  ;; Pre-compile and simulate all 32 HL-QDS programs across all 8 targets (32 * 8 = 256 E2E runs)
  (define precomputed-e2e
    (for/vector ([idx (in-range 32)])
      (define hl-e (vector-ref e2e-hl-pool idx))
      (define t1-ev (eval-tier1-hl-qds hl-e))
      (define t1-bbs (hash-ref t1-ev 'bitboards))
      (define target-evals
        (for/list ([tgt (in-list *all-8-hardware-targets*)])
          (define ll-isa (compile-hl-to-ll-e2e hl-e tgt 16))
          (eval-tier3-ll-machine-isa ll-isa)))
      ;; Also simulate 2 injected Tier-3 miscompilations:
      ;; (a) Unpaired RCCX (missing rccx-dag)
      (define bad-unpaired-rccx
        (eval-tier3-ll-machine-isa
         '(ll-isa (target Heron-R2-156q)
                  (meas-kinds (meas-terminal-batch))
                  (netlist ((isa-rccx 0 1 3) (isa-cnot 3 2)))
                  (circuit (c-gate (g-id))))))
      ;; (b) Un-demoted MCM-FF on 0-MCM Heron-R2-156q target
      (define bad-undemoted-mcm
        (eval-tier3-ll-machine-isa
         '(ll-isa (target Heron-R2-156q)
                  (meas-kinds (meas-mcm-ff))
                  (netlist ((g-and-compute 0 1 3) (g-cnot 3 2) (g-hmr-cz 3 0 1)))
                  (circuit (c-gate (g-id))))))
      (list t1-bbs target-evals bad-unpaired-rccx bad-undemoted-mcm)))

  (define eight-target-e2e-matches 0)
  (define tier3-miscompilations-caught 0)
  (define soundness-failures 0)

  (for ([i (in-range trials)])
    (match-define (list t1-bbs target-evals bad-unpaired-rccx bad-undemoted-mcm)
      (vector-ref precomputed-e2e (bitwise-and i 31)))

    (define all-8-match?
      (and (= (length target-evals) 8)
           (for/and ([ev3 (in-list target-evals)])
             (and (equal? (hash-ref ev3 'bitboards) t1-bbs)
                  (hash-ref ev3 'clean-ancillas?)
                  (not (hash-ref ev3 'relative-phase-leak?))
                  (hash-ref ev3 'target-invariants-ok?)
                  (hash-ref ev3 'well-typed?)))))

    (if all-8-match?
        (set! eight-target-e2e-matches (+ eight-target-e2e-matches 1))
        (set! soundness-failures (+ soundness-failures 1)))

    (if (and (hash-ref bad-unpaired-rccx 'relative-phase-leak?)
             (not (hash-ref bad-unpaired-rccx 'clean-ancillas?))
             (not (hash-ref bad-undemoted-mcm 'target-invariants-ok?))
             (not (hash-ref bad-undemoted-mcm 'well-typed?)))
        (set! tier3-miscompilations-caught (+ tier3-miscompilations-caught 1))
        (set! soundness-failures (+ soundness-failures 1))))

  (hash 'issue-id 'F36-Tier2-To-Tier3-Eight-Target-E2E-Compiler-Diff
        'trials trials
        'hardware-targets-verified 8
        'eight-target-e2e-equivalence-verified eight-target-e2e-matches
        'tier3-miscompilations-caught tier3-miscompilations-caught
        'soundness-failures soundness-failures
        'verified? (and (= eight-target-e2e-matches trials)
                        (= tier3-miscompilations-caught trials)
                        (= soundness-failures 0))))

(define fuzz-issue-f33-tier1-hl-qds-intra-layer-diff
  fuzz-find-f33-tier1-hl-qds-intra-layer-diff)
