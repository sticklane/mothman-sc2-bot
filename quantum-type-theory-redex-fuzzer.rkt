  (hash 'issue-id 'F52-floquet-honeycomb-period3-zipper-cut-pass-m12
        'suite-id 'S32-PassM12-OQP17-TODAY10-Floquet-Honeycomb-Period3
        'trials trials
        'm12-floquet-mod3-aligned-verified m12-floquet-mod3-aligned-verified
        'misaligned-floquet-seam-mutant-caught misaligned-floquet-seam-mutant-caught
