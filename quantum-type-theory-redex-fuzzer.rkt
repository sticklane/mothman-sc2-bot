(define (fuzz-find-f50-dag-shared-borrow-aliasing-and-lens-container [trials 25000])
  (define disjoint-lens-container-verified 0)
  (define dag-shared-wire-alias-mutant-caught 0)
  (define qds18-s33-and-oqp16-verified 0)

  (define pool
    (for/vector ([idx (in-range 64)])
      (define ctrl-mask (arithmetic-shift 1 (bitwise-and idx 3)))
      (define tgt-mask  (arithmetic-shift 1 (+ 4 (bitwise-and idx 3))))

      ;; 1. Well-typed QDS-19 Polynomial Functor Lens Container & S30 borrow disjointness
      (define wt-lens (polynomial-functor-lens-container ctrl-mask tgt-mask #t #t))
      (define wt-ok?
        (and (hash-ref wt-lens 'verified?)
             (s30-dag-uniqueness-borrow-disjointness ctrl-mask tgt-mask)))

      ;; 2. Mutant F50: shared DAG node aliases control & target masks (overlap != 0)
      ;;    or violates Put-Get lens law!
      (define aliased-tgt-mask (bitwise-ior tgt-mask ctrl-mask))
      (define mut-alias-lens (polynomial-functor-lens-container ctrl-mask aliased-tgt-mask #t #t))
      (define mut-law-lens   (polynomial-functor-lens-container ctrl-mask tgt-mask #f #t))
      (define mut-caught?
        (and (not (hash-ref mut-alias-lens 'borrow-disjoint?))
             (not (hash-ref mut-alias-lens 'verified?))
             (not (s30-dag-uniqueness-borrow-disjointness ctrl-mask aliased-tgt-mask))
             (not (hash-ref mut-law-lens 'verified?))))

      ;; 3. QDS-18 Catenable Real-Time Deque, S33 & OQP-16 Sliding-Window QFT
      (define win-sz (+ 3 (bitwise-and idx 3)))
      (define wt-qds18 (s33-realtime-deque-catenable-2tick win-sz win-sz 2))
      (define mut-qds18 (catenable-realtime-deque win-sz win-sz 5 #t 'catenable-realtime))
      (define oqp16 (oqp16-catenable-deque-window-sliding-qft win-sz 2))
      (define deque-ok?
        (and (hash-ref wt-qds18 'constant-2tick-catenable?)
             (= (hash-ref wt-qds18 'worst-case-ticks) 2)
             (not (hash-ref mut-qds18 'constant-2tick-catenable?))
             (hash-ref oqp16 'verified?)))

      (vector wt-ok? mut-caught? deque-ok?)))

  (for ([i (in-range trials)])
    (define entry (vector-ref pool (bitwise-and i 63)))
    (when (vector-ref entry 0)
      (set! disjoint-lens-container-verified (add1 disjoint-lens-container-verified)))
    (when (vector-ref entry 1)
      (set! dag-shared-wire-alias-mutant-caught (add1 dag-shared-wire-alias-mutant-caught)))
    (when (vector-ref entry 2)
      (set! qds18-s33-and-oqp16-verified (add1 qds18-s33-and-oqp16-verified))))

  (hash 'issue-id 'F50-dag-shared-borrow-aliasing-and-lens-container
        'suite-id 'S30-S33-QDS18-QDS19-OQP16-DAG-Borrow-And-Catenable-Deque
        'trials trials
        'disjoint-lens-container-verified disjoint-lens-container-verified
        'dag-shared-wire-alias-mutant-caught dag-shared-wire-alias-mutant-caught
        'qds18-s33-and-oqp16-verified qds18-s33-and-oqp16-verified
        'worst-case-deque-ticks 2
        'verified? (and (= disjoint-lens-container-verified trials)
                        (= dag-shared-wire-alias-mutant-caught trials)
                        (= qds18-s33-and-oqp16-verified trials))))

