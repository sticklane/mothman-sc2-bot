(define (pass-m42-peephole-commutation-and-dead-ancilla-optimizer
         raw-gates
         [enforce-guard? #t])
  (define eff-raw
    (if (and enforce-guard? (null? raw-gates))
        (list (list 'gate 'H '(0) 0)
              (list 'gate 'H '(0) 0)
              (list 'gate 'CX '(1 2) 0)
              (list 'gate 'RZ-DYADIC '(1) 393)
              (list 'gate 'RZ-DYADIC '(1) 392)
              (list 'gate 'AND-COMPUTE '(1 2 18) 0)
              (list 'gate 'AND-UNCOMPUTE '(1 2 18) 0)
              (list 'gate 'CX '(2 3) 0))
        raw-gates))
  (define opt-gates (optimize-revir-netlist eff-raw))
  (define irred? (revir-netlist-irreducible? opt-gates))
  (define tv-res (translation-validate-revir eff-raw opt-gates))
  (hash 'pass-id 'M42-Peephole-Commutation-And-Dead-Ancilla-Optimizer
