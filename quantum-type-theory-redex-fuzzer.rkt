;; -----------------------------------------------------------------------------
;; Phase-4 Fuzz Finding F13: VOQC Gate-Cancellation Across QEC or Basis Barrier
;; -----------------------------------------------------------------------------
;; Vulnerability in Naive VOQC (`voqc-optimize-naive`) & Phase-3 `typeof-canonical`:
;; `voqc-optimize-naive` cancels self-inverse gate pairs `G ; ... ; G -> I` whenever
;; intermediate gates do not X-write to `G`'s wires, ignoring:
;;   (a) Conjugate basis flips `H(w) ; Z(w) ; H(w) = X(w) != Z(w)`,
;;   (b) Diagonal phase kickback `CNOT(c, t) ; Z(t) ; CNOT(c, t)` (`(-1)^(x_c xor x_t)`),
;;   (c) Intermediate `Stim` detector annotations `(g-stim-detector t)` between
;;       `(g-compute-and 0 1 3)` and `(g-compute-and 0 1 3)`, erasing the dirty
;;       ancilla state at the detector!
;; Fix (Fix F13 & Simplification S9 `voqc-optimize-canonical` / `can-commute-past?`):
;; Certified commutator-checked gate cancellation refuses to commute across non-commuting
;; Z-phase, Hadamard, measurement, QEC barrier, or Stim detector boundaries.
(define (fuzz-issue-f13-voqc-gate-cancel-across-qec-or-basis-barrier [trials 2500])
  (define naive-voqc-failures 0)
  (define canonical-voqc-failures 0)
  (define certified-compiler-failures 0)
  (define minimal-counterexample #f)

  (for ([trial (in-range trials)])
    (define kind
      (rand-choice '(valid-commuting-cnot-cancel
                     valid-commuting-cz-cancel
                     bug-cancel-h-across-z
                     bug-cancel-cnot-across-target-z
                     bug-cancel-ccx-across-stim-detector)))
    (define circ
      (match kind
        ['valid-commuting-cnot-cancel
         `(c-seq (c-gate (g-cnot 0 1))
                 (c-seq (c-gate (g-cnot 0 2))
                        (c-gate (g-cnot 0 1))))]
        ['valid-commuting-cz-cancel
         `(c-seq (c-gate (g-cz 0 1))
                 (c-seq (c-gate (g-cz 0 2))
                        (c-gate (g-cz 0 1))))]
        ['bug-cancel-h-across-z
         ;; H(3) ; Z(3) ; H(3) = X(3), but naive VOQC cancels H(3) across Z(3) -> Z(3)!
         `(c-seq (c-gate (g-h 3))
                 (c-seq (c-gate (g-z 3))
                        (c-gate (g-h 3))))]
        ['bug-cancel-cnot-across-target-z
         ;; CNOT(0,3) ; Z(3) ; CNOT(0,3) kicks back Z(0)*Z(3), but naive VOQC -> Z(3)!
         `(c-seq (c-gate (g-cnot 0 3))
                 (c-seq (c-gate (g-z 3))
                        (c-gate (g-cnot 0 3))))]
        ['bug-cancel-ccx-across-stim-detector
         ;; ComputeAND(0,1,3) ; StimDetector(3) ; ComputeAND(0,1,3):
         ;; Naive VOQC cancels ComputeAND across StimDetector(3), hiding the detector fault!
         `(c-seq (c-gate (g-compute-and 0 1 3))
                 (c-seq (c-gate (g-stim-detector 3))
                        (c-gate (g-compute-and 0 1 3))))]))

    (define init-anfs (initial-anf-env 4 '(3)))
    (define init-zones (make-list 4 'EntanglingZone))
    (define in-bits (list 1 1 (rand-int 0 1) 0))
    (define init-st `(wire-state (vals ,in-bits) (anf ,init-anfs) (phase 1) (zones ,init-zones)))

    (define out-orig  (eval-circuit-raw circ init-st))
    (define out-naive (eval-circuit-raw (voqc-optimize-naive circ) init-st))
    (define out-canon (eval-circuit-raw (voqc-optimize-canonical circ) init-st))

    (define naive-sem-eq? (equal? out-naive out-orig))
    (define canon-sem-eq? (equal? out-canon out-orig))

    ;; Also check `(c-voqc-opt circ)` under Phase-3 (naive VOQC) vs Phase-4 Certified Compiler
    (define voqc-wrapped `(c-voqc-opt ,circ))
    (define cert-grade (Synthesize-Certified-Compiler-Grade voqc-wrapped init-anfs init-zones))
    (define cert-ok? (certified-compiler-restoration-law-holds? cert-grade init-anfs '(3)))
    (match-define `(wire-state (vals ,voqc-bits) (anf ,voqc-anfs) (phase ,_voqc-ph) (zones ,_))
      (eval-circuit-raw voqc-wrapped init-st))
    (define voqc-ancilla-clean?
      (and (= (list-ref voqc-bits 3) 0)
           (null? (list-ref voqc-anfs 3))))

    (unless naive-sem-eq?
      (set! naive-voqc-failures (+ naive-voqc-failures 1))
      (unless minimal-counterexample
        (define bloated (pad-circuit-for-shrinking circ))
        (define (f13-bug-pred? cand)
          (not (equal? (eval-circuit-raw (voqc-optimize-naive cand) init-st)
                       (eval-circuit-raw cand init-st))))
        (define shrunk (shrink-circuit bloated f13-bug-pred?))
        (set! minimal-counterexample
              (hash 'unshrunk-gate-count (circuit-gate-count bloated)
                    'shrunk-gate-count (circuit-gate-count shrunk)
                    'circuit shrunk
                    'naive-optimized-circuit (voqc-optimize-naive shrunk)
                    'canonical-optimized-circuit (voqc-optimize-canonical shrunk)
                    'input-bits in-bits
                    'unoptimized-eval (eval-circuit-raw shrunk init-st)
                    'naive-voqc-eval (eval-circuit-raw (voqc-optimize-naive shrunk) init-st)))))

    (unless canon-sem-eq?
      (set! canonical-voqc-failures (+ canonical-voqc-failures 1)))
    (when (and cert-ok? (not voqc-ancilla-clean?))
      (set! certified-compiler-failures (+ certified-compiler-failures 1))))

  (hash 'issue-id 'F13-VOQC-Gate-Cancel-Across-QEC-or-Basis-Barrier
        'trials trials
        'naive-voqc-semantic-failures naive-voqc-failures
        'canonical-voqc-semantic-failures canonical-voqc-failures
        'certified-compiler-soundness-failures certified-compiler-failures
        'minimal-counterexample minimal-counterexample
        'verified? (and (> naive-voqc-failures 0)
                        (= canonical-voqc-failures 0)
                        (= certified-compiler-failures 0))))

;; -----------------------------------------------------------------------------
;; Phase-4 Fuzz Finding F14: Stim Detector Annotation on Non-Deterministic Wire
;; -----------------------------------------------------------------------------
;; Vulnerability in Naive & Phase-3 `typeof-canonical`:
;; In Stim fault-tolerant syndrome extraction circuits, `DETECTOR` (`(g-stim-detector w)`)
;; asserts that syndrome/ancilla measurement record `w` is deterministically `|0>`
;; (`BasisMode = QFree`, `RepState = CanonicalMod`, `ANFPoly(w) = ()`) in the
;; noiseless execution. Phase-3 `typeof-canonical` treated `g-stim-detector` as a
;; passive no-op annotation and only checked restoration at the END of the circuit,
;; accepting circuits where `w` is in `Superpos`, `RedundantCS`, or holds an
;; un-uncomputed degree-2 ANF polynomial `x_0 * x_1` when `g-stim-detector` fires!
;; Fix (Fix F14 / `typeof-certified-compiler`):
;; Enforce at the exact program point of `(g-stim-detector w)` that wire `w` satisfies
;; `BasisMode = QFree`, `RepState = CanonicalMod`, `Locked? = #f`, and `Delta_w(x) = 0`.
(define (fuzz-issue-f14-stim-detector-annotation-nondeterministic-superpos [trials 2500])
  (define naive-failures 0)
  (define phase3-canonical-failures 0)
  (define certified-compiler-failures 0)
  (define minimal-counterexample #f)

  (for ([trial (in-range trials)])
    (define kind
      (rand-choice '(valid-clean-uncomputed-detector
                     bug-superpos-before-detector
                     bug-unconsolidated-cs-detector
                     bug-dirty-pebble-detector)))
    (define circ
      (match kind
        ['valid-clean-uncomputed-detector
         `(c-seq (c-with-uncompute (c-gate (g-compute-and 0 1 3))
                                   (c-gate (g-cz 2 3)))
                 (c-gate (g-stim-detector 3)))]
        ['bug-superpos-before-detector
         ;; Wire 3 is in |+> when Stim DETECTOR fires, then H(3) restores QFree at exit!
         `(c-seq (c-gate (g-h 3))
                 (c-seq (c-gate (g-stim-detector 3))
                        (c-gate (g-h 3))))]
        ['bug-unconsolidated-cs-detector
         ;; Wire 3 is in RedundantCS when Stim DETECTOR fires, then consolidated at exit!
         `(c-seq (c-gate (g-skew-add-cs 3))
                 (c-seq (c-gate (g-stim-detector 3))
                        (c-seq (c-gate (g-consolidate-cs 3))
                               (c-gate (g-x 3)))))]
        ['bug-dirty-pebble-detector
         ;; Wire 3 holds x_0 * x_1 inside with-uncompute body when Stim DETECTOR fires!
         `(c-with-uncompute (c-gate (g-compute-and 0 1 3))
                            (c-gate (g-stim-detector 3)))]))

    (define init-anfs (initial-anf-env 4 '(3)))
    (define init-zones (make-list 4 'EntanglingZone))
    (define naive-ok?     (second (assoc 'well-typed? (cdr (Synthesize-Circuit-Grade circ init-anfs init-zones 'naive)))))
    (define canonical-cg  (Synthesize-Canonical-Grade circ init-anfs init-zones))
    (define canonical-ok? (canonical-restoration-law-holds? canonical-cg init-anfs '(3)))
    (define cert-cg       (Synthesize-Certified-Compiler-Grade circ init-anfs init-zones))
    (define cert-ok?      (certified-compiler-restoration-law-holds? cert-cg init-anfs '(3)))

    (define in-bits (list 1 1 0 0))
    (define init-st `(wire-state (vals ,in-bits) (anf ,init-anfs) (phase 1) (zones ,init-zones)))
    (define out-st (eval-circuit-raw circ init-st))
    (match-define `(wire-state (vals ,out-bits) (anf ,out-anfs) (phase ,out-ph) (zones ,_)) out-st)
    (define detector-sound?
      (and (= (list-ref out-bits 3) 0)
           (null? (list-ref out-anfs 3))
           (= out-ph 1)))

    (when (and naive-ok? (not detector-sound?))
      (set! naive-failures (+ naive-failures 1)))
    (when (and canonical-ok? (not detector-sound?))
      (set! phase3-canonical-failures (+ phase3-canonical-failures 1))
      (unless minimal-counterexample
        (define bloated (pad-circuit-for-shrinking circ))
        (define (f14-bug-pred? cand)
          (define cg (Synthesize-Canonical-Grade cand init-anfs init-zones))
          (define cok? (canonical-restoration-law-holds? cg init-anfs '(3)))
          (match-define `(wire-state (vals ,ob) (anf ,oa) (phase ,oph) (zones ,_))
            (eval-circuit-raw cand init-st))
          (and cok?
               (not (and (= (list-ref ob 3) 0)
                         (null? (list-ref oa 3))
                         (= oph 1)))))
        (define shrunk (shrink-circuit bloated f14-bug-pred?))
        (set! minimal-counterexample
              (hash 'unshrunk-gate-count (circuit-gate-count bloated)
                    'shrunk-gate-count (circuit-gate-count shrunk)
                    'circuit shrunk
                    'input-bits in-bits
                    'output-bits out-bits
                    'output-anf-wire3 (list-ref out-anfs 3)
                    'output-phase out-ph))))
    (when (and cert-ok? (not detector-sound?))
      (set! certified-compiler-failures (+ certified-compiler-failures 1))))

  (hash 'issue-id 'F14-Stim-Detector-Annotation-NonDeterministic-Superpos
        'trials trials
        'naive-soundness-failures naive-failures
        'phase3-canonical-soundness-failures phase3-canonical-failures
        'certified-compiler-soundness-failures certified-compiler-failures
        'minimal-counterexample minimal-counterexample
        'verified? (and (> naive-failures 0)
                        (> phase3-canonical-failures 0)
                        (= certified-compiler-failures 0))))

;; -----------------------------------------------------------------------------
;; Phase-4 Fuzz Finding F15: Liquid Haskell / Gospel Forgetful Refinement Subtyping
;; -----------------------------------------------------------------------------
;; Vulnerability in Naive Refinement Plugin (`typeof-naive-plugin`) & Phase-3:
;; When passing a quantum wire across a polymorphic module boundary, a naive
;; Liquid Haskell / Gospel refinement subtyping rule `(c-unsafe-widen-refinement w C)`
;; forgets the refinement predicate on wire `w` (widening `RedundantCS -> CanonicalMod`,
;; `Locked? = #t -> #f`, or `Superpos -> QFree`) without discharging an SMT `QF_BV`
;; proof that `Delta_w(x) == 0` and all grade invariants are at their identity!
;; Fix (Fix F15 & Simplification S10 `discharge-refinement-plugin-vc`):
;; Require an exact symbolic `F_2[x]` / SMT-LIB2 `QF_BV` proof that wire `w` is
;; already in `(QFree, CanonicalMod, #f, init_anf(w))` at every refinement widening!
(define (fuzz-issue-f15-liquidhaskell-gospel-refinement-subtyping-forgetful-cast [trials 2500])
  (define naive-plugin-failures 0)
  (define phase3-canonical-failures 0)
  (define certified-compiler-failures 0)
  (define minimal-counterexample #f)

  (for ([trial (in-range trials)])
    (define kind
      (rand-choice '(valid-smt-verified-clean-widen
                     bug-widen-drops-redundant-cs-before-z
                     bug-widen-drops-pebble-lock-overwrite
                     bug-widen-drops-superpos-before-hmr)))
    (define circ
      (match kind
        ['valid-smt-verified-clean-widen
         `(c-seq (c-with-uncompute (c-gate (g-compute-and 0 1 3))
                                   (c-seq (c-gate (g-cnot 3 2))
                                          (c-gate (g-cnot 3 2))))
                 (c-unsafe-widen-refinement 3 (c-gate (g-stim-detector 3))))]
        ['bug-widen-drops-redundant-cs-before-z
         ;; Widens RedundantCS -> CanonicalMod without consolidation, then applies Z(3)!
         `(c-seq (c-gate (g-skew-add-cs 3))
                 (c-unsafe-widen-refinement 3
                   (c-seq (c-gate (g-z 3))
                          (c-gate (g-x 3)))))]
        ['bug-widen-drops-pebble-lock-overwrite
         ;; Widens Locked? = #t -> #f inside c-with-locked-pebble, allowing CNOT(2,3) overwrite!
         `(c-with-locked-pebble 3
            (c-gate (g-compute-and 0 1 3))
            (c-unsafe-widen-refinement 3
              (c-gate (g-cnot 2 3))))]
        ['bug-widen-drops-superpos-before-hmr
         ;; Widens Superpos -> QFree on wire 0 across HMR_CZ(3, 0, 1)!
         `(c-seq (c-gate (g-compute-and 0 1 3))
                 (c-seq (c-gate (g-h 0))
                        (c-unsafe-widen-refinement 0
                          (c-gate (g-hmr-cz 3 0 1 1)))))]))

    (define init-anfs (initial-anf-env 4 '(3)))
    (define init-zones (make-list 4 'EntanglingZone))
