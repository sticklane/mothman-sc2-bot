  (define m12-floquet-mod3-aligned-verified 0)
  (define misaligned-floquet-seam-mutant-caught 0)
  (define oqp17-and-today10-verified 0)

  (define pool
    (for/vector ([idx (in-range 64)])
      ;; Misaligned raw sub-round count: 3*k + 1 or 3*k + 2
      (define misaligned-rounds (+ (* 3 (+ 1 (bitwise-and idx 7)))
                                   (+ 1 (bitwise-and idx 1))))

      ;; 1. Pass M12 pads misaligned sub-rounds to 0 (mod 3) before ZipperCut seam
      (define m12-wt (pass-m12-align-floquet-round-mod3 misaligned-rounds #t))
      (define wt-ok?
        (and (hash-ref m12-wt 'verified?)
             (s32-floquet-period3-round-alignment (hash-ref m12-wt 'aligned-subrounds))
             (= (hash-ref m12-wt 'floquet-round-mod3) 0)))

      ;; 2. Mutant F52: cuts ZipperCut seam at misaligned Floquet sub-round (r mod 3 != 0)
      (define m12-mut (pass-m12-align-floquet-round-mod3 misaligned-rounds #f))
      (define oqp17-mut (oqp17-floquet-honeycomb-dynamic-code 3 misaligned-rounds #t))
      (define mut-caught?
        (and (not (hash-ref m12-mut 'verified?))
             (hash-ref oqp17-mut 'gauge-phase-slip?)
             (not (s32-floquet-period3-round-alignment misaligned-rounds))))

      ;; 3. OQP-17 & TODAY-10 (18q Period-3 Honeycomb Floquet Code)
      (define today10 (FloquetHoneycomb_Period3_18q 6))
      (define bench-ok?
        (and (hash-ref today10 'verified?)
             (= (hash-ref today10 'logical-qubits) 18)
             (= (hash-ref today10 'floquet-round-mod3) 0)))

      (vector wt-ok? mut-caught? bench-ok?)))

  (for ([i (in-range trials)])
    (define entry (vector-ref pool (bitwise-and i 63)))
    (when (vector-ref entry 0)
      (set! m12-floquet-mod3-aligned-verified (add1 m12-floquet-mod3-aligned-verified)))
    (when (vector-ref entry 1)
      (set! misaligned-floquet-seam-mutant-caught (add1 misaligned-floquet-seam-mutant-caught)))
    (when (vector-ref entry 2)
