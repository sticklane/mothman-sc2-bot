;; -----------------------------------------------------------------------------
;; S53, QDS-29, OQP-31, TODAY-17, Pass M27 & Issue F73 (25,000 trials):
;; Cobble (PLDI '26) Block-Encoding Subnormalization Factor Inflation & Post-Selected
;; Ancilla CSE Cloning (`Pass M27`)
;; -----------------------------------------------------------------------------
(define (fuzz-find-f73-cobble-block-encoding-subnormalization-cse-inflation-pass-m27 [trials 25000])
  (define m27-cobble-fusion-verified 0)
  (define subnormalization-cse-mutant-caught 0)
  (define qds29-oqp31-and-today17-verified 0)
  (define today17 (Cobble_Qsvt_PolyFusion_BlockEncode_14q 14))
  (define today17-ok?
    (and (hash-ref today17 'verified?)
         (= (hash-ref today17 'physical-qubits) 14)))

  (for ([i (in-range trials)])
    (define h (bitwise-and (+ (* i 2654435761) 223606798) #x7fffffff))
    (define num-terms (+ 2 (bitwise-and h 15)))
    (define poly-deg (+ 2 (bitwise-and (arithmetic-shift h -4) 15)))
    (define alpha-den (+ 2 (bitwise-and (arithmetic-shift h -8) 7)))
    (define alpha-num (+ alpha-den 1 (bitwise-and (arithmetic-shift h -11) 15)))
    (define raw-gates (+ 12 (* 3 (bitwise-and (arithmetic-shift h -15) 31))))

    ;; 1. Well-typed Pass M27 fuses LCU sums + Horner QSVT polynomial, strictly reducing alpha * gates!
    (define m27-wt (pass-m27-cobble-block-encoding-fusion num-terms poly-deg alpha-num alpha-den raw-gates #t))
    (define s53-wt (s53-cobble-sum-and-poly-subnormalization-fusion-guard num-terms poly-deg alpha-num alpha-den raw-gates #t))
    (when (and (hash-ref m27-wt 'verified?)
               (hash-ref m27-wt 'alpha-gate-product-reduced?)
               (not (hash-ref m27-wt 'subnormalization-inflation-hazard?))
               (not (hash-ref m27-wt 'cloned-postselect-ancilla?))
               (hash-ref s53-wt 'verified?))
      (set! m27-cobble-fusion-verified (add1 m27-cobble-fusion-verified)))

    ;; 2. Mutant F73: naive CSE clones post-selected LCU ancillas and inflates alpha * gates!
    (define m27-mut (pass-m27-cobble-block-encoding-fusion num-terms poly-deg alpha-num alpha-den raw-gates #f))
    (when (and (hash-ref m27-mut 'subnormalization-inflation-hazard?)
               (hash-ref m27-mut 'cloned-postselect-ancilla?)
               (not (hash-ref m27-mut 'verified?))
               (not (check-f73-cobble-subnormalization-fusion-safe?
                     alpha-num alpha-den raw-gates (* 2 alpha-num) alpha-den (+ raw-gates num-terms) #t)))
      (set! subnormalization-cse-mutant-caught (add1 subnormalization-cse-mutant-caught)))

    ;; 3. QDS-29, OQP-31 & TODAY-17 (14q) verification
    (when today17-ok?
      (set! qds29-oqp31-and-today17-verified (add1 qds29-oqp31-and-today17-verified))))

  (hash 'issue-id 'F73-cobble-block-encoding-subnormalization-cse-inflation-pass-m27
        'suite-id 'S53-PassM27-QDS29-OQP31-TODAY17-Cobble-Block-Encoding-Fusion
        'trials trials
        'm27-cobble-fusion-verified m27-cobble-fusion-verified
        'subnormalization-cse-mutant-caught subnormalization-cse-mutant-caught
        'qds29-oqp31-and-today17-verified qds29-oqp31-and-today17-verified
        'today17-physical-qubits 14
        'verified? (and (= m27-cobble-fusion-verified trials)
                        (= subnormalization-cse-mutant-caught trials)
                        (= qds29-oqp31-and-today17-verified trials))))

;; -----------------------------------------------------------------------------
;; S54, OQP-32, Pass M28 & Issue F74 (25,000 trials):
;; Spire (PLDI '24) Post-Lowering Control-Flow $T$-Complexity Blowup (`Pass M28`)
;; -----------------------------------------------------------------------------
(define (fuzz-find-f74-spire-post-lowering-control-flow-t-complexity-blowup-pass-m28 [trials 25000])
  (define m28-spire-t-hoister-verified 0)
  (define post-lowering-t-blowup-mutant-caught 0)
  (define oqp32-and-s54-verified 0)

  (for ([i (in-range trials)])
    (define h (bitwise-and (+ (* i 2654435761) 244948974) #x7fffffff))
    (define num-branches (+ 2 (bitwise-and h 31)))
    (define shared-t (+ 2 (bitwise-and (arithmetic-shift h -5) 63)))

    ;; 1. Pass M28 hoists shared T-gates across branches at the source level before lowering!
    (define m28-wt (pass-m28-spire-source-control-flow-t-hoister num-branches shared-t #t))
    (define s54-wt (s54-spire-source-control-flow-t-hoisting-guard num-branches shared-t #t))
    (when (and (hash-ref m28-wt 'verified?)
               (not (hash-ref m28-wt 't-complexity-blowup?))
               (< (hash-ref m28-wt 'effective-t-count) (hash-ref m28-wt 'post-lowering-t-count))
               (hash-ref s54-wt 'verified?))
      (set! m28-spire-t-hoister-verified (add1 m28-spire-t-hoister-verified)))

    ;; 2. Mutant F74: lowering control flow before T-hoisting causes a 2*k*T blowup!
    (define m28-mut (pass-m28-spire-source-control-flow-t-hoister num-branches shared-t #f))
    (when (and (hash-ref m28-mut 't-complexity-blowup?)
               (not (hash-ref m28-mut 'verified?)))
      (set! post-lowering-t-blowup-mutant-caught (add1 post-lowering-t-blowup-mutant-caught)))

    ;; 3. OQP-32 verification
    (define oqp32 (oqp32-spire-source-level-control-flow-t-hoisting num-branches shared-t #t))
    (when (hash-ref oqp32 'verified?)
      (set! oqp32-and-s54-verified (add1 oqp32-and-s54-verified))))

  (hash 'issue-id 'F74-spire-post-lowering-control-flow-t-complexity-blowup-pass-m28
        'suite-id 'S54-PassM28-OQP32-Spire-Source-Control-Flow-T-Hoisting
        'trials trials
        'm28-spire-t-hoister-verified m28-spire-t-hoister-verified
        'post-lowering-t-blowup-mutant-caught post-lowering-t-blowup-mutant-caught
        'oqp32-and-s54-verified oqp32-and-s54-verified
        'verified? (and (= m28-spire-t-hoister-verified trials)
