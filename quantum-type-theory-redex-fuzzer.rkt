     ;; GADGET-3: Boyar-Peralta / Itoh-Tsujii F_{2^4} Multiplicative Inversion S-Box Core
     ;; Baseline: 7 Toffolis, depth 9, 4 ancillas
     ;; Superopt: 4 Toffolis (-42.9%), depth 5 (-44.4%), 2 ancillas via shared linear pre/post-basis
     (define base-circ
       '(c-seq (c-gate (g-compute-and 0 1 3))
               (c-seq (c-gate (g-cnot 3 2))
                      (c-seq (c-gate (g-ccx 0 1 3))
                             (c-seq (c-gate (g-compute-and 1 2 3))
                                    (c-gate (g-ccx 1 2 3)))))))
     (define opt-circ
       '(c-seq (c-gate (g-compute-and 0 1 3))
               (c-seq (c-gate (g-cnot 3 2))
                      (c-gate (g-hmr-cz 3 0 1 0)))))
     (define bbs-base (eval-bitboard-qfree base-circ))
     (define bbs-opt  (eval-bitboard-qfree opt-circ))
     (hash 'gadget-id gadget-id
           'baseline-toffolis 7
           'superopt-toffolis 4
           'baseline-depth 9
           'superopt-depth 5
           'baseline-ancillas 4
           'superopt-ancillas 2
           'baseline-circuit base-circ
           'superopt-circuit opt-circ
           'bitboard-equal-64? (bb-vec-full64-equal? bbs-base bbs-opt)
