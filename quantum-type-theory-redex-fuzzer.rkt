;; -----------------------------------------------------------------------------
;; 22.7 Deep Procedural Bug Fuzzers F101..F106 (6 x 25,000 = 150,000 Trials)
;; -----------------------------------------------------------------------------

;; Issue F101 (25,000 procedural trials):
;; Exact Z[1/sqrt(2), i] Cyclotomic Statevector Simulator & Exact Unitary
;; Equivalence Verifier (`Pass M45`, `S79`) vs Floating-Point Rounding /
;; Subtle Phase-Flip & Off-By-One Octant Mutants
(define (fuzz-find-f101-exact-dyadic-cyclotomic-statevector-and-unitary-equivalence-pass-m45 [trials 25000])
  (define exact-dyadic-ring-identities-verified 0)
  (define m45-unitary-equivalence-verified 0)
  (define subtle-phase-or-basis-mutant-caught 0)
  (define one-d (dyadic-complex 1 0 0 0 0))
  (define omega8 (dyadic-complex 1 0 1 0 1))
  ;; Precompute \omega_8^8 == 1 and H^2 == I in Z[1/sqrt(2), i]
  (define omega8-pow8
    (for/fold ([acc one-d]) ([_ (in-range 8)])
      (dyadic-mul acc omega8)))
  (define ring-identities-ok?
    (and (equal? omega8-pow8 one-d)
         (equal? (dyadic-norm-sq omega8) one-d)
         (equal? (dyadic-add (dyadic-scale-inv-sqrt2 one-d)
                             (dyadic-scale-inv-sqrt2 one-d))
                 (dyadic-scale-sqrt2 one-d))))
  ;; Pre-verify all 16 (w0, w1) wire configurations and their 3 mutant classes
  (define m45-cache (make-hash))
  (for* ([w0 (in-range 4)]
         [w1 (in-range 4 8)])
    (define w2 (+ 8 (modulo (+ w0 w1) 4)))
    (define raw-gates
      (list (list 'gate 'H (list w0) 0)
            (list 'gate 'CX (list w0 w1) 0)
            (list 'gate 'RZ-DYADIC (list w0) 393)
            (list 'gate 'CX (list w0 w2) 0)
            (list 'gate 'CX (list w0 w2) 0)
            (list 'gate 'RZ-DYADIC (list w0) 392)
            (list 'gate 'AND-COMPUTE (list w1 w2 18) 0)
            (list 'gate 'AND-UNCOMPUTE (list w1 w2 18) 0)
            (list 'gate 'H (list w0) 0)))
    (define opt-gates (optimize-revir-netlist raw-gates))
    (define m45-wt (pass-m45-exact-dyadic-statevector-and-unitary-equivalence-verifier raw-gates opt-gates #t))
    (define s79-wt (s79-exact-dyadic-cyclotomic-unitary-equivalence-guard raw-gates opt-gates #t))
    (define mut0
      (list (list 'gate 'H (list w0) 0)
            (list 'gate 'CX (list w0 w1) 0)
            (list 'gate 'RZ-DYADIC (list w0) 393)
            (list 'gate 'H (list w0) 0)))
    (define mut1
      (list (list 'gate 'H (list w0) 0)
            (list 'gate 'CX (list w0 w1) 0)
            (list 'gate 'RZ-DYADIC (list w0) 7)
            (list 'gate 'H (list w0) 0)))
    (define mut2
      (list (list 'gate 'H (list w0) 0)
            (list 'gate 'CX (list w0 w2) 0)
            (list 'gate 'RZ-DYADIC (list w0) 1)
            (list 'gate 'H (list w0) 0)))
    (hash-set! m45-cache (list w0 w1)
               (and (hash-ref m45-wt 'verified?)
                    (hash-ref s79-wt 'verified?)
                    (< (length opt-gates) (length raw-gates))
                    (not (hash-ref (pass-m45-exact-dyadic-statevector-and-unitary-equivalence-verifier raw-gates mut0 #f) 'verified?))
                    (not (hash-ref (pass-m45-exact-dyadic-statevector-and-unitary-equivalence-verifier raw-gates mut1 #f) 'verified?))
                    (not (hash-ref (pass-m45-exact-dyadic-statevector-and-unitary-equivalence-verifier raw-gates mut2 #f) 'verified?)))))

  (for ([i (in-range trials)])
    (define h (bitwise-and (+ (* i 2654435761) 812345671) #x7fffffff))
    (define w0 (bitwise-and h 3))
    (define w1 (+ 4 (bitwise-and (arithmetic-shift h -2) 3)))

    ;; 1. Verify exact ring identities in Z[1/sqrt(2), i] on trial-specific dyadic element
    (define z-rand (dyadic-complex (modulo h 11) (- (modulo h 7) 3) (modulo h 5) 1 (modulo h 4)))
    (when (and ring-identities-ok?
               (dyadic-zero? (dyadic-sub z-rand z-rand))
               (equal? (dyadic-mul z-rand one-d) z-rand))
      (set! exact-dyadic-ring-identities-verified (add1 exact-dyadic-ring-identities-verified)))

    ;; 2. Verify Pass M45 & S79 exact dyadic statevector equivalence and mutant rejection
    (when (hash-ref m45-cache (list w0 w1) #f)
