(define (hardware-gate-duration-ns g [machine 'SuperconductingPlanar])
  (define fam (target-arch->machine-family machine))
  (define op (gate-op-symbol g))
  (match op
    [(or 'MCM 'MX-Gidney 'SYNDROME-DETECT)
     (match fam
       ['TrappedIonQCCD 150000]
       ['NeutralAtomZonedAOD 500000]
       [_ 1240])]
    [(or 'EPR-SHARE 'TELE-CX 'BELL-MEAS-FIXUP 'TELEGATE-HERALD)
     1500]
    [(or 'CZ 'CX 'SWAP 'RZZ 'ZZPhase 'RYDBERG-CZ 'AOD-SHUTTLE 'AND-COMPUTE 'AND-UNCOMPUTE)
     (match fam
       ['TrappedIonQCCD 2000]
       ['NeutralAtomZonedAOD 400]
       [_ 40])]
    [_
     (match fam
       ['TrappedIonQCCD 200]
       ['NeutralAtomZonedAOD 100]
       [_ 20])]))

(define (serial-gate-sum-ns gates [machine 'SuperconductingPlanar])
  (if (not (list? gates))
      0
