;; =============================================================================
;; 6. Adversarial Redex Property Fuzzer: Phase-1 (F1..F4) & Phase-2 (F5..F8)
;;    Discovers counterexamples in the Naive and Phase-1 typing rules, shrinks
;;    large bloated circuits (depth 6-10) via `shrink-circuit` down to minimal
;;    2-3 gate witnesses, and verifies 0 failures across 2,500 trials per issue
;;    on the Phase-2 / Unified typing rules!
;; =============================================================================

;; Deterministic PRNG for reproducible fuzzing
(define fuzz-rng (make-pseudo-random-generator))
(parameterize ([current-pseudo-random-generator fuzz-rng])
  (random-seed 20261024))

(define (rand-int lo hi)
  (+ lo (random (- (+ hi 1) lo) fuzz-rng)))

(define (rand-choice lst)
  (list-ref lst (random (length lst) fuzz-rng)))

(define (random-bit-vec n)
  (for/list ([_ (in-range n)]) (rand-int 0 1)))

;; Pad a core circuit with benign identity/phase/self-cancelling prefix & suffix gates
;; so its unshrunk gate count is 6-10 gates, testing `shrink-circuit`!
(define (pad-circuit-for-shrinking core-circ)
  (define prefix
    `(c-seq (c-gate (g-id))
            (c-seq (c-gate (g-z 2))
                   (c-gate (g-z 2)))))
  (define suffix
    `(c-seq (c-gate (g-twirl-step 2 TwirlEven))
            (c-seq (c-gate (g-zone-shuttle 2 EntanglingZone))
                   (c-gate (g-id)))))
  `(c-seq ,prefix (c-seq ,core-circ ,suffix)))

;; -----------------------------------------------------------------------------
;; Fuzz Finding F1: Dirty-Target AND-Elbow / CCX Degree & Monomial Contamination
;; -----------------------------------------------------------------------------
(define (fuzz-issue-f1-hmr-cz-monomial-contamination [trials 2500])
  (define naive-failures 0)
  (define refined-failures 0)
  (define minimal-counterexample #f)

  (for ([trial (in-range trials)])
    (define c1 0)
    (define c2 1)
    (define extra 2)
    (define t 3)
    (define contaminate-kind (rand-choice '(clean cnot-contaminate x-contaminate wrong-controls)))
    (define m-outcome (rand-int 0 1))
    (define circ
      (match contaminate-kind
        ['clean
         `(c-seq (c-gate (g-compute-and ,c1 ,c2 ,t))
                 (c-gate (g-hmr-cz ,t ,c1 ,c2 ,m-outcome)))]
        ['cnot-contaminate
         `(c-seq (c-seq (c-gate (g-compute-and ,c1 ,c2 ,t))
                        (c-seq (c-gate (g-cnot ,extra ,t))
                               (c-gate (g-cnot ,extra ,t))))
                 (c-gate (g-hmr-cz ,t ,c1 ,c2 ,m-outcome)))]
        ['x-contaminate
         `(c-seq (c-gate (g-compute-and ,c1 ,c2 ,t))
                 (c-seq (c-gate (g-x ,c1))
                        (c-seq (c-gate (g-hmr-cz ,t ,c1 ,c2 ,m-outcome))
                               (c-gate (g-x ,c1)))))]
        ['wrong-controls
         `(c-seq (c-gate (g-compute-and ,c1 ,extra ,t))
                 (c-gate (g-hmr-cz ,t ,c1 ,c2 ,m-outcome)))]))

    (define init-anfs (initial-anf-env 4 '(3)))
    (define init-zones (make-list 4 'EntanglingZone))
    (define naive-grade (Synthesize-Circuit-Grade circ init-anfs init-zones 'naive))
    (define refined-grade (Synthesize-Circuit-Grade circ init-anfs init-zones 'refined))
    (define naive-ok? (second (assoc 'well-typed? (cdr naive-grade))))
    (define refined-ok? (second (assoc 'well-typed? (cdr refined-grade))))

    (define in-bits (list (rand-int 0 1) (rand-int 0 1) (rand-int 0 1) 0))
    (define init-st `(wire-state (vals ,in-bits) (anf ,init-anfs) (phase 1) (zones ,init-zones)))
    (define out-st (eval-circuit-raw circ init-st))
    (match-define `(wire-state (vals ,out-bits) (anf ,_) (phase ,out-ph) (zones ,_)) out-st)
    (define semantically-sound?
      (and (equal? out-bits in-bits)
           (= out-ph 1)))

    (when (and naive-ok? (not semantically-sound?))
      (set! naive-failures (+ naive-failures 1))
      (unless minimal-counterexample
        (define bloated (pad-circuit-for-shrinking circ))
        (define (f1-bug-pred? cand)
          (define ng (Synthesize-Circuit-Grade cand init-anfs init-zones 'naive))
          (define nok? (second (assoc 'well-typed? (cdr ng))))
          (define np3 (list-ref (second (assoc 'z2-parity (cdr ng))) 3))
          (match-define `(wire-state (vals ,ob) (anf ,_) (phase ,oph) (zones ,_))
            (eval-circuit-raw cand init-st))
          (and nok? (= np3 0) (equal? ob in-bits) (= oph -1)))
        (define shrunk (shrink-circuit bloated f1-bug-pred?))
        (set! minimal-counterexample
              (hash 'unshrunk-gate-count (circuit-gate-count bloated)
                    'shrunk-gate-count (circuit-gate-count shrunk)
                    'circuit shrunk
                    'input-bits in-bits
                    'meas-outcome m-outcome
                    'output-bits out-bits
                    'output-phase out-ph))))

    (when (and refined-ok? (not semantically-sound?))
      (set! refined-failures (+ refined-failures 1))))

  (hash 'issue-id 'F1-HMR-CZ-Monomial-Contamination
        'trials trials
        'naive-type-system-soundness-failures naive-failures
        'refined-type-system-soundness-failures refined-failures
        'minimal-counterexample minimal-counterexample
        'verified? (and (> naive-failures 0) (= refined-failures 0))))

;; -----------------------------------------------------------------------------
;; Fuzz Finding F2: withUncompute(U, V, U^dag) Read/Write Aliasing Interference
;; -----------------------------------------------------------------------------
(define (fuzz-issue-f2-with-uncompute-const-aliasing [trials 2500])
  (define naive-failures 0)
  (define refined-failures 0)
  (define minimal-counterexample #f)

  (for ([trial (in-range trials)])
    (define u `(c-gate (g-compute-and 0 1 3)))
    (define v-kind (rand-choice '(valid-read-only-v valid-target-2 mutate-ctrl-0 mutate-ctrl-1)))
    (define v
      (match v-kind
        ['valid-read-only-v `(c-gate (g-cz 2 3))]
        ['valid-target-2    `(c-gate (g-cnot 3 2))]
        ['mutate-ctrl-0     `(c-gate (g-cnot 2 0))]
        ['mutate-ctrl-1     `(c-gate (g-x 1))]))
    (define circ `(c-with-uncompute ,u ,v))

    (define init-anfs (initial-anf-env 4 '(3)))
    (define init-zones (make-list 4 'EntanglingZone))
    (define naive-grade (Synthesize-Circuit-Grade circ init-anfs init-zones 'naive))
    (define refined-grade (Synthesize-Circuit-Grade circ init-anfs init-zones 'refined))
    (define naive-ok? (second (assoc 'well-typed? (cdr naive-grade))))
    (define refined-ok? (second (assoc 'well-typed? (cdr refined-grade))))

    (define in-bits (list (rand-int 0 1) (rand-int 0 1) (rand-int 0 1) 0))
    (define init-st `(wire-state (vals ,in-bits) (anf ,init-anfs) (phase 1) (zones ,init-zones)))
    (define out-st (eval-circuit-raw circ init-st))
    (match-define `(wire-state (vals ,out-bits) (anf ,out-anfs) (phase ,_) (zones ,_)) out-st)
    (define pebble-restored?
      (and (= (list-ref out-bits 3) 0)
           (null? (list-ref out-anfs 3))))

    (when (and naive-ok? (not pebble-restored?))
      (set! naive-failures (+ naive-failures 1))
      (unless minimal-counterexample
        (define bloated `(c-with-uncompute ,(pad-circuit-for-shrinking u) ,(pad-circuit-for-shrinking v)))
        (define (f2-bug-pred? cand)
          (and (match cand [`(c-with-uncompute ,_ ,_) #t] [_ #f])
               (let* ([ng (Synthesize-Circuit-Grade cand init-anfs init-zones 'naive)]
                      [nok? (second (assoc 'well-typed? (cdr ng)))])
                 (match-define `(wire-state (vals ,ob) (anf ,oa) (phase ,_) (zones ,_))
                   (eval-circuit-raw cand init-st))
                 (and nok? (not (and (= (list-ref ob 3) 0) (null? (list-ref oa 3))))))))
        (define shrunk (shrink-circuit bloated f2-bug-pred?))
        (set! minimal-counterexample
              (hash 'unshrunk-gate-count (circuit-gate-count bloated)
                    'shrunk-gate-count (circuit-gate-count shrunk)
                    'circuit shrunk
                    'input-bits in-bits
                    'output-bits out-bits
                    'residual-pebble-bit (list-ref out-bits 3)
                    'residual-pebble-anf (list-ref out-anfs 3)))))

    (when (and refined-ok? (not pebble-restored?))
      (set! refined-failures (+ refined-failures 1))))

  (hash 'issue-id 'F2-WithUncompute-Const-Control-Aliasing
        'trials trials
        'naive-type-system-soundness-failures naive-failures
        'refined-type-system-soundness-failures refined-failures
        'minimal-counterexample minimal-counterexample
        'verified? (and (> naive-failures 0) (= refined-failures 0))))

;; -----------------------------------------------------------------------------
;; Fuzz Finding F3: Symbiotic Z_2 Toggle-Parity Control-Drift Bug
;; -----------------------------------------------------------------------------
(define (fuzz-issue-f3-symbiotic-z2-control-drift [trials 2500])
  (define naive-z2-failures 0)
  (define refined-f2-poly-failures 0)
  (define minimal-counterexample #f)

  (for ([trial (in-range trials)])
    (define drift-kind (rand-choice '(no-drift middle-cnot-on-ctrl middle-x-on-ctrl mismatched-second-ccx)))
    (define circ
      (match drift-kind
        ['no-drift
         `(c-seq (c-gate (g-ccx 0 1 3))
                 (c-seq (c-gate (g-cnot 3 2))
                        (c-seq (c-gate (g-cnot 3 2))
                               (c-gate (g-ccx 0 1 3)))))]
        ['middle-cnot-on-ctrl
         `(c-seq (c-gate (g-ccx 0 1 3))
                 (c-seq (c-gate (g-cnot 2 0))
                        (c-gate (g-ccx 0 1 3))))]
        ['middle-x-on-ctrl
         `(c-seq (c-gate (g-ccx 0 1 3))
                 (c-seq (c-gate (g-x 1))
                        (c-gate (g-ccx 0 1 3))))]
        ['mismatched-second-ccx
         `(c-seq (c-gate (g-ccx 0 1 3))
                 (c-gate (g-ccx 0 2 3)))]))

    (define init-anfs (initial-anf-env 4 '()))
    (define init-zones (make-list 4 'EntanglingZone))
    (define grade (Synthesize-Circuit-Grade circ init-anfs init-zones 'refined))
    (define z2-parity-vec (second (assoc 'z2-parity (cdr grade))))
    (define f2-delta-vec  (second (assoc 'f2-delta (cdr grade))))

    (define naive-z2-says-restored? (= (list-ref z2-parity-vec 3) 0))
    (define refined-f2-says-restored? (null? (list-ref f2-delta-vec 3)))

    (define in-bits (random-bit-vec 4))
    (define init-st `(wire-state (vals ,in-bits) (anf ,init-anfs) (phase 1) (zones ,init-zones)))
    (define out-st (eval-circuit-raw circ init-st))
    (match-define `(wire-state (vals ,out-bits) (anf ,_) (phase ,_) (zones ,_)) out-st)
    (define dirty-wire3-actually-restored? (= (list-ref out-bits 3) (list-ref in-bits 3)))

    (when (and naive-z2-says-restored? (not dirty-wire3-actually-restored?))
      (set! naive-z2-failures (+ naive-z2-failures 1))
      (unless minimal-counterexample
        (define bloated (pad-circuit-for-shrinking circ))
        (define (f3-bug-pred? cand)
          (define g (Synthesize-Circuit-Grade cand init-anfs init-zones 'refined))
          (define z2v (second (assoc 'z2-parity (cdr g))))
          (match-define `(wire-state (vals ,ob) (anf ,_) (phase ,_) (zones ,_))
            (eval-circuit-raw cand init-st))
          (and (= (list-ref z2v 3) 0)
               (not (= (list-ref ob 3) (list-ref in-bits 3)))))
        (define shrunk (shrink-circuit bloated f3-bug-pred?))
        (set! minimal-counterexample
              (hash 'unshrunk-gate-count (circuit-gate-count bloated)
                    'shrunk-gate-count (circuit-gate-count shrunk)
                    'circuit shrunk
                    'input-bits in-bits
                    'output-bits out-bits
                    'naive-z2-parity-wire3 (list-ref z2-parity-vec 3)
                    'refined-f2-delta-wire3 (list-ref f2-delta-vec 3)))))

    (when (and refined-f2-says-restored? (not dirty-wire3-actually-restored?))
      (set! refined-f2-poly-failures (+ refined-f2-poly-failures 1))))

  (hash 'issue-id 'F3-Symbiotic-Z2-Control-Drift
        'trials trials
        'naive-z2-parity-failures naive-z2-failures
        'refined-f2-polynomial-delta-failures refined-f2-poly-failures
        'minimal-counterexample minimal-counterexample
        'verified? (and (> naive-z2-failures 0) (= refined-f2-poly-failures 0))))

;; -----------------------------------------------------------------------------
;; Fuzz Finding F4: Parallel Diagonal Tensor Non-Commuting Basis Mixing
;; -----------------------------------------------------------------------------
(define (fuzz-issue-f4-pardiag-basis-mixing [trials 2500])
  (define naive-commutativity-failures 0)
  (define refined-commutativity-failures 0)
  (define minimal-counterexample #f)

  (for ([trial (in-range trials)])
    (define pair-kind (rand-choice '(shared-readonly-ctrl12 shared-readonly-cz write-read-hazard-cnot write-read-hazard-ccx)))
    (define-values (c1 c2)
      (match pair-kind
        ['shared-readonly-ctrl12
         (values `(c-gate (g-cnot 0 1)) `(c-gate (g-cnot 0 2)))]
        ['shared-readonly-cz
         (values `(c-gate (g-cz 0 1)) `(c-gate (g-cz 0 2)))]
        ['write-read-hazard-cnot
         (values `(c-gate (g-cnot 1 0)) `(c-gate (g-cnot 0 2)))]
        ['write-read-hazard-ccx
         (values `(c-gate (g-x 0)) `(c-gate (g-ccx 0 1 3)))]))

    (define par-c12 `(c-par-diag ,c1 ,c2))
    (define par-c21 `(c-par-diag ,c2 ,c1))
    (define init-anfs (initial-anf-env 4 '()))
    (define init-zones (make-list 4 'EntanglingZone))

    (define naive-grade (Synthesize-Circuit-Grade par-c12 init-anfs init-zones 'naive))
    (define refined-grade (Synthesize-Circuit-Grade par-c12 init-anfs init-zones 'refined))
    (define naive-ok? (second (assoc 'well-typed? (cdr naive-grade))))
    (define refined-ok? (second (assoc 'well-typed? (cdr refined-grade))))

    (define in-bits (random-bit-vec 4))
    (define init-st `(wire-state (vals ,in-bits) (anf ,init-anfs) (phase 1) (zones ,init-zones)))
    (define out-12 (eval-circuit-raw par-c12 init-st))
    (define out-21 (eval-circuit-raw par-c21 init-st))
    (define order-independent? (equal? out-12 out-21))

    (when (and naive-ok? (not order-independent?))
      (set! naive-commutativity-failures (+ naive-commutativity-failures 1))
      (unless minimal-counterexample
        (define bloated `(c-par-diag ,(pad-circuit-for-shrinking c1) ,(pad-circuit-for-shrinking c2)))
        (define (f4-bug-pred? cand)
          (match cand
            [`(c-par-diag , lhs ,rhs)
             (define ng (Synthesize-Circuit-Grade cand init-anfs init-zones 'naive))
             (define nok? (second (assoc 'well-typed? (cdr ng))))
             (define o12 (eval-circuit-raw `(c-par-diag ,lhs ,rhs) init-st))
             (define o21 (eval-circuit-raw `(c-par-diag ,rhs ,lhs) init-st))
             (and nok? (not (equal? o12 o21)))]
            [_ #f]))
        (define shrunk (shrink-circuit bloated f4-bug-pred?))
        (set! minimal-counterexample
              (hash 'unshrunk-gate-count (circuit-gate-count bloated)
                    'shrunk-gate-count (circuit-gate-count shrunk)
                    'shrunk-circuit shrunk
                    'c1 c1
                    'c2 c2
                    'input-bits in-bits
                    'eval-c1-then-c2 out-12
                    'eval-c2-then-c1 out-21))))

    (when (and refined-ok? (not order-independent?))
      (set! refined-commutativity-failures (+ refined-commutativity-failures 1))))

  (hash 'issue-id 'F4-ParDiag-NonCommuting-Basis-Mixing
        'trials trials
        'naive-pardiag-commutativity-failures naive-commutativity-failures
        'refined-pardiag-commutativity-failures refined-commutativity-failures
        'minimal-counterexample minimal-counterexample
        'verified? (and (> naive-commutativity-failures 0)
                        (= refined-commutativity-failures 0))))

;; -----------------------------------------------------------------------------
;; Phase-2 Fuzz Finding F5: HMR-CZ Superposition Control/Target & Non-Unitary Adjoint
;; -----------------------------------------------------------------------------
;; Vulnerability in Phase-1 rules:
;; In Phase-1 `Synthesize-Circuit-Grade`, `(g-h w)` left `anfs[w]` unchanged.
;; Consequently:
;;   (a) Applying `(g-h 0)` (or `(g-h 3)`) after `(g-compute-and 0 1 3)` and before
;;       `(g-hmr-cz 3 0 1 m)` still satisfied `anfs[3] == anfs[0] * anfs[1]` in Phase-1,
;;       even though wire 0 (or 3) is in X-basis superposition!
;;   (b) Placing `g-h` or `g-hmr-cz` inside `U` of `(c-with-uncompute U V)` allowed
;;       `circuit-dag` to pretend that superposition / measurement-based uncomputation
;;       is a clean QFree pebble computation!
;; Fix (Fix F5 / Unified S1-S2):
;; Track per-wire `BasisMode ∈ {QFree, Superpos}` and `unitary-qfree?`:
;; `g-hmr-cz(t, c1, c2)` requires `BasisMode(t) = BasisMode(c1) = BasisMode(c2) = QFree`,
;; and `c-with-uncompute U V` requires `U` to be strictly `unitary-qfree?`.
(define (fuzz-issue-f5-hmr-cz-superposition-and-nonunitary-adjoint [trials 2500])
  (define naive-failures 0)
  (define phase1-failures 0)
  (define unified-failures 0)
  (define minimal-counterexample #f)

  (for ([trial (in-range trials)])
    (define kind
      (rand-choice '(valid-qfree-hmr
                     superpos-ctrl-before-hmr
                     superpos-target-before-hmr
                     non-qfree-u-in-with-uncompute)))
    (define m-outcome (rand-int 0 1))
    (define circ
      (match kind
        ['valid-qfree-hmr
         `(c-seq (c-gate (g-compute-and 0 1 3))
                 (c-gate (g-hmr-cz 3 0 1 ,m-outcome)))]
        ['superpos-ctrl-before-hmr
         ;; Hadamard on control 0 before HMR_CZ, then Hadamard 0 back:
         ;; Phase-1 sees anfs[3] == ((0 1)) == anfs[0]*anfs[1] and ACCEPTS!
         `(c-seq (c-gate (g-compute-and 0 1 3))
                 (c-seq (c-gate (g-h 0))
                        (c-seq (c-gate (g-hmr-cz 3 0 1 1))
                               (c-gate (g-h 0)))))]
        ['superpos-target-before-hmr
         ;; Hadamard on target 3 before HMR_CZ: Phase-1 sees anfs[3] unchanged and ACCEPTS!
         `(c-seq (c-gate (g-compute-and 0 1 3))
                 (c-seq (c-gate (g-h 3))
                        (c-gate (g-hmr-cz 3 0 1 1))))]
        ['non-qfree-u-in-with-uncompute
         ;; U places wire 3 in superposition before compute-and; Phase-1 thinks U^dag restores wire 3!
         `(c-with-uncompute
           (c-seq (c-gate (g-h 3)) (c-gate (g-compute-and 0 1 3)))
           (c-gate (g-z 3)))]))

    (define init-anfs (initial-anf-env 4 '(3)))
    (define init-zones (make-list 4 'EntanglingZone))
    (define naive-ok?   (second (assoc 'well-typed? (cdr (Synthesize-Circuit-Grade circ init-anfs init-zones 'naive)))))
    (define phase1-ok?  (second (assoc 'well-typed? (cdr (Synthesize-Circuit-Grade circ init-anfs init-zones 'phase1)))))
    (define unified-ug  (Synthesize-Unified-Grade circ init-anfs init-zones))
    (define unified-ok? (unified-restoration-law-holds? unified-ug init-anfs '(3)))

    (define in-bits (list (rand-int 0 1) (rand-int 0 1) (rand-int 0 1) 0))
    (define init-st `(wire-state (vals ,in-bits) (anf ,init-anfs) (phase 1) (zones ,init-zones)))
    (define out-st (eval-circuit-raw circ init-st))
    (match-define `(wire-state (vals ,out-bits) (anf ,out-anfs) (phase ,out-ph) (zones ,_)) out-st)
    (define semantically-sound?
      (and (equal? out-bits in-bits)
           (null? (list-ref out-anfs 3))
           (= out-ph 1)))

    (when (and naive-ok? (not semantically-sound?))
      (set! naive-failures (+ naive-failures 1)))
    (when (and phase1-ok? (not semantically-sound?))
      (set! phase1-failures (+ phase1-failures 1))
      (unless minimal-counterexample
        (define bloated (pad-circuit-for-shrinking circ))
        (define (f5-bug-pred? cand)
          (define p1g (Synthesize-Circuit-Grade cand init-anfs init-zones 'phase1))
          (define p1ok? (second (assoc 'well-typed? (cdr p1g))))
          (define p1d3 (list-ref (second (assoc 'f2-delta (cdr p1g))) 3))
          (match-define `(wire-state (vals ,ob) (anf ,oa) (phase ,oph) (zones ,_))
            (eval-circuit-raw cand init-st))
          (and p1ok? (null? p1d3) (not (and (equal? ob in-bits) (null? (list-ref oa 3)) (= oph 1)))))
        (define shrunk (shrink-circuit bloated f5-bug-pred?))
        (set! minimal-counterexample
              (hash 'unshrunk-gate-count (circuit-gate-count bloated)
                    'shrunk-gate-count (circuit-gate-count shrunk)
                    'circuit shrunk
                    'input-bits in-bits
                    'output-bits out-bits
                    'output-pebble-anf (list-ref out-anfs 3)
                    'output-phase out-ph))))
    (when (and unified-ok? (not semantically-sound?))
      (set! unified-failures (+ unified-failures 1))))

  (hash 'issue-id 'F5-HMR-CZ-Superposition-and-NonUnitary-Adjoint
        'trials trials
        'naive-soundness-failures naive-failures
        'phase1-refined-soundness-failures phase1-failures
        'unified-type-system-soundness-failures unified-failures
        'minimal-counterexample minimal-counterexample
        'verified? (and (> naive-failures 0)
                        (> phase1-failures 0)
                        (= unified-failures 0))))

;; -----------------------------------------------------------------------------
;; Phase-2 Fuzz Finding F6: withUncompute Conjugate Phase Kickback (H ; Z ; H = X)
;; -----------------------------------------------------------------------------
;; Vulnerability in Phase-1 rules:
;; Phase-1 `Fix F2` checked `XWriteSet(V) ∩ AllWires(U) = ∅` where `Z` and `CZ`
;; had empty write sets. When `U` puts wire `w` in superposition (`g-h w`) and `V`
;; applies `g-z w` or `g-cz w q` (or `g-cnot w t` where `t` is in `|->`), conjugate
;; phase kickback flips `|+> -> |->` on `w`, causing `U^dag = H(w)` to map `|-> -> |1>`
;; instead of restoring `|0>`! Conversely, when `U` is strictly `QFree` and `V` applies
;; diagonal `Z`/`CZ` on `WriteSet(U)`, `U^dag` DOES restore `WriteSet(U)` to `|0>`!
(define (fuzz-issue-f6-with-uncompute-conjugate-phase-kickback [trials 2500])
  (define naive-failures 0)
  (define phase1-failures 0)
  (define unified-failures 0)
  (define valid-qfree-phase-kickbacks-accepted 0)
  (define minimal-counterexample #f)

  (for ([trial (in-range trials)])
    (define kind
      (rand-choice '(valid-qfree-cz-kickback
                     valid-qfree-z-kickback
                     bug-h-pebble-z-kickback
                     bug-h-ctrl-z-kickback
                     bug-v-hzh-on-pebble)))
    (define circ
      (match kind
        ['valid-qfree-cz-kickback
         `(c-with-uncompute (c-gate (g-compute-and 0 1 3))
                            (c-gate (g-cz 2 3)))]
        ['valid-qfree-z-kickback
         `(c-with-uncompute (c-gate (g-compute-and 0 1 3))
                            (c-gate (g-z 3)))]
        ['bug-h-pebble-z-kickback
         ;; U = H(3), V = Z(3), U^dag = H(3) => H Z H |0> = |1> (pebble 3 NOT restored!)
         ;; Yet Phase-1 sees XWriteSet(V) = ∅ and ACCEPTS!
         `(c-with-uncompute (c-gate (g-h 3))
                            (c-gate (g-z 3)))]
        ['bug-h-ctrl-z-kickback
         ;; U puts ctrl 0 in |+> and computes AND(0,1,3); V applies Z(0); U^dag fails to uncompute!
         `(c-with-uncompute (c-seq (c-gate (g-h 0)) (c-gate (g-compute-and 0 1 3)))
                            (c-gate (g-z 0)))]
        ['bug-v-hzh-on-pebble
         ;; U computes pebble 3; V applies H(3);Z(3);H(3) = X(3) with XWriteSet(V) = ∅!
         `(c-with-uncompute (c-gate (g-compute-and 0 1 3))
                            (c-seq (c-gate (g-h 3))
                                   (c-seq (c-gate (g-z 3))
                                          (c-gate (g-h 3)))))]))

    (define init-anfs (initial-anf-env 4 '(3)))
    (define init-zones (make-list 4 'EntanglingZone))
    (define naive-ok?   (second (assoc 'well-typed? (cdr (Synthesize-Circuit-Grade circ init-anfs init-zones 'naive)))))
    (define phase1-ok?  (second (assoc 'well-typed? (cdr (Synthesize-Circuit-Grade circ init-anfs init-zones 'phase1)))))
    (define unified-ug  (Synthesize-Unified-Grade circ init-anfs init-zones))
    (define unified-ok? (unified-restoration-law-holds? unified-ug init-anfs '(3)))

    (when (and (or (eq? kind 'valid-qfree-cz-kickback)
                   (eq? kind 'valid-qfree-z-kickback))
               unified-ok?)
      (set! valid-qfree-phase-kickbacks-accepted (+ valid-qfree-phase-kickbacks-accepted 1)))

    (define in-bits (list (rand-int 0 1) (rand-int 0 1) (rand-int 0 1) 0))
    (define init-st `(wire-state (vals ,in-bits) (anf ,init-anfs) (phase 1) (zones ,init-zones)))
    (define out-st (eval-circuit-raw circ init-st))
    (match-define `(wire-state (vals ,out-bits) (anf ,out-anfs) (phase ,_) (zones ,_)) out-st)
    (define pebble-and-ctrls-restored?
      (and (= (list-ref out-bits 3) 0)
           (null? (list-ref out-anfs 3))
           (= (list-ref out-bits 0) (list-ref in-bits 0))
           (equal? (list-ref out-anfs 0) (list-ref init-anfs 0))))

    (when (and naive-ok? (not pebble-and-ctrls-restored?))
      (set! naive-failures (+ naive-failures 1)))
    (when (and phase1-ok? (not pebble-and-ctrls-restored?))
      (set! phase1-failures (+ phase1-failures 1))
      (unless minimal-counterexample
        (match-define `(c-with-uncompute ,u-core ,v-core) circ)
        (define bloated `(c-with-uncompute ,(pad-circuit-for-shrinking u-core)
                                           ,(pad-circuit-for-shrinking v-core)))
        (define (f6-bug-pred? cand)
          (and (match cand [`(c-with-uncompute ,_ ,_) #t] [_ #f])
               (let* ([p1g (Synthesize-Circuit-Grade cand init-anfs init-zones 'phase1)]
                      [p1ok? (second (assoc 'well-typed? (cdr p1g)))])
                 (match-define `(wire-state (vals ,ob) (anf ,oa) (phase ,_) (zones ,_))
                   (eval-circuit-raw cand init-st))
                 (and p1ok?
                      (not (and (= (list-ref ob 3) 0)
                                (null? (list-ref oa 3))
                                (= (list-ref ob 0) (list-ref in-bits 0))))))))
        (define shrunk (shrink-circuit bloated f6-bug-pred?))
        (set! minimal-counterexample
              (hash 'unshrunk-gate-count (circuit-gate-count bloated)
                    'shrunk-gate-count (circuit-gate-count shrunk)
                    'circuit shrunk
                    'input-bits in-bits
                    'output-bits out-bits
                    'residual-pebble-bit (list-ref out-bits 3)
                    'residual-pebble-anf (list-ref out-anfs 3)))))
    (when (and unified-ok? (not pebble-and-ctrls-restored?))
      (set! unified-failures (+ unified-failures 1))))

  (hash 'issue-id 'F6-WithUncompute-Conjugate-Phase-Kickback
        'trials trials
        'naive-soundness-failures naive-failures
        'phase1-refined-soundness-failures phase1-failures
        'unified-type-system-soundness-failures unified-failures
        'valid-qfree-phase-kickbacks-accepted valid-qfree-phase-kickbacks-accepted
        'minimal-counterexample minimal-counterexample
        'verified? (and (> naive-failures 0)
                        (> phase1-failures 0)
                        (> valid-qfree-phase-kickbacks-accepted 0)
                        (= unified-failures 0))))

;; -----------------------------------------------------------------------------
;; Phase-2 Fuzz Finding F7: ParDiag Basis-Incoherent Commutation Hazard
;; -----------------------------------------------------------------------------
;; Vulnerability in Phase-1 rules:
;; Phase-1 `c-par-diag` checked `XWriteSet` disjointness from computational reads,
;; missing that Hadamard `(g-h 0)` on a shared wire fails to commute with `(g-cnot 0 2)`
;; or `(g-cz 0 1)` (`H(0) ; CNOT(0,2) != CNOT(0,2) ; H(0)`), and `(g-z 0)` fails to
;; commute with `(g-x 0)` (`Z X = -X Z`)!
(define (fuzz-issue-f7-pardiag-basis-incoherent-commutation [trials 2500])
  (define naive-failures 0)
  (define phase1-failures 0)
  (define unified-failures 0)
  (define minimal-counterexample #f)

  (for ([trial (in-range trials)])
    (define kind
      (rand-choice '(valid-shared-z-ctrl
                     valid-shared-cz
                     bug-shared-h-and-cnot
                     bug-shared-h-and-cz
                     bug-shared-z-and-x)))
    (define-values (c1 c2)
      (match kind
        ['valid-shared-z-ctrl
         (values `(c-gate (g-cnot 0 1)) `(c-gate (g-cnot 0 2)))]
        ['valid-shared-cz
         (values `(c-gate (g-cz 0 1)) `(c-gate (g-cz 0 2)))]
        ['bug-shared-h-and-cnot
         ;; XWriteSet(g-h 0) = ∅, XWriteSet(g-cnot 0 2) = {2}: Phase-1 ACCEPTS!
         (values `(c-gate (g-h 0)) `(c-gate (g-cnot 0 2)))]
        ['bug-shared-h-and-cz
         ;; XWriteSet(g-h 0) = ∅, XWriteSet(g-cz 0 1) = ∅: Phase-1 ACCEPTS!
         (values `(c-gate (g-h 0)) `(c-gate (g-cz 0 1)))]
        ['bug-shared-z-and-x
         ;; Z(0) and X(0) anti-commute: Z X |0> = -|1> != +|1> = X Z |0>!
         (values `(c-gate (g-z 0)) `(c-gate (g-x 0)))]))

    (define par-c12 `(c-par-diag ,c1 ,c2))
    (define par-c21 `(c-par-diag ,c2 ,c1))
    (define init-anfs (initial-anf-env 4 '()))
    (define init-zones (make-list 4 'EntanglingZone))

    (define naive-ok?   (second (assoc 'well-typed? (cdr (Synthesize-Circuit-Grade par-c12 init-anfs init-zones 'naive)))))
    (define phase1-ok?  (second (assoc 'well-typed? (cdr (Synthesize-Circuit-Grade par-c12 init-anfs init-zones 'phase1)))))
    (define unified-ug  (Synthesize-Unified-Grade par-c12 init-anfs init-zones))
    (define unified-ok? (second (assoc 'ok? (cdr unified-ug))))

    (define in-bits (list 1 1 (rand-int 0 1) (rand-int 0 1)))
    (define init-st `(wire-state (vals ,in-bits) (anf ,init-anfs) (phase 1) (zones ,init-zones)))
    (define out-12 (eval-circuit-raw par-c12 init-st))
    (define out-21 (eval-circuit-raw par-c21 init-st))
    (define order-independent? (equal? out-12 out-21))

    (when (and naive-ok? (not order-independent?))
      (set! naive-failures (+ naive-failures 1)))
    (when (and phase1-ok? (not order-independent?))
      (set! phase1-failures (+ phase1-failures 1))
      (unless minimal-counterexample
        (define bloated `(c-par-diag ,(pad-circuit-for-shrinking c1) ,(pad-circuit-for-shrinking c2)))
        (define (f7-bug-pred? cand)
          (match cand
            [`(c-par-diag ,lhs ,rhs)
             (define p1g (Synthesize-Circuit-Grade cand init-anfs init-zones 'phase1))
             (define p1ok? (second (assoc 'well-typed? (cdr p1g))))
             (define o12 (eval-circuit-raw `(c-par-diag ,lhs ,rhs) init-st))
             (define o21 (eval-circuit-raw `(c-par-diag ,rhs ,lhs) init-st))
             (and p1ok? (not (equal? o12 o21)))]
            [_ #f]))
        (define shrunk (shrink-circuit bloated f7-bug-pred?))
        (set! minimal-counterexample
              (hash 'unshrunk-gate-count (circuit-gate-count bloated)
                    'shrunk-gate-count (circuit-gate-count shrunk)
                    'shrunk-circuit shrunk
                    'eval-c1-then-c2 out-12
                    'eval-c2-then-c1 out-21))))
    (when (and unified-ok? (not order-independent?))
      (set! unified-failures (+ unified-failures 1))))

  (hash 'issue-id 'F7-ParDiag-Basis-Incoherent-Commutation
        'trials trials
        'naive-commutativity-failures naive-failures
        'phase1-refined-commutativity-failures phase1-failures
        'unified-type-system-commutativity-failures unified-failures
        'minimal-counterexample minimal-counterexample
        'verified? (and (> naive-failures 0)
                        (> phase1-failures 0)
                        (= unified-failures 0))))

;; -----------------------------------------------------------------------------
;; Phase-2 Fuzz Finding F8: Live Distributed Cat-Ebit Leak & Cold-Zone MBU
;; -----------------------------------------------------------------------------
;; Vulnerability in Phase-1 rules:
;;   (a) Phase-1 `ebits` only incremented a counter on `g-cat-entangle` without
;;       tracking the live entangled cat-link set L_live. Exiting with L_live != ∅
;;       or applying `g-h` to an active cat-linked wire leaves the cross-QPU link
;;       entangled (mixed reduced density matrix, Tr(rho^2) = 0.5 < 1.0)!
;;   (b) Phase-1 `g-hmr-cz` checked `pt == pc1 * pc2` without verifying that
;;       `Zone(t, c1, c2) == EntanglingZone`, allowing MBU in `StorageZone`!
(define (fuzz-issue-f8-live-cat-ebit-leak-and-cold-zone-mbu [trials 2500])
  (define naive-failures 0)
  (define phase1-failures 0)
  (define unified-failures 0)
  (define minimal-counterexample #f)

  (for ([trial (in-range trials)])
    (define kind
      (rand-choice '(valid-balanced-cat-session
                     bug-unclosed-cat-ebit-leak
                     bug-hadamard-on-active-cat-link
                     bug-cold-storage-zone-hmr-cz)))
    (define circ
      (match kind
        ['valid-balanced-cat-session
         `(c-seq (c-gate (g-cat-entangle 0 3))
                 (c-seq (c-gate (g-cz 3 2))
                        (c-gate (g-cat-disentangle 0 3))))]
        ['bug-unclosed-cat-ebit-leak
         ;; Opens distributed cat link (0, 3) and exits without g-cat-disentangle!
         `(c-seq (c-gate (g-cat-entangle 0 3))
                 (c-gate (g-cz 3 2)))]
        ['bug-hadamard-on-active-cat-link
         ;; Applies Hadamard on cat ancilla 3 while cat link (0, 3) is active!
         `(c-seq (c-gate (g-cat-entangle 0 3))
                 (c-seq (c-gate (g-h 3))
                        (c-gate (g-cat-disentangle 0 3))))]
        ['bug-cold-storage-zone-hmr-cz
         ;; Shuttles control 0 to StorageZone (cold zone) before executing HMR_CZ!
         `(c-seq (c-gate (g-compute-and 0 1 3))
                 (c-seq (c-gate (g-zone-shuttle 0 StorageZone))
                        (c-seq (c-gate (g-hmr-cz 3 0 1 1))
                               (c-gate (g-zone-shuttle 0 EntanglingZone)))))]))

    (define init-anfs (initial-anf-env 4 '(3)))
    (define init-zones (make-list 4 'EntanglingZone))
    (define naive-ok?   (second (assoc 'well-typed? (cdr (Synthesize-Circuit-Grade circ init-anfs init-zones 'naive)))))
    (define phase1-ok?  (second (assoc 'well-typed? (cdr (Synthesize-Circuit-Grade circ init-anfs init-zones 'phase1)))))
    (define unified-ug  (Synthesize-Unified-Grade circ init-anfs init-zones))
    (define unified-ok? (unified-restoration-law-holds? unified-ug init-anfs '(3)))

    (define in-bits (list 1 1 (rand-int 0 1) 0))
    (define init-st `(wire-state (vals ,in-bits) (anf ,init-anfs) (phase 1) (zones ,init-zones)))
    (define out-st (eval-circuit-raw circ init-st))
    (match-define `(wire-state (vals ,out-bits) (anf ,out-anfs) (phase ,out-ph) (zones ,_)) out-st)
    (define cat-and-zone-sound?
      (and (= (list-ref out-bits 3) 0)
           (null? (list-ref out-anfs 3))
           (not (any-wire-has-catlink-endpoint? out-anfs 3))
           ;; For HMR_CZ, phase must remain +1; for valid cat session with CZ(3,2), phase is (-1)^(x0*x2)
           (if (eq? kind 'valid-balanced-cat-session)
               (= out-ph (if (= (bitwise-and (list-ref in-bits 0) (list-ref in-bits 2)) 1) -1 1))
               (= out-ph 1))))

    (when (and naive-ok? (not cat-and-zone-sound?))
      (set! naive-failures (+ naive-failures 1)))
    (when (and phase1-ok? (not cat-and-zone-sound?))
      (set! phase1-failures (+ phase1-failures 1))
      (unless minimal-counterexample
        (define bloated (pad-circuit-for-shrinking circ))
        (define (f8-bug-pred? cand)
          (define p1g (Synthesize-Circuit-Grade cand init-anfs init-zones 'phase1))
          (define p1ok? (second (assoc 'well-typed? (cdr p1g))))
          (match-define `(wire-state (vals ,ob) (anf ,oa) (phase ,oph) (zones ,_))
            (eval-circuit-raw cand init-st))
          (and p1ok?
               (not (and (= (list-ref ob 3) 0)
                         (null? (list-ref oa 3))
                         (not (any-wire-has-catlink-endpoint? oa 3))
                         (= oph 1)))))
        (define shrunk (shrink-circuit bloated f8-bug-pred?))
        (set! minimal-counterexample
              (hash 'unshrunk-gate-count (circuit-gate-count bloated)
                    'shrunk-gate-count (circuit-gate-count shrunk)
                    'circuit shrunk
                    'input-bits in-bits
                    'output-bits out-bits
                    'output-pebble-anf (list-ref out-anfs 3)
                    'output-phase out-ph))))
    (when (and unified-ok? (not cat-and-zone-sound?))
      (set! unified-failures (+ unified-failures 1))))

  (hash 'issue-id 'F8-Live-Cat-Ebit-Leak-and-Cold-Zone-MBU
        'trials trials
        'naive-soundness-failures naive-failures
        'phase1-refined-soundness-failures phase1-failures
        'unified-type-system-soundness-failures unified-failures
        'minimal-counterexample minimal-counterexample
        'verified? (and (> naive-failures 0)
                        (> phase1-failures 0)
                        (= unified-failures 0))))

;; -----------------------------------------------------------------------------
;; Phase-3 Fuzz Finding F9: Quotient Carry-Save Premature Phase Kickback
;; -----------------------------------------------------------------------------
;; Vulnerability in Naive / Phase-1 / Phase-2 rules:
;; A carry-save register stores redundant pairs (S, C) representing x = S + 2C (mod M).
;; After `(g-skew-add-cs w)` sets `RepState = RedundantCS`, applying a phase kickback
;; gate (`g-z w`, `g-cz w c2`) or comparator (`g-cmp-gt w c2 t`) BEFORE
;; `(g-consolidate-cs w)` projects (S, C) -> ((S + 2C) mod M, 0) causes superposed
;; branches with distinct carry-save representations (S1, C1) != (S2, C2) of the
;; same canonical residue x to acquire different phases or fail to interfere!
;; Fix (Fix F9 / Canonical S8):
;; Track `RepState ∈ {CanonicalMod, RedundantCS}` in `cwire`; require `RepState = CanonicalMod`
;; on all phase, comparator, Hadamard, and measurement gates and at circuit exit.
(define (fuzz-issue-f9-quotient-carry-save-premature-phase-kickback [trials 2500])
  (define naive-failures 0)
  (define phase2-failures 0)
  (define canonical-failures 0)
  (define minimal-counterexample #f)

  (for ([trial (in-range trials)])
    (define kind
      (rand-choice '(valid-consolidated-before-phase
                     bug-z-before-consolidate
                     bug-cz-before-consolidate
                     bug-unconsolidated-exit)))
    (define circ
      (match kind
        ['valid-consolidated-before-phase
         ;; Skew-add -> Consolidate -> Z phase kickback -> Adjoint uncompute: SOUND!
         `(c-with-uncompute
           (c-seq (c-gate (g-skew-add-cs 3))
                  (c-gate (g-consolidate-cs 3)))
           (c-gate (g-z 3)))]
        ['bug-z-before-consolidate
         ;; Z phase kickback on redundant carry-save wire 3 BEFORE g-consolidate-cs!
         `(c-seq (c-gate (g-skew-add-cs 3))
                 (c-seq (c-gate (g-z 3))
                        (c-seq (c-gate (g-consolidate-cs 3))
                               (c-gate (g-x 3)))))]
        ['bug-cz-before-consolidate
         ;; CZ phase kickback on redundant carry-save wire 3 BEFORE g-consolidate-cs!
         `(c-seq (c-gate (g-skew-add-cs 3))
                 (c-seq (c-gate (g-cz 0 3))
                        (c-seq (c-gate (g-consolidate-cs 3))
                               (c-gate (g-x 3)))))]
        ['bug-unconsolidated-exit
         ;; Exits circuit while wire 3 is still in RedundantCS without g-consolidate-cs!
         `(c-seq (c-gate (g-skew-add-cs 3))
                 (c-gate (g-x 3)))]))

    (define init-anfs (initial-anf-env 4 '(3)))
    (define init-zones (make-list 4 'EntanglingZone))
    (define naive-ok?     (second (assoc 'well-typed? (cdr (Synthesize-Circuit-Grade circ init-anfs init-zones 'naive)))))
    (define phase2-ug     (Synthesize-Unified-Grade circ init-anfs init-zones))
    (define phase2-ok?    (unified-restoration-law-holds? phase2-ug init-anfs '(3)))
    (define canonical-cg  (Synthesize-Canonical-Grade circ init-anfs init-zones))
    (define canonical-ok? (canonical-restoration-law-holds? canonical-cg init-anfs '(3)))

    (define in-bits (list (rand-int 0 1) (rand-int 0 1) (rand-int 0 1) 0))
    (define init-st `(wire-state (vals ,in-bits) (anf ,init-anfs) (phase 1) (zones ,init-zones)))
    (define out-st (eval-circuit-raw circ init-st))
    (match-define `(wire-state (vals ,out-bits) (anf ,out-anfs) (phase ,out-ph) (zones ,_)) out-st)
    (define cs-sound?
      (and (= (list-ref out-bits 3) 0)
           (null? (list-ref out-anfs 3))
           (not (wire-has-redundant-cs? out-anfs 3))
           (not (poly-has-mono? (list-ref out-anfs 3) (hmr-fault-mono 3)))))

    (when (and naive-ok? (not cs-sound?))
      (set! naive-failures (+ naive-failures 1)))
    (when (and phase2-ok? (not cs-sound?))
      (set! phase2-failures (+ phase2-failures 1))
      (unless minimal-counterexample
        (define bloated (pad-circuit-for-shrinking circ))
        (define (f9-bug-pred? cand)
          (define ug (Synthesize-Unified-Grade cand init-anfs init-zones))
          (define uok? (unified-restoration-law-holds? ug init-anfs '(3)))
          (match-define `(wire-state (vals ,ob) (anf ,oa) (phase ,_oph) (zones ,_))
            (eval-circuit-raw cand init-st))
          (and uok?
               (not (and (= (list-ref ob 3) 0)
                         (null? (list-ref oa 3))
                         (not (wire-has-redundant-cs? oa 3))))))
        (define shrunk (shrink-circuit bloated f9-bug-pred?))
        (set! minimal-counterexample
              (hash 'unshrunk-gate-count (circuit-gate-count bloated)
                    'shrunk-gate-count (circuit-gate-count shrunk)
                    'circuit shrunk
                    'input-bits in-bits
                    'output-bits out-bits
                    'output-pebble-anf (list-ref out-anfs 3)
                    'output-phase out-ph))))
    (when (and canonical-ok? (not cs-sound?))
      (set! canonical-failures (+ canonical-failures 1))))

  (hash 'issue-id 'F9-Quotient-Carry-Save-Premature-Phase-Kickback
        'trials trials
        'naive-soundness-failures naive-failures
        'phase2-unified-soundness-failures phase2-failures
        'canonical-type-system-soundness-failures canonical-failures
        'minimal-counterexample minimal-counterexample
        'verified? (and (> naive-failures 0)
                        (> phase2-failures 0)
                        (= canonical-failures 0))))

;; -----------------------------------------------------------------------------
;; Phase-3 Fuzz Finding F10: Recursive Binomial Pebble Checkpoint Overwrite
;; -----------------------------------------------------------------------------
;; Vulnerability in Naive / Phase-1 / Phase-2 rules:
;; In Královič's recursive binomial pebbling `(c-with-locked-pebble p u-ckpt v-body)`,
;; `u-ckpt` computes an intermediate checkpoint state onto pebble wire `p` while
;; `v-body` executes the recursive suffix pebbling before `u-ckpt^dag` uncomputes `p`.
;; If `v-body` overwrites, resets, or reuses `p` as a scratch wire (`p ∈ WriteSet(v-body)`),
;; `u-ckpt^dag` fails to restore `p` to `|0>`!
;; Fix (Fix F10 / Canonical S8):
;; Track `Locked?` boolean per wire in `cwire`; `(c-with-locked-pebble p u-ckpt v-body)`
;; sets `Locked?(p) = #t` throughout `v-body`, rejecting any write/measurement/shuttle on `p`.
(define (fuzz-issue-f10-recursive-binomial-pebble-checkpoint-overwrite [trials 2500])
  (define naive-failures 0)
  (define phase2-failures 0)
  (define canonical-failures 0)
  (define minimal-counterexample #f)

  (for ([trial (in-range trials)])
    (define kind
      (rand-choice '(valid-locked-checkpoint-read
                     bug-v-overwrites-ckpt-x
                     bug-v-overwrites-ckpt-cnot
                     bug-v-hmr-resets-ckpt)))
    (define u-ckpt '(c-gate (g-compute-and 0 1 3)))
    (define v-body
      (match kind
        ['valid-locked-checkpoint-read
         ;; v-body reads checkpoint pebble 3 via CNOT(3, 2) and uncomputes CNOT(3, 2): SOUND!
         `(c-seq (c-gate (g-cnot 3 2))
                 (c-gate (g-cnot 3 2)))]
        ['bug-v-overwrites-ckpt-x
         ;; v-body flips locked checkpoint wire 3 via g-x!
         `(c-gate (g-x 3))]
        ['bug-v-overwrites-ckpt-cnot
         ;; v-body reuses locked checkpoint wire 3 as a CNOT target from wire 2!
         `(c-gate (g-cnot 2 3))]
        ['bug-v-hmr-resets-ckpt
         ;; v-body prematurely uncomputes locked checkpoint 3 via HMR_CZ, so outer u-ckpt^dag
         ;; re-computes x0*x1 onto wire 3 instead of restoring 0!
         `(c-gate (g-hmr-cz 3 0 1 0))]))
    (define circ `(c-with-locked-pebble 3 ,u-ckpt ,v-body))

    (define init-anfs (initial-anf-env 4 '(3)))
    (define init-zones (make-list 4 'EntanglingZone))
    (define naive-ok?     (second (assoc 'well-typed? (cdr (Synthesize-Circuit-Grade circ init-anfs init-zones 'naive)))))
    (define phase2-ug     (Synthesize-Unified-Grade circ init-anfs init-zones))
    (define phase2-ok?    (second (assoc 'ok? (cdr phase2-ug))))
    (define canonical-cg  (Synthesize-Canonical-Grade circ init-anfs init-zones))
    (define canonical-ok? (canonical-restoration-law-holds? canonical-cg init-anfs '(3)))

    (define in-bits (list 1 1 1 0))
    (define init-st `(wire-state (vals ,in-bits) (anf ,init-anfs) (phase 1) (zones ,init-zones)))
    (define out-st (eval-circuit-raw circ init-st))
    (match-define `(wire-state (vals ,out-bits) (anf ,out-anfs) (phase ,out-ph) (zones ,_)) out-st)
    (define ckpt-restored?
      (and (= (list-ref out-bits 3) 0)
           (null? (list-ref out-anfs 3))
           (= out-ph 1)))

    (when (and naive-ok? (not ckpt-restored?))
      (set! naive-failures (+ naive-failures 1)))
    (when (and phase2-ok? (not ckpt-restored?))
      (set! phase2-failures (+ phase2-failures 1))
      (unless minimal-counterexample
        (define bloated `(c-with-locked-pebble 3
                                               ,(pad-circuit-for-shrinking u-ckpt)
                                               ,(pad-circuit-for-shrinking v-body)))
        (define (f10-bug-pred? cand)
          (and (match cand [`(c-with-locked-pebble 3 ,_ ,_) #t] [_ #f])
               (let* ([ug (Synthesize-Unified-Grade cand init-anfs init-zones)]
                      [uok? (second (assoc 'ok? (cdr ug)))])
                 (match-define `(wire-state (vals ,ob) (anf ,oa) (phase ,oph) (zones ,_))
                   (eval-circuit-raw cand init-st))
                 (and uok?
                      (not (and (= (list-ref ob 3) 0)
                                (null? (list-ref oa 3))
                                (= oph 1)))))))
        (define shrunk (shrink-circuit bloated f10-bug-pred?))
        (set! minimal-counterexample
              (hash 'unshrunk-gate-count (circuit-gate-count bloated)
                    'shrunk-gate-count (circuit-gate-count shrunk)
                    'circuit shrunk
                    'input-bits in-bits
                    'output-bits out-bits
                    'residual-pebble-bit (list-ref out-bits 3)
                    'residual-pebble-anf (list-ref out-anfs 3)))))
    (when (and canonical-ok? (not ckpt-restored?))
      (set! canonical-failures (+ canonical-failures 1))))

  (hash 'issue-id 'F10-Recursive-Binomial-Pebble-Checkpoint-Overwrite
        'trials trials
        'naive-soundness-failures naive-failures
        'phase2-unified-soundness-failures phase2-failures
        'canonical-type-system-soundness-failures canonical-failures
        'minimal-counterexample minimal-counterexample
        'verified? (and (> naive-failures 0)
                        (> phase2-failures 0)
                        (= canonical-failures 0))))

;; -----------------------------------------------------------------------------
;; Phase-3 Fuzz Finding F11: Fredkin Comparator Post-Swap Uncompute Paradox
;; -----------------------------------------------------------------------------
;; Vulnerability in Naive / Phase-1 / Phase-2 rules:
;; In reversible sorting networks (`CanonicalCritBitBitonicDictionary`, QDS-6),
;; a compare-and-swap stage computes `c <- (kL > kR)` via `(g-cmp-gt 0 1 3)` and
;; swaps `(0, 1)` via `(g-cswap 3 0 1)` so `(kL', kR') = (min(kL, kR), max(kL, kR))`.
;; If a circuit attempts to uncompute `c` immediately after `g-cswap` via
;; `(g-cmp-gt 0 1 3)` on the POST-SWAP wires `(kL', kR')`, then `(kL' > kR') == 0`
;; identically in F_2[x_0, x_1], leaving `c = (kL > kR) != 0` dirty forever!
;; Fix (Fix F11 / Canonical S8):
;; Exact nonlinear Fredkin ANF update `anf(kL') <- pL xor pc*(pL xor pR)` in `typeof-canonical`
;; automatically proves `anf_out(c) = x_0 xor x_0*x_1 != 0` on the post-swap uncompute
;; while proving `anf_out(c) = 0` on the valid symmetric reverse-pass uncompute!
(define (fuzz-issue-f11-fredkin-comparator-postswap-uncompute-paradox [trials 2500])
  (define naive-failures 0)
  (define phase2-failures 0)
  (define canonical-failures 0)
  (define minimal-counterexample #f)

  (for ([trial (in-range trials)])
    (define kind
      (rand-choice '(valid-symmetric-reverse-uncompute
                     valid-with-uncompute-comparator
                     bug-postswap-immediate-uncompute
                     bug-postswap-reversed-args-uncompute)))
    (define circ
      (match kind
        ['valid-symmetric-reverse-uncompute
         ;; Compare -> CSWAP -> use sorted wire -> CSWAP back -> Uncompare: SOUND!
         `(c-seq (c-gate (g-cmp-gt 0 1 3))
                 (c-seq (c-gate (g-cswap 3 0 1))
                        (c-seq (c-gate (g-cnot 0 2))
                               (c-seq (c-gate (g-cnot 0 2))
                                      (c-seq (c-gate (g-cswap 3 0 1))
                                             (c-gate (g-cmp-gt 0 1 3)))))))]
        ['valid-with-uncompute-comparator
         `(c-with-uncompute
           (c-seq (c-gate (g-cmp-gt 0 1 3))
                  (c-gate (g-cswap 3 0 1)))
           (c-gate (g-z 0)))]
        ['bug-postswap-immediate-uncompute
         ;; Paradoxical post-swap uncompute: after CSWAP(3, 0, 1), wire 0 is min(x0,x1)
         ;; and wire 1 is max(x0,x1), so (w0 > w1) is identically 0 and fails to uncompute wire 3!
         `(c-seq (c-gate (g-cmp-gt 0 1 3))
                 (c-seq (c-gate (g-cswap 3 0 1))
                        (c-gate (g-cmp-gt 0 1 3))))]
        ['bug-postswap-reversed-args-uncompute
         ;; Trying (w1 > w0) after CSWAP computes (max > min) = (x0 != x1) != (x0 > x1)!
         `(c-seq (c-gate (g-cmp-gt 0 1 3))
                 (c-seq (c-gate (g-cswap 3 0 1))
                        (c-gate (g-cmp-gt 1 0 3))))]))

    (define init-anfs (initial-anf-env 4 '(3)))
    (define init-zones (make-list 4 'EntanglingZone))
    (define naive-grade   (Synthesize-Circuit-Grade circ init-anfs init-zones 'naive))
    (define naive-ok?     (and (second (assoc 'well-typed? (cdr naive-grade)))
                               (= (list-ref (second (assoc 'z2-parity (cdr naive-grade))) 3) 0)))
    (define phase2-ug     (Synthesize-Unified-Grade circ init-anfs init-zones))
    (define phase2-ok?    (unified-restoration-law-holds? phase2-ug init-anfs '(3)))
    (define canonical-cg  (Synthesize-Canonical-Grade circ init-anfs init-zones))
    (define canonical-ok? (canonical-restoration-law-holds? canonical-cg init-anfs '(3)))

    ;; Test on input (x0=1, x1=0) where (x0 > x1) == 1 so the swap actually fires!
    (define in-bits (list 1 0 (rand-int 0 1) 0))
    (define init-st `(wire-state (vals ,in-bits) (anf ,init-anfs) (phase 1) (zones ,init-zones)))
    (define out-st (eval-circuit-raw circ init-st))
    (match-define `(wire-state (vals ,out-bits) (anf ,out-anfs) (phase ,_) (zones ,_)) out-st)
    (define comparator-ancilla-clean?
      (and (= (list-ref out-bits 3) 0)
           (null? (list-ref out-anfs 3))))

    (when (and naive-ok? (not comparator-ancilla-clean?))
      (set! naive-failures (+ naive-failures 1)))
    (when (and phase2-ok? (not comparator-ancilla-clean?))
      (set! phase2-failures (+ phase2-failures 1))
      (unless minimal-counterexample
        (define bloated (pad-circuit-for-shrinking circ))
        (define (f11-bug-pred? cand)
          (define ug (Synthesize-Unified-Grade cand init-anfs init-zones))
          (define uok? (unified-restoration-law-holds? ug init-anfs '(3)))
          (match-define `(wire-state (vals ,ob) (anf ,oa) (phase ,_) (zones ,_))
            (eval-circuit-raw cand init-st))
          (and uok?
               (not (and (= (list-ref ob 3) 0)
                         (null? (list-ref oa 3))))))
        (define shrunk (shrink-circuit bloated f11-bug-pred?))
        (set! minimal-counterexample
              (hash 'unshrunk-gate-count (circuit-gate-count bloated)
                    'shrunk-gate-count (circuit-gate-count shrunk)
                    'circuit shrunk
                    'input-bits in-bits
                    'output-bits out-bits
                    'residual-comparator-bit (list-ref out-bits 3)
                    'residual-comparator-anf (list-ref out-anfs 3)))))
    (when (and canonical-ok? (not comparator-ancilla-clean?))
      (set! canonical-failures (+ canonical-failures 1))))

  (hash 'issue-id 'F11-Fredkin-Comparator-PostSwap-Uncompute-Paradox
        'trials trials
        'naive-soundness-failures naive-failures
        'phase2-unified-soundness-failures phase2-failures
        'canonical-type-system-soundness-failures canonical-failures
        'minimal-counterexample minimal-counterexample
        'verified? (and (> naive-failures 0)
                        (> phase2-failures 0)
                        (= canonical-failures 0))))

;; -----------------------------------------------------------------------------
;; Phase-3 Fuzz Finding F12: Timed Choreography Terhal Backlog & FIFO Cat Deadlock
;; -----------------------------------------------------------------------------
;; Vulnerability in Naive / Phase-1 / Phase-2 rules:
;;   (a) Accumulating > 1,000 ns of classical FPGA feed-forward + tele-gate latency
;;       within a single QEC syndrome cycle without `(g-qec-barrier)` violates
;;       Terhal's syndrome backlog bound (`latency-ns > T_cycle = 1,000 ns`).
;;   (b) Phase-2 `live-links` used set membership `(member pair links)` instead of
;;       a strict LIFO stack, accepting interleaved/FIFO cat-link disentanglement
;;       `entangle(0,2) ; entangle(1,3) ; disentangle(0,2) ; disentangle(1,3)`
;;       which deadlocks distributed endpoint projection!
;; Fix (Fix F12 / Canonical S8):
;; Track `latency-ns <= 1,000` (reset to 0 by `g-qec-barrier`) and enforce strict
;; LIFO stack push/pop on `live-links` in `typeof-canonical`.
(define (fuzz-issue-f12-timed-choreography-terhal-backlog-and-fifo-deadlock [trials 2500])
  (define naive-failures 0)
  (define phase2-failures 0)
  (define canonical-failures 0)
  (define minimal-counterexample #f)

  (for ([trial (in-range trials)])
    (define kind
      (rand-choice '(valid-barriered-fpga-and-lifo-cats
                     bug-terhal-latency-backlog-exceeded
                     bug-fifo-interleaved-cat-deadlock)))
    (define circ
      (match kind
        ['valid-barriered-fpga-and-lifo-cats
         ;; 600 ns FPGA feed-forward -> QEC barrier (resets to 0) -> LIFO nested cat links: SOUND!
         `(c-seq (c-gate (g-fpga-feedforward 0 600))
                 (c-seq (c-gate (g-qec-barrier))
                        (c-seq (c-gate (g-cat-entangle 0 2))
                               (c-seq (c-gate (g-cat-entangle 1 3))
                                      (c-seq (c-gate (g-cat-disentangle 1 3))
                                             (c-gate (g-cat-disentangle 0 2)))))))]
        ['bug-terhal-latency-backlog-exceeded
         ;; Two 600 ns FPGA feed-forward steps (1,200 ns > 1,000 ns QEC budget) without g-qec-barrier!
         `(c-seq (c-gate (g-fpga-feedforward 0 600))
                 (c-gate (g-fpga-feedforward 0 600)))]
        ['bug-fifo-interleaved-cat-deadlock
         ;; Opens (0, 2) then (1, 3), but disentangles (0, 2) FIRST (FIFO order -> deadlock)!
         `(c-seq (c-gate (g-cat-entangle 0 2))
                 (c-seq (c-gate (g-cat-entangle 1 3))
                        (c-seq (c-gate (g-cat-disentangle 0 2))
                               (c-gate (g-cat-disentangle 1 3)))))]))

    (define init-anfs (initial-anf-env 4 '(2 3)))
    (define init-zones (make-list 4 'EntanglingZone))
    (define naive-ok?     (second (assoc 'well-typed? (cdr (Synthesize-Circuit-Grade circ init-anfs init-zones 'naive)))))
    (define phase2-ug     (Synthesize-Unified-Grade circ init-anfs init-zones))
    (define phase2-ok?    (unified-restoration-law-holds? phase2-ug init-anfs '(2 3)))
    (define canonical-cg  (Synthesize-Canonical-Grade circ init-anfs init-zones))
    (define canonical-ok? (canonical-restoration-law-holds? canonical-cg init-anfs '(2 3)))

    (define in-bits (list (rand-int 0 1) (rand-int 0 1) 0 0))
    (define init-st `(wire-state (vals ,in-bits) (anf ,init-anfs) (phase 1) (zones ,init-zones)))
    (define out-st (eval-circuit-raw circ init-st))
    (match-define `(wire-state (vals ,out-bits) (anf ,out-anfs) (phase ,out-ph) (zones ,_)) out-st)
    (define choreography-sound?
      (and (equal? out-bits in-bits)
           (null? (list-ref out-anfs 2))
           (null? (list-ref out-anfs 3))
           (= out-ph 1)))

    (when (and naive-ok? (not choreography-sound?))
      (set! naive-failures (+ naive-failures 1)))
    (when (and phase2-ok? (not choreography-sound?))
      (set! phase2-failures (+ phase2-failures 1))
      (unless minimal-counterexample
        (define bloated (pad-circuit-for-shrinking circ))
        (define (f12-bug-pred? cand)
          (define ug (Synthesize-Unified-Grade cand init-anfs init-zones))
          (define uok? (unified-restoration-law-holds? ug init-anfs '(2 3)))
          (match-define `(wire-state (vals ,ob) (anf ,oa) (phase ,oph) (zones ,_))
            (eval-circuit-raw cand init-st))
          (and uok?
               (not (and (equal? ob in-bits)
                         (null? (list-ref oa 2))
                         (null? (list-ref oa 3))
                         (= oph 1)))))
        (define shrunk (shrink-circuit bloated f12-bug-pred?))
        (set! minimal-counterexample
              (hash 'unshrunk-gate-count (circuit-gate-count bloated)
                    'shrunk-gate-count (circuit-gate-count shrunk)
                    'circuit shrunk
                    'input-bits in-bits
                    'output-bits out-bits
                    'output-phase out-ph))))
    (when (and canonical-ok? (not choreography-sound?))
      (set! canonical-failures (+ canonical-failures 1))))

  (hash 'issue-id 'F12-Timed-Choreography-Terhal-Backlog-and-FIFO-Deadlock
        'trials trials
        'naive-soundness-failures naive-failures
        'phase2-unified-soundness-failures phase2-failures
        'canonical-type-system-soundness-failures canonical-failures
        'minimal-counterexample minimal-counterexample
        'verified? (and (> naive-failures 0)
                        (> phase2-failures 0)
                        (= canonical-failures 0))))

