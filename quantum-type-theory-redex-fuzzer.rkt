    (define qds31-mut-listall (logarithmic-assertion-counter-tree num-assertions num-rounds #t #t 'user-cloud-outer-loop))
    (define qds31-mut-innerloop (logarithmic-assertion-counter-tree num-assertions num-rounds #t #f 'provider-inner-loop-blueprint))
    (when (and (hash-ref qds31-mut-linear 'linear-ancilla-blowup?)
