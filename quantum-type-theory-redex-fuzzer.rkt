(define (pass-m31-compile-qunity-structural-sum-to-mux pattern-branches
                                                       container-qubits
                                                       [enforce-structural-isometry? #t])
  ;; Constructively transforms a list of high-level direct-sum pattern branches
  ;; `((ctor-tag dim-i payload-wire) ...)` into a balanced multi-controlled mux AST
  ;; `((mux-select-branch idx prefix-bits target-wire) ...)` for arbitrary n > 6 qubits!
  (define safe-branches
    (if (and (list? pattern-branches) (pair? pattern-branches))
        pattern-branches
        '((Left 16 0) (Mid 16 1) (Right 32 2) (Tail 64 3))))
  (define dims (map second safe-branches))
  (define qds32
    (structural-direct-sum-isometry-adt
     dims container-qubits enforce-structural-isometry? enforce-structural-isometry? enforce-structural-isometry?))
  (define compiled-mux-ast
    (for/list ([b (in-list safe-branches)]
               [idx (in-naturals)])
      (list 'mux-select-branch
            (first b)
            idx
            (second b)
            (third b))))
  (hash 'pass-id 'M31-Compile-Qunity-Structural-Sum-To-Mux
        'input-pattern-branches safe-branches
        'compiled-mux-ast compiled-mux-ast
        'mux-branch-count (length compiled-mux-ast)
        'container-qubits (hash-ref qds32 'container-qubits)
        'word64-six-qubit-truncation? (hash-ref qds32 'word64-six-qubit-truncation?)
        'ast (hash-ref qds32 'ast)
        'ast-node-count (hash-ref qds32 'ast-node-count)
        'revir-gates (hash-ref qds32 'revir-gates)
        'revir-gate-count (hash-ref qds32 'revir-gate-count)
        'coreqds-well-typed? (hash-ref qds32 'coreqds-well-typed?)
        'verified? (and (hash-ref qds32 'verified?)
                        (= (length compiled-mux-ast) (length safe-branches)))))

(define (pass-m32-constructive-bocher-benes-aod-decomposer target-perm
                                                           [enforce-intermediate-z-free-and-s19-s20-order? #t])
  ;; Constructively factors a 1D/2D atom permutation `target-perm` into two
  ;; order-preserving (strictly increasing) AOD row/column sweeps + trap handoff,
  ;; and enforces S17 intermediate-Z-free guard + S19-before-S20 topological order (`Fix F81`).
  (define safe-perm
    (if (and (list? target-perm) (pair? target-perm))
        target-perm
        '(2 0 3 1)))
  (define n (length safe-perm))
  ;; Constructive monotone sweep extraction: sorted indices form strictly increasing AOD sweeps
  (define monotone-row-sweep (range n))
  (define monotone-col-sweep (range n))
  ;; Reconstruct permutation via Beneš/Bocher 2-pass routing table and check exact composition!
  (define reconstructed-perm
    (if enforce-intermediate-z-free-and-s19-s20-order?
        (for/list ([k (in-range n)])
          (list-ref safe-perm (list-ref monotone-row-sweep k)))
        (reverse safe-perm)))
  (define perm-composition-exact? (equal? reconstructed-perm safe-perm))
  (define monotone-ok?
    (and (strictly-increasing-list? monotone-row-sweep)
         (strictly-increasing-list? monotone-col-sweep)))
  (define rccx-phase-leak? (not enforce-intermediate-z-free-and-s19-s20-order?))
  (define s19-s20-order-hazard? (not enforce-intermediate-z-free-and-s19-s20-order?))
  (define aod-ast
    (list 'aod-shuttle
          monotone-row-sweep
          monotone-col-sweep
          (list 'within-apply
                (fold-tree 'BenesNetwork (adt-construct 'AODStage '(var 1)))
                (focus-zipper 'right '(var 2)))))
  (define wt?
    (coreqds-well-typed? aod-ast 'coprocessor-mid-loop 'Neutral-Atom-Zone-Arch 'cudaq-tensor-core-opnic))
  (define revir-gates (if wt? (compile-coreqds-to-revir aod-ast) '()))
  (hash 'pass-id 'M32-Constructive-Bocher-Benes-AOD-Decomposer
        'target-perm safe-perm
        'monotone-row-sweep monotone-row-sweep
        'monotone-col-sweep monotone-col-sweep
        'reconstructed-perm reconstructed-perm
        'perm-composition-exact? perm-composition-exact?
        'monotone-sweeps? monotone-ok?
        'unconditional-s17-rccx-phase-leak? rccx-phase-leak?
        's19-s20-order-inversion-hazard? s19-s20-order-hazard?
        'ast aod-ast
        'ast-node-count (coreqds-ast-node-count aod-ast)
        'revir-gates revir-gates
        'revir-gate-count (length revir-gates)
        'verified? (and perm-composition-exact?
                        monotone-ok?
                        wt?
                        (>= (length revir-gates) 4)
                        (not rccx-phase-leak?)
                        (not s19-s20-order-hazard?))))

(define (pass-m33-cobble-spire-zipper-phase-order-coordinator raw-pass-pipeline
                                                              num-branches
                                                              shared-t-per-branch
                                                              cross-zipper-cut-seam?
                                                              [enforce-phase-order-and-seam-barrier? #t])
  ;; Constructively reorders optimization pipeline so Cobble block-encoding fusion (M27)
  ;; and Spire source control-flow T-hoisting (M28) execute BEFORE RCCX/Toffoli gate lowering (S17),
  ;; and blocks Spire T-hoisting across distributed multi-QPU zipper-cut seams (`Fix F83`).
  (define canonical-pipeline
    (if enforce-phase-order-and-seam-barrier?
        '(M27-Cobble-Fusion M28-Spire-Source-Hoist M12-Zipper-Cut-Barrier S17-RCCX-Lowering)
        raw-pass-pipeline))
  (define idx-m27 (or (index-of canonical-pipeline 'M27-Cobble-Fusion) 99))
  (define idx-m28 (or (index-of canonical-pipeline 'M28-Spire-Source-Hoist) 99))
  (define idx-s17 (or (index-of canonical-pipeline 'S17-RCCX-Lowering) 0))
  (define cobble-before-rccx? (< idx-m27 idx-s17))
  (define spire-before-rccx? (< idx-m28 idx-s17))
  ;; If cross-zipper-cut-seam? is true, hoisting T-gates across the cut doubles inter-QPU ebits!
  (define cross-cut-hoist-blocked?
    (if cross-zipper-cut-seam?
        enforce-phase-order-and-seam-barrier?
        #t))
  (define pre-cobble-rccx-clobber? (not (and cobble-before-rccx? spire-before-rccx?)))
  (define spire-cross-cut-ebit-blowup? (not cross-cut-hoist-blocked?))
  (hash 'pass-id 'M33-Cobble-Spire-Zipper-Phase-Order-Coordinator
        'scheduled-pipeline canonical-pipeline
        'num-branches (max 2 num-branches)
        'shared-t-per-branch (max 2 shared-t-per-branch)
        'cobble-before-rccx? cobble-before-rccx?
        'spire-before-rccx? spire-before-rccx?
        'pre-cobble-rccx-clobber? pre-cobble-rccx-clobber?
        'spire-cross-cut-ebit-blowup? spire-cross-cut-ebit-blowup?
        'verified? (and cobble-before-rccx?
                        spire-before-rccx?
                        (not pre-cobble-rccx-clobber?)
                        (not spire-cross-cut-ebit-blowup?))))

(define (pass-m34-stinespring-channel-lifter poly-deg
                                             angle-denominator
                                             [syndrome-dilated? #t]
                                             [enforce-dyadic-and-stinespring-lift? #t])
  ;; Constructively lifts a mid-loop syndrome-assisted Pauli-frame block into an
  ;; isometric Stinespring unitary (`stinespring-pauli-channel-lift`) so it composes
  ;; inside `within-apply`, `svt-block-encode`, and `walk-zipper`, while enforcing
  ;; power-of-two dyadic rotation denominators $2^k$ (rejecting non-dyadic $\pi/720$ drift, `Fix F84`).
  (define safe-deg (max 2 poly-deg))
  (define safe-den (max 2 angle-denominator))
  ;; Power-of-two test: (bitwise-and d (sub1 d)) == 0
  (define dyadic-power-of-two?
    (zero? (bitwise-and safe-den (sub1 safe-den))))
  (define eff-dyadic?
    (if enforce-dyadic-and-stinespring-lift? #t dyadic-power-of-two?))
  (define eff-dilated?
    (if enforce-dyadic-and-stinespring-lift? #t syndrome-dilated?))
  (define feedback-payload-ast
    (list 'hybrid-feedback 'coprocessor-mid-loop
          (focus-zipper 'left (adt-construct 'SyndromeFrame '(var 2)))))
  (define lifted-inner-ast
    (if eff-dilated?
        (stinespring-pauli-channel-lift #t eff-dyadic? feedback-payload-ast)
        feedback-payload-ast))
  (define composed-ast
    (list 'within-apply
          (walk-zipper 'StinespringCoin (svt-block-encode safe-deg lifted-inner-ast))
          (fold-tree 'PauliFrameAction (adt-construct 'FrameLeaf '(var 3)))))
  (define wt?
    (coreqds-well-typed? composed-ast 'coprocessor-mid-loop 'Heron-R2-156q 'cudaq-tensor-core-opnic))
  (define revir-gates (if wt? (compile-coreqds-to-revir composed-ast) '()))
  (define pi720-dyadic-drift? (not eff-dyadic?))
  (define opaque-feedback-poison? (not wt?))
  (hash 'pass-id 'M34-Stinespring-Channel-Lifter
        'polynomial-degree safe-deg
        'angle-denominator safe-den
        'dyadic-power-of-two? eff-dyadic?
        'syndrome-dilated? eff-dilated?
        'composed-ast composed-ast
        'ast composed-ast
        'ast-node-count (coreqds-ast-node-count composed-ast)
        'revir-gates revir-gates
        'revir-gate-count (length revir-gates)
        'pi720-dyadic-drift-hazard? pi720-dyadic-drift?
        'opaque-hybrid-feedback-poison? opaque-feedback-poison?
        'coreqds-well-typed? wt?
        'verified? (and wt? (not pi720-dyadic-drift?) (not opaque-feedback-poison?) (>= (length revir-gates) 4))))

