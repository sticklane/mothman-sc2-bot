  (define pool
    (for/vector ([idx (in-range 64)])
      (define n-leaves (if (even? idx) 0 (+ 1 (bitwise-and idx 7))))
      (define code-d   (if (zero? (bitwise-and idx 3)) 1 3))
      (define noise-p  (if (zero? (bitwise-and idx 7)) 0 0.001))
      (define angle-mrad 0)

      ;; 1. S40 totality guard clamps N=0, d=1, p=0, and elides theta=0 rotations safely!
      (define s40-wt (s40-boundary-input-safe-totality-guard n-leaves code-d noise-p angle-mrad #t))
      (define wt-ok?
        (and (hash-ref s40-wt 'verified?)
             (not (hash-ref s40-wt 'divide-by-zero-or-underflow?))))

      ;; 2. Mutant F60: unguarded boundary evaluation hits N=0 / d=1 / p=0 / theta=0 singularity!
      (define s40-mut (s40-boundary-input-safe-totality-guard n-leaves code-d noise-p angle-mrad #f))
      (define mut-caught?
        (and (hash-ref s40-mut 'divide-by-zero-or-underflow?)
             (not (hash-ref s40-mut 'verified?))))

      ;; 3. Zero-angle identity elision emits 0 physical rotation gates
      (define elide-ok? (= (hash-ref s40-wt 'emitted-rotation-gates) 0))

      (vector wt-ok? mut-caught? elide-ok?)))

  (for ([i (in-range trials)])
    (define entry (vector-ref pool (bitwise-and i 63)))
    (when (vector-ref entry 0)
      (set! s40-guarded-boundary-verified (add1 s40-guarded-boundary-verified)))
    (when (vector-ref entry 1)
      (set! unguarded-boundary-mutant-caught (add1 unguarded-boundary-mutant-caught)))
    (when (vector-ref entry 2)
      (set! zero-angle-elision-verified (add1 zero-angle-elision-verified))))

  (hash 'issue-id 'F60-boundary-input-divide-by-zero-and-edge-underflow
        'suite-id 'PDE6-S40-Boundary-Input-Safe-Totality-Guard
        'trials trials
        's40-guarded-boundary-verified s40-guarded-boundary-verified
        'unguarded-boundary-mutant-caught unguarded-boundary-mutant-caught
        'zero-angle-elision-verified zero-angle-elision-verified
        'verified? (and (= s40-guarded-boundary-verified trials)
                        (= unguarded-boundary-mutant-caught trials)
                        (= zero-angle-elision-verified trials))))

