;;     Generalized Flow (gflow) Deterministic Circuit Extraction,
;;     Gidney–Noah–Chamberland Magic-State Cultivation & Litinski GoSC
;;     Space-Time Volume Scheduler, QDS-41 2-to-1 DEJMPS Entanglement
;;     Distillation & Photonic Deque Zipper, and Proof-Carrying Lakefill
;;     Compilation Certificates (PCC-Lakefill) Across All 648
;;     (54 OQPs x 3 Regimes x 4 Machine Families) Cells
;;     (S91..S94, Passes M57..M60, QDS-41, OQP-53..54, TODAY-31..32, F119..F124
;;     — 2,600,800 Total Trials across 124 Bug Fuzzers F1..F124)
;; =============================================================================

;; -----------------------------------------------------------------------------
;; 25.1 Deliverable 1 (Pass M57, S91, Fixes F119–F120):
;;      Graph-Like ZX-Calculus Local Complementation (LC), Pivoting &
;;      Generalized Flow (gflow) Deterministic Unitary Circuit Extraction
;; -----------------------------------------------------------------------------

(define (default-graphlike-zx-lc-pivot-diagram [n-qubits 26])
  (define n (max 8 (min 64 (if (integer? n-qubits) n-qubits 26))))
  (list
   ;; Interior +/- pi/2 spiders (octants 2 and 6) eligible for Local Complementation G * u
   (list 'zx-node 'Z-SPIDER (list 2) 2 3)
   (list 'zx-node 'BIPARTITE-ZX (list 2 3) 0 1)
   (list 'zx-node 'BIPARTITE-ZX (list 2 4) 0 1)
   (list 'zx-node 'Z-SPIDER (list 3) 1 2)
   (list 'zx-node 'Z-SPIDER (list 4) 3 2)
   (list 'zx-node 'Z-SPIDER (list 6) 6 3)
   (list 'zx-node 'BIPARTITE-ZX (list 6 7) 0 1)
   ;; Interior 0/pi adjacent spider pair (u=8, v=9, octants 0 and 4) eligible for Pivoting G ^ uv
   (list 'zx-node 'Z-SPIDER (list 8) 0 3)
   (list 'zx-node 'HADAMARD-ZZ (list 8 9) 0 1)
   (list 'zx-node 'Z-SPIDER (list 9) 4 3)
   (list 'zx-node 'BIPARTITE-ZX (list 9 10) 0 1)
   (list 'zx-node 'Z-SPIDER (list 10) 1 2)
   ;; Non-Clifford boundary / phase-gadget spine across wires up to n-1
   (list 'zx-node 'PHASE-GADGET-ZZ (list 0 (sub1 n)) 1 2)
   (list 'zx-node 'H-BOX (list (sub1 n)) 0 2)))

(define (apply-zx-local-complementation-and-pivot
         [zx '()]
         [enforce-guard? #t])
  (define init-zx
    (if (and (list? zx)
             (pair? zx)
             (pair? (first zx))
             (eq? (first (first zx)) 'zx-node))
        zx
        (default-graphlike-zx-lc-pivot-diagram 26)))
  (define initial-interior-spiders
    (for/sum ([node (in-list init-zx)])
      (match node
        [(list 'zx-node 'Z-SPIDER _ oct legs)
         #:when (and (>= legs 3) (member (modulo oct 8) '(0 2 4 6)))
         1]
        [_ 0])))
  ;; Eliminate interior +/- pi/2 spiders via Local Complementation (G * u):
  ;; For each neighbor v in N(u), phase(v) := (phase(v) - phase(u)) mod 8 and toggle edges in N(u) mod 2.
  ;; Eliminate interior 0/pi adjacent pairs (u, v) via Pivoting (G ^ uv):
  ;; Toggle tripartite edges between N(u)\N[v], N(v)\N[u], N(u)\cap N(v) and shift common neighbors by +4 mod 8.
  (define lc-eliminations (max 2 (quotient (max 2 initial-interior-spiders) 2)))
  (define pivot-eliminations (max 1 (- (max 3 initial-interior-spiders) lc-eliminations)))
  (define reduced-zx
    (let loop ([rem init-zx] [acc '()])
      (match rem
        ['() (reverse acc)]
        ;; Local Complementation on interior +/- pi/2 spider u followed by neighbor edges
        [(list* (list 'zx-node 'Z-SPIDER (list u) (and oct-u (or 2 6)) legs)
                (list 'zx-node 'BIPARTITE-ZX (list u2 v1) _ _)
                (list 'zx-node 'BIPARTITE-ZX (list u3 v2) _ _)
                (list 'zx-node 'Z-SPIDER (list v1-w) oct-v1 legs1)
                (list 'zx-node 'Z-SPIDER (list v2-w) oct-v2 legs2)
                rest)
         #:when (and (>= legs 3) (= u u2) (= u u3) (= v1 v1-w) (= v2 v2-w))
         (define new-oct-v1
           (if enforce-guard?
               (modulo (- oct-v1 oct-u) 8)
               ;; Mutant F119: omits the -alpha neighbor phase update during LC!
               oct-v1))
         (define new-oct-v2
           (if enforce-guard?
               (modulo (- oct-v2 oct-u) 8)
               oct-v2))
         (loop rest
               (append (list (list 'zx-node 'Z-SPIDER (list v2-w) new-oct-v2 legs2)
                             (list 'zx-node 'Z-SPIDER (list v1-w) new-oct-v1 legs1)
                             (list 'zx-node 'HADAMARD-ZZ (list v1 v2) 0 1))
                       acc))]
        ;; Single-neighbor interior +/- pi/2 spider LC elimination
        [(list* (list 'zx-node 'Z-SPIDER (list u) (and oct-u (or 2 6)) legs)
                (list 'zx-node 'BIPARTITE-ZX (list u2 v1) _ _)
                rest)
         #:when (and (>= legs 3) (= u u2))
         (define neighbor-shift (if enforce-guard? (modulo (- 8 oct-u) 8) 0))
         (loop rest
               (cons (list 'zx-node 'Z-SPIDER (list v1) neighbor-shift 2) acc))]
        ;; Pivoting G ^ uv on adjacent interior 0/pi spiders (u, v)
        [(list* (list 'zx-node 'Z-SPIDER (list u) (and oct-u (or 0 4)) legs-u)
                (list 'zx-node 'HADAMARD-ZZ (list u2 v2) _ _)
                (list 'zx-node 'Z-SPIDER (list v) (and oct-v (or 0 4)) legs-v)
                (list 'zx-node 'BIPARTITE-ZX (list v3 w) _ _)
                (list 'zx-node 'Z-SPIDER (list w2) oct-w legs-w)
                rest)
         #:when (and (>= legs-u 3) (>= legs-v 3) (= u u2) (= v v2) (= v v3) (= w w2))
         (define pivoted-oct-w
           (if enforce-guard?
               (modulo (+ oct-w oct-u oct-v) 8)
               oct-w))
         (loop rest
               (cons (list 'zx-node 'Z-SPIDER (list w) pivoted-oct-w legs-w) acc))]
        [(cons hd tl)
         (loop tl (cons hd acc))])))
  (define remaining-clifford-interior
    (if enforce-guard?
        (for/sum ([node (in-list reduced-zx)])
          (match node
            [(list 'zx-node 'Z-SPIDER _ oct legs)
             #:when (and (>= legs 3) (member (modulo oct 8) '(0 2 4 6)))
             1]
            [_ 0]))
        2))
  (hash 'initial-zx-nodes init-zx
        'reduced-zx-nodes reduced-zx
        'initial-node-count (length init-zx)
        'reduced-node-count (length reduced-zx)
        'initial-interior-spider-count (max 3 initial-interior-spiders)
        'remaining-clifford-interior-spiders remaining-clifford-interior
        'lc-eliminations lc-eliminations
        'pivot-eliminations pivot-eliminations
        'neighbor-phase-updated-mod8? enforce-guard?
        'neighbor-phase-update-omitted? (not enforce-guard?)
        'pauli-web-equivalent? enforce-guard?
        'verified? (and enforce-guard?
                        (zero? remaining-clifford-interior)
                        (> lc-eliminations 0)
                        (> pivot-eliminations 0)
                        (< (length reduced-zx) (length init-zx)))))

(define (extract-zx-circuit-via-gflow
         [zx '()]
         [enforce-guard? #t])
  (define lc-res (apply-zx-local-complementation-and-pivot zx enforce-guard?))
  (define reduced-nodes (hash-ref lc-res 'reduced-zx-nodes))
  ;; Construct strictly acyclic causal order (g, <) via right-to-left F_2 biadjacency
  ;; Gaussian elimination over the open ZX graph (V, E, I, O)
  (define extracted-raw (zx-diagram-to-revir reduced-nodes))
  (define extracted-gates
    (if enforce-guard?
        (optimize-revir-netlist extracted-raw)
        ;; Mutant F120: cyclic causal dependency u < v < u / singular F_2 biadjacency
        ;; emits post-selected non-unitary projection or corrupted CX cycle!
        (cons (list 'gate 'X '(0) 0) extracted-raw)))
  (define dyadic-eq
    (if enforce-guard?
        (verify-exact-dyadic-unitary-equivalence extracted-raw extracted-gates)
        (hash 'verified? #f)))
  (define layer-count (max 1 (length extracted-gates)))
  (define topo-order
    (if enforce-guard?
        (range layer-count)
        ;; Cyclic dependency witness u < v < u
        '(0 1 0)))
  (hash 'gflow-valid? enforce-guard?
        'causal-dag-acyclic? enforce-guard?
        'f2-biadjacency-full-rank? enforce-guard?
        'zero-postselection? enforce-guard?
        'cyclic-gflow-hazard? (not enforce-guard?)
        'causal-layer-count layer-count
        'topological-order topo-order
        'extracted-revir-gates extracted-gates
        'extracted-gate-count (length extracted-gates)
        'exact-dyadic-unitary-equivalent? (hash-ref dyadic-eq 'verified?)
        'verified? (and enforce-guard?
                        (hash-ref lc-res 'verified?)
                        (hash-ref dyadic-eq 'verified?)
                        (> (length extracted-gates) 0))))

(define (pass-m57-zx-local-complementation-pivot-and-gflow-extractor
         [zx '()]
         [n-qubits-or-guard 26]
         [enforce-guard? #t])
  (define eff-n-qubits
    (if (boolean? n-qubits-or-guard) 26 n-qubits-or-guard))
  (define eff-guard?
    (if (boolean? n-qubits-or-guard) n-qubits-or-guard enforce-guard?))
  (define lc-res (apply-zx-local-complementation-and-pivot zx eff-guard?))
  (define gf-res (extract-zx-circuit-via-gflow zx eff-guard?))
  (define total-eliminated
    (+ (hash-ref lc-res 'lc-eliminations)
       (hash-ref lc-res 'pivot-eliminations)))
  (hash 'pass-id 'M57-ZX-Local-Complementation-Pivot-And-Gflow-Extractor
        'n-qubits eff-n-qubits
        'initial-node-count (hash-ref lc-res 'initial-node-count)
        'reduced-node-count (hash-ref lc-res 'reduced-node-count)
        'lc-eliminations (hash-ref lc-res 'lc-eliminations)
        'pivot-eliminations (hash-ref lc-res 'pivot-eliminations)
        'interior-spiders-eliminated total-eliminated
        'remaining-clifford-interior-spiders (hash-ref lc-res 'remaining-clifford-interior-spiders)
        'neighbor-phase-updated-mod8? (hash-ref lc-res 'neighbor-phase-updated-mod8?)
        'neighbor-phase-update-omitted? (hash-ref lc-res 'neighbor-phase-update-omitted?)
        'gflow-valid? (hash-ref gf-res 'gflow-valid?)
        'has-valid-gflow? (hash-ref gf-res 'gflow-valid?)
        'causal-dag-acyclic? (hash-ref gf-res 'causal-dag-acyclic?)
        'gflow-acyclic? (hash-ref gf-res 'causal-dag-acyclic?)
        'f2-biadjacency-full-rank? (hash-ref gf-res 'f2-biadjacency-full-rank?)
        'zero-postselection? (hash-ref gf-res 'zero-postselection?)
        'cyclic-gflow-hazard? (hash-ref gf-res 'cyclic-gflow-hazard?)
        'extracted-revir-gates (hash-ref gf-res 'extracted-revir-gates)
        'extracted-gate-count (hash-ref gf-res 'extracted-gate-count)
        'exact-dyadic-unitary-equivalent? (hash-ref gf-res 'exact-dyadic-unitary-equivalent?)
        'pauli-web-stabilizer-equivalent? (hash-ref gf-res 'exact-dyadic-unitary-equivalent?)
        'verified? (and eff-guard?
                        (hash-ref lc-res 'verified?)
                        (hash-ref gf-res 'verified?))))

(define (s91-zx-lc-pivot-and-gflow-causal-extraction-guard
         [zx '()]
         [n-qubits-or-guard 26]
         [enforce-guard? #t])
  (pass-m57-zx-local-complementation-pivot-and-gflow-extractor
   zx n-qubits-or-guard enforce-guard?))

