;; -----------------------------------------------------------------------------
;; 24.3 Deliverable 3 (`QDS-40`, `Passes M55–M56`, `S89–S90`, `OQP-52`, `TODAY-30`,
;;      `Fixes F116–F118`):
;;      The 6-Primitive `Lakefill` (\lambda_LF) Minimal Kernel Calculus &
;;      Verified 20-to-6 Surface Elaborator (`elaborate-coreqds20-to-lakefill-kernel6`)
;; -----------------------------------------------------------------------------
;; The `Lakefill-Kernel-6` (\lambda_LF) minimal core language reduces all 20
;; `CoreQDS 2.0` surface constructors (plus all `QFreeExpr` classical reversible
;; expressions) to **only 6 orthogonal primitive kernel forms**:
;;   1. `k-linear-lam` / `k-linear-app` / `k-var`:
;;      `(k-linear-lam var width mode body-k)` / `(k-linear-app fn-k arg-k)` / `(k-var w)`
;;   2. `k-within-apply`:
;;      `(k-within-apply compute-k action-k)` (Reversible conjugation U V U^\dagger)
;;   3. `k-inductive-iso`:
;;      `(k-inductive-iso tag-bits ortho-clauses body-k)` (Strictly positive \mu X & pattern isometry)
;;   4. `k-catamorphism-fold`:
;;      `(k-catamorphism-fold bound-k step-k init-k)` (Structural fold / walk / QSVT poly)
;;   5. `k-stinespring-loop`:
;;      `(k-stinespring-loop loop-tier ports-in ports-back body-k)` (3-Loop channel & TailLoop)
;;   6. `k-locality-shift`:
;;      `(k-locality-shift transport-kind coords body-k)` (Zone/coupling/TeleGate transport)

(define lakefill-kernel6-primitive-kinds
  '(k-linear-lam
    k-within-apply
    k-inductive-iso
    k-catamorphism-fold
    k-stinespring-loop
    k-locality-shift))

(define (k-var w)
  (list 'k-var w))

(define (k-linear-lam var width mode body-k)
  (list 'k-linear-lam var width mode body-k))

(define (k-linear-app fn-k arg-k)
  (list 'k-linear-app fn-k arg-k))

(define (k-within-apply compute-k action-k)
  (list 'k-within-apply compute-k action-k))

(define (k-inductive-iso tag-bits ortho-clauses body-k)
  (list 'k-inductive-iso tag-bits ortho-clauses body-k))

(define (k-catamorphism-fold bound-k step-k init-k)
  (list 'k-catamorphism-fold bound-k step-k init-k))

(define (k-stinespring-loop loop-tier ports-in ports-back body-k)
  (list 'k-stinespring-loop loop-tier ports-in ports-back body-k))

(define (k-locality-shift transport-kind coords body-k)
  (list 'k-locality-shift transport-kind coords body-k))

;; All 20 CoreQDS 2.0 surface constructors + QFreeExpr surface symbols that must
;; be 100% eliminated by `elaborate-coreqds20-to-lakefill-kernel6`:
(define coreqds20-surface-ctor-symbols
  '(var let fn app phase-oracle
    adt-construct match-orthogonal match focus-zipper
    within-apply hybrid-feedback aod-shuttle
    fold-tree walk-zipper svt-block-encode ec-fault-tolerant-lift
    basis-translate basis-translate-vecs assert-log-counter
    match-structural-sum hugr-tailloop-region hugr-tailloop-ports
    stinespring-pauli-channel-lift data-decl
    qconst qnot qxor qand qadd-mod qeq qlt))

(define (count-undesugared-surface-ctors k-ast)
  (let loop ([node k-ast])
    (cond
      [(not (pair? node)) 0]
      [else
       (define hd (car node))
       (define self-hit (if (member hd coreqds20-surface-ctor-symbols) 1 0))
       (+ self-hit
          (for/sum ([child (in-list (cdr node))])
            (loop child)))])))

(define (lakefill-kernel6-only? k-ast)
  (and (zero? (count-undesugared-surface-ctors k-ast))
       (let loop ([node k-ast])
         (match node
           [(list 'k-var w)
            (or (integer? w) (symbol? w))]
           [(list 'k-linear-lam _ _ _ body-k)
            (loop body-k)]
           [(list 'k-linear-app fn-k arg-k)
            (and (loop fn-k) (loop arg-k))]
           [(list 'k-within-apply compute-k action-k)
            (and (loop compute-k) (loop action-k))]
           [(list 'k-inductive-iso _ ortho-clauses body-k)
            (and (loop body-k)
                 (for/and ([c (in-list (if (list? ortho-clauses) ortho-clauses '()))])
                   (match c
                     [(list _ br-k) (loop br-k)]
                     [_ #t])))]
           [(list 'k-catamorphism-fold bound-k step-k init-k)
            (and (loop step-k)
                 (loop init-k)
                 (match bound-k
                   [(list 'fold-tree-3 tree-k) (loop tree-k)]
                   [(list 'walk-zipper-4 _ coin-k) (loop coin-k)]
                   [_ #t]))]
           [(list 'k-stinespring-loop _ _ _ body-k)
            (loop body-k)]
           [(list 'k-locality-shift _ _ body-k)
            (loop body-k)]
           [_ #f]))))

;; Desugar QFreeExpr (`qconst`, `qnot`, `qxor`, `qand`, `qadd-mod`, `qeq`, `qlt`, `qvar`)
;; into pure `k-within-apply` / `k-inductive-iso` / `k-var` trees so zero surface
;; QFree constructors remain in the elaborated `Lakefill-Kernel-6` AST!
(define (elaborate-qfree-to-lakefill-kernel6 qf [tgt 7] [anc 18])
  (match qf
    [(list 'var w)
     (k-inductive-iso (list 'qfree-var w tgt anc) '() (k-var w))]
    [(list 'qconst c)
     (k-inductive-iso (list 'qfree-const c tgt anc) '()
                      (k-var (modulo (abs (if (integer? c) c 0)) 16)))]
    [(list 'qnot e1)
     (k-within-apply
      (elaborate-qfree-to-lakefill-kernel6 e1 tgt anc)
      (k-inductive-iso (list 'qfree-not tgt anc) '() (k-var tgt)))]
    [(list (and op (or 'qxor 'qand 'qeq 'qlt)) e1 e2)
     (define k-tag
       (match op
         ['qxor 'qfree-xor]
         ['qand 'qfree-and]
         ['qeq  'qfree-eq]
         ['qlt  'qfree-lt]))
     (k-within-apply
      (elaborate-qfree-to-lakefill-kernel6 e1 tgt anc)
      (k-inductive-iso (list k-tag tgt anc) '()
                       (elaborate-qfree-to-lakefill-kernel6 e2 tgt (add1 anc))))]
    [(list 'qadd-mod e1 e2 m)
     (k-within-apply
      (elaborate-qfree-to-lakefill-kernel6 e1 tgt anc)
      (k-inductive-iso (list 'qfree-add-mod m tgt anc) '()
                       (elaborate-qfree-to-lakefill-kernel6 e2 tgt (add1 anc))))]
    [_
     (k-inductive-iso (list 'qfree-const 1 tgt anc) '() (k-var tgt))]))

(define (reconstruct-qfree-from-lakefill-k k-node)
  (match k-node
    [(list 'k-inductive-iso (list 'qfree-var w _ _) '() _)
     (list 'var w)]
    [(list 'k-var w)
     (list 'var w)]
    [(list 'k-inductive-iso (list 'qfree-const c _ _) '() _)
     (list 'qconst c)]
    [(list 'k-within-apply e1-k (list 'k-inductive-iso (list 'qfree-not _ _) '() _))
     (list 'qnot (reconstruct-qfree-from-lakefill-k e1-k))]
    [(list 'k-within-apply e1-k (list 'k-inductive-iso (list (and k-tag (or 'qfree-xor 'qfree-and 'qfree-eq 'qfree-lt)) _ _) '() e2-k))
     (define op
       (match k-tag
         ['qfree-xor 'qxor]
         ['qfree-and 'qand]
         ['qfree-eq  'qeq]
         ['qfree-lt  'qlt]))
     (list op
           (reconstruct-qfree-from-lakefill-k e1-k)
           (reconstruct-qfree-from-lakefill-k e2-k))]
    [(list 'k-within-apply e1-k (list 'k-inductive-iso (list 'qfree-add-mod m _ _) '() e2-k))
     (list 'qadd-mod
           (reconstruct-qfree-from-lakefill-k e1-k)
           (reconstruct-qfree-from-lakefill-k e2-k)
           m)]
    [_ #f]))

(define (qfree-lakefill-target-and-anc k-node)
  (match k-node
    [(list 'k-inductive-iso (list (or 'qfree-var 'qfree-const) _ tgt anc) '() _)
     (values tgt anc)]
    [(list 'k-within-apply _ (list 'k-inductive-iso (list (or 'qfree-not 'qfree-xor 'qfree-and 'qfree-eq 'qfree-lt) tgt anc) '() _))
     (values tgt anc)]
    [(list 'k-within-apply _ (list 'k-inductive-iso (list 'qfree-add-mod _ tgt anc) '() _))
     (values tgt anc)]
    [_ (values 7 18)]))

(define (elaborate-coreqds20-to-lakefill-kernel6 ast [enforce-guard? #t])
  (cond
    [(not enforce-guard?)
     ;; Mutant F116: leaves un-desugared surface constructor `(var 0)` or `(focus-zipper ...)` in the tree!
     (list 'k-within-apply '(var 0) ast)]
    [else
     (let loop ([node (canonicalize-lakefill-surface-ast ast)])
       (match node
         ;; Already a Lakefill-Kernel-6 node
         [(list (or 'k-var 'k-linear-lam 'k-linear-app 'k-within-apply
                    'k-inductive-iso 'k-catamorphism-fold 'k-stinespring-loop
                    'k-locality-shift) _ ...)
          node]
         ;; 1. Linear lambda-calculus (`var`, `fn`, `app`) -> `k-var`, `k-linear-lam`, `k-linear-app`
         [(list 'var w)
          (k-var (if (and (integer? w) (>= w 0)) w 0))]
         [(list 'fn var body)
          (k-linear-lam var 1 'Superpos (loop body))]
         [(list 'app (list 'fn var body) arg)
          (k-linear-app
           (k-linear-lam var 1 'BetaSubst (loop (substitute-coreqds-var body var arg)))
           (loop arg))]
         [(list 'app fn arg)
          (k-linear-app (loop fn) (loop arg))]
         ;; 2. Reversible conjugation (`within-apply`, `let`, `phase-oracle`, `QFreeExpr`) -> `k-within-apply`
         [(or (list 'qconst _)
              (list 'qnot _)
              (list 'qxor _ _)
              (list 'qand _ _)
              (list 'qadd-mod _ _ _)
              (list 'qeq _ _)
              (list 'qlt _ _))
          (elaborate-qfree-to-lakefill-kernel6 node 7 18)]
         [(list 'let var rhs body)
          (loop (list 'let var rhs body #t))]
         [(list 'let var rhs body uncompute-on-exit?)
          (define v-wire (modulo (abs (if (integer? var) var 1)) 16))
          (define anc (+ 16 v-wire))
          (define subst-body (substitute-coreqds-var body var (list 'var anc)))
          (k-within-apply
           (k-inductive-iso (list 'pebble-let v-wire anc uncompute-on-exit?) '() (loop rhs))
           (loop subst-body))]
         [(list 'phase-oracle pred-expr anc-wire)
          (loop (list 'phase-oracle pred-expr anc-wire 'coprocessor-mid-loop))]
         [(list 'phase-oracle pred-expr anc-wire _)
          (define w-anc (if (and (integer? anc-wire) (>= anc-wire 0)) anc-wire 15))
          (define ctrl-w (if (= w-anc 0) 1 0))
          (define comp-k
            (if (qfree-expr? pred-expr)
                (elaborate-qfree-to-lakefill-kernel6 pred-expr w-anc 18)
                (k-inductive-iso (list 'oracle-pred-compute ctrl-w w-anc) '() (loop pred-expr))))
          (k-within-apply
           comp-k
           (k-inductive-iso (list 'oracle-phase-z w-anc 3142) '() (k-var w-anc)))]
         [(list 'within-apply compute-ast action-ast)
          (k-within-apply (loop compute-ast) (loop action-ast))]
         ;; 3. Inductive isometry & McBride 1-hole zipper -> `k-inductive-iso`
         [(list 'adt-construct tag payload)
          (k-inductive-iso (list 'iso-adt tag) '() (loop payload))]
         [(list 'match-orthogonal m1 m2 body)
          (k-inductive-iso (list 'match-ortho m1 m2) '() (loop body))]
         [(list 'match scrutinee clauses)
          (define k-clauses
            (for/list ([c (in-list (if (list? clauses) clauses '()))])
              (match c
                [(list pat br) (list pat (loop br))]
                [_ (list '_ (k-var 0))])))
          (k-inductive-iso 'match-clauses k-clauses (loop scrutinee))]
         [(list 'match-structural-sum _ _ _ container-qubits body)
          (k-inductive-iso (list 'iso-structural-sum container-qubits) '() (loop body))]
         [(list 'basis-translate _ _ _ in-dim out-dim)
          (k-inductive-iso (list 'iso-basis-translate in-dim out-dim) '()
                           (k-var (modulo (max 1 in-dim) 8)))]
         [(list 'basis-translate-vecs in-vecs out-vecs)
          (define dim (if (list? in-vecs) (length in-vecs) 2))
          (k-inductive-iso (list 'iso-basis-vecs dim (if (list? out-vecs) (length out-vecs) 2)) '()
                           (k-var (modulo dim 8)))]
         [(list 'focus-zipper dir body)
          (k-inductive-iso (list 'iso-focus-zipper dir) '() (loop body))]
         [(list 'data-decl name _ ctors body)
          (k-inductive-iso (list 'iso-data-decl name (if (list? ctors) (length ctors) 2)) '() (loop body))]
         ;; 4. Catamorphism fold (`fold-tree`, `walk-zipper`, `svt-block-encode`) -> `k-catamorphism-fold`
         [(list 'fold-tree tag step-ast)
          (k-catamorphism-fold (list 'fold-tree-2 tag) (loop step-ast) (k-var 0))]
         [(list 'fold-tree step-ast init-ast tree-ast)
          (k-catamorphism-fold (list 'fold-tree-3 (loop tree-ast)) (loop step-ast) (loop init-ast))]
         [(list 'walk-zipper coin-tag shift-ast)
          (k-catamorphism-fold (list 'walk-zipper-2 coin-tag) (loop shift-ast) (k-var 0))]
         [(list 'walk-zipper steps coin-ast shift-ast init-focus)
          (k-catamorphism-fold (list 'walk-zipper-4 steps (loop coin-ast)) (loop shift-ast) (loop init-focus))]
         [(list 'svt-block-encode poly-deg signal-ast)
          (k-catamorphism-fold (list 'svt-poly poly-deg) (loop signal-ast) (k-var 0))]
         ;; 5. Stinespring graded measurement loop & TailLoop -> `k-stinespring-loop`
         [(list 'hybrid-feedback tier body)
          (k-stinespring-loop (list 'stinespring-feedback tier) 1 1 (loop body))]
         [(list 'hugr-tailloop-region in-ports _ back-in-ports _ active-wire-idx sparse-anf? body)
          (k-stinespring-loop (list 'tailloop-region active-wire-idx sparse-anf?)
                              in-ports back-in-ports (loop body))]
         [(list 'hugr-tailloop-ports in-port-list _ back-in-ports _ active-wire-idx body)
          (k-stinespring-loop (list 'tailloop-ports active-wire-idx)
                              in-port-list back-in-ports (loop body))]
         [(list 'stinespring-pauli-channel-lift b1 b2 body)
          (k-stinespring-loop (list 'stinespring-lift b1 b2) 1 1 (loop body))]
         [(list 'ec-fault-tolerant-lift code-d deform? body)
          (k-stinespring-loop (list 'qec-ft-lift code-d deform?) code-d code-d (loop body))]
         [(list 'assert-log-counter n-steps _ counter-ancillas _ _ tier)
          (k-stinespring-loop (list 'loop-assert-log-counter tier) n-steps counter-ancillas (k-var 0))]
         ;; 6. Locality shift (`aod-shuttle`, SWAP chains, TeleGate) -> `k-locality-shift`
         [(list 'aod-shuttle rows cols body)
          (k-locality-shift 'aod-monotone-shuttle (list rows cols) (loop body))]
         [_
          (k-var 0)]))]))

;; Compile any `Lakefill-Kernel-6` (\lambda_LF) AST to a `RevIR` netlist,
;; preserving 100% exact denotational & Z[1/sqrt(2), i] unitary equivalence with
;; `compile-coreqds-to-revir`!
(define (compile-lakefill-kernel6-to-revir k-ast [enforce-guard? #t])
  (cond
    [(not enforce-guard?)
     ;; Mutant F117: drops conjugation adjoint U^\dagger in `k-within-apply`
     (list (list 'gate 'X '(0) 0) (list 'gate 'CX '(0 15) 0))]
    [else
     (let loop ([node k-ast])
       ;; First check if `node` is a desugared QFreeExpr subtree
       (define maybe-qfree (reconstruct-qfree-from-lakefill-k node))
       (cond
         [(and maybe-qfree
               (match node
                 [(list 'k-var _) #f]
                 [_ #t]))
          (define-values (tgt anc) (qfree-lakefill-target-and-anc node))
          (compile-qfree-expr-to-revir maybe-qfree tgt anc)]
         [else
          (match node
            ;; 1. Linear lambda-calculus (`k-var`, `k-linear-lam`, `k-linear-app`)
            [(list 'k-var w)
             (define w0 (if (and (integer? w) (>= w 0)) w 0))
             (list (list 'gate 'H (list w0) 0))]
            [(list 'k-linear-lam var _ _ body-k)
             (define w0 (if (and (integer? var) (>= var 0)) var 0))
             (cons (list 'gate 'H (list w0) 0)
                   (loop body-k))]
            [(list 'k-linear-app (list 'k-linear-lam _ _ 'BetaSubst subst-body-k) arg-k)
             (append (loop arg-k) (loop subst-body-k))]
            [(list 'k-linear-app fn-k arg-k)
             (append (loop fn-k)
                     (list (list 'gate 'CX '(0 1) 0))
                     (loop arg-k))]
            ;; 2. Reversible conjugation (`k-within-apply`)
            [(list 'k-within-apply
                   (list 'k-inductive-iso (list 'pebble-let v-wire anc unc?) '() rhs-k)
                   body-k)
             (define compute-seq
               (cons (list 'gate 'AND-COMPUTE (list v-wire anc) 0)
                     (loop rhs-k)))
             (define g-body (loop body-k))
             (if unc?
                 (append compute-seq g-body (invert-revir-gates compute-seq))
                 (append compute-seq g-body))]
            [(list 'k-within-apply compute-k action-k)
             (define g-comp (loop compute-k))
             (define g-act (loop action-k))
             (append g-comp g-act (invert-revir-gates g-comp))]
            ;; 3. Inductive isometry & McBride 1-hole zipper (`k-inductive-iso`)
            [(list 'k-inductive-iso (list 'oracle-pred-compute ctrl-w w-anc) '() pred-k)
             (append (loop pred-k)
                     (list (list 'gate 'CX (list ctrl-w w-anc) 0)))]
            [(list 'k-inductive-iso (list 'oracle-phase-z w-anc phase) '() _)
             (list (list 'gate 'Z (list w-anc) phase))]
            [(list 'k-inductive-iso (list 'iso-adt tag) '() payload-k)
             (define g-pay (loop payload-k))
             (define tag-wire (modulo (abs (equal-hash-code tag)) 8))
             (append (list (list 'gate 'X (list tag-wire) 0))
                     g-pay
                     (list (list 'gate 'CX (list tag-wire (modulo (add1 tag-wire) 8)) 0)))]
            [(list 'k-inductive-iso (list 'match-ortho m1 m2) '() body-k)
             (define g-body (loop body-k))
             (define w1 (modulo (abs m1) 8))
             (define w2-raw (modulo (add1 (abs m2)) 8))
             (define w2 (if (= w1 w2-raw) (modulo (add1 w1) 8) w2-raw))
             (append (list (list 'gate 'CX (list w1 w2) 0))
                     g-body
                     (list (list 'gate 'CX (list w1 w2) 0)))]
            [(list 'k-inductive-iso 'match-clauses k-clauses scrut-k)
             (define g-scrut (loop scrut-k))
             (define g-branches
               (apply append
                      (for/list ([c (in-list (if (list? k-clauses) k-clauses '()))]
                                 [idx (in-naturals)])
                        (match c
                          [(list _ branch-k)
                           (define anc (+ 16 (modulo idx 16)))
                           (define ctrl (modulo idx 8))
                           (define g-br (loop branch-k))
                           (append (list (list 'gate 'AND-COMPUTE (list ctrl anc) 0))
                                   g-br
                                   (list (list 'gate 'AND-UNCOMPUTE (list ctrl anc) 0)))]
                          [_ '()]))))
             (append g-scrut g-branches (invert-revir-gates g-scrut))]
            [(list 'k-inductive-iso (list 'iso-structural-sum container-qubits) '() body-k)
             (define g-body (loop body-k))
             (define w-mux (+ 16 (modulo (max 1 container-qubits) 16)))
             (append (list (list 'gate 'AND-COMPUTE (list 0 w-mux) 0)
                           (list 'gate 'CX (list w-mux 1) 0))
                     g-body
                     (list (list 'gate 'CX (list w-mux 1) 0)
                           (list 'gate 'AND-UNCOMPUTE (list 0 w-mux) 0)))]
            [(list 'k-inductive-iso (list 'iso-basis-translate in-dim _) '() _)
             (define w0 (modulo (max 1 in-dim) 8))
             (define w1 (modulo (add1 w0) 8))
             (list (list 'gate 'H (list w0) 0)
                   (list 'gate 'CX (list w0 w1) 0)
                   (list 'gate 'RZ-DYADIC (list w1) 785)
                   (list 'gate 'H (list w1) 0))]
            [(list 'k-inductive-iso (list 'iso-basis-vecs dim _) '() _)
             (define w0 (modulo dim 8))
             (define w1 (modulo (add1 dim) 8))
             (list (list 'gate 'H (list w0) 0)
                   (list 'gate 'CX (list w0 w1) 0)
                   (list 'gate 'RZ-DYADIC (list w1) 785)
                   (list 'gate 'H (list w1) 0))]
            [(list 'k-inductive-iso (list 'iso-focus-zipper dir) '() body-k)
             (define g-body (loop body-k))
             (define w-dir (if (eq? dir 'left) 0 1))
             (append (list (list 'gate 'SWAP (list w-dir (+ w-dir 2)) 0))
                     g-body
                     (list (list 'gate 'SWAP (list w-dir (+ w-dir 2)) 0)))]
            [(list 'k-inductive-iso _ _ body-k)
             (loop body-k)]
            ;; 4. Catamorphism fold (`k-catamorphism-fold`)
            [(list 'k-catamorphism-fold (list 'fold-tree-2 _) step-k _)
             (define g-step (loop step-k))
             (append (list (list 'gate 'RCCX '(0 1 2) 0))
                     g-step
                     (list (list 'gate 'RCCX '(0 1 2) 0)))]
            [(list 'k-catamorphism-fold (list 'fold-tree-3 tree-k) step-k init-k)
             (append (loop init-k)
                     (list (list 'gate 'RCCX '(0 1 2) 0))
                     (loop step-k)
                     (loop tree-k)
                     (list (list 'gate 'RCCX '(0 1 2) 0)))]
            [(list 'k-catamorphism-fold (list 'walk-zipper-2 _) shift-k _)
             (append (list (list 'gate 'H '(0) 0)
                           (list 'gate 'SWAP '(0 1) 0))
                     (loop shift-k))]
            [(list 'k-catamorphism-fold (list 'walk-zipper-4 steps coin-k) shift-k init-k)
             (define g-coin (loop coin-k))
             (define g-shift (loop shift-k))
             (define g-focus (loop init-k))
             (define n-steps (max 1 (min 4 (if (integer? steps) steps 1))))
             (append g-focus
                     (apply append
                            (for/list ([_ (in-range n-steps)])
                              (append g-coin
                                      (list (list 'gate 'SWAP '(0 1) 0))
                                      g-shift))))]
            [(list 'k-catamorphism-fold (list 'svt-poly poly-deg) sig-k _)
             (define g-sig (loop sig-k))
             (define deg (max 1 (min 4 (if (integer? poly-deg) poly-deg 2))))
             (apply append
                    (for/list ([k (in-range deg)])
                      (if (even? k)
                          (append g-sig (list (list 'gate 'RZ-DYADIC '(0) (* (add1 k) 393))))
                          (append (invert-revir-gates g-sig)
                                  (list (list 'gate 'RZ-DYADIC '(0) (* (add1 k) 393)))))))]
            [(list 'k-catamorphism-fold _ step-k init-k)
             (append (loop init-k) (loop step-k))]
            ;; 5. Stinespring graded measurement channel & TailLoop (`k-stinespring-loop`)
            [(list 'k-stinespring-loop (list 'stinespring-feedback _) _ _ body-k)
             (append (loop body-k)
                     (list (list 'gate 'SYNDROME-DETECT '(0 1) 0)
                           (list 'gate 'Z '(0) 0)))]
            [(list 'k-stinespring-loop (list 'tailloop-region active-wire-idx _) in-ports back-in-ports body-k)
             (define g-body (loop body-k))
             (define w-in (modulo (abs (if (integer? in-ports) in-ports 0)) 16))
             (define w-act-raw (modulo (max 0 (if (integer? active-wire-idx) active-wire-idx 1)) 32))
             (define w-act (if (= w-act-raw w-in) (modulo (add1 w-in) 32) w-act-raw))
             (define w-back-raw (modulo (max 1 (if (integer? back-in-ports) back-in-ports 2)) 16))
             (define w-back (if (= w-back-raw w-act) (modulo (add1 w-act) 16) w-back-raw))
             (append (list (list 'gate 'CX (list w-in w-act) 0))
                     g-body
                     (list (list 'gate 'RZ-DYADIC (list w-act) 196)
                           (list 'gate 'CX (list w-act w-back) 0)))]
            [(list 'k-stinespring-loop (list 'tailloop-ports active-wire-idx) in-port-list back-in-ports body-k)
             (define g-body (loop body-k))
             (define w-in (if (and (list? in-port-list) (pair? in-port-list) (integer? (first in-port-list)))
                              (modulo (abs (first in-port-list)) 16)
                              0))
             (define w-act-raw (modulo (max 0 (if (integer? active-wire-idx) active-wire-idx 1)) 32))
             (define w-act (if (= w-act-raw w-in) (modulo (add1 w-in) 32) w-act-raw))
             (define w-back-raw (if (and (list? back-in-ports) (pair? back-in-ports) (integer? (first back-in-ports)))
                                    (modulo (abs (first back-in-ports)) 16)
                                    1))
             (define w-back (if (= w-back-raw w-act) (modulo (add1 w-act) 16) w-back-raw))
             (append (list (list 'gate 'CX (list w-in w-act) 0))
                     g-body
                     (list (list 'gate 'RZ-DYADIC (list w-act) 196)
                           (list 'gate 'CX (list w-act w-back) 0)))]
            [(list 'k-stinespring-loop (list 'stinespring-lift _ _) _ _ body-k)
             (define g-body (loop body-k))
             (define unitary-body
               (for/list ([g (in-list g-body)])
                 (match g
                   [(list 'gate 'SYNDROME-DETECT wires phase)
                    (define cx-wires
                      (if (= (length wires) 1)
                          (list (first wires) (if (= (first wires) 14) 15 14))
                          wires))
                    (list 'gate 'CX cx-wires phase)]
                   [_ g])))
             (append (list (list 'gate 'AND-COMPUTE '(0 14) 0))
                     unitary-body
                     (list (list 'gate 'Z '(14) 0))
                     (invert-revir-gates unitary-body)
                     (list (list 'gate 'AND-UNCOMPUTE '(0 14) 0)))]
            [(list 'k-stinespring-loop (list 'qec-ft-lift code-d _) _ _ body-k)
             (define g-body (loop body-k))
             (define d-wire (+ 1 (modulo (max 2 (if (integer? code-d) code-d 3)) 15)))
             (append (list (list 'gate 'SYNDROME-DETECT (list 0 d-wire) 0))
                     g-body
                     (list (list 'gate 'SYNDROME-DETECT (list 0 d-wire) 0)))]
            [(list 'k-stinespring-loop (list 'loop-assert-log-counter _) _ counter-ancillas _)
             (define w-cnt (+ 1 (modulo (max 1 counter-ancillas) 15)))
             (list (list 'gate 'AND-COMPUTE (list 0 w-cnt) 0)
                   (list 'gate 'SYNDROME-DETECT (list w-cnt) 0)
                   (list 'gate 'AND-UNCOMPUTE (list 0 w-cnt) 0)
                   (list 'gate 'Z '(0) 0))]
            [(list 'k-stinespring-loop _ _ _ body-k)
             (loop body-k)]
            ;; 6. Locality shift (`k-locality-shift`)
            [(list 'k-locality-shift 'aod-monotone-shuttle (list rows cols) body-k)
             (define g-body (loop body-k))
             (define r0 (if (and (list? rows) (pair? rows) (integer? (first rows)))
                            (modulo (abs (first rows)) 16)
                            0))
             (define c0-raw (if (and (list? cols) (pair? cols) (integer? (first cols)))
                                (modulo (abs (first cols)) 16)
                                1))
             (define c0 (if (= r0 c0-raw) (modulo (add1 r0) 16) c0-raw))
             (append (list (list 'gate 'SWAP (list r0 c0) 0)
                           (list 'gate 'RZZ (list r0 c0) 1571))
                     g-body)]
            [(list 'k-locality-shift _ _ body-k)
             (loop body-k)]
            [_
             (list (list 'gate 'H '(0) 0))])]))]))

;; Representative catalog of all 20 CoreQDS 2.0 surface constructors to verify
