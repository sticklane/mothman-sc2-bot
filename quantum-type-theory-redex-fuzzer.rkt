(define (qds40-lakefill-six-primitive-minimal-kernel-zipper
         [ast #f]
         [enforce-guard? #t])
  (define eff-ast (or ast (oqp-coreqds-ast 52)))
  (define k-ast (elaborate-coreqds20-to-lakefill-kernel6 eff-ast enforce-guard?))
  (define kernel-only? (lakefill-kernel6-only? k-ast))
  (define undesugared-count (count-undesugared-surface-ctors k-ast))
  (define surf-gates (compile-coreqds-to-revir eff-ast))
  (define kern-gates (compile-lakefill-kernel6-to-revir k-ast enforce-guard?))
  (define dyadic-eq (verify-exact-dyadic-unitary-equivalence surf-gates kern-gates))
  (hash 'qds-id 'QDS-40-Lakefill-Six-Primitive-Minimal-Kernel-Zipper
        'kernel-primitive-count (length lakefill-kernel6-primitive-kinds)
        'kernel-primitives lakefill-kernel6-primitive-kinds
        'surface-ast eff-ast
        'kernel6-ast k-ast
        'lakefill-kernel6-only? kernel-only?
        'undesugared-surface-ctor-count undesugared-count
        'surface-gate-count (length surf-gates)
        'kernel6-gate-count (length kern-gates)
        'exact-dyadic-unitary-equivalent? (hash-ref dyadic-eq 'verified?)
        'verified? (and enforce-guard?
                        kernel-only?
                        (zero? undesugared-count)
                        (= (length lakefill-kernel6-primitive-kinds) 6)
                        (hash-ref dyadic-eq 'verified?))))

(define (pass-m55-lakefill-20-to-6-minimal-kernel-elaborator
         [ast #f]
         [enforce-guard? #t])
  (define reps (all-20-coreqds-surface-constructor-representatives))
  (define eff-ast (or ast (oqp-coreqds-ast 52)))
  (define k-ast (elaborate-coreqds20-to-lakefill-kernel6 eff-ast enforce-guard?))
  (define all-20-elaborated-ok?
    (and (= (length reps) 20)
         (for/and ([r (in-list reps)])
           (define kr (elaborate-coreqds20-to-lakefill-kernel6 r enforce-guard?))
           (and (lakefill-kernel6-only? kr)
                (zero? (count-undesugared-surface-ctors kr))))))
  (hash 'pass-id 'M55-Lakefill-20-To-6-Minimal-Kernel-Elaborator
        'surface-ctor-count 20
        'kernel-primitive-count 6
        'kernel-primitives lakefill-kernel6-primitive-kinds
        'kernel6-ast k-ast
        'lakefill-kernel6-only? (lakefill-kernel6-only? k-ast)
        'undesugared-surface-ctor-count (count-undesugared-surface-ctors k-ast)
        'all-20-surface-ctors-desugared? all-20-elaborated-ok?
        'verified? (and enforce-guard?
                        (lakefill-kernel6-only? k-ast)
                        (zero? (count-undesugared-surface-ctors k-ast))
                        all-20-elaborated-ok?)))

(define (s89-lakefill-six-primitive-kernel-completeness-guard
         [ast #f]
         [enforce-guard? #t])
