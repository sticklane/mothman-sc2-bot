(define (fuzz-find-f51-litinski-pbc-qroam-weight-explosion-pass-m11 [trials 25000])
  (define m11-hybrid-qroam-pbc-verified 0)
  (define unbounded-pbc-weight-explosion-caught 0)
  (define qds17-oqp15-and-today9-verified 0)

  (define pool
    (for/vector ([idx (in-range 64)])
      (define addr-bits (+ 6 (bitwise-and idx 3)))
      (define raw-pbc-depth (+ 5 (bitwise-and idx 7)))

      ;; 1. Pass M11 & S31 cap PBC commutation depth at k = 3 -> weight <= 4
      (define m11-wt (pass-m11-hybrid-qroam-pbc-lower addr-bits raw-pbc-depth #t))
      (define s31-wt (s31-qroam-pbc-commutation-cutoff addr-bits raw-pbc-depth 3))
      (define m11-ok?
        (and (hash-ref m11-wt 'verified?)
             (<= (hash-ref m11-wt 'pauli-rotation-weight) 4)
             (hash-ref s31-wt 'verified?)))

      ;; 2. Mutant F51: unguarded Litinski PBC commutes through full QROAM tree -> weight = 2^addr-bits >= 64!
      (define m11-mut (pass-m11-hybrid-qroam-pbc-lower addr-bits raw-pbc-depth #f))
      (define mut-caught?
        (and (not (hash-ref m11-mut 'verified?))
             (>= (hash-ref m11-mut 'pauli-rotation-weight) 64)))

      ;; 3. QDS-17 Bootstrapped Skew Binomial Heap, S34, OQP-15 & TODAY-9 (16q Branch-and-Bound)
      (define rank (+ 2 (bitwise-and idx 3)))
      (define wt-heap (s34-skew-binomial-heap-2toffoli-insert rank))
      (define mut-heap (bootstrapped-skew-binomial-heap rank (+ rank 3) #f 'skew-bootstrapped))
      (define today9 (QuantumBranchAndBound_MaxSat_16q 4))
      (define heap-ok?
        (and (hash-ref wt-heap 'constant-2toffoli-coherent?)
             (= (hash-ref wt-heap 'worst-case-insert-toffolis) 2)
             (not (hash-ref mut-heap 'constant-2toffoli-coherent?))
             (hash-ref today9 'verified?)
             (= (hash-ref today9 'logical-qubits) 16)))

      (vector m11-ok? mut-caught? heap-ok?)))

  (for ([i (in-range trials)])
    (define entry (vector-ref pool (bitwise-and i 63)))
    (when (vector-ref entry 0)
      (set! m11-hybrid-qroam-pbc-verified (add1 m11-hybrid-qroam-pbc-verified)))
    (when (vector-ref entry 1)
      (set! unbounded-pbc-weight-explosion-caught (add1 unbounded-pbc-weight-explosion-caught)))
    (when (vector-ref entry 2)
      (set! qds17-oqp15-and-today9-verified (add1 qds17-oqp15-and-today9-verified))))

  (hash 'issue-id 'F51-litinski-pbc-qroam-weight-explosion-pass-m11
        'suite-id 'S31-S34-PassM11-QDS17-OQP15-OQP18-TODAY9
        'trials trials
        'm11-hybrid-qroam-pbc-verified m11-hybrid-qroam-pbc-verified
        'unbounded-pbc-weight-explosion-caught unbounded-pbc-weight-explosion-caught
        'qds17-oqp15-and-today9-verified qds17-oqp15-and-today9-verified
        'today9-logical-qubits 16
        'max-bounded-pauli-weight 4
        'verified? (and (= m11-hybrid-qroam-pbc-verified trials)
                        (= unbounded-pbc-weight-explosion-caught trials)
                        (= qds17-oqp15-and-today9-verified trials))))

