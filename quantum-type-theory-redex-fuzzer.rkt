               (hash-ref qasm3-res 'verified?))
      (set! e2e-pipeline-verified (add1 e2e-pipeline-verified)))

    ;; 2. Mutant F90: unbalanced AND-COMPUTE without AND-UNCOMPUTE in compiled netlist is caught!
    (define imbalanced-gates
      (cons (list 'gate 'AND-COMPUTE '(0 15) 0) revir-gates))
    (define mut-check (verify-compiled-revir-netlist imbalanced-gates))
    (when (and (not (hash-ref mut-check 'balanced-ancilla-uncompute?))
               (not (hash-ref mut-check 'verified?)))
      (set! unbalanced-ancilla-mutant-caught (add1 unbalanced-ancilla-mutant-caught)))

    ;; 3. OQP-42 & TODAY-22 (18q) verification
    (define oqp42 (oqp42-tket-lexicographic-routing-and-e2e-qasm3-pipeline #t))
    (when (and today22-ok? (hash-ref oqp42 'verified?))
      (set! oqp42-and-today22-verified (add1 oqp42-and-today22-verified))))

  (hash 'issue-id 'F90-end-to-end-coreqds-revir-hugr-qasm3-pipeline-and-oqp42-audit
        'suite-id 'S70-PassM38-OQP42-TODAY22-E2E-CoreQDS-RevIR-HUGR-QASM3
        'trials trials
        'e2e-pipeline-verified e2e-pipeline-verified
        'unbalanced-ancilla-mutant-caught unbalanced-ancilla-mutant-caught
        'oqp42-and-today22-verified oqp42-and-today22-verified
        'today22-physical-qubits 18
        'verified? (and (= e2e-pipeline-verified trials)
                        (= unbalanced-ancilla-mutant-caught trials)
                        (= oqp42-and-today22-verified trials))))

