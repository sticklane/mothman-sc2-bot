(define (oqp47-exact-dyadic-tpar-phase-poly-and-sabre-routed-qsvt [enforce-guard? #t])
  (define ast
    (list 'let 1
          (qxor (qand '(var 1) '(var 2))
                (qeq '(var 3) '(var 4)))
          (list 'within-apply
                (svt-block-encode 3
                  (focus-zipper 'left
                    (adt-construct 'OQP47-TparSabre '(var 7))))
                (phase-oracle
                  (qxor '(var 1) (qand '(var 5) '(var 6)))
                  12
                  'coprocessor-mid-loop))
          enforce-guard?))
  (define raw-gates (compile-coreqds-to-revir ast))
  (define tpar-gates
    (if enforce-guard?
        (optimize-phase-polynomial-tpar-and-gf2-cnot raw-gates)
        raw-gates))
  (define routed-gates
    (if enforce-guard?
        (route-revir-on-coupling-graph tpar-gates 'Heron-R2-156q)
