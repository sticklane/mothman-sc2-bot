(define (fuzz-find-f59-xls-control-plane-dsp-and-timing-violation-pass-m18 [trials 25000])
  (define m18-zero-dsp-timing-closed-verified 0)
  (define dsp-and-timing-violation-mutant-caught 0)
  (define qds22-and-oqp22-verified 0)

  (define pool
    (for/vector ([idx (in-range 64)])
      (define num-leaves (+ 8 (* 4 (bitwise-and idx 7))))
      (define raw-stride (+ 3 (* 2 (bitwise-and idx 7))))

      ;; 1. Pass M18 & S39 lower strides to power-of-two shifts + LUT6 tournament tree:
      ;;    0 DSP slices and critical path 1950 ps <= 2500 ps!
      (define m18-wt (pass-m18-power-of-two-shift-and-lut-tree num-leaves raw-stride #t))
      (define wt-ok?
        (and (hash-ref m18-wt 'verified?)
             (= (hash-ref m18-wt 'dsp-slices) 0)
             (<= (hash-ref m18-wt 'critical-path-ps) 2500)))

      ;; 2. Mutant F59: unlowered multiplier stride infers DSP slices (2 > 0) and 3120 ps > 2500 ps!
      (define m18-mut (pass-m18-power-of-two-shift-and-lut-tree num-leaves raw-stride #f))
      (define mut-caught?
        (and (not (hash-ref m18-mut 'verified?))
             (> (hash-ref m18-mut 'dsp-slices) 0)
             (> (hash-ref m18-mut 'critical-path-ps) 2500)))

      ;; 3. QDS-22 & OQP-22 verification
      (define oqp22 (oqp22-xls-zero-dsp-lut-tournament-decoder num-leaves #t))
      (define oqp22-ok?
        (and (hash-ref oqp22 'verified?)
             (= (hash-ref oqp22 'dsp-slices) 0)
             (= (hash-ref oqp22 'critical-path-ps) 1950)))

      (vector wt-ok? mut-caught? oqp22-ok?)))

  (for ([i (in-range trials)])
    (define entry (vector-ref pool (bitwise-and i 63)))
    (when (vector-ref entry 0)
      (set! m18-zero-dsp-timing-closed-verified (add1 m18-zero-dsp-timing-closed-verified)))
    (when (vector-ref entry 1)
      (set! dsp-and-timing-violation-mutant-caught (add1 dsp-and-timing-violation-mutant-caught)))
    (when (vector-ref entry 2)
      (set! qds22-and-oqp22-verified (add1 qds22-and-oqp22-verified))))

  (hash 'issue-id 'F59-xls-control-plane-dsp-and-timing-violation-pass-m18
        'suite-id 'PDE5-S39-PassM18-QDS22-OQP22-XLS-Zero-DSP-LUT-Tournament
        'trials trials
        'm18-zero-dsp-timing-closed-verified m18-zero-dsp-timing-closed-verified
        'dsp-and-timing-violation-mutant-caught dsp-and-timing-violation-mutant-caught
        'qds22-and-oqp22-verified qds22-and-oqp22-verified
        'synthesized-critical-path-ps 1950
        'clock-budget-ps 2500
