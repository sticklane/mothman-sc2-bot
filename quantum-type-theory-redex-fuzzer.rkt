      (append (compile-coreqds-to-revir (oqp-coreqds-ast (add1 idx)))
              (default-48q-zx-test-revir-circuit 48)))
    (define m53-wt (pass-m53-zx-calculus-spider-hopf-and-pauli-web-n-gt-20-verifier base-gates 48 #t))
