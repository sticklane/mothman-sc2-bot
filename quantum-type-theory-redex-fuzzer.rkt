        (hardware-gate-duration-ns g machine))))

(define (asap-parallel-critical-path-ns gates [machine 'SuperconductingPlanar] [enforce-guard? #t])
  (cond
    [(or (not (list? gates)) (null? gates)) 0]
    [(not enforce-guard?)
     ;; Mutant F130: conflates parallel critical path with serial sum + artificial stall inflation
     (+ (serial-gate-sum-ns gates machine) 20)]
    [else
     (define avail (make-hash))
     (for ([g (in-list gates)])
       (define ws (gate-touched-wires g))
       (define eff-ws (if (null? ws) '(0) ws))
       (define dur (hardware-gate-duration-ns g machine))
       (define start-ns
         (apply max (for/list ([q (in-list eff-ws)]) (hash-ref avail q 0))))
       (define finish-ns (+ start-ns dur))
       (for ([q (in-list eff-ws)])
         (hash-set! avail q finish-ns)))
     (if (zero? (hash-count avail))
         0
         (apply max (hash-values avail)))]))

(define (idle-window-duration-ns [modality 'SuperconductingPlanar])
  (match modality
    [(or 'SuperconductingPlanar 'Planar 'Willow-105q 'Heron-R2-156q) 1240]
    [(or 'TrappedIonQCCD 'QCCD 'Quantinuum-H2-56q) 150000]
    [(or 'NeutralAtomZonedAOD 'AOD 'Bluvstein-NeutralAtom) 500000]
    [(or 'PhotonicTeleGateHerald 'TeleGate 'MultiMachineDistributed) 1500]
