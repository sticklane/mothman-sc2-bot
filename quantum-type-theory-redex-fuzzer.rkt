;; 25.2 Deliverable 2 (Pass M58, S92, OQP-53, TODAY-31, Fix F121):
;;      Gidney–Noah–Chamberland Magic-State Cultivation & Litinski Game-of-Surface-Codes
;;      (GoSC) Space-Time Volume Scheduler
;; -----------------------------------------------------------------------------

(define (schedule-magic-state-cultivation-and-gosc-volume
         [gates '()]
         [regime 'MultiShotSingleMachine]
         [mtype 'Superconducting2DGrid]
         [enforce-guard? #t])
  (define eff-gates
    (if (and (list? gates) (pair? gates))
        gates
        (compile-coreqds-to-revir (oqp-coreqds-ast 53))))
  (define compute-and-count
    (if (and (integer? gates) (> gates 0))
        (max 2 (quotient (+ gates 3) 4))
        (max 2
             (for/sum ([g (in-list eff-gates)])
               (match g
                 [(list 'gate (or 'AND-COMPUTE 'CCX 'RCCX) _ _) 1]
                 [_ 0])))))
  ;; In OneShotSingleMachine, each Toffoli/AND pair uses 4T (compute) + 4T (unitary uncompute) = 8T.
  ;; In MultiShotSingleMachine, Gidney MBU replaces unitary uncompute with 0T measurement + conditional CZ,
  ;; consuming 4T (compute) + 0T (uncompute) = 4T (exact 50% reduction in T-count and cultivation volume!).
  (define oneshot-t-count (* 8 compute-and-count))
  (define multishot-t-count (* 4 compute-and-count))
  (define t-gates-consumed
    (if (eq? regime 'OneShotSingleMachine)
        oneshot-t-count
        multishot-t-count))
  ;; Gidney-Noah-Chamberland (arXiv:2409.17595) magic-state cultivation parameters:
  ;; Cultivation patch footprint ~ 420 physical qubits per factory (vs 4,600 for 15-to-1 distillation)
  ;; and 18 surface/color-code cultivation rounds per cultivated |T> state.
  (define cultivation-qubits-per-factory
    (match mtype
      ['Superconducting2DGrid 420]
      ['TrappedIonQCCD 360]
      ['NeutralAtomZoned 380]
      ['PhotonicFusion 400]
      [_ 420]))
  (define distillation-15to1-qubits-per-factory 4600)
  (define cultivation-factory-count 2)
  (define cultivation-rounds-per-t 18)
  (define oneshot-cultivation-volume
    (* oneshot-t-count cultivation-qubits-per-factory cultivation-rounds-per-t))
  (define multishot-cultivation-volume
    (* multishot-t-count cultivation-qubits-per-factory cultivation-rounds-per-t))
  (define cultivation-qubit-cycles
    (if (eq? regime 'OneShotSingleMachine)
        oneshot-cultivation-volume
        multishot-cultivation-volume))
  ;; Idling wait cycles inserted when T consumption bursts exceed cultivation factory supply
  (define idling-wait-cycles
    (if enforce-guard?
        (* (quotient t-gates-consumed cultivation-factory-count) 3)
        0))
  (define unbuffered-deficit
    (if enforce-guard?
        0
        (max 4 (- t-gates-consumed cultivation-factory-count))))
  (define routing-bus-qubit-cycles (* 120 (+ t-gates-consumed idling-wait-cycles)))
  (define total-spacetime-qubit-cycles
    (+ cultivation-qubit-cycles routing-bus-qubit-cycles))
  (define distillation-15to1-spacetime-volume
    (* t-gates-consumed distillation-15to1-qubits-per-factory 36))
  (define multishot-50pct-reduction?
    (= (* 2 multishot-cultivation-volume) oneshot-cultivation-volume))
  (define vol-reduction-ratio
    (exact->inexact (/ distillation-15to1-spacetime-volume
                       (max 1 total-spacetime-qubit-cycles))))
  (define cultivated-log-err
    (if enforce-guard? 2.0e-13 5.0e-6))
  (hash 'regime regime
        'machine-family mtype
        'logical-toffoli-pairs compute-and-count
        'oneshot-t-count oneshot-t-count
        'multishot-t-count multishot-t-count
        't-gates-consumed t-gates-consumed
        'cultivation-factory-count cultivation-factory-count
        'cultivation-qubits-per-factory cultivation-qubits-per-factory
        'distillation-15to1-qubits-per-factory distillation-15to1-qubits-per-factory
        'cultivation-rounds-per-t cultivation-rounds-per-t
        'idling-wait-cycles idling-wait-cycles
        'oneshot-cultivation-volume oneshot-cultivation-volume
        'multishot-cultivation-volume multishot-cultivation-volume
        'cultivation-qubit-cycles cultivation-qubit-cycles
        'total-spacetime-qubit-cycles total-spacetime-qubit-cycles
        'cultivation-spacetime-volume total-spacetime-qubit-cycles
        'distillation-15to1-spacetime-volume distillation-15to1-spacetime-volume
        'volume-reduction-ratio vol-reduction-ratio
        'cultivated-logical-error cultivated-log-err
        'multishot-50pct-cultivation-reduction? multishot-50pct-reduction?
        'cultivation-beats-15to1-distillation? (< total-spacetime-qubit-cycles distillation-15to1-spacetime-volume)
        'factory-starvation-hazard? (not enforce-guard?)
        'unbuffered-magic-state-deficit unbuffered-deficit
        'verified? (and enforce-guard?
                        (zero? unbuffered-deficit)
                        multishot-50pct-reduction?
                        (< total-spacetime-qubit-cycles distillation-15to1-spacetime-volume))))

