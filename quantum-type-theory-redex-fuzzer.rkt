(define (uwire-mode uw) (second uw))
(define (uwire-anf  uw) (third uw))
(define (uwire-zone uw) (fourth uw))

(define (wire-in-catlinks? w links)
  (for/or ([lk (in-list links)])
    (or (= (first lk) w) (= (second lk) w))))

;; Synthesize-Unified-Grade (Simplifications S1, S2, S3):
;; Single composable quantitative grade monoid over (uwire BasisMode ANFPoly HardwareZone)
;; and live distributed cat-links L_live.
(define (Synthesize-Unified-Grade c init-anfs init-zones)
  (define init-uwires
    (map (lambda (a z) `(uwire QFree ,(anf-normalize a) ,z))
         init-anfs init-zones))

  (define (step-gate g uwires links)
    (match g
      [`(g-id)
       (values 0 0 0 links uwires #t)]
      [`(g-x ,w)
       (match-define `(uwire ,m ,a ,z) (list-ref uwires w))
       (define ok? (and (eq? m 'QFree) (not (wire-in-catlinks? w links))))
