         [(eq? m 'QFree)
          (values 0 1 0 links (list-set uwires w `(uwire Superpos ,a ,z)) #t)]
         [else
          ;; Exiting Superpos via second H: H * Z^(dz) * H = X^(dz)
          (define dz? (poly-has-mono? a (xphase-mono w)))
          (define a-clean
            (if dz?
                (anf-xor (anf-xor a (list (xphase-mono w))) '(()))
                a))
          (values 0 1 0 links (list-set uwires w `(uwire QFree ,a-clean ,z)) #t)])]
      [`(g-cnot ,c ,t)
       (match-define `(uwire ,mc ,ac ,zc) (list-ref uwires c))
       (match-define `(uwire ,mt ,at ,zt) (list-ref uwires t))
