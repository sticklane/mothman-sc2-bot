(define (fuzz-find-f75-qcm-superposed-join-non-injective-history-leak-pass-m29 [trials 25000])
  (define m29-qcm-injective-join-verified 0)
  (define non-injective-history-leak-mutant-caught 0)
  (define s55-zero-garbage-guard-verified 0)

  (for ([i (in-range trials)])
    (define h (bitwise-and (+ (* i 2654435761) 264575131) #x7fffffff))
    (define num-join-keys (+ 2 (bitwise-and h 127)))

    ;; 1. Well-typed Pass M29 enforces injective join predicate and uncomputes all history ancillas!
    (define m29-wt (pass-m29-qcm-injective-join-uncomputer num-join-keys #f #t #t))
    (define s55-wt (s55-qcm-injective-join-predicate-zero-garbage-guard num-join-keys #t #f #t))
    (when (and (hash-ref m29-wt 'verified?)
               (hash-ref m29-wt 'injective-join-predicate?)
               (not (hash-ref m29-wt 'landauer-history-tape?))
               (zero? (hash-ref m29-wt 'residual-garbage-ancillas))
               (not (hash-ref m29-wt 'non-injective-history-leak?))
               (hash-ref s55-wt 'verified?))
      (set! m29-qcm-injective-join-verified (add1 m29-qcm-injective-join-verified)))

    ;; 2. Mutant F75: non-injective join predicate or un-erased Landauer history tape leaks garbage!
    (define m29-mut (pass-m29-qcm-injective-join-uncomputer num-join-keys #f #t #f))
    (when (and (hash-ref m29-mut 'non-injective-history-leak?)
               (> (hash-ref m29-mut 'residual-garbage-ancillas) 0)
               (not (hash-ref m29-mut 'verified?))
               (not (check-f75-qcm-injective-join-predicate-safe? #f #t num-join-keys))
               (not (check-f75-qcm-injective-join-predicate-safe? #t #t 0)))
      (set! non-injective-history-leak-mutant-caught (add1 non-injective-history-leak-mutant-caught)))

    ;; 3. Direct predicate verification
    (when (check-f75-qcm-injective-join-predicate-safe? #t #f 0)
      (set! s55-zero-garbage-guard-verified (add1 s55-zero-garbage-guard-verified))))

  (hash 'issue-id 'F75-qcm-superposed-join-non-injective-history-leak-pass-m29
        'suite-id 'S55-PassM29-QCM-Injective-Join-Uncomputer
        'trials trials
