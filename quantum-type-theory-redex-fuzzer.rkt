;; -----------------------------------------------------------------------------
;; Phase 12 Simplification Rules S25..S28 & Compiler Passes M9..M10:
;; - S25 (`s25-qunity-orthogonal-projector-collapse`):
;;   Collapses a Qunity orthogonal case-split followed by its inverse case-merge
;;   into identity when projectors are disjoint, exhaustive, and ancilla-clean.
;; - S26 (`s26-rccx-affine-phase-commutation-guard`):
;;   Blocks unsound commutation of diagonal `Z`/`RZ` phase gates across the target
;;   wire `t` of a relative-phase `(g-rccx c1 c2 t)` unless `RCCX` is paired in a
;;   clean `with-uncompute` bracket or promoted to full-phase `CCX` (`Issue F46a`).
;; - S27 (`s27-realtime-queue-constant-tick-invariant`):
;;   Rewrites an amortized queue step in superposition into a 2-tick scheduled
;;   `realtime-quantum-queue` step (`Issue F47a`).
;; - S28 (`s28-egraph-acyclic-rank-reduction`):
;;   Prunes non-decreasing or self-inverse e-graph rewrite edges (`Issue F47b`).
;; - Pass M9 (`pass-m9-chromatic-transversal-schedule`):
;;   Edge-colors a set of transversal 2Q coupler edges into conflict-free matching
;;   rounds where each round has maximum vertex degree `<= 1` (`Issue F48`).
;; - Pass M10 (`pass-m10-catalyst-phase-tower-coalesce`):
;;   Coalesces `K` sequential phase-gradient catalyst rotations into a single
;;   modular addition step with zero catalyst phase drift (`Issue F46b`).
;; -----------------------------------------------------------------------------
(define (s25-qunity-orthogonal-projector-collapse focus-mask complement-mask domain-mask [branch-ancilla-residual 0])
  (define oz (orthogonal-case-zipper focus-mask complement-mask domain-mask branch-ancilla-residual))
  (if (hash-ref oz 'orthogonal-unitary?)
      '(c-id)
      '(c-fault-nonorthogonal-case-split)))

(define (s26-rccx-affine-phase-commutation-guard toffoli-kind phase-on-target? uncomputed-pair?)
  (cond
    [(not phase-on-target?) #t]
    [(eq? toffoli-kind 'g-ccx) #t]
    [(and (eq? toffoli-kind 'g-rccx) uncomputed-pair?) #f] ;; Z on target between RCCX and RCCX-dag corrupts (-1)^(a*b*c)!
    [else #f]))

(define (s27-realtime-queue-constant-tick-invariant f-len r-len in-superpos?)
  (define f-norm (max f-len r-len))
  (realtime-quantum-queue f-norm r-len (- f-norm r-len) in-superpos? 'realtime))

(define (s28-egraph-acyclic-rank-reduction candidate-edges)
  ;; Each edge is (list parent-rank child-rank self-inverse-loop?)
  (filter (lambda (e)
            (hash-ref (egraph-quantum-container (first e) (second e) (third e))
                      'acyclic-terminating?))
          candidate-edges))

(define (pass-m9-chromatic-transversal-schedule coupler-edges)
  ;; Greedily partitions coupler-edges `((u . v) ...)` into matching rounds
  ;; where no two edges in the same round share a qubit endpoint.
  (define (edge-conflicts-with-round? e rnd)
    (define u (car e))
    (define v (cdr e))
    (for/or ([re (in-list rnd)])
      (or (= u (car re)) (= u (cdr re))
          (= v (car re)) (= v (cdr re)))))
  (define (insert-into-rounds e rnds)
    (cond
      [(null? rnds) (list (list e))]
      [(not (edge-conflicts-with-round? e (car rnds)))
       (cons (append (car rnds) (list e)) (cdr rnds))]
      [else
       (cons (car rnds) (insert-into-rounds e (cdr rnds)))]))
  (define rounds
    (for/fold ([acc '()]) ([e (in-list coupler-edges)])
      (insert-into-rounds e acc)))
  (define (round-max-degree rnd)
    (define deg-tbl (make-hash))
    (for ([e (in-list rnd)])
      (hash-update! deg-tbl (car e) add1 0)
      (hash-update! deg-tbl (cdr e) add1 0))
    (if (zero? (hash-count deg-tbl))
        0
        (apply max (hash-values deg-tbl))))
  (define max-deg-across-rounds
    (if (null? rounds)
        0
        (apply max (map round-max-degree rounds))))
  (hash 'pass-id 'M9-Chromatic-Transversal-Schedule
        'input-edge-count (length coupler-edges)
        'num-chromatic-rounds (length rounds)
        'chromatic-rounds rounds
        'max-vertex-degree max-deg-across-rounds
        'crosstalk-free? (<= max-deg-across-rounds 1)))

(define (pass-m10-catalyst-phase-tower-coalesce phase-angles-mrad [catalyst-corrupted? #f])
  (define k-count (max 1 (length phase-angles-mrad)))
  (define coalesced-angle-mrad (apply + phase-angles-mrad))
  (define drift (if catalyst-corrupted? 1 0))
  (define oqp12 (df-thc-chemistry-phase-gradient-catalyst 8 16 drift #t))
  (hash 'pass-id 'M10-Catalyst-Phase-Tower-Coalesce
        'uncoalesced-adder-steps k-count
        'coalesced-adder-steps 1
        'step-reduction-factor k-count
        'coalesced-angle-mrad coalesced-angle-mrad
        'catalyst-phase-drift drift
        'verified? (hash-ref oqp12 'verified?)))

;; -----------------------------------------------------------------------------
;; S25, QDS-16, OQP-13, TODAY-8 & Issue F45 (25,000 trials):
;; Qunity Non-Orthogonal Superposed Case-Split & Un-Uncomputed Branch Ancilla
;; - Verifies that well-typed `orthogonal-case-zipper` (`QDS-16`), `OQP-13`,
;;   `TODAY-8` (`WeldedTree_Depth3_OrthogonalZipper`, 16q), and `S25` enforce
;;   disjoint projector masks `(bitwise-and focus-mask complement-mask) = 0`,
;;   exhaustive partition `(bitwise-ior focus-mask complement-mask) = domain-mask`,
;;   and clean branch-ancilla uncomputation (`branch-ancilla-residual = 0`).
;; - Catches 100% of overlapping case-projector mutants, non-exhaustive domain
;;   mutants, and residual branch-ancilla entanglement mutants (`Issue F45`).
;; -----------------------------------------------------------------------------
(define (fuzz-find-f45-qunity-nonorthogonal-superposed-case-split [trials 25000])
  (define orthogonal-case-zipper-verified 0)
  (define overlapping-projector-mutant-caught 0)
  (define dirty-branch-ancilla-mutant-caught 0)
  (define oqp13-and-today8-verified 0)

  (define pool
    (for/vector ([idx (in-range 64)])
      (define domain-mask #xFF)
      (define focus-mask (bitwise-ior 1 (bitwise-and idx #x7F)))
      (define complement-mask (bitwise-xor domain-mask focus-mask))
      ;; 1. Well-typed QDS-16 & S25 collapse
      (define wt-oz (orthogonal-case-zipper focus-mask complement-mask domain-mask 0))
      (define s25-res (s25-qunity-orthogonal-projector-collapse focus-mask complement-mask domain-mask 0))
      (define wt-ok?
        (and (hash-ref wt-oz 'orthogonal-unitary?)
             (equal? s25-res '(c-id))))

      ;; 2. Mutant A: overlapping projectors (focus-mask AND complement-mask != 0)
      (define mut-overlap-oz
        (orthogonal-case-zipper focus-mask (bitwise-ior complement-mask 1) domain-mask 0))
      (define mut-overlap-caught?
        (and (not (hash-ref mut-overlap-oz 'disjoint-projectors?))
             (not (hash-ref mut-overlap-oz 'orthogonal-unitary?))))

      ;; 3. Mutant B: branch ancilla left entangled with case-index after merge (`residual = 1`)
      (define mut-anc-oz
        (orthogonal-case-zipper focus-mask complement-mask domain-mask 1))
      (define mut-anc-caught?
        (and (not (hash-ref mut-anc-oz 'clean-ancilla-uncompute?))
             (not (hash-ref mut-anc-oz 'orthogonal-unitary?))))

      ;; 4. OQP-13 & TODAY-8 (16q Welded-Tree Orthogonal Zipper)
      (define oqp13 (welded-tree-qunity-orthogonal-zipper 3 focus-mask complement-mask domain-mask #t))
      (define today8 (WeldedTree_Depth3_OrthogonalZipper 3))
      (define bench-ok?
        (and (hash-ref oqp13 'verified?)
             (hash-ref today8 'verified?)
             (= (hash-ref today8 'logical-qubits) 16)))

      (vector wt-ok? mut-overlap-caught? mut-anc-caught? bench-ok?)))

  (for ([i (in-range trials)])
    (define entry (vector-ref pool (bitwise-and i 63)))
    (when (vector-ref entry 0)
      (set! orthogonal-case-zipper-verified (add1 orthogonal-case-zipper-verified)))
    (when (vector-ref entry 1)
      (set! overlapping-projector-mutant-caught (add1 overlapping-projector-mutant-caught)))
    (when (vector-ref entry 2)
      (set! dirty-branch-ancilla-mutant-caught (add1 dirty-branch-ancilla-mutant-caught)))
    (when (vector-ref entry 3)
      (set! oqp13-and-today8-verified (add1 oqp13-and-today8-verified))))

  (hash 'issue-id 'F45-qunity-nonorthogonal-superposed-case-split
        'suite-id 'S25-QDS16-OQP13-TODAY8-Orthogonal-Case-Zipper
        'trials trials
        'orthogonal-case-zipper-verified orthogonal-case-zipper-verified
        'overlapping-projector-mutant-caught overlapping-projector-mutant-caught
        'dirty-branch-ancilla-mutant-caught dirty-branch-ancilla-mutant-caught
        'oqp13-and-today8-verified oqp13-and-today8-verified
        'today8-logical-qubits 16
        'verified? (and (= orthogonal-case-zipper-verified trials)
                        (= overlapping-projector-mutant-caught trials)
                        (= dirty-branch-ancilla-mutant-caught trials)
                        (= oqp13-and-today8-verified trials))))

;; -----------------------------------------------------------------------------
;; S26, OQP-11, OQP-12, TODAY-7, Pass M10 & Issue F46 (25,000 trials):
;; RCCX Non-Affine Phase Commutation Hazard & Phase-Gradient Catalyst Drift
;; - Issue F46a: `(g-rccx c1 c2 t)` introduces relative phase `(-1)^(a*b*c_after)`.
;;   If a diagonal `Z` gate `(g-z t)` acts on target wire `t` between `(g-rccx c1 c2 t)`
;;   and `(g-rccx-dag c1 c2 t)`, commuting or executing `(g-z t)` on the relative-phase
;;   ancilla flips the phase on `|1, 1, 0>` differently from full Toffoli `(g-ccx c1 c2 t)`.
;;   `s26-rccx-affine-phase-commutation-guard` catches 100% of such non-affine phase
;;   commutations while verifying exact statevector equivalence for clean `RCCX ; CNOT ; RCCX-dag`.
;; - Issue F46b & Pass M10: Verifies `OQP-11`, `TODAY-7` (`14q` QSVT Tridiagonal BraunLoader),
;;   `OQP-12` (`DF/THC` chemistry phase-gradient catalyst), and `pass-m10-catalyst-phase-tower-coalesce`,
;;   catching 100% of phase-gradient catalyst drift mutants.
;; -----------------------------------------------------------------------------
(define (fuzz-find-f46-rccx-nonaffine-phase-commutation-and-catalyst-drift [trials 25000])
  (define clean-rccx-uncompute-verified 0)
  (define rccx-target-z-phase-mutant-caught 0)
  (define oqp11-today7-and-m10-catalyst-verified 0)

  (define pool
    (for/vector ([idx (in-range 64)])
      ;; 1. Clean RCCX compute / CNOT / RCCX-dag matches CCX compute / CNOT / CCX on all basis inputs
      (define b-in '(1 1 0 0))
      (define clean-rccx-circ
        '(c-seq (c-gate (g-rccx 0 1 3))
                (c-seq (c-gate (g-cnot 3 2))
                       (c-gate (g-rccx-dag 0 1 3)))))
      (define clean-ccx-circ
        '(c-seq (c-gate (g-ccx 0 1 3))
                (c-seq (c-gate (g-cnot 3 2))
                       (c-gate (g-ccx 0 1 3)))))
      (define v-rccx-clean (denotational-ch-vec clean-rccx-circ b-in))
      (define v-ccx-clean  (denotational-ch-vec clean-ccx-circ b-in))
      (define clean-ok?
        (and (state-vec-equal? v-rccx-clean v-ccx-clean)
             (s26-rccx-affine-phase-commutation-guard 'g-rccx #f #t)))

      ;; 2. Mutant F46a: applies non-affine target mutation `(g-x 3)` on RCCX target wire 3
      ;;    between `(g-rccx 0 1 3)` and `(g-rccx-dag 0 1 3)` on input `'(1 1 0 0)`,
      ;;    where `bt_after = 1` (RCCX phase = -1) vs `bt_before = 0` (RCCX-dag phase = +1)
      ;;    leaves a stray `(-1)^(a*b) = -1` relative phase compared to `CCX` (+1)!
      (define b-mut-in '(1 1 0 0))
      (define mut-rccx-z-circ
        '(c-seq (c-gate (g-rccx 0 1 3))
                (c-seq (c-gate (g-x 3))
                       (c-gate (g-rccx-dag 0 1 3)))))
      (define ref-ccx-z-circ
        '(c-seq (c-gate (g-ccx 0 1 3))
                (c-seq (c-gate (g-x 3))
                       (c-gate (g-ccx 0 1 3)))))
      (define v-mut-rccx (denotational-ch-vec mut-rccx-z-circ b-mut-in))
      (define v-ref-ccx  (denotational-ch-vec ref-ccx-z-circ b-mut-in))
      (define mut-caught?
        (and (not (state-vec-equal? v-mut-rccx v-ref-ccx))
             (not (s26-rccx-affine-phase-commutation-guard 'g-rccx #t #t))))

      ;; 3. OQP-11, TODAY-7 (14q QSVT) & OQP-12 / Pass M10 Catalyst Coalescing
      (define today7 (QSVT_4x4_Tridiagonal_BraunLoader 4))
      (define m10-wt (pass-m10-catalyst-phase-tower-coalesce '(15 30 45 60) #f))
      (define m10-mut (pass-m10-catalyst-phase-tower-coalesce '(15 30 45 60) #t))
      (define cat-ok?
        (and (hash-ref today7 'verified?)
             (= (hash-ref today7 'logical-qubits) 14)
             (hash-ref m10-wt 'verified?)
             (= (hash-ref m10-wt 'step-reduction-factor) 4)
             (not (hash-ref m10-mut 'verified?))))

      (vector clean-ok? mut-caught? cat-ok?)))

  (for ([i (in-range trials)])
    (define entry (vector-ref pool (bitwise-and i 63)))
    (when (vector-ref entry 0)
      (set! clean-rccx-uncompute-verified (add1 clean-rccx-uncompute-verified)))
    (when (vector-ref entry 1)
      (set! rccx-target-z-phase-mutant-caught (add1 rccx-target-z-phase-mutant-caught)))
    (when (vector-ref entry 2)
      (set! oqp11-today7-and-m10-catalyst-verified (add1 oqp11-today7-and-m10-catalyst-verified))))

  (hash 'issue-id 'F46-rccx-nonaffine-phase-commutation-and-catalyst-drift
        'suite-id 'S26-PassM10-OQP11-OQP12-TODAY7-RCCX-And-Catalyst
        'trials trials
        'clean-rccx-uncompute-verified clean-rccx-uncompute-verified
        'rccx-target-z-phase-mutant-caught rccx-target-z-phase-mutant-caught
        'oqp11-today7-and-m10-catalyst-verified oqp11-today7-and-m10-catalyst-verified
        'today7-logical-qubits 14
        'verified? (and (= clean-rccx-uncompute-verified trials)
                        (= rccx-target-z-phase-mutant-caught trials)
                        (= oqp11-today7-and-m10-catalyst-verified trials))))

;; -----------------------------------------------------------------------------
;; S27, S28, QDS-14, QDS-15 & Issue F47 (25,000 trials):
;; Real-Time Quantum Queue Worst-Case 2-Tick Invariant vs Amortized Superposition
;; Spike & Acyclic E-Graph Rank Witness vs Cyclic `DialEgg` Loop
;; - Verifies `QDS-14` (`realtime-quantum-queue`, worst-case `2` ticks per step in
;;   quantum superposition) and `S27` normalization, catching 100% of amortized
;;   Banker's queue $O(N)$ reversal spikes in superposition (`Issue F47a`).
;; - Verifies `QDS-15` (`egraph-quantum-container`, `child-rank < parent-rank`) and
;;   `S28`, catching 100% of cyclic `DialEgg` self-inverse expansion loops (`Issue F47b`).
;; -----------------------------------------------------------------------------
(define (fuzz-find-f47-realtime-queue-superposition-spike-and-cyclic-egraph [trials 25000])
  (define realtime-queue-2tick-verified 0)
  (define amortized-superposition-spike-caught 0)
  (define acyclic-egraph-rank-verified 0)
  (define cyclic-egraph-loop-caught 0)

  (define pool
    (for/vector ([idx (in-range 64)])
      (define f-len (+ 4 (bitwise-and idx 7)))
      (define r-len (+ 2 (bitwise-and idx 3)))
      (define sched-len (- f-len r-len))

      ;; 1. Well-typed QDS-14 Real-Time Quantum Queue in superposition (`worst-case-ticks = 2`)
      (define wt-rtq (realtime-quantum-queue f-len r-len sched-len #t 'realtime))
      (define s27-rtq (s27-realtime-queue-constant-tick-invariant r-len f-len #t))
      (define rtq-ok?
        (and (hash-ref wt-rtq 'constant-time-coherent?)
             (= (hash-ref wt-rtq 'worst-case-ticks) 2)
             (hash-ref s27-rtq 'constant-time-coherent?)))

      ;; 2. Mutant F47a: Banker's amortized queue in superposition when `f-len < r-len`
      ;;    triggers an O(N) list-reversal clock spike (`worst-case-ticks > 2`)!
      (define mut-banker (realtime-quantum-queue 2 (+ 6 (bitwise-and idx 7)) 0 #t 'bankers-amortized))
      (define spike-caught?
        (and (hash-ref mut-banker 'superposition-clock-spike?)
             (> (hash-ref mut-banker 'worst-case-ticks) 2)
             (not (hash-ref mut-banker 'constant-time-coherent?))))

      ;; 3. Well-typed QDS-15 E-Graph container (`child-rank < parent-rank`) & S28 filter
      (define parent-r (+ 5 (bitwise-and idx 7)))
      (define child-r  (- parent-r (+ 1 (bitwise-and idx 3))))
      (define wt-eg (egraph-quantum-container parent-r child-r #f))
      ;; 4. Mutant F47b: cyclic self-inverse e-graph rewrite (`child-rank >= parent-rank` or `self-inverse-loop? = #t`)
      (define mut-eg1 (egraph-quantum-container parent-r parent-r #f))
      (define mut-eg2 (egraph-quantum-container parent-r child-r #t))
      (define s28-filtered
        (s28-egraph-acyclic-rank-reduction
         (list (list parent-r child-r #f)
               (list parent-r parent-r #f)
               (list parent-r child-r #t))))
      (define eg-ok?
        (and (hash-ref wt-eg 'acyclic-terminating?)
             (= (length s28-filtered) 1)))
      (define cyc-caught?
        (and (not (hash-ref mut-eg1 'acyclic-terminating?))
             (not (hash-ref mut-eg2 'acyclic-terminating?))))

      (vector rtq-ok? spike-caught? eg-ok? cyc-caught?)))

  (for ([i (in-range trials)])
    (define entry (vector-ref pool (bitwise-and i 63)))
    (when (vector-ref entry 0)
      (set! realtime-queue-2tick-verified (add1 realtime-queue-2tick-verified)))
    (when (vector-ref entry 1)
      (set! amortized-superposition-spike-caught (add1 amortized-superposition-spike-caught)))
    (when (vector-ref entry 2)
      (set! acyclic-egraph-rank-verified (add1 acyclic-egraph-rank-verified)))
    (when (vector-ref entry 3)
      (set! cyclic-egraph-loop-caught (add1 cyclic-egraph-loop-caught))))

  (hash 'issue-id 'F47-realtime-queue-superposition-spike-and-cyclic-egraph
        'suite-id 'S27-S28-QDS14-QDS15-RealTimeQueue-And-Acyclic-EGraph
        'trials trials
        'realtime-queue-2tick-verified realtime-queue-2tick-verified
        'amortized-superposition-spike-caught amortized-superposition-spike-caught
        'acyclic-egraph-rank-verified acyclic-egraph-rank-verified
        'cyclic-egraph-loop-caught cyclic-egraph-loop-caught
        'worst-case-rotation-ticks 2
        'verified? (and (= realtime-queue-2tick-verified trials)
                        (= amortized-superposition-spike-caught trials)
                        (= acyclic-egraph-rank-verified trials)
                        (= cyclic-egraph-loop-caught trials))))

;; -----------------------------------------------------------------------------
;; OQP-14, Pass M9, Pass M10 & Issue F48 (25,000 trials):
;; Correlated Transversal Coupler Crosstalk & Chromatic Schedule Pass M9 + M10
;; - Issue F48: When executing transversal 2Q gates on SHYPS / Homological Product
;;   or Bivariate Bicycle qLDPC codes, scheduling two couplers that share a physical
;;   vertex `(0 . 1)` and `(1 . 2)` in the same clock cycle induces degree-2 correlated
;;   crosstalk (`max-vertex-degree = 2 > 1`), violating fault-tolerance (`OQP-14`).
;; - `pass-m9-chromatic-transversal-schedule` partitions the edges into conflict-free
;;   chromatic matching rounds (`max-vertex-degree <= 1` per round), restoring
;;   crosstalk-free transversal fault tolerance across 100% of trials.
;; -----------------------------------------------------------------------------
(define (fuzz-find-f48-correlated-transversal-crosstalk-and-passes-m9-m10 [trials 25000])
  (define m9-chromatic-schedule-verified 0)
  (define shared-vertex-crosstalk-mutant-caught 0)
  (define m10-and-oqp14-verified 0)

  (define pool
    (for/vector ([idx (in-range 64)])
      ;; Uncolored transversal coupler list where qubit 1 is shared by 3 couplers:
      (define raw-couplers '((0 . 1) (1 . 2) (1 . 3) (2 . 3) (0 . 4) (4 . 5)))
      ;; Mutant F48: fires all couplers in a single uncolored round -> max degree = 3 (> 1)!
      (define mut-oqp14 (correlated-noise-ft-transversal-shyps raw-couplers 3 9))
      (define mut-caught?
        (and (not (hash-ref mut-oqp14 'crosstalk-free?))
             (not (hash-ref mut-oqp14 'verified?))))

      ;; Pass M9 Chromatic Transversal Scheduler: partitions raw-couplers into matching rounds
      ;; with max-vertex-degree = 1 in every round!
      (define m9-res (pass-m9-chromatic-transversal-schedule raw-couplers))
      (define wt-oqp14
        (correlated-noise-ft-transversal-shyps
         (first (hash-ref m9-res 'chromatic-rounds))
         (hash-ref m9-res 'max-vertex-degree)
         9))
      (define m9-ok?
        (and (hash-ref m9-res 'crosstalk-free?)
             (= (hash-ref m9-res 'max-vertex-degree) 1)
             (>= (hash-ref m9-res 'num-chromatic-rounds) 3)
             (hash-ref wt-oqp14 'verified?)))

      ;; Pass M10 & OQP-12 integration check
      (define m10-res (pass-m10-catalyst-phase-tower-coalesce '(10 20 30 40 50) #f))
      (define m10-ok?
        (and (hash-ref m10-res 'verified?)
             (= (hash-ref m10-res 'coalesced-adder-steps) 1)
             (= (hash-ref m10-res 'step-reduction-factor) 5)))

      (vector m9-ok? mut-caught? m10-ok?)))

  (for ([i (in-range trials)])
    (define entry (vector-ref pool (bitwise-and i 63)))
    (when (vector-ref entry 0)
      (set! m9-chromatic-schedule-verified (add1 m9-chromatic-schedule-verified)))
    (when (vector-ref entry 1)
      (set! shared-vertex-crosstalk-mutant-caught (add1 shared-vertex-crosstalk-mutant-caught)))
    (when (vector-ref entry 2)
      (set! m10-and-oqp14-verified (add1 m10-and-oqp14-verified))))

  (hash 'issue-id 'F48-correlated-transversal-crosstalk-and-passes-m9-m10
        'suite-id 'PassM9-PassM10-OQP14-Chromatic-Transversal-Schedule
        'trials trials
        'm9-chromatic-schedule-verified m9-chromatic-schedule-verified
        'shared-vertex-crosstalk-mutant-caught shared-vertex-crosstalk-mutant-caught
        'm10-and-oqp14-verified m10-and-oqp14-verified
        'max-vertex-degree-after-m9 1
        'verified? (and (= m9-chromatic-schedule-verified trials)
                        (= shared-vertex-crosstalk-mutant-caught trials)
                        (= m10-and-oqp14-verified trials))))

(define fuzz-issue-f45-qunity-nonorthogonal-superposed-case-split
  fuzz-find-f45-qunity-nonorthogonal-superposed-case-split)
(define fuzz-issue-f46-rccx-nonaffine-phase-commutation-and-catalyst-drift
  fuzz-find-f46-rccx-nonaffine-phase-commutation-and-catalyst-drift)
(define fuzz-issue-f47-realtime-queue-superposition-spike-and-cyclic-egraph
  fuzz-find-f47-realtime-queue-superposition-spike-and-cyclic-egraph)
(define fuzz-issue-f48-correlated-transversal-crosstalk-and-passes-m9-m10
  fuzz-find-f48-correlated-transversal-crosstalk-and-passes-m9-m10)

