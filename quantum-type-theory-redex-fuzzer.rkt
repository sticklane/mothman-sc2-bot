        (/ theta-drift 2.0)))
  (define f-protected
    (sqr (cos residual-angle)))
  (hash 'channel 'quasi-static-z-detuning-xy4-filter
        'theta-drift-rad theta-drift
        'weave-xy4? weave-xy4?
        'unprotected-fidelity f-unprotected
        'xy4-protected-fidelity f-protected
        'first-order-magnus-canceled? weave-xy4?
        'fidelity-restored-above-9999? (> f-protected 0.9999)
        'unprotected-fidelity-collapsed? (< f-unprotected 0.70)
        'noisy-z-drift-dephasing-hazard? (not (> f-protected 0.9999))
