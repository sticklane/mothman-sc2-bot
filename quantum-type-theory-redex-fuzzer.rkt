              (not (wire-in-catlinks? c1 links))
              (not (wire-in-catlinks? c2 links))
              (not (wire-in-catlinks? t links))))
       (define uw-new (list-set uwires t `(uwire ,mt ,(anf-xor at (anf-and a1 a2)) ,zt)))
