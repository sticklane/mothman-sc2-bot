;; =============================================================================
;; 8R. Phase 28: Commutation-Aware Per-Wire DAG & Diagonal-Z Peephole Optimizer
;;     (Pass M65, S99, F129), ASAP Parallel Critical-Path Scheduler & Idle-Spine
;;     XY4 Dynamical Decoupling (Pass M66, S100, QDS-43, OQP-57, TODAY-35, F130),
;;     GRH 8-Pattern Zero-Drift Proof-Term Validator (Pass M67, S101, F131), and
;;     Parametric-Width Symbolic Resource Compiler & Complete 696-Cell
;;     (58 OQPs x 3 Regimes x 4 Machine Families) PCC-Lakefill Matrix
;;     (Pass M68, S102, OQP-58, TODAY-36, F132 — 2,780,800 Total Trials F1..F132)
;; =============================================================================

;; -----------------------------------------------------------------------------
;; 28.1 Deliverable 1 (Pass M65, S99, Fix F129):
;;      Commutation-Aware Per-Wire DAG & Diagonal-Z Peephole Optimizer &
;;      Pauli-Fixup Tuple Normalization (Pauli-Fixup u v op)
;; -----------------------------------------------------------------------------

(define (normalize-pauli-fixup-tuple g [enforce-guard? #t])
  (cond
    [(not enforce-guard?) g]
    [else
     (match g
       [(list 'Pauli-Fixup a b c)
        (cond
          ;; Already normalized: wire indices in positions 1 and 2, op in position 3
          [(and (integer? a) (integer? b))
           (list 'Pauli-Fixup a b c)]
          ;; Misordered: (Pauli-Fixup op u v) -> (Pauli-Fixup u v op)
          [(and (symbol? a) (integer? b) (integer? c))
           (list 'Pauli-Fixup b c a)]
          ;; Misordered: (Pauli-Fixup u op v) -> (Pauli-Fixup u v op)
          [(and (integer? a) (symbol? b) (integer? c))
           (list 'Pauli-Fixup a c b)]
          [else (list 'Pauli-Fixup 0 1 'Z)])]
       [(list 'gate 'Pauli-Fixup (list a b c) phase)
        (define norm (normalize-pauli-fixup-tuple (list 'Pauli-Fixup a b c) #t))
        (list 'gate 'Pauli-Fixup (list (second norm) (third norm)) phase)]
       [_ g])]))

(define (pauli-fixup-wires-in-positions-1-and-2? gates)
  (if (not (list? gates))
      #t
      (for/and ([g (in-list gates)])
        (match g
          [(list 'Pauli-Fixup u v op)
           (and (integer? u) (>= u 0)
                (integer? v) (>= v 0)
                (symbol? op))]
          [(list 'gate 'Pauli-Fixup ws _)
           (and (list? ws)
                (= (length ws) 2)
                (integer? (first ws))
                (integer? (second ws)))]
          [_ #t]))))

(define (inverse-1q-gate-op? op1 op2)
  (or (and (eq? op1 op2) (member op1 '(H X Z)))
      (and (eq? op1 'S) (eq? op2 'Sdg))
      (and (eq? op1 'Sdg) (eq? op2 'S))
      (and (eq? op1 'T) (eq? op2 'Tdg))
      (and (eq? op1 'Tdg) (eq? op2 'T))))

(define (diagonal-z-gate-op? op)
  (not (not (member op '(T Tdg S Sdg Z RZ RZ-DYADIC CZ RZZ)))))

(define (gate-touched-wires g)
  (match g
    [(list 'gate _ ws _) (filter integer? ws)]
    [(list 'Pauli-Fixup u v _) (filter integer? (list u v))]
    [(list 'CZ u v) (filter integer? (list u v))]
    [(list _ w) (if (integer? w) (list w) '())]
    [_ '()]))

(define (gate-op-symbol g)
  (match g
    [(list 'gate op _ _) op]
    [(list op _ ...) op]
    [_ #f]))

(define (find-dag-disjoint-1q-inverse-index rest-gates op1 w1)
  (let scan ([rem rest-gates] [idx 0])
    (match rem
      ['() #f]
      [(cons g2 tl)
       (define op2 (gate-op-symbol g2))
       (define ws2 (gate-touched-wires g2))
       (cond
         [(and (equal? ws2 (list w1))
               (inverse-1q-gate-op? op1 op2))
          idx]
         [(member w1 ws2) #f]
         [else (scan tl (add1 idx))])])))

(define (find-diagonal-z-cz-partner-index rest-gates u v)
  (let scan ([rem rest-gates] [idx 0])
    (match rem
      ['() #f]
      [(cons g2 tl)
       (define op2 (gate-op-symbol g2))
       (define ws2 (gate-touched-wires g2))
       (cond
         ;; Matching CZ(u, v) or CZ(v, u) across intervening diagonal-Z gates!
         [(and (eq? op2 'CZ)
               (or (equal? ws2 (list u v))
                   (equal? ws2 (list v u))))
          idx]
         ;; Disjoint wire gate commutes freely with CZ(u, v)
         [(and (not (member u ws2)) (not (member v ws2)))
          (scan tl (add1 idx))]
         ;; Intervening diagonal-Z gate (T, Tdg, S, Sdg, Z, RZ, RZ-DYADIC, CZ, RZZ) commutes with CZ(u, v)!
         [(diagonal-z-gate-op? op2)
          (scan tl (add1 idx))]
         ;; Non-diagonal gate on u or v blocks CZ commutation
         [else #f])])))

(define (remove-at-index lst idx)
  (append (take lst idx) (drop lst (add1 idx))))

(define (dag-commutation-peephole-single-pass gates)
  (let loop ([rem gates] [acc '()])
    (match rem
      ['() (reverse acc)]
      [(cons g1 rest1)
       (define gn (normalize-pauli-fixup-tuple g1 #t))
       (define op1 (gate-op-symbol gn))
       (define ws1 (gate-touched-wires gn))
       (cond
         ;; 1Q gate inverse cancellation across intervening disjoint-wire gates
         [(and (= (length ws1) 1)
               (member op1 '(H X Z S Sdg T Tdg)))
          (define p-idx (find-dag-disjoint-1q-inverse-index rest1 op1 (first ws1)))
          (if p-idx
              (loop (remove-at-index rest1 p-idx) acc)
              (loop rest1 (cons gn acc)))]
         ;; 2Q CZ(u, v) / CZ(u, v) cancellation across intervening diagonal-Z gates
         [(and (eq? op1 'CZ) (= (length ws1) 2))
          (define u (first ws1))
          (define v (second ws1))
          (define cz-idx (find-diagonal-z-cz-partner-index rest1 u v))
          (if cz-idx
              (loop (remove-at-index rest1 cz-idx) acc)
              (loop rest1 (cons gn acc)))]
         [else
          (loop rest1 (cons gn acc))])])))

(define (dag-commutation-peephole-optimize gates [enforce-guard? #t])
  (cond
    [(not (list? gates)) '()]
    [(not enforce-guard?)
     ;; Mutant F129: fails to commute across disjoint wires / diagonal-Z gates and leaves misordered Pauli-Fixup tuples!
     gates]
    [else
     (let fixpoint ([curr (map (lambda (g) (normalize-pauli-fixup-tuple g #t)) gates)]
                    [fuel (+ 8 (* 2 (length gates)))])
       (if (<= fuel 0)
           curr
           (let ([next (dag-commutation-peephole-single-pass curr)])
             (if (equal? next curr)
                 curr
                 (fixpoint next (sub1 fuel))))))]))

(define (count-native-t-and-tdg-gates gates)
  (if (not (list? gates))
      0
      (for/sum ([g (in-list gates)])
        (if (member (gate-op-symbol g) '(T Tdg)) 1 0))))

(define (post-peephole-native-t-count gates [enforce-guard? #t])
