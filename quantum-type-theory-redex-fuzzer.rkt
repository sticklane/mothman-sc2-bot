    (when (and (coreqds-strict-well-typed? proc-ast rand-env)
               (hash-ref proc-strict 'verified?))
      (set! random-coreqds2-e2e-optimal-verified (add1 random-coreqds2-e2e-optimal-verified))))

  (hash 'issue-id 'F100-complete-oqp1-to-46-translation-validated-optimal-pipeline
        'suite-id 'S75-To-S78-PassM41-To-M44-OQP1-To-46-Master-Audit
