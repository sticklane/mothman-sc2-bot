    SuperconductingQLDPC
    TrappedIonQCCD
    NeutralAtomZonedAOD))

(define all-3-quantum-execution-regimes
  '(OneShotSingleMachine
    MultiShotSingleMachine
    MultiMachineDistributed))

(define (target-arch->machine-family arch)
  (match arch
    [(or 'SuperconductingPlanar 'Heron-R2-156q 'Willow-105q
         'Majorana-Tetron-4q 'Cat-Qubit-Biased-Z 'Silicon-Spin-Shuttling)
     'SuperconductingPlanar]
    [(or 'SuperconductingQLDPC 'Gross-Code-144-12-12
         'Distributed-MultiQPU-Interconnect 'Photonic-GBS)
     'SuperconductingQLDPC]
    [(or 'TrappedIonQCCD 'Helios-98q 'Tesseract-16-4-4)
     'TrappedIonQCCD]
    [(or 'NeutralAtomZonedAOD 'Neutral-Atom-Zone-Arch 'Dawn-3000q)
     'NeutralAtomZonedAOD]
    [_ 'SuperconductingPlanar]))

(define (count-unrebased-generic-cx-gates gates)
  (for/sum ([g (in-list (if (list? gates) gates '()))])
    (match g
      [(list 'gate 'CX _ _) 1]
      [_ 0])))

(define (count-native-machine-two-qubit-gates gates [arch-or-family 'SuperconductingPlanar])
  (define fam (target-arch->machine-family arch-or-family))
  (for/sum ([g (in-list (if (list? gates) gates '()))])
    (match g
      [(list 'gate op (list _ _) _)
       (match fam
         [(or 'SuperconductingPlanar 'SuperconductingQLDPC)
          (if (member op '(CZ EPR-SHARE TELE-CX CZ-COND BIAS-PRESERVING-CX
                           BRAID-PARITY-MZM HEISENBERG-SQRTSWAP FUSION-TYPE-II))
              1
              0)]
         ['TrappedIonQCCD
          (if (member op '(ZZPhase EPR-SHARE TELE-CX CZ-COND)) 1 0)]
         ['NeutralAtomZonedAOD
          (if (member op '(RYDBERG-CZ AOD-SHUTTLE EPR-SHARE TELE-CX CZ-COND)) 1 0)]
         [_ 0])]
      [_ 0])))

(define (rebase-revir-to-native-machine-isa
         gates
         [arch-or-family 'SuperconductingPlanar]
         [enforce-guard? #t])
  (cond
    [(not enforce-guard?)
     (if (list? gates) gates '())]
    [else
     (define routed (route-revir-on-coupling-graph gates arch-or-family))
     (define fam (target-arch->machine-family arch-or-family))
     (apply append
            (for/list ([g (in-list routed)])
              (match g
                ;; Preserve LIFO ancilla markers, MBU measurement/reset/fixup, and TeleGate-EPR primitives
                [(list 'gate (or 'AND-COMPUTE 'AND-UNCOMPUTE 'SYNDROME-DETECT
                                 'MX-Gidney 'CZ-COND 'RESET
                                 'EPR-SHARE 'TELE-CX 'BELL-MEAS-FIXUP) _ _)
                 (list g)]
                [_
                 (match fam
                   [(or 'SuperconductingPlanar 'SuperconductingQLDPC)
                    ;; Native basis: {H, X, Z, RZ-DYADIC, CZ}
                    (match g
                      [(list 'gate 'CX (list c t) phase)
                       (list (list 'gate 'H (list t) 0)
                             (list 'gate 'CZ (list c t) phase)
                             (list 'gate 'H (list t) 0))]
                      [(list 'gate 'RZZ (list u v) phase)
                       (list (list 'gate 'H (list v) 0)
                             (list 'gate 'CZ (list u v) 0)
                             (list 'gate 'RZ-DYADIC (list v) phase)
                             (list 'gate 'CZ (list u v) 0)
                             (list 'gate 'H (list v) 0))]
                      [(list 'gate 'SWAP (list u v) _)
                       (list (list 'gate 'H (list v) 0)
                             (list 'gate 'CZ (list u v) 0)
                             (list 'gate 'H (list v) 0)
                             (list 'gate 'H (list u) 0)
                             (list 'gate 'CZ (list v u) 0)
                             (list 'gate 'H (list u) 0))]
                      [(list 'gate (or 'CCX 'RCCX) (list c1 c2 t) phase)
                       (list (list 'gate 'H (list t) 0)
                             (list 'gate 'CZ (list c2 t) 0)
                             (list 'gate 'RZ-DYADIC (list t) -393)
                             (list 'gate 'CZ (list c1 t) phase)
                             (list 'gate 'RZ-DYADIC (list t) 393)
                             (list 'gate 'CZ (list c2 t) 0)
                             (list 'gate 'H (list t) 0))]
                      [_ (list g)])]
                   ['TrappedIonQCCD
                    ;; Native basis: {RZ-DYADIC, RX, X, Z, ZZPhase(theta)}
                    (match g
                      [(list 'gate 'H (list q) _)
                       (list (list 'gate 'RZ-DYADIC (list q) 785)
                             (list 'gate 'RX (list q) 785)
                             (list 'gate 'RZ-DYADIC (list q) 785))]
                      [(list 'gate 'CX (list c t) _)
                       (list (list 'gate 'RZ-DYADIC (list c) -785)
                             (list 'gate 'RX (list t) -785)
                             (list 'gate 'ZZPhase (list c t) 785)
                             (list 'gate 'RZ-DYADIC (list t) 785))]
                      [(list 'gate 'CZ (list c t) _)
                       (list (list 'gate 'RZ-DYADIC (list c) 785)
                             (list 'gate 'ZZPhase (list c t) 785)
                             (list 'gate 'RZ-DYADIC (list t) 785))]
                      [(list 'gate 'RZZ (list u v) phase)
                       (list (list 'gate 'ZZPhase (list u v) phase))]
                      [(list 'gate 'SWAP (list u v) _)
                       (list (list 'gate 'ZZPhase (list u v) 785)
                             (list 'gate 'RX (list u) 785)
                             (list 'gate 'RX (list v) 785)
                             (list 'gate 'ZZPhase (list u v) 785))]
                      [(list 'gate (or 'CCX 'RCCX) (list c1 c2 t) _)
                       (list (list 'gate 'RX (list t) 785)
                             (list 'gate 'ZZPhase (list c2 t) 785)
                             (list 'gate 'RZ-DYADIC (list t) -393)
                             (list 'gate 'ZZPhase (list c1 t) 785)
                             (list 'gate 'RZ-DYADIC (list t) 393)
                             (list 'gate 'ZZPhase (list c2 t) 785)
                             (list 'gate 'RX (list t) -785))]
                      [_ (list g)])]
                   ['NeutralAtomZonedAOD
                    ;; Native basis: {LOCAL-RXY, RZ-DYADIC, X, Z, RYDBERG-CZ, AOD-SHUTTLE}
                    (match g
                      [(list 'gate 'H (list q) _)
                       (list (list 'gate 'LOCAL-RXY (list q) 785)
                             (list 'gate 'RZ-DYADIC (list q) 1571))]
                      [(list 'gate 'CX (list c t) phase)
                       (list (list 'gate 'LOCAL-RXY (list t) 785)
                             (list 'gate 'RYDBERG-CZ (list c t) phase)
                             (list 'gate 'LOCAL-RXY (list t) -785))]
                      [(list 'gate 'CZ (list c t) phase)
                       (list (list 'gate 'RYDBERG-CZ (list c t) phase))]
                      [(list 'gate 'RZZ (list u v) phase)
                       (list (list 'gate 'AOD-SHUTTLE (list u v) 0)
                             (list 'gate 'RYDBERG-CZ (list u v) phase))]
                      [(list 'gate 'SWAP (list u v) _)
                       (list (list 'gate 'AOD-SHUTTLE (list u v) 0))]
                      [(list 'gate (or 'CCX 'RCCX) (list c1 c2 t) phase)
                       (list (list 'gate 'LOCAL-RXY (list t) 785)
                             (list 'gate 'RYDBERG-CZ (list c2 t) 0)
                             (list 'gate 'RZ-DYADIC (list t) -393)
                             (list 'gate 'RYDBERG-CZ (list c1 t) phase)
                             (list 'gate 'RZ-DYADIC (list t) 393)
                             (list 'gate 'RYDBERG-CZ (list c2 t) 0)
                             (list 'gate 'LOCAL-RXY (list t) -785))]
                      [_ (list g)])]
                   [_ (list g)])])))]))

(define *cached-12-regime-machine-cells* (make-hash))

(define (compile-coreqds-12-regime-machine-cell
         ast
         [regime 'OneShotSingleMachine]
         [machine-family 'SuperconductingPlanar]
         [enforce-guard? #t])
  (define cache-key (list ast regime machine-family enforce-guard?))
  (hash-ref!
   *cached-12-regime-machine-cells*
   cache-key
   (lambda ()
     (define valid-regime? (not (not (member regime all-3-quantum-execution-regimes))))
     (define valid-family? (not (not (member machine-family all-4-quantum-machine-families))))
     (define base-gates (compile-coreqds-to-revir ast))
     (define tpar-gates (optimize-phase-polynomial-tpar-and-gf2-cnot base-gates))
     (define pebbled-gates (ensure-revir-pebble-pair-for-mbu tpar-gates))
     (define oneshot-t (count-revir-t-gates pebbled-gates))
     (define pre-rebased-gates
       (match regime
         ['OneShotSingleMachine
          pebbled-gates]
         ['MultiShotSingleMachine
          (rewrite-revir-multishot-gidney-mbu pebbled-gates enforce-guard?)]
         ['MultiMachineDistributed
          pebbled-gates]
         [_ pebbled-gates]))
     (define isa-gates
       (rebase-revir-to-native-machine-isa pre-rebased-gates machine-family enforce-guard?))
     (define rebased-gates
       (if (eq? regime 'MultiMachineDistributed)
           (rewrite-revir-multimachine-zipper-telegate isa-gates 4 enforce-guard?)
           isa-gates))
     (define unrebased-cx (count-unrebased-generic-cx-gates rebased-gates))
     (define native-2q (count-native-machine-two-qubit-gates rebased-gates machine-family))
     (define edge-check (verify-routed-coupling-graph-edges rebased-gates machine-family))
     (define netlist-check (verify-compiled-revir-netlist rebased-gates))
     (define mcm-count (count-revir-mid-circuit-measurements rebased-gates))
     (define ebit-count (count-ebit-bell-pairs rebased-gates))
     (define cross-mod (if (eq? regime 'MultiMachineDistributed)
                           (count-direct-cross-module-gates rebased-gates 4)
                           0))
     (define regime-t (count-revir-t-gates pre-rebased-gates))
     (define regime-invariant-ok?
       (match regime
         ['OneShotSingleMachine
          (and (zero? mcm-count) (zero? ebit-count))]
         ['MultiShotSingleMachine
          (and (> mcm-count 0) (< regime-t oneshot-t))]
         ['MultiMachineDistributed
          (and (zero? cross-mod) (>= ebit-count 1))]
         [_ #f]))
     (hash 'regime regime
           'machine-family machine-family
           'raw-gate-count (length base-gates)
           'rebased-gate-count (length rebased-gates)
           'rebased-gates rebased-gates
           'oneshot-t-count oneshot-t
           'regime-t-count regime-t
           'mid-circuit-measurements mcm-count
           'ebit-bell-pairs ebit-count
           'direct-cross-module-gates cross-mod
           'unrebased-cx-count unrebased-cx
           'native-two-qubit-gate-count native-2q
           'non-adjacent-edge-violations (hash-ref edge-check 'non-adjacent-edge-violations)
           'routed-coupling-edges-valid? (hash-ref edge-check 'verified?)
           'netlist-verified? (hash-ref netlist-check 'verified?)
           'regime-invariant-ok? regime-invariant-ok?
           'verified? (and enforce-guard?
                           valid-regime?
                           valid-family?
                           (zero? unrebased-cx)
                           (>= native-2q 1)
                           (hash-ref edge-check 'verified?)
                           (hash-ref netlist-check 'verified?)
                           regime-invariant-ok?)))))

(define (qds39-multi-target-native-isa-rebase-and-telegate-zipper
         [regime 'MultiMachineDistributed]
         [machine-family 'TrappedIonQCCD]
         [enforce-guard? #t])
  (define ast (oqp-coreqds-ast 50))
  (define cell (compile-coreqds-12-regime-machine-cell ast regime machine-family enforce-guard?))
