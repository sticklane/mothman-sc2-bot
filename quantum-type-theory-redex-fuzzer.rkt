;; 1. PLT Redex Formal Language: QuantumTypeTheoryL
;;    Intrinsic Quantum Data Structures (QDS-1..13, OQP-1..10, QEC-1..8) & Resource-Graded /
;;    Refined Quantum Type Theory (Refinements 1..8 + Fuzz-Discovered Fixes F1..F44
;;    + Simplified Unified Grade Judgment typeof-unified S1..S3
;;    + Canonical Minimal Grade Judgment typeof-canonical & Surface QDo S5..S8
;;    + Certifying Compiler typeof-certified-compiler, VOQC/Stim S9 & SMT S10
;;    + Generic QContainer S11 & Single-Pass Canonical NbE typeof-nbe-complete S12
;;    + Fault-Polynomial QEC NbE typeof-qec-nbe S13 & 64-Bit Bitboard/Hash-Consing S14
;;    + AlphaDev 64-Bit Bitboard MITM Superopt S15 & 4D Pareto Sweep S16
;;    + Today-Available Hardware Primitives, 3-Tier Multi-Dialect IR, MeasKind M1..M8 & S17..S24
;;    + Phase-9/10/11 Multi-Layer IR Evaluators, 8-Target E2E Compiler, 6-Axis Gap Verifier & F33..F44)
;; =============================================================================

(define-language QuantumTypeTheoryL
  ;; Wire indices, natural numbers, bits, signs
  (w w1 w2 p c c1 c2 t i j k n s cap r r1 r2 d e a b l q q1 q2 q3 ::= natural)
  (bit                                                            ::= 0 1)
  (sign                                                           ::= 1 -1)

  ;; Hardware Zone Coeffects (Neutral-Atom / Superconducting Zone Hierarchy)
  (HardwareZone ::= StorageZone EntanglingZone ReadoutZone)

  ;; Zipper Focus Modal State for Tier-1 HL-QDS (Phase 9, Fix F33)
  (ZipperFocus ::= FocusRoot FocusLeft FocusRight)

  ;; Phase-10/11 Hardware-Gap & Next-Frontier Modalities (Fixes F37-F44, Passes M6-M8, S21-S24):
  (FramePolarity     ::= FrameZero FrameTwistedX FrameTwistedZ FrameTwistedY)
  (SubspaceModality  ::= SubspaceClean NeedsErasureHerald)
  (DDModality        ::= UnprotectedIdle DDProtectedXY4)
  (NoiseBiasModality ::= ZBiasPreserving BiasBreaking)

  ;; Phase-8/9 Hardware Targets (4 Ideal FTQC + 4 Today-Hardware + Legacy Alias)
  ;; & 6-Kind Physical Measurement Taxonomy (MeasKind, M1-M5)
  (HardwareTarget ::=
    Ideal-FTQC
    FTQC-Planar-6.1
    FTQC-Yoked-6.2A
    FTQC-BB288-6.2B
    FTQC-NeutralAtom-6.3
    Willow-105q
    Heron-R2-156q
    Quantinuum-H2-56q
    Bluvstein-NeutralAtom)

  (MeasKind ::=
    meas-terminal-batch
    meas-mcm-ff
    meas-mcmr-reuse
    meas-qnd-parity
    meas-heralded-erasure
    meas-joint-bell-fusion)

  ;; Twist-Type Purity Classification (MIT 2022 Twist + ANF Degree)
  (TwistPurity  ::= SeparableBasis SeparableSuperpos Entangled)

  ;; Pauli-X Twirl Polarity for Catalytic Phase-Gradient Cancellation
  (TwirlPolarity ::= TwirlEven TwirlOdd)

  ;; Quotient vs Canonical Carry-Save Consolidation Tag (Refinement 6 & Fix F9)
  (CarrySaveTag  ::= RedundantCarrySave CanonicalZeroless)
  (RepState      ::= CanonicalMod RedundantCS)

  ;; Phase-4 [[288, 12, 18]] Bivariate Bicycle CSS Syndrome Round State (Fix F16)
  (CSSRoundState ::= CSSClosed CSSOpenX CSSOpenZ)

  ;; Phase-6 2D Surface <-> 3D Color Code Homological Gauge State (Fix F24, QEC-7)
  (GaugeState    ::= ClosedHomologyGauge ClosedHomologicalGauge OpenBoundaryGauge)

  ;; ---------------------------------------------------------------------------
  ;; (a) Intrinsic Quantum Data Structure (QDS) Terms (QDS-1..13 & QContainer S11)
  ;; ---------------------------------------------------------------------------

  ;; 1. CanonicalSkewNum: strictly increasing tail ranks after an optional
  ;;    lowest duplicate pair (uniquely encoding every natural number in O(1) inc/dec)
  (SkewTail ::=
    mt-tail
    (cons-tail natural SkewTail))
  (CanonicalSkewNum ::=
    skew-zero
    (skew-single natural SkewTail)
    (skew-double natural SkewTail))

  ;; 2. IntrinsicBoundedArena: (arena free-slots used-slots (slot-ids ...))
  (IntrinsicBoundedArena ::=
    (bounded-arena natural natural (natural ...)))

  ;; 3. IntrinsicRealTimeQueue: Okasaki real-time queue with schedule invariant
  ;;    |sched| = |front| - |rear|, guaranteeing worst-case O(1) snoc/uncons
  (IntrinsicRealTimeQueue ::=
    (rt-queue (natural ...) (natural ...) (natural ...)))

  ;; 4. IntrinsicBraunTree: pointerless balanced tree with 0 <= |L| - |R| <= 1
  (IntrinsicBraunTree ::=
    braun-mt
    (braun-node natural natural IntrinsicBraunTree IntrinsicBraunTree))

  ;; 5. IntrinsicFingerNode: 2-3 finger tree node with cached monoidal measure M
  (MonoidMeasure ::= (gp-measure natural natural)) ;; (generate, propagate) in {0,1}^2
  (IntrinsicFingerNode ::=
    (finger-leaf MonoidMeasure natural)
    (finger-node2 MonoidMeasure IntrinsicFingerNode IntrinsicFingerNode)
    (finger-node3 MonoidMeasure IntrinsicFingerNode IntrinsicFingerNode IntrinsicFingerNode))

  ;; 6. CritBitTrie: history-independent PATRICIA / Crit-Bit radix tree
  (CritBitTrie ::=
    crit-mt
    (crit-lf natural)
    (crit-br natural natural CritBitTrie CritBitTrie))

  ;; QuotientCarrySave: explicit quotient vs canonical representative
  (QuotientCarrySave ::=
    (qcs CarrySaveTag (natural ...)))

  ;; ChoreographicSession: distributed multi-QPU tele-gate session protocol
  (ChoreographicSession ::=
    sess-end
    (sess-alloc-ebit natural ChoreographicSession)
    (sess-cat-entangle natural natural ChoreographicSession)
    (sess-cat-disentangle natural natural ChoreographicSession)
    (sess-local-diag natural ChoreographicSession))

  ;; ClockedStream: guarded Bahr-Grathwohl-Mogelberg clocked stream step
  (ClockedStream ::=
    (clocked-stream natural TwirlPolarity (natural ...)))

  ;; 10. CatenableDeque (QDS-10): O(1) catenable entanglement buffer deque
  (CatenableDeque ::=
    (cat-deque (natural ...) (natural ...)))

  ;; 11. SegmentedBitmask (QDS-11): 64-bit word-aligned syndrome bitmask
  (SegmentedBitmask ::=
    (seg-bitmask (natural ...)))

  ;; 12. LazyPebbleTree (QDS-12): memoized binomial pebbling schedule tree
  (LazyPebbleTree ::=
    pebble-leaf
    (pebble-node natural natural LazyPebbleTree LazyPebbleTree))

  ;; 13. PersistentUnionFind (QDS-13): persistent Union-Find forest on Braun array
  (PUFNode ::=
    (puf-node natural natural natural)
    (natural natural natural))
  (PersistentUnionFind ::=
    (puf-forest (PUFNode ...)))

  ;; Simplification S11: Generic Indexed Quantum Container (QContainer S P M) & OQP-1..10
  (QContainerShape ::=
    ShapeSkew
    ShapeBraun
    ShapeFinger
    ShapeCritBit
    ShapeCatDeque
    ShapeSegBitmask
    ShapePebbleTree
    ShapeUnionFind)
  (QContainer ::=
    (qcontainer (shape QContainerShape) (arity natural) (measure MonoidMeasure) (payload (natural ...))))

  (OQPSpec ::=
    oqp1-qrng-braun-tree
    oqp2-shor-skew-carry-save
    oqp3-grover-critbit-oracle
    oqp4-ambainis-ed-radix-walk
    oqp5-kuperberg-collimation-sieve
    oqp6-magic-state-cultivation-fifo
    oqp7-tree-qram-bucket-brigade
    oqp8-hierarchical-pebbling-f2poly
    oqp9-distributed-cat-choreography
    oqp10-sliding-window-syndrome-deque)

  ;; Phase-6 Canonical QEC Protocol & Fault-Tolerant Gadget Specifications (QEC-1..8, S13):
  (QECSpec ::=
    qec1-surface-code-sliding-window
    qec2-bb-288-12-18-torus
    qec3-color-code-flag-bridge
    qec4-magic-state-cultivation-15-to-1
    qec5-lattice-surgery-ppm-routing
    qec6-homological-code-switching
    qec7-yoked-surface-code-hierarchy
    qec8-distributed-floquet-honeycomb)

  ;; Unified QDS Term & Operation Grammar
  (QDSTerm ::=
    CanonicalSkewNum
    IntrinsicBoundedArena
    IntrinsicRealTimeQueue
