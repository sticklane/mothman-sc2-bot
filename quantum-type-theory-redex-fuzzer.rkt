               (not (hash-ref s49-mut 'verified?)))
      (set! fixed-asic-deformation-mutant-caught (add1 fixed-asic-deformation-mutant-caught)))

    ;; 3. CoreQDS combinator check: ec-fault-tolerant-lift with dynamic-deform?=#t is rejected on 240ns ASIC!
    (define deform-ast (ec-fault-tolerant-lift code-d #t (fold-tree 'Braun (list 'var var-idx))))
    (when (and (not (coreqds-well-typed? deform-ast 'provider-inner-loop-blueprint 'Willow-105q 'asic-240ns-collision-clustering))
