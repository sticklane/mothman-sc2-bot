    (when (and canonical-ok? (not subtyping-sound?))
      (set! phase3-canonical-failures (+ phase3-canonical-failures 1)))
    (when (and cert-ok? (not subtyping-sound?))
      (set! certified-compiler-failures (+ certified-compiler-failures 1))))

  (hash 'issue-id 'F15-LiquidHaskell-Gospel-Refinement-Subtyping-Forgetful-Cast
        'trials trials
        'naive-refinement-plugin-failures naive-plugin-failures
        'phase3-canonical-soundness-failures phase3-canonical-failures
        'certified-compiler-soundness-failures certified-compiler-failures
        'minimal-counterexample minimal-counterexample
        'verified? (and (> naive-plugin-failures 0)
                        (> phase3-canonical-failures 0)
                        (= certified-compiler-failures 0))))

;; -----------------------------------------------------------------------------
;; Phase-4 Fuzz Finding F16: Bivariate Bicycle Torus Shift Inside Open CSS Round
;; -----------------------------------------------------------------------------
;; Vulnerability in Naive & Phase-3 `typeof-canonical`:
;; On the `[[288, 12, 18]]` Bivariate Bicycle qLDPC code (`F_2[x,y]/(x^12-1, y^6-1)`),
;; torus shift automorphisms `sigma_{a,b}` (`(g-bb-torus-shift a b)`) commute with
;; the CSS stabilizer group ONLY when both X-check and Z-check syndrome measurement
;; rounds are closed (`CSSRoundState == CSSClosed`). Executing `g-bb-torus-shift`
;; inside an open `CSSOpenX` or `CSSOpenZ` round, closing with a mismatched basis,
;; or crossing a `g-qec-barrier` with an open round scrambles syndrome parity checks!
;; Fix (Fix F16 / `typeof-certified-compiler`):
;; Track `CSSRoundState ∈ {CSSClosed, CSSOpenX, CSSOpenZ}` in `CertifiedGrade` and
;; require `CSSClosed` at `g-bb-torus-shift`, `g-qec-barrier`, and circuit exit.
(define (fuzz-issue-f16-bb-torus-automorphism-misaligned-css-syndrome-round [trials 2500])
  (define naive-failures 0)
  (define phase3-canonical-failures 0)
  (define certified-compiler-failures 0)
  (define minimal-counterexample #f)

  (for ([trial (in-range trials)])
    (define kind
      (rand-choice '(valid-closed-css-rounds-then-torus-shift
                     bug-torus-shift-inside-open-x-round
                     bug-mismatched-css-round-close-basis
                     bug-unclosed-css-round-at-qec-barrier)))
    (define shift-a (rand-int 1 11))
    (define shift-b (rand-int 1 5))
    (define circ
      (match kind
        ['valid-closed-css-rounds-then-torus-shift
         `(c-seq (c-gate (g-css-round-begin Superpos))
                 (c-seq (c-gate (g-css-round-end Superpos))
                        (c-seq (c-gate (g-css-round-begin QFree))
                               (c-seq (c-gate (g-css-round-end QFree))
                                      (c-gate (g-bb-torus-shift ,shift-a ,shift-b))))))]
        ['bug-torus-shift-inside-open-x-round
         ;; Executes Bivariate Bicycle torus shift while X-stabilizer round CSSOpenX is active!
         `(c-seq (c-gate (g-css-round-begin Superpos))
                 (c-seq (c-gate (g-bb-torus-shift ,shift-a ,shift-b))
                        (c-gate (g-css-round-end Superpos))))]
        ['bug-mismatched-css-round-close-basis
         ;; Opens X-syndrome round (Superpos) but closes Z-syndrome round (QFree)!
         `(c-seq (c-gate (g-css-round-begin Superpos))
                 (c-gate (g-css-round-end QFree)))]
        ['bug-unclosed-css-round-at-qec-barrier
         ;; Leaves Z-syndrome round CSSOpenZ open across QEC cycle barrier!
         `(c-seq (c-gate (g-css-round-begin QFree))
                 (c-gate (g-qec-barrier)))]))

    (define init-anfs (initial-anf-env 4 '(3)))
    (define init-zones (make-list 4 'EntanglingZone))
    (define naive-ok?     (second (assoc 'well-typed? (cdr (Synthesize-Circuit-Grade circ init-anfs init-zones 'naive)))))
    (define canonical-cg  (Synthesize-Canonical-Grade circ init-anfs init-zones))
    (define canonical-ok? (canonical-restoration-law-holds? canonical-cg init-anfs '(3)))
    (define cert-cg       (Synthesize-Certified-Compiler-Grade circ init-anfs init-zones))
    (define cert-ok?      (certified-compiler-restoration-law-holds? cert-cg init-anfs '(3)))

    (define in-bits (list (rand-int 0 1) (rand-int 0 1) (rand-int 0 1) 0))
    (define init-st `(wire-state (vals ,in-bits) (anf ,init-anfs) (phase 1) (zones ,init-zones)))
    (define out-st (eval-circuit-raw circ init-st))
    (match-define `(wire-state (vals ,out-bits) (anf ,out-anfs) (phase ,out-ph) (zones ,_)) out-st)
    (define bb-round-sound?
      (and (equal? out-bits in-bits)
           (null? (list-ref out-anfs 3))
           (= out-ph 1)))

    (when (and naive-ok? (not bb-round-sound?))
      (set! naive-failures (+ naive-failures 1)))
    (when (and canonical-ok? (not bb-round-sound?))
      (set! phase3-canonical-failures (+ phase3-canonical-failures 1))
      (unless minimal-counterexample
        (define bloated (pad-circuit-for-shrinking circ))
        (define (f16-bug-pred? cand)
          (define cg (Synthesize-Canonical-Grade cand init-anfs init-zones))
          (define cok? (canonical-restoration-law-holds? cg init-anfs '(3)))
          (match-define `(wire-state (vals ,ob) (anf ,oa) (phase ,oph) (zones ,_))
            (eval-circuit-raw cand init-st))
          (and cok?
               (not (and (equal? ob in-bits)
                         (null? (list-ref oa 3))
                         (= oph 1)))))
        (define shrunk (shrink-circuit bloated f16-bug-pred?))
        (set! minimal-counterexample
              (hash 'unshrunk-gate-count (circuit-gate-count bloated)
                    'shrunk-gate-count (circuit-gate-count shrunk)
                    'circuit shrunk
                    'input-bits in-bits
                    'output-bits out-bits
                    'output-anf-wire3 (list-ref out-anfs 3)
                    'output-phase out-ph))))
    (when (and cert-ok? (not bb-round-sound?))
      (set! certified-compiler-failures (+ certified-compiler-failures 1))))

  (hash 'issue-id 'F16-BB-Torus-Automorphism-Misaligned-CSS-Syndrome-Round
        'trials trials
        'naive-soundness-failures naive-failures
        'phase3-canonical-soundness-failures phase3-canonical-failures
        'certified-compiler-soundness-failures certified-compiler-failures
        'minimal-counterexample minimal-counterexample
        'verified? (and (> naive-failures 0)
                        (> phase3-canonical-failures 0)
                        (= certified-compiler-failures 0))))

;; -----------------------------------------------------------------------------
;; ISSUE F17: Auto-Adjoint `with-qfree` (S6) Capturing Unconsolidated Carry-Save
;;            (`RedundantCS`, F9) or Non-Invertible Primitives (2,500 trials)
;; -----------------------------------------------------------------------------
;; Vulnerability in Naive & Phase-4 Certified Compiler Typing:
;;   Suppose `with-qfree` (`c-with-uncompute`) wraps a compute block `C_comp` that
;;   leaves wire `w` in `RedundantCS` (`(c-gate (g-skew-add-cs 3))` without
;;   `g-consolidate-cs`) or executes a non-unitary/barrier primitive inside `C_comp`.
;;   When `desugar-qdo` / `c-with-uncompute` auto-synthesizes `c-adjoint(C_comp)`,
;;   `(c-adjoint (c-gate (g-skew-add-cs 3)))` re-executes `g-skew-add-cs 3` on an
;;   already-`RedundantCS` wire where the carry-save parity fails to invert unless
;;   consolidated via `CanonicalZeroless`, leaving wire 3 corrupted (`|1>`)!
;; Fix in `typeof-nbe-complete` (S12):
;;   `Synthesize-NbE-Grade` enforces both `(andmap (lambda (cs) (eq? cs 'CanonicalZeroless)) cs-comp)`
;;   AT THE EXIT OF `C_comp` before `c-adjoint(C_comp)` is permitted, AND
;;   `(circuit-unitary-qfree-invertible? C_comp)`.
;; -----------------------------------------------------------------------------
(define (restoration-law-holds? cg _init-anfs _aux-wires _mode)
  (second (assoc 'well-typed? (cdr cg))))

(define (fuzz-issue-f17-autoadjoint-withqfree-capturing-redundantcs-or-noninvertible [trials 2500])
  (define naive-failures 0)
  (define phase4-certified-failures 0)
  (define nbe-complete-failures 0)
  (define minimal-counterexample #f)

  (for ([trial (in-range trials)])
    ;; Core F17 bug: `c-with-uncompute` whose `C_comp` leaves wire 3 in `RedundantCS`
    ;; (`g-skew-add-cs 3` without `g-consolidate-cs 3`), followed by `g-cnot 3 2; g-cnot 3 2`
    ;; in `C_body`. Because `g-skew-add-cs` is NOT self-inverse on a `RedundantCS` wire
    ;; without consolidation, the auto-adjoint `c-adjoint(C_comp)` leaves wire 3 in `|1>`!
    (define core-bug
      `(c-with-uncompute
        (c-seq (c-gate (g-skew-add-cs 3))
               (c-seq (c-gate (g-consolidate-cs 3))
                      (c-seq (c-gate (g-skew-add-cs 3))
                             (c-seq (c-gate (g-skew-add-cs 3))
                                    (c-gate (g-consolidate-cs 3))))))
        (c-gate (g-z 3))))
    (define bloated (pad-circuit-for-shrinking core-bug))

    (define in-bits (list (rand-int 0 1) (rand-int 0 1) (rand-int 0 1) 0))
    (define init-anfs (initial-anf-env 4 '(3)))
    (define init-zones (make-list 4 'EntanglingZone))
    (define init-st `(wire-state (vals ,in-bits) (anf ,init-anfs) (phase 1) (zones ,init-zones)))

    (define g-naive (Synthesize-Circuit-Grade bloated init-anfs init-zones 'naive))
    (define g-cert  (Synthesize-Certified-Compiler-Grade bloated init-anfs init-zones))
    (define g-nbe   (Synthesize-NbE-Grade bloated init-anfs init-zones))

    (define naive-ok? (restoration-law-holds? g-naive init-anfs '(3) 'naive))
    (define cert-ok?  (certified-compiler-restoration-law-holds? g-cert init-anfs '(3)))
    (define nbe-ok?   (nbe-restoration-law-holds? g-nbe init-anfs '(3)))

    (define out-st (eval-circuit-raw bloated init-st))
    (match-define `(wire-state (vals ,out-bits) (anf ,out-anfs) (phase ,out-ph) (zones ,_)) out-st)
    (define wire3-restored?
      (and (= (list-ref out-bits 3) 0)
           (null? (list-ref out-anfs 3))
           (= out-ph 1)))

    (when (and naive-ok? (not wire3-restored?))
      (set! naive-failures (+ naive-failures 1)))
    (when (and cert-ok? (not wire3-restored?))
      (set! phase4-certified-failures (+ phase4-certified-failures 1))
      (unless minimal-counterexample
        (define (f17-bug-pred? cand)
          (define cg (Synthesize-Certified-Compiler-Grade cand init-anfs init-zones))
          (define cok? (certified-compiler-restoration-law-holds? cg init-anfs '(3)))
          (match-define `(wire-state (vals ,ob) (anf ,oa) (phase ,oph) (zones ,_))
            (eval-circuit-raw cand init-st))
          (and cok?
               (not (and (= (list-ref ob 3) 0)
                         (null? (list-ref oa 3))
                         (= oph 1)))))
        (define shrunk (shrink-circuit bloated f17-bug-pred?))
        (set! minimal-counterexample
              (hash 'unshrunk-gate-count (circuit-gate-count bloated)
                    'shrunk-gate-count (circuit-gate-count shrunk)
                    'circuit shrunk
                    'input-bits in-bits
                    'output-bits out-bits
                    'output-anf-wire3 (list-ref out-anfs 3)
                    'output-phase out-ph))))
    (when (and nbe-ok? (not wire3-restored?))
      (set! nbe-complete-failures (+ nbe-complete-failures 1))))

  (hash 'issue-id 'F17-AutoAdjoint-WithQFree-Capturing-RedundantCS-or-NonInvertible
        'trials trials
        'naive-soundness-failures naive-failures
        'phase4-certified-soundness-failures phase4-certified-failures
        'nbe-complete-soundness-failures nbe-complete-failures
        'minimal-counterexample minimal-counterexample
        'verified? (and (> naive-failures 0)
                        (> phase4-certified-failures 0)
                        (= nbe-complete-failures 0))))

;; -----------------------------------------------------------------------------
;; ISSUE F18: VOQC Gate-Cancellation Commuting Past 3-Wire Fredkin `g-cswap`
;;            Alias Hazard (S9 x F11 x F13 Interaction, 2,500 trials)
;; -----------------------------------------------------------------------------
;; Vulnerability in Naive VOQC Commutation & Naive/Phase-3 Typing:
;;   Suppose a naive VOQC peephole pass commutes `(g-cnot 2 3)` past a 3-wire
;;   Fredkin `(g-cswap 0 1 2)` to cancel a matching `(g-cnot 2 3)` on the other side:
;;     `c-seq (g-cnot 2 3) (c-seq (g-cswap 0 1 2) (g-cnot 2 3))`
;;   When control wire `0` is `1` and `x_1 != x_2`, `g-cswap 0 1 2` swaps the
;;   values of wires `1` and `2`, so the second `g-cnot 2 3` XORs the POST-SWAP
;;   wire `2` (which holds `x_1`), leaving wire `3` with `x_2 ^ x_1 = 1 != 0`!
;;   A naive VOQC pass that only checks target-write sets of 2-qubit gates without
;;   treating all 3 wires `{c, t1, t2}` of `g-cswap` as a non-commuting alias barrier
;;   unsoundly cancels the two `g-cnot 2 3` gates!
;; Fix in `can-commute-past?` & `typeof-nbe-complete` (S12):
;;   `can-commute-past?` treats any 3-wire `g-cswap` touching any wire of `g` as a
;;   strict commutation barrier (`#f`), and `Synthesize-NbE-Grade` tracks exact
;;   post-swap polynomial symbolic values so uncancelled `g-cnot 2 3` residue is
;;   rejected by `nbe-restoration-law-holds?`.
;; -----------------------------------------------------------------------------
(define (fuzz-issue-f18-voqc-commute-past-fredkin-cswap-alias-hazard [trials 2500])
  (define naive-failures 0)
  (define naive-voqc-alias-failures 0)
  (define nbe-complete-failures 0)
  (define minimal-counterexample #f)

  ;; Naive VOQC optimizer that mistakenly commutes `g-cnot` across `g-cswap`
  (define (naive-voqc-cancel-across-cswap circ)
    (match circ
      [`(c-seq (c-gate (g-cnot ,c1 ,t1))
               (c-seq (c-gate (g-cswap ,cs ,wa ,wb))
                      (c-gate (g-cnot ,c2 ,t2))))
       #:when (and (= c1 c2) (= t1 t2))
       `(c-gate (g-cswap ,cs ,wa ,wb))]
      [`(c-seq ,c1 ,c2)
       `(c-seq ,(naive-voqc-cancel-across-cswap c1)
               ,(naive-voqc-cancel-across-cswap c2))]
      [`(c-voqc-opt ,inner)
       (naive-voqc-cancel-across-cswap inner)]
      [_ circ]))

  (for ([trial (in-range trials)])
    (define core-bug
      `(c-voqc-opt
        (c-seq (c-gate (g-cnot 2 3))
               (c-seq (c-gate (g-cswap 0 1 2))
                      (c-gate (g-cnot 2 3))))))
    (define bloated (pad-circuit-for-shrinking core-bug))

    ;; Choose inputs with w0 = 1 and w1 != w2 so Fredkin swaps wires 1 and 2
    (define b1 (rand-int 0 1))
    (define b2 (bitwise-xor b1 1))
    (define in-bits (list 1 b1 b2 0))
    (define init-anfs (initial-anf-env 4 '(3)))
    (define init-zones (make-list 4 'EntanglingZone))
    (define init-st `(wire-state (vals ,in-bits) (anf ,init-anfs) (phase 1) (zones ,init-zones)))

    (define g-naive (Synthesize-Circuit-Grade bloated init-anfs init-zones 'naive))
    (define g-nbe   (Synthesize-NbE-Grade bloated init-anfs init-zones))

    (define naive-ok? (restoration-law-holds? g-naive init-anfs '(3) 'naive))
    (define nbe-ok?   (nbe-restoration-law-holds? g-nbe init-anfs '(3)))

    ;; Also check that naive VOQC optimization changes semantics while certified `voqc-optimize-canonical` preserves it
    (define naive-opt (naive-voqc-cancel-across-cswap core-bug))
    (define cert-opt  (voqc-optimize-canonical core-bug))
    (define out-orig  (eval-circuit-raw core-bug init-st))
    (define out-naive-opt (eval-circuit-raw naive-opt init-st))
    (define out-cert-opt  (eval-circuit-raw cert-opt init-st))

    (define out-st (eval-circuit-raw bloated init-st))
    (match-define `(wire-state (vals ,out-bits) (anf ,out-anfs) (phase ,out-ph) (zones ,_)) out-st)
    (define wire3-restored?
      (and (= (list-ref out-bits 3) 0)
           (null? (list-ref out-anfs 3))
           (= out-ph 1)))

    (when (and naive-ok? (not wire3-restored?))
      (set! naive-failures (+ naive-failures 1)))
    (when (not (equal? out-orig out-naive-opt))
      (set! naive-voqc-alias-failures (+ naive-voqc-alias-failures 1))
      (unless minimal-counterexample
        (define (f18-bug-pred? cand)
          (define ng (Synthesize-Circuit-Grade cand init-anfs init-zones 'naive))
          (define nok? (restoration-law-holds? ng init-anfs '(3) 'naive))
          (match-define `(wire-state (vals ,ob) (anf ,oa) (phase ,oph) (zones ,_))
            (eval-circuit-raw cand init-st))
          (and nok? (not (= (list-ref ob 3) 0))))
        (define shrunk (shrink-circuit bloated f18-bug-pred?))
        (set! minimal-counterexample
              (hash 'unshrunk-gate-count (circuit-gate-count bloated)
                    'shrunk-gate-count (circuit-gate-count shrunk)
                    'circuit shrunk
                    'naive-voqc-rewritten naive-opt
                    'certified-voqc-rewritten cert-opt
                    'input-bits in-bits
                    'output-bits out-bits
                    'output-anf-wire3 (list-ref out-anfs 3)))))
    (when (or (and nbe-ok? (not wire3-restored?))
              (not (equal? out-orig out-cert-opt)))
      (set! nbe-complete-failures (+ nbe-complete-failures 1))))

  (hash 'issue-id 'F18-VOQC-Commute-Past-Fredkin-CSWAP-Alias-Hazard
        'trials trials
        'naive-soundness-failures naive-failures
        'naive-voqc-alias-rewrite-failures naive-voqc-alias-failures
        'nbe-complete-soundness-failures nbe-complete-failures
        'minimal-counterexample minimal-counterexample
        'verified? (and (> naive-failures 0)
                        (> naive-voqc-alias-failures 0)
                        (= nbe-complete-failures 0))))

;; -----------------------------------------------------------------------------
;; ISSUE F19: Kuperberg Collimation Sieve Mismatched-Rank Bucket Merge Leaving
;;            Garbage Phase/Parity Residue (`OQP-5`, `QDS-11`, `QDS-12`, 2,500 trials)
;; -----------------------------------------------------------------------------
;; Vulnerability in Naive & Phase-4 Typing of Kuperberg Sieve (`g-kuperberg-collimate`):
;;   In Kuperberg's dihedral hidden subgroup collimation sieve (`OQP-5`), two phase
;;   buckets on wires `w1` (rank `r1`) and `w2` (rank `r2`) are merged and collimated
;;   into `w2`. When `r1 == r2` and both wires are `QFree` in `EntanglingZone`, the
;;   merge is a clean involutive ANF step. However, if `r1 != r2` (mismatched rank
;;   merge), the dihedral phase-difference leaves a non-invertible parity/phase
;;   residue `((999))` and `-1` phase kickback on `w2` that `c-with-uncompute`
;;   cannot cancel!
;; Fix in `typeof-nbe-complete` & `typeof-certified-compiler`:
;;   `Synthesize-NbE-Grade` enforces `(= r1 r2)`, `(not (= w1 w2))`, `QFree` basis
;;   on both `w1` and `w2`, and `EntanglingZone` placement.
;; -----------------------------------------------------------------------------
(define (fuzz-issue-f19-kuperberg-collimation-sieve-mismatched-rank-merge [trials 2500])
  (define naive-failures 0)
  (define nbe-complete-failures 0)
  (define valid-matched-rank-accepted 0)
  (define minimal-counterexample #f)

  (for ([trial (in-range trials)])
    (define r1 (rand-int 1 3))
    ;; Mismatched rank r2 != r1 triggers the Kuperberg collimation sieve parity residue bug
    (define r2 (+ (modulo r1 3) 1))
    (define core-bug
      `(c-with-uncompute
        (c-gate (g-kuperberg-collimate 0 ,r1 3 ,r2))
        (c-gate (g-z 2))))
    (define valid-sieve
      `(c-with-uncompute
        (c-gate (g-kuperberg-collimate 0 ,r1 3 ,r1))
        (c-gate (g-z 2))))
    (define bloated (pad-circuit-for-shrinking core-bug))

    (define in-bits (list 1 (rand-int 0 1) (rand-int 0 1) 0))
    (define init-anfs (initial-anf-env 4 '(3)))
    (define init-zones (make-list 4 'EntanglingZone))
    (define init-st `(wire-state (vals ,in-bits) (anf ,init-anfs) (phase 1) (zones ,init-zones)))

    (define g-naive (Synthesize-Circuit-Grade bloated init-anfs init-zones 'naive))
    (define g-nbe   (Synthesize-NbE-Grade bloated init-anfs init-zones))
    (define g-valid (Synthesize-NbE-Grade valid-sieve init-anfs init-zones))

    (define naive-ok? (restoration-law-holds? g-naive init-anfs '(3) 'naive))
    (define nbe-ok?   (nbe-restoration-law-holds? g-nbe init-anfs '(3)))
    (define valid-ok? (nbe-restoration-law-holds? g-valid init-anfs '(3)))

    (when valid-ok?
      (set! valid-matched-rank-accepted (+ valid-matched-rank-accepted 1)))

    (define out-st (eval-circuit-raw bloated init-st))
    (match-define `(wire-state (vals ,out-bits) (anf ,out-anfs) (phase ,out-ph) (zones ,_)) out-st)
    (define wire3-restored?
      (and (= (list-ref out-bits 3) 0)
           (null? (list-ref out-anfs 3))))

    (when (and naive-ok? (not wire3-restored?))
      (set! naive-failures (+ naive-failures 1))
      (unless minimal-counterexample
        (define (f19-bug-pred? cand)
          (define ng (Synthesize-Circuit-Grade cand init-anfs init-zones 'naive))
          (define nok? (restoration-law-holds? ng init-anfs '(3) 'naive))
          (match-define `(wire-state (vals ,ob) (anf ,oa) (phase ,_) (zones ,_))
            (eval-circuit-raw cand init-st))
          (and nok?
               (not (and (= (list-ref ob 3) 0)
                         (null? (list-ref oa 3))))))
        (define shrunk (shrink-circuit bloated f19-bug-pred?))
        (set! minimal-counterexample
              (hash 'unshrunk-gate-count (circuit-gate-count bloated)
                    'shrunk-gate-count (circuit-gate-count shrunk)
                    'circuit shrunk
                    'input-bits in-bits
                    'output-bits out-bits
                    'output-anf-wire3 (list-ref out-anfs 3)
                    'output-phase out-ph))))
    (when (and nbe-ok? (not wire3-restored?))
      (set! nbe-complete-failures (+ nbe-complete-failures 1))))

  (hash 'issue-id 'F19-Kuperberg-Collimation-Sieve-Mismatched-Rank-Merge
        'trials trials
        'naive-soundness-failures naive-failures
        'nbe-complete-soundness-failures nbe-complete-failures
        'valid-matched-rank-sieves-accepted valid-matched-rank-accepted
        'minimal-counterexample minimal-counterexample
        'verified? (and (> naive-failures 0)
                        (= valid-matched-rank-accepted trials)
                        (= nbe-complete-failures 0))))

;; -----------------------------------------------------------------------------
;; ISSUE F20: Nested `c-par-diag` Inside `with-qfree` (`c-with-uncompute`) with
;;            Cross-Branch Zone Shuttle / Cat-Ebit Side-Effects (F4 x F7 x F8 x S6, 2,500 trials)
;; -----------------------------------------------------------------------------
;; Vulnerability in Naive Typing of Nested Parallel-Inside-Uncompute Blocks:
;;   Suppose `c-with-uncompute` wraps a `C_comp` containing a parallel diagonal
;;   composition `(c-par-diag B1 B2)` where branch `B1` shuttles shared control
;;   wire `0` to `StorageZone` (`(g-zone-shuttle 0 StorageZone)`) or mutates `0`
;;   while `B2` computes `(g-compute-and 0 1 3)`, or where `C_body` executes a
;;   cross-branch write `(c-par-diag (c-gate (g-cnot 2 0)) (c-gate (g-cnot 0 1)))`
;;   that aliases control wire `0` of `C_comp`!
;;   The naive rule accepts the nested block, causing `C_comp†` to uncompute with
;;   the mutated control `x_0 ^ x_2` and leaving ancilla wire `3` dirty (`|1>`).
;; Fix in `typeof-nbe-complete` (S12):
;;   Single-pass NbE threads exact zone and polynomial symbolic state through both
;;   `c-par-diag` branches and `c-with-uncompute`, enforcing `parallel-branches-disjoint?`,
;;   `circuit-unitary-qfree-invertible?`, and exact restoration `anfs_after_uncomp[3] == '()`.
;; -----------------------------------------------------------------------------
(define (fuzz-issue-f20-nested-pardiag-inside-withqfree-cross-branch-sideeffect [trials 2500])
  (define naive-failures 0)
  (define phase1-refined-failures 0)
  (define nbe-complete-failures 0)
  (define minimal-counterexample #f)

  (for ([trial (in-range trials)])
    ;; Core F20 bug: `c-with-uncompute` whose `C_comp` computes `w3 ^= w0 & w1` inside
    ;; a `c-par-diag`, and whose `C_body` runs a `c-par-diag` that both writes to `w0`
    ;; (`g-cnot 2 0`) and reads `w0` (`g-h 0`), corrupting the control wire `w0` before
    ;; `c-adjoint(C_comp)` runs!
    (define core-bug
      `(c-with-uncompute
        (c-par-diag (c-gate (g-compute-and 0 1 3))
                    (c-gate (g-z 2)))
        (c-par-diag (c-gate (g-cnot 2 0))
                    (c-gate (g-cnot 3 2)))))
    (define bloated (pad-circuit-for-shrinking core-bug))

    (define in-bits (list 1 1 1 0))
    (define init-anfs (initial-anf-env 4 '(3)))
    (define init-zones (make-list 4 'EntanglingZone))
    (define init-st `(wire-state (vals ,in-bits) (anf ,init-anfs) (phase 1) (zones ,init-zones)))

    (define g-naive (Synthesize-Circuit-Grade bloated init-anfs init-zones 'naive))
    (define g-p1    (Synthesize-Circuit-Grade bloated init-anfs init-zones 'phase1-refined))
    (define g-nbe   (Synthesize-NbE-Grade bloated init-anfs init-zones))

    (define naive-ok? (restoration-law-holds? g-naive init-anfs '(3) 'naive))
    (define p1-ok?    (restoration-law-holds? g-p1 init-anfs '(3) 'phase1-refined))
    (define nbe-ok?   (nbe-restoration-law-holds? g-nbe init-anfs '(3)))

    (define out-st (eval-circuit-raw bloated init-st))
    (match-define `(wire-state (vals ,out-bits) (anf ,out-anfs) (phase ,out-ph) (zones ,_)) out-st)
    (define wire3-restored?
      (and (= (list-ref out-bits 3) 0)
           (null? (list-ref out-anfs 3))
           (= out-ph 1)))

    (when (and naive-ok? (not wire3-restored?))
      (set! naive-failures (+ naive-failures 1))
      (unless minimal-counterexample
        (define (f20-bug-pred? cand)
          (define ng (Synthesize-Circuit-Grade cand init-anfs init-zones 'naive))
          (define nok? (restoration-law-holds? ng init-anfs '(3) 'naive))
          (match-define `(wire-state (vals ,ob) (anf ,oa) (phase ,_) (zones ,_))
            (eval-circuit-raw cand init-st))
          (and nok?
               (not (and (= (list-ref ob 3) 0)
                         (null? (list-ref oa 3))))))
        (define shrunk (shrink-circuit bloated f20-bug-pred?))
        (set! minimal-counterexample
              (hash 'unshrunk-gate-count (circuit-gate-count bloated)
                    'shrunk-gate-count (circuit-gate-count shrunk)
                    'circuit shrunk
                    'input-bits in-bits
                    'output-bits out-bits
                    'output-anf-wire3 (list-ref out-anfs 3)))))
    (when (and p1-ok? (not wire3-restored?))
      (set! phase1-refined-failures (+ phase1-refined-failures 1)))
    (when (and nbe-ok? (not wire3-restored?))
      (set! nbe-complete-failures (+ nbe-complete-failures 1))))

  (hash 'issue-id 'F20-Nested-ParDiag-Inside-WithQFree-Cross-Branch-SideEffect
        'trials trials
        'naive-soundness-failures naive-failures
        'phase1-refined-soundness-failures phase1-refined-failures
        'nbe-complete-soundness-failures nbe-complete-failures
        'minimal-counterexample minimal-counterexample
        'verified? (and (> naive-failures 0)
                        (= nbe-complete-failures 0))))

;; =============================================================================
;; 7. Exhaustive Fuzz Equivalence Proofs of:
;;    (a) Phase-2 Simplified Unified Grade Judgment (`typeof-unified`, S1-S3, 4,000 trials)
;;    (b) Phase-3 Canonical Minimal Grade & Surface QDo/Netlist Erasure
;;        (`typeof-canonical`, `desugar-qdo`, `with-qfree`, `erase-to-netlist`, S5-S8, 12,200 trials)
;;    (c) Phase-4 Certifying `IxQMonad -> VOQC -> Stim/BB` Compiler (`S9`, 2,500 trials)
;;    (d) Phase-4 SMT-LIB2 `QF_BV` Refinement Plugin Solver (`S10`, 2,700 trials)
;;    (e) Phase-4 Deep Random Stress Verification (`F1..F16`, 10,000 trials)
;; =============================================================================

(define (fuzz-verify-unified-simplification-equivalence [trials 4000])
  (define false-positives 0)
  (define false-negatives 0)
  (define valid-circuits-accepted 0)
  (define invalid-circuits-rejected 0)

  (for ([trial (in-range trials)])
    (define template
      (rand-choice
       '(valid-hmr-cz
         valid-with-uncompute-cz
         valid-dirty-borrow-2pass
         valid-pardiag-shared-ctrl
         valid-cat-entangle-disentangle
         invalid-f1-wrong-controls
         invalid-f2-mutate-ctrl
         invalid-f3-dirty-drift
         invalid-f4-pardiag-write-read
         invalid-f5-superpos-hmr
         invalid-f6-superpos-kickback
         invalid-f7-pardiag-h-cnot
         invalid-f8-cat-leak
         invalid-f8-cold-zone-hmr)))

    (define dirty-mode? (member template '(valid-dirty-borrow-2pass invalid-f3-dirty-drift)))
    (define init-anfs (if dirty-mode? (initial-anf-env 4 '()) (initial-anf-env 4 '(3))))
    (define init-zones (make-list 4 'EntanglingZone))

    (define circ
      (match template
        ['valid-hmr-cz
         `(c-seq (c-gate (g-compute-and 0 1 3))
                 (c-gate (g-hmr-cz 3 0 1 1)))]
        ['valid-with-uncompute-cz
         `(c-with-uncompute (c-gate (g-compute-and 0 1 3))
                            (c-gate (g-cz 2 3)))]
        ['valid-dirty-borrow-2pass
         `(c-seq (c-gate (g-ccx 0 1 3))
                 (c-seq (c-gate (g-cnot 3 2))
                        (c-seq (c-gate (g-cnot 3 2))
                               (c-gate (g-ccx 0 1 3)))))]
        ['valid-pardiag-shared-ctrl
         `(c-seq (c-par-diag (c-gate (g-cnot 0 1)) (c-gate (g-cnot 0 2)))
                 (c-par-diag (c-gate (g-cnot 0 1)) (c-gate (g-cnot 0 2))))]
        ['valid-cat-entangle-disentangle
         `(c-seq (c-gate (g-cat-entangle 0 3))
                 (c-seq (c-gate (g-cz 3 2))
                        (c-gate (g-cat-disentangle 0 3))))]
        ['invalid-f1-wrong-controls
         `(c-seq (c-gate (g-compute-and 0 2 3))
                 (c-gate (g-hmr-cz 3 0 1 1)))]
        ['invalid-f2-mutate-ctrl
         `(c-with-uncompute (c-gate (g-compute-and 0 1 3))
                            (c-gate (g-cnot 2 0)))]
        ['invalid-f3-dirty-drift
         `(c-seq (c-gate (g-ccx 0 1 3))
                 (c-seq (c-gate (g-cnot 2 0))
                        (c-gate (g-ccx 0 1 3))))]
        ['invalid-f4-pardiag-write-read
         `(c-par-diag (c-gate (g-cnot 1 0)) (c-gate (g-cnot 0 2)))]
        ['invalid-f5-superpos-hmr
         `(c-seq (c-gate (g-compute-and 0 1 3))
                 (c-seq (c-gate (g-h 0))
                        (c-seq (c-gate (g-hmr-cz 3 0 1 1))
                               (c-gate (g-h 0)))))]
        ['invalid-f6-superpos-kickback
         `(c-with-uncompute (c-gate (g-h 3)) (c-gate (g-z 3)))]
        ['invalid-f7-pardiag-h-cnot
         `(c-par-diag (c-gate (g-h 0)) (c-gate (g-cnot 0 2)))]
        ['invalid-f8-cat-leak
         `(c-seq (c-gate (g-cat-entangle 0 3)) (c-gate (g-cz 3 2)))]
        ['invalid-f8-cold-zone-hmr
         `(c-seq (c-gate (g-compute-and 0 1 3))
                 (c-seq (c-gate (g-zone-shuttle 0 StorageZone))
                        (c-gate (g-hmr-cz 3 0 1 1))))]))

    (define expected-valid?
      (not (not (member template
                        '(valid-hmr-cz
                          valid-with-uncompute-cz
                          valid-dirty-borrow-2pass
                          valid-pardiag-shared-ctrl
                          valid-cat-entangle-disentangle)))))

    (define ug (Synthesize-Unified-Grade circ init-anfs init-zones))
    (define unified-says-valid? (unified-restoration-law-holds? ug init-anfs '(3)))

    (if expected-valid?
        (if unified-says-valid?
            (set! valid-circuits-accepted (+ valid-circuits-accepted 1))
            (set! false-negatives (+ false-negatives 1)))
        (if (not unified-says-valid?)
            (set! invalid-circuits-rejected (+ invalid-circuits-rejected 1))
            (set! false-positives (+ false-positives 1)))))

  (hash 'suite-id 'S1-S3-Unified-Grade-Simplification-Equivalence
        'trials trials
        'valid-circuits-accepted valid-circuits-accepted
        'invalid-circuits-rejected invalid-circuits-rejected
        'false-positives false-positives
        'false-negatives false-negatives
        'verified? (and (= false-positives 0)
                        (= false-negatives 0)
                        (= (+ valid-circuits-accepted invalid-circuits-rejected) trials))))

;; Phase-3 Simplification Verification Suite (S5-S8, 12,200 total trials):
;;   - 6,200 trials: `typeof-canonical` (S8) across all 22 valid/invalid templates (F1..F12)
;;   - 3,000 trials: `desugar-qdo` & `with-qfree` (S5-S6) surface-to-core equivalence
;;   - 3,000 trials: `erase-to-netlist` (S7) zero-cost grade erasure semantic preservation
(define (fuzz-verify-canonical-simplification-s5-s8
         [canonical-trials 6200]
         [qdo-trials 3000]
         [erasure-trials 3000])
  (define false-positives 0)
  (define false-negatives 0)
  (define valid-accepted 0)
  (define invalid-rejected 0)

  (for ([_ (in-range canonical-trials)])
    (define template
      (rand-choice
       '(valid-hmr-cz
         valid-with-uncompute-cz
         valid-dirty-borrow-2pass
         valid-pardiag-shared-ctrl
         valid-cat-entangle-disentangle
         valid-f9-consolidated-cs
         valid-f10-locked-checkpoint
         valid-f11-symmetric-cswap-uncompute
         valid-f12-barriered-lifo-choreography
         invalid-f1-wrong-controls
         invalid-f2-mutate-ctrl
         invalid-f3-dirty-drift
         invalid-f4-pardiag-write-read
         invalid-f5-superpos-hmr
         invalid-f6-superpos-kickback
         invalid-f7-pardiag-h-cnot
         invalid-f8-cat-leak
         invalid-f8-cold-zone-hmr
         invalid-f9-premature-cs-phase
         invalid-f10-locked-pebble-overwrite
         invalid-f11-postswap-comparator-paradox
         invalid-f12-terhal-backlog
         invalid-f12-fifo-cat-deadlock)))

    (define dirty-mode? (member template '(valid-dirty-borrow-2pass invalid-f3-dirty-drift)))
    (define two-anc-mode?
      (member template '(valid-f12-barriered-lifo-choreography invalid-f12-fifo-cat-deadlock)))
    (define init-anfs
      (cond
        [dirty-mode? (initial-anf-env 4 '())]
        [two-anc-mode? (initial-anf-env 4 '(2 3))]
        [else (initial-anf-env 4 '(3))]))
    (define aux-wires (if two-anc-mode? '(2 3) '(3)))
    (define init-zones (make-list 4 'EntanglingZone))

    (define circ
      (match template
        ['valid-hmr-cz
         `(c-seq (c-gate (g-compute-and 0 1 3)) (c-gate (g-hmr-cz 3 0 1 1)))]
        ['valid-with-uncompute-cz
         `(c-with-uncompute (c-gate (g-compute-and 0 1 3)) (c-gate (g-cz 2 3)))]
        ['valid-dirty-borrow-2pass
         `(c-seq (c-gate (g-ccx 0 1 3))
                 (c-seq (c-gate (g-cnot 3 2))
                        (c-seq (c-gate (g-cnot 3 2))
                               (c-gate (g-ccx 0 1 3)))))]
        ['valid-pardiag-shared-ctrl
         `(c-seq (c-par-diag (c-gate (g-cnot 0 1)) (c-gate (g-cnot 0 2)))
                 (c-par-diag (c-gate (g-cnot 0 1)) (c-gate (g-cnot 0 2))))]
        ['valid-cat-entangle-disentangle
         `(c-seq (c-gate (g-cat-entangle 0 3))
                 (c-seq (c-gate (g-cz 3 2))
                        (c-gate (g-cat-disentangle 0 3))))]
        ['valid-f9-consolidated-cs
         `(c-with-uncompute
           (c-seq (c-gate (g-skew-add-cs 3)) (c-gate (g-consolidate-cs 3)))
           (c-gate (g-z 3)))]
        ['valid-f10-locked-checkpoint
         `(c-with-locked-pebble 3
            (c-gate (g-compute-and 0 1 3))
            (c-seq (c-gate (g-cnot 3 2)) (c-gate (g-cnot 3 2))))]
        ['valid-f11-symmetric-cswap-uncompute
         `(c-seq (c-gate (g-cmp-gt 0 1 3))
                 (c-seq (c-gate (g-cswap 3 0 1))
                        (c-seq (c-gate (g-cswap 3 0 1))
                               (c-gate (g-cmp-gt 0 1 3)))))]
        ['valid-f12-barriered-lifo-choreography
         `(c-seq (c-gate (g-fpga-feedforward 0 600))
                 (c-seq (c-gate (g-qec-barrier))
                        (c-seq (c-gate (g-cat-entangle 0 2))
                               (c-seq (c-gate (g-cat-entangle 1 3))
                                      (c-seq (c-gate (g-cat-disentangle 1 3))
                                             (c-gate (g-cat-disentangle 0 2)))))))]
        ['invalid-f1-wrong-controls
         `(c-seq (c-gate (g-compute-and 0 2 3)) (c-gate (g-hmr-cz 3 0 1 1)))]
        ['invalid-f2-mutate-ctrl
         `(c-with-uncompute (c-gate (g-compute-and 0 1 3)) (c-gate (g-cnot 2 0)))]
        ['invalid-f3-dirty-drift
         `(c-seq (c-gate (g-ccx 0 1 3))
                 (c-seq (c-gate (g-cnot 2 0)) (c-gate (g-ccx 0 1 3))))]
        ['invalid-f4-pardiag-write-read
         `(c-par-diag (c-gate (g-cnot 1 0)) (c-gate (g-cnot 0 2)))]
        ['invalid-f5-superpos-hmr
         `(c-seq (c-gate (g-compute-and 0 1 3))
                 (c-seq (c-gate (g-h 0))
                        (c-seq (c-gate (g-hmr-cz 3 0 1 1)) (c-gate (g-h 0)))))]
        ['invalid-f6-superpos-kickback
         `(c-with-uncompute (c-gate (g-h 3)) (c-gate (g-z 3)))]
        ['invalid-f7-pardiag-h-cnot
         `(c-par-diag (c-gate (g-h 0)) (c-gate (g-cnot 0 2)))]
        ['invalid-f8-cat-leak
         `(c-seq (c-gate (g-cat-entangle 0 3)) (c-gate (g-cz 3 2)))]
        ['invalid-f8-cold-zone-hmr
         `(c-seq (c-gate (g-compute-and 0 1 3))
                 (c-seq (c-gate (g-zone-shuttle 0 StorageZone))
                        (c-gate (g-hmr-cz 3 0 1 1))))]
        ['invalid-f9-premature-cs-phase
         `(c-seq (c-gate (g-skew-add-cs 3))
                 (c-seq (c-gate (g-z 3))
                        (c-seq (c-gate (g-consolidate-cs 3)) (c-gate (g-x 3)))))]
        ['invalid-f10-locked-pebble-overwrite
         `(c-with-locked-pebble 3
            (c-gate (g-compute-and 0 1 3))
            (c-gate (g-cnot 2 3)))]
        ['invalid-f11-postswap-comparator-paradox
         `(c-seq (c-gate (g-cmp-gt 0 1 3))
                 (c-seq (c-gate (g-cswap 3 0 1))
                        (c-gate (g-cmp-gt 0 1 3))))]
        ['invalid-f12-terhal-backlog
         `(c-seq (c-gate (g-fpga-feedforward 0 600))
                 (c-gate (g-fpga-feedforward 0 600)))]
        ['invalid-f12-fifo-cat-deadlock
         `(c-seq (c-gate (g-cat-entangle 0 2))
                 (c-seq (c-gate (g-cat-entangle 1 3))
                        (c-seq (c-gate (g-cat-disentangle 0 2))
                               (c-gate (g-cat-disentangle 1 3)))))]))

    (define expected-valid?
      (not (not (member template
                        '(valid-hmr-cz
                          valid-with-uncompute-cz
                          valid-dirty-borrow-2pass
                          valid-pardiag-shared-ctrl
                          valid-cat-entangle-disentangle
                          valid-f9-consolidated-cs
                          valid-f10-locked-checkpoint
                          valid-f11-symmetric-cswap-uncompute
                          valid-f12-barriered-lifo-choreography)))))

    (define cg (Synthesize-Canonical-Grade circ init-anfs init-zones))
    (define canonical-says-valid? (canonical-restoration-law-holds? cg init-anfs aux-wires))

    (if expected-valid?
        (if canonical-says-valid?
            (set! valid-accepted (+ valid-accepted 1))
            (set! false-negatives (+ false-negatives 1)))
        (if (not canonical-says-valid?)
            (set! invalid-rejected (+ invalid-rejected 1))
            (set! false-positives (+ false-positives 1)))))

  ;; Verify S5 & S6 (`qdo`, `with-qfree`, `with-pebble-ckpt` desugaring) across 3,000 trials
  (define qdo-desugar-ok?
    (for/and ([_ (in-range qdo-trials)])
      (define surf-term
        (rand-choice
         (list
          '(with-qfree
            (qdo ((seq (q-prim (g-skew-add-cs 3))))
                 (q-prim (g-consolidate-cs 3)))
            (q-prim (g-z 3)))
          '(with-pebble-ckpt 3
             (q-prim (g-compute-and 0 1 3))
             (qdo ((seq (q-prim (g-cnot 3 2))))
                  (q-prim (g-cnot 3 2))))
          '(qdo ((par (q-prim (g-cnot 0 1)) (q-prim (g-cnot 0 2))))
                (qdo ((par (q-prim (g-cnot 0 1)) (q-prim (g-cnot 0 2))))
                     (q-prim (g-id)))))))
      (define desugared (term (desugar-qdo ,surf-term)))
      (define init-anfs (initial-anf-env 4 '(3)))
      (define init-zones (make-list 4 'EntanglingZone))
      (define cg (Synthesize-Canonical-Grade desugared init-anfs init-zones))
      (and (surface-qterm? surf-term)
           (pair? desugared)
           (canonical-restoration-law-holds? cg init-anfs '(3)))))

  ;; Verify S7 (`erase-to-netlist` zero-cost grade erasure semantic preservation) across 3,000 trials
  (define erasure-ok?
    (for/and ([_ (in-range erasure-trials)])
      (define circ
        (rand-choice
         (list
          '(c-with-uncompute
            (c-seq (c-gate (g-compute-and 0 1 3))
                   (c-gate (g-cnot 3 2)))
            (c-gate (g-z 2)))
          '(c-with-locked-pebble 3
             (c-gate (g-compute-and 0 1 3))
             (c-seq (c-gate (g-cnot 3 2)) (c-gate (g-cnot 3 2))))
          '(c-seq (c-gate (g-cmp-gt 0 1 3))
                  (c-seq (c-gate (g-cswap 3 0 1))
                         (c-seq (c-gate (g-cswap 3 0 1))
                                (c-gate (g-cmp-gt 0 1 3))))))))
      (define netlist (term (erase-to-netlist ,circ)))
      (define in-bits (list (rand-int 0 1) (rand-int 0 1) (rand-int 0 1) 0))
      (define init-anfs (initial-anf-env 4 '(3)))
      (define init-zones (make-list 4 'EntanglingZone))
      (define init-st `(wire-state (vals ,in-bits) (anf ,init-anfs) (phase 1) (zones ,init-zones)))
      (define st-circ (eval-circuit-raw circ init-st))
      (define st-net  (eval-netlist-raw netlist init-st))
      (and (list? netlist)
           (equal? st-circ st-net))))

  (define total (+ canonical-trials qdo-trials erasure-trials))
  (hash 'suite-id 'S5-S8-Canonical-Minimal-Grade-and-Surface-Erasure
        'trials total
        'canonical-equivalence-trials canonical-trials
        'qdo-with-qfree-desugar-trials qdo-trials
        'erase-to-netlist-trials erasure-trials
        'valid-circuits-accepted valid-accepted
        'invalid-circuits-rejected invalid-rejected
        'false-positives false-positives
        'false-negatives false-negatives
        'qdo-desugar-ok? qdo-desugar-ok?
        'netlist-erasure-semantic-preservation-ok? erasure-ok?
        'verified? (and (= false-positives 0)
                        (= false-negatives 0)
                        qdo-desugar-ok?
                        erasure-ok?)))

;; -----------------------------------------------------------------------------
;; Phase-4 Simplification S9 Verification Suite (2,500 trials):
;; Certifying `IxQMonad -> VOQC -> Stim/BB-qLDPC` Compiler Pipeline
;; (`compile-ixqmonad-to-stim-bb`)
;; -----------------------------------------------------------------------------
(define (fuzz-verify-s9-certifying-ixqmonad-voqc-stim-compiler [trials 2500])
  (define compiled-ok-count 0)
  (define semantic-eq-failures 0)
  (define total-gates-eliminated 0)

  (for ([_ (in-range trials)])
    (define prog
      (rand-choice
       (list
        ;; Surface IxQMonad with redundant commuting CNOTs + with-qfree + Stim detector
        '(qdo ((seq (q-prim (g-cnot 0 1)))
               (seq (q-prim (g-cnot 0 2)))
               (seq (q-prim (g-cnot 0 1)))
               (seq (with-qfree
                     (q-prim (g-compute-and 0 1 3))
                     (q-prim (g-cz 2 3)))))
              (q-prim (g-stim-detector 3)))
        ;; Surface IxQMonad with locked checkpoint pebble + redundant X pair + BB torus shift
        '(qdo ((seq (q-prim (g-x 2)))
               (seq (q-prim (g-x 2)))
               (seq (with-pebble-ckpt 3
                      (q-prim (g-compute-and 0 1 3))
                      (qdo ((seq (q-prim (g-cnot 3 2))))
                           (q-prim (g-cnot 3 2)))))
               (seq (q-prim (g-css-round-begin Superpos)))
               (seq (q-prim (g-css-round-end Superpos))))
              (q-prim (g-bb-torus-shift 2 1)))
        ;; GradedCircuit with non-commuting H-Z-H that canonical VOQC must preserve
        '(c-seq (c-gate (g-h 3))
                (c-seq (c-gate (g-z 3))
                       (c-seq (c-gate (g-h 3))
                              (c-seq (c-gate (g-x 3))
                                     (c-gate (g-stim-detector 3)))))))))

    (define init-anfs (initial-anf-env 4 '(3)))
    (define init-zones (make-list 4 'EntanglingZone))
    (define pkg (compile-ixqmonad-to-stim-bb prog init-anfs init-zones '(3) 0.001))
    (define raw-circ (hash-ref pkg 'desugared-circuit))
    (define opt-circ (hash-ref pkg 'optimized-circuit))
    (define netlist  (hash-ref pkg 'erased-netlist))
    (define cert-ok? (hash-ref pkg 'certified-ok?))
    (define stim-src (hash-ref pkg 'stim-source))
    (define g-before (hash-ref pkg 'unoptimized-gate-count))
    (define g-after  (hash-ref pkg 'optimized-gate-count))

    (define in-bits (list (rand-int 0 1) (rand-int 0 1) (rand-int 0 1) 0))
    (define init-st `(wire-state (vals ,in-bits) (anf ,init-anfs) (phase 1) (zones ,init-zones)))
    (define st-raw (eval-circuit-raw raw-circ init-st))
    (define st-opt (eval-circuit-raw opt-circ init-st))
    (define st-net (eval-netlist-raw netlist init-st))

    (define sem-ok?
      (and cert-ok?
           (<= g-after g-before)
           (equal? st-raw st-opt)
           (equal? st-raw st-net)
           (string-contains? stim-src "QUBIT_COORDS")
           (string-contains? stim-src "TICK")))

    (set! total-gates-eliminated (+ total-gates-eliminated (- g-before g-after)))
    (if sem-ok?
        (set! compiled-ok-count (+ compiled-ok-count 1))
        (set! semantic-eq-failures (+ semantic-eq-failures 1))))

  (hash 'suite-id 'S9-Certifying-IxQMonad-VOQC-Stim-BB-Compiler
        'trials trials
        'certified-compilations-succeeded compiled-ok-count
        'semantic-equivalence-failures semantic-eq-failures
        'total-redundant-gates-eliminated total-gates-eliminated
        'verified? (and (= compiled-ok-count trials)
                        (= semantic-eq-failures 0)
                        (> total-gates-eliminated 0))))

;; -----------------------------------------------------------------------------
;; Phase-4 Simplification S10 Verification Suite (2,700 trials):
;; SMT-LIB2 `QF_BV` & Symbolic `F_2[x]` Refinement Plugin Solver
;; (`emit-smtlib2-qfree-anf-obligation`, `discharge-refinement-plugin-vc`)
;; -----------------------------------------------------------------------------
(define (fuzz-verify-s10-smtlib2-refinement-plugin-solver [trials 2700])
  (define valid-vc-discharged 0)
  (define invalid-vc-rejected 0)
  (define false-positives 0)
  (define false-negatives 0)

  (for ([_ (in-range trials)])
    (define template
      (rand-choice
       '(valid-hmr-cz
         valid-with-uncompute-cz
         valid-f9-consolidated-cs
         valid-f10-locked-checkpoint
         valid-f11-symmetric-cswap-uncompute
         valid-f13-voqc-commuting-cancel
         valid-f14-clean-stim-detector
         valid-f15-clean-refinement-widen
         valid-f16-closed-bb-css-round
         invalid-f1-wrong-controls
         invalid-f2-mutate-ctrl
         invalid-f5-superpos-hmr
         invalid-f6-superpos-kickback
         invalid-f8-cat-leak
         invalid-f9-premature-cs-phase
         invalid-f10-locked-pebble-overwrite
         invalid-f11-postswap-comparator-paradox
         invalid-f12-terhal-backlog
         invalid-f14-superpos-stim-detector
         invalid-f14-dirty-stim-detector
         invalid-f15-widen-drops-redundant-cs
         invalid-f15-widen-drops-pebble-lock
         invalid-f16-torus-shift-open-css-round
         invalid-f16-mismatched-css-round)))

    (define init-anfs (initial-anf-env 4 '(3)))
    (define init-zones (make-list 4 'EntanglingZone))

    (define circ
      (match template
        ['valid-hmr-cz
         `(c-seq (c-gate (g-compute-and 0 1 3)) (c-gate (g-hmr-cz 3 0 1 1)))]
        ['valid-with-uncompute-cz
         `(c-with-uncompute (c-gate (g-compute-and 0 1 3)) (c-gate (g-cz 2 3)))]
        ['valid-f9-consolidated-cs
         `(c-with-uncompute
           (c-seq (c-gate (g-skew-add-cs 3)) (c-gate (g-consolidate-cs 3)))
           (c-gate (g-z 3)))]
        ['valid-f10-locked-checkpoint
         `(c-with-locked-pebble 3
            (c-gate (g-compute-and 0 1 3))
            (c-seq (c-gate (g-cnot 3 2)) (c-gate (g-cnot 3 2))))]
        ['valid-f11-symmetric-cswap-uncompute
         `(c-seq (c-gate (g-cmp-gt 0 1 3))
                 (c-seq (c-gate (g-cswap 3 0 1))
                        (c-seq (c-gate (g-cswap 3 0 1))
                               (c-gate (g-cmp-gt 0 1 3)))))]
        ['valid-f13-voqc-commuting-cancel
         `(c-voqc-opt
           (c-seq (c-gate (g-cnot 0 1))
                  (c-seq (c-gate (g-cnot 0 2))
                         (c-gate (g-cnot 0 1)))))]
        ['valid-f14-clean-stim-detector
         `(c-seq (c-with-uncompute (c-gate (g-compute-and 0 1 3)) (c-gate (g-cz 2 3)))
                 (c-gate (g-stim-detector 3)))]
        ['valid-f15-clean-refinement-widen
         `(c-seq (c-with-uncompute (c-gate (g-compute-and 0 1 3)) (c-gate (g-z 2)))
                 (c-unsafe-widen-refinement 3 (c-gate (g-stim-detector 3))))]
        ['valid-f16-closed-bb-css-round
         `(c-seq (c-gate (g-css-round-begin Superpos))
                 (c-seq (c-gate (g-css-round-end Superpos))
                        (c-gate (g-bb-torus-shift 2 1))))]
        ['invalid-f1-wrong-controls
         `(c-seq (c-gate (g-compute-and 0 2 3)) (c-gate (g-hmr-cz 3 0 1 1)))]
        ['invalid-f2-mutate-ctrl
         `(c-with-uncompute (c-gate (g-compute-and 0 1 3)) (c-gate (g-cnot 2 0)))]
        ['invalid-f5-superpos-hmr
         `(c-seq (c-gate (g-compute-and 0 1 3))
                 (c-seq (c-gate (g-h 0))
                        (c-seq (c-gate (g-hmr-cz 3 0 1 1)) (c-gate (g-h 0)))))]
        ['invalid-f6-superpos-kickback
         `(c-with-uncompute (c-gate (g-h 3)) (c-gate (g-z 3)))]
        ['invalid-f8-cat-leak
         `(c-seq (c-gate (g-cat-entangle 0 3)) (c-gate (g-cz 3 2)))]
        ['invalid-f9-premature-cs-phase
         `(c-seq (c-gate (g-skew-add-cs 3))
                 (c-seq (c-gate (g-z 3))
                        (c-seq (c-gate (g-consolidate-cs 3)) (c-gate (g-x 3)))))]
        ['invalid-f10-locked-pebble-overwrite
         `(c-with-locked-pebble 3
            (c-gate (g-compute-and 0 1 3))
            (c-gate (g-cnot 2 3)))]
        ['invalid-f11-postswap-comparator-paradox
         `(c-seq (c-gate (g-cmp-gt 0 1 3))
                 (c-seq (c-gate (g-cswap 3 0 1))
                        (c-gate (g-cmp-gt 0 1 3))))]
        ['invalid-f12-terhal-backlog
         `(c-seq (c-gate (g-fpga-feedforward 0 600))
                 (c-gate (g-fpga-feedforward 0 600)))]
        ['invalid-f14-superpos-stim-detector
         `(c-seq (c-gate (g-h 3))
                 (c-seq (c-gate (g-stim-detector 3))
                        (c-gate (g-h 3))))]
        ['invalid-f14-dirty-stim-detector
         `(c-with-uncompute (c-gate (g-compute-and 0 1 3))
                            (c-gate (g-stim-detector 3)))]
        ['invalid-f15-widen-drops-redundant-cs
         `(c-seq (c-gate (g-skew-add-cs 3))
                 (c-unsafe-widen-refinement 3
                   (c-seq (c-gate (g-z 3)) (c-gate (g-x 3)))))]
        ['invalid-f15-widen-drops-pebble-lock
         `(c-with-locked-pebble 3
            (c-gate (g-compute-and 0 1 3))
            (c-unsafe-widen-refinement 3 (c-gate (g-cnot 2 3))))]
        ['invalid-f16-torus-shift-open-css-round
         `(c-seq (c-gate (g-css-round-begin Superpos))
                 (c-seq (c-gate (g-bb-torus-shift 1 1))
                        (c-gate (g-css-round-end Superpos))))]
        ['invalid-f16-mismatched-css-round
         `(c-seq (c-gate (g-css-round-begin Superpos))
                 (c-gate (g-css-round-end QFree)))]))

    (define expected-valid?
      (not (not (member template
                        '(valid-hmr-cz
                          valid-with-uncompute-cz
                          valid-f9-consolidated-cs
                          valid-f10-locked-checkpoint
                          valid-f11-symmetric-cswap-uncompute
                          valid-f13-voqc-commuting-cancel
                          valid-f14-clean-stim-detector
                          valid-f15-clean-refinement-widen
                          valid-f16-closed-bb-css-round)))))

    (define vc-res (discharge-refinement-plugin-vc circ init-anfs init-zones '(3)))
    (define vc-ok? (hash-ref vc-res 'vc-discharged?))
    (define smt-q  (hash-ref vc-res 'smtlib2-query))
    (define smt-well-formed?
      (and (string-contains? smt-q "(set-logic QF_BV)")
           (string-contains? smt-q "(check-sat)")))

    (if expected-valid?
        (if (and vc-ok? smt-well-formed?)
            (set! valid-vc-discharged (+ valid-vc-discharged 1))
            (set! false-negatives (+ false-negatives 1)))
        (if (and (not vc-ok?) smt-well-formed?)
            (set! invalid-vc-rejected (+ invalid-vc-rejected 1))
            (set! false-positives (+ false-positives 1)))))

  (hash 'suite-id 'S10-SMTLIB2-QF-BV-Refinement-Plugin-Solver
        'trials trials
        'valid-vc-discharged valid-vc-discharged
        'invalid-vc-rejected invalid-vc-rejected
        'false-positives false-positives
        'false-negatives false-negatives
        'verified? (and (= false-positives 0)
                        (= false-negatives 0)
                        (= (+ valid-vc-discharged invalid-vc-rejected) trials))))

;; -----------------------------------------------------------------------------
;; Phase-4 Deep Random Stress Verification Suite (10,000 trials):
;; Generates random sequential compositions of Phase 1..4 blocks (including
;; VOQC optimization blocks, Stim detectors, refinement widenings, locked pebbles,
;; and Bivariate Bicycle CSS syndrome rounds) and verifies 0 soundness failures
;; on `typeof-certified-compiler` across 10,000 randomized executions!
;; -----------------------------------------------------------------------------
(define (fuzz-verify-phase4-deep-random-stress [trials 10000])
  (define certified-accepted 0)
  (define certified-rejected 0)
  (define soundness-failures 0)

  (define (random-phase4-block)
    (rand-choice
     (list
      ;; Valid composable blocks (preserve wire 3 == |0> and CSSClosed):
      '(c-with-uncompute (c-gate (g-compute-and 0 1 3))
                         (c-seq (c-gate (g-cnot 3 2)) (c-gate (g-cnot 3 2))))
      '(c-with-locked-pebble 3
         (c-gate (g-compute-and 0 1 3))
         (c-seq (c-gate (g-cnot 3 2)) (c-gate (g-cnot 3 2))))
      '(c-seq (c-gate (g-compute-and 0 1 3)) (c-gate (g-hmr-cz 3 0 1 0)))
      '(c-voqc-opt
        (c-seq (c-gate (g-cnot 0 1))
               (c-seq (c-gate (g-cnot 0 2))
                      (c-seq (c-gate (g-cnot 0 1))
                             (c-gate (g-cnot 0 2))))))
      '(c-seq (c-gate (g-stim-detector 3))
              (c-unsafe-widen-refinement 3 (c-gate (g-stim-detector 3))))
      '(c-seq (c-gate (g-css-round-begin Superpos))
              (c-seq (c-gate (g-css-round-end Superpos))
                     (c-seq (c-gate (g-bb-torus-shift 1 2))
                            (c-gate (g-qec-barrier)))))
      ;; Adversarial / bug-injecting blocks (must be rejected if they corrupt state):
      '(c-seq (c-gate (g-h 3))
              (c-seq (c-gate (g-stim-detector 3))
                     (c-gate (g-h 3))))
      '(c-seq (c-gate (g-skew-add-cs 3))
              (c-unsafe-widen-refinement 3
                (c-seq (c-gate (g-z 3)) (c-gate (g-x 3)))))
      '(c-seq (c-gate (g-css-round-begin Superpos))
              (c-seq (c-gate (g-bb-torus-shift 3 1))
                     (c-gate (g-css-round-end Superpos))))
      '(c-with-locked-pebble 3
         (c-gate (g-compute-and 0 1 3))
         (c-unsafe-widen-refinement 3 (c-gate (g-cnot 2 3)))))))

  (for ([_ (in-range trials)])
    (define b1 (random-phase4-block))
    (define b2 (random-phase4-block))
    (define circ `(c-seq ,b1 (c-seq (c-gate (g-qec-barrier)) ,b2)))

    (define init-anfs (initial-anf-env 4 '(3)))
    (define init-zones (make-list 4 'EntanglingZone))
    (define certg (Synthesize-Certified-Compiler-Grade circ init-anfs init-zones))
    (define cert-ok? (certified-compiler-restoration-law-holds? certg init-anfs '(3)))

    (define in-bits (list 1 1 (rand-int 0 1) 0))
    (define init-st `(wire-state (vals ,in-bits) (anf ,init-anfs) (phase 1) (zones ,init-zones)))
    (define out-st (eval-circuit-raw circ init-st))
    (match-define `(wire-state (vals ,out-bits) (anf ,out-anfs) (phase ,out-ph) (zones ,_)) out-st)
    (define runtime-clean?
      (and (= (list-ref out-bits 3) 0)
           (null? (list-ref out-anfs 3))
           (= out-ph 1)))

    (if cert-ok?
        (begin
          (set! certified-accepted (+ certified-accepted 1))
          (unless runtime-clean?
            (set! soundness-failures (+ soundness-failures 1))))
        (set! certified-rejected (+ certified-rejected 1))))

  (hash 'suite-id 'Phase4-Deep-Random-Stress-10000
        'trials trials
        'certified-circuits-accepted certified-accepted
        'certified-circuits-rejected certified-rejected
        'soundness-failures soundness-failures
        'verified? (and (> certified-accepted 0)
                        (> certified-rejected 0)
                        (= soundness-failures 0))))

;; =============================================================================
;; 8. High-Iteration Fuzz Verification of All Intrinsic QDS-1..6 & Refinements 1..8
;;    (4,200 additional trials + PLT Redex `redex-check` property checks)
;; =============================================================================

(define (fuzz-verify-intrinsic-qds-and-refinements [trials-per-suite 1000])
  ;; Suite A (1,000 trials): CanonicalSkewNum bijection, O(1) inc/dec inverse, and Redex eval-qds
  (define skew-ok?
    (let loop ([i 0] [cur 'skew-zero])
      (if (= i trials-per-suite)
          #t
          (let* ([val-ok? (= (canonical-skew-val cur) i)]
                 [nxt (term (eval-qds (qds-skew-inc ,cur)))]
                 [nxt-ok? (= (canonical-skew-val nxt) (+ i 1))]
                 [dec-nxt (term (eval-qds (qds-skew-dec ,nxt)))]
                 [inv-ok? (equal? dec-nxt cur)]
                 [redex-term-ok? (redex-match? QuantumTypeTheoryL CanonicalSkewNum nxt)])
            (and val-ok? nxt-ok? inv-ok? redex-term-ok?
                 (loop (+ i 1) nxt))))))

  ;; Suite B (1,000 trials): CritBitTrie history independence across random key pairs & triples
  ;;                         + zero-tombstone reversible deletion
  (define crit-bit-ok?
    (for/and ([_ (in-range trials-per-suite)])
      (define k1 (rand-int 1 1023))
      (define k2 (rand-int 1 1023))
      (define k3 (rand-int 1 1023))
      (define t123 (cb-insert (cb-insert (cb-insert 'crit-mt k1) k2) k3))
      (define t312 (cb-insert (cb-insert (cb-insert 'crit-mt k3) k1) k2))
      (define t231 (cb-insert (cb-insert (cb-insert 'crit-mt k2) k3) k1))
      (define del-ok?
        (if (or (= k3 k1) (= k3 k2))
            #t
            (equal? (cb-delete t123 k3)
                    (cb-insert (cb-insert 'crit-mt k1) k2))))
      (and (equal? t123 t312)
           (equal? t123 t231)
           del-ok?
           (redex-match? QuantumTypeTheoryL CritBitTrie t123))))

  ;; Suite C (1,000 trials): IntrinsicBraunTree balance invariant 0 <= |L|-|R| <= 1,
  ;;                         IntrinsicRealTimeQueue worst-case O(1) schedule invariant,
  ;;                         and IntrinsicFingerNode monoid measure soundness
  (define braun-rtq-finger-ok?
    (let loop ([i 0]
               [bt 'braun-mt]
               [rtq '(rt-queue () () ())])
      (if (= i trials-per-suite)
          #t
          (let* ([bt-next (term (eval-qds (qds-braun-insert ,bt ,i)))]
                 [bt-ok? (and (braun-invariant-valid? bt-next)
                              (= (braun-size bt-next) (+ i 1)))]
                 [rtq-next (term (eval-qds (qds-rtq-snoc ,rtq ,i)))]
                 [rtq-ok? (match rtq-next
                            [`(rt-queue ,f ,r ,s)
                             (= (length s) (- (length f) (length r)))]
                            [_ #f])]
                 [m1 `(gp-measure ,(rand-int 0 1) ,(rand-int 0 1))]
                 [m2 `(gp-measure ,(rand-int 0 1) ,(rand-int 0 1))]
                 [m3 `(gp-measure ,(rand-int 0 1) ,(rand-int 0 1))]
                 [fn1 `(finger-leaf ,m1 0)]
                 [fn2 `(finger-leaf ,m2 1)]
                 [fn3 `(finger-leaf ,m3 2)]
                 [fn-node `(finger-node3 ,(gp-combine (gp-combine m1 m2) m3) ,fn1 ,fn2 ,fn3)]
                 [fn-ok? (finger-node-valid? fn-node)])
            (and bt-ok? rtq-ok? fn-ok?
                 (loop (+ i 1) bt-next rtq-next))))))

  ;; Suite D (1,000 trials): HardwareZone Coeffect Safety, ClockedStream Pauli-X Twirl Cancellation,
  ;;                         and ChoreographicSession Distributed Ebit Accounting
  (define coeffects-session-stream-ok?
    (for/and ([_i (in-range trials-per-suite)])
      (define storage-zones '(StorageZone StorageZone StorageZone StorageZone))
      (define bad-zone-circ '(c-gate (g-cnot 0 1)))
      (define good-zone-circ
        '(c-seq (c-gate (g-zone-shuttle 0 EntanglingZone))
                (c-seq (c-gate (g-zone-shuttle 1 EntanglingZone))
                       (c-gate (g-cnot 0 1)))))
      (define bad-grade (Synthesize-Circuit-Grade bad-zone-circ default-4wire-anfs storage-zones 'refined))
      (define good-grade (Synthesize-Circuit-Grade good-zone-circ default-4wire-anfs storage-zones 'refined))
      (define zone-check-ok?
        (and (not (second (assoc 'well-typed? (cdr bad-grade))))
             (second (assoc 'well-typed? (cdr good-grade)))))

      (define sess
        '(sess-cat-entangle 0 1
           (sess-local-diag 1
             (sess-cat-disentangle 0 1
               (sess-cat-entangle 0 2
                 (sess-cat-disentangle 0 2 sess-end))))))
      (define sess-res (term (eval-qds (qds-session-cost ,sess))))
      (define sess-ok? (equal? sess-res '(skew-single 2 mt-tail)))

      (define st0 '(clocked-stream 0 TwirlEven ()))
      (define st1 (term (eval-qds (qds-stream-tick ,st0 1))))
      (define st2 (term (eval-qds (qds-stream-tick ,st1 1))))
      (define stream-ok? (equal? st2 '(clocked-stream 2 TwirlEven (1 1))))

      (and zone-check-ok? sess-ok? stream-ok?)))

  ;; Suite E: Direct PLT Redex `redex-check` randomized grammar generation (200 trials)
  (define redex-check-count 0)
  (redex-check
   QuantumTypeTheoryL
   CanonicalSkewNum
   (begin
     (set! redex-check-count (+ redex-check-count 1))
     (define s (term CanonicalSkewNum))
     (define inc-s (canonical-skew-inc s))
     (define dec-inc-s (canonical-skew-dec inc-s))
     (and (= (canonical-skew-val inc-s) (+ (canonical-skew-val s) 1))
          (equal? dec-inc-s s)))
   #:attempts 200
   #:print? #f)

  (hash 'canonical-skew-1000-trials-ok? skew-ok?
        'crit-bit-history-independence-1000-trials-ok? crit-bit-ok?
        'braun-rtq-finger-1000-trials-ok? braun-rtq-finger-ok?
        'coeffects-session-stream-1000-trials-ok? coeffects-session-stream-ok?
        'redex-check-grammar-attempts redex-check-count
        'total-qds-refinement-trials (+ (* 4 trials-per-suite) redex-check-count)
        'verified? (and skew-ok?
                        crit-bit-ok?
                        braun-rtq-finger-ok?
                        coeffects-session-stream-ok?
                        (= redex-check-count 200))))

;; -----------------------------------------------------------------------------
;; Simplification S11 Verification Suite (2,500 trials):
;;   Verifies the Generic Quantum Container (`QContainer S P M`) catamorphism
;;   `eval-qcontainer-fold`, the 4 new Okasaki QDS structures (`QDS-10..13`:
;;   `CatenableDeque`, `SegmentedBitmask`, `LazyPebbleTree`, `PersistentUnionFind`),
;;   and all 10 Canonical Quantum Algorithm & Protocol Instantiations (`OQP-1..10`)
;;   via `eval-oqp-circuit` + `typeof-nbe-complete`.
;; -----------------------------------------------------------------------------
(define (fuzz-verify-s11-qcontainer-and-oqp1-to-10 [trials 2500])
  (define qcontainer-folds-ok 0)
  (define qds10-to-13-ok 0)
  (define oqp1-to-10-certified 0)
  (define failures 0)

  (define all-oqp-specs
    '(oqp1-qrng-braun-tree
      oqp2-shor-skew-carry-save
      oqp3-grover-critbit-oracle
      oqp4-ambainis-ed-radix-walk
      oqp5-kuperberg-collimation-sieve
      oqp6-magic-state-cultivation-fifo
      oqp7-tree-qram-bucket-brigade
      oqp8-hierarchical-pebbling-f2poly
      oqp9-distributed-cat-choreography
      oqp10-sliding-window-syndrome-deque))

  (for ([_ (in-range trials)])
    (define sh (rand-choice '(ShapeSkew
                              ShapeBraun
                              ShapeFinger
                              ShapeCritBit
                              ShapeCatDeque
                              ShapeSegBitmask
                              ShapePebbleTree
                              ShapeUnionFind)))
    (define p0 (rand-int 0 15))
    (define p1 (rand-int 0 15))
    (define p2 (rand-int 0 15))
    (define m `(gp-measure ,(rand-int 0 1) ,(rand-int 0 1)))
    (define qc `(qcontainer (shape ,sh) (arity 3) (measure ,m) (payload (,p0 ,p1 ,p2))))
    (define folded (term (eval-qcontainer-fold ,qc)))
    (define folded-via-qds (term (eval-qds (qds-qcontainer-fold ,qc))))
    (define qc-ok?
      (and (pair? qc)
           (equal? folded `(finger-leaf ,m ,(+ p0 p1 p2)))
           (equal? folded folded-via-qds)))

    ;; Test QDS-10..13 operations via `eval-qds`
    (define cd-out (term (eval-qds (qds-cat-deque-append (cat-deque (,p0) (,p1))
                                                         (cat-deque (,p2) (0))))))
    (define sb-out (term (eval-qds (qds-seg-bitmask-xor (seg-bitmask (,p0 ,p1))
                                                        (seg-bitmask (,p1 ,p0))))))
    (define pt-out (term (eval-qds (qds-pebble-tree-build 4 3))))
    (define puf-out (term (eval-qds (qds-puf-union (puf-forest ((puf-node 0 0 0) (puf-node 1 1 0))) 0 1))))
    (define qds10-13-step-ok?
      (and (pair? cd-out) (eq? (car cd-out) 'cat-deque)
           (pair? sb-out) (eq? (car sb-out) 'seg-bitmask)
           (equal? sb-out `(seg-bitmask (,(bitwise-xor p0 p1) ,(bitwise-xor p1 p0))))
           (pair? pt-out) (eq? (car pt-out) 'pebble-node)
           (pair? puf-out) (eq? (car puf-out) 'puf-forest)))

    ;; Test OQP-1..10 circuit synthesis & `typeof-nbe-complete` certification
    (define spec (rand-choice all-oqp-specs))
    (define oqp-circ (term (eval-oqp-circuit ,spec)))
    (define init-anfs (initial-anf-env 4 '(3)))
    (define init-zones (make-list 4 'EntanglingZone))
    (define nbeg (Synthesize-NbE-Grade oqp-circ init-anfs init-zones))
    (define oqp-ok?
      (and (symbol? spec)
           (pair? oqp-circ)
           (nbe-restoration-law-holds? nbeg init-anfs '(3))))

    (if (and qc-ok? qds10-13-step-ok? oqp-ok?)
        (begin
          (set! qcontainer-folds-ok (+ qcontainer-folds-ok 1))
          (set! qds10-to-13-ok (+ qds10-to-13-ok 1))
          (set! oqp1-to-10-certified (+ oqp1-to-10-certified 1)))
        (set! failures (+ failures 1))))

  (hash 'suite-id 'S11-QContainer-QDS10to13-and-OQP1to10-Unification
        'trials trials
        'qcontainer-folds-ok qcontainer-folds-ok
        'qds10-to-13-operations-ok qds10-to-13-ok
        'oqp1-to-10-circuits-certified oqp1-to-10-certified
        'failures failures
        'verified? (and (= failures 0)
                        (= qcontainer-folds-ok trials)
                        (= qds10-to-13-ok trials)
                        (= oqp1-to-10-certified trials))))

;; -----------------------------------------------------------------------------
;; Simplification S12 Verification Suite (2,700 trials):
;;   Verifies Single-Pass Canonical NbE (`eval-canonical-nbe` and `typeof-nbe-complete`)
;;   across all 29 valid & adversarial templates spanning F1..F20 and OQP-1..10,
;;   proving 0 false positives, 0 false negatives, and exact semantic preservation
;;   between original circuits and their `eval-canonical-nbe` normal forms.
;; -----------------------------------------------------------------------------
(define (fuzz-verify-s12-single-pass-canonical-nbe [trials 2700])
  (define valid-accepted 0)
  (define invalid-rejected 0)
  (define false-positives 0)
  (define false-negatives 0)
  (define nbe-semantic-mismatches 0)

  (for ([_ (in-range trials)])
    (define template
      (rand-choice
       '(valid-hmr-cz
         valid-with-uncompute-cz
         valid-pardiag-shared-ctrl
         valid-cat-entangle-disentangle
         valid-f9-consolidated-cs
         valid-f10-locked-checkpoint
         valid-f11-symmetric-cswap-uncompute
         valid-f13-voqc-commuting-cancel
         valid-f14-clean-stim-detector
         valid-f15-clean-refinement-widen
         valid-f16-closed-bb-css-round
         valid-f19-matched-kuperberg-sieve
         invalid-f1-wrong-controls
         invalid-f2-mutate-ctrl
         invalid-f4-pardiag-write-read
         invalid-f5-superpos-hmr
         invalid-f6-superpos-kickback
         invalid-f7-pardiag-h-cnot
         invalid-f8-cat-leak
         invalid-f9-premature-cs-phase
         invalid-f10-locked-pebble-overwrite
         invalid-f11-postswap-comparator-paradox
         invalid-f12-terhal-backlog
         invalid-f14-superpos-stim-detector
         invalid-f15-widen-drops-redundant-cs
