  (define entries-vec (list->vector (hash-ref catalog48 'entries)))
  (define heron-graph (hardware-coupling-graph 'Heron-R2-156q))
  ;; Pre-verify mutant rejection across all 48 OQP programs
  (define mutant-48-vec
    (for/vector ([idx (in-range 48)])
      (define entry (vector-ref entries-vec idx))
      (define raw-gates (compile-coreqds-to-revir (hash-ref entry 'ast)))
      (define bad-gates (cons (list 'gate 'CX '(0 15) 0) raw-gates))
      (define dyadic-bad (verify-exact-dyadic-unitary-equivalence raw-gates bad-gates))
      (define edge-bad (verify-routed-coupling-graph-edges bad-gates heron-graph))
      (and (not (hash-ref dyadic-bad 'verified?))
           (not (hash-ref edge-bad 'verified?)))))
  ;; Pre-verify procedural (w1, w2) CoreQDS 2.0 AST -> T-par -> SABRE route -> Exact Dyadic equivalence
  (define proc-cache (make-hash))
  (for* ([w1 (in-range 1 5)]
         [w2 (in-range 5 9)])
    (define proc-ast
      (list 'let w1
            (qxor (list 'var w1) (list 'var w2))
            (list 'within-apply
                  (focus-zipper 'left (list 'var w1))
                  (phase-oracle (qeq (list 'var w1) (list 'var w2)) 12 'coprocessor-mid-loop))
            #t))
    (define p-raw (compile-coreqds-to-revir proc-ast))
    (define p-tpar (optimize-phase-polynomial-tpar-and-gf2-cnot p-raw))
    (define p-routed (route-revir-on-coupling-graph p-tpar heron-graph))
    (hash-set! proc-cache (list w1 w2)
               (and (hash-ref (verify-exact-dyadic-unitary-equivalence p-raw p-tpar) 'verified?)
                    (hash-ref (verify-routed-coupling-graph-edges p-routed heron-graph) 'verified?))))

  (for ([i (in-range trials)])
    (define h (bitwise-and (+ (* i 2654435761) 912345679) #x7fffffff))
    (define idx (modulo i 48))
    (define entry (vector-ref entries-vec idx))

    (when (and catalog48-ok?
               (hash-ref entry 'verified?)
               (hash-ref entry 'exact-dyadic-unitary-equivalent?)
               (hash-ref entry 'routed-coupling-edges-valid?))
      (set! oqp1-to-48-e2e-verified (add1 oqp1-to-48-e2e-verified)))

    (when (vector-ref mutant-48-vec idx)
      (set! unrouted-or-unvalidated-mutant-caught (add1 unrouted-or-unvalidated-mutant-caught)))

    (define w1 (+ 1 (bitwise-and h 3)))
    (define w2 (+ 5 (bitwise-and (arithmetic-shift h -2) 3)))
    (when (hash-ref proc-cache (list w1 w2) #f)
      (set! random-coreqds2-dyadic-routed-verified (add1 random-coreqds2-dyadic-routed-verified))))

  (hash 'issue-id 'F106-complete-oqp1-to-48-exact-dyadic-tpar-routed-stim-pipeline
        'suite-id 'S79-To-S82-PassM45-To-M48-Complete-OQP1-To-48-Pipeline
