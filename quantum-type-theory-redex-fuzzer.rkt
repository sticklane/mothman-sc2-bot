(define (default-dag-commutation-test-circuit)
  ;; Interleaved disjoint-wire 1Q inverses (H-H on wire 0 across X on wire 2, T-Tdg on wire 1 across S on wire 3),
  ;; CZ(0, 1) ... T(0), Sdg(1), Z(0), RZ(1) ... CZ(0, 1) across intervening diagonal-Z gates,
  ;; and misordered (Pauli-Fixup Z 0 1) tuple requiring normalization to (Pauli-Fixup 0 1 Z)
  (list (list 'gate 'H '(0) 0)
        (list 'gate 'T '(1) 0)
        (list 'gate 'H '(2) 0)
        (list 'gate 'H '(0) 0)
        (list 'gate 'Tdg '(1) 0)
        (list 'gate 'CZ '(0 1) 0)
        (list 'gate 'T '(0) 0)
        (list 'gate 'S '(1) 0)
        (list 'gate 'CZ '(0 1) 0)
        (list 'gate 'Sdg '(1) 0)
        (list 'Pauli-Fixup 'Z 0 1)))

(define (pass-m65-dag-commutation-and-diagonal-z-peephole-optimizer
         [gates '()]
         [enforce-guard? #t])
  (define raw-gates
    (if (and (list? gates) (pair? gates))
        gates
        (default-dag-commutation-test-circuit)))
  (define pre-t-count (count-native-t-and-tdg-gates raw-gates))
  (define opt-gates (dag-commutation-peephole-optimize raw-gates enforce-guard?))
  (define post-t-count (post-peephole-native-t-count raw-gates enforce-guard?))
  (define fixup-normalized? (pauli-fixup-wires-in-positions-1-and-2? opt-gates))
  (define t-monotonic? (<= post-t-count pre-t-count))
  (hash 'pass-id 'M65-DAG-Commutation-And-Diagonal-Z-Peephole-Optimizer
        'simplification-id 'S99-DAG-Commutation-And-Pauli-Fixup-Tuple-Guard
        'initial-gate-count (length raw-gates)
        'optimized-gate-count (length opt-gates)
        'gates-eliminated (- (length raw-gates) (length opt-gates))
        'pre-peephole-native-t-count pre-t-count
        'post-peephole-native-t-count post-t-count
        'post-peephole-t-count-monotonic? t-monotonic?
        'pauli-fixup-wires-normalized? fixup-normalized?
        'uncommuted-peephole-residue-hazard? (or (not fixup-normalized?)
                                                 (= (length opt-gates) (length raw-gates)))
        'optimized-gates opt-gates
        'verified? (and enforce-guard?
                        fixup-normalized?
                        t-monotonic?
                        (< post-t-count pre-t-count)
                        (< (length opt-gates) (length raw-gates)))))

(define (s99-dag-commutation-and-pauli-fixup-tuple-guard
