            (basis-translate eff-in-ortho? eff-out-ortho? eff-spans-eq? total-dim total-dim))
          (match-structural-sum enforce-direct-sum-and-ortho? eff-in-ortho? eff-out-ortho?
            (hash-ref qds30 'direct-sum-qubits)
