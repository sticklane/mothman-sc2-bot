               (c-seq (c-gate (g-cnot 0 2))
                      (c-seq (c-gate (g-cnot 0 2))
                             (c-gate (g-hmr-cz 3 0 1 0))))))
     (define bbs-base (eval-bitboard-qfree base-circ))
