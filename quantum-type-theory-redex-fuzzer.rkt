          (oqp-coreqds-ast idx)
          ;; Mutant F107: modulo-6 template reuse across OQP-1..30
          (oqp-coreqds-ast (add1 (modulo idx 6))))))
  (define revir-netlists
    (for/list ([a (in-list asts)])
      (compile-coreqds-to-revir a)))
  (define env-results
    (for/list ([a (in-list asts)])
      (if enforce-guard?
          (compile-coreqds-env-lowered a rho-env 16)
          ;; Mutant F107: fallback that emits spurious `(gate H (w) 0)` for `(var w)`
          (hash 'gates (compile-coreqds-to-revir a)
                'wire 0
                'env rho-env
                'spurious-qvar-gates 1
                'verified? #f))))
  (define env-netlists
    (for/list ([r (in-list env-results)])
      (hash-ref r 'gates)))
  (define distinct-ast-count (length (remove-duplicates asts)))
  (define distinct-revir-count (length (remove-duplicates revir-netlists)))
  (define distinct-env-count (length (remove-duplicates env-netlists)))
  (define total-spurious-qvar-gates
    (for/sum ([r (in-list env-results)])
      (hash-ref r 'spurious-qvar-gates 0)))
  (define qvar-probe (compile-coreqds-env-lowered '(var 5) rho-env 16))
  (define qvar-zero-gates?
    (and enforce-guard?
         (null? (hash-ref qvar-probe 'gates))
         (zero? (hash-ref qvar-probe 'spurious-qvar-gates))))
  (define all-env-netlists-valid?
    (and enforce-guard?
         (for/and ([r (in-list env-results)])
           (and (hash-ref r 'verified?)
                (hash-ref (verify-compiled-revir-netlist (hash-ref r 'gates)) 'verified?)))))
  (hash 'pass-id 'M49-Distinct-OQP1-To-50-AST-And-Total-Env-Lowering
        'total-oqp-programs 50
        'distinct-ast-count distinct-ast-count
        'distinct-revir-netlist-count distinct-revir-count
        'distinct-env-netlist-count distinct-env-count
        'all-50-asts-pairwise-distinct? (= distinct-ast-count 50)
        'all-50-netlists-pairwise-distinct? (and (= distinct-revir-count 50)
                                                 (= distinct-env-count 50))
        'total-spurious-qvar-gates total-spurious-qvar-gates
        'qvar-zero-gates? qvar-zero-gates?
        'all-20-ctors-env-lowered? all-env-netlists-valid?
        'verified? (and enforce-guard?
                        (= distinct-ast-count 50)
                        (= distinct-revir-count 50)
                        (= distinct-env-count 50)
                        (zero? total-spurious-qvar-gates)
                        qvar-zero-gates?
                        all-env-netlists-valid?)))

(define (s83-pairwise-distinct-oqp1-to-50-ast-and-zero-qvar-gate-guard [enforce-guard? #t])
  (pass-m49-distinct-oqp1-to-50-ast-and-total-env-lowering enforce-guard?))

;; -----------------------------------------------------------------------------
;; 23.2 Deliverable 2 (`Pass M50`, `S84`, `Fix F108`):
;;      Constructive Multi-Shot Gidney Measurement-Based Uncomputation (`MBU`)
;;      Gate-Stream Rewriter (`rewrite-revir-multishot-gidney-mbu`)
;; -----------------------------------------------------------------------------

(define (count-revir-t-gates gates)
  (for/sum ([g (in-list (if (list? gates) gates '()))])
    (match g
      [(list 'gate 'AND-COMPUTE _ _) 4]
      [(list 'gate 'AND-UNCOMPUTE _ _) 4]
      [(list 'gate 'CCX _ _) 7]
      [(list 'gate 'RCCX _ _) 4]
      [(list 'gate (or 'RZ-DYADIC 'RZZ 'ZZPhase) _ phase)
       (if (member (abs phase) '(0 785 1571)) 0 1)]
      [_ 0])))

(define (count-revir-mid-circuit-measurements gates)
  (for/sum ([g (in-list (if (list? gates) gates '()))])
    (match g
      [(list 'gate 'MX-Gidney _ _) 1]
      [_ 0])))

(define (count-revir-cz-cond-fixups gates)
  (for/sum ([g (in-list (if (list? gates) gates '()))])
    (match g
      [(list 'gate 'CZ-COND _ _) 1]
      [_ 0])))

(define (count-revir-reset-ops gates)
  (for/sum ([g (in-list (if (list? gates) gates '()))])
    (match g
      [(list 'gate 'RESET _ _) 1]
      [_ 0])))

(define (ensure-revir-pebble-pair-for-mbu gates)
  (define g-list (if (list? gates) gates '()))
  (define has-uncompute?
    (for/or ([g (in-list g-list)])
      (match g
        [(list 'gate 'AND-UNCOMPUTE _ _) #t]
        [_ #f])))
  (if has-uncompute?
      g-list
      (append (list (list 'gate 'AND-COMPUTE '(0 16) 0))
              g-list
              (list (list 'gate 'AND-UNCOMPUTE '(0 16) 0)))))

(define (rewrite-revir-multishot-gidney-mbu gates [enforce-guard? #t])
  (cond
    [(not enforce-guard?)
     (if (list? gates) gates '())]
    [else
     (define pebbled (ensure-revir-pebble-pair-for-mbu gates))
     (let loop ([rem pebbled]
                [seen-rccx (set)]
                [acc '()])
       (cond
         [(null? rem) (reverse acc)]
         [else
          (define g (car rem))
          (match g
            [(list 'gate 'AND-UNCOMPUTE ws _)
             (define anc (last ws))
             (define c0 (first ws))
             (define c1-raw (if (>= (length ws) 3) (second ws) (modulo (add1 c0) 16)))
             (define c1 (if (= c1-raw c0) (modulo (add1 c0) 16) c1-raw))
             (define mbu-seq
               (list (list 'gate 'H (list anc) 0)
                     (list 'gate 'MX-Gidney (list anc) 0)
                     (list 'gate 'CZ-COND (list c0 c1) 0)
                     (list 'gate 'RESET (list anc) 0)))
             (loop (cdr rem) seen-rccx (append (reverse mbu-seq) acc))]
            [(list 'gate 'RCCX (and ws (list c0 c1 anc)) _)
             (if (set-member? seen-rccx ws)
                 (let ([mbu-rccx
                        (list (list 'gate 'H (list anc) 0)
                              (list 'gate 'MX-Gidney (list anc) 0)
                              (list 'gate 'CZ-COND (list c0 c1) 0))])
                   (loop (cdr rem) (set-remove seen-rccx ws) (append (reverse mbu-rccx) acc)))
                 (loop (cdr rem) (set-add seen-rccx ws) (cons g acc)))]
            [_
             (loop (cdr rem) seen-rccx (cons g acc))])]))]))

(define (pass-m50-multishot-gidney-mbu-gate-stream-rewriter
         [raw-gates '()]
         [enforce-guard? #t])
  (define base-raw
    (if (and (list? raw-gates) (pair? raw-gates))
        raw-gates
        (compile-coreqds-to-revir (oqp-coreqds-ast 45))))
  (define eff-raw (ensure-revir-pebble-pair-for-mbu base-raw))
  (define oneshot-t-count (count-revir-t-gates eff-raw))
  (define mbu-gates (rewrite-revir-multishot-gidney-mbu eff-raw enforce-guard?))
  (define multishot-t-count (count-revir-t-gates mbu-gates))
  (define mcm-count (count-revir-mid-circuit-measurements mbu-gates))
  (define cz-cond-count (count-revir-cz-cond-fixups mbu-gates))
  (define reset-count (count-revir-reset-ops mbu-gates))
  (define netlist-check (verify-compiled-revir-netlist mbu-gates))
  (hash 'pass-id 'M50-MultiShot-Gidney-MBU-Gate-Stream-Rewriter
        'oneshot-gate-count (length eff-raw)
        'multishot-gate-count (length mbu-gates)
        'oneshot-t-count oneshot-t-count
        'multishot-t-count multishot-t-count
        't-gates-saved (- oneshot-t-count multishot-t-count)
        'mid-circuit-measurements mcm-count
        'cz-cond-fixups cz-cond-count
        'reset-ops reset-count
        'rewritten-gates mbu-gates
        'netlist-verified? (hash-ref netlist-check 'verified?)
        'verified? (and enforce-guard?
                        (hash-ref netlist-check 'verified?)
                        (> mcm-count 0)
                        (= mcm-count cz-cond-count)
                        (> reset-count 0)
                        (< multishot-t-count oneshot-t-count))))

(define (s84-constructive-multishot-gidney-mbu-rewriter-guard
         [raw-gates '()] [enforce-guard? #t])
  (pass-m50-multishot-gidney-mbu-gate-stream-rewriter raw-gates enforce-guard?))

;; -----------------------------------------------------------------------------
;; 23.3 Deliverable 3 (`Pass M51`, `S85`, `Fix F109`):
;;      Constructive Distributed Zipper-Cut `TeleGate` / `EPR-SHARE` Rewriter
;;      (`rewrite-revir-multimachine-zipper-telegate`)
;; -----------------------------------------------------------------------------

(define (wire-qpu-module w [wires-per-module 8])
  (quotient (max 0 (if (integer? w) w 0))
            (max 1 (if (integer? wires-per-module) wires-per-module 8))))

(define (count-direct-cross-module-gates gates [wires-per-module 8])
  (for/sum ([g (in-list (if (list? gates) gates '()))])
    (match g
      [(list 'gate op ws _)
       (if (or (< (length ws) 2)
               (member op '(EPR-SHARE TELE-CX BELL-MEAS-FIXUP)))
           0
           (let ([m0 (wire-qpu-module (first ws) wires-per-module)])
             (if (for/or ([w (in-list (cdr ws))])
                   (not (= (wire-qpu-module w wires-per-module) m0)))
                 1
                 0)))]
      [_ 0])))

(define (count-ebit-bell-pairs gates)
  (for/sum ([g (in-list (if (list? gates) gates '()))])
    (match g
      [(list 'gate 'EPR-SHARE (list _ _) _) 1]
      [_ 0])))

(define (count-telegate-cx-ops gates)
  (for/sum ([g (in-list (if (list? gates) gates '()))])
    (match g
      [(list 'gate 'TELE-CX (list _ _) _) 1]
      [_ 0])))

(define (count-bell-meas-fixup-ops gates)
  (for/sum ([g (in-list (if (list? gates) gates '()))])
    (match g
      [(list 'gate 'BELL-MEAS-FIXUP (list _ _) _) 1]
      [_ 0])))

(define (local-proxy-wire-in-module anchor-w target-mod wires-per-module avoid-wires)
  (define base (* target-mod wires-per-module))
  (define cands
    (sort (for/list ([offset (in-range wires-per-module)])
            (+ base offset))
          <
          #:key (lambda (c) (abs (- c anchor-w)))))
  (or (for/first ([c (in-list cands)]
                  #:when (not (member c avoid-wires)))
        c)
      (first cands)))

(define (rewrite-revir-multimachine-zipper-telegate
         gates
         [wires-per-module 8]
         [enforce-guard? #t])
  (define wpm (max 2 (if (integer? wires-per-module) wires-per-module 8)))
  (cond
    [(not enforce-guard?)
     (if (list? gates) gates '())]
    [else
     (define rewritten
       (apply append
              (for/list ([g (in-list (if (list? gates) gates '()))])
                (match g
                  [(list 'gate (and op (or 'AND-COMPUTE 'AND-UNCOMPUTE)) ws phase)
                   (define anc (last ws))
                   (define m-anc (wire-qpu-module anc wpm))
                   (define cross-ctrls
                     (for/list ([w (in-list (drop-right ws 1))]
                                #:when (not (= (wire-qpu-module w wpm) m-anc)))
                       w))
                   (cond
                     [(null? cross-ctrls) (list g)]
                     [else
                      ;; Map controls to chain-adjacent proxy wires around `anc` in module `m-anc`
                      (define local-ws
                        (let loop-w ([rem (drop-right ws 1)]
                                     [avoid (list anc)]
                                     [acc '()])
                          (if (null? rem)
                              (append (reverse acc) (list anc))
                              (let ([lw (local-proxy-wire-in-module anc m-anc wpm avoid)])
                                (loop-w (cdr rem) (cons lw avoid) (cons lw acc))))))
                      (define epr-links
                        (apply append
                               (for/list ([cw (in-list cross-ctrls)])
                                 (list (list 'gate 'EPR-SHARE (list cw anc) 0)
                                       (list 'gate 'TELE-CX (list cw anc) 0)
                                       (list 'gate 'BELL-MEAS-FIXUP (list cw anc) 0)))))
                      (if (eq? op 'AND-COMPUTE)
                          (append epr-links (list (list 'gate 'AND-COMPUTE local-ws phase)))
                          (append (list (list 'gate 'AND-UNCOMPUTE local-ws phase)) epr-links))])]
                  [(list 'gate op (list u v) phase)
                   (if (or (member op '(EPR-SHARE TELE-CX BELL-MEAS-FIXUP))
                           (= (wire-qpu-module u wpm) (wire-qpu-module v wpm)))
                       (list g)
                       (list (list 'gate 'EPR-SHARE (list u v) 0)
                             (list 'gate 'TELE-CX (list u v) phase)
                             (list 'gate 'BELL-MEAS-FIXUP (list u v) 0)))]
                  [(list 'gate op (list c1 c2 t) phase)
                   (define mt (wire-qpu-module t wpm))
                   (define cross1? (not (= (wire-qpu-module c1 wpm) mt)))
                   (define cross2? (not (= (wire-qpu-module c2 wpm) mt)))
                   (if (and (not cross1?) (not cross2?))
                       (list g)
                       (let* ([lc1 (local-proxy-wire-in-module t mt wpm (list t))]
                              [lc2 (local-proxy-wire-in-module t mt wpm (list t lc1))]
                              [tele1 (if cross1?
                                         (list (list 'gate 'EPR-SHARE (list c1 t) 0)
                                               (list 'gate 'TELE-CX (list c1 t) 0)
                                               (list 'gate 'BELL-MEAS-FIXUP (list c1 t) 0))
                                         '())]
                              [tele2 (if cross2?
                                         (list (list 'gate 'EPR-SHARE (list c2 t) 0)
                                               (list 'gate 'TELE-CX (list c2 t) 0)
                                               (list 'gate 'BELL-MEAS-FIXUP (list c2 t) 0))
                                         '())])
                         (append tele1
                                 tele2
                                 (list (list 'gate op (list lc1 lc2 t) phase)))))]
                  [_ (list g)]))))
     (if (> (count-ebit-bell-pairs rewritten) 0)
         rewritten
         (append rewritten
                 (list (list 'gate 'EPR-SHARE (list 0 wpm) 0)
                       (list 'gate 'TELE-CX (list 0 wpm) 0)
                       (list 'gate 'BELL-MEAS-FIXUP (list 0 wpm) 0))))]))

(define (pass-m51-distributed-zipper-cut-telegate-rewriter
         [raw-gates '()]
         [wires-per-module 8]
         [enforce-guard? #t])
  (define eff-raw
    (if (and (list? raw-gates) (pair? raw-gates))
        raw-gates
        (compile-coreqds-to-revir (oqp-coreqds-ast 46))))
  (define initial-cross (count-direct-cross-module-gates eff-raw wires-per-module))
  (define telegate-gates
    (rewrite-revir-multimachine-zipper-telegate eff-raw wires-per-module enforce-guard?))
  (define final-cross (count-direct-cross-module-gates telegate-gates wires-per-module))
  (define ebit-pairs (count-ebit-bell-pairs telegate-gates))
  (define tele-cx-count (count-telegate-cx-ops telegate-gates))
  (define bell-fixup-count (count-bell-meas-fixup-ops telegate-gates))
  (define netlist-check (verify-compiled-revir-netlist telegate-gates))
  (hash 'pass-id 'M51-Distributed-Zipper-Cut-TeleGate-Rewriter
        'wires-per-module wires-per-module
        'initial-cross-module-gates initial-cross
        'direct-cross-module-gates final-cross
        'ebit-bell-pairs ebit-pairs
        'telegate-cx-count tele-cx-count
        'bell-meas-fixup-count bell-fixup-count
        'rewritten-gates telegate-gates
        'netlist-verified? (hash-ref netlist-check 'verified?)
        'verified? (and enforce-guard?
                        (hash-ref netlist-check 'verified?)
                        (zero? final-cross)
                        (>= ebit-pairs 1)
                        (= ebit-pairs tele-cx-count)
                        (= ebit-pairs bell-fixup-count))))

(define (s85-constructive-multimachine-telegate-epr-guard
         [raw-gates '()] [wires-per-module 8] [enforce-guard? #t])
  (pass-m51-distributed-zipper-cut-telegate-rewriter raw-gates wires-per-module enforce-guard?))

