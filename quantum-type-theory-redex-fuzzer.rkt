;; Issue F102 (25,000 procedural trials):
;; Non-Local Phase-Polynomial (`T-par` / Amy-Maslov-Mosca) & GF(2) Linear-Network
;; CNOT Synthesis (`Pass M46`, `S80`) vs Unmerged Non-Local Parity Rotations &
;; Corrupted GF(2) Linear Transformation Mutants
(define (fuzz-find-f102-phase-polynomial-tpar-and-gf2-cnot-synthesis-pass-m46 [trials 25000])
  (define m46-tpar-and-gf2-verified 0)
  (define non-local-parity-merge-verified 0)
  (define gf2-or-parity-mutant-caught 0)
  ;; Pre-verify all 16 (w0, w1) non-local phase-polynomial + GF(2) CNOT networks
  (define m46-cache (make-hash))
  (for* ([w0 (in-range 4)]
         [w1 (in-range 4 8)])
    (define w2 (+ 8 (modulo (+ w0 w1) 4)))
    (define raw-gates
      (list (list 'gate 'CX (list w0 w1) 0)
            (list 'gate 'CX (list w2 w1) 0)
            (list 'gate 'RZ-DYADIC (list w1) 393)
            (list 'gate 'CX (list w2 w1) 0)
            (list 'gate 'CX (list w1 w2) 0)
            (list 'gate 'RZ-DYADIC (list w2) 392)
            (list 'gate 'CX (list w1 w2) 0)
            (list 'gate 'CX (list w0 w1) 0)
            (list 'gate 'CX (list w0 w1) 0)
            (list 'gate 'CX (list w1 w2) 0)
            (list 'gate 'CX (list w0 w1) 0)
            (list 'gate 'CX (list w1 w2) 0)
            (list 'gate 'CX (list w0 w2) 0)))
    (define m46-wt (pass-m46-phase-polynomial-tpar-and-gf2-cnot-synthesizer raw-gates #t))
    (define s80-wt (s80-phase-polynomial-tpar-and-gf2-gauss-jordan-guard raw-gates #t))
    (define m46-mut-unopt (pass-m46-phase-polynomial-tpar-and-gf2-cnot-synthesizer raw-gates #f))
    (define bad-gf2-gates
      (append (hash-ref m46-wt 'optimized-gates)
              (list (list 'gate 'CX (list w0 w2) 0))))
    (define dyadic-bad (verify-exact-dyadic-unitary-equivalence raw-gates bad-gf2-gates))
    (hash-set! m46-cache (list w0 w1)
               (and (hash-ref m46-wt 'verified?)
                    (hash-ref s80-wt 'verified?)
                    (<= (hash-ref m46-wt 'opt-gate-count) 5)
                    (= (hash-ref m46-wt 'opt-rotation-count) 1)
                    (not (hash-ref m46-mut-unopt 'verified?))
                    (not (hash-ref dyadic-bad 'verified?)))))

  (for ([i (in-range trials)])
    (define h (bitwise-and (+ (* i 2654435761) 834567891) #x7fffffff))
    (define w0 (bitwise-and h 3))
    (define w1 (+ 4 (bitwise-and (arithmetic-shift h -2) 3)))
    (when (hash-ref m46-cache (list w0 w1) #f)
      (set! m46-tpar-and-gf2-verified (add1 m46-tpar-and-gf2-verified))
      (set! non-local-parity-merge-verified (add1 non-local-parity-merge-verified))
      (set! gf2-or-parity-mutant-caught (add1 gf2-or-parity-mutant-caught))))

  (hash 'issue-id 'F102-phase-polynomial-tpar-and-gf2-cnot-synthesis-pass-m46
        'suite-id 'S80-PassM46-Phase-Polynomial-Tpar-And-GF2-CNOT-Synthesis
        'trials trials
