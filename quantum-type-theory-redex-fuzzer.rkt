;; -----------------------------------------------------------------------------
;; S75, Pass M41 & Issue F95 (25,000 procedural trials):
;; Multi-Depth Pebbled `qfree` Oracle Truth-Table Fidelity & Uncomputation +
;; Strict OpenQASM 3.0 Bracketed Emission (`S75`, `Pass M41`)
;; -----------------------------------------------------------------------------
(define (fuzz-find-f95-pebbled-qfree-oracle-truth-table-and-openqasm3-strict-syntax [trials 25000])
  (define m41-pebbled-qfree-verified 0)
  (define leaked-scratch-or-malformed-qasm3-mutant-caught 0)
  (define s75-and-truth-table-verified 0)
  (define m41-base (pass-m41-pebbled-qfree-revir-and-openqasm3-strict-verifier #f 7 #t))
  (define s75-base (s75-pebbled-qfree-oracle-and-strict-qasm3-guard #f 7 #t))
  (define base-ok? (and (hash-ref m41-base 'verified?) (hash-ref s75-base 'verified?)))

  (for ([i (in-range trials)])
    (define h (bitwise-and (+ (* i 2654435761) 712345679) #x7fffffff))
    (define w1 (+ 1 (modulo h 2)))
    (define w2 (+ 3 (modulo (arithmetic-shift h -3) 2)))
    (define w3 (+ 5 (modulo (arithmetic-shift h -6) 2)))
    (define expr
      (if (even? h)
          (qxor (qand (list 'var w1) (list 'var w2))
                (qnot (list 'var w3)))
          (qeq (qxor (list 'var w1) (qconst 1))
               (qand (list 'var w2) (list 'var w3)))))
    (define c-gates (compile-qfree-expr-to-revir expr 7 18))
    (define u-gates (invert-revir-gates c-gates))
    (define full-gates (append c-gates u-gates))
    (define b1 (if (bitwise-bit-set? h 1) 1 0))
    (define b2 (if (bitwise-bit-set? h 2) 1 0))
    (define b3 (if (bitwise-bit-set? h 4) 1 0))
    (define env (hash w1 b1 w2 b2 w3 b3 7 0))
    (define expected (eval-qfree-expr-bool expr env))
    (define sim-c (simulate-revir-classical-netlist c-gates env))
    (define sim-full (simulate-revir-classical-netlist full-gates env))

    ;; 1. Verify pebbled compute matches eval-qfree-expr-bool and uncompute restores target wire 7 to 0!
    (when (and base-ok?
               (= (hash-ref sim-c 7 0) expected)
               (zero? (hash-ref sim-full 7 0))
               (zero? (hash-ref sim-full 18 0)))
      (set! m41-pebbled-qfree-verified (add1 m41-pebbled-qfree-verified)))

    ;; 2. Mutant F95: omitting AND-UNCOMPUTE (leaked scratch pebble) OR Racket-paren "q(0)" in OpenQASM 3.0!
    (define leaked-gates (cons (list 'gate 'AND-COMPUTE '(1 2 18) 0) c-gates))
    (define leaked-check (verify-revir-strict-wires-and-lifo-ancillas leaked-gates))
    (define bad-qasm-check
      (verify-openqasm3-syntax-strict
       (list "OPENQASM 3.0;"
             "include \"stdgates.inc\";"
             "qubit[16] q;"
             "bit[16] c;"
             "h q(0);")))
    (when (and (not (hash-ref leaked-check 'verified?))
               (not (hash-ref bad-qasm-check 'verified?)))
      (set! leaked-scratch-or-malformed-qasm3-mutant-caught
            (add1 leaked-scratch-or-malformed-qasm3-mutant-caught)))

    ;; 3. Verify strict wire disjointness (no CX q[w], q[w]) on full pebbled circuit
    (define strict-full (verify-revir-strict-wires-and-lifo-ancillas full-gates))
    (when (hash-ref strict-full 'verified?)
      (set! s75-and-truth-table-verified (add1 s75-and-truth-table-verified))))

  (hash 'issue-id 'F95-pebbled-qfree-oracle-truth-table-and-openqasm3-strict-syntax
        'suite-id 'S75-PassM41-Pebbled-Qfree-Oracle-And-Strict-OpenQASM3
        'trials trials
        'm41-pebbled-qfree-verified m41-pebbled-qfree-verified
        'leaked-scratch-or-malformed-qasm3-mutant-caught leaked-scratch-or-malformed-qasm3-mutant-caught
        's75-and-truth-table-verified s75-and-truth-table-verified
        'verified? (and (= m41-pebbled-qfree-verified trials)
                        (= leaked-scratch-or-malformed-qasm3-mutant-caught trials)
                        (= s75-and-truth-table-verified trials))))

;; -----------------------------------------------------------------------------
;; S76, Pass M42 & Issue F96 (25,000 procedural trials):
;; Peephole Gate Cancellation, Commutation-Driven Fusion & Dead Clean-Ancilla
;; Elimination (`S76`, `Pass M42`)
;; -----------------------------------------------------------------------------
(define (fuzz-find-f96-revir-peephole-commutation-and-dead-ancilla-elimination [trials 25000])
  (define m42-peephole-optimizer-verified 0)
  (define reducible-or-self-aliased-gate-mutant-caught 0)
  (define s76-irreducibility-verified 0)

  (for ([i (in-range trials)])
    (define h (bitwise-and (+ (* i 2654435761) 738912345) #x7fffffff))
    (define w0 (modulo h 4))
    (define w1 (+ 4 (modulo (arithmetic-shift h -3) 4)))
    (define w2 (+ 8 (modulo (arithmetic-shift h -6) 4)))
    (define anc (+ 18 (modulo (arithmetic-shift h -9) 6)))
    (define a1 (+ 100 (modulo h 500)))
    (define a2 (- 6284 a1))

    ;; Construct circuit with adjacent H-H, commuting Z-diagonal RZ-DYADIC across CX control,
    ;; full-turn 6284 RZ-DYADIC cancellation, and dead AND-COMPUTE / AND-UNCOMPUTE ancilla pair!
    (define raw-gates
      (list (list 'gate 'H (list w0) 0)
            (list 'gate 'H (list w0) 0)
            (list 'gate 'RZ-DYADIC (list w1) a1)
            (list 'gate 'CX (list w1 w2) 0)
            (list 'gate 'RZ-DYADIC (list w1) a2)
            (list 'gate 'AND-COMPUTE (list w0 w1 anc) 0)
            (list 'gate 'AND-UNCOMPUTE (list w0 w1 anc) 0)
            (list 'gate 'CX (list w0 w2) 0)))
    (define opt-gates (optimize-revir-netlist raw-gates))

    ;; 1. Verify optimizer eliminates H-H, RZ-DYADIC(a1)+RZ-DYADIC(6284-a1)=RZ-DYADIC(0), and dead ancilla pair -> 2 CX gates!
    (when (and (= (length opt-gates) 2)
               (revir-netlist-irreducible? opt-gates))
      (set! m42-peephole-optimizer-verified (add1 m42-peephole-optimizer-verified)))

    ;; 2. Mutant F96: unoptimized reducible netlist is flagged by revir-netlist-irreducible?,
    ;;    and self-aliased CX(w0, w0) is rejected by verify-revir-strict-wires-and-lifo-ancillas!
    (define self-alias-gates (list (list 'gate 'CX (list w0 w0) 0)))
    (define alias-check (verify-revir-strict-wires-and-lifo-ancillas self-alias-gates))
    (when (and (not (revir-netlist-irreducible? raw-gates))
               (not (hash-ref alias-check 'verified?)))
      (set! reducible-or-self-aliased-gate-mutant-caught
            (add1 reducible-or-self-aliased-gate-mutant-caught)))

    ;; 3. Verify S76 guard
    (when (> (- (length raw-gates) (length opt-gates)) 0)
      (set! s76-irreducibility-verified (add1 s76-irreducibility-verified))))

  (hash 'issue-id 'F96-revir-peephole-commutation-and-dead-ancilla-elimination
        'suite-id 'S76-PassM42-RevIR-Peephole-Commutation-And-Dead-Ancilla-Optimizer
        'trials trials
        'm42-peephole-optimizer-verified m42-peephole-optimizer-verified
        'reducible-or-self-aliased-gate-mutant-caught reducible-or-self-aliased-gate-mutant-caught
        's76-irreducibility-verified s76-irreducibility-verified
        'verified? (and (= m42-peephole-optimizer-verified trials)
                        (= reducible-or-self-aliased-gate-mutant-caught trials)
                        (= s76-irreducibility-verified trials))))

;; -----------------------------------------------------------------------------
;; S77, Pass M43 & Issue F97 (25,000 procedural trials):
;; Translation Validation via Exact Statevector & Observable Equivalence
;; (`S77`, `Pass M43`)
;; -----------------------------------------------------------------------------
(define (fuzz-find-f97-revir-translation-validation-and-semantic-equivalence [trials 25000])
  (define m43-translation-validation-verified 0)
  (define semantic-drift-mutant-caught 0)
  (define s77-observable-equivalence-verified 0)

  (for ([i (in-range trials)])
    (define h (bitwise-and (+ (* i 2654435761) 765432109) #x7fffffff))
    (define w0 (modulo h 4))
    (define w1 (+ 4 (modulo (arithmetic-shift h -3) 4)))
    (define w2 (+ 8 (modulo (arithmetic-shift h -6) 4)))
    (define anc (+ 16 (modulo (arithmetic-shift h -9) 4)))
    (define angle (+ 180 (* 90 (modulo h 7))))

    (define raw-gates
      (list (list 'gate 'H (list w0) 0)
            (list 'gate 'CX (list w0 w1) 0)
            (list 'gate 'AND-COMPUTE (list w0 w1 anc) 0)
            (list 'gate 'AND-UNCOMPUTE (list w0 w1 anc) 0)
            (list 'gate 'RZ-DYADIC (list w1) angle)
            (list 'gate 'CX (list w1 w2) 0)
            (list 'gate 'CX (list w1 w2) 0)))
    (define m43-wt (pass-m43-revir-translation-validation-and-statevector-verifier raw-gates '() #t))

    ;; 1. Verify translation validation passes 6/6 statevector probes between raw and optimized circuits!
    (when (and (hash-ref m43-wt 'verified?)
               (= (hash-ref m43-wt 'matching-probes) 6))
      (set! m43-translation-validation-verified (add1 m43-translation-validation-verified)))

    ;; 2. Mutant F97: corrupting optimized circuit (flipping RZ-DYADIC angle or dropping live CX) is caught!
    (define corrupted-gates
      (if (even? h)
          (list (list 'gate 'H (list w0) 0)
                (list 'gate 'CX (list w0 w1) 0)
                (list 'gate 'RZ-DYADIC (list w1) (+ angle 393)))
          (list (list 'gate 'H (list w0) 0)
                (list 'gate 'RZ-DYADIC (list w1) angle))))
    (define m43-mut
      (pass-m43-revir-translation-validation-and-statevector-verifier raw-gates corrupted-gates #f))
    (when (not (hash-ref m43-mut 'verified?))
      (set! semantic-drift-mutant-caught (add1 semantic-drift-mutant-caught)))

    ;; 3. S77 guard verification
    (define s77-wt (s77-revir-translation-validation-equivalence-guard raw-gates '() #t))
    (when (hash-ref s77-wt 'verified?)
      (set! s77-observable-equivalence-verified (add1 s77-observable-equivalence-verified))))

  (hash 'issue-id 'F97-revir-translation-validation-and-semantic-equivalence
        'suite-id 'S77-PassM43-RevIR-Translation-Validation-Statevector-Verifier
        'trials trials
        'm43-translation-validation-verified m43-translation-validation-verified
        'semantic-drift-mutant-caught semantic-drift-mutant-caught
        's77-observable-equivalence-verified s77-observable-equivalence-verified
        'verified? (and (= m43-translation-validation-verified trials)
                        (= semantic-drift-mutant-caught trials)
                        (= s77-observable-equivalence-verified trials))))

