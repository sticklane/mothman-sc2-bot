        'opt-gate-count (length opt-gates)
        'gates-eliminated (- (length eff-raw) (length opt-gates))
        'optimized-gates opt-gates
        'irreducible? irred?
        'translation-validated? (hash-ref tv-res 'verified?)
        'verified? (and irred?
                        (<= (length opt-gates) (length eff-raw))
                        (hash-ref tv-res 'verified?))))

