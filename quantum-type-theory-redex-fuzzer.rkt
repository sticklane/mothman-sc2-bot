(define (revir-gate->openqasm3-line g)
  (match g
    [(list 'gate op ws phase)
     (match (list op ws phase)
       [(list 'X (list w) 0) (format "x q[~a];" w)]
       [(list 'Z (list w) 0) (format "z q[~a];" w)]
       [(list 'H (list w) 0) (format "h q[~a];" w)]
       [(list 'S (list w) 0) (format "s q[~a];" w)]
       [(list 'Sdg (list w) 0) (format "sdg q[~a];" w)]
       [(list 'T (list w) 0) (format "t q[~a];" w)]
       [(list 'Tdg (list w) 0) (format "tdg q[~a];" w)]
       [(list 'SX (list w) 0) (format "sx q[~a];" w)]
       [(list 'XY4-DD (list w) 0) (format "xy4_dd q[~a];" w)]
       [(list 'RZ (list w) theta) (format "rz(~a) q[~a];" theta w)]
       [(list 'RZ-DYADIC (list w) theta) (format "rz_dyadic(~a) q[~a];" theta w)]
       [(list 'CX (list c t) 0) (format "cx q[~a], q[~a];" c t)]
       [(list 'CZ (list c t) 0) (format "cz q[~a], q[~a];" c t)]
       [(list 'SWAP (list u v) 0) (format "swap q[~a], q[~a];" u v)]
       [(list 'CCX (list a b t) 0) (format "ccx q[~a], q[~a], q[~a];" a b t)]
       [(list 'CSWAP (list c u v) 0) (format "cswap q[~a], q[~a], q[~a];" c u v)]
       [(list 'AND-COMPUTE (list a b t) 0) (format "and_compute q[~a], q[~a], q[~a];" a b t)]
       [(list 'AND-UNCOMPUTE (list a b t) 0) (format "and_uncompute q[~a], q[~a], q[~a];" a b t)]
       [_ (format "// custom_op ~s;" g)])]
    [_ (format "// custom_op ~s;" g)]))

(define (openqasm3-line->revir-gate line)
  (define trimmed (string-trim line))
  (cond
    [(or (string=? trimmed "")
         (string-prefix? trimmed "OPENQASM")
         (string-prefix? trimmed "include")
         (string-prefix? trimmed "qubit["))
     #f]
    [(regexp-match #px"^// custom_op (.+);$" trimmed)
     => (lambda (m) (read (open-input-string (second m))))]
    [(regexp-match #px"^([a-z0-9_]+)\\(([^)]+)\\)\\s+q\\[([0-9]+)\\];$" trimmed)
     => (lambda (m)
          (define op (second m))
          (define param (or (string->number (third m)) 0))
          (define w (string->number (fourth m)))
          (match op
            ["rz" (list 'gate 'RZ (list w) param)]
            ["rz_dyadic" (list 'gate 'RZ-DYADIC (list w) param)]
            [_ (list 'gate (string->symbol (string-upcase op)) (list w) param)]))]
    [(regexp-match #px"^([a-z0-9_]+)\\s+q\\[([0-9]+)\\];$" trimmed)
     => (lambda (m)
          (define op (second m))
          (define w (string->number (third m)))
          (match op
            ["x" (list 'gate 'X (list w) 0)]
            ["z" (list 'gate 'Z (list w) 0)]
            ["h" (list 'gate 'H (list w) 0)]
            ["s" (list 'gate 'S (list w) 0)]
            ["sdg" (list 'gate 'Sdg (list w) 0)]
            ["t" (list 'gate 'T (list w) 0)]
            ["tdg" (list 'gate 'Tdg (list w) 0)]
            ["sx" (list 'gate 'SX (list w) 0)]
            ["xy4_dd" (list 'gate 'XY4-DD (list w) 0)]
            [_ (list 'gate (string->symbol (string-upcase op)) (list w) 0)]))]
    [(regexp-match #px"^([a-z0-9_]+)\\s+q\\[([0-9]+)\\],\\s*q\\[([0-9]+)\\];$" trimmed)
     => (lambda (m)
          (define op (second m))
          (define u (string->number (third m)))
          (define v (string->number (fourth m)))
          (match op
            ["cx" (list 'gate 'CX (list u v) 0)]
            ["cz" (list 'gate 'CZ (list u v) 0)]
            ["swap" (list 'gate 'SWAP (list u v) 0)]
            [_ (list 'gate (string->symbol (string-upcase op)) (list u v) 0)]))]
    [(regexp-match #px"^([a-z0-9_]+)\\s+q\\[([0-9]+)\\],\\s*q\\[([0-9]+)\\],\\s*q\\[([0-9]+)\\];$" trimmed)
     => (lambda (m)
          (define op (second m))
          (define a (string->number (third m)))
          (define b (string->number (fourth m)))
          (define t (string->number (fifth m)))
          (match op
            ["ccx" (list 'gate 'CCX (list a b t) 0)]
            ["cswap" (list 'gate 'CSWAP (list a b t) 0)]
            ["and_compute" (list 'gate 'AND-COMPUTE (list a b t) 0)]
            ["and_uncompute" (list 'gate 'AND-UNCOMPUTE (list a b t) 0)]
            [_ (list 'gate (string->symbol (string-upcase op)) (list a b t) 0)]))]
    [else #f]))

(define (emit-openqasm3-from-revir gates [declared-qubits #f])
  (define active-wires (extract-active-revir-wires gates))
  (define n-q
    (cond
      [(and declared-qubits (exact-positive-integer? declared-qubits)) declared-qubits]
      [(null? active-wires) 1]
      [else (add1 (apply max active-wires))]))
  (define header
    (list "OPENQASM 3.0;"
          "include \"stdgates.inc\";"
          (format "qubit[~a] q;" n-q)))
  (define body (map revir-gate->openqasm3-line gates))
  (string-join (append header body) "\n"))

(define (parse-openqasm3-to-revir qasm-str)
  (define lines (string-split qasm-str "\n"))
  (filter-map openqasm3-line->revir-gate lines))

(define (openqasm3-declared-qubit-count qasm-str)
  (define m (regexp-match #px"qubit\\[([0-9]+)\\]\\s+q;" qasm-str))
  (if m (string->number (second m)) 0))

(define (pass-m71-openqasm3-roundtrip-parser-and-38-today-benchmark-verifier
         [enforce-guard? #t])
  (define all-38-res (all-today-1-to-38-benchmarks))
  (define sample-gates
    (list (list 'gate 'H '(0) 0)
          (list 'gate 'CX '(0 1) 0)
          (list 'gate 'AND-COMPUTE '(0 1 2) 0)
          (list 'gate 'CZ '(1 2) 0)
          (list 'gate 'AND-UNCOMPUTE '(0 1 2) 0)
          (list 'gate 'CX '(0 1) 0)
          (list 'gate 'H '(0) 0)))
  (define compacted-sample
    (hash-ref (pass-m62-chordal-ssa-dense-qubit-compaction sample-gates #t) 'compacted-gates))
  (define qasm-str
    (if enforce-guard?
        (emit-openqasm3-from-revir compacted-sample)
        ;; Bug F135: uncompacted/corrupted OpenQASM 3.0 emitter drops CZ and inflates qubit[64]
        (emit-openqasm3-from-revir
         (append (filter (lambda (g) (not (eq? (gate-op-symbol g) 'CZ))) compacted-sample)
                 (list (list 'gate 'H '(0) 0) (list 'gate 'H '(0) 0)))
         64)))
  (define parsed-gates (parse-openqasm3-to-revir qasm-str))
  (define declared-q (openqasm3-declared-qubit-count qasm-str))
  (define active-q (length (extract-active-revir-wires parsed-gates)))
  (define roundtrip-syntactic-eq? (equal? parsed-gates compacted-sample))
  (define roundtrip-semantic-eq?
    (and (equal? (simulate-revir-exact-dyadic-statevector parsed-gates 0)
                 (simulate-revir-exact-dyadic-statevector compacted-sample 0))
         (equal? (simulate-revir-exact-dyadic-statevector parsed-gates 3)
                 (simulate-revir-exact-dyadic-statevector compacted-sample 3))))
  (define zero-unused-qubits? (= declared-q active-q))
  (define zero-adjacent-self-canceling?
    (= (count-post-route-adjacent-self-canceling-gates parsed-gates) 0))
  (hash 'pass 'M71-openqasm3-roundtrip-parser-and-38-today-benchmark-verifier
        's-number 'S105
        'today-benchmarks-verified (hash-ref all-38-res 'total-today-benchmarks)
        'all-38-today-roundtrip-verified? (hash-ref all-38-res 'all-openqasm3-roundtrip-verified?)
        'qasm-string qasm-str
        'parsed-gates parsed-gates
        'declared-qubits declared-q
        'active-qubits active-q
        'roundtrip-syntactic-eq? roundtrip-syntactic-eq?
        'roundtrip-semantic-eq? roundtrip-semantic-eq?
        'zero-unused-qubits? zero-unused-qubits?
        'zero-adjacent-self-canceling? zero-adjacent-self-canceling?
        'openqasm3-roundtrip-or-unused-qubit-hazard?
        (or (not roundtrip-syntactic-eq?)
            (not roundtrip-semantic-eq?)
            (not zero-unused-qubits?)
            (not zero-adjacent-self-canceling?))
        'verified? (and enforce-guard?
                        (hash-ref all-38-res 'verified?)
                        roundtrip-syntactic-eq?
                        roundtrip-semantic-eq?
                        zero-unused-qubits?
                        zero-adjacent-self-canceling?)))

(define (s105-openqasm3-roundtrip-syntactic-and-semantic-equivalence-guard
         [enforce-guard? #t])
  (pass-m71-openqasm3-roundtrip-parser-and-38-today-benchmark-verifier enforce-guard?))


