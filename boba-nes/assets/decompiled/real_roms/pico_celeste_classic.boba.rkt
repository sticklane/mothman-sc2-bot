telseif this.grace > 0 then" "\t\t this.grace-=1" "\t\tend" "" "\t\tthis.dash_effect_time -=1" "  if this.dash_time > 0 then" "   init_object(smoke,this.x,this.y)" "  \tthis.dash_time-=1" "  \tthis.spd.x=appr(this.spd.x,this.dash_target.x,this.dash_accel.x)" "  \tthis.spd.y=appr(this.spd.y,this.dash_target.y,this.dash_accel.y)  " "  else" "" "\t\t\t-- move" "\t\t\tlocal maxrun=1" "\t\t\tlocal accel=0.6" "\t\t\tlocal deccel=0.15" "\t\t\t" "\t\t\tif not on_ground then" "\t\t\t\taccel=0.4" "\t\t\telseif on_ice then" "\t\t\t\taccel=0.05" "\t\t\t\tif input==(this.flip.x and -1 or 1) then" "\t\t\t\t\taccel=0.05" "\t\t\t\tend" "\t\t\tend" "\t\t" "\t\t\tif abs(this.spd.x) > maxrun then" "\t\t \tthis.spd.x=appr(this.spd.x,sign(this.spd.x)*maxrun,deccel)" "\t\t\telse" "\t\t\t\tthis.spd.x=appr(this.spd.x,input*maxrun,accel)" "\t\t\tend" "\t\t\t" "\t\t\t--facing" "\t\t\tif this.spd.x!=0 then" "\t\t\t\tthis.flip.x=(this.spd.x<0)" "\t\t\tend" "" "\t\t\t-- gravity" "\t\t\tlocal maxfall=2" "\t\t\tlocal gravity=0.21" "" "  \tif abs(this.spd.y) <= 0.15 then" "   \tgravity*=0.5" "\t\t\tend" "\t\t" "\t\t\t-- wall slide" "\t\t\tif input!=0 and this.is_solid(input,0) and not this.is_ice(input,0) then" "\t\t \tmaxfall=0.4" "\t\t \tif rnd(10)<2 then" "\t\t \t\tinit_object(smoke,this.x+input*6,this.y)" "\t\t\t\tend" "\t\t\tend" "" "\t\t\tif not on_ground then" "\t\t\t\tthis.spd.y=appr(this.spd.y,maxfall,gravity)" "\t\t\tend" "" "\t\t\t-- jump" "\t\t\tif this.jbuffer>0 then" "\t\t \tif this.grace>0 then" "\t\t  \t-- normal jump" "\t\t  \tpsfx(1)" "\t\t  \tthis.jbuffer=0" "\t\t  \tthis.grace=0" "\t\t\t\t\tthis.spd.y=-2" "\t\t\t\t\tinit_object(smoke,this.x,this.y+4)" "\t\t\t\telse" "\t\t\t\t\t-- wall jump" "\t\t\t\t\tlocal wall_dir=(this.is_solid(-3,0) and -1 or this.is_solid(3,0) and 1 or 0)" "\t\t\t\t\tif wall_dir!=0 then" "\t\t\t \t\tpsfx(2)" "\t\t\t \t\tthis.jbuffer=0" "\t\t\t \t\tthis.spd.y=-2" "\t\t\t \t\tthis.spd.x=-wall_dir*(maxrun+1)" "\t\t\t \t\tif not this.is_ice(wall_dir*3,0) then" "\t\t \t\t\t\tinit_object(smoke,this.x+wall_dir*6,this.y)" "\t\t\t\t\t\tend" "\t\t\t\t\tend" "\t\t\t\tend" "\t\t\tend" "\t\t" "\t\t\t-- dash" "\t\t\tlocal d_full=5" "\t\t\tlocal d_half=d_full*0.70710678118" "\t\t" "\t\t\tif this.djump>0 and dash then" "\t\t \tinit_object(smoke,this.x,this.y)" "\t\t \tthis.djump-=1\t\t" "\t\t \tthis.dash_time=4" "\t\t \thas_dashed=true" "\t\t \tthis.dash_effect_time=10" "\t\t \tlocal v_input=(btn(k_up) and -1 or (btn(k_down) and 1 or 0))" "\t\t \tif input!=0 then" "\t\t  \tif v_input!=0 then" "\t\t   \tthis.spd.x=input*d_half" "\t\t   \tthis.spd.y=v_input*d_half" "\t\t  \telse" "\t\t   \tthis.spd.x=input*d_full" "\t\t   \tthis.spd.y=0" "\t\t  \tend" "\t\t \telseif v_input!=0 then" "\t\t \t\tthis.spd.x=0" "\t\t \t\tthis.spd.y=v_input*d_full" "\t\t \telse" "\t\t \t\tthis.spd.x=(this.flip.x and -1 or 1)" "\t\t  \tthis.spd.y=0" "\t\t \tend" "\t\t \t" "\t\t \tpsfx(3)" "\t\t \tfreeze=2" "\t\t \tshake=6" "\t\t \tthis.dash_target.x=2*sign(this.spd.x)" "\t\t \tthis.dash_target.y=2*sign(this.spd.y)" "\t\t \tthis.dash_accel.x=1.5" "\t\t \tthis.dash_accel.y=1.5" "\t\t \t" "\t\t \tif this.spd.y<0 then" "\t\t \t this.dash_target.y*=.75" "\t\t \tend" "\t\t \t" "\t\t \tif this.spd.y!=0 then" "\t\t \t this.dash_accel.x*=0.70710678118" "\t\t \tend" "\t\t \tif this.spd.x!=0 then" "\t\t \t this.dash_accel.y*=0.70710678118" "\t\t \tend\t \t " "\t\t\telseif dash and this.djump<=0 then" "\t\t\t psfx(9)" "\t\t\t init_object(smoke,this.x,this.y)" "\t\t\tend" "\t\t" "\t\tend" "\t\t" "\t\t-- animation" "\t\tthis.spr_off+=0.25" "\t\tif not on_ground then" "\t\t\tif this.is_solid(input,0) then" "\t\t\t\tthis.spr=5" "\t\t\telse" "\t\t\t\tthis.spr=3" "\t\t\tend" "\t\telseif btn(k_down) then" "\t\t\tthis.spr=6" "\t\telseif btn(k_up) then" "\t\t\tthis.spr=7" "\t\telseif (this.spd.x==0) or (not btn(k_left) and not btn(k_right)) then" "\t\t\tthis.spr=1" "\t\telse" "\t\t\tthis.spr=1+this.spr_off%4" "\t\tend" "\t\t" "\t\t-- next level" "\t\tif this.y<-4 and level_index()<30 then next_room() end" "\t\t" "\t\t-- was on the ground" "\t\tthis.was_on_ground=on_ground" "\t\t" "\tend, --<end update loop" "\t" "\tdraw=function(this)" "\t" "\t\t-- clamp in screen" "\t\tif this.x<-1 or this.x>121 then " "\t\t\tthis.x=clamp(this.x,-1,121)" "\t\t\tthis.spd.x=0" "\t\tend" "\t\t" "\t\tset_hair_color(this.djump)" "\t\tdraw_hair(this,this.flip.x and -1 or 1)" "\t\tspr(this.spr,this.x,this.y,1,1,this.flip.x,this.flip.y)\t\t" "\t\tunset_hair_color()" "\tend" "}" "" "psfx=function(num)" " if sfx_timer<=0 then" "  sfx(num)" " end" "end" "" "create_hair=function(obj)" "\tobj.hair={}" "\tfor i=0,4 do" "\t\tadd(obj.hair,{x=obj.x,y=obj.y,size=max(1,min(2,3-i))})" "\tend" "end" "" "set_hair_color=function(djump)" "\tpal(8,(djump==1 and 8 or djump==2 and (7+flr((frames/3)%2)*4) or 12))" "end" "" "draw_hair=function(obj,facing)" "\tlocal last={x=obj.x+4-facing*2,y=obj.y+(btn(k_down) and 4 or 3)}" "\tforeach(obj.hair,function(h)" "\t\th.x+=(last.x-h.x)/1.5" "\t\th.y+=(last.y+0.5-h.y)/1.5" "\t\tcircfill(h.x,h.y,h.size,8)" "\t\tlast=h" "\tend)" "end" "" "unset_hair_color=function()" "\tpal(8,8)" "end" "" "player_spawn = {" "\ttile=1," "\tinit=function(this)" "\t sfx(4)" "\t\tthis.spr=3" "\t\tthis.target= {x=this.x,y=this.y}" "\t\tthis.y=128" "\t\tthis.spd.y=-4" "\t\tthis.state=0" "\t\tthis.delay=0" "\t\tthis.solids=false" "\t\tcreate_hair(this)" "\tend," "\tupdate=function(this)" "\t\t-- jumping up" "\t\tif this.state==0 then" "\t\t\tif this.y < this.target.y+16 then" "\t\t\t\tthis.state=1" "\t\t\t\tthis.delay=3" "\t\t\tend" "\t\t-- falling" "\t\telseif this.state==1 then" "\t\t\tthis.spd.y+=0.5" "\t\t\tif this.spd.y>0 and this.delay>0 then" "\t\t\t\tthis.spd.y=0" "\t\t\t\tthis.delay-=1" "\t\t\tend" "\t\t\tif this.spd.y>0 and this.y > this.target.y then" "\t\t\t\tthis.y=this.target.y" "\t\t\t\tthis.spd = {x=0,y=0}" "\t\t\t\tthis.state=2" "\t\t\t\tthis.delay=5" "\t\t\t\tshake=5" "\t\t\t\tinit_object(smoke,this.x,this.y+4)" "\t\t\t\tsfx(5)" "\t\t\tend" "\t\t-- landing" "\t\telseif this.state==2 then" "\t\t\tthis.delay-=1" "\t\t\tthis.spr=6" "\t\t\tif this.delay<0 then" "\t\t\t\tdestroy_object(this)" "\t\t\t\tinit_object(player,this.x,this.y)" "\t\t\tend" "\t\tend" "\tend," "\tdraw=function(this)" "\t\tset_hair_color(max_djump)" "\t\tdraw_hair(this,1)" "\t\tspr(this.spr,this.x,this.y,1,1,this.flip.x,this.flip.y)" "\t\tunset_hair_color()" "\tend" "}" "add(types,player_spawn)" "" "spring = {" "\ttile=18," "\tinit=function(this)" "\t\tthis.hide_in=0" "\t\tthis.hide_for=0" "\tend," "\tupdate=function(this)" "\t\tif this.hide_for>0 then" "\t\t\tthis.hide_for-=1" "\t\t\tif this.hide_for<=0 then" "\t\t\t\tthis.spr=18" "\t\t\t\tthis.delay=0" "\t\t\tend" "\t\telseif this.spr==18 then" "\t\t\tlocal hit = this.collide(player,0,0)" "\t\t\tif hit ~=nil and hit.spd.y>=0 then" "\t\t\t\tthis.spr=19" "\t\t\t\thit.y=this.y-4" "\t\t\t\thit.spd.x*=0.2" "\t\t\t\thit.spd.y=-3" "\t\t\t\thit.djump=max_djump" "\t\t\t\tthis.delay=10" "\t\t\t\tinit_object(smoke,this.x,this.y)" "\t\t\t\t" "\t\t\t\t-- breakable below us" "\t\t\t\tlocal below=this.collide(fall_floor,0,1)" "\t\t\t\tif below~=nil then" "\t\t\t\t\tbreak_fall_floor(below)" "\t\t\t\tend" "\t\t\t\t" "\t\t\t\tpsfx(8)" "\t\t\tend" "\t\telseif this.delay>0 then" "\t\t\tthis.delay-=1" "\t\t\tif this.delay<=0 then " "\t\t\t\tthis.spr=18 " "\t\t\tend" "\t\tend" "\t\t-- begin hiding" "\t\tif this.hide_in>0 then" "\t\t\tthis.hide_in-=1" "\t\t\tif this.hide_in<=0 then" "\t\t\t\tthis.hide_for=60" "\t\t\t\tthis.spr=0" "\t\t\tend" "\t\tend" "\tend" "}" "add(types,spring)" "" "function break_spring(obj)" "\tobj.hide_in=15" "end" "" "balloon = {" "\ttile=22," "\tinit=function(this) " "\t\tthis.offset=rnd(1)" "\t\tthis.start=this.y" "\t\tthis.timer=0" "\t\tthis.hitbox={x=-1,y=-1,w=10,h=10}" "\tend," "\tupdate=function(this) " "\t\tif this.spr==22 then" "\t\t\tthis.offset+=0.01" "\t\t\tthis.y=this.start+sin(this.offset)*2" "\t\t\tlocal hit = this.collide(player,0,0)" "\t\t\tif hit~=nil and hit.djump<max_djump then" "\t\t\t\tpsfx(6)" "\t\t\t\tinit_object(smoke,this.x,this.y)" "\t\t\t\thit.djump=max_djump" "\t\t\t\tthis.spr=0" "\t\t\t\tthis.timer=60" "\t\t\tend" "\t\telseif this.timer>0 then" "\t\t\tthis.timer-=1" "\t\telse " "\t\t psfx(7)" "\t\t init_object(smoke,this.x,this.y)" "\t\t\tthis.spr=22 " "\t\tend" "\tend," "\tdraw=function(this)" "\t\tif this.spr==22 then" "\t\t\tspr(13+(this.offset*8)%3,this.x,this.y+6)" "\t\t\tspr(this.spr,this.x,this.y)" "\t\tend" "\tend" "}" "add(types,balloon)" "" "fall_floor = {" "\ttile=23," "\tinit=function(this)" "\t\tthis.state=0" "\t\tthis.solid=true" "\tend," "\tupdate=function(this)" "\t\t-- idling" "\t\tif this.state == 0 then" "\t\t\tif this.check(player,0,-1) or this.check(player,-1,0) or this.check(player,1,0) then" "\t\t\t\tbreak_fall_floor(this)" "\t\t\tend" "\t\t-- shaking" "\t\telseif this.state==1 then" "\t\t\tthis.delay-=1" "\t\t\tif this.delay<=0 then" "\t\t\t\tthis.state=2" "\t\t\t\tthis.delay=60--how long it hides for" "\t\t\t\tthis.collideable=false" "\t\t\tend" "\t\t-- invisible, waiting to reset" "\t\telseif this.state==2 then" "\t\t\tthis.delay-=1" "\t\t\tif this.delay<=0 and not this.check(player,0,0) then" "\t\t\t\tpsfx(7)" "\t\t\t\tthis.state=0" "\t\t\t\tthis.collideable=true" "\t\t\t\tinit_object(smoke,this.x,this.y)" "\t\t\tend" "\t\tend" "\tend," "\tdraw=function(this)" "\t\tif this.state!=2 then" "\t\t\tif this.state!=1 then" "\t\t\t\tspr(23,this.x,this.y)" "\t\t\telse" "\t\t\t\tspr(23+(15-this.delay)/5,this.x,this.y)" "\t\t\tend" "\t\tend" "\tend" "}" "add(types,fall_floor)" "" "function break_fall_floor(obj)" " if obj.state==0 then" " \tpsfx(15)" "\t\tobj.state=1" "\t\tobj.delay=15--how long until it falls" "\t\tinit_object(smoke,obj.x,obj.y)" "\t\tlocal hit=obj.collide(spring,0,-1)" "\t\tif hit~=nil then" "\t\t\tbreak_spring(hit)" "\t\tend" "\tend" "end" "" "smoke={" "\tinit=function(this)" "\t\tthis.spr=29" "\t\tthis.spd.y=-0.1" "\t\tthis.spd.x=0.3+rnd(0.2)" "\t\tthis.x+=-1+rnd(2)" "\t\tthis.y+=-1+rnd(2)" "\t\tthis.flip.x=maybe()" "\t\tthis.flip.y=maybe()" "\t\tthis.solids=false" "\tend," "\tupdate=function(this)" "\t\tthis.spr+=0.2" "\t\tif this.spr>=32 then" "\t\t\tdestroy_object(this)" "\t\tend" "\tend" "}" "" "fruit={" "\ttile=26," "\tif_not_fruit=true," "\tinit=function(this) " "\t\tthis.start=this.y" "\t\tthis.off=0" "\tend," "\tupdate=function(this)" "\t local hit=this.collide(player,0,0)" "\t\tif hit~=nil then" "\t\t hit.djump=max_djump" "\t\t\tsfx_timer=20" "\t\t\tsfx(13)" "\t\t\tgot_fruit[1+level_index()] = true" "\t\t\tinit_object(lifeup,this.x,this.y)" "\t\t\tdestroy_object(this)" "\t\tend" "\t\tthis.off+=1" "\t\tthis.y=this.start+sin(this.off/40)*2.5" "\tend" "}" "add(types,fruit)" "" "fly_fruit={" "\ttile=28," "\tif_not_fruit=true," "\tinit=function(this) " "\t\tthis.start=this.y" "\t\tthis.fly=false" "\t\tthis.step=0.5" "\t\tthis.solids=false" "\t\tthis.sfx_delay=8" "\tend," "\tupdate=function(this)" "\t\t--fly away" "\t\tif this.fly then" "\t\t if this.sfx_delay>0 then" "\t\t  this.sfx_delay-=1" "\t\t  if this.sfx_delay<=0 then" "\t\t   sfx_timer=20" "\t\t   sfx(14)" "\t\t  end" "\t\t end" "\t\t\tthis.spd.y=appr(this.spd.y,-3.5,0.25)" "\t\t\tif this.y<-16 then" "\t\t\t\tdestroy_object(this)" "\t\t\tend" "\t\t-- wait" "\t\telse" "\t\t\tif has_dashed then" "\t\t\t\tthis.fly=true" "\t\t\tend" "\t\t\tthis.step+=0.05" "\t\t\tthis.spd.y=sin(this.step)*0.5" "\t\tend" "\t\t-- collect" "\t\tlocal hit=this.collide(player,0,0)" "\t\tif hit~=nil then" "\t\t hit.djump=max_djump" "\t\t\tsfx_timer=20" "\t\t\tsfx(13)" "\t\t\tgot_fruit[1+level_index()] = true" "\t\t\tinit_object(lifeup,this.x,this.y)" "\t\t\tdestroy_object(this)" "\t\tend" "\tend," "\tdraw=function(this)" "\t\tlocal off=0" "\t\tif not this.fly then" "\t\t\tlocal dir=sin(this.step)" "\t\t\tif dir<0 then" "\t\t\t\toff=1+max(0,sign(this.y-this.start))" "\t\t\tend" "\t\telse" "\t\t\toff=(off+0.25)%3" "\t\tend" "\t\tspr(45+off,this.x-6,this.y-2,1,1,true,false)" "\t\tspr(this.spr,this.x,this.y)" "\t\tspr(45+off,this.x+6,this.y-2)" "\tend" "}" "add(types,fly_fruit)" "" "lifeup = {" "\tinit=function(this)" "\t\tthis.spd.y=-0.25" "\t\tthis.duration=30" "\t\tthis.x-=2" "\t\tthis.y-=4" "\t\tthis.flash=0" "\t\tthis.solids=false" "\tend," "\tupdate=function(this)" "\t\tthis.duration-=1" "\t\tif this.duration<= 0 then" "\t\t\tdestroy_object(this)" "\t\tend" "\tend," "\tdraw=function(this)" "\t\tthis.flash+=0.5" "" "\t\tprint(\"1000\",this.x-2,this.y,7+this.flash%2)" "\tend" "}" "" "fake_wall = {" "\ttile=64," "\tif_not_fruit=true," "\tupdate=function(this)" "\t\tthis.hitbox={x=-1,y=-1,w=18,h=18}" "\t\tlocal hit = this.collide(player,0,0)" "\t\tif hit~=nil and hit.dash_effect_time>0 then" "\t\t\thit.spd.x=-sign(hit.spd.x)*1.5" "\t\t\thit.spd.y=-1.5" "\t\t\thit.dash_time=-1" "\t\t\tsfx_timer=20" "\t\t\tsfx(16)" "\t\t\tdestroy_object(this)" "\t\t\tinit_object(smoke,this.x,this.y)" "\t\t\tinit_object(smoke,this.x+8,this.y)" "\t\t\tinit_object(smoke,this.x,this.y+8)" "\t\t\tinit_object(smoke,this.x+8,this.y+8)" "\t\t\tinit_object(fruit,this.x+4,this.y+4)" "\t\tend" "\t\tthis.hitbox={x=0,y=0,w=16,h=16}" "\tend," "\tdraw=function(this)" "\t\tspr(64,this.x,this.y)" "\t\tspr(65,this.x+8,this.y)" "\t\tspr(80,this.x,this.y+8)" "\t\tspr(81,this.x+8,this.y+8)" "\tend" "}" "add(types,fake_wall)" "" "key={" "\ttile=8," "\tif_not_fruit=true," "\tupdate=function(this)" "\t\tlocal was=flr(this.spr)" "\t\tthis.spr=9+(sin(frames/30)+0.5)*1" "\t\tlocal is=flr(this.spr)" "\t\tif is==10 and is!=was then" "\t\t\tthis.flip.x=not this.flip.x" "\t\tend" "\t\tif this.check(player,0,0) then" "\t\t\tsfx(23)" "\t\t\tsfx_timer=10" "\t\t\tdestroy_object(this)" "\t\t\thas_key=true" "\t\tend" "\tend" "}" "add(types,key)" "" "chest={" "\ttile=20," "\tif_not_fruit=true," "\tinit=function(this)" "\t\tthis.x-=4" "\t\tthis.start=this.x" "\t\tthis.timer=20" "\tend," "\tupdate=function(this)" "\t\tif has_key then" "\t\t\tthis.timer-=1" "\t\t\tthis.x=this.start-1+rnd(3)" "\t\t\tif this.timer<=0 then" "\t\t\t sfx_timer=20" "\t\t\t sfx(16)" "\t\t\t\tinit_object(fruit,this.x,this.y-4)" "\t\t\t\tdestroy_object(this)" "\t\t\tend" "\t\tend" "\tend" "}" "add(types,chest)" "" "platform={" "\tinit=function(this)" "\t\tthis.x-=4" "\t\tthis.solids=false" "\t\tthis.hitbox.w=16" "\t\tthis.last=this.x" "\tend," "\tupdate=function(this)" "\t\tthis.spd.x=this.dir*0.65" "\t\tif this.x<-16 then this.x=128" "\t\telseif this.x>128 then this.x=-16 end" "\t\tif not this.check(player,0,0) then" "\t\t\tlocal hit=this.collide(player,0,-1)" "\t\t\tif hit~=nil then" "\t\t\t\thit.move_x(this.x-this.last,1)" "\t\t\tend" "\t\tend" "\t\tthis.last=this.x" "\tend," "\tdraw=function(this)" "\t\tspr(11,this.x,this.y-1)" "\t\tspr(12,this.x+8,this.y-1)" "\tend" "}" "" "message={" "\ttile=86," "\tlast=0," "\tdraw=function(this)" "\t\tthis.text=\"-- celeste mountain --#this memorial to those# perished on the climb\"" "\t\tif this.check(player,4,0) then" "\t\t\tif this.index<#this.text then" "\t\t\t this.index+=0.5" "\t\t\t\tif this.index>=this.last+1 then" "\t\t\t\t this.last+=1" "\t\t\t\t sfx(35)" "\t\t\t\tend" "\t\t\tend" "\t\t\tthis.off={x=8,y=96}" "\t\t\tfor i=1,this.index do" "\t\t\t\tif sub(this.text,i,i)~=\"#\" then" "\t\t\t\t\trectfill(this.off.x-2,this.off.y-2,this.off.x+7,this.off.y+6 ,7)" "\t\t\t\t\tprint(sub(this.text,i,i),this.off.x,this.off.y,0)" "\t\t\t\t\tthis.off.x+=5" "\t\t\t\telse" "\t\t\t\t\tthis.off.x=8" "\t\t\t\t\tthis.off.y+=7" "\t\t\t\tend" "\t\t\tend" "\t\telse" "\t\t\tthis.index=0" "\t\t\tthis.last=0" "\t\tend" "\tend" "}" "add(types,message)" "" "big_chest={" "\ttile=96," "\tinit=function(this)" "\t\tthis.state=0" "\t\tthis.hitbox.w=16" "\tend," "\tdraw=function(this)" "\t\tif this.state==0 then" "\t\t\tlocal hit=this.collide(player,0,8)" "\t\t\tif hit~=nil and hit.is_solid(0,1) then" "\t\t\t\tmusic(-1,500,7)" "\t\t\t\tsfx(37)" "\t\t\t\tpause_player=true" "\t\t\t\thit.spd.x=0" "\t\t\t\thit.spd.y=0" "\t\t\t\tthis.state=1" "\t\t\t\tinit_object(smoke,this.x,this.y)" "\t\t\t\tinit_object(smoke,this.x+8,this.y)" "\t\t\t\tthis.timer=60" "\t\t\t\tthis.particles={}" "\t\t\tend" "\t\t\tspr(96,this.x,this.y)" "\t\t\tspr(97,this.x+8,this.y)" "\t\telseif this.state==1 then" "\t\t\tthis.timer-=1" "\t\t shake=5" "\t\t flash_bg=true" "\t\t\tif this.timer<=45 and count(this.particles)<50 then" "\t\t\t\tadd(this.particles,{" "\t\t\t\t\tx=1+rnd(14)," "\t\t\t\t\ty=0," "\t\t\t\t\th=32+rnd(32)," "\t\t\t\t\tspd=8+rnd(8)" "\t\t\t\t})" "\t\t\tend" "\t\t\tif this.timer<0 then" "\t\t\t\tthis.state=2" "\t\t\t\tthis.particles={}" "\t\t\t\tflash_bg=false" "\t\t\t\tnew_bg=true" "\t\t\t\tinit_object(orb,this.x+4,this.y+4)" "\t\t\t\tpause_player=false" "\t\t\tend" "\t\t\tforeach(this.particles,function(p)" "\t\t\t\tp.y+=p.spd" "\t\t\t\tline(this.x+p.x,this.y+8-p.y,this.x+p.x,min(this.y+8-p.y+p.h,this.y+8),7)" "\t\t\tend)" "\t\tend" "\t\tspr(112,this.x,this.y+8)" "\t\tspr(113,this.x+8,this.y+8)" "\tend" "}" "add(types,big_chest)" "" "orb={" "\tinit=function(this)" "\t\tthis.spd.y=-4" "\t\tthis.solids=false" "\t\tthis.particles={}" "\tend," "\tdraw=function(this)" "\t\tthis.spd.y=appr(this.spd.y,0,0.5)" "\t\tlocal hit=this.collide(player,0,0)" "\t\tif this.spd.y==0 and hit~=nil then" "\t\t music_timer=45" "\t\t\tsfx(51)" "\t\t\tfreeze=10" "\t\t\tshake=10" "\t\t\tdestroy_object(this)" "\t\t\tmax_djump=2" "\t\t\thit.djump=2" "\t\tend" "\t\t" "\t\tspr(102,this.x,this.y)" "\t\tlocal off=frames/30" "\t\tfor i=0,7 do" "\t\t\tcircfill(this.x+4+cos(off+i/8)*8,this.y+4+sin(off+i/8)*8,1,7)" "\t\tend" "\tend" "}" "" "flag = {" "\ttile=118," "\tinit=function(this)" "\t\tthis.x+=5" "\t\tthis.score=0" "\t\tthis.show=false" "\t\tfor i=1,count(got_fruit) do" "\t\t\tif got_fruit[i] then" "\t\t\t\tthis.score+=1" "\t\t\tend" "\t\tend" "\tend," "\tdraw=function(this)" "\t\tthis.spr=118+(frames/5)%3" "\t\tspr(this.spr,this.x,this.y)" "\t\tif this.show then" "\t\t\trectfill(32,2,96,31,0)" "\t\t\tspr(26,55,6)" "\t\t\tprint(\"x\"..this.score,64,9,7)" "\t\t\tdraw_time(49,16)" "\t\t\tprint(\"deaths:\"..deaths,48,24,7)" "\t\telseif this.check(player,0,0) then" "\t\t\tsfx(55)" "\t  sfx_timer=30" "\t\t\tthis.show=true" "\t\tend" "\tend" "}" "add(types,flag)" "" "room_title = {" "\tinit=function(this)" "\t\tthis.delay=5" " end," "\tdraw=function(this)" "\t\tthis.delay-=1" "\t\tif this.delay<-30 then" "\t\t\tdestroy_object(this)" "\t\telseif this.delay<0 then" "\t\t\t" "\t\t\trectfill(24,58,104,70,0)" "\t\t\t--rect(26,64-10,102,64+10,7)" "\t\t\t--print(\"---\",31,64-2,13)" "\t\t\tif room.x==3 and room.y==1 then" "\t\t\t\tprint(\"old site\",48,62,7)" "\t\t\telseif level_index()==30 then" "\t\t\t\tprint(\"summit\",52,62,7)" "\t\t\telse" "\t\t\t\tlocal level=(1+level_index())*100" "\t\t\t\tprint(level..\" m\",52+(level<1000 and 2 or 0),62,7)" "\t\t\tend" "\t\t\t--print(\"---\",86,64-2,13)" "\t\t\t" "\t\t\tdraw_time(4,4)" "\t\tend" "\tend" "}" "" "-- object functions --" "-----------------------" "" "function init_object(type,x,y)" "\tif type.if_not_fruit~=nil and got_fruit[1+level_index()] then" "\t\treturn" "\tend" "\tlocal obj = {}" "\tobj.type = type" "\tobj.collideable=true" "\tobj.solids=true" "" "\tobj.spr = type.tile" "\tobj.flip = {x=false,y=false}" "" "\tobj.x = x" "\tobj.y = y" "\tobj.hitbox = { x=0,y=0,w=8,h=8 }" "" "\tobj.spd = {x=0,y=0}" "\tobj.rem = {x=0,y=0}" "" "\tobj.is_solid=function(ox,oy)" "\t\tif oy>0 and not obj.check(platform,ox,0) and obj.check(platform,ox,oy) then" "\t\t\treturn true" "\t\tend" "\t\treturn solid_at(obj.x+obj.hitbox.x+ox,obj.y+obj.hitbox.y+oy,obj.hitbox.w,obj.hitbox.h)" "\t\t or obj.check(fall_floor,ox,oy)" "\t\t or obj.check(fake_wall,ox,oy)" "\tend" "\t" "\tobj.is_ice=function(ox,oy)" "\t\treturn ice_at(obj.x+obj.hitbox.x+ox,obj.y+obj.hitbox.y+oy,obj.hitbox.w,obj.hitbox.h)" "\tend" "\t" "\tobj.collide=function(type,ox,oy)" "\t\tlocal other" "\t\tfor i=1,count(objects) do" "\t\t\tother=objects[i]" "\t\t\tif other ~=nil and other.type == type and other != obj and other.collideable and" "\t\t\t\tother.x+other.hitbox.x+other.hitbox.w > obj.x+obj.hitbox.x+ox and " "\t\t\t\tother.y+other.hitbox.y+other.hitbox.h > obj.y+obj.hitbox.y+oy and" "\t\t\t\tother.x+other.hitbox.x < obj.x+obj.hitbox.x+obj.hitbox.w+ox and " "\t\t\t\tother.y+other.hitbox.y < obj.y+obj.hitbox.y+obj.hitbox.h+oy then" "\t\t\t\treturn other" "\t\t\tend" "\t\tend" "\t\treturn nil" "\tend" "\t" "\tobj.check=function(type,ox,oy)" "\t\treturn obj.collide(type,ox,oy) ~=nil" "\tend" "\t" "\tobj.move=function(ox,oy)" "\t\tlocal amount" "\t\t-- [x] get move amount" " \tobj.rem.x += ox" "\t\tamount = flr(obj.rem.x + 0.5)" "\t\tobj.rem.x -= amount" "\t\tobj.move_x(amount,0)" "\t\t" "\t\t-- [y] get move amount" "\t\tobj.rem.y += oy" "\t\tamount = flr(obj.rem.y + 0.5)" "\t\tobj.rem.y -= amount" "\t\tobj.move_y(amount)" "\tend" "\t" "\tobj.move_x=function(amount,start)" "\t\tif obj.solids then" "\t\t\tlocal step = sign(amount)" "\t\t\tfor i=start,abs(amount) do" "\t\t\t\tif not obj.is_solid(step,0) then" "\t\t\t\t\tobj.x += step" "\t\t\t\telse" "\t\t\t\t\tobj.spd.x = 0" "\t\t\t\t\tobj.rem.x = 0" "\t\t\t\t\tbreak" "\t\t\t\tend" "\t\t\tend" "\t\telse" "\t\t\tobj.x += amount" "\t\tend" "\tend" "\t" "\tobj.move_y=function(amount)" "\t\tif obj.solids then" "\t\t\tlocal step = sign(amount)" "\t\t\tfor i=0,abs(amount) do" "\t \t\tif not obj.is_solid(0,step) then" "\t\t\t\t\tobj.y += step" "\t\t\t\telse" "\t\t\t\t\tobj.spd.y = 0" "\t\t\t\t\tobj.rem.y = 0" "\t\t\t\t\tbreak" "\t\t\t\tend" "\t\t\tend" "\t\telse" "\t\t\tobj.y += amount" "\t\tend" "\tend" "" "\tadd(objects,obj)" "\tif obj.type.init~=nil then" "\t\tobj.type.init(obj)" "\tend" "\treturn obj" "end" "" "function destroy_object(obj)" "\tdel(objects,obj)" "end" "" "function kill_player(obj)" "\tsfx_timer=12" "\tsfx(0)" "\tdeaths+=1" "\tshake=10" "\tdestroy_object(obj)" "\tdead_particles={}" "\tfor dir=0,7 do" "\t\tlocal angle=(dir/8)" "\t\tadd(dead_particles,{" "\t\t\tx=obj.x+4," "\t\t\ty=obj.y+4," "\t\t\tt=10," "\t\t\tspd={" "\t\t\t\tx=sin(angle)*3," "\t\t\t\ty=cos(angle)*3" "\t\t\t}" "\t\t})" "\t\trestart_room()" "\tend" "end" "" "-- room functions --" "--------------------" "" "function restart_room()" "\twill_restart=true" "\tdelay_restart=15" "end" "" "function next_room()" " if room.x==2 and room.y==1 then" "  music(30,500,7)" " elseif room.x==3 and room.y==1 then" "  music(20,500,7)" " elseif room.x==4 and room.y==2 then" "  music(30,500,7)" " elseif room.x==5 and room.y==3 then" "  music(30,500,7)" " end" "" "\tif room.x==7 then" "\t\tload_room(0,room.y+1)" "\telse" "\t\tload_room(room.x+1,room.y)" "\tend" "end" "" "function load_room(x,y)" "\thas_dashed=false" "\thas_key=false" "" "\t--remove existing objects" "\tforeach(objects,destroy_object)" "" "\t--current room" "\troom.x = x" "\troom.y = y" "" "\t-- entities" "\tfor tx=0,15 do" "\t\tfor ty=0,15 do" "\t\t\tlocal tile = mget(room.x*16+tx,room.y*16+ty);" "\t\t\tif tile==11 then" "\t\t\t\tinit_object(platform,tx*8,ty*8).dir=-1" "\t\t\telseif tile==12 then" "\t\t\t\tinit_object(platform,tx*8,ty*8).dir=1" "\t\t\telse" "\t\t\t\tforeach(types, " "\t\t\t\tfunction(type) " "\t\t\t\t\tif type.tile == tile then" "\t\t\t\t\t\tinit_object(type,tx*8,ty*8) " "\t\t\t\t\tend " "\t\t\t\tend)" "\t\t\tend" "\t\tend" "\tend" "\t" "\tif not is_title() then" "\t\tinit_object(room_title,0,0)" "\tend" "end" "" "-- update function --" "-----------------------" "" "function _update()" "\tframes=((frames+1)%30)" "\tif frames==0 and level_index()<30 then" "\t\tseconds=((seconds+1)%60)" "\t\tif seconds==0 then" "\t\t\tminutes+=1" "\t\tend" "\tend" "\t" "\tif music_timer>0 then" "\t music_timer-=1" "\t if music_timer<=0 then" "\t  music(10,0,7)" "\t end" "\tend" "\t" "\tif sfx_timer>0 then" "\t sfx_timer-=1" "\tend" "\t" "\t-- cancel if freeze" "\tif freeze>0 then freeze-=1 return end" "" "\t-- screenshake" "\tif shake>0 then" "\t\tshake-=1" "\t\tcamera()" "\t\tif shake>0 then" "\t\t\tcamera(-2+rnd(5),-2+rnd(5))" "\t\tend" "\tend" "\t" "\t-- restart (soon)" "\tif will_restart and delay_restart>0 then" "\t\tdelay_restart-=1" "\t\tif delay_restart<=0 then" "\t\t\twill_restart=false" "\t\t\tload_room(room.x,room.y)" "\t\tend" "\tend" "" "\t-- update each object" "\tforeach(objects,function(obj)" "\t\tobj.move(obj.spd.x,obj.spd.y)" "\t\tif obj.type.update~=nil then" "\t\t\tobj.type.update(obj) " "\t\tend" "\tend)" "\t" "\t-- start game" "\tif is_title() then" "\t\tif not start_game and (btn(k_jump) or btn(k_dash)) then" "\t\t\tmusic(-1)" "\t\t\tstart_game_flash=50" "\t\t\tstart_game=true" "\t\t\tsfx(38)" "\t\tend" "\t\tif start_game then" "\t\t\tstart_game_flash-=1" "\t\t\tif start_game_flash<=-30 then" "\t\t\t\tbegin_game()" "\t\t\tend" "\t\tend" "\tend" "end" "" "-- drawing functions --" "-----------------------" "function _draw()" "\tif freeze>0 then return end" "\t" "\t-- reset all palette values" "\tpal()" "\t" "\t-- start game flash" "\tif start_game then" "\t\tlocal c=10" "\t\tif start_game_flash>10 then" "\t\t\tif frames%10<5 then" "\t\t\t\tc=7" "\t\t\tend" "\t\telseif start_game_flash>5 then" "\t\t\tc=2" "\t\telseif start_game_flash>0 then" "\t\t\tc=1" "\t\telse " "\t\t\tc=0" "\t\tend" "\t\tif c<10 then" "\t\t\tpal(6,c)" "\t\t\tpal(12,c)" "\t\t\tpal(13,c)" "\t\t\tpal(5,c)" "\t\t\tpal(1,c)" "\t\t\tpal(7,c)" "\t\tend" "\tend" "" "\t-- clear screen" "\tlocal bg_col = 0" "\tif flash_bg then" "\t\tbg_col = frames/5" "\telseif new_bg~=nil then" "\t\tbg_col=2" "\tend" "\trectfill(0,0,128,128,bg_col)" "" "\t-- clouds" "\tif not is_title() then" "\t\tforeach(clouds, function(c)" "\t\t\tc.x += c.spd" "\t\t\trectfill(c.x,c.y,c.x+c.w,c.y+4+(1-c.w/64)*12,new_bg~=nil and 14 or 1)" "\t\t\tif c.x > 128 then" "\t\t\t\tc.x = -c.w" "\t\t\t\tc.y=rnd(128-8)" "\t\t\tend" "\t\tend)" "\tend" "" "\t-- draw bg terrain" "\tmap(room.x * 16,room.y * 16,0,0,16,16,4)" "" "\t-- platforms/big chest" "\tforeach(objects, function(o)" "\t\tif o.type==platform or o.type==big_chest then" "\t\t\tdraw_object(o)" "\t\tend" "\tend)" "" "\t-- draw terrain" "\tlocal off=is_title() and -4 or 0" "\tmap(room.x*16,room.y * 1