#lang boba-nes

;; ============================================================================
;; examples/boba_pico.bnes : PICO-8 (.p8) & RP2040 (Cortex-M0+ + PIO .uf2)
;; ============================================================================
;; Compiles and verifies both:
;;   1. build/boba_pico8.p8  : PICO-8 Fantasy Console Cartridge (__lua__,
;;      __gfx__ 128x128 4bpp sheet, __gff__, __map__, __sfx__) with verified
;;      token budget (<= 8192 tokens), signed Q16.16 fixed-point safety, and
;;      3-sector campaign playthrough (FAIL_OK -> REC_OK -> FULL_WIN_OK).
;;   2. build/boba_rp2040.uf2 : Raspberry Pi RP2040 Dual Cortex-M0+ Thumb +
;;      16-bit PIO Scanline Video State Machine (<= 32 instructions) packaged
;;      into 512-byte UF2 blocks (familyID = #xE48BFF56, flash #x10000000) with
;;      verified bank-disjoint SRAM allocation (Core 0 SRAM0..3, Core 1 SRAM4..5).
;; ============================================================================

(require racket/runtime-path
         racket/file
         racket/format
         "../compiler/backend-pico.rkt")

(define-runtime-path build-dir "../build")
(make-directory* build-dir)

(define pico8-cart-path (build-path build-dir "boba_pico8.p8"))
(define rp2040-uf2-path (build-path build-dir "boba_rp2040.uf2"))

(provide boba-pico8-cart-text
         boba-pico8-meta
         boba-rp2040-uf2-bytes
         boba-rp2040-meta
         boba-pico-verification)

(define-values (boba-pico8-cart-text boba-pico8-meta)
  (compile-boba-pico8-cart! #:out-path pico8-cart-path
                            #:title "boba pico-8"))

(define-values (boba-rp2040-uf2-bytes boba-rp2040-meta)
  (compile-boba-rp2040-uf2! #:out-path rp2040-uf2-path))

(define boba-pico-verification
  (verify-pico-backends pico8-cart-path rp2040-uf2-path))

(module+ main
  (printf "================================================================\n")
  (printf "  #lang boba-nes : PICO-8 (.p8) & RP2040 (.uf2) Backend Report\n")
  (printf "================================================================\n")
  (printf "  [1] PICO-8 Fantasy Console Cartridge\n")
  (printf "      Output .p8 File       : ~a (~a chars)\n"
          pico8-cart-path (string-length boba-pico8-cart-text))
  (printf "      Lua Token Budget      : ~a / ~a tokens (ok? = ~a)\n"
          (hash-ref boba-pico-verification 'pico8-tokens)
          (hash-ref boba-pico-verification 'pico8-token-limit)
          (hash-ref boba-pico-verification 'pico8-tokens-ok?))
  (printf "      Signed Q16.16 Range   : ~a ([-32768.0, 32767.99998])\n"
          (hash-ref boba-pico-verification 'pico8-fixed16-16-ok?))
  (printf "      Cartridge Sections    : ~a (__lua__, __gfx__, __gff__, __map__, __sfx__)\n"
          (hash-ref boba-pico-verification 'pico8-sections-ok?))
  (printf "      3-Sector Campaign     : ~a\n"
          (hash-ref boba-pico-verification 'pico8-campaign-result))
  (printf "----------------------------------------------------------------\n")
  (printf "  [2] RP2040 (Dual ARMv6-M Cortex-M0+ Thumb + PIO) Firmware\n")
  (printf "      Output .uf2 Binary    : ~a (~a bytes, ~a UF2 blocks)\n"
          rp2040-uf2-path
          (bytes-length boba-rp2040-uf2-bytes)
          (hash-ref boba-pico-verification 'uf2-block-count))
  (printf "      UF2 Header & FamilyID : valid=~a, familyID=#x~a, flash=#x~a\n"
          (hash-ref boba-pico-verification 'uf2-valid-blocks?)
          (~r (hash-ref boba-pico-verification 'uf2-family-id) #:base 16 #:min-width 8 #:pad-string "0")
          (~r (hash-ref boba-pico-verification 'uf2-flash-base) #:base 16 #:min-width 8 #:pad-string "0"))
  (printf "      PIO Scanline Program  : ~a / 32 instructions (within-limit? = ~a, ~a cyc)\n"
          (hash-ref boba-pico-verification 'pio-instruction-count)
          (hash-ref boba-pico-verification 'pio-within-32-limit?)
          (hash-ref boba-pico-verification 'pio-scanline-cycles))
  (printf "      SRAM Bank Disjointness: ~a (Core 0 SRAM0..3 vs Core 1 SRAM4..5)\n"
          (hash-ref boba-pico-verification 'sram-bank-disjoint?))
  (printf "================================================================\n"))
