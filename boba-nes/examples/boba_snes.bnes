#lang boba-nes

;; ============================================================================
;; examples/boba_snes.bnes : "Boba Is You" Super Nintendo (SNES) Edition
;; ============================================================================
;; Compiles the 4-Stage "Boba Is You" SNES Campaign into a 32,768-byte FastROM
;; LoROM (.sfc) cartridge using:
;;   - Flow-Sensitive WDC 65C816 Mode-Indexed Assembler (M/X/E width tracking)
;;   - Automatic Branch Join Mode Reconciler (reconcile-65816-branch-modes)
;;   - Sony SPC700 Audio Co-Processor Assembler & IPL ROM ($2140-$2143) Uploader
;;   - S-PPU 4bpp Planar CHR Tiles, 15-bit BGR555 CGRAM & HBlank HDMA1 Gradient
;;   - Headless SNES 65C816 + S-PPU + SPC700 Execution & Campaign Verifier
;; ============================================================================

(require racket/runtime-path
         racket/file
         racket/format
         "../compiler/backend-snes.rkt")

(define-runtime-path build-dir "../build")

;; 1. Declarative Campaign State Machine (4 Stages + Failure & START Recovery)
(defstate-machine boba_snes_campaign_fsm
  #:initial stage_0
  ([stage_0         #:kind gameplay #:transitions (stage_1)]
   [stage_1         #:kind gameplay #:transitions (stage_1_failure stage_2)]
   [stage_1_failure #:kind failure  #:transitions (stage_1)]
   [stage_2         #:kind gameplay #:transitions (stage_3)]
   [stage_3         #:kind gameplay #:transitions (stage_3_victory)]
   [stage_3_victory #:kind victory  #:transitions ()]))

;; 2. Direct-Page ($0010-$001D) Hardware Layout
(defzp-map boba_snes_dp_map
  ([dp_joy_lo       #x10 input]
   [dp_joy_hi       #x11 input]
   [dp_cur_stage    #x12 state]
   [dp_stage_status #x13 state]
   [dp_player_x     #x14 entity]
   [dp_player_y     #x15 entity]
   [dp_move_count   #x16 counter]
   [dp_recoveries   #x17 counter]
   [dp_frame_count  #x18 timer]
   [dp_spc_cmd      #x1A audio]
   [dp_rule_mask    #x1B rules]
   [dp_campaign_won #x1C victory]
   [dp_stage_clears #x1D progress]))

;; 3. Verify Branch Mode Reconciliation on a Mismatched Control-Flow Join
(define mismatched-branch-sample
  '((clc)
    (xce)
    (sep #x30)          ; M=8, X=8
    (lda-imm #x12)      ; 2 bytes
    (beq join_target)   ; Branches with M=8, X=8
    (rep #x20)          ; Fallthrough changes to M=16, X=8!
    (lda-imm #x3456)    ; 3 bytes (16-bit immediate!)
    (label join_target) ; Conflict if unreconciled: branch(M=8) vs fallthrough(M=16)
    (lda-imm #x78)
    (rts)))

(define unreconciled-check
  (verify-65816-mode-safety mismatched-branch-sample))
(define reconciled-sample
  (reconcile-65816-branch-modes mismatched-branch-sample))
(define reconciled-check
  (verify-65816-mode-safety reconciled-sample))

;; 4. Compile, Link & Verify the 32 KB SNES LoROM (.sfc) Cartridge
(make-directory* build-dir)
(define sfc-rom-path (build-path build-dir "boba_snes.sfc"))

(define-values (boba-snes-rom-bytes
                boba-snes-asm-result
                boba-snes-spc-result
                boba-snes-verification-report)
  (compile-boba-snes-rom! #:sfc-out-path sfc-rom-path
                          #:title "BOBA IS YOU SNES"))

(provide boba-snes-rom-bytes
         boba-snes-asm-result
         boba-snes-spc-result
         boba-snes-verification-report
         unreconciled-check
         reconciled-check)

(module+ main
  (define rpt boba-snes-verification-report)
  (printf "======================================================================\n")
  (printf "  #lang boba-nes : Super Nintendo (WDC 65C816 + SPC700) Build Report\n")
  (printf "======================================================================\n")
  (printf "  Output LoROM Cartridge     : ~a (~a bytes)\n"
          sfc-rom-path (bytes-length boba-snes-rom-bytes))
  (printf "  Cartridge ASCII Title      : \"~a\" ($7FC0-$7FD4)\n"
          (snes-verification-report-title rpt))
  (printf "  LoROM Map Mode ($7FD5)     : #$~a (FastROM LoROM, ROM=#$08 32KB, SRAM=#$00)\n"
          (~r (snes-verification-report-map-mode rpt) #:base 16 #:min-width 2 #:pad-string "0"))
  (printf "  SNES Checksum / Complement : #$~a / #$~a (XOR=#$FFFF: ~a, SumMatch: ~a)\n"
          (~r (snes-verification-report-checksum rpt) #:base 16 #:min-width 4 #:pad-string "0")
          (~r (snes-verification-report-complement rpt) #:base 16 #:min-width 4 #:pad-string "0")
          (snes-verification-report-checksum-xor-ffff? rpt)
          (snes-verification-report-checksum-matches-sum? rpt))
  (printf "  65C816 Assembled Code+Data : ~a bytes (~a instructions, ~a static cycles)\n"
          (bytes-length (asm-65816-result-bytes boba-snes-asm-result))
          (asm-65816-result-instruction-count boba-snes-asm-result)
          (asm-65816-result-cycles boba-snes-asm-result))
  (printf "  65C816 M/X Mode-Safe?      : ~a (0 conflicts; reconciler test: ~a -> ~a)\n"
          (asm-65816-result-mode-safe? boba-snes-asm-result)
          (mode-safety-result-mode-safe? unreconciled-check)
          (mode-safety-result-mode-safe? reconciled-check))
  (printf "  65C816 Native Mode Switch  : ~a (CLC; XCE -> E=native, REP #$30 16-bit: ~a)\n"
          (snes-verification-report-native-mode-switched? rpt)
          (snes-verification-report-reg-16bit-configured? rpt))
  (printf "  Sony SPC700 Driver Upload  : ~a (~a B uploaded to ARAM $0200, S-DSP KON=#$~a)\n"
          (snes-verification-report-spc700-handshake-ok? rpt)
          (snes-verification-report-spc700-uploaded-bytes rpt)
          (~r (snes-verification-report-spc700-dsp-kon rpt) #:base 16 #:min-width 2 #:pad-string "0"))
  (printf "  S-PPU DMA0 Transfers       : ~a transfers (CGRAM=~a B, 4bpp CHR=~a B)\n"
          (snes-verification-report-oam-dma-transfers rpt)
          (snes-verification-report-cgram-dma-bytes rpt)
          (snes-verification-report-vram-4bpp-dma-bytes rpt))
  (printf "  S-PPU HBlank HDMA1 Sky     : $420C=#$~a (~a visible scanlines updated on $2122)\n"
          (~r (snes-verification-report-hdma-enabled-mask rpt) #:base 16 #:min-width 2 #:pad-string "0")
          (snes-verification-report-hdma-scanlines-updated rpt))
  (printf "  4-Stage Campaign Verified? : ~a\n"
          (snes-verification-report-campaign-victory? rpt))
  (for ([step-hash (in-list (snes-verification-report-campaign-trace rpt))])
    (printf "    - ~a : stage=~a status=~a pos=(~a,~a) moves=~a recoveries=~a clears=#$~a won=~a spc=#$~a\n"
            (~a (hash-ref step-hash 'step) #:min-width 18)
            (hash-ref step-hash 'stage)
            (~a (hash-ref step-hash 'status) #:min-width 8)
            (hash-ref step-hash 'player-x)
            (hash-ref step-hash 'player-y)
            (hash-ref step-hash 'moves)
            (hash-ref step-hash 'recoveries)
            (~r (hash-ref step-hash 'stage-clears) #:base 16 #:min-width 2 #:pad-string "0")
            (hash-ref step-hash 'campaign-won)
            (~r (hash-ref step-hash 'spc-last-cmd) #:base 16 #:min-width 2 #:pad-string "0")))
  (printf "======================================================================\n")
  (unless (and (snes-verification-report-header-valid? rpt)
               (snes-verification-report-native-mode-switched? rpt)
               (snes-verification-report-spc700-handshake-ok? rpt)
               (snes-verification-report-campaign-victory? rpt))
    (error 'boba_snes "SNES ROM verification failed!")))
