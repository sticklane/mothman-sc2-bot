#lang boba-nes

;; ============================================================================
;; examples/boba_is_you.bnes : "Boba Is You" in #lang boba-nes
;; ============================================================================
;; Compiles the 5-stage "Boba Is You" block-pushing rule-manipulation puzzle
;; game into a real, bootable iNES 1.0 (.nes) cartridge ROM while statically
;; verifying all logical (L1..L4) and physical (Phi1..Phi5) hardware grades.
;; ============================================================================

(require racket/runtime-path
         racket/file)

(define-runtime-path build-dir "../build")

;; 1. Declare graded Zero-Page bindings & high-watermark scratch scopes
(defzp-var zp_joy_state   #:bytes 3  #:cap RamLinear)
(defzp-var zp_stage_state #:bytes 6  #:cap RamLinear)
(defzp-var zp_ppu_state   #:bytes 6  #:cap RamLinear)
(defzp-var zp_rule_table  #:bytes 6  #:cap RamLinear)
(defzp-var tile_constants #:bytes 16 #:cap ConstMeta)

;; 2. Verify and compile the complete 5-Stage "Boba Is You" ROM
(provide boba-rom-bytes
         boba-asm-result
         boba-type-result
         boba-module-desc)

(make-directory* build-dir)

(define nes-rom-path (build-path build-dir "boba_is_you.nes"))
(define ca65-asm-path (build-path build-dir "boba_is_you.s"))

(define-values (boba-rom-bytes boba-asm-result boba-type-result boba-module-desc)
  (compile-boba-is-you-rom! #:nes-out-path nes-rom-path
                            #:asm-out-path ca65-asm-path))

(module+ main
  (define tot (nes-type-result-total-grade boba-type-result))
  (define vb  (nes-type-result-vblank-grade boba-type-result))
  (define act (nes-type-result-active-grade boba-type-result))
  (printf "================================================================\n")
  (printf "  #lang boba-nes : 'Boba Is You' NES ROM Compilation Report\n")
  (printf "================================================================\n")
  (printf "  Well-Typed Hardware Module : ~a\n" (nes-type-result-well-typed? boba-type-result))
  (printf "  Joined Memory Capability   : ~a\n" (nes-type-result-capability boba-type-result))
  (printf "  Phi1 VBlank NMI Cycles     : ~a / 2273 cycles (OAMDMA = 514 cyc)\n"
          (nes-grade-cycles vb))
  (printf "  Phi1 ActiveFrame Cycles    : ~a / 29780 cycles\n"
          (nes-grade-cycles act))
  (printf "  Phi1 Page-Crossing Hazards : ~a\n"
          (nes-grade-page-crossings tot))
  (printf "  Phi2 OAM Total Sprites     : ~a / 64 sprites (~a / 256 B)\n"
          (nes-grade-oam-sprites vb) (* 4 (nes-grade-oam-sprites vb)))
  (printf "  Phi2 Peak Scanline Sprites : ~a / 8 sprites per scanline\n"
          (nes-grade-scanline-sprites vb))
  (printf "  Phi3 Zero-Page Live / Peak : ~a B live / ~a B peak (<= 224 B, 4x6B scratch recycled!)\n"
          (nes-grade-zp-bytes-live tot) (nes-grade-zp-bytes-peak tot))
  (printf "  Phi3 BSS Work RAM          : ~a / 1280 B ($0300-$04DF dual-layer 16x14 board)\n"
          (nes-grade-ram-bytes tot))
  (printf "  Phi3 PRG-ROM Code + Data   : ~a / 32768 B ($8000-$FFFF)\n"
          (nes-grade-prg-rom-bytes tot))
  (printf "  Phi3 CHR-ROM 2bpp Tiles    : ~a / 512 tiles\n"
          (nes-grade-chr-tiles tot))
  (printf "  Phi4 VBlank VRAM Bandwidth : ~a / 128 B\n"
          (nes-grade-vram-dma-bytes vb))
  (printf "  Phi4 16x16 Attr Clashes    : ~a clashes\n"
          (nes-grade-attr-clashes tot))
  (printf "  Phi5 Active APU Channels   : ~a\n"
          (nes-grade-apu-channels tot))
  (printf "  Output iNES 1.0 ROM        : ~a (~a bytes)\n"
          nes-rom-path (bytes-length boba-rom-bytes))
  (printf "  Output ca65 Assembly       : ~a\n" ca65-asm-path)
  (printf "================================================================\n"))
