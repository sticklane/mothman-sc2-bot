#lang boba-nes

;; ============================================================================
;; examples/boba_200_levels_cartridge.bnes
;; 256 KB MMC1 SXROM / 128 KB UNROM Multi-Bank Cartridge & Coroutine Demo
;; ============================================================================
;; Demonstrates scaling #lang boba-nes to all 231 levels of the full base game:
;;   1. 256 KB Banked PRG-ROM (15 switchable 16 KB level banks + 1 fixed 16 KB engine bank)
;;   2. 8 KB Battery-Backed Cartridge WRAM ($6000-$7FFF):
;;        - $6000-$62FF (768 B)  : 32x24 cell head-pointer grid
;;        - $6300-$6EFF (3072 B) : 1,024-node linked entity stack pool (3 B/node)
;;        - $6F00-$7EFF (4096 B) : 1,000-step delta UNDO ring buffer
;;        - $7F00-$7FFF (256 B)  : Battery-backed 231-level completion bitmap
;;   3. 8 KB Writable CHR-RAM ($0000-$1FFF):
;;        - Dynamically synthesizes 16x8 word badges (KEKE, LAVA, MELT, WORD, EMPT)
;;          from the 130-byte FONT-3X5 glyph table during ForcedBlank level load
;;   4. Multi-Frame Cooperative Turn Coroutines (with-turn-coroutine #:slices 2)
;;      and Multi-Frame VBlank Delta Ring Buffers (with-vram-delta-queue #:slices 3)
;; ============================================================================

(require racket/runtime-path)

(define-runtime-path banked-rom-out-path "../build/boba_231_banked.nes")

;; 1. Declare 256 KB MMC1 SXROM Cartridge (16 x 16 KB PRG banks, 8 KB CHR-RAM, 8 KB Battery WRAM)
(defcartridge sxrom-cartridge sxrom-budget
  #:mapper     MMC1
  #:prg-banks  16
  #:chr-banks  0
  #:chr-mode   chr-ram
  #:wram-bytes 8192
  #:battery?   #t
  #:mirroring  vertical)

;; 2. Declare Switchable PRG Bank 0 ($8000-$BFFF): World 1..4 Compressed Level Pack
(defprg-bank prg-bank-0 #:bank 0
  `(;; Switchable Bank 0 entry point ($8000): Unpacks Level #17 into $6000-$7FFF WRAM
    (label bank0_unpack_world1)
    (LDA #:imm #x11) ; Level 17 header marker
    (STA #:abs #x6000)
    ;; Push stacked entities (OBJ-BOBA + OBJ-FLAG on same cell!) into WRAM node pool ($6300)
    (LDA #:imm ,OBJ-BOBA)
    (STA #:abs #x6300)
    (LDA #:imm ,OBJ-FLAG)
    (STA #:abs #x6301)
    (RTS)))

;; 3. Declare Switchable PRG Bank 1 ($8000-$BFFF): World 5..10 & Meta-World Level Pack
(defprg-bank prg-bank-1 #:bank 1
  `(;; Switchable Bank 1 entry point ($8000): Unpacks Level #184 into $6000-$7FFF WRAM
    (label bank1_unpack_meta_world)
    (LDA #:imm #xB8) ; Level 184 header marker
    (STA #:abs #x6001)
    ;; Record delta UNDO frame in $6F00 WRAM ring buffer and mark level 184 cleared in $7F00 save RAM
    (LDA #:imm #x5A)
    (STA #:abs #x6F00)
    (LDA #:imm #x01)
    (STA #:abs #x7F17)
    (RTS)))

;; 4. Declare Fixed Engine Bank ($C000-$FFFF) with Far-Call Trampoline & Dynamic CHR-RAM Uploader
(define fixed-engine-forms
  (append
   `((label reset_handler)
     (SEI)
     (CLD)
     ;; Initialize active bank tracker ($0E = 0)
     (LDA #:imm 0)
     (STA #:zp #x0E)
     ;; Upload dynamic 3x5 word tiles ("KEKE", "MELT") into writable 8 KB CHR-RAM ($0000-$1FFF)
     ,@(emit-chr-ram-word-upload-6502
        (list (cons #x16 "KEKE")
              (cons #x26 "MELT")))
     ;; Invoke Bank 0 level unpacker via fixed-bank far_call_trampoline
     ,@(hash-ref (far-call 0 #x8000 #:caller-bank 0) 'asm-forms)
     ;; Invoke Bank 1 meta-world unpacker via fixed-bank far_call_trampoline
     ,@(hash-ref (far-call 1 #x8000 #:caller-bank 0) 'asm-forms)
     (RTS)

     (label nmi_handler)
     (BIT #:abs #x2002)
     (LDA #:imm #x80)
     (STA #:abs #x2000)
     (LDA #:imm 0)
     (STA #:abs #x2005)
     (STA #:abs #x2005)
     (RTI))
   (emit-bank-trampoline-6502 #:mapper 'UNROM #:bank-count 4)))

(define fixed-engine-asm
  (assemble-6502 fixed-engine-forms #:origin #xC000))

;; 5. Analyze Static WCET Cycles for the Fixed Engine Boot & Far-Call Trampoline
(define boot-wcet-report
  (analyze-6502-wcet fixed-engine-forms #:origin #xC000))

;; 6. Build Multi-Frame Turn Coroutine & VBlank Delta Queue Grades for 231-Level Base Game
(define heavy-turn-grade
  (with-turn-coroutine #:slices 2 #:turn-cycles 42000
    'empty-is-push-2-frame-coroutine))

(define world-event-vram-grade
  (with-vram-delta-queue #:slices 3 #:vram-bytes 180
    'mass-36-wall-to-boba-vram-queue))

;; 7. Construct and Verify Graded Module Descriptor for the 231-Level Banked Cartridge
(defzp-var zp_core_state    #:bytes 24 #:cap RamLinear)
(defzp-var zp_token_index   #:bytes 32 #:cap RamLinear)
(defzp-var zp_far_call_ptr  #:bytes 3  #:cap RamLinear)

(define boba-231-module
  (hasheq
   'name               'boba-231-levels-sxrom
   'mapper             'MMC1
   'fixed-prg-bank     15
   'initial-prg-bank   0
   'mmc1-atomic-guard? #t
   'wram-enabled?      #t
   'zp-vars            (list zp_core_state zp_token_index zp_far_call_ptr)
   'zp-scratch-blocks  (list (hasheq 'id 'scratch_token_parser 'bytes 12 'leaked? #f)
                             (hasheq 'id 'scratch_stack_walker 'bytes 12 'leaked? #f)
                             (hasheq 'id 'scratch_undo_delta   'bytes 10 'leaked? #f))
   'subroutines        (list (hasheq 'name 'far_call_trampoline 'pha-count 1 'pla-count 1))
   'bank-calls         (list (far-call 0 'bank0_unpack_world1 #:caller-bank 15)
                             (far-call 1 'bank1_unpack_meta_world #:caller-bank 15))
   'ppu-ops            (list (hasheq 'op 'oam-dma!        'phase 'VBlankNMI)
                             (hasheq 'op 'nametable-patch! 'phase 'VBlankNMI))
   'nmi-ops            (list (hasheq 'op 'oam-dma!)
                             (hasheq 'op 'nametable-patch!)
                             (hasheq 'op 'restore-scroll! 'x 0 'y 0))
   'vblank-cycles      1420
   'active-cycles      (hash-ref heavy-turn-grade 'active-cycles)
   'turn-slices        (hash-ref heavy-turn-grade 'turn-slices)
   'page-crossings     0
   'oam-sprites        32
   'scanline-sprites   8
   'ram-bytes          768   ; Internal BSS ($0300-$05FF)
   'wram-bytes         8128  ; Cartridge WRAM ($6000-$7FFF: cell pool + 4KB undo + save bitmap)
   'prg-rom-bytes      53248 ; 231 compressed levels (34.6 KB) + engine (10 KB) + audio (8 KB)
   'prg-banks          (list (hasheq 'bank 0 'bytes 15800 'limit 16384)
                             (hasheq 'bank 1 'bytes 16120 'limit 16384)
                             (hasheq 'bank 2 'bytes 14200 'limit 16384))
   'chr-mode           'chr-ram
   'chr-tiles          580   ; 220+ word pairs + 80 sprites stored compressed in PRG-ROM
   'active-chr-tiles   56    ; Only active level's word tiles synthesized into 8 KB CHR-RAM!
   'vram-dma-bytes     (hash-ref world-event-vram-grade 'vram-dma-bytes)
   'vram-queue-slices  (hash-ref world-event-vram-grade 'vram-queue-slices)
   'attr-clashes       0
   'apu-channels       '(pulse1 pulse2 triangle noise)))

(defnes-module verified-boba-231 sxrom-budget boba-231-module)

;; Build and write the banked ROM image
(define banked-rom-bytes
  (build-banked-ines-rom
   (list (hash-ref prg-bank-0 'asm)
         (hash-ref prg-bank-1 'asm))
   fixed-engine-asm
   #:mapper 'UNROM
   #:chr-rom-bytes #f
   #:battery-wram? #t))

(provide sxrom-cartridge
         sxrom-budget
         prg-bank-0
         prg-bank-1
         fixed-engine-asm
         boot-wcet-report
         verified-boba-231
         banked-rom-bytes
         res-231)

(define _wrote-rom (write-ines-rom-file! banked-rom-out-path banked-rom-bytes))

(define res-231 (verify-nes-grades! verified-boba-231 sxrom-budget))
(define act-g   (nes-type-result-active-grade res-231))
(define vb-g    (nes-type-result-vblank-grade res-231))

(module+ main
  (printf "================================================================\n")
  (printf "  #lang boba-nes : 231-Level Banked Cartridge Verification Report\n")
  (printf "================================================================\n")
  (printf "  Well-Typed Hardware Module : ~a\n" (nes-type-result-well-typed? res-231))
  (printf "  Cartridge Mapper & Spec    : MMC1 SXROM (256 KB PRG, 8 KB CHR-RAM, 8 KB Battery WRAM)\n")
  (printf "  Phi1 VBlank NMI Cycles     : ~a / 2273 cycles\n" (nes-grade-cycles vb-g))
  (printf "  Phi1 Turn Coroutine Cycles : ~a cyc/frame (42,000 cyc across 2 VBlank slices + 144 trampoline cyc)\n"
          (nes-grade-cycles act-g))
  (printf "  Phi1 Static Boot WCET      : ~a cycles (~a bytes in Fixed Bank $C000-$FFFF)\n"
          (hash-ref boot-wcet-report 'wcet-cycles)
          (hash-ref boot-wcet-report 'code-bytes))
  (printf "  Phi3 Zero-Page Live / Peak : ~a B live / ~a B peak (<= 224 B)\n"
          (nes-grade-zp-bytes-live act-g)
          (nes-grade-zp-bytes-peak act-g))
  (printf "  Phi3 Internal + Cart WRAM  : ~a / ~a B (768 B BSS + 8,128 B $6000-$7FFF WRAM)\n"
          (nes-grade-ram-bytes act-g)
          (nes-budget-ram-bytes-max sxrom-budget))
  (printf "  Phi3 Banked PRG-ROM Usage  : ~a / ~a B across 16 KB switchable banks\n"
          (nes-grade-prg-rom-bytes act-g)
          (nes-budget-prg-rom-bytes-max sxrom-budget))
  (printf "  Phi3 Dynamic CHR-RAM Tiles : ~a active tiles in 8 KB CHR-RAM (from 580 total tiles in PRG-ROM)\n"
          (nes-grade-chr-tiles act-g))
  (printf "  Phi4 VBlank Delta Queue    : ~a / 128 B per NMI (180 B drained across 3 VBlank frames)\n"
          (nes-grade-vram-dma-bytes vb-g))
  (printf "================================================================\n"))

