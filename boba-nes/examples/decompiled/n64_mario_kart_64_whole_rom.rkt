      (set! COP0.Cause 0)
      (set! COP0.Count 0)
      (set! COP0.Compare 0)
      (set! RI_CONFIG #x40)
      (spin-wait-mmio RI_CONFIG
        (poll-mmio RI_CONFIG))
      (set! RI_CURRENT_LOAD 0))
    (insn "0xA4000040" #x40806800 (MIPS-MTC0 r0 Cause))
    (insn "0xA4000044" #x40804800 (MIPS-MTC0 r0 Count))
    (insn "0xA4000048" #x40805800 (MIPS-MTC0 r0 Compare))
    (insn "0xA400004C" #x3C08A470 (MIPS-LUI t0 #xa470))
