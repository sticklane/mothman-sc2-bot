;; Complete Stack-Framed MIPS III VR4300 + COP0 + COP1 FPU Lifted Subroutines (with Structured CFG)
(define-n64-lifted-subroutines
  (subroutine pif-ipl3-bootstrap (entry #xa4000040) (offset #x000040) (stack-frame 0) (fpu-ops 0) #:params () #:returns ()
    (decompiled-pseudo-code
      (set! COP0.Cause 0)
      (set! COP0.Count 0)
      (set! COP0.Compare 0)
      (set! RI_CONFIG #x40)
      (spin-wait-mmio RI_CONFIG
        (poll-mmio RI_CONFIG))
      (set! RI_CURRENT_LOAD 0))
    (insn "0xA4000040" #x40806800 (MIPS-MTC0 r0 Cause))
    (insn "0xA4000044" #x40804800 (MIPS-MTC0 r0 Count))
    (insn "0xA4000048" #x40805800 (MIPS-MTC0 r0 Compare))
    (insn "0xA400004C" #x3C08A470 (MIPS-LUI t0 #xa470))
    (insn "0xA4000050" #x25080000 (MIPS-ADDIU t0 t0 0 #:addr #xa4700000 #:sym "RI_MODE"))
    (insn "0xA4000054" #x8D09000C (MIPS-LW t1 12(t0) #:addr #xa470000c #:sym "RI_SELECT"))
    (insn "0xA4000058" #x152000ED (MIPS-BNE t1 r0 #xa4000410))
    (insn "0xA400005C" #x00000000 (MIPS-NOP))
    (insn "0xA4000060" #x27BDFFE8 (MIPS-ADDIU sp sp -24))
    (insn "0xA4000064" #xAFB30000 (MIPS-SW s3 0(sp)))
    (insn "0xA4000068" #xAFB40004 (MIPS-SW s4 4(sp)))
    (insn "0xA400006C" #xAFB50008 (MIPS-SW s5 8(sp)))
    (insn "0xA4000070" #xAFB6000C (MIPS-SW s6 12(sp)))
    (insn "0xA4000074" #xAFB70010 (MIPS-SW s7 16(sp)))
    (insn "0xA4000078" #x3C08A470 (MIPS-LUI t0 #xa470))
    (insn "0xA400007C" #x25080000 (MIPS-ADDIU t0 t0 0 #:addr #xa4700000 #:sym "RI_MODE"))
    (insn "0xA4000080" #x3C0AA3F8 (MIPS-LUI t2 #xa3f8))
    (insn "0xA4000084" #x3C0BA3F0 (MIPS-LUI t3 #xa3f0))
    (insn "0xA4000088" #x3C0CA430 (MIPS-LUI t4 #xa430))
    (insn "0xA400008C" #x258C0000 (MIPS-ADDIU t4 t4 0 #:addr #xa4300000 #:sym "MI_MODE"))
    (insn "0xA4000090" #x34090040 (MIPS-ORI t1 r0 #x40))
    (insn "0xA4000094" #xAD090004 (MIPS-SW t1 4(t0) #:addr #xa4700004 #:sym "RI_CONFIG"))
    (insn "0xA4000098" #x24111F40 (MIPS-ADDIU s1 r0 8000))
