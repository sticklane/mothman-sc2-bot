#lang boba-nes

;; ============================================================================
;; examples/crypt_sweep.bnes : Crypt Sweep: Chronomancer's Vault in #lang boba-nes
;; ============================================================================
;; Original Grid-Action Arcane Bomb & Time-Freeze Dungeon Crawler across 3 Vaults:
;;   - Vault 0: Catacomb Entry (Teal Crypt Stone #x2C)
;;   - Vault 1: Obsidian Hall  (Amethyst Rune Bricks #x24)
;;   - Vault 2: Lich Sanctum   (Gilded Altar Masonry #x28)
;;
;; Exercises #lang boba-nes declarative hardware & gameplay constructs:
;;   - defchr-layout, defchar-map, defsprite-tile, defmetasprite ('symmetric-col-major)
;;   - defstate-machine (vault-0 -> vault-1 -> vault-2 -> chronomancer-victory,
;;                       with wraith-defeat -> vault-0 recovery)
;;   - defzp-map, with-zp-scratch, vblank-block, active-frame-block, defnes-module
;; ============================================================================

(require "../compiler/original-dsl-games.rkt")

;; 1. PPU Pattern Table & Zero-Offset HUD Typography Layout
(defchr-layout crypt-sweep-chr-layout
  #:sprite-pt  0
  #:bg-pt      1
  #:blank-tile #x24)

(defchar-map crypt-sweep-hud-font
  #:digit-base #x00
  #:alpha-base #x0A
  #:space-tile #x24
  #:extra      (list (cons #\- #x28) (cons #\: #x2C) (cons #\= #x65)))

(defsprite-tile crypt-sweep-hud-anchor #:tile #xFF #:attr #x00)

;; 2. Symmetric-Column-Major 16x16 Metasprites (Chronomancer, Wraith, Arcane Bomb, Relic)
(defmetasprite chronomancer-metasprite
  #:tiles (list #x30 #x31)
  #:order 'symmetric-col-major
  #:attr  #x00)

(defmetasprite crypt-wraith-metasprite
  #:tiles (list #x32 #x33)
  #:order 'symmetric-col-major
  #:attr  #x01)

(defmetasprite arcane-bomb-metasprite
  #:tiles (list #x34 #x35)
  #:order 'symmetric-col-major
  #:attr  #x02)

(defmetasprite chrono-relic-metasprite
  #:tiles (list #x36 #x37)
  #:order 'symmetric-col-major
  #:attr  #x03)

;; 3. Cursed Vault State Machine with Verified Wraith-Defeat Recovery
(defstate-machine crypt-sweep-fsm
  #:initial vault-0
  ([vault-0              #:kind normal  #:transitions (vault-1 wraith-defeat)]
   [vault-1              #:kind normal  #:transitions (vault-2 wraith-defeat)]
   [vault-2              #:kind normal  #:transitions (chronomancer-victory wraith-defeat)]
   [wraith-defeat        #:kind failure #:transitions (vault-0 vault-1 vault-2)]
   [chronomancer-victory #:kind victory #:transitions (vault-0)]))

;; 4. Pinned Hardware Zero-Page Map ($0014-$0029)
(defzp-map crypt-sweep-zp-map
  ([x              #x14 player-or-actor-coord]
   [y              #x15 player-or-actor-coord]
   [vy             #x16 player-or-actor-coord]
   [freeze-timer   #x17 game-phase-or-flag]
   [wraith-x       #x1B player-or-actor-coord]
   [enemy-alive    #x1C game-phase-or-flag]
   [score          #x1E hud-bcd-counter]
   [relics         #x1F hud-bcd-counter]
   [lives          #x25 hud-bcd-counter]
   [dead           #x26 game-phase-or-flag]
   [stage-id       #x28 game-phase-or-flag]
   [game-completed #x29 game-phase-or-flag]))

;; 5. Graded VBlank NMI & ActiveFrame Phase Blocks with High-Watermark Scratch Reuse
(vblank-block crypt-sweep-vblank
  #:cycles           640
  #:oam-sprites      11
  #:scanline-sprites 4
  #:vram-bytes       24
  (with-zp-scratch ([scratch_vblank_vault 4])
    scratch_vblank_vault))

(active-frame-block crypt-sweep-active
  #:cycles       1840
  #:ram-bytes    64
  #:apu-channels '(pulse1 pulse2 triangle noise)
  (with-zp-scratch ([scratch_bomb_blast 6]
                    [scratch_grid_step  6])
    (list scratch_bomb_blast scratch_grid_step)))

;; 6. Verify Graded Module Descriptor via defnes-module
(defnes-module crypt-sweep-verified-module NTSC-NROM-BUDGET
  crypt-sweep-module-desc)

(provide crypt-sweep-chr-layout
         crypt-sweep-hud-font
         crypt-sweep-hud-anchor
         chronomancer-metasprite
         crypt-wraith-metasprite
         arcane-bomb-metasprite
         chrono-relic-metasprite
         crypt-sweep-fsm
         crypt-sweep-zp-map
         crypt-sweep-vblank
         crypt-sweep-active
         crypt-sweep-verified-module
         crypt-sweep-rom-bytes
         crypt-sweep-asm-result
         crypt-sweep-type-result
         crypt-sweep-module-desc)

(module+ main
  (define vb  (nes-type-result-vblank-grade crypt-sweep-type-result))
  (define act (nes-type-result-active-grade crypt-sweep-type-result))
  (printf "================================================================\n")
  (printf "  #lang boba-nes : Crypt Sweep: Chronomancer's Vault ROM Report\n")
  (printf "================================================================\n")
  (printf "  Well-Typed Hardware Module : ~a (0 violations)\n"
          (nes-type-result-well-typed? crypt-sweep-type-result))
  (printf "  6502 Machine Code Size     : ~a bytes (< 900 B, ~a page crossings)\n"
          (bytes-length (asm-result-bytes crypt-sweep-asm-result))
          (asm-result-page-crossings crypt-sweep-asm-result))
  (printf "  Phi1 VBlank / Active Cyc   : ~a / 2273 VBlank, ~a / 29780 Active\n"
          (nes-grade-cycles vb) (nes-grade-cycles act))
  (printf "  Phi2 OAM Total / Scanline  : ~a / 64 sprites (~a / 8 per scanline)\n"
          (nes-grade-oam-sprites vb) (nes-grade-scanline-sprites vb))
  (printf "  Phi3 Zero-Page Live / Peak : ~a B live / ~a B peak (<= 224 B)\n"
          (nes-grade-zp-bytes-live act) (nes-grade-zp-bytes-peak act))
  (printf "  Output iNES 1.0 ROM        : build/crypt_sweep.nes (~a bytes)\n"
          (bytes-length crypt-sweep-rom-bytes))
  (printf "================================================================\n"))
