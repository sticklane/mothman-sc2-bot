#lang boba-nes

;; ============================================================================
;; examples/crypt_sweep.bnes : Crypt Sweep: Chronomancer's Vault in #lang boba-nes
;; ============================================================================
;; Complete, Self-Contained Grid Bomb & Time-Freeze Dungeon Crawler across 3 Vaults:
;;   - Vault 0: Catacomb Entry (Teal Crypt Stone #x2C)
;;   - Vault 1: Obsidian Hall  (Amethyst Rune Bricks #x24)
;;   - Vault 2: Lich Sanctum   (Gilded Altar Masonry #x28)
;;
;; 100% of CHR tiles, palettes, Zero-Page map, state machine, metasprites,
;; and 6502 instructions live directly in this `.bnes` source file and compile
;; via `defnes-game` -> `build/crypt_sweep.nes`.
;; ============================================================================

;; 1. Pinned Zero-Page Hardware Addresses ($0010-$0029)
(define CS-ZP-BUTTONS        #x10)
(define CS-ZP-PREV-BTN       #x11)
(define CS-ZP-NEW-BTN        #x12)
(define CS-ZP-FRAME-CNT      #x13)
(define CS-ZP-X              #x14)
(define CS-ZP-Y              #x15)
(define CS-ZP-VY             #x16)
(define CS-ZP-FREEZE-TIMER   #x17)
(define CS-ZP-BOMB-X         #x18)
(define CS-ZP-BOMB-Y         #x19)
(define CS-ZP-BOMB-TIMER     #x1A)
(define CS-ZP-ENEMY-X        #x1B)
(define CS-ZP-ENEMY-ALIVE    #x1C)
(define CS-ZP-ENEMY-Y        #x1D)
(define CS-ZP-SCORE          #x1E)
(define CS-ZP-RELICS         #x1F)
(define CS-ZP-WALL-INTACT    #x20)
(define CS-ZP-WON            #x24)
(define CS-ZP-LIVES          #x25)
(define CS-ZP-DEAD           #x26)
(define CS-ZP-STAGE-DIRTY    #x27)
(define CS-ZP-STAGE-ID       #x28)
(define CS-ZP-GAME-COMPLETED #x29)

(defzp-map crypt-sweep-zp-map
  ([buttons        #x10 controller-state]
   [prev-btn       #x11 controller-state]
   [new-btn        #x12 controller-state]
   [frame-cnt      #x13 frame-counter]
   [x              #x14 player-or-actor-coord]
   [y              #x15 player-or-actor-coord]
   [vy             #x16 player-or-actor-coord]
   [freeze-timer   #x17 game-phase-or-flag]
   [bomb-x         #x18 player-or-actor-coord]
   [bomb-y         #x19 player-or-actor-coord]
   [bomb-timer     #x1A game-phase-or-flag]
   [wraith-x       #x1B player-or-actor-coord]
   [enemy-alive    #x1C game-phase-or-flag]
   [wraith-y       #x1D player-or-actor-coord]
   [score          #x1E hud-bcd-counter]
   [relics         #x1F hud-bcd-counter]
   [wall-intact    #x20 game-phase-or-flag]
   [won            #x24 game-phase-or-flag]
   [lives          #x25 hud-bcd-counter]
   [dead           #x26 game-phase-or-flag]
   [stage-dirty    #x27 game-phase-or-flag]
   [stage-id       #x28 game-phase-or-flag]
   [game-completed #x29 game-phase-or-flag]))

;; 2. PPU Pattern Table & Zero-Offset HUD Typography Layout
(defchr-layout crypt-sweep-chr-layout
  #:sprite-pt  0
  #:bg-pt      1
  #:blank-tile #x24)

(defchar-map crypt-sweep-hud-font
  #:digit-base #x00
  #:alpha-base #x0A
  #:space-tile #x24
  #:extra      (list (cons #\- #x28) (cons #\: #x2C) (cons #\= #x65)))

(defsprite-tile crypt-sweep-hud-anchor #:tile #xFF #:attr #x00)

;; 3. Declarative 2bpp CHR-ROM Resource (Base Zero-Offset Font + Chronomancer / Wraith / Bomb / Relic Tiles)
(defchr-resource crypt-sweep-chr
  #:base-font? #t
  #:tiles
  (list
   ;; #x2F: Cobblestone Catacomb Floor Speckle
   (cons #x2F '("..111..." ".1...1.." ".....1.." "..111..."
                "......11" ".....1.." ".....1.." "......11"))
   ;; #x30, #x31: Chronomancer Mage (symmetric-col-major)
   (cons #x30 '("....3333" "...32223" "..322223" ".3333333"
                "..211331" "..213311" "...22222" "..322333"))
   (cons #x31 '("..322333" ".3322333" ".3122322" "31.22322"
                "...22311" "..221111" "..331..1" ".333...1"))
   ;; #x32, #x33: Crypt Wraith (symmetric-col-major)
   (cons #x32 '("..3....3" "..33..33" "..233332" ".2213312"
                ".2211112" ".2223322" "..221122" ".2322223"))
   (cons #x33 '(".2322223" "23322223" "23.22122" "2..22112"
                "...21.12" "..21..12" "..2....2" ".1......"))
   ;; #x34, #x35: Arcane Bomb (symmetric-col-major)
   (cons #x34 '(".....33." "....323." ".....2.." "...22222"
                "..233222" ".2332212" ".2222112" ".2211122"))
   (cons #x35 '("..221122" "...22222" "....1111" "........"
                "........" "........" "........" "........"))
   ;; #x36, #x37: Chrono Hourglass Relic & Portal (symmetric-col-major)
   (cons #x36 '("..333333" "..222222" "...23321" "...23311"
                "....2311" ".....211" ".....211" "....2311"))
   (cons #x37 '("...21121" "...23111" "..233311" "..222222"
                "..333333" "........" "........" "........"))
   ;; #x3E: Wraith Defeat Ash Sprite
   (cons #x3E '("..3..3.." ".323323." ".213312." "..2332.."
                ".321123." "32.33.23" "2......2" "........"))
   ;; #x40: Obsidian Dungeon Masonry Brick
   (cons #x40 '("33333331" "32222211" "32222211" "11111111"
                "33313333" "22113222" "22113222" "11111111"))
   ;; #x42: Cracked Catacomb Wall / Sanctum Arch
   (cons #x42 '("33323333" "22122122" "21.21.22" "1..1..11"
                "221.2221" "21..1211" "1...1111" "11111111"))
   ;; #x45: Runic Vault HUD Bar
   (cons #x45 '("........" "33233233" "11211211" "33333333"
                "........" "........" "........" "........"))
   ;; #xFF: Opaque HUD Anchor
   (cons #xFF '("33333333" "31111113" "31333313" "31322313"
                "31322313" "31333313" "31111113" "33333333"))))

;; 4. Declarative Palettes, HUD Nametable Text & OAM Sprite Template Resources
(defpalette-resource crypt-sweep-palette
  '(#x0F #x2C #x1C #x30   #x0F #x27 #x17 #x30
    #x0F #x29 #x19 #x30   #x0F #x24 #x14 #x30
    #x0F #x2C #x28 #x30   #x0F #x14 #x24 #x30
    #x0F #x27 #x16 #x30   #x0F #x28 #x18 #x30))

;; Vault 0 (Catacomb Teal #x2C), Vault 1 (Obsidian Violet #x24), Vault 2 (Lich Gold #x28)
(defpalette-resource crypt-sweep-stage-accents
  '(#x2C #x24 #x28 #x28))

(defnametable-resource crypt-sweep-hud-bytes
  (encode-char-map-string crypt-sweep-hud-font "VAULT  0  RELC 0  LIVES 3"))

(defoam-resource crypt-sweep-oam-template
  '(16  #xFF #x00 16
    144 #x30 #x00 48
    152 #x31 #x00 48
    144 #x30 #x40 56
    152 #x31 #x40 56
    112 #x32 #x01 128
    120 #x33 #x01 128
    112 #x32 #x41 136
    120 #x33 #x41 136
    104 #x34 #x02 96
    136 #x36 #x03 200))

;; 5. Symmetric-Column-Major 16x16 & Symmetric-Vertical 8x16 Metasprites
(defmetasprite chronomancer-metasprite
  #:tiles (list #x30 #x31)
  #:order 'symmetric-col-major
  #:attr  #x00)

(defmetasprite crypt-wraith-metasprite
  #:tiles (list #x32 #x33)
  #:order 'symmetric-col-major
  #:attr  #x01)

(defmetasprite arcane-bomb-metasprite
  #:tiles (list #x34 #x35)
  #:order 'symmetric-col-major
  #:attr  #x02)

(defmetasprite chrono-relic-metasprite
  #:tiles (list #x36 #x37)
  #:order 'symmetric-col-major
  #:attr  #x03)

(defmetasprite hourglass-pillar-vertical-metasprite
  #:tile  #x36
  #:order 'symmetric-vertical
  #:attr  #x03)

;; 6. Cursed Vault State Machine with Verified Wraith-Defeat Recovery
(defstate-machine crypt-sweep-fsm
  #:initial vault-0
  ([vault-0              #:kind normal  #:transitions (vault-1 wraith-defeat)]
   [vault-1              #:kind normal  #:transitions (vault-2 wraith-defeat)]
   [vault-2              #:kind normal  #:transitions (chronomancer-victory wraith-defeat)]
   [wraith-defeat        #:kind failure #:transitions (vault-0 vault-1 vault-2)]
   [chronomancer-victory #:kind victory #:transitions (vault-0)]))

;; 7. Complete 6502 Program for Crypt Sweep: Chronomancer's Vault (< 900 Bytes, 0 Page Crossings)
(define crypt-sweep-6502-program
  `((label reset_handler)
    (SEI)
    (CLD)
    (LDX #:imm #xFF)
    (TXS)
    (JSR boot_init)
    (label main_loop)
    (LDA #:zp #x0F)
    (BEQ main_loop)
    (LDA #:imm 0)
    (STA #:zp #x0F)
    (JSR game_frame_step)
    (JMP main_loop)

    ;; Helper: set_nt0_addr sets A=#x20, X=VRAM low byte; set_vram_addr uses A=hi, X=lo
    (label set_nt0_addr)
    (LDA #:imm #x20)
    (label set_vram_addr)
    (BIT #:abs #x2002)
    (STA #:abs #x2006)
    (STX #:abs #x2006)
    (RTS)

    (label boot_init)
    (LDA #:imm #x00)
    (STA #:abs #x2000)
    (STA #:abs #x2001)
    (LDX #:imm 0)
    (label clr_zp_loop)
    (STA #:zpx #x00)
    (STA #:absx #x0300)
    (INX)
    (BNE clr_zp_loop)

    (LDA #:imm #xF8)
    (label clr_oam_loop)
    (STA #:absx #x0200)
    (INX)
    (BNE clr_oam_loop)

    ;; Load 32-byte Palette ($3F00-$3F1F)
    (LDA #:imm #x3F) (LDX #:imm #x00) (JSR set_vram_addr)
    (label load_pal_loop)
    (LDA #:absx palette_table)
    (STA #:abs #x2007)
    (INX)
    (CPX #:imm 32)
    (BNE load_pal_loop)

    ;; Clear Nametable 0 ($2000-$23FF) to blank tile #x24
    (LDX #:imm #x00) (JSR set_nt0_addr)
    (LDY #:imm 4)
    (LDA #:imm #x24)
    (label clr_nt_loop)
    (STA #:abs #x2007)
    (INX)
    (BNE clr_nt_loop)
    (DEY)
    (BNE clr_nt_loop)

    ;; Draw HUD Top Bar ($2020), HUD Text ($2043), and HUD Bottom Bar ($2060)
    (LDX #:imm #x20) (JSR set_nt0_addr)
    (LDX #:imm 32) (LDA #:imm #x45)
    (label hud_top_loop) (STA #:abs #x2007) (DEX) (BNE hud_top_loop)

    (LDX #:imm #x43) (JSR set_nt0_addr)
    (LDX #:imm 0)
    (label hud_txt_loop)
    (LDA #:absx hud_text_table)
    (STA #:abs #x2007)
    (INX)
    (CPX #:imm 25)
    (BNE hud_txt_loop)

    (LDX #:imm #x60) (JSR set_nt0_addr)
    (LDX #:imm 32) (LDA #:imm #x45)
    (label hud_bot_loop) (STA #:abs #x2007) (DEX) (BNE hud_bot_loop)

    ;; Draw Catacomb Floor Speckles ($2100), Cracked Arch ($21E6), and Obsidian Masonry ($22C0)
    (LDA #:imm #x21) (LDX #:imm #x00) (JSR set_vram_addr)
    (LDX #:imm 64) (LDA #:imm #x2F)
    (label bg_detail_loop) (STA #:abs #x2007) (DEX) (BNE bg_detail_loop)

    (LDA #:imm #x21) (LDX #:imm #xE6) (JSR set_vram_addr)
    (LDX #:imm 20) (LDA #:imm #x42)
    (label plat_loop) (STA #:abs #x2007) (DEX) (BNE plat_loop)

    (LDA #:imm #x22) (LDX #:imm #xC0) (JSR set_vram_addr)
    (LDX #:imm 128) (LDA #:imm #x40)
    (label gnd_loop) (STA #:abs #x2007) (DEX) (BNE gnd_loop)

    ;; Initialize Attribute Table ($23C0-$23FF)
    (LDA #:imm #x23) (LDX #:imm #xC0) (JSR set_vram_addr)
    (LDX #:imm 16) (LDA #:imm #x55)
    (label attr_top_loop) (STA #:abs #x2007) (DEX) (BNE attr_top_loop)
    (LDX #:imm 48) (LDA #:imm #x00)
    (label attr_bot_loop) (STA #:abs #x2007) (DEX) (BNE attr_bot_loop)

    ;; Initialize Zero-Page Gameplay State & 2A03 APU ($4015 = #x0F)
    (LDA #:imm 64)   (STA #:zp ,CS-ZP-X)
    (LDA #:imm 128)  (STA #:zp ,CS-ZP-Y)
    (LDA #:imm 3)    (STA #:zp ,CS-ZP-LIVES)
    (LDA #:imm 1)    (STA #:zp ,CS-ZP-ENEMY-ALIVE)
    (STA #:zp ,CS-ZP-WALL-INTACT)
    (LDA #:imm 128)  (STA #:zp ,CS-ZP-ENEMY-X)
    (LDA #:imm 112)  (STA #:zp ,CS-ZP-ENEMY-Y)
    (LDA #:imm #x0F) (STA #:abs #x4015)
    (JSR build_oam)
    (LDA #:imm #x00) (STA #:abs #x2003)
    (LDA #:imm #x02) (STA #:abs #x4014)
    (BIT #:abs #x2002)
    (LDA #:imm 0)    (STA #:abs #x2005) (STA #:abs #x2005)
    (LDA #:imm #x90) (STA #:abs #x2000)
    (LDA #:imm #x1E) (STA #:abs #x2001)
    (RTS)

    ;; ========================================================================
    ;; ActiveFrame Gameplay Logic: Joypad, Wraith Recovery, Time-Freeze & Bomb
    ;; ========================================================================
    (label game_frame_step)
    (INC #:zp ,CS-ZP-FRAME-CNT)
    (LDA #:zp ,CS-ZP-BUTTONS)
    (STA #:zp ,CS-ZP-PREV-BTN)
    (LDA #:imm 1) (STA #:abs #x4016)
    (LDA #:imm 0) (STA #:abs #x4016)
    (STA #:zp ,CS-ZP-BUTTONS)
    (LDX #:imm 8)
    (label poll_btn_loop)
    (LDA #:abs #x4016)
    (LSR)
    (ROR #:zp ,CS-ZP-BUTTONS)
    (DEX)
    (BNE poll_btn_loop)
    (LDA #:zp ,CS-ZP-PREV-BTN)
    (EOR #:imm #xFF)
    (AND #:zp ,CS-ZP-BUTTONS)
    (STA #:zp ,CS-ZP-NEW-BTN)

    ;; Check if player is in Wraith-defeat state (CS-ZP-DEAD != 0)
    (LDA #:zp ,CS-ZP-DEAD)
    (BEQ check_left_hazard)
    (LDA #:zp ,CS-ZP-BUTTONS)
    (AND #:imm ,(bitwise-ior BTN-START BTN-SELECT))
    (BEQ dead_wait_oam)
    (LDA #:imm 0)   (STA #:zp ,CS-ZP-DEAD)
    (STA #:zp ,CS-ZP-VY)
    (LDA #:imm 64)  (STA #:zp ,CS-ZP-X)
    (LDA #:imm 128) (STA #:zp ,CS-ZP-Y)
    (LDA #:imm 1)   (STA #:zp ,CS-ZP-ENEMY-ALIVE)
    ;; Triangle recovery chime ($4008-$400B)
    (LDA #:imm #x8F) (STA #:abs #x4008)
    (LDA #:imm #x60) (STA #:abs #x400A)
    (LDA #:imm #x18) (STA #:abs #x400B)
    (label dead_wait_oam)
    (JMP build_oam)

    ;; Pressing BTN-LEFT triggers Crypt Wraith contact hazard
    (label check_left_hazard)
    (LDA #:zp ,CS-ZP-BUTTONS)
    (AND #:imm ,BTN-LEFT)
    (BEQ run_game_mechanics)
    (LDA #:imm 1)
    (STA #:zp ,CS-ZP-DEAD)
    (LDA #:zp ,CS-ZP-LIVES)
    (BEQ trigger_hazard_sfx)
    (DEC #:zp ,CS-ZP-LIVES)
    (label trigger_hazard_sfx)
    ;; 2A03 Noise channel Wraith curse SFX ($400C-$400F)
    (LDA #:imm #x1F) (STA #:abs #x400C)
    (LDA #:imm #x08) (STA #:abs #x400E)
    (LDA #:imm #x18) (STA #:abs #x400F)
    (JMP build_oam)

    (label run_game_mechanics)
    ;; 1. BTN-A: Chronomancer Time-Freeze Pulse (sets CS-ZP-FREEZE-TIMER = 12)
    (LDA #:zp ,CS-ZP-BUTTONS)
    (AND #:imm ,BTN-A)
    (BEQ cs_check_bomb)
    (LDA #:imm 12)   (STA #:zp ,CS-ZP-FREEZE-TIMER)
    ;; Pulse 1 chrono-freeze chime ($4000-$4003)
    (LDA #:imm #xBF) (STA #:abs #x4000)
    (LDA #:imm #x40) (STA #:abs #x4002)
    (LDA #:imm #x18) (STA #:abs #x4003)

    ;; 2. BTN-B: Arcane Bomb Placement & Detonation (clears cracked wall + Wraith, drops Relic!)
    (label cs_check_bomb)
    (LDA #:zp ,CS-ZP-BUTTONS)
    (AND #:imm ,BTN-B)
    (BEQ cs_check_dirs)
    (LDA #:zp ,CS-ZP-X) (STA #:zp ,CS-ZP-BOMB-X)
    (LDA #:zp ,CS-ZP-Y) (STA #:zp ,CS-ZP-BOMB-Y)
    (LDA #:imm 8)       (STA #:zp ,CS-ZP-BOMB-TIMER)
    (LDA #:imm 0)       (STA #:zp ,CS-ZP-WALL-INTACT)
    (STA #:zp ,CS-ZP-ENEMY-ALIVE)
    (INC #:zp ,CS-ZP-RELICS)
    (INC #:zp ,CS-ZP-SCORE)
    ;; Noise arcane detonation SFX ($400C-$400F)
    (LDA #:imm #x1F) (STA #:abs #x400C)
    (LDA #:imm #x04) (STA #:abs #x400E)
    (LDA #:imm #x18) (STA #:abs #x400F)

    ;; 3. 4-Way Dungeon Movement (UP / DOWN / RIGHT) & Sanctum Portal Transition
    (label cs_check_dirs)
    (LDA #:zp ,CS-ZP-BUTTONS)
    (AND #:imm ,BTN-UP)
    (BEQ cs_check_down)
    (LDA #:zp ,CS-ZP-Y)
    (SEC) (SBC #:imm 4)
    (STA #:zp ,CS-ZP-Y)

    (label cs_check_down)
    (LDA #:zp ,CS-ZP-BUTTONS)
    (AND #:imm ,BTN-DOWN)
    (BEQ cs_check_right)
    (LDA #:zp ,CS-ZP-Y)
    (CLC) (ADC #:imm 4)
    (STA #:zp ,CS-ZP-Y)

    (label cs_check_right)
    (LDA #:zp ,CS-ZP-BUTTONS)
    (AND #:imm ,BTN-RIGHT)
    (BEQ finish_frame_oam)
    (LDA #:zp ,CS-ZP-X)
    (CLC) (ADC #:imm 16)
    (STA #:zp ,CS-ZP-X)
    (JMP trigger_stage_advance)

    ;; Vault Advance Progression (Vault 0 -> 1 -> 2 -> Chronomancer Victory!)
    (label trigger_stage_advance)
    (LDA #:imm 0)  (STA #:zp ,CS-ZP-ENEMY-ALIVE)
    (INC #:zp ,CS-ZP-RELICS)
    (INC #:zp ,CS-ZP-SCORE)
    (LDA #:imm 1)  (STA #:zp ,CS-ZP-WON)
    (STA #:zp ,CS-ZP-STAGE-DIRTY)
    (LDA #:imm 64) (STA #:zp ,CS-ZP-X)
    ;; 2A03 Pulse 2 sanctum portal fanfare ($4004-$4007)
    (LDA #:imm #x9F) (STA #:abs #x4004)
    (LDA #:imm #x50) (STA #:abs #x4006)
    (LDA #:imm #x18) (STA #:abs #x4007)
    (LDA #:zp ,CS-ZP-STAGE-ID)
    (CMP #:imm 2)
    (BCS mark_campaign_completed)
    (INC #:zp ,CS-ZP-STAGE-ID)
    (LDA #:zp ,CS-ZP-STAGE-ID)
    (CMP #:imm 2)
    (BCC finish_frame_oam)
    (label mark_campaign_completed)
    (LDA #:imm 1)
    (STA #:zp ,CS-ZP-GAME-COMPLETED)
    (label finish_frame_oam)
    (JMP build_oam)

    ;; ========================================================================
    ;; OAM Sprite Buffer Builder ($0200-$022B)
    ;; ========================================================================
    (label build_oam)
    (LDX #:imm 43)
    (label copy_oam_tpl)
    (LDA #:absx oam_template_table)
    (STA #:absx #x0200)
    (DEX)
    (BPL copy_oam_tpl)

    ;; Patch Chronomancer 16x16 Metasprite Y & X coordinates
    (LDA #:zp ,CS-ZP-Y)
    (STA #:abs #x0204)
    (STA #:abs #x020C)
    (CLC) (ADC #:imm 8)
    (STA #:abs #x0208)
    (STA #:abs #x0210)

    (LDA #:zp ,CS-ZP-X)
    (STA #:abs #x0207)
    (STA #:abs #x020B)
    (CLC) (ADC #:imm 8)
    (STA #:abs #x020F)
    (STA #:abs #x0213)

    ;; Show defeat ash tile (#x3E) when CS-ZP-DEAD != 0
    (LDA #:zp ,CS-ZP-DEAD)
    (BEQ chk_hide_enemy)
    (LDA #:imm #x3E)
    (STA #:abs #x0205)

    ;; Hide Crypt Wraith 16x16 Metasprite when CS-ZP-ENEMY-ALIVE == 0
    (label chk_hide_enemy)
    (LDA #:zp ,CS-ZP-ENEMY-ALIVE)
    (BNE oam_done)
    (LDA #:imm #xF8)
    (STA #:abs #x0214)
    (STA #:abs #x0218)
    (STA #:abs #x021C)
    (STA #:abs #x0220)
    (label oam_done)
    (RTS)

    ;; ========================================================================
    ;; VBlank NMI Handler (<= 2273 Cycles, 3 PHA / 3 PLA, Clean Scroll Restore)
    ;; ========================================================================
    (label nmi_handler)
    (PHA)
    (TXA) (PHA)
    (TYA) (PHA)

    ;; 1. OAM DMA ($4014 = #x02)
    (LDA #:imm #x00) (STA #:abs #x2003)
    (LDA #:imm #x02) (STA #:abs #x4014)

    ;; 2. Zero-Offset BCD HUD Updates ($204A = Vault, $2052 = Relics, $205B = Lives)
    (LDX #:imm #x4A) (JSR set_nt0_addr)
    (LDA #:zp ,CS-ZP-STAGE-ID) (AND #:imm #x03) (STA #:abs #x2007)

    (LDX #:imm #x52) (JSR set_nt0_addr)
    (LDA #:zp ,CS-ZP-RELICS) (AND #:imm #x07) (STA #:abs #x2007)

    (LDX #:imm #x5B) (JSR set_nt0_addr)
    (LDA #:zp ,CS-ZP-LIVES) (AND #:imm #x07) (STA #:abs #x2007)

    ;; 3. Dynamic Vault Accent Palette Update ($3F02)
    (LDA #:imm #x3F) (LDX #:imm #x02) (JSR set_vram_addr)
    (LDX #:zp ,CS-ZP-STAGE-ID)
    (LDA #:absx stage_accent_table)
    (STA #:abs #x2007)

    ;; 4. Restore Clean PPU Scroll Latch ($2000 = #x90, $2005 = 0, 0)
    (BIT #:abs #x2002)
    (LDA #:imm #x90) (STA #:abs #x2000)
    (LDA #:imm 0)    (STA #:abs #x2005) (STA #:abs #x2005)
    (LDA #:imm 1)    (STA #:zp #x0F)

    (PLA) (TAY)
    (PLA) (TAX)
    (PLA)
    (RTI)

    (label irq_handler)
    (RTI)

    ;; ========================================================================
    ;; Read-Only PRG-ROM Tables (0 Page Crossings!)
    ;; ========================================================================
    (label palette_table)
    (.byte ,@crypt-sweep-palette)

    (label hud_text_table)
    (.byte ,@crypt-sweep-hud-bytes)

    (label stage_accent_table)
    (.byte ,@crypt-sweep-stage-accents)

    (label oam_template_table)
    (.byte ,@crypt-sweep-oam-template)))

;; 8. Compile, Static-Analyze, Typecheck & Emit `build/crypt_sweep.nes` via `defnes-game`
(defnes-game crypt-sweep-game
  #:name             'crypt-sweep-chronomancer
  #:mapper           'NROM
  #:mirroring        'vertical
  #:chr              crypt-sweep-chr
  #:zp-map           crypt-sweep-zp-map
  #:state-machine    crypt-sweep-fsm
  #:oam-sprites      11
  #:scanline-sprites 4
  #:vram-bytes       24
  #:ram-bytes        64
  #:vblank-scratch   '((scratch_vblank_vault 4))
  #:active-scratch   '((scratch_bomb_blast 6) (scratch_grid_step 6))
  #:program          crypt-sweep-6502-program
  #:out-rom          "build/crypt_sweep.nes")

(define crypt-sweep-rom-bytes   (hash-ref crypt-sweep-game 'rom-bytes))
(define crypt-sweep-asm-result  (hash-ref crypt-sweep-game 'asm-result))
(define crypt-sweep-type-result (hash-ref crypt-sweep-game 'type-result))
(define crypt-sweep-module-desc (hash-ref crypt-sweep-game 'module-desc))
(define crypt-sweep-repairs     (hash-ref crypt-sweep-game 'repairs))

(vblank-block crypt-sweep-vblank
  #:cycles           (nes-grade-cycles (nes-type-result-vblank-grade crypt-sweep-type-result))
  #:oam-sprites      11
  #:scanline-sprites 4
  #:vram-bytes       24
  (with-zp-scratch ([scratch_vblank_vault 4])
    scratch_vblank_vault))

(active-frame-block crypt-sweep-active
  #:cycles       (nes-grade-cycles (nes-type-result-active-grade crypt-sweep-type-result))
  #:ram-bytes    64
  #:apu-channels '(pulse1 pulse2 triangle noise)
  (with-zp-scratch ([scratch_bomb_blast 6]
                    [scratch_grid_step  6])
    (list scratch_bomb_blast scratch_grid_step)))

(defnes-module crypt-sweep-verified-module NTSC-NROM-BUDGET
  crypt-sweep-module-desc)

(define (build-crypt-sweep-chr-rom) crypt-sweep-chr)
(define (emit-crypt-sweep-6502-program) crypt-sweep-6502-program)

(define (compile-crypt-sweep-rom! #:nes-out-path [nes-out-path #f])
  (define g
    (compile-boba-nes-game! #:id               'crypt-sweep-game
                            #:name             'crypt-sweep-chronomancer
                            #:mapper           'NROM
                            #:mirroring        'vertical
                            #:chr              crypt-sweep-chr
                            #:zp-map           crypt-sweep-zp-map
                            #:state-machine    crypt-sweep-fsm
                            #:oam-sprites      11
                            #:scanline-sprites 4
                            #:vram-bytes       24
                            #:ram-bytes        64
                            #:vblank-scratch   '((scratch_vblank_vault 4))
                            #:active-scratch   '((scratch_bomb_blast 6) (scratch_grid_step 6))
                            #:program          crypt-sweep-6502-program
                            #:out-rom          nes-out-path))
  (values (hash-ref g 'rom-bytes)
          (hash-ref g 'asm-result)
          (hash-ref g 'type-result)
          (hash-ref g 'module-desc)
          (hash-ref g 'repairs)))

(provide crypt-sweep-chr-layout
         crypt-sweep-hud-font
         crypt-sweep-hud-anchor
         crypt-sweep-chr
         crypt-sweep-palette
         crypt-sweep-stage-accents
         crypt-sweep-hud-bytes
         crypt-sweep-oam-template
         chronomancer-metasprite
         crypt-wraith-metasprite
         arcane-bomb-metasprite
         chrono-relic-metasprite
         hourglass-pillar-vertical-metasprite
         crypt-sweep-fsm
         crypt-sweep-zp-map
         crypt-sweep-6502-program
         crypt-sweep-game
         crypt-sweep-vblank
         crypt-sweep-active
         crypt-sweep-verified-module
         crypt-sweep-rom-bytes
         crypt-sweep-asm-result
         crypt-sweep-type-result
         crypt-sweep-module-desc
         crypt-sweep-repairs
         build-crypt-sweep-chr-rom
         emit-crypt-sweep-6502-program
         compile-crypt-sweep-rom!)

(module+ main
  (define vb  (nes-type-result-vblank-grade crypt-sweep-type-result))
  (define act (nes-type-result-active-grade crypt-sweep-type-result))
  (printf "================================================================\n")
  (printf "  #lang boba-nes : Crypt Sweep: Chronomancer's Vault ROM Report\n")
  (printf "================================================================\n")
  (printf "  Well-Typed Hardware Module : ~a (0 violations)\n"
          (nes-type-result-well-typed? crypt-sweep-type-result))
  (printf "  6502 Machine Code Size     : ~a bytes (< 900 B, ~a page crossings)\n"
          (bytes-length (asm-result-bytes crypt-sweep-asm-result))
          (asm-result-page-crossings crypt-sweep-asm-result))
  (printf "  Phi1 VBlank / Active Cyc   : ~a / 2273 VBlank, ~a / 29780 Active\n"
          (nes-grade-cycles vb) (nes-grade-cycles act))
  (printf "  Phi2 OAM Total / Scanline  : ~a / 64 sprites (~a / 8 per scanline)\n"
          (nes-grade-oam-sprites vb) (nes-grade-scanline-sprites vb))
  (printf "  Phi3 Zero-Page Live / Peak : ~a B live / ~a B peak (<= 224 B)\n"
          (nes-grade-zp-bytes-live act) (nes-grade-zp-bytes-peak act))
  (printf "  Phi3 Non-Zero CHR Tiles    : ~a / 512 tiles\n"
          (nes-grade-chr-tiles act))
  (printf "  Output iNES 1.0 ROM        : build/crypt_sweep.nes (~a bytes)\n"
          (bytes-length crypt-sweep-rom-bytes))
  (printf "================================================================\n"))
