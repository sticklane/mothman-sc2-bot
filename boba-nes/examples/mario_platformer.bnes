#lang boba-nes

;; ============================================================================
;; examples/mario_platformer.bnes : Super Mario Bros. (World 1-1) in #lang boba-nes
;; ============================================================================
;; Exercises the #lang boba-nes extensions for continuous side-scrolling action:
;;   1. 8.8 Fixed-Point Subpixel Gravity, Velocity & Jump Impulse Integration
;;   2. Mid-Frame Sprite-0-Hit ($2002 bit 6) Stationary Top HUD + Scrolling Playfield
;;   3. Vertical Nametable Mirroring ($2000 & $2400 -> 512x240 Scrolling World 1-1)
;;   4. 16x16 Metasprite Actors (Mario & Goomba), '?' Block Bonk & Flagpole Victory
;; ============================================================================

(require racket/runtime-path
         racket/file)

(define-runtime-path build-dir "../build")

(defmetasprite mario-metasprite
  #:tl #x10 #:tr #x11
  #:bl #x12 #:br #x13
  #:attr #x00)

(defmetasprite goomba-metasprite
  #:tl #x14 #:tr #x15
  #:bl #x16 #:br #x17
  #:attr #x01)

(provide mario-rom-bytes
         mario-asm-result
         mario-type-result
         mario-module-desc)

(make-directory* build-dir)
(define mario-rom-path (build-path build-dir "mario_nes.nes"))

(define-values (mario-rom-bytes mario-asm-result mario-type-result mario-module-desc)
  (compile-mario-nes-rom! #:nes-out-path mario-rom-path))

(module+ main
  (define vb  (nes-type-result-vblank-grade mario-type-result))
  (define act (nes-type-result-active-grade mario-type-result))
  (printf "================================================================\n")
  (printf "  #lang boba-nes : Super Mario Bros. (World 1-1) ROM Report\n")
  (printf "================================================================\n")
  (printf "  Well-Typed Hardware Module : ~a\n" (nes-type-result-well-typed? mario-type-result))
  (printf "  Scroll & HUD Split Mode    : Horizontal ($2000+$2400 Vertical Mirroring + Sprite 0 Hit)\n")
  (printf "  Phi1 VBlank NMI Cycles     : ~a / 2273 cycles\n" (nes-grade-cycles vb))
  (printf "  Phi1 ActiveFrame Cycles    : ~a / 29780 cycles (8.8 subpixel physics + AABB)\n" (nes-grade-cycles act))
  (printf "  Phi2 OAM Total / Scanline  : ~a / 64 sprites (~a / 8 per scanline)\n"
          (nes-grade-oam-sprites vb) (nes-grade-scanline-sprites vb))
  (printf "  Phi3 Zero-Page Live / Peak : ~a B live / ~a B peak (<= 224 B)\n"
          (nes-grade-zp-bytes-live act) (nes-grade-zp-bytes-peak act))
  (printf "  Phi3 PRG-ROM Code + Tables : ~a / 32768 B\n" (nes-grade-prg-rom-bytes act))
  (printf "  Output iNES 1.0 ROM        : ~a (~a bytes)\n"
          mario-rom-path (bytes-length mario-rom-bytes))
  (printf "================================================================\n"))
