#lang boba-nes

;; ============================================================================
;; examples/mario_platformer.bnes : Super Mario Bros. (World 1-1) in #lang boba-nes
;; ============================================================================
;; Exercises the #lang boba-nes resource-separation constructs & genre libraries:
;;   1. Authentic 8 KB CHR-ROM extracted from commercial Super Mario Bros.
;;      (PPUCTRL = #$90: Sprites at PT0 $0000, Background at PT1 $1000)
;;   2. Zero-Offset BCD Typography (NINTENDO-STD-CHAR-MAP: '0'..'9' at #x00..#x09,
;;      'A'..'Z' at #x0A..#x23, Empty Sky at #x24, HUD Coin at #x2E, 'x' at #x29)
;;   3. Authentic Sprite-0 Coin-Bottom Anchor (#xFF in PT0 over #x2E at $2063)
;;   4. Row-Major 16x16 Metasprites: Small Mario (#x32..#x35) & Goomba (#x70..#x73)
;; ============================================================================

(defchr-layout smb-chr-layout
  #:sprite-pt  0
  #:bg-pt      1
  #:blank-tile #x24)

(defchar-map smb-hud-font
  #:digit-base #x00
  #:alpha-base #x0A
  #:space-tile #x24
  #:extra      (list (cons #\- #x28) (cons #\x #x29) (cons #\! #x2B) (cons #\* #x2E)))

(defsprite-tile smb-sprite0-coin-bottom #:tile #xFF #:attr #x00)

(defmetasprite mario-metasprite
  #:tiles (list #x32 #x33 #x34 #x35)
  #:order 'row-major
  #:attr  #x00)

(defmetasprite goomba-metasprite
  #:tiles (list #x70 #x71 #x72 #x73)
  #:order 'row-major
  #:attr  #x01)

(provide smb-chr-layout
         smb-hud-font
         smb-sprite0-coin-bottom
         mario-metasprite
         goomba-metasprite
         mario-rom-bytes
         mario-asm-result
         mario-type-result
         mario-module-desc)

(define mario-rom-path "build/mario_nes.nes")

(define-values (mario-rom-bytes mario-asm-result mario-type-result mario-module-desc)
  (compile-mario-nes-rom! #:nes-out-path mario-rom-path))

(module+ main
  (define vb  (nes-type-result-vblank-grade mario-type-result))
  (define act (nes-type-result-active-grade mario-type-result))
  (printf "================================================================\n")
  (printf "  #lang boba-nes : Super Mario Bros. (World 1-1) ROM Report\n")
  (printf "================================================================\n")
  (printf "  Well-Typed Hardware Module : ~a\n" (nes-type-result-well-typed? mario-type-result))
  (printf "  CHR Resource Layout        : Authentic SMB 8 KB CHR-ROM (PT0 Sprites / PT1 BG)\n")
  (printf "  Scroll & HUD Split Mode    : Horizontal ($2000+$2400 Vertical Mirroring + Sprite 0 #xFF)\n")
  (printf "  Phi1 VBlank NMI Cycles     : ~a / 2273 cycles (Zero-offset BCD HUD digits)\n" (nes-grade-cycles vb))
  (printf "  Phi1 ActiveFrame Cycles    : ~a / 29780 cycles (8.8 subpixel physics + AABB)\n" (nes-grade-cycles act))
  (printf "  Phi2 OAM Total / Scanline  : ~a / 64 sprites (~a / 8 per scanline)\n"
          (nes-grade-oam-sprites vb) (nes-grade-scanline-sprites vb))
  (printf "  Phi3 Zero-Page Live / Peak : ~a B live / ~a B peak (<= 224 B)\n"
          (nes-grade-zp-bytes-live act) (nes-grade-zp-bytes-peak act))
  (printf "  Phi3 PRG-ROM Code + Tables : ~a / 32768 B (~a CHR tiles)\n"
          (nes-grade-prg-rom-bytes act) (nes-grade-chr-tiles act))
  (printf "  Output iNES 1.0 ROM        : ~a (~a bytes)\n"
          mario-rom-path (bytes-length mario-rom-bytes))
  (printf "================================================================\n"))
