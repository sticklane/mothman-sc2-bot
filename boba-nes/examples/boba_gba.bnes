#lang boba-nes

;; ============================================================================
;; examples/boba_gba.bnes
;; Game Boy Advance (ARM7TDMI: ARM32 + Thumb16) "Boba Is You" Cartridge in
;; #lang boba-nes
;;
;; Compiles "Boba Is You" to a bootable `.gba` ROM (`build/boba_gba.gba`) with:
;;   1. Official 156-byte GBA Nintendo Boot Logo ($04..$9F), `#x96` Fixed Byte ($B2),
;;      and Exact `$BD` GBA Header Complement Check (`chk = (-(sum($A0..$BC) + #x19)) & #xFF`)
;;   2. Static `u16`/`u32` VRAM Bus-Width Capability Verification (0 `STRB` writes
;;      to PALRAM $05000000, VRAM $06000000, or OAM $07000000) & 1-Cycle 32-Bit IWRAM Grading
;;   3. Dual-ISA ARM32 + Thumb16 Machine Code (`boot_init`, `thumb_bg0_tilemap_veneer`,
;;      `frame_step`) + 5 DMA3 32-Bit Transfers (`$040000D4..$040000DE`)
;;   4. Headless ARM7TDMI + DMA3 + PPU Execution Verification across a 4-Stage
;;      Campaign Playthrough (`FAIL_OK -> REC_OK -> FULL_WIN_OK`)
;; ============================================================================

(require racket/format
         "../compiler/backend-gba.rkt")

;; 1. Graded Campaign State Machine (Verified Totality, Recovery & Victory Reachability)
(defstate-machine boba-gba-campaign-fsm
  #:initial gba-stage-0
  ([gba-stage-0      #:kind normal  #:transitions (gba-stage-1 skull-defeat)]
   [gba-stage-1      #:kind normal  #:transitions (gba-stage-2 skull-defeat)]
   [gba-stage-2      #:kind normal  #:transitions (gba-stage-3 skull-defeat)]
   [gba-stage-3      #:kind normal  #:transitions (gba-campaign-win skull-defeat)]
   [skull-defeat     #:kind failure #:transitions (gba-stage-0 gba-stage-1 gba-stage-2 gba-stage-3)]
   [gba-campaign-win #:kind victory #:transitions (gba-stage-0)]))

;; 2. Compile `build/boba_gba.gba` & Execute Headless ARM7TDMI + DMA3 + PPU Verification
(define boba-gba-build-result  (compile-boba-gba-rom! #:gba-out-path "build/boba_gba.gba"))
(define boba-gba-rom-bytes     (hash-ref boba-gba-build-result 'rom-bytes))
(define boba-gba-asm-result    (hash-ref boba-gba-build-result 'asm-result))
(define boba-gba-bus-check     (hash-ref boba-gba-build-result 'bus-check))
(define boba-gba-exec-report   (verify-gba-rom-execution boba-gba-rom-bytes))

(provide boba-gba-campaign-fsm
         boba-gba-build-result
         boba-gba-rom-bytes
         boba-gba-asm-result
         boba-gba-bus-check
         boba-gba-exec-report)

(module+ main
  (printf "================================================================\n")
  (printf "  #lang boba-nes : GBA ARM7TDMI (ARM32 + Thumb16) ROM Report\n")
  (printf "================================================================\n")
  (printf "  Output Cartridge ROM       : build/boba_gba.gba (~a bytes)\n"
          (bytes-length boba-gba-rom-bytes))
  (printf "  GBA Header Entry / Fixed   : #xEA00002E -> $080000C0 | $B2=#x~x | $BD=#x~x (valid? ~a)\n"
          (bytes-ref boba-gba-rom-bytes #xB2)
          (hash-ref boba-gba-exec-report 'header-checksum)
          (hash-ref boba-gba-exec-report 'header-valid?))
  (printf "  ARM32 / Thumb16 Inst Count : ~a ARM32 + ~a Thumb16 (~a total insts)\n"
          (gba-asm-result-arm-count boba-gba-asm-result)
          (gba-asm-result-thumb-count boba-gba-asm-result)
          (hash-ref boba-gba-asm-result 'instruction-count))
  (printf "  VRAM u16/u32 Bus Verifier  : ~a (STRB violations = ~a, DMA3 transfers = ~a)\n"
          (hash-ref boba-gba-bus-check 'valid?)
          (hash-ref boba-gba-exec-report 'strb-vram-violations)
          (hash-ref boba-gba-exec-report 'dma3-transfers))
  (printf "  Work RAM Placement Grade   : ~a (~a IWRAM 1-cyc vs ~a EWRAM waitstate accesses)\n"
          (hash-ref boba-gba-bus-check 'memory-placement-grade)
          (hash-ref boba-gba-bus-check 'iwram-accesses)
          (hash-ref boba-gba-bus-check 'ewram-accesses))
  (printf "  PPU Boot State             : REG_DISPCNT=#x~x | REG_BG0CNT=#x~x | Thumb BG0 Map=#x~x\n"
          (hash-ref boba-gba-exec-report 'dispcnt)
          (hash-ref boba-gba-exec-report 'bg0cnt)
          (hash-ref boba-gba-exec-report 'thumb-bg0-map-entry))
  (printf "  4-Stage Campaign Playtest  : ~a (Stage ~a, Score ~a, Verified? ~a)\n"
          (hash-ref boba-gba-exec-report 'campaign-status)
          (hash-ref boba-gba-exec-report 'final-stage-id)
          (hash-ref boba-gba-exec-report 'final-score)
          (hash-ref boba-gba-exec-report 'verified?))
  (printf "================================================================\n"))
