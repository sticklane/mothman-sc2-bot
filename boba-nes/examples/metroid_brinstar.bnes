#lang boba-nes

;; ============================================================================
;; examples/metroid_brinstar.bnes : Metroid (NES, 1986) in #lang boba-nes
;; ============================================================================
;; Exercises the #lang boba-nes hardware-software co-design constructs:
;;   1. Authentic 8 x 16 KB MMC1 PRG-ROM + 8 KB CHR-RAM Architecture
;;      (`assets/roms/metroid.nes` -> `assets/decompiled/metroid_chr8k.bin`)
;;   2. Dynamic MMC1 Control Register ($8000) Mirroring (Vertical Mirroring in
;;      Brinstar Horizontal Shafts, Horizontal Mirroring in Vertical Shafts)
;;   3. Samus Aran Pedestal Materialization, Maru Mari (Morph Ball) Pickup,
;;      Power Beam / Missile Combat, Zoomer Energy Drain ("EN..30" -> "EN..00"),
;;      START Recovery, and Full 4-Zone Zebes Campaign (Brinstar -> Norfair ->
;;      Kraid/Ridley Lair -> Tourian Mother Brain & Escape)
;; ============================================================================

(require "../compiler/decompiled-metroid.rkt")

(defcartridge metroid-mmc1-spec metroid-mmc1-budget
  #:mapper    MMC1
  #:prg-banks 8
  #:chr-banks 0
  #:chr-mode  chr-ram
  #:wram-bytes 8192
  #:battery?  #f
  #:mirroring vertical)

(defchr-layout metroid-chr-layout
  #:sprite-pt  0
  #:bg-pt      1
  #:blank-tile #xFF)

(defchar-map metroid-hud-font
  #:digit-base #xA0
  #:alpha-base #xAA
  #:space-tile #xFF
  #:extra      (list (cons #\. #x3A) (cons #\- #xFE)))

(defmetasprite samus-upper-metasprite
  #:tiles (list #x09 #x09 #x19 #x1A)
  #:order 'row-major
  #:attr  #x20)

(defmetasprite samus-lower-metasprite
  #:tiles (list #x29 #x2A #x39 #x39)
  #:order 'row-major
  #:attr  #x20)

(defmetasprite zoomer-metasprite
  #:tiles (list #xCC #xCD #xDC #xDD)
  #:order 'row-major
  #:attr  #x22)

(defstate-machine metroid-zebes-fsm
  #:initial brinstar-pedestal
  ([brinstar-pedestal    #:kind normal  #:transitions (norfair-caverns energy-depleted)]
   [norfair-caverns      #:kind normal  #:transitions (kraid-ridley-lair energy-depleted)]
   [kraid-ridley-lair    #:kind normal  #:transitions (tourian-mother-brain energy-depleted)]
   [tourian-mother-brain #:kind normal  #:transitions (zebes-escaped energy-depleted)]
   [energy-depleted      #:kind failure #:transitions (brinstar-pedestal norfair-caverns kraid-ridley-lair tourian-mother-brain)]
   [zebes-escaped        #:kind victory #:transitions (brinstar-pedestal)]))

(defzp-map metroid-zp-layout
  ([frame-cnt      #x13 monotonic-frame-counter]
   [samus-x        #x14 player-or-actor-coord]
   [samus-y        #x15 player-or-actor-coord]
   [samus-dir      #x16 game-phase-or-flag]
   [beam-timer     #x17 game-phase-or-flag]
   [beam-x         #x18 player-or-actor-coord]
   [morph-ball     #x19 game-phase-or-flag]
   [enemy-x        #x1A player-or-actor-coord]
   [enemy-y        #x1B player-or-actor-coord]
   [enemy-alive    #x1C game-phase-or-flag]
   [score          #x1E hud-bcd-counter]
   [energy         #x20 hud-bcd-counter]
   [missiles       #x21 hud-bcd-counter]
   [morph-active   #x22 game-phase-or-flag]
   [door-open      #x23 game-phase-or-flag]
   [won            #x24 game-phase-or-flag]
   [lives          #x25 hud-bcd-counter]
   [dead           #x26 game-phase-or-flag]
   [stage-id       #x28 game-phase-or-flag]
   [game-completed #x29 game-phase-or-flag]))

(define metroid-entry       metroid-decompiled-game)
(define metroid-rom-bytes   (hash-ref metroid-entry 'rom-bytes))
(define metroid-asm-result  (hash-ref metroid-entry 'asm-result))
(define metroid-type-result (hash-ref metroid-entry 'type-result))
(define metroid-module-desc (hash-ref metroid-entry 'module-desc))
(define metroid-multibank   (analyze-authentic-metroid-multibank-rom))

(provide metroid-mmc1-spec
         metroid-mmc1-budget
         metroid-chr-layout
         metroid-hud-font
         samus-upper-metasprite
         samus-lower-metasprite
         zoomer-metasprite
         metroid-zebes-fsm
         metroid-zp-layout
         metroid-entry
         metroid-rom-bytes
         metroid-asm-result
         metroid-type-result
         metroid-module-desc
         metroid-multibank)

(module+ main
  (define vb  (nes-type-result-vblank-grade metroid-type-result))
  (define act (nes-type-result-active-grade metroid-type-result))
  (printf "================================================================\n")
  (printf "  #lang boba-nes : Metroid (NES, 1986) Brinstar ROM Report\n")
  (printf "================================================================\n")
  (printf "  Authentic MMC1 Cartridge   : ~a x 16 KB PRG-ROM + 8 KB CHR-RAM (~a insts)\n"
          (hash-ref metroid-multibank 'prg-banks)
          (hash-ref metroid-multibank 'total-instructions))
  (printf "  Well-Typed Hardware Module : ~a\n" (nes-type-result-well-typed? metroid-type-result))
  (printf "  CHR Resource Layout        : Authentic Metroid CHR-RAM (PT0 Sprites / PT1 Brinstar BG)\n")
  (printf "  Dynamic Mirroring Mode     : ~a (MMC1 $8000 Control Register)\n"
          (hash-ref metroid-entry 'mirroring))
  (printf "  Phi1 VBlank NMI Cycles     : ~a / 2273 cycles\n" (nes-grade-cycles vb))
  (printf "  Phi1 ActiveFrame Cycles    : ~a / 29780 cycles\n" (nes-grade-cycles act))
  (printf "  Phi2 OAM Total / Scanline  : ~a / 64 sprites (~a scanline sprites)\n"
          (nes-grade-oam-sprites vb) (nes-grade-scanline-sprites vb))
  (printf "  Phi3 Zero-Page Live / Peak : ~a B live / ~a B peak (<= 224 B)\n"
          (nes-grade-zp-bytes-live act) (nes-grade-zp-bytes-peak act))
  (printf "  Phi3 PRG-ROM Code + Tables : ~a / 32768 B (~a CHR tiles)\n"
          (nes-grade-prg-rom-bytes act) (nes-grade-chr-tiles act))
  (printf "  Output iNES 1.0 ROM        : build/metroid_nes.nes (~a bytes)\n"
          (bytes-length metroid-rom-bytes))
  (printf "================================================================\n"))
