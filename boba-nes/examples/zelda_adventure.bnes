#lang boba-nes

;; ============================================================================
;; examples/zelda_adventure.bnes : The Legend of Zelda in #lang boba-nes
;; ============================================================================
;; Exercises the #lang boba-nes extensions for top-down action-adventure games:
;;   1. 16x16 Metasprite Actors (Link & Octorok) + Directional Sword Hitbox
;;   2. Coprime OAM Flicker Multiplexer (+20 byte stride, Phi2 scanline > 8 safe!)
;;   3. Enemy Elimination -> Dungeon Key Drop -> North Locked Door -> Triforce Sanctum
;;   4. Automatic 6502 Long-Branch Relaxation across multi-room state handlers
;; ============================================================================

(require racket/runtime-path
         racket/file)

(define-runtime-path build-dir "../build")

(defmetasprite link-metasprite
  #:tl #x10 #:tr #x11
  #:bl #x12 #:br #x13
  #:attr #x00)

(defmetasprite octorok-metasprite
  #:tl #x16 #:tr #x17
  #:bl #x18 #:br #x19
  #:attr #x02)

(provide zelda-rom-bytes
         zelda-asm-result
         zelda-type-result
         zelda-module-desc)

(make-directory* build-dir)
(define zelda-rom-path (build-path build-dir "zelda_nes.nes"))

(define-values (zelda-rom-bytes zelda-asm-result zelda-type-result zelda-module-desc)
  (compile-zelda-nes-rom! #:nes-out-path zelda-rom-path))

(module+ main
  (define vb  (nes-type-result-vblank-grade zelda-type-result))
  (define act (nes-type-result-active-grade zelda-type-result))
  (printf "================================================================\n")
  (printf "  #lang boba-nes : The Legend of Zelda NES ROM Report\n")
  (printf "================================================================\n")
  (printf "  Well-Typed Hardware Module : ~a\n" (nes-type-result-well-typed? zelda-type-result))
  (printf "  OAM Scanline Multiplexer   : Enabled (Coprime +5-sprite stride rotation)\n")
  (printf "  Phi1 VBlank NMI Cycles     : ~a / 2273 cycles\n" (nes-grade-cycles vb))
  (printf "  Phi1 ActiveFrame Cycles    : ~a / 29780 cycles\n" (nes-grade-cycles act))
  (printf "  Phi2 OAM Total / Scanline  : ~a / 64 sprites (~a scanline sprites multiplexed)\n"
          (nes-grade-oam-sprites vb) (nes-grade-scanline-sprites vb))
  (printf "  Phi3 Zero-Page Live / Peak : ~a B live / ~a B peak (<= 224 B)\n"
          (nes-grade-zp-bytes-live act) (nes-grade-zp-bytes-peak act))
  (printf "  Phi3 PRG-ROM Code + Tables : ~a / 32768 B\n" (nes-grade-prg-rom-bytes act))
  (printf "  Output iNES 1.0 ROM        : ~a (~a bytes)\n"
          zelda-rom-path (bytes-length zelda-rom-bytes))
  (printf "================================================================\n"))
