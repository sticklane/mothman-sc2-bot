#lang boba-nes

;; ============================================================================
;; examples/zelda_adventure.bnes : The Legend of Zelda in #lang boba-nes
;; ============================================================================
;; Exercises the #lang boba-nes resource-separation constructs & genre libraries:
;;   1. Authentic 8 KB CHR Image composited from commercial Legend of Zelda PRG-ROM
;;      (CommonSpritePatterns + PatternBlockOWSP at PT0 $0000;
;;       CommonBackgroundPatterns + PatternBlockOWBG at PT1 $1000)
;;   2. Column-Major & Symmetric-Column-Major 16x16 Metasprites:
;;      - Link Down (#x00..#x03, #:order 'col-major)
;;      - Red Octorok (#x70..#x71, #:order 'symmetric-col-major with OAM H-flip #x40)
;;   3. Authentic Sword (#x08), Key (#x28), Triforce (#x2C), and HUD Hearts (#x65)
;;   4. Coprime OAM Flicker Multiplexer (+20 byte stride, Phi2 scanline > 8 safe!)
;; ============================================================================

(defchr-layout zelda-chr-layout
  #:sprite-pt  0
  #:bg-pt      1
  #:blank-tile #x24)

(defchar-map zelda-hud-font
  #:digit-base #x00
  #:alpha-base #x0A
  #:space-tile #x24
  #:extra      (list (cons #\- #x62) (cons #\= #x65)))

(defsprite-tile zelda-sword-vertical-tile #:tile #x08 #:attr #x00)
(defsprite-tile zelda-dungeon-key-tile    #:tile #x28 #:attr #x03)

(defmetasprite link-metasprite
  #:tiles (list #x00 #x01 #x02 #x03)
  #:order 'col-major
  #:attr  #x00)

(defmetasprite octorok-metasprite
  #:tiles (list #x70 #x71)
  #:order 'symmetric-col-major
  #:attr  #x02)

(defstate-machine zelda-quest-fsm
  #:initial overworld-0x77
  ([overworld-0x77       #:kind normal  #:transitions (eagle-sanctum defeat)]
   [eagle-sanctum        #:kind normal  #:transitions (underworld-boss defeat)]
   [underworld-boss      #:kind normal  #:transitions (death-mountain-ganon defeat)]
   [death-mountain-ganon #:kind normal  #:transitions (zelda-rescued defeat)]
   [defeat               #:kind failure #:transitions (overworld-0x77 underworld-boss death-mountain-ganon)]
   [zelda-rescued        #:kind victory #:transitions (overworld-0x77)]))

(defzp-map zelda-zp-layout
  ([link-x         #x14 player-or-actor-coord]
   [link-y         #x15 player-or-actor-coord]
   [room-id        #x21 game-phase-or-flag]
   [hearts         #x22 hud-bcd-counter]
   [triforce-won   #x23 game-phase-or-flag]
   [hurt-timer     #x26 game-phase-or-flag]
   [dead           #x27 game-phase-or-flag]
   [triforce-count #x28 hud-bcd-counter]
   [game-completed #x29 game-phase-or-flag]))

(provide zelda-chr-layout
         zelda-hud-font
         zelda-sword-vertical-tile
         zelda-dungeon-key-tile
         link-metasprite
         octorok-metasprite
         zelda-quest-fsm
         zelda-zp-layout
         zelda-rom-bytes
         zelda-asm-result
         zelda-type-result
         zelda-module-desc)

(define zelda-rom-path "build/zelda_nes.nes")

(define-values (zelda-rom-bytes zelda-asm-result zelda-type-result zelda-module-desc)
  (compile-zelda-nes-rom! #:nes-out-path zelda-rom-path))

(module+ main
  (define vb  (nes-type-result-vblank-grade zelda-type-result))
  (define act (nes-type-result-active-grade zelda-type-result))
  (printf "================================================================\n")
  (printf "  #lang boba-nes : The Legend of Zelda NES ROM Report\n")
  (printf "================================================================\n")
  (printf "  Well-Typed Hardware Module : ~a\n" (nes-type-result-well-typed? zelda-type-result))
  (printf "  CHR Resource Layout        : Authentic Zelda CHR (PT0 Sprites / PT1 Overworld BG)\n")
  (printf "  Metasprite Orders          : col-major (Link #x00..#x03) + symmetric-col-major (Octorok #x70..#x71)\n")
  (printf "  OAM Scanline Multiplexer   : Enabled (Coprime +5-sprite stride rotation)\n")
  (printf "  Phi1 VBlank NMI Cycles     : ~a / 2273 cycles\n" (nes-grade-cycles vb))
  (printf "  Phi1 ActiveFrame Cycles    : ~a / 29780 cycles\n" (nes-grade-cycles act))
  (printf "  Phi2 OAM Total / Scanline  : ~a / 64 sprites (~a scanline sprites multiplexed)\n"
          (nes-grade-oam-sprites vb) (nes-grade-scanline-sprites vb))
  (printf "  Phi3 Zero-Page Live / Peak : ~a B live / ~a B peak (<= 224 B)\n"
          (nes-grade-zp-bytes-live act) (nes-grade-zp-bytes-peak act))
  (printf "  Phi3 PRG-ROM Code + Tables : ~a / 32768 B (~a CHR tiles)\n"
          (nes-grade-prg-rom-bytes act) (nes-grade-chr-tiles act))
  (printf "  Output iNES 1.0 ROM        : ~a (~a bytes)\n"
          zelda-rom-path (bytes-length zelda-rom-bytes))
  (printf "================================================================\n"))
