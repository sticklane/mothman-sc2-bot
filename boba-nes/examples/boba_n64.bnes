#lang boba-nes

;; ============================================================================
;; examples/boba_n64.bnes
;; Nintendo 64 (64-Bit MIPS VR4300 + RSP Vector Microcode + RDP Display List)
;; "Boba Is You" Cartridge in #lang boba-nes
;;
;; Compiles "Boba Is You" to a big-endian `.z64` ROM (`build/boba_n64.z64`) with:
;;   1. Big-Endian PI BSD DOM1 Header (`#x80371240`), Boot PC `#x80000400`,
;;      CRC1/CRC2 Checksums, `"NBOB"` Cartridge ID, and IPL3 Boot Stub
;;   2. Static `CapDMA` 16-Byte Cache-Line Alignment & `(mips-cache ...)` Writeback
;;      Verification + `IMEM <= 4 KB`, `DMEM <= 4 KB`, `TMEM <= 4 KB` Bounds
;;   3. RSP 128-Bit (`8 x 16-bit`) Vector Unit Microcode (`rsp-lqv`, `rsp-vmulf`,
;;      `rsp-vmacf`, `rsp-vadd`, `rsp-sqv`, `rsp-break`) & 64-Bit RDP Display List
;;   4. Headless VR4300 + RSP + RDP + VI Execution Verification across a 4-Stage
;;      Campaign Playthrough (`FAIL_OK -> REC_OK -> FULL_WIN_OK`)
;; ============================================================================

(require racket/format
         "../compiler/backend-n64.rkt")

;; 1. Graded Campaign State Machine (Verified Totality, Recovery & Victory Reachability)
(defstate-machine boba-n64-campaign-fsm
  #:initial n64-stage-0
  ([n64-stage-0      #:kind normal  #:transitions (n64-stage-1 skull-defeat)]
   [n64-stage-1      #:kind normal  #:transitions (n64-stage-2 skull-defeat)]
   [n64-stage-2      #:kind normal  #:transitions (n64-stage-3 skull-defeat)]
   [n64-stage-3      #:kind normal  #:transitions (n64-campaign-win skull-defeat)]
   [skull-defeat     #:kind failure #:transitions (n64-stage-0 n64-stage-1 n64-stage-2 n64-stage-3)]
   [n64-campaign-win #:kind victory #:transitions (n64-stage-0)]))

;; 2. Compile `build/boba_n64.z64` & Execute Headless VR4300 + RSP + RDP + VI Verification
(define boba-n64-build-result  (compile-boba-n64-rom! #:z64-out-path "build/boba_n64.z64"))
(define boba-n64-rom-bytes     (hash-ref boba-n64-build-result 'rom-bytes))
(define boba-n64-mips-result   (hash-ref boba-n64-build-result 'mips-result))
(define boba-n64-rsp-result    (hash-ref boba-n64-build-result 'rsp-result))
(define boba-n64-rdp-result    (hash-ref boba-n64-build-result 'rdp-result))
(define boba-n64-safety-check  (hash-ref boba-n64-build-result 'safety-check))
(define boba-n64-exec-report   (verify-n64-rom-execution boba-n64-rom-bytes))

(provide boba-n64-campaign-fsm
         boba-n64-build-result
         boba-n64-rom-bytes
         boba-n64-mips-result
         boba-n64-rsp-result
         boba-n64-rdp-result
         boba-n64-safety-check
         boba-n64-exec-report)

(module+ main
  (printf "================================================================\n")
  (printf "  #lang boba-nes : N64 MIPS VR4300 + RSP/RDP .z64 ROM Report\n")
  (printf "================================================================\n")
  (printf "  Output Cartridge ROM       : build/boba_n64.z64 (~a bytes)\n"
          (bytes-length boba-n64-rom-bytes))
  (printf "  .z64 Header Magic / BootPC : #x~x | BootPC=#x~x | CRC1=#x~x | CRC2=#x~x\n"
          (hash-ref boba-n64-exec-report 'header-magic)
          (hash-ref boba-n64-exec-report 'boot-pc)
          (hash-ref boba-n64-exec-report 'crc1)
          (hash-ref boba-n64-exec-report 'crc2))
  (printf "  CapDMA 16B & Cache Safety  : aligned? ~a | D-Cache WB ops = ~a | valid? ~a\n"
          (hash-ref boba-n64-exec-report 'dma-16byte-aligned?)
          (hash-ref boba-n64-exec-report 'cache-wb-ops)
          (hash-ref boba-n64-safety-check 'valid?))
  (printf "  RCP Memory Footprint       : IMEM=~a/4096 B | DMEM=~a/4096 B | TMEM=~a/4096 B\n"
          (hash-ref boba-n64-exec-report 'imem-bytes)
          (hash-ref boba-n64-exec-report 'dmem-bytes)
          (hash-ref boba-n64-exec-report 'tmem-bytes))
  (printf "  RSP SIMD & RDP Execution   : ~a RSP vec ops (lane0=~a) | ~a RDP cmds (FullSync? ~a)\n"
          (hash-ref boba-n64-exec-report 'rsp-vector-ops)
          (hash-ref boba-n64-exec-report 'rsp-simd-lane0-out)
          (hash-ref boba-n64-exec-report 'rdp-commands)
          (hash-ref boba-n64-exec-report 'rdp-full-sync?))
  (printf "  VI Framebuffer Scanout     : Origin=$#x~x | Width=~a | Pixels Drawn=~a\n"
          (hash-ref boba-n64-exec-report 'vi-origin)
          (hash-ref boba-n64-exec-report 'vi-width)
          (hash-ref boba-n64-exec-report 'vi-pixels-drawn))
  (printf "  4-Stage Campaign Playtest  : ~a (Stage ~a, Score ~a, Verified? ~a)\n"
          (hash-ref boba-n64-exec-report 'campaign-status)
          (hash-ref boba-n64-exec-report 'final-stage-id)
          (hash-ref boba-n64-exec-report 'final-score)
          (hash-ref boba-n64-exec-report 'verified?))
  (printf "================================================================\n"))
