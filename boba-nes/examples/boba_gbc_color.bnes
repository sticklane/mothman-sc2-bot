#lang boba-nes

;; ============================================================================
;; examples/boba_gbc_color.bnes : "Boba GBC Color" for Game Boy Color (CGB)
;; ============================================================================
;; Compiles a 4-stage "Boba Is You" puzzle campaign to a 32,768-byte Sharp SM83
;; Game Boy Color (.gbc) cartridge ($0143 = #x80) with CGB double-speed mode
;; ($FF4D KEY1 + STOP -> 8.388 MHz), 15-bit BGR555 palette RAM uploads via
;; BCPS/BCPD ($FF68/$FF69) and OCPS/OCPD ($FF6A/$FF6B), HBlank HDMA ($FF51-$FF55),
;; HRAM $FF80 OAM DMA trampoline, and headless 4-stage playthrough verification.
;; ============================================================================

(require racket/runtime-path
         racket/file
         racket/format
         "../compiler/backend-gb-gbc.rkt")

(define-runtime-path build-dir "../build")
(make-directory* build-dir)

(define gbc-rom-path (build-path build-dir "boba_gbc.gbc"))

;; 15-bit BGR555 Palettes (bit 15 = 0, R5/G5/B5 in [0..31])
(define boba-gbc-bg-palette
  (list (encode-gbc-bgr555 31 30 27)  ; Cream Milk Tea Foam
        (encode-gbc-bgr555 26 18 11)  ; Roasted Brown Sugar
        (encode-gbc-bgr555 15  8  5)  ; Deep Oolong Amber
        (encode-gbc-bgr555  4  2  3))) ; Tapioca Pearl Black

(define boba-gbc-obj-palette
  (list (encode-gbc-bgr555 31 31 31)  ; Highlight White
        (encode-gbc-bgr555 31 23  8)  ; Honey Gold
        (encode-gbc-bgr555 29  9 14)  ; Taro Berry Pink
        (encode-gbc-bgr555  5  2  6))) ; Dark Outline

(provide boba-gbc-rom-bytes
         boba-gbc-asm-result
         boba-gbc-peephole-stats
         boba-gbc-verification)

(define-values (boba-gbc-rom-bytes
                boba-gbc-asm-result
                boba-gbc-peephole-stats
                boba-gbc-verification)
  (compile-boba-gb-rom! #:out-path gbc-rom-path
                        #:title "BOBA GBC COLOR"
                        #:gbc? #t
                        #:bg-palette boba-gbc-bg-palette
                        #:obj-palette boba-gbc-obj-palette))

(module+ main
  (printf "================================================================\n")
  (printf "  #lang boba-nes : Game Boy Color (CGB / SM83) Report\n")
  (printf "================================================================\n")
  (printf "  Output .gbc Cartridge    : ~a (~a bytes)\n"
          gbc-rom-path (bytes-length boba-gbc-rom-bytes))
  (printf "  CGB Header Flag ($0143)  : #x80 (gbc-mode? = ~a)\n"
          (hash-ref boba-gbc-verification 'gbc-mode?))
  (printf "  CGB Double-Speed ($FF4D) : ~a (8.388 MHz active)\n"
          (hash-ref boba-gbc-verification 'gbc-double-speed?))
  (printf "  15-Bit BGR555 Palettes   : ~a (BCPS/BCPD & OCPS/OCPD verified)\n"
          (hash-ref boba-gbc-verification 'gbc-bgr555-palettes-ok?))
  (printf "  HBlank HDMA ($FF51-$FF55): ~a block transfer(s)\n"
          (hash-ref boba-gbc-verification 'hdma-transfers))
  (printf "  SM83 Code Size ($0150+)  : ~a bytes (~a instructions)\n"
          (bytes-length (sm83-asm-result-bytes boba-gbc-asm-result))
          (sm83-asm-result-instruction-count boba-gbc-asm-result))
  (printf "  Peephole Optimization    : ~a B saved, ~a M-cycles saved\n"
          (hash-ref boba-gbc-peephole-stats 'bytes-saved)
          (hash-ref boba-gbc-peephole-stats 'm-cycles-saved))
  (printf "  Nintendo Logo & Checksum : logo=~a, checksum=~a (#x~a / #x~a)\n"
          (hash-ref boba-gbc-verification 'valid-header?)
          (hash-ref boba-gbc-verification 'checksum-ok?)
          (~r (hash-ref boba-gbc-verification 'header-checksum) #:base 16 #:min-width 2 #:pad-string "0")
          (~r (hash-ref boba-gbc-verification 'global-checksum) #:base 16 #:min-width 4 #:pad-string "0"))
  (printf "  HRAM $FF80 OAM DMA Safe  : ~a (~a DMA transfers)\n"
          (hash-ref boba-gbc-verification 'hram-dma-ok?)
          (hash-ref boba-gbc-verification 'oam-dma-transfers))
  (printf "  PPU STAT Mode Safe VRAM  : ~a (~a tiles, ~a BG map writes)\n"
          (hash-ref boba-gbc-verification 'stat-mode-safe?)
          (hash-ref boba-gbc-verification 'vram-tiles-uploaded)
          (hash-ref boba-gbc-verification 'bg-map-writes))
  (printf "  4-Stage Campaign Trace   : ~a (stages ~a)\n"
          (hash-ref boba-gbc-verification 'campaign-result)
          (hash-ref boba-gbc-verification 'stages-visited))
  (printf "================================================================\n"))
