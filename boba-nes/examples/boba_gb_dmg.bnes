#lang boba-nes

;; ============================================================================
;; examples/boba_gb_dmg.bnes : "Boba DMG" for Original Game Boy (DMG-01)
;; ============================================================================
;; Compiles a 4-stage "Boba Is You" puzzle campaign to a 32,768-byte Sharp SM83
;; (LR35902) Game Boy (.gb) cartridge with verified Nintendo logo ($0104-$0133),
;; header/global checksums ($014D-$014F), 10-byte HRAM OAM DMA trampoline at
;; $FF80, STAT-safe VRAM uploads, and headless 4-stage playthrough verification.
;; ============================================================================

(require racket/runtime-path
         racket/file
         racket/format
         "../compiler/backend-gb-gbc.rkt")

(define-runtime-path build-dir "../build")
(make-directory* build-dir)

(define gb-rom-path (build-path build-dir "boba_gb.gb"))

;; Declarative 8x8 2bpp Game Boy Tiles (row-interleaved 2bpp format)
(define boba-dmg-tiles
  (list
   ;; Tile 0: Blank background
   (compile-gb-2bpp-tile
    '("........" "........" "........" "........"
      "........" "........" "........" "........"))
   ;; Tile 1: Boba Hero Cup (Stage 0)
   (compile-gb-2bpp-tile
    '("...33..." "..3223.." ".333333." ".312213."
      ".322223." ".323323." "..3333.." "...22..."))
   ;; Tile 2: Boba Hero Cup (Stage 1)
   (compile-gb-2bpp-tile
    '("...33..." "..3223.." ".333333." ".313313."
      ".322223." ".332233." "..3333.." "...22..."))
   ;; Tile 3: Boba Hero Cup (Stage 2)
   (compile-gb-2bpp-tile
    '("..3..3.." "..3223.." ".333333." ".312213."
      ".323323." ".322223." "..3333.." "...33..."))
   ;; Tile 4: Boba Crown Cup (Stage 3 Victory)
   (compile-gb-2bpp-tile
    '(".3.33.3." ".332233." ".333333." ".312213."
      ".323323." ".323323." "..3333.." "..3333.."))
   ;; Tile 5: Tapioca Pearl Goal
   (compile-gb-2bpp-tile
    '("..3333.." ".322223." "32112223" "32122223"
      "32222323" "32223323" ".322223." "..3333.."))
   ;; Tile 6: Hazard Spike Block
   (compile-gb-2bpp-tile
    '("...33..." "..3113.." "..3113.." ".313313."
      ".313313." "31133113" "31111113" "33333333"))
   ;; Tile 7: IS / YOU Rule Block
   (compile-gb-2bpp-tile
    '("33333333" "31111113" "31333313" "31322313"
      "31322313" "31333313" "31111113" "33333333"))))

(provide boba-gb-rom-bytes
         boba-gb-asm-result
         boba-gb-peephole-stats
         boba-gb-verification)

(define-values (boba-gb-rom-bytes
                boba-gb-asm-result
                boba-gb-peephole-stats
                boba-gb-verification)
  (compile-boba-gb-rom! #:out-path gb-rom-path
                        #:title "BOBA DMG"
                        #:gbc? #f
                        #:tiles boba-dmg-tiles))

(module+ main
  (printf "================================================================\n")
  (printf "  #lang boba-nes : Game Boy (DMG-01 / SM83) Compilation Report\n")
  (printf "================================================================\n")
  (printf "  Output .gb Cartridge     : ~a (~a bytes)\n"
          gb-rom-path (bytes-length boba-gb-rom-bytes))
  (printf "  SM83 Code Size ($0150+)  : ~a bytes (~a instructions)\n"
          (bytes-length (sm83-asm-result-bytes boba-gb-asm-result))
          (sm83-asm-result-instruction-count boba-gb-asm-result))
  (printf "  SM83 Static Timing       : ~a M-cycles (~a T-states)\n"
          (sm83-asm-result-m-cycles boba-gb-asm-result)
          (sm83-asm-result-t-states boba-gb-asm-result))
  (printf "  Peephole Optimization    : ~a B saved, ~a M-cycles saved\n"
          (hash-ref boba-gb-peephole-stats 'bytes-saved)
          (hash-ref boba-gb-peephole-stats 'm-cycles-saved))
  (printf "  Nintendo Logo & Header   : ~a\n"
          (hash-ref boba-gb-verification 'valid-header?))
  (printf "  Header / Global Checksum : #x~a / #x~a (ok? = ~a)\n"
          (~r (hash-ref boba-gb-verification 'header-checksum) #:base 16 #:min-width 2 #:pad-string "0")
          (~r (hash-ref boba-gb-verification 'global-checksum) #:base 16 #:min-width 4 #:pad-string "0")
          (hash-ref boba-gb-verification 'checksum-ok?))
  (printf "  HRAM $FF80 OAM DMA Safe  : ~a (~a DMA transfers)\n"
          (hash-ref boba-gb-verification 'hram-dma-ok?)
          (hash-ref boba-gb-verification 'oam-dma-transfers))
  (printf "  PPU STAT Mode Safe VRAM  : ~a (~a tiles, ~a BG map writes)\n"
          (hash-ref boba-gb-verification 'stat-mode-safe?)
          (hash-ref boba-gb-verification 'vram-tiles-uploaded)
          (hash-ref boba-gb-verification 'bg-map-writes))
  (printf "  4-Stage Campaign Trace   : ~a (stages ~a)\n"
          (hash-ref boba-gb-verification 'campaign-result)
          (hash-ref boba-gb-verification 'stages-visited))
  (printf "================================================================\n"))
