pico-8 cartridge // http://www.pico-8.com
version 41
__lua__
-- boba pico-8 : graded hardware cartridge
-- verified q16.16 fixed-point & <= 8192 tokens

function _init()
 state="play"
 sector=0
 px=24
 py=64
 vx=0
 vy=0
 goal_x=96
 haz_x=60
 score=0
 deaths=0
 recovered=0
 won=0
 frame=0
 trace="INIT"
end

function trigger_hazard()
 state="fail"
 deaths+=1
 trace="FAIL_OK"
 sfx(1)
end

function recover_stage()
 if state=="fail" then
  state="play"
  px=24
  py=64
  recovered=1
  trace="FAIL_OK -> REC_OK"
  sfx(2)
 end
end

function advance_sector()
 score+=100
 if sector<2 then
  sector+=1
  px=24
  sfx(0)
 else
  state="win"
  won=1
  trace="FAIL_OK -> REC_OK -> FULL_WIN_OK"
  sfx(3)
 end
end

function _update60()
 frame+=1
 if state=="fail" then
  if btnp(4) or btnp(5) then
   recover_stage()
  end
 elseif state=="play" then
  if btn(0) then px-=2 end
  if btn(1) then px+=2 end
  if btn(2) then py-=2 end
  if btn(3) then py+=2 end
  if px==haz_x then
   trigger_hazard()
  elseif px>=goal_x then
   advance_sector()
  end
 end
end

function _draw()
 cls(1)
 map(0,0,0,0,16,16)
 spr(4,16,16)
 spr(3,haz_x,64)
 spr(2,goal_x,64)
 spr(1,px,py)
 print("sec:"..sector.." scr:"..score,4,4,7)
 if state=="fail" then
  print("hazard! press z/x",24,52,8)
 elseif state=="win" then
  print("full_win_ok!",36,52,11)
 end
end
