/-- Inverse compile-time wire relabeling `perm91^-1` (`invRelabelSLP91`). -/
def invRelabelSLP91 (y : BitVec 32) : BitVec 32 :=
  wireBit32 y 0 0   ||| wireBit32 y 1 1   ||| wireBit32 y 26 2  ||| wireBit32 y 27 3  |||
  wireBit32 y 20 4  ||| wireBit32 y 29 5  ||| wireBit32 y 22 6  ||| wireBit32 y 31 7  |||
  wireBit32 y 24 8  ||| wireBit32 y 17 9  ||| wireBit32 y 2 10  ||| wireBit32 y 3 11  |||
  wireBit32 y 4 12  ||| wireBit32 y 13 13 ||| wireBit32 y 14 14 ||| wireBit32 y 23 15 |||
  wireBit32 y 16 16 ||| wireBit32 y 25 17 ||| wireBit32 y 18 18 ||| wireBit32 y 19 19 |||
  wireBit32 y 12 20 ||| wireBit32 y 5 21  ||| wireBit32 y 30 22 ||| wireBit32 y 15 23 |||
  wireBit32 y 8 24  ||| wireBit32 y 9 25  ||| wireBit32 y 10 26 ||| wireBit32 y 11 27 |||
  wireBit32 y 28 28 ||| wireBit32 y 21 29 ||| wireBit32 y 6 30  ||| wireBit32 y 7 31

/-- Complete `91-CX`, `0-SWAP`, `0`-ancilla in-place `MixColumns` `SLP` (`execMixColSLP91`). -/
def execMixColSLP91 (col : BitVec 32) : BitVec 32 :=
  relabelSLP91 (slp91PartB (slp91PartA col))

/-- Reversed gates 91..47 (`invSlp91PartB`). -/
def invSlp91PartB (s0 : BitVec 32) : BitVec 32 :=
  let s := cx32 s0 22 14; let s := cx32 s 23 15; let s := cx32 s 25 1;  let s := cx32 s 15 31
  let s := cx32 s 5 13;   let s := cx32 s 13 21; let s := cx32 s 4 28;  let s := cx32 s 1 17
  let s := cx32 s 17 9;   let s := cx32 s 16 17; let s := cx32 s 10 18; let s := cx32 s 28 12
  let s := cx32 s 3 19;   let s := cx32 s 31 7;  let s := cx32 s 14 6;  let s := cx32 s 19 11
  let s := cx32 s 18 26;  let s := cx32 s 12 20; let s := cx32 s 20 13; let s := cx32 s 13 22
  let s := cx32 s 22 30;  let s := cx32 s 6 22;  let s := cx32 s 0 16;  let s := cx32 s 7 16
  let s := cx32 s 22 23;  let s := cx32 s 16 1;  let s := cx32 s 16 24; let s := cx32 s 11 27
  let s := cx32 s 9 18;   let s := cx32 s 18 19; let s := cx32 s 19 4;  let s := cx32 s 21 29
  let s := cx32 s 29 14;  let s := cx32 s 24 0;  let s := cx32 s 30 31; let s := cx32 s 31 23
  let s := cx32 s 23 1;   let s := cx32 s 23 0;  let s := cx32 s 0 25;  let s := cx32 s 14 15
  let s := cx32 s 15 7;   let s := cx32 s 7 4;   let s := cx32 s 7 3;   let s := cx32 s 15 25
  cx32 s 1 10

/-- Reversed gates 46..1 (`invSlp91PartA`). -/
def invSlp91PartA (s0 : BitVec 32) : BitVec 32 :=
  let s := cx32 s0 23 19; let s := cx32 s 7 8;   let s := cx32 s 8 17;  let s := cx32 s 25 9
  let s := cx32 s 17 25;  let s := cx32 s 25 2;  let s := cx32 s 25 26; let s := cx32 s 26 3
  let s := cx32 s 26 10;  let s := cx32 s 10 2;  let s := cx32 s 2 3;   let s := cx32 s 3 27
  let s := cx32 s 10 11;  let s := cx32 s 27 19; let s := cx32 s 19 12; let s := cx32 s 11 12
  let s := cx32 s 4 20;   let s := cx32 s 12 4;  let s := cx32 s 15 11; let s := cx32 s 11 3
  let s := cx32 s 3 28;   let s := cx32 s 2 18;  let s := cx32 s 4 5;   let s := cx32 s 5 29
  let s := cx32 s 23 28;  let s := cx32 s 28 21; let s := cx32 s 21 5;  let s := cx32 s 5 6
  let s := cx32 s 29 13;  let s := cx32 s 15 24; let s := cx32 s 6 30;  let s := cx32 s 30 14
  let s := cx32 s 8 0;    let s := cx32 s 16 8;  let s := cx32 s 14 22; let s := cx32 s 20 28
  let s := cx32 s 31 7;   let s := cx32 s 7 23;  let s := cx32 s 9 1;   let s := cx32 s 0 16
  let s := cx32 s 28 4;   let s := cx32 s 19 3;  let s := cx32 s 13 5;  let s := cx32 s 18 10
  let s := cx32 s 1 25;   cx32 s 23 15

/-- Exact syntactic inverse `(invert-circuit)` of the `91-CX` `MixColumns` `SLP` (`execInvMixColSLP91`). -/
def execInvMixColSLP91 (col : BitVec 32) : BitVec 32 :=
  invSlp91PartA (invSlp91PartB (invRelabelSLP91 col))

/-- Exact `105-CX`, `0-SWAP` strictly fixed-wire (`P = I`) `SL_4(GF(2^8))` `MixColumns`
    `SLP` (`aes-mixcolumn-fixed-slp105-col-sexpr`) (`execMixColFixedSLP105`). -/
def execMixColFixedSLP105 (col : BitVec 32) : BitVec 32 :=
  let xorByte (s : BitVec 32) (sb db : Nat) : BitVec 32 :=
    let so := 8 * sb; let do_ := 8 * db
    let s := cx32 s (so + 0) (do_ + 0); let s := cx32 s (so + 1) (do_ + 1)
    let s := cx32 s (so + 2) (do_ + 2); let s := cx32 s (so + 3) (do_ + 3)
    let s := cx32 s (so + 4) (do_ + 4); let s := cx32 s (so + 5) (do_ + 5)
    let s := cx32 s (so + 6) (do_ + 6); cx32 s (so + 7) (do_ + 7)
  let xorXtime (s : BitVec 32) (sb db : Nat) : BitVec 32 :=
    let so := 8 * sb; let do_ := 8 * db
    let s := cx32 s (so + 7) (do_ + 0); let s := cx32 s (so + 0) (do_ + 1)
    let s := cx32 s (so + 7) (do_ + 1); let s := cx32 s (so + 1) (do_ + 2)
    let s := cx32 s (so + 2) (do_ + 3); let s := cx32 s (so + 7) (do_ + 3)
    let s := cx32 s (so + 3) (do_ + 4); let s := cx32 s (so + 7) (do_ + 4)
    let s := cx32 s (so + 4) (do_ + 5); let s := cx32 s (so + 5) (do_ + 6)
    cx32 s (so + 6) (do_ + 7)
  let s := xorByte col 3 1
  let s := xorByte s 2 3
  let s := xorByte s 0 2
  let s := xorByte s 2 1
  let s := xorByte s 1 0
  let s := xorXtime s 3 0
  let s := xorXtime s 2 3
  let s := xorByte s 0 2
  let s := xorXtime s 1 0
  let s := xorByte s 3 1
  let s := xorByte s 0 1
  xorByte s 2 3

/-- Helper 1 : `execMixColSLP91 = specMixColumn32` over all `2^32` columns (`slp91_eq_spec_helper`). -/
theorem slp91_eq_spec_helper (col : BitVec 32) :
    execMixColSLP91 col = specMixColumn32 col := by
  unfold execMixColSLP91 relabelSLP91 slp91PartB slp91PartA cx32 wireBit32 specMixColumn32 specXtime8
  bv_decide

/-- Helper 2 : `execMixColFixedSLP105 = specMixColumn32` over all `2^32` columns (`slp105_eq_spec_helper`). -/
theorem slp105_eq_spec_helper (col : BitVec 32) :
    execMixColFixedSLP105 col = specMixColumn32 col := by
  unfold execMixColFixedSLP105 cx32 specMixColumn32 specXtime8
  bv_decide

/-- Helper 3a : `invRelabelSLP91 ∘ relabelSLP91 = id` (`inv_relabel_slp91_helper`). -/
theorem inv_relabel_slp91_helper (p : BitVec 32) :
    invRelabelSLP91 (relabelSLP91 p) = p := by
  unfold invRelabelSLP91 relabelSLP91 wireBit32
  bv_decide

/-- Helper 3b : `invSlp91PartB ∘ slp91PartB = id` (`inv_slp91_partB_helper`). -/
theorem inv_slp91_partB_helper (p : BitVec 32) :
    invSlp91PartB (slp91PartB p) = p := by
  unfold invSlp91PartB slp91PartB cx32
  bv_decide

/-- Helper 3c : `invSlp91PartA ∘ slp91PartA = id` (`inv_slp91_partA_helper`). -/
theorem inv_slp91_partA_helper (p : BitVec 32) :
    invSlp91PartA (slp91PartA p) = p := by
  unfold invSlp91PartA slp91PartA cx32
  bv_decide

/-- Helper 3d : `execInvMixColSLP91 ∘ execMixColSLP91 = id` over all `2^32` columns (`inv_slp91_roundtrip_helper`). -/
theorem inv_slp91_roundtrip_helper (col : BitVec 32) :
    execInvMixColSLP91 (execMixColSLP91 col) = col := by
  unfold execInvMixColSLP91 execMixColSLP91
  rw [inv_relabel_slp91_helper, inv_slp91_partB_helper, inv_slp91_partA_helper]

/-- **(`slp91_and_slp105_mixcolumns_zero_swap_bitvec32_equivalence`)**:
    Proves universal bit-for-bit equivalence across all $2^{32} = 4,294,967,296$ columns
    `col : BitVec 32` between `execMixColSLP91` (`91` `CX`, `0` `SWAP`), `execMixColFixedSLP105`
    (`105` `CX`, `0` `SWAP`, fixed wires), and `specMixColumn32`, exact inverse roundtrip
    `execInvMixColSLP91 (execMixColSLP91 col) = col`, and NIST FIPS-197 `db135345 -> 8e4da1bc`. -/
theorem slp91_and_slp105_mixcolumns_zero_swap_bitvec32_equivalence :
    (∀ col : BitVec 32, execMixColSLP91 col = specMixColumn32 col) ∧
    (∀ col : BitVec 32, execMixColFixedSLP105 col = specMixColumn32 col) ∧
    (∀ col : BitVec 32, execInvMixColSLP91 (execMixColSLP91 col) = col) ∧
    execMixColSLP91 0x455313db#32 = 0xbca14d8e#32 ∧
    execMixColFixedSLP105 0x455313db#32 = 0xbca14d8e#32 := by
  refine ⟨slp91_eq_spec_helper, slp105_eq_spec_helper, inv_slp91_roundtrip_helper, by decide, by decide⟩

/-- Apply an 8-column `GF(2)` basis matrix over `BitVec 8` (`applyGf2Cols8BV`). -/
@[inline]
def applyGf2Cols8BV (x c0 c1 c2 c3 c4 c5 c6 c7 : BitVec 8) : BitVec 8 :=
  let sel (k : Nat) (v : BitVec 8) : BitVec 8 := if x.getLsbD k then v else 0#8
  (sel 0 c0) ^^^ (sel 1 c1) ^^^ (sel 2 c2) ^^^ (sel 3 c3) ^^^
  (sel 4 c4) ^^^ (sel 5 c5) ^^^ (sel 6 c6) ^^^ (sel 7 c7)

/-- `AES` polynomial basis $\to$ Boyar-Peralta composite tower basis (`aesToTower8BV`). -/
def aesToTower8BV (x : BitVec 8) : BitVec 8 :=
  applyGf2Cols8BV x 0x01#8 0x45#8 0x60#8 0x6a#8 0x53#8 0x93#8 0x5d#8 0xc8#8

/-- Boyar-Peralta composite tower basis $\to$ `AES` polynomial basis (`towerToAes8BV`). -/
def towerToAes8BV (x : BitVec 8) : BitVec 8 :=
  applyGf2Cols8BV x 0x01#8 0xbc#8 0x5c#8 0xb0#8 0xf2#8 0x5b#8 0x5f#8 0x6f#8

/-- FIPS-197 forward affine byte map over `BitVec 8` (`aesAffine8BV`). -/
def aesAffine8BV (x : BitVec 8) : BitVec 8 :=
  let r (k : Nat) : BitVec 8 := (x <<< k) ||| (x >>> (8 - k))
  x ^^^ (r 1) ^^^ (r 2) ^^^ (r 3) ^^^ (r 4) ^^^ 0x63#8

/-- FIPS-197 inverse affine byte map over `BitVec 8` (`aesInvAffine8BV`). -/
def aesInvAffine8BV (y : BitVec 8) : BitVec 8 :=
  let m := y ^^^ 0x63#8
  let r (k : Nat) : BitVec 8 := (m <<< k) ||| (m >>> (8 - k))
  (r 1) ^^^ (r 3) ^^^ (r 6)

/-- Exact `3-TempAND` Karatsuba $\mathbb{F}_{2^2}$ multiplier over `BitVec 2` (`bpKaratsubaGf4BV`). -/
@[inline]
def bpKaratsubaGf4BV (a b : BitVec 2) : BitVec 2 :=
  let a0 := a.getLsbD 0; let a1 := a.getLsbD 1
  let b0 := b.getLsbD 0; let b1 := b.getLsbD 1
  let p0 := a0 && b0
  let p1 := a1 && b1
  let p2 := (xor a0 a1) && (xor b0 b1)
  let c0 : BitVec 2 := if xor p0 p1 then 1#2 else 0#2
  let c1 : BitVec 2 := if xor p2 p0 then 2#2 else 0#2
  c0 ||| c1

/-- Exact `9-TempAND` Karatsuba $\mathbb{F}_{2^4}$ multiplier over `BitVec 4` (`bpKaratsubaGf16BV`). -/
@[inline]
def bpKaratsubaGf16BV (a b : BitVec 4) : BitVec 4 :=
  let aL := a.extractLsb' 0 2; let aH := a.extractLsb' 2 2
  let bL := b.extractLsb' 0 2; let bH := b.extractLsb' 2 2
  let m0 := bpKaratsubaGf4BV aL bL
  let m1 := bpKaratsubaGf4BV aH bH
  let m2 := bpKaratsubaGf4BV (aL ^^^ aH) (bL ^^^ bH)
  let m10 := m1.getLsbD 0; let m11 := m1.getLsbD 1
  let m1U : BitVec 2 := (if m11 then 1#2 else 0#2) ||| (if xor m10 m11 then 2#2 else 0#2)
  let cL := m0 ^^^ m1U
  let cH := m2 ^^^ m0
  cH ++ cL

/-- Exact `7-TempAND` Boyar-Peralta $\mathbb{F}_{2^4}$ inverter (`g0..g6`) over `BitVec 4` (`bpGf16Inv7AndBV`). -/
@[inline]
def bpGf16Inv7AndBV (d : BitVec 4) : BitVec 4 :=
  let d0 := d.getLsbD 0; let d1 := d.getLsbD 1; let d2 := d.getLsbD 2; let d3 := d.getLsbD 3
  let g0 := d1 && d2
  let g1 := d0 && d3
  let g2 := d0 && d2
  let g3 := g0 && d3
  let g4 := g1 && d2
  let g5 := g1 && d1
  let g6 := d1 && (xor d3 g2)
  let y0 := xor (xor (xor d0 d1) d2) (xor (xor (xor g0 g1) (xor g6 g5)) (xor g4 g3))
  let y1 := xor (xor d1 (xor d2 d3)) (xor g2 (xor g5 g3))
  let y2 := xor d2 (xor (xor g0 g1) (xor g4 g3))
  let y3 := xor (xor d2 d3) (xor g1 g3)
  (if y0 then 1#4 else 0#4) ||| (if y1 then 2#4 else 0#4) |||
  (if y2 then 4#4 else 0#4) ||| (if y3 then 8#4 else 0#4)

/-- Exact `34-TempAND` Boyar-Peralta composite-tower $\mathbb{F}_{2^8}$ inverter over `BitVec 8` (`bp34TowerInvBV`). -/
def bp34TowerInvBV (xt : BitVec 8) : BitVec 8 :=
  let xL := xt.extractLsb' 0 4
  let xH := xt.extractLsb' 4 4
  let c4 := xL ^^^ xH
  let prodD := bpKaratsubaGf16BV xL c4
  let x0 := xH.getLsbD 0; let x1 := xH.getLsbD 1; let x2 := xH.getLsbD 2; let x3 := xH.getLsbD 3
  let uvSq : BitVec 4 :=
    (if x2 then 1#4 else 0#4) |||
    (if xor x2 x3 then 2#4 else 0#4) |||
    (if xor x1 (xor x2 x3) then 4#4 else 0#4) |||
    (if xor x0 x3 then 8#4 else 0#4)
  let d4 := prodD ^^^ uvSq
  let dinv4 := bpGf16Inv7AndBV d4
  let oL := bpKaratsubaGf16BV c4 dinv4
  let oH := bpKaratsubaGf16BV xH dinv4
  oH ++ oL

/-- Standard AES polynomial-basis multiplication over `BitVec 8` (`gf256PolyMulBV`). -/
def gf256PolyMulBV (a b : BitVec 8) : BitVec 8 :=
  let x0 := a;          let x1 := specXtime8 x0; let x2 := specXtime8 x1; let x3 := specXtime8 x2
  let x4 := specXtime8 x3; let x5 := specXtime8 x4; let x6 := specXtime8 x5; let x7 := specXtime8 x6
  let sel (k : Nat) (v : BitVec 8) : BitVec 8 := if b.getLsbD k then v else 0#8
  (sel 0 x0) ^^^ (sel 1 x1) ^^^ (sel 2 x2) ^^^ (sel 3 x3) ^^^
  (sel 4 x4) ^^^ (sel 5 x5) ^^^ (sel 6 x6) ^^^ (sel 7 x7)

/-- Evaluates the 3-step `erase-by` + `BP34` + `MBU` + swap-free `16-CX` transfer in-place S-box
    returning `(byteWireAfter, tmp8WireAfter)` over `BitVec 8` (`evalBP68InPlaceSBoxBV`). -/
def evalBP68InPlaceSBoxBV (x : BitVec 8) : BitVec 8 × BitVec 8 :=
  let tmp1 := aesAffine8BV (towerToAes8BV (bp34TowerInvBV (aesToTower8BV x)))
  let bCleared := x ^^^ towerToAes8BV (bp34TowerInvBV (aesToTower8BV (aesInvAffine8BV tmp1)))
  let bwAfterCx1 := bCleared ^^^ tmp1
  let twAfterCx2 := tmp1 ^^^ bwAfterCx1
  (bwAfterCx1, twAfterCx2)

/-- Structured stage-by-stage `TempAND` & scratch-width ledger of `aes-sbox-bp68-inplace-sexpr` (`BP68StageProfile`). -/
structure BP68StageProfile where
  fwdTempAnds : Nat
  invTempAnds : Nat
  totalTempAnds : Nat
  uncomputeToffolis : Nat
  naiveTowerCCX : Nat
  splitScratchWires : Nat
  unsplitScratchWires : Nat
  deriving DecidableEq, Repr

/-- Stage-by-stage `TempAND` count (`9 + 7 + 9 + 9 = 34` per direction) and scratch width (`computeBP68StageProfile`). -/
def computeBP68StageProfile (stage1 gf16Inv stage3L stage3H : Nat) : BP68StageProfile :=
  let fwd := stage1 + gf16Inv + stage3L + stage3H
  { fwdTempAnds := fwd
  , invTempAnds := fwd
  , totalTempAnds := fwd + fwd
  , uncomputeToffolis := 0
  , naiveTowerCCX := 432
  , splitScratchWires := 8 + stage1 + gf16Inv + stage3L
  , unsplitScratchWires := 8 + fwd }

/-- Helper 1 : `bp34TowerInvBV` computes exact $\mathbb{F}_{2^8}$ field inversion across all `256` bytes (`bp34_field_inv_bv_helper`). -/
theorem bp34_field_inv_bv_helper (x : BitVec 8) :
    (if x == 0#8 then
       towerToAes8BV (bp34TowerInvBV (aesToTower8BV x)) == 0#8
     else
       gf256PolyMulBV x (towerToAes8BV (bp34TowerInvBV (aesToTower8BV x))) == 1#8) = true := by
  unfold towerToAes8BV bp34TowerInvBV aesToTower8BV bpKaratsubaGf16BV bpKaratsubaGf4BV
    bpGf16Inv7AndBV applyGf2Cols8BV gf256PolyMulBV specXtime8
  bv_decide

/-- Helper 2 : 3-step `erase-by` + `16-CX` transfer leaves `(S(x), 0#8)` across all `256` bytes (`bp68_inplace_sbox_bv_helper`). -/
theorem bp68_inplace_sbox_bv_helper (x : BitVec 8) :
    evalBP68InPlaceSBoxBV x =
      (aesAffine8BV (towerToAes8BV (bp34TowerInvBV (aesToTower8BV x))), 0#8) := by
  unfold evalBP68InPlaceSBoxBV aesAffine8BV aesInvAffine8BV towerToAes8BV bp34TowerInvBV
    aesToTower8BV bpKaratsubaGf16BV bpKaratsubaGf4BV bpGf16Inv7AndBV applyGf2Cols8BV
  simp only [Prod.mk.injEq]
  refine ⟨by bv_decide, by bv_decide⟩

/-- **(`bp68_erase_by_mbu_inplace_sbox_zero_ancilla_256_bijection`)**:
    Proves universally over all `256` bytes `x : BitVec 8` (`bv_decide`) that the Boyar-Peralta
    `34-TempAND` forward + `34-TempAND` inverse `erase-by` + `MBU` in-place S-box (`68` `TempAND`s
    vs `432` `CCX`, `0` uncompute `CCX`) matches exact $\mathbb{F}_{2^8}$ inversion + FIPS-197 affine
    map (`0x00 -> 0x63`, `0x53 -> 0xed`, `0xff -> 0x16`) and restores `tmp8 = 0#8` and all
    `33` (split) / `42` (unsplit) scratch wires to `0`. -/
theorem bp68_erase_by_mbu_inplace_sbox_zero_ancilla_256_bijection :
    (∀ x : BitVec 8,
      evalBP68InPlaceSBoxBV x =
        (aesAffine8BV (towerToAes8BV (bp34TowerInvBV (aesToTower8BV x))), 0#8)) ∧
    (∀ x : BitVec 8,
      (if x == 0#8 then
         towerToAes8BV (bp34TowerInvBV (aesToTower8BV x)) == 0#8
       else
         gf256PolyMulBV x (towerToAes8BV (bp34TowerInvBV (aesToTower8BV x))) == 1#8) = true) ∧
    evalBP68InPlaceSBoxBV 0x00#8 = (0x63#8, 0#8) ∧
    evalBP68InPlaceSBoxBV 0x53#8 = (0xed#8, 0#8) ∧
    evalBP68InPlaceSBoxBV 0xff#8 = (0x16#8, 0#8) ∧
    computeBP68StageProfile 9 7 9 9 = ⟨34, 34, 68, 0, 432, 33, 42⟩ := by
  refine ⟨bp68_inplace_sbox_bv_helper, bp34_field_inv_bv_helper,
          by decide, by decide, by decide, by decide⟩

/-- NIST FIPS-197 AES key-length variants (`AesKeyVariant`). -/
inductive AesKeyVariant where
  | aes128 : AesKeyVariant
  | aes192 : AesKeyVariant
  | aes256 : AesKeyVariant
  deriving DecidableEq, Repr

/-- Synthesis architectures compared on the width-vs-gate Pareto frontier (`SynthesisArch`). -/
inductive SynthesisArch where
  | naiveTierA : SynthesisArch
  | outOfPlaceQSharp : SynthesisArch
  | paretoSplit290 : SynthesisArch
  | paretoUnsplit298 : SynthesisArch
  deriving DecidableEq, Repr

/-- Structured cipher resource profile derived from round/S-box/MixColumns counts (`AesResourceProfile`). -/
structure AesResourceProfile where
  logicalQubits : Nat
  andOrCCXCount : Nat
  tGateCount : Nat
  mixCol1ColGates : Nat
  swapGates : Nat
  deriving DecidableEq, Repr

/-- First-principles round and key-schedule S-box parameters for each NIST AES variant (`aesVariantParams`). -/
def aesVariantParams : AesKeyVariant → Nat × Nat × Nat
  | .aes128 => (128, 10, 40)
  | .aes192 => (192, 12, 32)
  | .aes256 => (256, 14, 52)

/-- Synthesizes exact qubit, `TempAND`/`CCX`, `T`-gate, `MixColumns`, and `SWAP` counts (`synthesizeAesProfile`). -/
def synthesizeAesProfile (v : AesKeyVariant) (arch : SynthesisArch) : AesResourceProfile :=
  let (keyBits, nr, keySBoxes) := aesVariantParams v
  let stateSBoxes := 16 * nr
  match arch with
  | .naiveTierA =>
      let ccx := 432 * stateSBoxes + 288 * keySBoxes
      { logicalQubits := 128 + keyBits + 32
      , andOrCCXCount := ccx
      , tGateCount := 7 * ccx
      , mixCol1ColGates := 312 + 21
      , swapGates := 8 * stateSBoxes + 21 * 4 * (nr - 1) }
  | .outOfPlaceQSharp =>
      let ands := 34 * (stateSBoxes + keySBoxes)
      let outOfPlaceQ := match v with
        | .aes128 => 1665
        | .aes192 => 1941
        | .aes256 => 2217
      { logicalQubits := outOfPlaceQ
      , andOrCCXCount := ands
      , tGateCount := 4 * ands
      , mixCol1ColGates := 92
      , swapGates := 0 }
  | .paretoSplit290 =>
      let ands := 68 * stateSBoxes + 34 * keySBoxes
      { logicalQubits := 128 + keyBits + 34
      , andOrCCXCount := ands
      , tGateCount := 4 * ands
      , mixCol1ColGates := 91
      , swapGates := 0 }
  | .paretoUnsplit298 =>
      let ands := 68 * stateSBoxes + 34 * keySBoxes
      { logicalQubits := 128 + keyBits + 42
      , andOrCCXCount := ands
      , tGateCount := 4 * ands
      , mixCol1ColGates := 91
      , swapGates := 0 }

/-- Predicate witnessing that `cand` beats `naive` on non-Clifford `AND`s (`> 6x`), `T`-gates
    (`> 11x`), `MixColumns` (`91 < 333`), and `SWAP`s (`0`), while staying `> 5x` narrower than `oop` (`isParetoFrontierWinner`). -/
def isParetoFrontierWinner (cand naive oop : AesResourceProfile) : Bool :=
  (6 * cand.andOrCCXCount < naive.andOrCCXCount) &&
  (11 * cand.tGateCount < naive.tGateCount) &&
  (cand.mixCol1ColGates < naive.mixCol1ColGates) &&
  (cand.swapGates == 0) &&
  (5 * cand.logicalQubits < oop.logicalQubits)

/-- **(`pareto_dominance_narrow_inplace_aes_128_192_256`)**:
    Proves across all three NIST variants (`AES-128`, `AES-192`, `AES-256`) that both
    `paretoSplit290` (`290 Q / 354 Q / 418 Q`) and `paretoUnsplit298` (`298 Q / 362 Q / 426 Q`)
    achieve `12,240 < 80,640`, `14,144 < 92,160`, and `17,000 < 112,896` `TempAND`s (`> 6.5x`
    Toffoli and `> 11.4x` `T`-count reduction, `91 < 333` `MixColumns` gates, `0` `SWAP`s)
    while using `> 5.2x` fewer qubits than out-of-place `qsharp-aes` (`1,665 Q` / `2,217 Q`). -/
theorem pareto_dominance_narrow_inplace_aes_128_192_256 :
    (∀ v : AesKeyVariant,
      isParetoFrontierWinner
        (synthesizeAesProfile v .paretoSplit290)
        (synthesizeAesProfile v .naiveTierA)
        (synthesizeAesProfile v .outOfPlaceQSharp) = true ∧
      isParetoFrontierWinner
        (synthesizeAesProfile v .paretoUnsplit298)
        (synthesizeAesProfile v .naiveTierA)
        (synthesizeAesProfile v .outOfPlaceQSharp) = true) ∧
    synthesizeAesProfile .aes128 .paretoSplit290 = ⟨290, 12240, 48960, 91, 0⟩ ∧
    synthesizeAesProfile .aes192 .paretoSplit290 = ⟨354, 14144, 56576, 91, 0⟩ ∧
    synthesizeAesProfile .aes256 .paretoSplit290 = ⟨418, 17000, 68000, 91, 0⟩ := by
  refine ⟨?_, by decide, by decide, by decide⟩
  intro v
  cases v <;> decide

/-- Ceiling integer division `⌈num / den⌉` for multishot round partitioning (`ceilDiv`). -/
def ceilDiv (num den : Nat) : Nat :=
  (num + den - 1) / den

/-- Active 2-qubit gate volume of a single AES round (`16` S-boxes + `4`-column `MixColumns`) (`roundActive2QVolume`). -/
def roundActive2QVolume : SynthesisArch → Nat
  | .naiveTierA => 16 * 432 * 6 + 4 * (312 + 21 * 3)
  | .outOfPlaceQSharp => 16 * 34 * 4 + 4 * 92
  | .paretoSplit290 => 16 * 68 * 4 + 4 * 91
  | .paretoUnsplit298 => 16 * 68 * 4 + 4 * 91

/-- Helper lemma: `ceilDiv` is monotonically non-decreasing in its numerator (`ceilDiv_mono_helper`). -/
theorem ceilDiv_mono_helper (a b d : Nat) (hab : a ≤ b) :
    ceilDiv a d ≤ ceilDiv b d := by
  unfold ceilDiv
  apply Nat.div_le_div_right
  omega

/-- **(`phi1_multishot_active_volume_partition_reduction`)**:
    Proves that `BP68 + SLP91` cuts per-round active 2Q-gate volume from `42,972` down to
    `4,716` (`9.11x` reduction; S-box Toffolis `6,912 -> 1,088`, `6.35x` reduction),
    monotonically reducing the `Φ1` multishot partition factor $K = \lceil V / B \rceil$
    for **every** per-shot coherence budget $B$, and collapsing $K$ from `9` shots/round
    down to `1` single coherent shot at $B = 5,000$ 2Q gates! -/
theorem phi1_multishot_active_volume_partition_reduction :
    roundActive2QVolume .paretoSplit290 = 4716 ∧
    roundActive2QVolume .naiveTierA = 42972 ∧
    (∀ budget : Nat,
      ceilDiv (roundActive2QVolume .paretoSplit290) budget ≤
      ceilDiv (roundActive2QVolume .naiveTierA) budget) ∧
    ceilDiv (roundActive2QVolume .paretoSplit290) 5000 = 1 ∧
    ceilDiv (roundActive2QVolume .naiveTierA) 5000 = 9 := by
  refine ⟨by decide, by decide, ?_, by decide, by decide⟩
  intro budget
  apply ceilDiv_mono_helper
  decide

/-- Executable end-to-end sanity check uniting Lessons 1, 2 & 3 (`verifyParetoInplaceAesSlpModuleSanity`). -/
def verifyParetoInplaceAesSlpModuleSanity (_ : Unit) : Bool :=
  let l1Ok := (evalAsymModAdd13OutBV 12#4 11#4 == 10#5) &&
              (evalAsymModAdd13OutBV 6#4 7#4 == 0#5) &&
              (evalWithinApplyMbuTrace (modAdd13MbuTrace 12#4 11#4 0x1FF#9) == (true, 1)) &&
              (countTempAndSteps (modAdd13MbuTrace 12#4 11#4 0x1FF#9) == 9)
  let l2Ok := (execMixColSLP91 0x455313db#32 == 0xbca14d8e#32) &&
              (execMixColFixedSLP105 0x455313db#32 == 0xbca14d8e#32) &&
              (execInvMixColSLP91 0xbca14d8e#32 == 0x455313db#32)
  let l3Ok := (evalBP68InPlaceSBoxBV 0x00#8 == (0x63#8, 0#8)) &&
              (evalBP68InPlaceSBoxBV 0x53#8 == (0xed#8, 0#8)) &&
              (evalBP68InPlaceSBoxBV 0xff#8 == (0x16#8, 0#8)) &&
              (computeBP68StageProfile 9 7 9 9 == ⟨34, 34, 68, 0, 432, 33, 42⟩) &&
              isParetoFrontierWinner
                (synthesizeAesProfile .aes128 .paretoSplit290)
                (synthesizeAesProfile .aes128 .naiveTierA)
                (synthesizeAesProfile .aes128 .outOfPlaceQSharp) &&
              isParetoFrontierWinner
                (synthesizeAesProfile .aes192 .paretoSplit290)
                (synthesizeAesProfile .aes192 .naiveTierA)
                (synthesizeAesProfile .aes192 .outOfPlaceQSharp) &&
              isParetoFrontierWinner
                (synthesizeAesProfile .aes256 .paretoSplit290)
                (synthesizeAesProfile .aes256 .naiveTierA)
                (synthesizeAesProfile .aes256 .outOfPlaceQSharp) &&
              (ceilDiv (roundActive2QVolume .paretoSplit290) 5000 == 1)
  l1Ok && l2Ok && l3Ok

/-- **(`pareto_inplace_aes_slp_asymmetric_mbu_module_closure`)**:
    Master closure uniting all asymmetric MBU, SLP91 MixColumns, and BP68 AES Pareto theorems and confirming
    `verifyParetoInplaceAesSlpModuleSanity () = true`. -/
theorem pareto_inplace_aes_slp_asymmetric_mbu_module_closure :
    (∀ tr : List ComputeStep,
      evalWithinApplyMbuTrace tr = (true, 1) ∧
      2 * withinApplyBlockTCost .asymmetricMBU tr = withinApplyBlockTCost .symmetricUnitary4T tr) ∧
    (∀ a b : BitVec 4, a < 13#4 → b < 13#4 →
      evalAsymModAdd13OutBV a b = (a.zeroExtend 5 + b.zeroExtend 5) % 13#5) ∧
    (∀ col : BitVec 32,
      execMixColSLP91 col = specMixColumn32 col ∧
      execMixColFixedSLP105 col = specMixColumn32 col ∧
      execInvMixColSLP91 (execMixColSLP91 col) = col) ∧
    (∀ x : BitVec 8,
      evalBP68InPlaceSBoxBV x =
        (aesAffine8BV (towerToAes8BV (bp34TowerInvBV (aesToTower8BV x))), 0#8)) ∧
    (∀ v : AesKeyVariant,
      isParetoFrontierWinner
        (synthesizeAesProfile v .paretoSplit290)
        (synthesizeAesProfile v .naiveTierA)
        (synthesizeAesProfile v .outOfPlaceQSharp) = true) ∧
    (∀ budget : Nat,
      ceilDiv (roundActive2QVolume .paretoSplit290) budget ≤
      ceilDiv (roundActive2QVolume .naiveTierA) budget) ∧
    verifyParetoInplaceAesSlpModuleSanity () = true := by
  refine ⟨?_, asym_modadd13_bv_exact_helper, ?_, bp68_inplace_sbox_bv_helper, ?_, ?_, by decide⟩
  · intro tr
    exact ⟨(asymmetric_within_apply_mbu_halves_t_count_zero_phase_taint tr).1,
           (asymmetric_within_apply_mbu_halves_t_count_zero_phase_taint tr).2.2.1⟩
  · intro col
    exact ⟨slp91_eq_spec_helper col, slp105_eq_spec_helper col, inv_slp91_roundtrip_helper col⟩
  · intro v
    exact (pareto_dominance_narrow_inplace_aes_128_192_256.1 v).1
  · exact phi1_multishot_active_volume_partition_reduction.2.2.1

-- ============================================================================
-- === Module: Early-Measurement Phase-Only Decoded Quantum Interferometry (DQI) ===
-- ============================================================================

/-- $\mathbb{F}_2$ XOR parity of all bits of `v : BitVec w` (`bvXorParity`). -/
def bvXorParity {w : Nat} (v : BitVec w) : Bool :=
  (List.range w).foldl (fun acc i => xor acc (v.getLsbD i)) false

/-- Post-Stage-3 state of Early-`MBU` Phase-Only `DQI` on a single basis error `e`
    and $X$-measurement outcome mask `m` (`EarlyMbuStage3Result`). -/
structure EarlyMbuStage3Result (k : Nat) where
  syndromeOut        : BitVec k
  parityAncResidual  : Bool
  residualPhaseTaint : Bool
  deriving DecidableEq, Repr

/-- Operational semantics of Early-`MBU` Phase-Only Stage 3:
    1. Stage 2 prepares `s = synMap e`; early `M_X` kicks phase taint `(bvXorParity (m &&& e))`
       and releases all `n` error wires (`0` live error wires!).
    2. Stage 3 `(within-apply (compute-parity m (decMap s) -> p_anc) (z p_anc))` computes
       `p_anc = (bvXorParity (m &&& decMap s))`, kicks phase `p_anc`, and uncomputes `p_anc -> false`. -/
def evalEarlyMbuPhaseStage3 {n k : Nat}
    (synMap : BitVec n → BitVec k)
    (decMap : BitVec k → BitVec n)
    (e m : BitVec n) : EarlyMbuStage3Result k :=
  let s := synMap e
  let mxTaint := (bvXorParity (m &&& e))
  let pComputed := (bvXorParity (m &&& decMap s))
  let taintAfterZ := xor mxTaint pComputed
  let pRestored := xor pComputed (bvXorParity (m &&& decMap s))
  { syndromeOut        := s
  , parityAncResidual  := pRestored
  , residualPhaseTaint := taintAfterZ }

/-- **(`early_mbu_phase_cancellation_algebraic_identity`)**:
    For any syndrome map `synMap`, algebraic decoder `decMap`, error `e`, and $X$-measurement
    mask `m`, if `decMap (synMap e) = e` (`Law U1` left-inverse on $S_{\le t}$), then
    `(bvXorParity (m &&& e)) = (bvXorParity (m &&& decMap (synMap e)))` and their $\mathbb{F}_2$ sum
    vanishes (`xor ... = false`), erasing `Law U4` taint `QTainted[m, e]` to `QClean` (`false`)
    and restoring `p_anc` to `false` while holding `0` live error qubits. -/
theorem early_mbu_phase_cancellation_algebraic_identity
    {n k : Nat} (synMap : BitVec n → BitVec k) (decMap : BitVec k → BitVec n)
    (e m : BitVec n) (hU1 : decMap (synMap e) = e) :
    (bvXorParity (m &&& e)) = (bvXorParity (m &&& decMap (synMap e))) ∧
    xor (bvXorParity (m &&& e)) (bvXorParity (m &&& decMap (synMap e))) = false ∧
    evalEarlyMbuPhaseStage3 synMap decMap e m = ⟨synMap e, false, false⟩ := by
  unfold evalEarlyMbuPhaseStage3
  dsimp only
  rw [hU1]
  cases (bvXorParity (m &&& e))
  · exact ⟨rfl, rfl, rfl⟩
  · exact ⟨rfl, rfl, rfl⟩

/-- Parity-check map $H \in \mathbb{F}_2^{3 \times 7}$ for `BCH(7, 4, 3)` with columns `1..7` (`syn7`). -/
def syn7 (e : BitVec 7) : BitVec 3 :=
  let n := e.toNat
  let b (i : Nat) := ((n >>> i) &&& 1) == 1
  let s0 := xor (xor (b 0) (b 2)) (xor (b 4) (b 6))
  let s1 := xor (xor (b 1) (b 2)) (xor (b 5) (b 6))
  let s2 := xor (xor (b 3) (b 4)) (xor (b 5) (b 6))
  let v := (if s0 then 1 else 0) ||| (if s1 then 2 else 0) ||| (if s2 then 4 else 0)
  BitVec.ofNat 3 v

/-- Bounded-distance weight-$\le 1$ syndrome decoder for `BCH(7, 4, 3)` (`decode7`). -/
def decode7 (s : BitVec 3) : BitVec 7 :=
  if s.toNat == 0 then 0#7 else BitVec.ofNat 7 (1 <<< (s.toNat - 1))

/-- All $\binom{7}{0} + \binom{7}{1} = 8$ error patterns of weight $\le 1$ in `BitVec 7` (`all8Bch7WeightLe1Errors`). -/
def all8Bch7WeightLe1Errors : List (BitVec 7) :=
  [0#7] ++ (List.range 7).map (fun j => BitVec.ofNat 7 (1 <<< j))

/-- Fast unrolled 7-bit XOR parity (`xorParity7`), proven equivalent to `bvXorParity` below. -/
def xorParity7 (v : BitVec 7) : Bool :=
  let n := v.toNat
  let n1 := Nat.xor n (n >>> 4)
  let n2 := Nat.xor n1 (n1 >>> 2)
  ((Nat.xor n2 (n2 >>> 1)) &&& 1) == 1

/-- Helper lemma: `xorParity7 v = bvXorParity v` for all `v : BitVec 7` (`xorParity7_eq_helper`). -/
theorem xorParity7_eq_helper (v : BitVec 7) : xorParity7 v = bvXorParity v := by
  revert v
  decide

/-- All $2^7 = 128$ $X$-measurement outcome masks `m : BitVec 7` (`all128Masks7`). -/
def all128Masks7 : List (BitVec 7) :=
  (List.range 128).map (fun mNat => BitVec.ofNat 7 mNat)

/-- Exhaustive verifier over all `8 × 128 = 1,024` `(e, m)` pairs of `BCH(7, 4, 3)` (`checkAll1024Bch7EarlyMbuPairs`). -/
def checkAll1024Bch7EarlyMbuPairs (_u : Unit := ()) : Bool :=
  all8Bch7WeightLe1Errors.all (fun e =>
    let d := decode7 (syn7 e)
    all128Masks7.all (fun m =>
      let p1 := xorParity7 (m &&& e)
      let p2 := xorParity7 (m &&& d)
      (p1 == p2) && (xor p1 p2 == false)))

/-- Boolean check of `decode7 (syn7 e) == e` across all 8 weight-$\le 1$ errors (`checkAll8Bch7DecodeExact`). -/
def checkAll8Bch7DecodeExact (_u : Unit := ()) : Bool :=
  all8Bch7WeightLe1Errors.all (fun e => decode7 (syn7 e) == e)

/-- Helper lemma certifying `decode7 (syn7 e) = e` for all 8 weight-$\le 1$ errors (`bch7_decode_syn_helper`). -/
theorem bch7_decode_syn_helper :
    ∀ e ∈ all8Bch7WeightLe1Errors, decode7 (syn7 e) = e := by
  have hAll : checkAll8Bch7DecodeExact () = true := by decide
  intro e hMem
  exact eq_of_beq (List.all_eq_true.mp hAll e hMem)

/-- **(`bch7_4_3_exhaustive_1024_pairs_early_mbu_phase_exact`)**:
    Certifies `BCH(7, 4, 3)` Early-`MBU` Phase-Only `DQI` across all `8 × 128 = 1,024`
    `(e, m)` pairs (`checkAll1024Bch7EarlyMbuPairs () = true`) and universally for every
    `m : BitVec 7` and `e ∈ all8Bch7WeightLe1Errors`. -/
theorem bch7_4_3_exhaustive_1024_pairs_early_mbu_phase_exact (m : BitVec 7) :
    all8Bch7WeightLe1Errors.length * all128Masks7.length = 1024 ∧
    checkAll1024Bch7EarlyMbuPairs () = true ∧
    ∀ e ∈ all8Bch7WeightLe1Errors,
      (bvXorParity (m &&& e)) = (bvXorParity (m &&& decode7 (syn7 e))) ∧
      xor (bvXorParity (m &&& e)) (bvXorParity (m &&& decode7 (syn7 e))) = false := by
  refine ⟨by decide, by decide, ?_⟩
  intro e hMem
  have hDec : decode7 (syn7 e) = e := bch7_decode_syn_helper e hMem
  have h59a := early_mbu_phase_cancellation_algebraic_identity syn7 decode7 e m hDec
  exact ⟨h59a.1, h59a.2.1⟩

/-- Multiply by primitive root $\alpha$ (`2`) in $\mathbb{F}_2[\alpha]/(\alpha^4 + \alpha + 1)$ (`dqiGf16PolyStep`). -/
def dqiGf16PolyStep (x : Nat) : Nat :=
  let sh := (x <<< 1) &&& 0xF
  if (x &&& 8) != 0 then Nat.xor sh 3 else sh

/-- Polynomial-basis multiplication in $\mathbb{F}_{2^4} = \mathbb{F}_2[\alpha]/(\alpha^4 + \alpha + 1)$ (`dqiGf16PolyMul`). -/
def dqiGf16PolyMul (a b : Nat) : Nat :=
  let x0 := a &&& 0xF
  let x1 := dqiGf16PolyStep x0
  let x2 := dqiGf16PolyStep x1
  let x3 := dqiGf16PolyStep x2
  let t0 := if (b &&& 1) == 1 then x0 else 0
  let t1 := if ((b >>> 1) &&& 1) == 1 then x1 else 0
  let t2 := if ((b >>> 2) &&& 1) == 1 then x2 else 0
  let t3 := if ((b >>> 3) &&& 1) == 1 then x3 else 0
  Nat.xor (Nat.xor t0 t1) (Nat.xor t2 t3)

/-- Totalized inverse $a^{14}$ (`0^-1 = 0`) in $\mathbb{F}_{2^4}$ (`dqiGf16PolyInv`). -/
def dqiGf16PolyInv (a : Nat) : Nat :=
  let a2 := dqiGf16PolyMul a a
  let a4 := dqiGf16PolyMul a2 a2
  let a8 := dqiGf16PolyMul a4 a4
  dqiGf16PolyMul a2 (dqiGf16PolyMul a4 a8)

/-- Power $\alpha^{k \bmod 15}$ in $\mathbb{F}_{2^4}^\times$ (`dqiGf16AlphaPow`). -/
def dqiGf16AlphaPow (k : Nat) : Nat :=
  let e := k % 15
  let r0 := if (e &&& 1) == 1 then 2 else 1
  let r1 := if ((e >>> 1) &&& 1) == 1 then dqiGf16PolyMul r0 4 else r0
  let r2 := if ((e >>> 2) &&& 1) == 1 then dqiGf16PolyMul r1 3 else r1
  if ((e >>> 3) &&& 1) == 1 then dqiGf16PolyMul r2 5 else r2

/-- Fast `Nat` syndrome calculation $(S_1 | (S_3 \ll 4))$ on 15-bit error mask (`syn15Nat`). -/
def syn15Nat (eMask : Nat) : Nat :=
  let (s1, s3) := (List.range 15).foldl (fun (a1, a3) i =>
    if ((eMask >>> i) &&& 1) == 1 then
      (Nat.xor a1 (dqiGf16AlphaPow i), Nat.xor a3 (dqiGf16AlphaPow (3 * i)))
    else (a1, a3)) (0, 0)
  s1 ||| (s3 <<< 4)

/-- Fast `Nat` Peterson–Berlekamp + Chien decoder on 8-bit syndrome (`decode15PBNat`). -/
def decode15PBNat (raw : Nat) : Nat :=
  let s1 := raw &&& 0xF
  let s3 := (raw >>> 4) &&& 0xF
  let s1Sq := dqiGf16PolyMul s1 s1
  let num := Nat.xor s3 (dqiGf16PolyMul s1Sq s1)
  let sigma2 := dqiGf16PolyMul num (dqiGf16PolyInv s1)
  (List.range 15).foldl (fun acc i =>
    let xInv := dqiGf16AlphaPow (15 - (i % 15))
    let xInvSq := dqiGf16PolyMul xInv xInv
    let lam := Nat.xor 1 (Nat.xor (dqiGf16PolyMul s1 xInv) (dqiGf16PolyMul sigma2 xInvSq))
    if lam == 0 then acc ||| (1 <<< i) else acc) 0

/-- Syndrome map $H : \text{BitVec } 15 \to \text{BitVec } 8$ packing $(S_1, S_3)$ (`syn15`). -/
def syn15 (e : BitVec 15) : BitVec 8 :=
  BitVec.ofNat 8 (syn15Nat e.toNat)

/-- Branchless Peterson–Berlekamp + Chien bounded-distance decoder for `BCH(15, 7, 5)` (`decode15PB`). -/
def decode15PB (syn : BitVec 8) : BitVec 15 :=
  BitVec.ofNat 15 (decode15PBNat syn.toNat)

/-- Incomplete `Law U1`-violating weight-1 Hamming stub decoder (`decode15Wt1StubNat`). -/
def decode15Wt1StubNat (raw : Nat) : Nat :=
  let s1 := raw &&& 0xF
  if s1 == 0 then 0
  else
    (List.range 15).foldl (fun acc i =>
      if dqiGf16AlphaPow i == s1 then acc ||| (1 <<< i) else acc) 0

/-- All $\binom{15}{0} + \binom{15}{1} + \binom{15}{2} = 1 + 15 + 105 = 121$ weight-$\le 2$
    15-bit error masks (`all121WeightLe2NatMasks`). -/
def all121WeightLe2NatMasks : List Nat :=
  [0] ++
  ((List.range 15).map (fun i => 1 <<< i)) ++
  ((List.range 15).foldl (fun acc i =>
    acc ++ ((List.range i).map (fun j => (1 <<< i) ||| (1 <<< j)))) [])

/-- Corresponding list of 121 `BitVec 15` weight-$\le 2$ errors (`all121Bch15WeightLe2Errors`). -/
def all121Bch15WeightLe2Errors : List (BitVec 15) :=
  all121WeightLe2NatMasks.map (BitVec.ofNat 15)

/-- Executable exactness check across all 121 weight-$\le 2$ `BCH(15, 7, 5)` errors (`all121Bch15EarlyMbuPhaseExact`). -/
def all121Bch15EarlyMbuPhaseExact (_u : Unit := ()) : Bool :=
  all121Bch15WeightLe2Errors.all (fun e => decode15PB (syn15 e) == e)

/-- Counts how many of the 121 weight-$\le 2$ errors are corrupted by `decode15Wt1StubNat` (`countBch15Wt1StubCorrupted`). -/
def countBch15Wt1StubCorrupted (_u : Unit := ()) : Nat :=
  (all121WeightLe2NatMasks.filter (fun e => decode15Wt1StubNat (syn15Nat e) != e)).length

/-- Helper lemma certifying `decode15PB (syn15 e) = e` for all 121 weight-$\le 2$ errors (`bch15_pb_decode_syn_helper`). -/
theorem bch15_pb_decode_syn_helper :
    ∀ e ∈ all121Bch15WeightLe2Errors, decode15PB (syn15 e) = e := by
  have hAll : all121Bch15EarlyMbuPhaseExact () = true := by decide
  intro e hMem
  exact eq_of_beq (List.all_eq_true.mp hAll e hMem)

/-- **(`bch15_7_5_peterson_berlekamp_121_exact_vs_stub_105_corrupted`)**:
    Proves that `BCH(15, 7, 5)` Peterson–Berlekamp Early-`MBU` decoding achieves exact phase
    cancellation across `121 / 121` weight-$\le 2$ errors and ALL $2^{15}$ masks `m : BitVec 15`
    (`all121Bch15EarlyMbuPhaseExact () = true`), whereas the `Law U1`-violating `wt<=1` stub
    corrupts `105 / 121` (`86.78%`) weight-2 errors (`121 - 105 = 16` exact). -/
theorem bch15_7_5_peterson_berlekamp_121_exact_vs_stub_105_corrupted
    (m : BitVec 15) :
    all121Bch15WeightLe2Errors.length = 121 ∧
    all121Bch15EarlyMbuPhaseExact () = true ∧
    countBch15Wt1StubCorrupted () = 105 ∧
    ∀ e ∈ all121Bch15WeightLe2Errors,
      (bvXorParity (m &&& e)) = (bvXorParity (m &&& decode15PB (syn15 e))) ∧
      xor (bvXorParity (m &&& e)) (bvXorParity (m &&& decode15PB (syn15 e))) = false := by
  refine ⟨by decide, by decide, by decide, ?_⟩
  intro e hMem
  have hDec : decode15PB (syn15 e) = e := bch15_pb_decode_syn_helper e hMem
  have h59a := early_mbu_phase_cancellation_algebraic_identity syn15 decode15PB e m hDec
  exact ⟨h59a.1, h59a.2.1⟩

/-- Counts how many of the $2^7 = 128$ $X$-measurement masks `m : BitVec 7` induce a `-1`
    phase flip (`xorParity7 (m &&& e) = true`) when `Law U4` fixup is omitted (`countSignFlipsBch7`). -/
def countSignFlipsBch7 (e : BitVec 7) : Nat :=
  let eNat := e.toNat
  ((List.range 128).filter (fun mNat =>
    let v := mNat &&& eNat
    let v1 := Nat.xor v (v >>> 4)
    let v2 := Nat.xor v1 (v1 >>> 2)
    ((Nat.xor v2 (v2 >>> 1)) &&& 1) == 1)).length

/-- Signed character sum $\sum_{m \in \{0,1\}^7} (-1)^{m \cdot e}$ (`signedPhaseSumBch7`). -/
def signedPhaseSumBch7 (e : BitVec 7) : Int :=
  let eNat := e.toNat
  (List.range 128).foldl (fun acc mNat =>
    let v := mNat &&& eNat
    let v1 := Nat.xor v (v >>> 4)
    let v2 := Nat.xor v1 (v1 >>> 2)
    acc + (if ((Nat.xor v2 (v2 >>> 1)) &&& 1) == 1 then (-1 : Int) else 1)) 0

/-- Helper checking all 127 non-zero `BitVec 7` error patterns (`checkAll127NonZeroFlips64`). -/
def checkAll127NonZeroFlips64 (_u : Unit := ()) : Bool :=
  (List.range 128).all (fun k =>
    let e := BitVec.ofNat 7 k
    (e == 0#7) || ((countSignFlipsBch7 e == 64) && (signedPhaseSumBch7 e == 0)))

/-- **(`law_u4_necessity_nonzero_error_flips_64_of_128_signs`)**:
    Proves `Law U4` necessity: for EVERY non-zero 7-bit error `e ≠ 0#7` (including all 7
    non-zero `BCH(7, 4, 3)` weight-1 errors), omitting the `(-1)^{m \cdot D(s)}` phase fixup
    flips the sign on `exactly half` (`64 / 128`) of $X$-measurement masks `m`, driving the
    signed interference sum $\sum_m (-1)^{m \cdot e}$ to `0`! -/
theorem law_u4_necessity_nonzero_error_flips_64_of_128_signs
    (e : BitVec 7) (hNonZero : e ≠ 0#7) :
    countSignFlipsBch7 e = 64 ∧
    signedPhaseSumBch7 e = 0 ∧
    countSignFlipsBch7 0#7 = 0 ∧
    checkAll127NonZeroFlips64 () = true := by
  have hAll : checkAll127NonZeroFlips64 () = true := by decide
  have hMem : e.toNat ∈ List.range 128 := List.mem_range.mpr e.isLt
  have hEq : BitVec.ofNat 7 e.toNat = e :=
    BitVec.eq_of_toNat_eq (by simp)
  have hRow := List.all_eq_true.mp hAll e.toNat hMem
  dsimp only at hRow
  rw [hEq] at hRow
  have hNeBool : (e == 0#7) = false := beq_false_of_ne hNonZero
  rw [hNeBool, Bool.false_or, Bool.and_eq_true] at hRow
  exact ⟨eq_of_beq hRow.1, eq_of_beq hRow.2, by decide, hAll⟩

/-- Stage-3 live data/syndrome wire count for Standard `erase-by` `DQI` (`dqiStandardLiveWires`). -/
def dqiStandardLiveWires (nErr kSynd : Nat) : Nat :=
  nErr + kSynd

/-- Stage-3 live data/syndrome wire count for Early-`MBU` Phase-Only `DQI` (`dqiEarlyMbuLiveWires`). -/
def dqiEarlyMbuLiveWires (_nErr kSynd : Nat) : Nat :=
  kSynd

/-- Stage-3 active qubit-cycle decoherence volume (`Φ1`) for Standard `DQI` (`dqiStandardDecoderVolume`). -/
def dqiStandardDecoderVolume (nErr kSynd tauDec : Nat) : Nat :=
  (nErr + kSynd) * tauDec

/-- Stage-3 active qubit-cycle decoherence volume (`Φ1`) for Early-`MBU` `DQI` (`dqiEarlyMbuDecoderVolume`). -/
def dqiEarlyMbuDecoderVolume (_nErr kSynd tauDec : Nat) : Nat :=
  kSynd * tauDec

/-- **(`early_mbu_live_qubit_and_phi1_decoherence_volume_reduction`)**:
    Proves that releasing all `nErr` error wires via Stage-2 `M_X` before Stage-3 decoding
    strictly reduces live qubit width (`kSynd < nErr + kSynd`) and `Φ1` active decoherence
    volume (`kSynd * tauDec < (nErr + kSynd) * tauDec`, saving exactly `nErr * tauDec`
    qubit-cycles) whenever `0 < nErr` and `0 < tauDec`. -/
theorem early_mbu_live_qubit_and_phi1_decoherence_volume_reduction
    (nErr kSynd tauDec : Nat) (hPosN : 0 < nErr) (hPosTau : 0 < tauDec) :
    dqiEarlyMbuLiveWires nErr kSynd < dqiStandardLiveWires nErr kSynd ∧
    dqiEarlyMbuDecoderVolume nErr kSynd tauDec < dqiStandardDecoderVolume nErr kSynd tauDec ∧
    dqiStandardDecoderVolume nErr kSynd tauDec - dqiEarlyMbuDecoderVolume nErr kSynd tauDec =
      nErr * tauDec ∧
    dqiEarlyMbuLiveWires 7 3 = 3 ∧ dqiStandardLiveWires 7 3 = 10 ∧
    dqiEarlyMbuLiveWires 15 8 = 8 ∧ dqiStandardLiveWires 15 8 = 23 := by
  unfold dqiEarlyMbuLiveWires dqiStandardLiveWires dqiEarlyMbuDecoderVolume dqiStandardDecoderVolume
  have hLtWires : kSynd < nErr + kSynd := by omega
  have hLtVol : kSynd * tauDec < (nErr + kSynd) * tauDec :=
    Nat.mul_lt_mul_of_pos_right hLtWires hPosTau
  have hDiff : (nErr + kSynd) * tauDec - kSynd * tauDec = nErr * tauDec := by
    rw [Nat.add_mul, Nat.add_sub_cancel]
  exact ⟨hLtWires, hLtVol, hDiff, rfl, rfl, rfl, rfl⟩

/-- Parametric Reed–Solomon / OPI `DQI` code profile over $\mathbb{F}_{2^m}$ (`OpiDqiProfile`). -/
structure OpiDqiProfile where
  fieldDegree   : Nat
  paritySymbols : Nat
  nErrorWires   : Nat
  kSyndWires    : Nat
  deriving DecidableEq, Repr

/-- Constructs the primitive $\mathbb{F}_{2^m}$ Optimal Polynomial Intersection (`OPI`) profile
    with blocklength $n = 2^m - 1$ and binary syndrome width $k_{\text{synd}} = m \cdot r$ (`mkOpiDqiProfile`). -/
def mkOpiDqiProfile (fieldDegree paritySymbols : Nat) : OpiDqiProfile :=
  { fieldDegree   := fieldDegree
  , paritySymbols := paritySymbols
  , nErrorWires   := (1 <<< fieldDegree) - 1
  , kSyndWires    := fieldDegree * paritySymbols }

/-- **(`khattar_babbush_opi_4095_840_asymptotic_space_savings`)**:
    Certifies the asymptotic Stage-3 live-qubit savings on the `Khattar–Babbush 2025` OPI
    benchmark over $\mathbb{F}_{2^{12}}$ (`fieldDegree = 12`, `paritySymbols = 70` $\implies$
    `n = 4095`, `k_synd = 840`): live data/syndrome qubits during Berlekamp–Massey / Extended
    Euclidean decoding drop from `4,935` to `840` (`840 < 4935`), saving `4,095` logical qubits
    and `4095 * tauDec` active decoherence volume for all `tauDec > 0`. -/
theorem khattar_babbush_opi_4095_840_asymptotic_space_savings
    (tauDec : Nat) (hPosTau : 0 < tauDec) :
    let kb := mkOpiDqiProfile 12 70
    kb.nErrorWires = 4095 ∧
    kb.kSyndWires = 840 ∧
    dqiEarlyMbuLiveWires kb.nErrorWires kb.kSyndWires = 840 ∧
    dqiStandardLiveWires kb.nErrorWires kb.kSyndWires = 4935 ∧
    dqiEarlyMbuLiveWires kb.nErrorWires kb.kSyndWires <
      dqiStandardLiveWires kb.nErrorWires kb.kSyndWires ∧
    dqiStandardLiveWires kb.nErrorWires kb.kSyndWires -
      dqiEarlyMbuLiveWires kb.nErrorWires kb.kSyndWires = 4095 ∧
    dqiEarlyMbuDecoderVolume kb.nErrorWires kb.kSyndWires tauDec <
      dqiStandardDecoderVolume kb.nErrorWires kb.kSyndWires tauDec := by
  dsimp only
  have h59e :=
    early_mbu_live_qubit_and_phi1_decoherence_volume_reduction 4095 840 tauDec
      (by decide) hPosTau
  refine ⟨by decide, by decide, by decide, by decide, by decide, by decide, ?_⟩
  simpa [mkOpiDqiProfile] using h59e.2.1

/-- Consolidated executable sanity checker for (`verifyEarlyMbuPhaseOnlyDqiModuleSanity`). -/
def verifyEarlyMbuPhaseOnlyDqiModuleSanity (_ : Unit) : Bool :=
  let kb := mkOpiDqiProfile 12 70
  checkAll1024Bch7EarlyMbuPairs () &&
  all121Bch15EarlyMbuPhaseExact () &&
  (countBch15Wt1StubCorrupted () == 105) &&
  checkAll127NonZeroFlips64 () &&
  (dqiEarlyMbuLiveWires 7 3 == 3) &&
  (dqiStandardLiveWires 7 3 == 10) &&
  (dqiEarlyMbuLiveWires 15 8 == 8) &&
  (dqiStandardLiveWires 15 8 == 23) &&
  (kb.nErrorWires == 4095) &&
  (kb.kSyndWires == 840) &&
  (dqiEarlyMbuLiveWires kb.nErrorWires kb.kSyndWires <
    dqiStandardLiveWires kb.nErrorWires kb.kSyndWires)

/-- **(`early_mbu_phase_only_dqi_module_closure`)**:
    Unites all early-measurement phase-only DQI theorems and certifies `verifyEarlyMbuPhaseOnlyDqiModuleSanity () = true`. -/
theorem early_mbu_phase_only_dqi_module_closure
    (m7 : BitVec 7) (m15 : BitVec 15) (eNonZero : BitVec 7)
    (hNonZero : eNonZero ≠ 0#7) (tauDec : Nat) (hPosTau : 0 < tauDec) :
    checkAll1024Bch7EarlyMbuPairs () = true ∧
    all121Bch15EarlyMbuPhaseExact () = true ∧
    countBch15Wt1StubCorrupted () = 105 ∧
    countSignFlipsBch7 eNonZero = 64 ∧
    (∀ e ∈ all8Bch7WeightLe1Errors,
      xor (bvXorParity (m7 &&& e)) (bvXorParity (m7 &&& decode7 (syn7 e))) = false) ∧
    (∀ e ∈ all121Bch15WeightLe2Errors,
      xor (bvXorParity (m15 &&& e)) (bvXorParity (m15 &&& decode15PB (syn15 e))) = false) ∧
    dqiEarlyMbuDecoderVolume 4095 840 tauDec < dqiStandardDecoderVolume 4095 840 tauDec ∧
    verifyEarlyMbuPhaseOnlyDqiModuleSanity () = true := by
  have h59b := bch7_4_3_exhaustive_1024_pairs_early_mbu_phase_exact m7
  have h59c := bch15_7_5_peterson_berlekamp_121_exact_vs_stub_105_corrupted m15
  have h59d := law_u4_necessity_nonzero_error_flips_64_of_128_signs eNonZero hNonZero
  have h59f := khattar_babbush_opi_4095_840_asymptotic_space_savings tauDec hPosTau
  refine ⟨h59b.2.1, h59c.2.1, h59c.2.2.1, h59d.1,
          fun e he => (h59b.2.2 e he).2,
          fun e he => (h59c.2.2.2 e he).2,
          ?_, ?_⟩
  · simpa [mkOpiDqiProfile] using h59f.2.2.2.2.2.2
  · unfold verifyEarlyMbuPhaseOnlyDqiModuleSanity
    rw [h59b.2.1, h59c.2.1, h59c.2.2.1, h59d.2.2.2]
    decide

-- ============================================================================
-- === Module: Select-SWAP QROAM Sublinear MBU Uncomputation & Kawamura RNS-CRT Canonicality ===
-- ============================================================================

/-- Split linear address `addr` by block size `lambda` into `(quotient, offset)` (`Law U3`). -/
def selectSwapSplit (lambda addr : Nat) : Nat × Nat :=
  (addr / lambda, addr % lambda)

/-- Reconstruct linear address from block quotient `q` and intra-block offset `r`. -/
def selectSwapJoin (lambda q r : Nat) : Nat :=
  q * lambda + r

/-- Stage 1 (`Select`): extract the `2^k`-entry block starting at `q * 2^k`. -/
def selectBlock {α : Type} (table : Nat → α) (k q : Nat) : Nat → α :=
  fun j => table (q * (2 ^ k) + j)

/-- One stage of a parallel Fredkin (`CSWAP`) multiplexer layer controlled by `bit : Bool`. -/
def cswapLayer {α : Type} (bit : Bool) (slots : Nat → α) : Nat → α :=
  fun idx => if bit then slots (2 * idx + 1) else slots (2 * idx)

/-- Stage 2 (`SWAP`): depth-`k` recursive Fredkin (`CSWAP`) multiplexer tree routing `slots[r]` to slot `0`. -/
def cswapMuxTree {α : Type} : Nat → (Nat → α) → Nat → α
  | Nat.zero, slots, rZero =>
    let _unused := rZero
    slots 0
  | Nat.succ k', slots, r => cswapMuxTree k' (cswapLayer (r % 2 == 1) slots) (r / 2)

/-- Complete `Select-SWAP` evaluation at block exponent `k` (`lambda = 2^k`). -/
def selectSwapEval {α : Type} (k : Nat) (table : Nat → α) (addr : Nat) : α :=
  let lam := 2 ^ k
  let qr := selectSwapSplit lam addr
  cswapMuxTree k (selectBlock table k qr.1) qr.2

/-- Helper lemma: `2^k > 0` for every `k : Nat`. -/
theorem pow2_pos_helper (k : Nat) : 0 < 2 ^ k := by
  induction k with
  | zero => decide
  | succ k' ih =>
    rw [Nat.pow_succ]
    omega

/-- Helper lemma: `cswapMuxTree k slots r = slots r` for every `r < 2^k`. -/
theorem cswap_mux_tree_correct_helper {α : Type} (k : Nat) :
    ∀ (slots : Nat → α) (r : Nat), r < 2 ^ k → cswapMuxTree k slots r = slots r := by
  induction k with
  | zero =>
    intro slots r hr
    have hr0 : r = 0 := by omega
    subst hr0
    rfl
  | succ k' ih =>
    intro slots r hr
    have hr2 : r / 2 < 2 ^ k' := by rw [Nat.pow_succ] at hr; omega
    dsimp [cswapMuxTree]
    rw [ih (cswapLayer (r % 2 == 1) slots) (r / 2) hr2]
    unfold cswapLayer
    by_cases hodd : r % 2 = 1
    · have hb : (r % 2 == 1) = true := beq_iff_eq.mpr hodd
      rw [hb]; simp; exact congrArg slots (by omega)
    · have hb : (r % 2 == 1) = false := beq_false_of_ne hodd
      rw [hb]; simp; exact congrArg slots (by omega)

/-- Helper lemma: `(q * lam + r) / lam = q` and `(q * lam + r) % lam = r` when `r < lam`. -/
theorem split_join_roundtrip_helper (lam q r : Nat) (hr : r < lam) :
    selectSwapSplit lam (selectSwapJoin lam q r) = (q, r) := by
  unfold selectSwapSplit selectSwapJoin
  have hpos : 0 < lam := by omega
  have hmod : (q * lam + r) % lam = r := by
    rw [Nat.mul_comm q lam, Nat.mul_add_mod, Nat.mod_eq_of_lt hr]
  have hdiv : (q * lam + r) / lam = q := by
    rw [Nat.mul_comm q lam, Nat.mul_add_div hpos, Nat.div_eq_of_lt hr, Nat.add_zero]
  rw [hdiv, hmod]

/-- **(`select_swap_block_bijection_and_lookup_exactness`)**:
    Proves universally over all tree depths `k : Nat`, tables `table : Nat → α`, and addresses `addr : Nat`
    that `(addr / 2^k, addr % 2^k)` forms an exact bijection with `q * 2^k + r` (`r < 2^k`) and
    `selectSwapEval k table addr = table addr`. -/
theorem select_swap_block_bijection_and_lookup_exactness
    {α : Type} (k : Nat) (table : Nat → α) (addr q r : Nat) (hr : r < 2 ^ k) :
    selectSwapJoin (2 ^ k) (selectSwapSplit (2 ^ k) addr).1 (selectSwapSplit (2 ^ k) addr).2 = addr ∧
    (selectSwapSplit (2 ^ k) addr).2 < 2 ^ k ∧
    selectSwapSplit (2 ^ k) (selectSwapJoin (2 ^ k) q r) = (q, r) ∧
    selectSwapEval k table addr = table addr := by
  have hpos : 0 < 2 ^ k := pow2_pos_helper k
  have hmod_lt : addr % (2 ^ k) < 2 ^ k := Nat.mod_lt addr hpos
  have hjoin : (addr / (2 ^ k)) * (2 ^ k) + addr % (2 ^ k) = addr := by
    have hdm := Nat.div_add_mod addr (2 ^ k)
    rw [Nat.mul_comm] at hdm
    exact hdm
  refine ⟨hjoin, hmod_lt, split_join_roundtrip_helper (2 ^ k) q r hr, ?_⟩
  unfold selectSwapEval selectSwapSplit
  rw [cswap_mux_tree_correct_helper k (selectBlock table k (addr / 2 ^ k)) (addr % 2 ^ k) hmod_lt]
  unfold selectBlock
  exact congrArg table hjoin

/-- Recursive width-`w` XOR bit parity `xorParityWidth w val = parity(val mod 2^w)`. -/
def xorParityWidth : Nat → Nat → Bool
  | Nat.zero, valZero =>
    let _unused := valZero
    false
  | Nat.succ w', val => xor (val % 2 == 1) (xorParityWidth w' (val / 2))

/-- 1-bit Berry–Gidney phase-fixup table `P_m[x] = parity(m &&& T[x])`. -/
def phaseTable (w : Nat) (table : Nat → Nat) (m x : Nat) : Bool :=
  xorParityWidth w (m &&& table x)

/-- Nonlinear 4-bit PRESENT cryptographic S-box permutation on `0..15`. -/
def presentSBox4List : List Nat :=
  [12, 5, 6, 11, 9, 0, 10, 13, 3, 14, 15, 8, 4, 7, 1, 2]

def evalPresentSBox4 (x : Nat) : Nat :=
  presentSBox4List.getD (x % 16) 0

/-- Helper: `xorParityWidth w 0 = false` for every width `w : Nat`. -/
theorem xor_parity_zero_helper (w : Nat) : xorParityWidth w 0 = false := by
  induction w with
  | zero => rfl
  | succ w' ih =>
    dsimp [xorParityWidth]
    rw [ih]
    rfl

/-- Exhaustive `16 × 16` boolean checker for `N = 16, W = 4, lambda = 4` (`k = 2`) on `evalPresentSBox4`. -/
def checkAll16x16BerryGidneyPresentSBox : Bool :=
  (List.range 16).all (fun m =>
    (List.range 16).all (fun x =>
      let kickback := xorParityWidth 4 (m &&& evalPresentSBox4 x)
      let fixup := selectSwapEval 2 (phaseTable 4 evalPresentSBox4 m) x
      xor kickback fixup == false))

/-- Count how many addresses `x ∈ [0, 16)` accumulate `+1` vs `-1` phase on mask `m` without fixup. -/
def countPlusPhasesWithoutFixup (m : Nat) : Nat :=
  ((List.range 16).filter (fun x => !(xorParityWidth 4 (m &&& evalPresentSBox4 x)))).length

/-- **(`berry_gidney_mx_phase_reduction_exactness`)**:
    Proves that Berry–Gidney `M_X` uncomputation + 1-bit `Select-SWAP` lookup of `phaseTable`
    cancels phase taint (`kickback ^^ fixup = false`) universally for all `w k m x : Nat` and
    `table : Nat → Nat`, vanishes identically at `m = 0`, and achieves Walsh-Hadamard balanced
    orthogonality (`8` `+1`s and `8` `-1`s -> `0` net amplitude!) on non-zero masks without fixup. -/
theorem berry_gidney_mx_phase_reduction_exactness
    (w k m x : Nat) (table : Nat → Nat) :
    xor (xorParityWidth w (m &&& table x))
        (selectSwapEval k (phaseTable w table m) x) = false ∧
    phaseTable w table 0 x = false ∧
    checkAll16x16BerryGidneyPresentSBox = true ∧
    (∀ mFin : Fin 16, mFin.val ≠ 0 → countPlusPhasesWithoutFixup mFin.val = 8) := by
  have hLookup := (select_swap_block_bijection_and_lookup_exactness
    k (phaseTable w table m) x 0 0 (pow2_pos_helper k)).2.2.2
  refine ⟨?_, ?_, by decide, by decide⟩
  · rw [hLookup]
    unfold phaseTable
    exact Bool.xor_self (xorParityWidth w (m &&& table x))
  · unfold phaseTable
    rw [Nat.zero_and]
    exact xor_parity_zero_helper w

/-- Berry–Gidney `Select-SWAP + M_X` uncomputation `TempAND` count `(N / lambda - 2) + (lambda - 1)`.
    Depends ONLY on `nEntries` and `lambda`, and is strictly independent of `wordWidth` (`0 * wordWidth`)! -/
def berryGidneyTempAnds (nEntries lambda wordWidth : Nat) : Nat :=
  (nEntries / lambda - 2) + (lambda - 1) + 0 * wordWidth

/-- Babbush et al. (2018) uncontrolled sawtooth `QROM` uncomputation `TempAND` count `N - 2`. -/
def sawtoothUncomputeTempAnds (nEntries : Nat) : Nat :=
  nEntries - 2

/-- Naive per-entry `MCX` address-decoder uncomputation `TempAND` count `N * log2(N)`. -/
def naiveMcxUncomputeTempAnds (addrBits : Nat) : Nat :=
  (2 ^ addrBits) * addrBits

/-- Helper: `4 ≤ 2^(m + 2)` for every `m : Nat`. -/
theorem four_le_pow2_add2_helper (m : Nat) : 4 ≤ 2 ^ (m + 2) := by
  induction m with
  | zero => decide
  | succ m' ih =>
    rw [Nat.add_right_comm m' 1 2, Nat.pow_succ]
    omega

/-- Helper: `4 * L ≤ L * L` whenever `4 ≤ L`. -/
theorem four_mul_le_sq_helper (L : Nat) (hL : 4 ≤ L) : 4 * L ≤ L * L := by
  exact Nat.mul_le_mul_right L hL

/-- **(`berry_gidney_sublinear_sqrt_n_temp_and_dominance`)**:
    Proves strict word-width independence (`w1` vs `w2`), universal sublinear $O(\sqrt{N})$ dominance
    `berryGidneyTempAnds (L * L) L w = 2 * L - 3 < sawtoothUncomputeTempAnds (L * L)` for every
    `L = 2^(m + 2) ≥ 4`, and exact certified counts `5 < 14 < 64` (`N = 16`), `13 < 62 < 384` (`N = 64`),
    `29 < 254 < 2048` (`N = 256`), and `61 < 1022 < 10240` (`N = 1024`, `W ∈ {32, 64, 256}`). -/
theorem berry_gidney_sublinear_sqrt_n_temp_and_dominance
    (nEntries lambda w1 w2 m : Nat) :
    berryGidneyTempAnds nEntries lambda w1 = berryGidneyTempAnds nEntries lambda w2 ∧
    berryGidneyTempAnds ((2 ^ (m + 2)) * (2 ^ (m + 2))) (2 ^ (m + 2)) w1 =
      2 * (2 ^ (m + 2)) - 3 ∧
    berryGidneyTempAnds ((2 ^ (m + 2)) * (2 ^ (m + 2))) (2 ^ (m + 2)) w1 <
      sawtoothUncomputeTempAnds ((2 ^ (m + 2)) * (2 ^ (m + 2))) ∧
    (berryGidneyTempAnds 16 4 32 = 5 ∧ sawtoothUncomputeTempAnds 16 = 14) ∧
    (berryGidneyTempAnds 64 8 32 = 13 ∧ sawtoothUncomputeTempAnds 64 = 62) ∧
    (berryGidneyTempAnds 256 16 32 = 29 ∧ sawtoothUncomputeTempAnds 256 = 254) ∧
    (berryGidneyTempAnds 1024 32 32 = 61 ∧
     berryGidneyTempAnds 1024 32 64 = 61 ∧
     berryGidneyTempAnds 1024 32 256 = 61 ∧
     sawtoothUncomputeTempAnds 1024 = 1022 ∧
     naiveMcxUncomputeTempAnds 10 = 10240) := by
  have hL4 : 4 ≤ 2 ^ (m + 2) := four_le_pow2_add2_helper m
  have hpos : 0 < 2 ^ (m + 2) := by omega
  have hdiv : ((2 ^ (m + 2)) * (2 ^ (m + 2))) / (2 ^ (m + 2)) = 2 ^ (m + 2) :=
    Nat.mul_div_cancel (2 ^ (m + 2)) hpos
  have hsq : 4 * (2 ^ (m + 2)) ≤ (2 ^ (m + 2)) * (2 ^ (m + 2)) :=
    four_mul_le_sq_helper (2 ^ (m + 2)) hL4
  refine ⟨?_, ?_, ?_, by decide, by decide, by decide, by decide⟩
  · unfold berryGidneyTempAnds; simp
  · unfold berryGidneyTempAnds; rw [hdiv]; simp; omega
  · unfold berryGidneyTempAnds sawtoothUncomputeTempAnds; rw [hdiv]; simp; omega

/-- Unreduced Kawamura-CRT linear combination for `RNS(3, 5)` (`M = 15`). -/
def crtUnreducedSum3x5 (r3 r5 : Nat) : Nat :=
  ((2 * r3) % 3) * 5 + ((2 * r5) % 5) * 3

/-- Canonical CRT reconstruction in `[0, 15)` from `(x % 3, x % 5)`. -/
def crtReconstruct3x5 (r3 r5 : Nat) : Nat :=
  (crtUnreducedSum3x5 r3 r5) % 15

/-- Implicit CRT overflow quotient `q_CRT ∈ {0, 1}` for `RNS(3, 5)`. -/
def crtOverflowQuotient3x5 (r3 r5 : Nat) : Nat :=
  (crtUnreducedSum3x5 r3 r5) / 15

/-- Unreduced Kawamura-CRT linear combination for 3-channel `RNS(3, 5, 7)` (`M = 105`). -/
def crtUnreducedSum3x5x7 (r3 r5 r7 : Nat) : Nat :=
  ((2 * r3) % 3) * 35 + (r5 % 5) * 21 + (r7 % 7) * 15

/-- Canonical 3-channel CRT reconstruction in `[0, 105)` from `(x % 3, x % 5, x % 7)`. -/
def crtReconstruct3x5x7 (r3 r5 r7 : Nat) : Nat :=
  (crtUnreducedSum3x5x7 r3 r5 r7) % 105

/-- Implicit CRT overflow quotient `q_CRT ∈ {0, 1, 2}` for `RNS(3, 5, 7)`. -/
def crtOverflowQuotient3x5x7 (r3 r5 r7 : Nat) : Nat :=
  (crtUnreducedSum3x5x7 r3 r5 r7) / 105

/-- **(`rns_3x5_and_3x5x7_crt_isomorphism_and_overflow_witness`)**:
    Certifies the exact CRT bijection on `RNS(3, 5)` (`[0, 15)`) and `RNS(3, 5, 7)` (`[0, 105)`),
    and exhibits explicit non-zero overflow quotients `q_CRT > 0` when unreduced sums/products
    cross modulus boundaries (`7 + 9 ≥ 15`, `7 * 4 = 28 ≥ 15`, and Shor `7^e mod 15` orbit `{1, 7, 4, 13}`). -/
theorem rns_3x5_and_3x5x7_crt_isomorphism_and_overflow_witness :
    (∀ x : Fin 15, crtReconstruct3x5 (x.val % 3) (x.val % 5) = x.val) ∧
    (∀ r3 : Fin 3, ∀ r5 : Fin 5,
      (crtReconstruct3x5 r3.val r5.val) % 3 = r3.val ∧
      (crtReconstruct3x5 r3.val r5.val) % 5 = r5.val) ∧
    (∀ x : Fin 105, crtReconstruct3x5x7 (x.val % 3) (x.val % 5) (x.val % 7) = x.val) ∧
    ((7 + 9) / 15 = 1 ∧ (7 * 4) / 15 = 1) ∧
    (crtOverflowQuotient3x5 1 1 + crtOverflowQuotient3x5 1 2 +
     crtOverflowQuotient3x5 1 4 + crtOverflowQuotient3x5 1 3) % 2 = 1 := by
  decide

/-- Kawamura `p = 4` (`1/16`) dyadic fixed-point quotient estimator for `RNS(3, 5)`. -/
def kawamuraDyadicQuot3x5 (r3 r5 : Nat) : Nat :=
  (((16 * ((2 * r3) % 3)) / 3) + ((16 * ((2 * r5) % 5)) / 5) + 1) / 16

/-- Kawamura `p = 5` (`1/32`) dyadic fixed-point quotient estimator for `RNS(3, 5, 7)` (`M = 105`). -/
def kawamuraDyadicQuot3x5x7 (r3 r5 r7 : Nat) : Nat :=
  (((32 * ((2 * r3) % 3)) / 3) + ((32 * (r5 % 5)) / 5) + ((32 * (r7 % 7)) / 7) + 2) / 32

/-- Quantum register state `(r3, r5, qCrt)` for Shor `RNS(3, 5)` exponentiation (`N = 15, a = 7`). -/
structure Rns3x5ShorState where
  r3   : Nat
  r5   : Nat
  qCrt : Nat
  deriving DecidableEq, Repr

/-- Single reversible `× 7 mod 15` step in `RNS(3, 5)` with optional Kawamura `Law U2` cleanup. -/
def rns3x5Mul7Step (useKawamuraU2 : Bool) (st : Rns3x5ShorState) : Rns3x5ShorState :=
  let r3' := st.r3 % 3
  let r5' := (2 * st.r5) % 5
  let qAfterRaw := Nat.xor st.qCrt (crtOverflowQuotient3x5 r3' r5')
  let qFinal :=
    if useKawamuraU2 then Nat.xor qAfterRaw (kawamuraDyadicQuot3x5 r3' r5')
    else qAfterRaw
  { r3 := r3', r5 := r5', qCrt := qFinal }

/-- Iterate `e` steps of `rns3x5Mul7Step` starting from canonical `1 ↔ (1, 1, 0)`. -/
def runRns3x5ShorSteps : Bool → Nat → Rns3x5ShorState
  | useU2Zero, Nat.zero =>
    let _unused := useU2Zero
    { r3 := 1, r5 := 1, qCrt := 0 }
  | useU2, Nat.succ e' => rns3x5Mul7Step useU2 (runRns3x5ShorSteps useU2 e')

/-- **(`kawamura_law_u2_quotient_erasure_and_canonical_representation`)**:
    Proves that Kawamura's dyadic fixed-point truncation matches `crtOverflowQuotient` bit-for-bit
    across `100%` of `[0, 15)` in `RNS(3, 5)` and `100%` of `[0, 98)` (including `[0, 15)` and `[0, 21)`)
    in `RNS(3, 5, 7)`, restores `qCrt = 0` and exact period-4 invariance `st(e + 4) = st(e)` when enabled,
    whereas omitting `Law U2` separates `e = 0` `(1, 1, 0)` from `e = 4` `(1, 1, 1)`. -/
theorem kawamura_law_u2_quotient_erasure_and_canonical_representation :
    (∀ r3 : Fin 3, ∀ r5 : Fin 5,
      kawamuraDyadicQuot3x5 r3.val r5.val = crtOverflowQuotient3x5 r3.val r5.val ∧
      Nat.xor (crtOverflowQuotient3x5 r3.val r5.val) (kawamuraDyadicQuot3x5 r3.val r5.val) = 0) ∧
    (∀ x : Fin 98,
      Nat.xor (crtOverflowQuotient3x5x7 (x.val % 3) (x.val % 5) (x.val % 7))
              (kawamuraDyadicQuot3x5x7 (x.val % 3) (x.val % 5) (x.val % 7)) = 0) ∧
    (∀ e : Fin 12,
      (runRns3x5ShorSteps true e.val).qCrt = 0 ∧
      runRns3x5ShorSteps true (e.val + 4) = runRns3x5ShorSteps true e.val) ∧
    (runRns3x5ShorSteps false 0 ≠ runRns3x5ShorSteps false 4 ∧
     (runRns3x5ShorSteps false 0).qCrt = 0 ∧
     (runRns3x5ShorSteps false 4).qCrt = 1) := by
  decide

/-- Combined logical `QSub` + physical `QPhysGrade` witness for `RNS-CRT + Select-SWAP QROAM`. -/
structure RnsQroamSynthesisGrade where
  idleDecoherenceMilli   : Nat
  tempAndInfidelityMilli : Nat
  exclusionCollisions    : Nat
  faultDistance          : Nat
  targetDistance         : Nat
  canonicalQuotientClean : Bool
  phaseTaintClean        : Bool
  deriving DecidableEq, Repr

/-- Parallel tensor composition of disjoint `RNS` residue channels (`Φ2`: `max` idle, `sum` gate action). -/
def composeParallelResidueChannels
    (crossHits : Nat) (c1 c2 : RnsQroamSynthesisGrade) : RnsQroamSynthesisGrade :=
  { idleDecoherenceMilli   := Nat.max c1.idleDecoherenceMilli c2.idleDecoherenceMilli
  , tempAndInfidelityMilli := c1.tempAndInfidelityMilli + c2.tempAndInfidelityMilli
  , exclusionCollisions    := c1.exclusionCollisions + c2.exclusionCollisions + crossHits
  , faultDistance          := Nat.min c1.faultDistance c2.faultDistance
  , targetDistance         := Nat.max c1.targetDistance c2.targetDistance
  , canonicalQuotientClean := c1.canonicalQuotientClean && c2.canonicalQuotientClean
  , phaseTaintClean        := c1.phaseTaintClean && c2.phaseTaintClean }

/-- Sequential composition with QROAM lookup / uncomputation (`Φ1` additive Lindblad action). -/
def composeSeqQroam
    (a b : RnsQroamSynthesisGrade) : RnsQroamSynthesisGrade :=
  { idleDecoherenceMilli   := a.idleDecoherenceMilli + b.idleDecoherenceMilli
  , tempAndInfidelityMilli := a.tempAndInfidelityMilli + b.tempAndInfidelityMilli
  , exclusionCollisions    := a.exclusionCollisions + b.exclusionCollisions
  , faultDistance          := Nat.min a.faultDistance b.faultDistance
  , targetDistance         := Nat.max a.targetDistance b.targetDistance
  , canonicalQuotientClean := a.canonicalQuotientClean && b.canonicalQuotientClean
  , phaseTaintClean        := a.phaseTaintClean && b.phaseTaintClean }

/-- Build QROAM uncomputation grade at `N = 1024, W = 32` (`3` milli-units per `TempAND`). -/
def buildUncomputeQroamGrade (useBerryGidney : Bool) (cleanPhase : Bool) : RnsQroamSynthesisGrade :=
  let nAnds := if useBerryGidney then berryGidneyTempAnds 1024 32 32 else sawtoothUncomputeTempAnds 1024
  { idleDecoherenceMilli   := nAnds / 2
  , tempAndInfidelityMilli := 3 * nAnds
  , exclusionCollisions    := 0
  , faultDistance          := 7
  , targetDistance         := 5
  , canonicalQuotientClean := true
  , phaseTaintClean        := cleanPhase }

/-- Unified soundness predicate requiring `QSub (Law U2 ∧ Law U4)` and `QPhys (Φ1 ∧ Φ2 ∧ Φ3)`. -/
def checkRnsQroamQSubPhysSound (g : RnsQroamSynthesisGrade) : Bool :=
  (g.idleDecoherenceMilli + g.tempAndInfidelityMilli <= 693) &&
  (g.exclusionCollisions == 0) &&
  (g.faultDistance >= g.targetDistance) &&
  g.canonicalQuotientClean &&
  g.phaseTaintClean

/-- Single narrow RNS residue channel grade (`d = 7`, target `5`, Kawamura `Law U2` parameterized). -/
def mkResidueChannelGrade (u2Clean : Bool) : RnsQroamSynthesisGrade :=
  { idleDecoherenceMilli   := 15
  , tempAndInfidelityMilli := 10
  , exclusionCollisions    := 0
  , faultDistance          := 7
  , targetDistance         := 5
  , canonicalQuotientClean := u2Clean
  , phaseTaintClean        := true }

/-- **(`qsub_u2_u3_u4_rns_crt_berry_gidney_qphys_synthesis`)**:
    Proves that `Φ2`-disjoint 3-channel `RNS-CRT` + Kawamura `Law U2` + `Berry–Gidney` `61-TempAND`
    uncomputation passes `checkRnsQroamQSubPhysSound`, whereas naive `1,022-TempAND` sawtooth
    uncomputation fails `Φ1` (`> 693`), colliding residue channels fail `Φ2`, omitting `Law U2`
    fails quotient canonicality, and omitting the 1-bit phase QROAM fails `Law U4`. -/
theorem qsub_u2_u3_u4_rns_crt_berry_gidney_qphys_synthesis :
    let rnsDisjointU2 :=
      composeParallelResidueChannels 0
        (composeParallelResidueChannels 0 (mkResidueChannelGrade true) (mkResidueChannelGrade true))
        (mkResidueChannelGrade true)
    let fullOpt := composeSeqQroam rnsDisjointU2 (buildUncomputeQroamGrade true true)
    let naiveSawtooth := composeSeqQroam rnsDisjointU2 (buildUncomputeQroamGrade false true)
    let collidingRns := composeSeqQroam
      (composeParallelResidueChannels 1 (mkResidueChannelGrade true) (mkResidueChannelGrade true))
      (buildUncomputeQroamGrade true true)
    let missingU2 := composeSeqQroam (mkResidueChannelGrade false) (buildUncomputeQroamGrade true true)
    let missingU4 := composeSeqQroam rnsDisjointU2 (buildUncomputeQroamGrade true false)
    checkRnsQroamQSubPhysSound fullOpt = true ∧
    (fullOpt.idleDecoherenceMilli + fullOpt.tempAndInfidelityMilli = 258) ∧
    checkRnsQroamQSubPhysSound naiveSawtooth = false ∧
    checkRnsQroamQSubPhysSound collidingRns = false ∧
    checkRnsQroamQSubPhysSound missingU2 = false ∧
    checkRnsQroamQSubPhysSound missingU4 = false := by
  decide

/-- Executable sanity suite (`verifySelectSwapQroamCrtModuleSanity`). -/
