    match layout with
    | .Willow105Grid    => 0
    | .Heron156HeavyHex => 0
    | .Gross144Biplanar => 0
    | .QccdZone         => 0
    | .AodGrid          => 0
  init + evalLakefillKernel6Prog desugared + regimePhaseCancels + isaRebaseDelta + layoutSwapParity

/-- Validates a single cell `(id, reg, mach)` in the `58 × 12 = 696` Phase-28 DAG-Peephole & ASAP compilation matrix
    (`checkDagAsap58TargetCellValid` — `OQP-1..58`). -/
def checkDagAsap58TargetCellValid (id : OqpFull58Id) (_reg : ExecRegime3) (mach : MachineFamily4) : Bool :=
  let sig := oqp58AlgorithmicSignature id
  let surfaceAst := buildOqpSurfaceAstFromSig sig
  let desugared := desugarProgToLakefill surfaceAst
  let loweredGates := lowerKernelToAbstractRevGates desugared
  let rebasedGates := rebaseToNativeMachineIsa mach loweredGates
