    LakefillQEGraphQPhysSaturationProofs.cx01
      (LakefillQEGraphQPhysSaturationProofs.cx12
        (LakefillQEGraphQPhysSaturationProofs.cx01
          (LakefillQEGraphQPhysSaturationProofs.cx12 s))) =
      LakefillQEGraphQPhysSaturationProofs.cx02 s ∧
    LakefillQEGraphQPhysSaturationProofs.qroamBerryGidneyTempAnds 16 (wordW + 2) 2 4 <
      LakefillQEGraphQPhysSaturationProofs.qroamSymmetricTempAnds 16 (wordW + 2) 2 ∧
    verifyLakefillQEGraphSaturationModuleSanity () = true := by
  exact ⟨(LakefillQEGraphQPhysSaturationProofs.mbu_hadamard_dual_branch_equivalence m c1 c2).1,
         (LakefillQEGraphQPhysSaturationProofs.heavy_hex_bridge_commutator_soundness s).1,
