theorem f56_s36_qds20_wide_word_skew_rank_overflow_guard_sound :
    skewCarryThresholdModWord 17 = 131071 ∧
    skewCarryThresholdExtended 17 = 262143 ∧
    skewCarryThresholdModWord 17 < skewCarryThresholdExtended 17 ∧
    checkF56WideWordCarryGuard 17 19 = true ∧
    checkF56WideWordCarryGuard 17 17 = false := by
  decide

