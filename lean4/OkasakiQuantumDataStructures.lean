namespace OkasakiQuantumDataStructures

/-- 64-bit truth-table bitboard representing a Boolean function $f : \mathbb{F}_2^6 \to \mathbb{F}_2$. -/
abbrev Bitboard64 := UInt64

/-- 6-wire 64-bit bitboard register state (`BitboardVec6`). -/
structure BitboardVec6 where
  w0 : Bitboard64
  w1 : Bitboard64
  w2 : Bitboard64
  w3 : Bitboard64
  w4 : Bitboard64
  w5 : Bitboard64
  deriving DecidableEq, Repr

/-- Fredkin (`CSWAP`) multiplexer over 64-bit bitboards:
    `(a ⊕ (c ∧ (a ⊕ b)), b ⊕ (c ∧ (a ⊕ b)))`. -/
def bb_cswap_mux (c a b : Bitboard64) : Bitboard64 × Bitboard64 :=
  let diff := c &&& (a ^^^ b)
  (a ^^^ diff, b ^^^ diff)

