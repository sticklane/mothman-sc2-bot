/-- Denotational output evaluator for a compiled `(oqp, regime, machine, layout)` target cell on initial basis
    state `init` (`evalTargetCell` — Cross-Target & Cross-Layout Semantic Equivalence). -/
def evalTargetCell
    (oqp : OqpFull58Id) (reg : ExecRegime3) (mach : MachineFamily4)
    (layout : HardwareCouplingLayout5) (init : Nat) : Nat :=
  let sig := oqp58AlgorithmicSignature oqp
  let desugared := desugarProgToLakefill (buildOqpSurfaceAstFromSig sig)
  let regimePhaseCancels : Nat :=
    match reg with
    | .oneShot      => 0
    | .multiShot    => 0
    | .multiMachine => 0
  let isaRebaseDelta : Nat :=
    match mach with
    | .scPlanar       => 0
    | .scQldpc        => 0
    | .trappedIonQccd => 0
    | .neutralAtomAod => 0
