theorem synthesize_preserves_logical_well_typed_helper (w : QSubPhysicalLoweringWitness) :
    (synthesizeQSubPhysicalRepair w).logicalQSubWellTyped = w.logicalQSubWellTyped := by
  unfold synthesizeQSubPhysicalRepair
  have h5 (x : QSubPhysicalLoweringWitness) : (applyRepairR5ZigzagAndExactDyadic x).logicalQSubWellTyped = x.logicalQSubWellTyped := by unfold applyRepairR5ZigzagAndExactDyadic; split <;> rfl
  have h4 (x : QSubPhysicalLoweringWitness) : (applyRepairR4TwoColorConflictSchedule x).logicalQSubWellTyped = x.logicalQSubWellTyped := by unfold applyRepairR4TwoColorConflictSchedule; split <;> rfl
  have h3 (x : QSubPhysicalLoweringWitness) : (applyRepairR3CouplingCostOrBridge x).logicalQSubWellTyped = x.logicalQSubWellTyped := by unfold applyRepairR3CouplingCostOrBridge; split <;> rfl
  have h2 (x : QSubPhysicalLoweringWitness) : (applyRepairR2SpectatorXy4OrDemote x).logicalQSubWellTyped = x.logicalQSubWellTyped := by unfold applyRepairR2SpectatorXy4OrDemote; split <;> rfl
  have h1 (x : QSubPhysicalLoweringWitness) : (applyRepairR1VolumeCompression x).logicalQSubWellTyped = x.logicalQSubWellTyped := by
    unfold applyRepairR1VolumeCompression; split
    · rfl
    · unfold compressP1Candidate; dsimp only []; generalize checkP1ActiveVolumeBelowBqpCliff x.nQubits _ _ _ _ = b; cases b <;> rfl
  rw [h5, h4, h3, h2, h1]

theorem synthesize_qsub_physical_repair_universal_soundness_and_idempotence
    (w : QSubPhysicalLoweringWitness) (hLogical : w.logicalQSubWellTyped = true) :
    checkQSubPhysicalLoweringSound (synthesizeQSubPhysicalRepair w) = true ∧
    synthesizeQSubPhysicalRepair canonicalValidQSubPhysicalWitness = canonicalValidQSubPhysicalWitness ∧
    classifyQSubPhysicalRepairs canonicalValidQSubPhysicalWitness = [.r0AlreadySound] := by
  refine ⟨?_, by decide, by decide⟩
  have hLog : (synthesizeQSubPhysicalRepair w).logicalQSubWellTyped = true := by
    rw [synthesize_preserves_logical_well_typed_helper w, hLogical]
  have hP1 := (r1_pyzx_peephole_and_bennett_checkpoint_repair_restores_bqp_volume w).2.2.2
  have hP2 := (r2_spectator_xy4_dd_and_unitary_demotion_repair_soundness (applyRepairR1VolumeCompression w)).2.2.2
  have hP3 := (r3_coupling_cost_guard_and_4cx_bridge_repair_soundness (applyRepairR2SpectatorXy4OrDemote (applyRepairR1VolumeCompression w))).2.2.2.2.2
  have hP4 := (r4_two_color_coupler_conflict_graph_schedule_repair_soundness (applyRepairR3CouplingCostOrBridge (applyRepairR2SpectatorXy4OrDemote (applyRepairR1VolumeCompression w)))).2.2
  have hP5 := (r5_hook_orthogonal_zigzag_cnot_and_exact_dyadic_repair_soundness (applyRepairR4TwoColorConflictSchedule (applyRepairR3CouplingCostOrBridge (applyRepairR2SpectatorXy4OrDemote (applyRepairR1VolumeCompression w))))).2.2.2.2.2.2.2
  unfold checkQSubPhysicalLoweringSound
  simp only [Bool.and_eq_true]
  refine ⟨⟨⟨⟨⟨hLog, ?_⟩, ?_⟩, ?_⟩, ?_⟩, hP5⟩
  · unfold synthesizeQSubPhysicalRepair; generalize applyRepairR1VolumeCompression w = x1 at hP1 ⊢; unfold applyRepairR5ZigzagAndExactDyadic; split <;> (unfold applyRepairR4TwoColorConflictSchedule; split <;> (unfold applyRepairR3CouplingCostOrBridge; split <;> (unfold applyRepairR2SpectatorXy4OrDemote; split <;> exact hP1)))
  · unfold synthesizeQSubPhysicalRepair; generalize applyRepairR2SpectatorXy4OrDemote (applyRepairR1VolumeCompression w) = x2 at hP2 ⊢; unfold applyRepairR5ZigzagAndExactDyadic; split <;> (unfold applyRepairR4TwoColorConflictSchedule; split <;> (unfold applyRepairR3CouplingCostOrBridge; split <;> exact hP2))
  · unfold synthesizeQSubPhysicalRepair; generalize applyRepairR3CouplingCostOrBridge (applyRepairR2SpectatorXy4OrDemote (applyRepairR1VolumeCompression w)) = x3 at hP3 ⊢; unfold applyRepairR5ZigzagAndExactDyadic; split <;> (unfold applyRepairR4TwoColorConflictSchedule; split <;> exact hP3)
  · unfold synthesizeQSubPhysicalRepair; generalize applyRepairR4TwoColorConflictSchedule (applyRepairR3CouplingCostOrBridge (applyRepairR2SpectatorXy4OrDemote (applyRepairR1VolumeCompression w))) = x4 at hP4 ⊢; unfold applyRepairR5ZigzagAndExactDyadic; split <;> exact hP4

