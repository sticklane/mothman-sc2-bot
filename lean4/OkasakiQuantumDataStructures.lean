  | BasisZero      : MultiBasisProbe
  | BasisPlusProbe : MultiBasisProbe
  deriving DecidableEq, Repr

/-- Multi-basis denotational output evaluator for `(oqp, basis, reg, mach, layout)` on initial state `init`
