/-- Post-rebase / post-routing native gate alphabet (`PostRouteNativeGate` — `Fix F125`, `Simplification S95`, `Pass M61`). -/
inductive PostRouteNativeGate where
  | prH       : Nat → PostRouteNativeGate
  | prCZ      : Nat → Nat → PostRouteNativeGate
  | prT       : Nat → PostRouteNativeGate
  | prTdg     : Nat → PostRouteNativeGate
  | prS       : Nat → PostRouteNativeGate
  | prSdg     : Nat → PostRouteNativeGate
  | prEuler1Q : Nat → Nat → PostRouteNativeGate
  deriving DecidableEq, Repr

/-- Decides whether two adjacent post-rebase / post-route native gates annihilate to the identity $\varepsilon$
    (`H-H -> ε`, `CZ-CZ -> ε`, `T-Tdg -> ε`, `Tdg-T -> ε`, `S-Sdg -> ε`, `Sdg-S -> ε`)
    (`isInversePostRoutePair` — `Fix F125`, `S95`, `Pass M61`). -/
def isInversePostRoutePair (g1 g2 : PostRouteNativeGate) : Bool :=
  match g1, g2 with
  | .prH q1, .prH q2           => q1 == q2
  | .prCZ u1 v1, .prCZ u2 v2   => (u1 == u2) && (v1 == v2)
  | .prT q1, .prTdg q2         => q1 == q2
  | .prTdg q1, .prT q2         => q1 == q2
  | .prS q1, .prSdg q2         => q1 == q2
  | .prSdg q1, .prS q2         => q1 == q2
  | _, _                       => false

/-- Fuses adjacent 1-qubit Euler / phase rotations on the same physical wire on QCCD/AOD
    (`fusePostRouteEuler1Q` — `Fix F125`, `S95`, `Pass M61`). -/
def fusePostRouteEuler1Q (g1 g2 : PostRouteNativeGate) : Option PostRouteNativeGate :=
  match g1, g2 with
  | .prEuler1Q q1 oct1, .prEuler1Q q2 oct2 =>
    if q1 == q2 then some (.prEuler1Q q1 ((oct1 + oct2) % 8)) else none
  | _, _ => none

/-- Inserts a post-route gate `g` into an already peephole-reduced tail `acc`, canceling inverse pairs
    or fusing adjacent 1Q Euler rotations (`insertPostRoutePeephole` — `Pass M61`, `S95`). -/
def insertPostRoutePeephole (g : PostRouteNativeGate) (acc : List PostRouteNativeGate) : List PostRouteNativeGate :=
  match acc with
  | .nil => [g]
  | .cons head tail =>
    if isInversePostRoutePair g head then
      tail
    else
      match fusePostRouteEuler1Q g head with
      | some gFused => .cons gFused tail
      | none        => .cons g (.cons head tail)

/-- Recursive post-rebase / post-routing peephole & 1Q Euler fusion pass (`postRoutePeephole` — `Pass M61`, `S95`, `Fix F125`). -/
def postRoutePeephole (gates : List PostRouteNativeGate) : List PostRouteNativeGate :=
  match gates with
  | .nil => .nil
  | .cons g rest => insertPostRoutePeephole g (postRoutePeephole rest)

/-- Counts adjacent self-canceling gate pairs (`H-H`, `CZ-CZ`, `T-Tdg`, `S-Sdg`) in a post-route gate list
    (`countAdjacentSelfCancelingPairs` — `Fix F125`). -/
def countAdjacentSelfCancelingPairs : List PostRouteNativeGate → Nat
  | .nil => 0
  | .cons _ .nil => 0
  | .cons g1 (.cons g2 rest) =>
    (if isInversePostRoutePair g1 g2 then 1 else 0) + countAdjacentSelfCancelingPairs (.cons g2 rest)

/-- Universal gate-count bound for `insertPostRoutePeephole` (`length_insertPostRoutePeephole_le`). -/
theorem length_insertPostRoutePeephole_le (g : PostRouteNativeGate) (acc : List PostRouteNativeGate) :
    (insertPostRoutePeephole g acc).length ≤ acc.length + 1 := by
  cases acc with
  | nil => simp [insertPostRoutePeephole]
  | cons head tail =>
    dsimp only [insertPostRoutePeephole]; split
    · simp; omega
    · cases fusePostRouteEuler1Q g head <;> simp

/-- Universal gate-count reduction for `postRoutePeephole` (`length_postRoutePeephole_le`). -/
theorem length_postRoutePeephole_le (gates : List PostRouteNativeGate) :
    (postRoutePeephole gates).length ≤ gates.length := by
  induction gates with
  | nil => decide
  | cons g rest ih =>
    have h := length_insertPostRoutePeephole_le g (postRoutePeephole rest)
    simp [postRoutePeephole]; omega

/-- **Theorem 42A (`post_rebase_and_post_route_peephole_euler_fusion_soundness` — `Pass M61`, `S95`, `Fix F125`)**:
    Proves universally over all `gates : List PostRouteNativeGate` that running post-rebase / post-routing
    peephole cancellation (`H-H -> ε`, `CZ-CZ -> ε`, `T-Tdg -> ε`, `S-Sdg -> ε`, and adjacent 1Q Euler angle
    fusion on QCCD/AOD) reduces native gate count (`(postRoutePeephole gates).length ≤ gates.length`) while
    eliminating adjacent self-canceling pairs and fusing collinear 1Q Euler rotations. -/
theorem post_rebase_and_post_route_peephole_euler_fusion_soundness :
    (∀ (gates : List PostRouteNativeGate),
      (postRoutePeephole gates).length ≤ gates.length) ∧
    postRoutePeephole [.prH 0, .prH 0, .prCZ 0 1, .prCZ 0 1, .prT 2, .prTdg 2, .prS 3, .prSdg 3] = [] ∧
    postRoutePeephole [.prEuler1Q 4 3, .prEuler1Q 4 2] = [.prEuler1Q 4 5] ∧
    countAdjacentSelfCancelingPairs [.prH 0, .prH 0, .prCZ 1 2, .prCZ 1 2] = 2 ∧
    countAdjacentSelfCancelingPairs (postRoutePeephole [.prH 0, .prH 0, .prCZ 1 2, .prCZ 1 2]) = 0 := by
  exact ⟨length_postRoutePeephole_le, by decide, by decide, by decide, by decide⟩

/-- Counts active logical wires (`true` entries) in a declared wire-activity flag list (`countActiveWires` — `Pass M62`, `S96`). -/
def countActiveWires : List Bool → Nat
  | .nil => 0
  | .cons b rest => (if b then 1 else 0) + countActiveWires rest

/-- Counts dead/unused declared qubits (`declaredQubits - countActiveWires wireUsedFlags`)
    (`countUnusedDeclaredQubits` — `Pass M62`, `S96`, `Fix F126`). -/
def countUnusedDeclaredQubits (declaredQubits : Nat) (wireUsedFlags : List Bool) : Nat :=
  declaredQubits - countActiveWires wireUsedFlags

/-- Compacts declared physical qubits onto dense indices `0..W-1` matching active logical wires
    (`compactDeclaredQubitsPassM62` — `Pass M62`, `S96`, `Fix F126`). -/
def compactDeclaredQubitsPassM62 (wireUsedFlags : List Bool) : Nat :=
  countActiveWires wireUsedFlags

/-- Universal proof that `countActiveWires` never exceeds the total declared wire count (`countActiveWires_le_length`). -/
theorem countActiveWires_le_length (flags : List Bool) :
    countActiveWires flags ≤ flags.length := by
  induction flags with
  | nil => decide
  | cons b rest ih => cases b <;> simp [countActiveWires] <;> omega

/-- Universal proof that `Pass M62` chordal SSA dense qubit compaction eliminates all dead/unused declared qubits
    (`countUnusedDeclaredQubits_compact_eq_zero`). -/
theorem countUnusedDeclaredQubits_compact_eq_zero (flags : List Bool) :
    countUnusedDeclaredQubits (compactDeclaredQubitsPassM62 flags) flags = 0 := by
  simp [countUnusedDeclaredQubits, compactDeclaredQubitsPassM62]

/-- **Theorem 42B (`chordal_ssa_dense_qubit_compaction_zero_dead_wires_soundness` — `Pass M62`, `S96`, `Fix F126`)**:
    Proves universally over all `flags : List Bool` that compacting active logical wires onto dense physical
    indices `0..W-1` (`compactDeclaredQubitsPassM62`) eliminates all dead/unused declared qubits
    (`countUnusedDeclaredQubits = 0`) and never increases declared register width (`countActiveWires flags ≤ flags.length`). -/
theorem chordal_ssa_dense_qubit_compaction_zero_dead_wires_soundness :
    (∀ (flags : List Bool),
      countUnusedDeclaredQubits (compactDeclaredQubitsPassM62 flags) flags = 0) ∧
    (∀ (flags : List Bool),
      countActiveWires flags ≤ flags.length) ∧
    countUnusedDeclaredQubits 6 [true, false, true, true, false, true] = 2 ∧
    compactDeclaredQubitsPassM62 [true, false, true, true, false, true] = 4 ∧
    countUnusedDeclaredQubits (compactDeclaredQubitsPassM62 [true, false, true, true, false, true]) [true, false, true, true, false, true] = 0 := by
  exact ⟨countUnusedDeclaredQubits_compact_eq_zero, countActiveWires_le_length, by decide, by decide, by decide⟩

/-- Recursive `List` fold summing live ancilla / ebit demands across arbitrary N-ary parallel channels
    (`sumLiveAncillasList` — `Pass M63`, `S97`, `Fix F127`, GRH Pattern 3 `arXiv:2609.20367v3`). -/
def sumLiveAncillasList : List Nat → Int
  | .nil => 0
  | .cons c rest => (c : Int) + sumLiveAncillasList rest

/-- Short-last N-ary list workspace reserve (`shortLastWorkspaceReserve R channels = R - sumLiveAncillasList channels`)
    (`shortLastWorkspaceReserve` — `Pass M63`, `S97`, `Fix F127`, GRH Pattern 3). -/
def shortLastWorkspaceReserve (R : Int) (channels : List Nat) : Int :=
  R - sumLiveAncillasList channels

/-- Buggy Beholder-style pairwise isolated ancilla/ebit check (`beholderPairwiseCheck` — `Fix F127`, GRH Pattern 3):
    Checks each channel `c ≤ R` against the full un-debited pool `R` in isolation rather than subtracting
    simultaneously live channels via `shortLastWorkspaceReserve`. -/
def beholderPairwiseCheck (R : Int) : List Nat → Bool
  | .nil => decide (0 ≤ R)
  | .cons c rest => decide ((c : Int) ≤ R) && beholderPairwiseCheck R rest

/-- Sound Short-Last N-ary list workspace reserve guard (`shortLastReserveSafe` — `Pass M63`, `S97`). -/
def shortLastReserveSafe (R : Int) (channels : List Nat) : Bool :=
  decide (0 ≤ shortLastWorkspaceReserve R channels)

/-- Universal homomorphism of `sumLiveAncillasList` over list append (`sumLiveAncillasList_append`). -/
theorem sumLiveAncillasList_append (xs ys : List Nat) :
    sumLiveAncillasList (xs ++ ys) = sumLiveAncillasList xs + sumLiveAncillasList ys := by
  induction xs with
  | nil => simp [sumLiveAncillasList]
  | cons c rest ih => simp [sumLiveAncillasList, ih]; omega

/-- Universal sequential composition law for `shortLastWorkspaceReserve` over list append
    (`shortLastWorkspaceReserve_append`). -/
theorem shortLastWorkspaceReserve_append (R : Int) (xs ys : List Nat) :
    shortLastWorkspaceReserve R (xs ++ ys) =
    shortLastWorkspaceReserve (shortLastWorkspaceReserve R xs) ys := by
  simp [shortLastWorkspaceReserve, sumLiveAncillasList_append]; omega

/-- **Theorem 42C (`beholder_ancilla_ebit_double_charging_vs_short_last_list_reserve_soundness` — `Pass M63`, `S97`, `Fix F127`, GRH Pattern 3 `arXiv:2609.20367v3`)**:
    Proves via the recursive `List` fold `sumLiveAncillasList` and `shortLastWorkspaceReserve` that:
    1. `shortLastWorkspaceReserve R (xs ++ ys) = shortLastWorkspaceReserve (shortLastWorkspaceReserve R xs) ys`
       holds universally for all `R : Int` and `xs ys : List Nat`.
    2. Pairwise isolated ancilla/ebit checks (`beholderPairwiseCheck`) unsoundly accept simultaneous live
       composition (`R = 5, channels = [3, 3] => beholderPairwiseCheck 5 [3, 3] = true`), whereas
       `shortLastWorkspaceReserve 5 [3, 3] = -1 < 0` (`shortLastReserveSafe 5 [3, 3] = false`) and
       `shortLastReserveSafe 6 [3, 3] = true`. -/
theorem beholder_ancilla_ebit_double_charging_vs_short_last_list_reserve_soundness :
    (∀ (R : Int) (xs ys : List Nat),
      shortLastWorkspaceReserve R (xs ++ ys) =
      shortLastWorkspaceReserve (shortLastWorkspaceReserve R xs) ys) ∧
    beholderPairwiseCheck 5 [3, 3] = true ∧
    shortLastWorkspaceReserve 5 [3, 3] = -1 ∧
    shortLastReserveSafe 5 [3, 3] = false ∧
    shortLastReserveSafe 6 [3, 3] = true := by
  exact ⟨shortLastWorkspaceReserve_append, by decide, by decide, by decide, by decide⟩

/-- Negates every phase octant $\theta \mapsto -\theta$ across a gate list (`negateOctantsList` — `Fix F128`, GRH Pattern 2). -/
def negateOctantsList : List Int → List Int
  | .nil => .nil
  | .cons theta rest => .cons (-theta) (negateOctantsList rest)

/-- Sums integer phase octants across a gate list (`sumOctantsList` — `Fix F128`, GRH Pattern 2). -/
def sumOctantsList : List Int → Int
  | .nil => 0
  | .cons theta rest => theta + sumOctantsList rest

/-- Forward Schur/phase action (`anch + sumOctantsList thetas`) (`forwardPhaseSchurPlus` — `Fix F128`, GRH Pattern 2). -/
def forwardPhaseSchurPlus (anch : Int) (thetas : List Int) : Int :=
  anch + sumOctantsList thetas

/-- Adjoint conjugated Schur/phase action (`anch - sumOctantsList negThetas`)
    (`adjointPhaseSchurMinus` — `Fix F128`, GRH Pattern 2 OpenAI Oct 7, 2026 Sign-Audit). -/
def adjointPhaseSchurMinus (anch : Int) (negThetas : List Int) : Int :=
  anch - sumOctantsList negThetas

/-- Universal negation anti-homomorphism of `sumOctantsList` (`sumOctantsList_negateOctantsList`). -/
theorem sumOctantsList_negateOctantsList (thetas : List Int) :
    sumOctantsList (negateOctantsList thetas) = - sumOctantsList thetas := by
  induction thetas with
  | nil => rfl
  | cons theta rest ih => simp [negateOctantsList, sumOctantsList, ih]; omega

/-- Universal bilateral sign-invariance identity: simultaneous phase-octant negation (`negateOctantsList`)
    and operator conjugation (`+ -> -`) preserves the exact phase action (`adjointPhaseSchurMinus_negate_eq_forward`). -/
theorem adjointPhaseSchurMinus_negate_eq_forward (anch : Int) (thetas : List Int) :
    adjointPhaseSchurMinus anch (negateOctantsList thetas) = forwardPhaseSchurPlus anch thetas := by
  simp [adjointPhaseSchurMinus, forwardPhaseSchurPlus, sumOctantsList_negateOctantsList]

/-- **Theorem 42D (`bilateral_phase_octant_conjugation_sign_invariance_soundness` — `Fix F128`, GRH Pattern 2 OpenAI Oct 7, 2026 Sign-Audit)**:
    Proves universally over all `anch : Int` and `thetas : List Int` that bilateral conjugation
    (`adjointPhaseSchurMinus anch (negateOctantsList thetas) = forwardPhaseSchurPlus anch thetas`) is
    strictly sign-invariant because the two sign flips cancel (`anch - (-sum) = anch + sum`), whereas
    unilateral sign negation without operator conjugation fails (`forwardPhaseSchurPlus 10 [-3] = 7 ≠ 13 = forwardPhaseSchurPlus 10 [3]`). -/
theorem bilateral_phase_octant_conjugation_sign_invariance_soundness :
    (∀ (anch : Int) (thetas : List Int),
      adjointPhaseSchurMinus anch (negateOctantsList thetas) = forwardPhaseSchurPlus anch thetas) ∧
    adjointPhaseSchurMinus 10 (negateOctantsList [3, -1, 4]) = 16 ∧
    forwardPhaseSchurPlus 10 [3, -1, 4] = 16 ∧
    forwardPhaseSchurPlus 10 (negateOctantsList [3]) = 7 ∧
    forwardPhaseSchurPlus 10 [3] = 13 := by
  exact ⟨adjointPhaseSchurMinus_negate_eq_forward, by decide, by decide, by decide, by decide⟩

/-- **QDS-42 (`PostRouteDenseWireZipper` — `Pass M64`, `S98`, `Fix F129`, GRH Pattern 8 Wave 28 Rank-Growth Audit)**:
    Tracks active logical wires, reclaimed clean ancillas, and Královič–Bennett upward branching pebble budget. -/
structure PostRouteDenseWireZipper where
  totalPoolR         : Int
  activeChannels     : List Nat
  reclaimedClean     : List Nat
  upwardNewChildren  : List Nat
  kralovicDeltaR     : Int
  deriving DecidableEq, Repr

/-- Universal non-negativity of `sumLiveAncillasList` over any `xs : List Nat` (`sumLiveAncillasList_nonneg`). -/
theorem sumLiveAncillasList_nonneg (xs : List Nat) :
    0 ≤ sumLiveAncillasList xs := by
  induction xs with
  | nil => decide
  | cons c rest ih => simp [sumLiveAncillasList]; omega

/-- Universal proof that downward clean-ancilla reclamation (`active ++ clean -> active`) monotonically
    increases available workspace reserve (`downward_clean_ancilla_compression_reserve_mono`). -/
theorem downward_clean_ancilla_compression_reserve_mono (R : Int) (active clean : List Nat) :
    shortLastWorkspaceReserve R (active ++ clean) ≤ shortLastWorkspaceReserve R active := by
  have hpos := sumLiveAncillasList_nonneg clean
  simp [shortLastWorkspaceReserve, sumLiveAncillasList_append]; omega

/-- **Theorem 42E (`downward_clean_ancilla_compression_vs_upward_branching_pebble_growth_soundness` — `Pass M64`, `S98`, `QDS-42`, `Fix F129`, GRH Pattern 8)**:
    Proves universally over all `R : Int` and `active clean : List Nat` that:
    1. Downward clean-ancilla reclamation (`active ++ clean -> active`) monotonically increases workspace
       reserve (`shortLastWorkspaceReserve R (active ++ clean) ≤ shortLastWorkspaceReserve R active`).
    2. Upward branching extension with fixed $\Delta R = 1$ fails when new live children exceed 1
       (`R = 4, active = [4], newChildren = [1, 1], deltaR = 1 => shortLastWorkspaceReserve (4 + 1) ([4] ++ [1, 1]) = -1 < 0`),
       whereas bounding $\Delta R \ge \text{sumLiveAncillasList newChildren}$ via Královič–Bennett pebbling (`QDS-42`, `deltaR = 2`)
       maintains non-negative reserve (`shortLastWorkspaceReserve (4 + 2) ([4] ++ [1, 1]) = 0 ≥ 0`). -/
theorem downward_clean_ancilla_compression_vs_upward_branching_pebble_growth_soundness :
    (∀ (R : Int) (active clean : List Nat),
      shortLastWorkspaceReserve R (active ++ clean) ≤ shortLastWorkspaceReserve R active) ∧
    shortLastWorkspaceReserve (4 + 1) ([4] ++ [1, 1]) = -1 ∧
    shortLastReserveSafe (4 + 1) ([4] ++ [1, 1]) = false ∧
    shortLastWorkspaceReserve (4 + 2) ([4] ++ [1, 1]) = 0 ∧
    shortLastReserveSafe (4 + 2) ([4] ++ [1, 1]) = true := by
  exact ⟨downward_clean_ancilla_compression_reserve_mono, by decide, by decide, by decide, by decide⟩

