/-- Homomorphism of `evalLakefillKernel6Seq` over list concatenation (`evalLakefillKernel6Seq_append`). -/
theorem evalLakefillKernel6Seq_append (xs ys : List LakefillKernel6) :
    evalLakefillKernel6Seq (xs ++ ys) = evalLakefillKernel6Seq xs + evalLakefillKernel6Seq ys := by
  induction xs with
  | nil => simp [evalLakefillKernel6Seq]
  | cons k rest ih =>
    simp [evalLakefillKernel6Seq, ih, Nat.add_assoc]

/-- Single-construct denotational equivalence between `desugarCoreQds20ToLakefillKernel6` and `evalCoreQds20SurfaceSpec`
    (`evalLakefillKernel6Seq_desugar_eq`). -/
