    | .Willow105Grid    => 0
    | .Heron156HeavyHex => 0
    | .Gross144Biplanar => 0
    | .QccdZone         => 0
    | .AodGrid          => 0
  init + evalLakefillKernel6Prog desugared + basisProbeWeight + regimeDelta + machDelta + layoutDelta

