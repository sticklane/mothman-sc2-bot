    - `userCloudOuterLoop`: `1–100 ms` standard cloud API batch submission (IBM Qiskit Runtime / AWS Braket / Azure Quantum). -/
inductive ExecutionLoopTier where
  | providerInnerLoopBlueprint : ExecutionLoopTier
  | coprocessorMidLoop         : ExecutionLoopTier
  | userCloudOuterLoop         : ExecutionLoopTier
  deriving DecidableEq, Repr

/-- Unified `CoreQDS` Quantitative Linear-Borrow Usage Semiring (`CoreQDSUsageGrade` — `QDS-26..28`):
    - `0` (`uZeroErased`): compile-time index/shape parameter (erased before QASM/XLS synthesis).
    - `b` (`uBorrowedRef`): read-only phase-kickback / control borrow inside `within { U } apply { V }` (must be restored).
    - `1` (`uLinearState`): linear owned quantum state wire (no-cloning, no-dropping).
    - `ω(ℓ)` (`uClassicalLoop ℓ`): classical control/syndrome parameter annotated with its 3-loop execution tier `ℓ`. -/
inductive CoreQDSUsageGrade where
  | uZeroErased    : CoreQDSUsageGrade
  | uBorrowedRef   : CoreQDSUsageGrade
  | uLinearState   : CoreQDSUsageGrade
  | uClassicalLoop : ExecutionLoopTier → CoreQDSUsageGrade
  deriving DecidableEq, Repr

