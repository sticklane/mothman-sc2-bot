  !(checkF86QphaseOracleKickbackSafe ⟨true, false, 1, 1, 1, 1, 1⟩) &&
  !(checkF86QphaseOracleKickbackSafe ⟨true, true, 1, 1, 1, 0, 0⟩) &&
  checkF87CoreQdsTotalRevIrLoweringSafe ⟨13, true, true, true, true⟩ &&
  !(checkF87CoreQdsTotalRevIrLoweringSafe ⟨11, true, true, true, true⟩) &&
  !(checkF87CoreQdsTotalRevIrLoweringSafe ⟨13, false, true, true, true⟩) &&
  !(checkF87CoreQdsTotalRevIrLoweringSafe ⟨13, true, true, false, true⟩) &&
