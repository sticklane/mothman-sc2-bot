/-- Adjacency predicate of the 6-vertex 5-wheel graph $W_6$ (`wheel6EdgeBool` — `QDS-46`, `OQP-62`):
    Vertices `0..4` form a 5-cycle and vertex `5` is the central hub connected to all 5 rim vertices. -/
def wheel6EdgeBool (u v : Nat) : Bool :=
  if u == v then false
  else if u == 5 && v < 5 then true
  else if v == 5 && u < 5 then true
  else if u < 5 && v < 5 then
    ((u + 1) % 5 == v) || ((v + 1) % 5 == u)
  else false

/-- Integer adjacency entry `0` or `1` of the 6-vertex 5-wheel graph $W_6$ (`wheel6EntryInt`). -/
def wheel6EntryInt (u v : Nat) : Int :=
  if wheel6EdgeBool u v then 1 else 0

/-- Exact $3 \times 3$ cross-bipartition minor determinant $\det(W_6[A, A^c])$ for a 3-party subset
    $A = \{i_0, i_1, i_2\}$ and its complement $A^c = \{j_0, j_1, j_2\}$ (`det3x3Wheel6`). -/
def det3x3Wheel6 (i0 i1 i2 j0 j1 j2 : Nat) : Int :=
  let a00 := wheel6EntryInt i0 j0
  let a01 := wheel6EntryInt i0 j1
  let a02 := wheel6EntryInt i0 j2
  let a10 := wheel6EntryInt i1 j0
  let a11 := wheel6EntryInt i1 j1
  let a12 := wheel6EntryInt i1 j2
  let a20 := wheel6EntryInt i2 j0
  let a21 := wheel6EntryInt i2 j1
  let a22 := wheel6EntryInt i2 j2
  a00 * (a11 * a22 - a12 * a21) -
  a01 * (a10 * a22 - a12 * a20) +
  a02 * (a10 * a21 - a11 * a20)

/-- Complete enumeration of all $\binom{6}{3} = 20$ balanced $3$-vs-$3$ party bipartitions
    `(i0, i1, i2, j0, j1, j2)` of `{0, 1, 2, 3, 4, 5}` (`all20HexadBipartitions`). -/
def all20HexadBipartitions : List (Nat × Nat × Nat × Nat × Nat × Nat) :=
  [ (0, 1, 2, 3, 4, 5), (0, 1, 3, 2, 4, 5), (0, 1, 4, 2, 3, 5), (0, 1, 5, 2, 3, 4)
  , (0, 2, 3, 1, 4, 5), (0, 2, 4, 1, 3, 5), (0, 2, 5, 1, 3, 4), (0, 3, 4, 1, 2, 5)
  , (0, 3, 5, 1, 2, 4), (0, 4, 5, 1, 2, 3), (1, 2, 3, 0, 4, 5), (1, 2, 4, 0, 3, 5)
  , (1, 2, 5, 0, 3, 4), (1, 3, 4, 0, 2, 5), (1, 3, 5, 0, 2, 4), (1, 4, 5, 0, 2, 3)
  , (2, 3, 4, 0, 1, 5), (2, 3, 5, 0, 1, 4), (2, 4, 5, 0, 1, 3), (3, 4, 5, 0, 1, 2) ]

/-- Verifies that every single one of the $\binom{6}{3} = 20$ balanced $3$-vs-$3$ bipartitions of $W_6$
    is a valid disjoint partition of `{0..5}` and has unimodular determinant $|\det(W_6[A, A^c])| = 1$,
    so $\gcd(|\det|, 6) = 1$ (`checkWheel6All20MinorsUnimodularMod6` — `Theorem 46A`). -/
def checkWheel6All20MinorsUnimodularMod6 (_ : Unit := ()) : Bool :=
  (all20HexadBipartitions.length == 20) &&
  (binomChoose 6 3 == 20) &&
  all20HexadBipartitions.all (fun (i0, i1, i2, j0, j1, j2) =>
    let orderedOk := (i0 < i1) && (i1 < i2) && (i2 < 6) && (j0 < j1) && (j1 < j2) && (j2 < 6)
    let sumOk := (i0 + i1 + i2 + j0 + j1 + j2 == 15)
    let detAbs := Int.natAbs (det3x3Wheel6 i0 i1 i2 j0 j1 j2)
    orderedOk && sumOk && (detAbs == 1) && (Nat.gcd detAbs 6 == 1))

/-- Checks whether a non-zero residue `z ∈ {1..5}` is a zero divisor modulo $6$ via `Nat.gcd z 6 > 1`
    (`isZ6ZeroDivisor`). For composite hexad dimension $d = 6 = 2 \times 3$, the zero divisors in
    $\mathbb{Z}_6$ are exactly $\{2, 3, 4\}$. -/
def isZ6ZeroDivisor (z : Nat) : Bool :=
  (1 <= z) && (z < 6) && (Nat.gcd z 6 > 1)

/-- **Theorem 46A (`composite_hexad_ame_6_6_mds_singleton_bound_saturation_soundness` — `OQP-62`, `QDS-46`, `TODAY-40`)**:
    Proves that for composite hexad dimension $d = 6 = 2 \times 3$ ($\mathbb{C}^6 \cong \mathbb{C}^2 \otimes \mathbb{C}^3$),
    $\mathrm{AME}(6, 6) \equiv ((6, 1, 4))_6$ has $\binom{6}{3} = 20$ balanced $3$-vs-$3$ bipartitions,
    saturates the Quantum Singleton Bound $d_{\text{code}} = \lfloor 6 / 2 \rfloor + 1 = 4$ (correcting $1$ hexad error
    or $3$ located hexad erasures), has unimodular $|\det| = 1$ (`Nat.gcd 1 6 = 1`) across all $20$ $W_6$ minors,
    and identifies the exact zero divisors $\{2, 3, 4\}$ of $\mathbb{Z}_6$. -/
theorem composite_hexad_ame_6_6_mds_singleton_bound_saturation_soundness :
    binomChoose 6 3 = 20 ∧
    ameMaxUniformityK 6 = 3 ∧
    ameMdsCodeDistance 6 = 4 ∧
    ameMdsCodeDistance 6 = quantumSingletonDistanceBound 6 0 ∧
    ameCorrectableQuditErrors 6 = 1 ∧
    ameCorrectableQuditErasures 6 = 3 ∧
    checkWheel6All20MinorsUnimodularMod6 () = true ∧
    ((List.range 6).filter isZ6ZeroDivisor = [2, 3, 4]) ∧
    checkModVandermondeDiffInvertible 2 6 = false ∧
    checkModVandermondeDiffInvertible 3 6 = false ∧
    checkModVandermondeDiffInvertible 4 6 = false ∧
    checkModVandermondeDiffInvertible 5 6 = true := by
  decide

/-- Validates the composite MDS family parameters for $\mathrm{AME}(5, 6) \equiv ((5, 1, 3))_6$
    ($\binom{5}{2} = 10$ bipartitions, $d_{\text{code}} = 3$) and $\mathrm{AME}(10, 10) \equiv ((10, 1, 6))_{10}$
    ($\binom{10}{5} = 252$ bipartitions, $d_{\text{code}} = 6$) over prime-power tensor factorizations
    $\mathbb{F}_2 \times \mathbb{F}_3$ and $\mathbb{F}_2 \times \mathbb{F}_{5^2}$
    (`checkAme5_6AndAme10_10CompositeMdsFamily` — `Theorem 46B`). -/
def checkAme5_6AndAme10_10CompositeMdsFamily (n5 d6 n10 d10 : Nat) : Bool :=
  (n5 == 5) && (d6 == 6) && (n10 == 10) && (d10 == 10) &&
