    checkMpsBeatsDensityMatrixCliff 12 16 = true ∧
    checkMpsBeatsDensityMatrixCliff 20 16 = true ∧
    checkMpsBeatsDensityMatrixCliff 28 16 = true ∧
    checkMpsBeatsDensityMatrixCliff 36 16 = true ∧
