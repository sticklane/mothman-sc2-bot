-- ============================================================================
-- === Module: LakefillQ Unified Kernel Elaboration & Dynamic OpenQASM 3.0 Feedforward ===
-- ============================================================================

namespace LakefillQUnifiedCompilerProofs

inductive LeafGate where
  | gX      : Nat → LeafGate
  | gZ      : Nat → LeafGate
  | gH      : Nat → LeafGate
  | gCX     : Nat → Nat → LeafGate
  | gCZ     : Nat → Nat → LeafGate
  | gTempAnd : Nat → Nat → Nat → LeafGate
  | gMidMeasX : Nat → Nat → Bool → LeafGate
  | gCondZ  : Nat → Nat → LeafGate
  | gCondCZ : Nat → Nat → Nat → LeafGate
  deriving DecidableEq, Repr

inductive IsoKind where
  | isoOrthogonalPartition : Nat → IsoKind
  | isoWireRelabel         : Nat → IsoKind
  deriving DecidableEq, Repr

inductive LocalityKind where
  | locZipperFocus   : Nat → LocalityKind
  | locParallelProd  : LocalityKind
  | locMultishot     : Nat → LocalityKind
  deriving DecidableEq, Repr

inductive EraseTag where
  | eraseScratch  : List Nat → EraseTag
  | eraseQuotient : List Nat → EraseTag
  deriving DecidableEq, Repr

/-- Surface `#lang lakefillq` AST covering all composite surface combinators. -/
inductive SurfaceTerm where
  | sSkip           : SurfaceTerm
  | sGate           : LeafGate → SurfaceTerm
  | sSeq            : SurfaceTerm → SurfaceTerm → SurfaceTerm
  | sWithAndSession : Nat → Nat → Nat → SurfaceTerm → SurfaceTerm
  | sWithinApplyMbu : SurfaceTerm → SurfaceTerm → List Nat → SurfaceTerm
  | sEraseBy        : SurfaceTerm → SurfaceTerm → List Nat → SurfaceTerm
  | sCanonQuotient  : List Nat → SurfaceTerm → SurfaceTerm
  | sQMatch         : Nat → SurfaceTerm → SurfaceTerm → SurfaceTerm
  | sFocusZipper    : Nat → SurfaceTerm → SurfaceTerm
  | sFoldBraun      : Nat → SurfaceTerm → SurfaceTerm → SurfaceTerm → SurfaceTerm
  | sParWires       : SurfaceTerm → SurfaceTerm → SurfaceTerm
  | sMultishotReset : Nat → SurfaceTerm → SurfaceTerm
  deriving Repr

/-- Target AST with 6 kernel primitives plus aghost `kResidualSurface` constructor
    to witness syntactically that `elaborateToKern` leaves `0` surface forms. -/
inductive KernTerm where
  | kLinearLambda     : List LeafGate → KernTerm → KernTerm → KernTerm
  | kWithinApplyMbu   : KernTerm → KernTerm → List Nat → KernTerm
  | kEraseBy          : KernTerm → KernTerm → EraseTag → KernTerm
  | kInductiveIso     : IsoKind → KernTerm → KernTerm → KernTerm
  | kCatamorphismFold : Nat → KernTerm → KernTerm → KernTerm → KernTerm
  | kLocalityShift    : LocalityKind → KernTerm → KernTerm → KernTerm
  | kNil              : KernTerm
  | kResidualSurface  : Nat → KernTerm
  deriving Repr

def kernUnit : KernTerm := KernTerm.kNil

def residualSurfaceCount : KernTerm → Nat
  | KernTerm.kLinearLambda _ a b => residualSurfaceCount a + residualSurfaceCount b
  | KernTerm.kWithinApplyMbu c a _ => residualSurfaceCount c + residualSurfaceCount a
  | KernTerm.kEraseBy f b _ => residualSurfaceCount f + residualSurfaceCount b
  | KernTerm.kInductiveIso _ a b => residualSurfaceCount a + residualSurfaceCount b
  | KernTerm.kCatamorphismFold _ s l r =>
      residualSurfaceCount s + residualSurfaceCount l + residualSurfaceCount r
  | KernTerm.kLocalityShift _ a b => residualSurfaceCount a + residualSurfaceCount b
  | KernTerm.kNil => 0
  | KernTerm.kResidualSurface _ => 1

def elaborateToKern : SurfaceTerm → KernTerm
  | SurfaceTerm.sSkip =>
      KernTerm.kLinearLambda [] KernTerm.kNil KernTerm.kNil
  | SurfaceTerm.sGate g =>
      KernTerm.kLinearLambda [g] KernTerm.kNil KernTerm.kNil
  | SurfaceTerm.sSeq e1 e2 =>
      KernTerm.kLinearLambda [] (elaborateToKern e1) (elaborateToKern e2)
  | SurfaceTerm.sWithAndSession c1 c2 anc body =>
      KernTerm.kWithinApplyMbu
        (KernTerm.kLinearLambda [LeafGate.gTempAnd c1 c2 anc] KernTerm.kNil KernTerm.kNil)
        (elaborateToKern body)
        [anc]
  | SurfaceTerm.sWithinApplyMbu comp act ws =>
      KernTerm.kWithinApplyMbu (elaborateToKern comp) (elaborateToKern act) ws
  | SurfaceTerm.sEraseBy fwd bwd ws =>
      KernTerm.kEraseBy (elaborateToKern fwd) (elaborateToKern bwd) (EraseTag.eraseScratch ws)
  | SurfaceTerm.sCanonQuotient qws cleanup =>
      KernTerm.kEraseBy KernTerm.kNil (elaborateToKern cleanup) (EraseTag.eraseQuotient qws)
  | SurfaceTerm.sQMatch nArms arm1 arm2 =>
      KernTerm.kInductiveIso (IsoKind.isoOrthogonalPartition nArms)
        (elaborateToKern arm1) (elaborateToKern arm2)
  | SurfaceTerm.sFocusZipper regId body =>
      KernTerm.kLocalityShift (LocalityKind.locZipperFocus regId)
        (elaborateToKern body) KernTerm.kNil
  | SurfaceTerm.sFoldBraun idx step l r =>
      KernTerm.kCatamorphismFold idx
        (elaborateToKern step) (elaborateToKern l) (elaborateToKern r)
  | SurfaceTerm.sParWires e1 e2 =>
      KernTerm.kLocalityShift LocalityKind.locParallelProd
        (elaborateToKern e1) (elaborateToKern e2)
  | SurfaceTerm.sMultishotReset k body =>
      KernTerm.kLocalityShift (LocalityKind.locMultishot k)
        (elaborateToKern body) KernTerm.kNil

/-- Elaborating any `LakefillQ` surface program into `lambda_LFQ_kern`
    produces strictly `0` residual surface forms. -/
theorem elaborateToKern_zero_residual_forms (e : SurfaceTerm) :
    residualSurfaceCount (elaborateToKern e) = 0 := by
  induction e with
  | sSkip => rfl
  | sGate _ => rfl
  | sSeq _ _ ih1 ih2 => simp [elaborateToKern, residualSurfaceCount, ih1, ih2]
  | sWithAndSession _ _ _ _ ih => simp [elaborateToKern, residualSurfaceCount, ih]
  | sWithinApplyMbu _ _ _ ih1 ih2 => simp [elaborateToKern, residualSurfaceCount, ih1, ih2]
  | sEraseBy _ _ _ ih1 ih2 => simp [elaborateToKern, residualSurfaceCount, ih1, ih2]
  | sCanonQuotient _ _ ih => simp [elaborateToKern, residualSurfaceCount, ih]
  | sQMatch _ _ _ ih1 ih2 => simp [elaborateToKern, residualSurfaceCount, ih1, ih2]
  | sFocusZipper _ _ ih => simp [elaborateToKern, residualSurfaceCount, ih]
  | sFoldBraun _ _ _ _ ihs ihl ihr =>
      simp [elaborateToKern, residualSurfaceCount, ihs, ihl, ihr]
  | sParWires _ _ ih1 ih2 => simp [elaborateToKern, residualSurfaceCount, ih1, ih2]
  | sMultishotReset _ _ ih => simp [elaborateToKern, residualSurfaceCount, ih]

/-- Three-wire + quantum-phase-sign state `(c1, c2, anc, signBit)` where `signBit = true`
    denotes relative quantum phase `-1` (`(-1)^1`) and `false` denotes `+1` (`(-1)^0`). -/
structure MbuTripleState where
  c1      : Bool
  c2      : Bool
  anc     : Bool
  signBit : Bool
  deriving DecidableEq, Repr

/-- Forward `TempAND` (`ccx q[c1], q[c2], q[a];`). -/
def execQasmCCX (st : MbuTripleState) : MbuTripleState :=
  { st with anc := xor st.anc (st.c1 && st.c2) }

/-- Action body flipping external target bit `outBit` controlled on `anc` (`cx q[a], q[out];`). -/
def execActionXor (st : MbuTripleState) (outBit : Bool) : Bool :=
  xor outBit st.anc

/-- Hadamard-dual mid-circuit measurement `h q[a]; m[k] = measure q[a];` under outcome `mk`:
    kicks back relative sign `mk && st.anc` and collapses `q[a]` to `mk`. -/
def execQasmHadMeasure (st : MbuTripleState) (mk : Bool) : MbuTripleState :=
  { st with anc := mk, signBit := xor st.signBit (mk && st.anc) }

/-- Dynamic OpenQASM 3.0 feedforward `if (m[k] == 1) { cz q[c1], q[c2]; }`. -/
def execQasmIfMeasCZ (st : MbuTripleState) (mk : Bool) : MbuTripleState :=
  { st with signBit := xor st.signBit (mk && (st.c1 && st.c2)) }

/-- Deterministic OpenQASM 3.0 `reset q[a];` returning `q[a]` to `|0>` (`false`). -/
def execQasmResetAnc (st : MbuTripleState) : MbuTripleState :=
  { st with anc := false }

/-- Complete OpenQASM 3.0 asymmetric `within-apply-mbu` sequence emitted by `lakefillqc`. -/
def execOpenQasm3MbuSession (b1 b2 initSign outBit mk : Bool) : MbuTripleState × Bool :=
  let s0 : MbuTripleState := { c1 := b1, c2 := b2, anc := false, signBit := initSign }
  let s1 := execQasmCCX s0
  let out1 := execActionXor s1 outBit
  let s2 := execQasmHadMeasure s1 mk
  let s3 := execQasmIfMeasCZ s2 mk
  let s4 := execQasmResetAnc s3
  (s4, out1)

/-- Across BOTH measurement outcomes `mk ∈ {false, true}` and all basis inputs
    `(b1, b2)`, OpenQASM 3.0 `if (m[k] == 1) { cz q[c1], q[c2]; } reset q[a];` cancels
    the `M_X` quantum phase kickback identically, preserves `(b1, b2)`, resets `anc = false`,
    and computes the exact Toffoli target `xor outBit (b1 && b2)` with `0` uncompute `CCX`s. -/
theorem openqasm3_mbu_feedforward_sound
    (b1 b2 initSign outBit mk : Bool) :
    execOpenQasm3MbuSession b1 b2 initSign outBit mk =
      ({ c1 := b1, c2 := b2, anc := false, signBit := initSign },
       xor outBit (b1 && b2)) := by
  cases b1 <;> cases b2 <;> cases initSign <;> cases outBit <;> cases mk <;> rfl

/-- Sequential chordal SSA reuse of the SAME physical ancilla wire across two `within-apply-mbu`
    sessions with independent control pairs `(a1, a2)` and `(d1, d2)` and outcomes `(mk1, mk2)`. -/
def execTwoChordalRecycledSessions
    (a1 a2 d1 d2 outA outD mk1 mk2 : Bool) : Bool × Bool × Bool × Bool :=
  let (st1, resA) := execOpenQasm3MbuSession a1 a2 false outA mk1
  let sNext0 : MbuTripleState := { c1 := d1, c2 := d2, anc := st1.anc, signBit := st1.signBit }
  let sNext1 := execQasmCCX sNext0
  let resD := execActionXor sNext1 outD
  let sNext2 := execQasmResetAnc (execQasmIfMeasCZ (execQasmHadMeasure sNext1 mk2) mk2)
  (resA, resD, sNext2.anc, sNext2.signBit)

/-- Chordal SSA live-range wire recycling after `M_X + reset` is 100% observationally
    equivalent to allocating fresh clean ancillas, leaving `0` ancilla leakage and `0` phase taint. -/
theorem chordal_ssa_wire_recycling_sound
    (a1 a2 d1 d2 outA outD mk1 mk2 : Bool) :
    execTwoChordalRecycledSessions a1 a2 d1 d2 outA outD mk1 mk2 =
      (xor outA (a1 && a2), xor outD (d1 && d2), false, false) := by
  cases a1 <;> cases a2 <;> cases d1 <;> cases d2 <;>
    cases outA <;> cases outD <;> cases mk1 <;> cases mk2 <;> rfl

/-- Zero-ancilla distinct-pivot linear fan-in (`pR ∉ lhs`): fanning `rOther` into
    `pR` first (even when `pL` participates in `rhs`) and fanning `lOther` into `pL` second
    computes exact parities `(xor pL lOther, xor (xor pR pL) rOther)` and restores `(pL, pR)`. -/
theorem zero_ancilla_distinct_pivot_fanin_sound (pL pR lOther rOther : Bool) :
    let pR_fanned := xor (xor pR pL) rOther
    let pL_fanned := xor pL lOther
    let prod := pL_fanned && pR_fanned
    let pL_restored := xor pL_fanned lOther
    let pR_restored := xor (xor pR_fanned rOther) pL_restored
    (prod, pL_restored, pR_restored) =
      ((xor pL lOther) && (xor pR (xor pL rOther)), pL, pR) := by
  cases pL <;> cases pR <;> cases lOther <;> cases rOther <;> rfl

/-- Domain-guard canonical Zhegalkin ideal reduction soundness:
    for all boolean evaluations `gVal` and `pVal`, `(gVal && pVal) = false` iff
    whenever the domain guard holds (`gVal = true`), the wire polynomial vanishes (`pVal = false`). -/
theorem domain_guard_ideal_zero_iff (gVal pVal : Bool) :
    ((gVal && pVal) = false) ↔ (gVal = true → pVal = false) := by
  cases gVal <;> cases pVal <;> decide

inductive ViolationClass where
  | vU1EraseBy       : ViolationClass
  | vU2Canonical     : ViolationClass
  | vU3TotalOn       : ViolationClass
  | vU4QTainted      : ViolationClass
  | vPhi1Decoherence : ViolationClass
  | vPhi2Exclusion   : ViolationClass
  | vPhi3FaultExp    : ViolationClass
  deriving DecidableEq, Repr

structure StaticObligations where
  u1ResidualScratch  : Nat
  u2ResidualQuotient : Nat
  u3GuardDefect      : Nat
  u4ResidualTaint    : Nat
  activeVolMilli     : Nat
  mbuSpectatorExcess : Nat
  hasXy4Echo         : Bool
  multishotK         : Nat
  phi2Collisions     : Nat
  nominalCodeDist    : Nat
  hookAligned        : Bool
  usesFloat64Deep    : Bool
  deriving DecidableEq, Repr

def effectiveLindbladMilli (st : StaticObligations) : Nat :=
  let shottedVol := st.activeVolMilli / (max 1 st.multishotK)
  let mbuPen := if st.hasXy4Echo then 0 else 700 * st.mbuSpectatorExcess
  shottedVol + mbuPen

def effectiveFaultDistance (st : StaticObligations) : Nat :=
  if st.usesFloat64Deep then 0
  else if st.hookAligned then (st.nominalCodeDist + 1) / 2
  else st.nominalCodeDist

def requiredFaultDistance (st : StaticObligations) : Nat :=
  max 3 st.nominalCodeDist

def inferViolations (st : StaticObligations) : List ViolationClass :=
  (if st.u1ResidualScratch == 0 then [] else [ViolationClass.vU1EraseBy]) ++
  (if st.u2ResidualQuotient == 0 then [] else [ViolationClass.vU2Canonical]) ++
  (if st.u3GuardDefect == 0 then [] else [ViolationClass.vU3TotalOn]) ++
  (if st.u4ResidualTaint == 0 then [] else [ViolationClass.vU4QTainted]) ++
  (if effectiveLindbladMilli st <= 693 then [] else [ViolationClass.vPhi1Decoherence]) ++
  (if st.phi2Collisions == 0 then [] else [ViolationClass.vPhi2Exclusion]) ++
  (if requiredFaultDistance st <= effectiveFaultDistance st then [] else [ViolationClass.vPhi3FaultExp])

def isWellTyped (st : StaticObligations) : Bool :=
  (st.u1ResidualScratch == 0) &&
  (st.u2ResidualQuotient == 0) &&
  (st.u3GuardDefect == 0) &&
  (st.u4ResidualTaint == 0) &&
  (decide (effectiveLindbladMilli st <= 693)) &&
  (st.phi2Collisions == 0) &&
  (decide (requiredFaultDistance st <= effectiveFaultDistance st))

/-- `isWellTyped st = true` guarantees all 4 logical `QSub` laws (`U1-U4`)
    and all 3 physical `QPhysGrade` laws (`Phi1-Phi3`) simultaneously. -/
theorem isWellTyped_sound (st : StaticObligations)
    (hOk : isWellTyped st = true) :
    st.u1ResidualScratch = 0 ∧
    st.u2ResidualQuotient = 0 ∧
    st.u3GuardDefect = 0 ∧
    st.u4ResidualTaint = 0 ∧
    effectiveLindbladMilli st ≤ 693 ∧
    st.phi2Collisions = 0 ∧
    requiredFaultDistance st ≤ effectiveFaultDistance st := by
  simp only [isWellTyped, Bool.and_eq_true, beq_iff_eq, decide_eq_true_eq] at hOk
  rcases hOk with ⟨⟨⟨⟨⟨⟨h1, h2⟩, h3⟩, h4⟩, h5⟩, h6⟩, h7⟩
  exact ⟨h1, h2, h3, h4, h5, h6, h7⟩

theorem rejects_u1_violation (st : StaticObligations) (h : st.u1ResidualScratch > 0) :
    ViolationClass.vU1EraseBy ∈ inferViolations st ∧ isWellTyped st = false := by
  have hNe : (st.u1ResidualScratch == 0) = false := beq_false_of_ne (Nat.ne_of_gt h)
  simp [inferViolations, isWellTyped, hNe]

theorem rejects_u2_violation (st : StaticObligations) (h : st.u2ResidualQuotient > 0) :
    ViolationClass.vU2Canonical ∈ inferViolations st ∧ isWellTyped st = false := by
  have hNe : (st.u2ResidualQuotient == 0) = false := beq_false_of_ne (Nat.ne_of_gt h)
  simp [inferViolations, isWellTyped, hNe]

theorem rejects_u3_violation (st : StaticObligations) (h : st.u3GuardDefect > 0) :
    ViolationClass.vU3TotalOn ∈ inferViolations st ∧ isWellTyped st = false := by
  have hNe : (st.u3GuardDefect == 0) = false := beq_false_of_ne (Nat.ne_of_gt h)
  simp [inferViolations, isWellTyped, hNe]

theorem rejects_u4_violation (st : StaticObligations) (h : st.u4ResidualTaint > 0) :
    ViolationClass.vU4QTainted ∈ inferViolations st ∧ isWellTyped st = false := by
  have hNe : (st.u4ResidualTaint == 0) = false := beq_false_of_ne (Nat.ne_of_gt h)
  simp [inferViolations, isWellTyped, hNe]

theorem rejects_phi1_violation (st : StaticObligations) (h : 693 < effectiveLindbladMilli st) :
    ViolationClass.vPhi1Decoherence ∈ inferViolations st ∧ isWellTyped st = false := by
  have hNotLe : ¬ (effectiveLindbladMilli st ≤ 693) := Nat.not_le_of_gt h
  simp [inferViolations, isWellTyped, hNotLe]

theorem rejects_phi2_violation (st : StaticObligations) (h : st.phi2Collisions > 0) :
    ViolationClass.vPhi2Exclusion ∈ inferViolations st ∧ isWellTyped st = false := by
  have hNe : (st.phi2Collisions == 0) = false := beq_false_of_ne (Nat.ne_of_gt h)
  simp [inferViolations, isWellTyped, hNe]

theorem rejects_phi3_violation (st : StaticObligations)
    (h : effectiveFaultDistance st < requiredFaultDistance st) :
    ViolationClass.vPhi3FaultExp ∈ inferViolations st ∧ isWellTyped st = false := by
  have hNotLe : ¬ (requiredFaultDistance st ≤ effectiveFaultDistance st) := Nat.not_le_of_gt h
  simp [inferViolations, isWellTyped, hNotLe]

/-- Counterexample-guided physical repair operator (`XY4` echo + multishot checkpointing +
    2-color coupler exclusion scheduling + `N-Z-S-W` hook-orthogonal ordering + exact dyadic). -/
def repairPhysGrade (st : StaticObligations) : StaticObligations :=
  { st with
    hasXy4Echo      := true
    multishotK      := st.activeVolMilli / 693 + 1
    phi2Collisions  := 0
    nominalCodeDist := max 3 st.nominalCodeDist
    hookAligned     := false
    usesFloat64Deep := false }

theorem div_succ_quot_le_693 (v : Nat) : v / (v / 693 + 1) ≤ 693 := by
  apply Nat.div_le_of_le_mul
  have hMod : v % 693 < 693 := Nat.mod_lt v (by decide)
  have hEq : 693 * (v / 693) + v % 693 = v := Nat.div_add_mod v 693
  omega

/-- For ANY logically sound `QSub` program (`U1-U4` satisfied),
    `repairPhysGrade` restores `isWellTyped (repairPhysGrade st) = true` while
    preserving all logical `U1-U4` obligations identically. -/
theorem repairPhysGrade_restores_wellTyped (st : StaticObligations)
    (hU1 : st.u1ResidualScratch = 0)
    (hU2 : st.u2ResidualQuotient = 0)
    (hU3 : st.u3GuardDefect = 0)
    (hU4 : st.u4ResidualTaint = 0) :
    isWellTyped (repairPhysGrade st) = true ∧ inferViolations (repairPhysGrade st) = [] := by
  have hMax : max 1 (st.activeVolMilli / 693 + 1) = st.activeVolMilli / 693 + 1 := by omega
  have hPhi1 : effectiveLindbladMilli (repairPhysGrade st) ≤ 693 := by
    simp only [effectiveLindbladMilli, repairPhysGrade, hMax, ite_true, Nat.add_zero]
    exact div_succ_quot_le_693 st.activeVolMilli
  have hPhi3 : requiredFaultDistance (repairPhysGrade st) ≤
      effectiveFaultDistance (repairPhysGrade st) := by
    simp [requiredFaultDistance, effectiveFaultDistance, repairPhysGrade]
    omega
  have hF : (repairPhysGrade st).u1ResidualScratch = 0 ∧
            (repairPhysGrade st).u2ResidualQuotient = 0 ∧
            (repairPhysGrade st).u3GuardDefect = 0 ∧
            (repairPhysGrade st).u4ResidualTaint = 0 ∧
            (repairPhysGrade st).phi2Collisions = 0 := ⟨hU1, hU2, hU3, hU4, rfl⟩
  rcases hF with ⟨r1, r2, r3, r4, r5⟩
  simp [isWellTyped, inferViolations, r1, r2, r3, r4, r5, hPhi1, hPhi3]

end LakefillQUnifiedCompilerProofs

/-- Executable sanity check for `LakefillQ` unified kernel elaboration and OpenQASM 3.0 feedforward. -/
def verifyLakefillQUnifiedCompilerModuleSanity (_ : Unit) : Bool :=
  open LakefillQUnifiedCompilerProofs in
  let sampleProg : SurfaceTerm :=
    SurfaceTerm.sSeq
      (SurfaceTerm.sWithAndSession 0 1 2 (SurfaceTerm.sGate (LeafGate.gCX 2 3)))
      (SurfaceTerm.sSeq
        (SurfaceTerm.sCanonQuotient [4] (SurfaceTerm.sFocusZipper 0 SurfaceTerm.sSkip))
        (SurfaceTerm.sMultishotReset 2
          (SurfaceTerm.sParWires
            (SurfaceTerm.sQMatch 2 SurfaceTerm.sSkip (SurfaceTerm.sGate (LeafGate.gZ 0)))
            (SurfaceTerm.sFoldBraun 1 SurfaceTerm.sSkip SurfaceTerm.sSkip SurfaceTerm.sSkip))))
  let elabOk := residualSurfaceCount (elaborateToKern sampleProg) == 0
  let qasmOk :=
    (execOpenQasm3MbuSession true true false false true ==
      ({ c1 := true, c2 := true, anc := false, signBit := false }, true)) &&
    (execOpenQasm3MbuSession true true false false false ==
      ({ c1 := true, c2 := true, anc := false, signBit := false }, true))
  let chordalOk :=
    execTwoChordalRecycledSessions true true true false false true true true ==
      (true, true, false, false)
  let badObl : StaticObligations :=
    { u1ResidualScratch := 0, u2ResidualQuotient := 0, u3GuardDefect := 0,
      u4ResidualTaint := 0, activeVolMilli := 1500, mbuSpectatorExcess := 2,
      hasXy4Echo := false, multishotK := 1, phi2Collisions := 3,
      nominalCodeDist := 5, hookAligned := true, usesFloat64Deep := true }
  let repairOk :=
    (isWellTyped badObl == false) &&
    (isWellTyped (repairPhysGrade badObl) == true) &&
    (inferViolations (repairPhysGrade badObl) == [])
  elabOk && qasmOk && chordalOk && repairOk

/-- **(`lakefillq_unified_compiler_module_closure`)**:
    Module closure certifying zero-residual `LakefillQ` kernel elaboration, dynamic OpenQASM 3.0
    `M_X + if(m[k]==1) cz + reset` feedforward exactness, chordal SSA ancilla wire recycling,
    and counterexample-guided `QPhysGrade` repair. -/
theorem lakefillq_unified_compiler_module_closure
    (e : LakefillQUnifiedCompilerProofs.SurfaceTerm)
    (b1 b2 initSign outBit mk a1 a2 d1 d2 outA outD mk1 mk2 : Bool)
    (st : LakefillQUnifiedCompilerProofs.StaticObligations) :
    LakefillQUnifiedCompilerProofs.residualSurfaceCount
      (LakefillQUnifiedCompilerProofs.elaborateToKern e) = 0 ∧
    LakefillQUnifiedCompilerProofs.execOpenQasm3MbuSession b1 b2 initSign outBit mk =
      ({ c1 := b1, c2 := b2, anc := false, signBit := initSign }, xor outBit (b1 && b2)) ∧
    LakefillQUnifiedCompilerProofs.execTwoChordalRecycledSessions a1 a2 d1 d2 outA outD mk1 mk2 =
      (xor outA (a1 && a2), xor outD (d1 && d2), false, false) ∧
    (st.u1ResidualScratch = 0 → st.u2ResidualQuotient = 0 →
     st.u3GuardDefect = 0 → st.u4ResidualTaint = 0 →
     LakefillQUnifiedCompilerProofs.isWellTyped
       (LakefillQUnifiedCompilerProofs.repairPhysGrade st) = true) ∧
    verifyLakefillQUnifiedCompilerModuleSanity () = true := by
  exact ⟨LakefillQUnifiedCompilerProofs.elaborateToKern_zero_residual_forms e,
         LakefillQUnifiedCompilerProofs.openqasm3_mbu_feedforward_sound b1 b2 initSign outBit mk,
         LakefillQUnifiedCompilerProofs.chordal_ssa_wire_recycling_sound
           a1 a2 d1 d2 outA outD mk1 mk2,
         fun h1 h2 h3 h4 =>
           (LakefillQUnifiedCompilerProofs.repairPhysGrade_restores_wellTyped st h1 h2 h3 h4).1,
         by decide⟩

-- ============================================================================
-- === Module: Hash-Consed XAG/FRAIG Multi-Round Symbolic QSub & Bilinear Phase Inference ===
-- ============================================================================

namespace LakefillQXagFraigSymbolicInferenceProofs

/-- Positive XOR-AND-Inverter Graph (`XAG`) internal node grammar. -/
inductive XagNode where
  | constZero : XagNode
  | var : Nat → XagNode
  | xor2 : XagNode → XagNode → XagNode
  | and2 : XagNode → Bool → XagNode → Bool → XagNode
  deriving DecidableEq, Repr

/-- Signed `XAG` edge literal (`inv = true` complements the target node in $O(1)$). -/
structure XagLit where
  node : XagNode
  inv : Bool
  deriving DecidableEq, Repr

def litZero : XagLit := { node := XagNode.constZero, inv := false }
def litOne  : XagLit := { node := XagNode.constZero, inv := true }
def litVar (v : Nat) : XagLit := { node := XagNode.var v, inv := false }
def litNot (l : XagLit) : XagLit := { node := l.node, inv := !l.inv }

/-- Boolean wire-assignment semantics of positive `XAG` nodes. -/
def evalXagNode (env : Nat → Bool) : XagNode → Bool
  | XagNode.constZero => false
  | XagNode.var idx => env idx
  | XagNode.xor2 u v => xor (evalXagNode env u) (evalXagNode env v)
  | XagNode.and2 u invU v invV =>
    (xor invU (evalXagNode env u)) && (xor invV (evalXagNode env v))

/-- Boolean semantics of a signed `XAG` literal (`inv ⊕ evalXagNode env node`). -/
def evalXagLit (env : Nat → Bool) (l : XagLit) : Bool :=
  xor l.inv (evalXagNode env l.node)

/-- Structural hash-consing smart constructor for `XOR` with identity & self-cancellation. -/
def mkXorSmart (l1 l2 : XagLit) : XagLit :=
  let outInv := xor l1.inv l2.inv
  if l1.node == XagNode.constZero then
    { node := l2.node, inv := outInv }
  else if l2.node == XagNode.constZero then
    { node := l1.node, inv := outInv }
  else if l1.node == l2.node then
    { node := XagNode.constZero, inv := outInv }
  else
    { node := XagNode.xor2 l1.node l2.node, inv := outInv }

/-- Structural hash-consing smart constructor for `AND` (`u & 0 = 0`, `u & u = u`, `u & ~u = 0`). -/
def mkAndSmart (l1 l2 : XagLit) : XagLit :=
  if l1 == litZero || l2 == litZero then
    litZero
  else if l1 == litOne then
    l2
  else if l2 == litOne then
    l1
  else if l1 == l2 then
    l1
  else if l1 == litNot l2 then
    litZero
  else
    { node := XagNode.and2 l1.node l1.inv l2.node l2.inv, inv := false }

theorem xag_lit_not_involution_and_semantics (env : Nat → Bool) (l : XagLit) :
    litNot (litNot l) = l ∧ evalXagLit env (litNot l) = !(evalXagLit env l) := by
  cases l with
  | mk nd iv =>
    simp only [litNot, evalXagLit]
    cases iv <;> cases evalXagNode env nd <;> simp

theorem xag_smart_xor_self_cancels (l : XagLit) :
    mkXorSmart l l = litZero ∧ mkXorSmart l (litNot l) = litOne := by
  cases l with
  | mk nd iv =>
    simp only [mkXorSmart, litNot, litZero, litOne]
    by_cases hz : (nd == XagNode.constZero) = true
    · have hnd : nd = XagNode.constZero := eq_of_beq hz
      subst hnd
      cases iv <;> decide
    · simp only [Bool.not_eq_true] at hz
      have hself : (nd == nd) = true := beq_self_eq_true nd
      simp only [hz, Bool.false_eq_true, ↓reduceIte, hself]
      cases iv <;> decide

theorem xag_smart_xor_preserves_semantics (env : Nat → Bool) (l1 l2 : XagLit) :
    evalXagLit env (mkXorSmart l1 l2) = xor (evalXagLit env l1) (evalXagLit env l2) := by
  simp only [mkXorSmart]
  by_cases e1 : l1.node = XagNode.constZero
  · simp only [e1, beq_self_eq_true, ↓reduceIte, evalXagLit, evalXagNode]
    cases l1.inv <;> cases l2.inv <;> cases evalXagNode env l2.node <;> rfl
  · have b1 : (l1.node == XagNode.constZero) = false := beq_eq_false_iff_ne.mpr e1
    by_cases e2 : l2.node = XagNode.constZero
    · simp only [b1, Bool.false_eq_true, ↓reduceIte, e2, beq_self_eq_true, evalXagLit, evalXagNode]
      cases l1.inv <;> cases l2.inv <;> cases evalXagNode env l1.node <;> rfl
    · have b2 : (l2.node == XagNode.constZero) = false := beq_eq_false_iff_ne.mpr e2
      by_cases e12 : l1.node = l2.node
      · simp only [b2, Bool.false_eq_true, ↓reduceIte, e12, beq_self_eq_true, evalXagLit, evalXagNode]
        cases l1.inv <;> cases l2.inv <;> cases evalXagNode env l2.node <;> rfl
      · have b12 : (l1.node == l2.node) = false := beq_eq_false_iff_ne.mpr e12
        simp only [b1, b2, b12, Bool.false_eq_true, ↓reduceIte, evalXagLit, evalXagNode]
        cases l1.inv <;> cases l2.inv <;> cases evalXagNode env l1.node <;> cases evalXagNode env l2.node <;> rfl

theorem xag_smart_and_zero_self_and_not_self (l : XagLit) :
    mkAndSmart l litZero = litZero ∧
    mkAndSmart l l = l ∧
    mkAndSmart l (litNot l) = litZero := by
  refine ⟨by simp [mkAndSmart], ?_, ?_⟩
  · simp only [mkAndSmart]
    by_cases hz : l = litZero
    · subst hz; decide
    · by_cases ho : l = litOne
      · subst ho; decide
      · simp [beq_eq_false_iff_ne.mpr hz, beq_eq_false_iff_ne.mpr ho]
  · cases l with
    | mk nd iv =>
      by_cases hnd : nd = XagNode.constZero
      · subst hnd; cases iv <;> decide
      · have hnz1 : ({ node := nd, inv := iv } == litZero) = false := beq_eq_false_iff_ne.mpr (fun h => hnd (congrArg XagLit.node h))
        have hnz2 : (litNot { node := nd, inv := iv } == litZero) = false := beq_eq_false_iff_ne.mpr (fun h => hnd (congrArg XagLit.node h))
        have hno1 : ({ node := nd, inv := iv } == litOne) = false := beq_eq_false_iff_ne.mpr (fun h => hnd (congrArg XagLit.node h))
        have hno2 : (litNot { node := nd, inv := iv } == litOne) = false := beq_eq_false_iff_ne.mpr (fun h => hnd (congrArg XagLit.node h))
        have hneq : ({ node := nd, inv := iv } == litNot { node := nd, inv := iv }) = false := by cases iv <;> simp [litNot]
        have hnot : ({ node := nd, inv := iv } == litNot (litNot { node := nd, inv := iv })) = true := by cases iv <;> simp [litNot]
        simp only [mkAndSmart, hnz1, hnz2, Bool.or_self, Bool.false_eq_true, ↓reduceIte, hno1, hno2, hneq, hnot]

theorem evalXagLit_zero_and_one (env : Nat → Bool) :
    evalXagLit env litZero = false ∧ evalXagLit env litOne = true := by
  simp [litZero, litOne, evalXagLit, evalXagNode]

theorem xag_smart_and_preserves_semantics (env : Nat → Bool) (l1 l2 : XagLit) :
    evalXagLit env (mkAndSmart l1 l2) = (evalXagLit env l1 && evalXagLit env l2) := by
  simp only [mkAndSmart]
  by_cases hz : (l1 == litZero || l2 == litZero) = true
  · simp only [hz, ↓reduceIte, (evalXagLit_zero_and_one env).1]
    rcases Bool.or_eq_true_iff.mp hz with h1 | h2
    · rw [eq_of_beq h1, (evalXagLit_zero_and_one env).1]; rfl
    · rw [eq_of_beq h2, (evalXagLit_zero_and_one env).1]; cases evalXagLit env l1 <;> rfl
  · simp only [Bool.not_eq_true] at hz
    by_cases ho1 : (l1 == litOne) = true
    · simp only [hz, Bool.false_eq_true, ↓reduceIte, ho1]; rw [eq_of_beq ho1, (evalXagLit_zero_and_one env).2, Bool.true_and]
    · simp only [Bool.not_eq_true] at ho1
      by_cases ho2 : (l2 == litOne) = true
      · simp only [hz, ho1, Bool.false_eq_true, ↓reduceIte, ho2]; rw [eq_of_beq ho2, (evalXagLit_zero_and_one env).2, Bool.and_true]
      · simp only [Bool.not_eq_true] at ho2
        by_cases heq : (l1 == l2) = true
        · simp only [hz, ho1, ho2, Bool.false_eq_true, ↓reduceIte, heq]; rw [eq_of_beq heq, Bool.and_self]
        · simp only [Bool.not_eq_true] at heq
          by_cases hneg : (l1 == litNot l2) = true
          · simp only [hz, ho1, ho2, heq, Bool.false_eq_true, ↓reduceIte, hneg]
            rw [eq_of_beq hneg, (evalXagLit_zero_and_one env).1, (xag_lit_not_involution_and_semantics env l2).2]
            cases evalXagLit env l2 <;> rfl
          · simp only [Bool.not_eq_true] at hneg
            simp [hz, ho1, ho2, heq, hneg, evalXagLit, evalXagNode]

/-- Parallel truth-table signature vector across a sample list of input environments. -/
def evalSimSignature (l : XagLit) : List (Nat → Bool) → List Bool
  | [] => []
  | env :: rest => evalXagLit env l :: evalSimSignature l rest

theorem sim_signature_mismatch_refutes_xag_equivalence
    (samples : List (Nat → Bool)) (l1 l2 : XagLit)
    (hne : evalSimSignature l1 samples ≠ evalSimSignature l2 samples) :
    ∃ env, evalXagLit env l1 ≠ evalXagLit env l2 := by
  induction samples with
  | nil =>
    exact False.elim (hne rfl)
  | cons env rest ih =>
    by_cases hhead : evalXagLit env l1 = evalXagLit env l2
    · apply ih
      intro htail
      apply hne
      simp [evalSimSignature, hhead, htail]
    · exact ⟨env, hhead⟩

/-- Quantum phase factor $(-1)^b \in \{-1, +1\}$ associated with Boolean exponent `b`. -/
def kickbackSign (b : Bool) : Int :=
  match b with
  | false => 1
  | true => -1

theorem kickbackSign_xor_homomorphism (a b : Bool) :
    kickbackSign (xor a b) = kickbackSign a * kickbackSign b := by
  cases a <;> cases b <;> rfl

/-- Symbolic `Law U4` coefficient update at `(mx anc m_k)`. -/
def mxUpdateCoeff (gk ancLit : XagLit) : XagLit :=
  mkXorSmart gk ancLit

/-- Symbolic `Law U4` coefficient update at `(cond-z m_k c1 c2)`. -/
def condCzUpdateCoeff (gk c1 c2 : XagLit) : XagLit :=
  mkXorSmart gk (mkAndSmart c1 c2)

/-- Even when `c1, c2` are degree-$d$ ($d \le 128$) multi-round cipher `XAG` cones,
    `(mx anc m_k)` followed by `(cond-z m_k c1 c2)` collapses `g_k` to `litZero` in $O(1)$. -/
theorem bilinear_xag_mbu_collapses_arbitrary_degree_to_zero (c1 c2 : XagLit) :
    condCzUpdateCoeff (mxUpdateCoeff litZero (mkAndSmart c1 c2)) c1 c2 = litZero := by
  unfold condCzUpdateCoeff mxUpdateCoeff
  have hid : mkXorSmart litZero (mkAndSmart c1 c2) = mkAndSmart c1 c2 := by
    cases mkAndSmart c1 c2 with
    | mk nd iv =>
      simp [mkXorSmart, litZero]
  rw [hid]
  exact (xag_smart_xor_self_cancels (mkAndSmart c1 c2)).1

/-- Whenever `mkXorSmart gk (mkAndSmart c1 c2) = litZero`, the quantum phase factor
    $(-1)^{m_k \cdot g_k'(x)}$ equals $+1$ for all measurement outcomes `mk` and inputs `env`. -/
theorem bilinear_xag_zero_coeff_implies_unit_quantum_phase
    (env : Nat → Bool) (mk : Bool) (gk c1 c2 : XagLit)
    (hcancel : condCzUpdateCoeff gk c1 c2 = litZero) :
    kickbackSign (mk && evalXagLit env (condCzUpdateCoeff gk c1 c2)) = 1 := by
  rw [hcancel, (evalXagLit_zero_and_one env).1]
  cases mk <;> rfl

/-- A recorded `TempAND + mx + cond-cz` session triple `(mk, c1, c2)`. -/
structure MbuSessionStep where
  measBit : Bool
  ctrl1 : XagLit
  ctrl2 : XagLit

/-- Cumulative quantum phase product across a multi-round sequence of `MBU` sessions. -/
def evalMultiRoundMbuKickback (env : Nat → Bool) : List MbuSessionStep → Int
  | [] => 1
  | s :: rest =>
    let gkFinal := condCzUpdateCoeff (mxUpdateCoeff litZero (mkAndSmart s.ctrl1 s.ctrl2)) s.ctrl1 s.ctrl2
    kickbackSign (s.measBit && evalXagLit env gkFinal) * evalMultiRoundMbuKickback env rest

theorem multiround_mbu_session_total_quantum_phase_unit
    (env : Nat → Bool) (sessions : List MbuSessionStep) :
    evalMultiRoundMbuKickback env sessions = 1 := by
  induction sessions with
  | nil =>
    rfl
  | cons s rest ih =>
    simp only [evalMultiRoundMbuKickback]
    have hzero : condCzUpdateCoeff (mxUpdateCoeff litZero (mkAndSmart s.ctrl1 s.ctrl2)) s.ctrl1 s.ctrl2 = litZero :=
      bilinear_xag_mbu_collapses_arbitrary_degree_to_zero s.ctrl1 s.ctrl2
    rw [bilinear_xag_zero_coeff_implies_unit_quantum_phase env s.measBit
          (mxUpdateCoeff litZero (mkAndSmart s.ctrl1 s.ctrl2)) s.ctrl1 s.ctrl2 hzero, ih]
    rfl

/-- Primitive wire-level `LakefillQ` gate operations tracked by the `XAG` interpreter. -/
inductive LakefillXagOp where
  | xGate : Nat → LakefillXagOp
  | cxGate : Nat → Nat → LakefillXagOp
  | tempAndGate : Nat → Nat → Nat → LakefillXagOp
  | mxGate : Nat → Nat → LakefillXagOp
  | condCzGate : Nat → Nat → Nat → LakefillXagOp
  deriving DecidableEq, Repr

/-- Worst-case newly allocated `XAG` nodes per gate (`0` for `X`, `1` for `CX`/`TempAND`/`MX`, `2` for `cond-CZ`). -/
def opNewXagNodeUpperBound : LakefillXagOp → Nat
  | LakefillXagOp.xGate _w => 0
  | LakefillXagOp.cxGate _c _t => 1
  | LakefillXagOp.tempAndGate _c1 _c2 _anc => 2
  | LakefillXagOp.mxGate _anc _m => 1
  | LakefillXagOp.condCzGate _m _c1 _c2 => 2

def totalXagNodeUpperBound : List LakefillXagOp → Nat
  | [] => 0
  | op :: rest => opNewXagNodeUpperBound op + totalXagNodeUpperBound rest

theorem xag_circuit_linear_node_bound (ops : List LakefillXagOp) :
    totalXagNodeUpperBound ops ≤ 2 * ops.length := by
  induction ops with
  | nil =>
    simp [totalXagNodeUpperBound]
  | cons op rest ih =>
    have hop : opNewXagNodeUpperBound op ≤ 2 := by
      cases op <;> simp [opNewXagNodeUpperBound]
    simp only [totalXagNodeUpperBound, List.length_cons]
    omega

/-- Exact explicit `ANF` monomial count for carry wire $c_k = a_k b_k \oplus c_{k-1}(a_k \oplus b_k)$. -/
def gidneyCarryAnfMonomials : Nat → Nat
  | 0 => 1
  | k + 1 => 2 * gidneyCarryAnfMonomials k + 1

/-- Exact `XAG` internal node count (`1 + 3k`) for the same $k$-bit Gidney carry chain. -/
def gidneyCarryXagNodes : Nat → Nat
  | 0 => 1
  | k + 1 => gidneyCarryXagNodes k + 3

theorem gidney_carry_explicit_anf_exponential_closed_form (k : Nat) :
    gidneyCarryAnfMonomials k + 1 = 2 ^ (k + 1) ∧ gidneyCarryXagNodes k = 3 * k + 1 := by
  induction k with
  | zero =>
    decide
  | succ m ih =>
    rcases ih with ⟨hanf, hxag⟩
    refine ⟨?_, ?_⟩
    · simp only [gidneyCarryAnfMonomials, Nat.pow_succ]
      omega
    · simp only [gidneyCarryXagNodes]
      omega

/-- Exact Pascal binomial coefficient $\binom{n}{k}$ without wildcard patterns. -/
def binom : Nat → Nat → Nat
  | 0, 0 => 1
  | 0, _k + 1 => 0
  | _n + 1, 0 => 1
  | n + 1, k + 1 => binom n k + binom n (k + 1)

theorem central_binom_step_ge_double (m : Nat) :
    2 * binom (2 * m) m ≤ binom (2 * (m + 1)) (m + 1) := by
  cases m with
  | zero =>
    decide
  | succ r =>
    have hsplit : 2 * (r + 1 + 1) = (2 * (r + 1) + 1) + 1 := by omega
    rw [hsplit]
    simp only [binom]
    omega

/-- Middle-slice explicit `ANF` over $2m$ variables satisfies $\binom{2m}{m} \ge 2^m$
    (e.g. $2m = 128 \implies \binom{128}{64} \ge 2^{64}$ monomials vs. linear $O(|G|)$ `XAG` size). -/
theorem central_binomial_anf_exponential_lower_bound (m : Nat) :
    2 ^ m ≤ binom (2 * m) m := by
  induction m with
  | zero =>
    decide
  | succ k ih =>
    have hstep : 2 * binom (2 * k) k ≤ binom (2 * (k + 1)) (k + 1) :=
      central_binom_step_ge_double k
    simp only [Nat.pow_succ]
    omega

/-- Topological `XAG` node definitions exported as 1-variable-per-node Tseitin equations. -/
inductive TseitinNodeDef where
  | primaryIn : Nat → TseitinNodeDef
  | xorNode : Nat → Nat → TseitinNodeDef
  | andNode : Nat → Bool → Nat → Bool → TseitinNodeDef
  deriving DecidableEq, Repr

/-- Functional DAG evaluation of node definitions in topological order. -/
def evalTseitinDag (env : Nat → Bool) : List TseitinNodeDef → (Nat → Bool)
  | [] => fun _id => false
  | d :: ds =>
    let prev := evalTseitinDag env ds
    let curId := ds.length
    let val :=
      match d with
      | TseitinNodeDef.primaryIn v => env v
      | TseitinNodeDef.xorNode u w => xor (prev u) (prev w)
      | TseitinNodeDef.andNode u iu w iw => (xor iu (prev u)) && (xor iw (prev w))
    fun q => if q == curId then val else prev q

/-- Well-formedness: every node definition references strictly earlier topological IDs (`< ds.length`). -/
def dagWellFormed : List TseitinNodeDef → Prop
  | [] => True
  | d :: ds =>
    dagWellFormed ds ∧
    match d with
    | TseitinNodeDef.primaryIn _v => True
    | TseitinNodeDef.xorNode u w => u < ds.length ∧ w < ds.length
    | TseitinNodeDef.andNode u _iu w _iw => u < ds.length ∧ w < ds.length

/-- Conjunction of 1-variable-per-node Tseitin equality constraints (`n_id ↔ op(...)`). -/
def satisfiesTseitin (env assign : Nat → Bool) : List TseitinNodeDef → Bool
  | [] => true
  | d :: ds =>
    let curId := ds.length
    let rhs :=
      match d with
      | TseitinNodeDef.primaryIn v => env v
      | TseitinNodeDef.xorNode u w => xor (assign u) (assign w)
      | TseitinNodeDef.andNode u iu w iw => (xor iu (assign u)) && (xor iw (assign w))
    (assign curId == rhs) && satisfiesTseitin env assign ds

theorem evalTseitinDag_prefix_invariant (env : Nat → Bool) (d : TseitinNodeDef)
    (ds : List TseitinNodeDef) (q : Nat) (hq : q < ds.length) :
    evalTseitinDag env (d :: ds) q = evalTseitinDag env ds q := by
  have hne : q ≠ ds.length := Nat.ne_of_lt hq
  simp [evalTseitinDag, hne]

theorem tseitin_dag_model_agrees_with_semantics
    (env assign : Nat → Bool) (dag : List TseitinNodeDef)
    (hwf : dagWellFormed dag) (hsat : satisfiesTseitin env assign dag = true) :
    ∀ q, q < dag.length → assign q = evalTseitinDag env dag q := by
  induction dag with
  | nil =>
    intro q hq; simp at hq
  | cons d ds ih =>
    rcases hwf with ⟨hwfDs, hdBound⟩
    rcases Bool.and_eq_true_iff.mp hsat with ⟨hcur, hrest⟩
    have hprev := ih hwfDs hrest
    intro q hq
    by_cases heq : q = ds.length
    · subst heq
      rw [eq_of_beq hcur]
      cases d with
      | primaryIn v => simp [evalTseitinDag]
      | xorNode u w =>
        simp [evalTseitinDag, hprev u hdBound.1, hprev w hdBound.2]
      | andNode u iu w iw =>
        simp [evalTseitinDag, hprev u hdBound.1, hprev w hdBound.2]
    · have hlt : q < ds.length := by simp at hq; omega
      rw [evalTseitinDag_prefix_invariant env d ds q hlt]
      exact hprev q hlt

theorem tseitin_canonical_eval_satisfies_defs
    (env : Nat → Bool) (dag : List TseitinNodeDef) (hwf : dagWellFormed dag) :
    satisfiesTseitin env (evalTseitinDag env dag) dag = true := by
  have hgen : ∀ (fullDag : List TseitinNodeDef) (f : Nat → Bool),
      dagWellFormed fullDag →
      (∀ q, q < fullDag.length → f q = evalTseitinDag env fullDag q) →
      satisfiesTseitin env f fullDag = true := by
    intro fullDag
    induction fullDag with
    | nil =>
      intro _f _hw _hag; rfl
    | cons d ds ih =>
      intro f ⟨hwfDs, hdBound⟩ hag
      have hagDs : ∀ q, q < ds.length → f q = evalTseitinDag env ds q := by
        intro q hq
        rw [hag q (Nat.lt_succ_of_lt hq), evalTseitinDag_prefix_invariant env d ds q hq]
      have hhead : f ds.length = evalTseitinDag env (d :: ds) ds.length :=
        hag ds.length (Nat.lt_succ_self ds.length)
      simp only [satisfiesTseitin, ih f hwfDs hagDs, Bool.and_true]
      cases d with
      | primaryIn v => simp [hhead, evalTseitinDag]
      | xorNode u w => simp [hhead, evalTseitinDag, hagDs u hdBound.1, hagDs w hdBound.2]
      | andNode u iu w iw => simp [hhead, evalTseitinDag, hagDs u hdBound.1, hagDs w hdBound.2]
  exact hgen dag (evalTseitinDag env dag) hwf (fun _q _hq => rfl)

/-- Soundness & completeness of the 1-variable-per-node `Z3` Tseitin DAG miter over ideal `dom`. -/
theorem tseitin_miter_unsat_iff_xag_domain_equivalence
    (dom : (Nat → Bool) → Bool) (dag : List TseitinNodeDef) (r1 r2 : Nat)
    (hwf : dagWellFormed dag) (hr1 : r1 < dag.length) (hr2 : r2 < dag.length) :
    (∀ env assign, dom env = true → satisfiesTseitin env assign dag = true →
      xor (assign r1) (assign r2) = false) ↔
    (∀ env, dom env = true → evalTseitinDag env dag r1 = evalTseitinDag env dag r2) := by
  constructor
  · intro hunsat env hdom
    have hsat := tseitin_canonical_eval_satisfies_defs env dag hwf
    have hxor := hunsat env (evalTseitinDag env dag) hdom hsat
    cases h1 : evalTseitinDag env dag r1 <;> cases h2 : evalTseitinDag env dag r2 <;>
      simp_all
  · intro heq env assign hdom hsat
    have a1 := tseitin_dag_model_agrees_with_semantics env assign dag hwf hsat r1 hr1
    have a2 := tseitin_dag_model_agrees_with_semantics env assign dag hwf hsat r2 hr2
    rw [a1, a2, heq env hdom]
    cases evalTseitinDag env dag r2 <;> rfl

/-- Soundness of Local Bottleneck Cut-Sweeping: if the local cut cone `localMiter` is `UNSAT`
    across all cut assignments `cutEnv`, then it vanishes across any multi-round upstream circuit
    `upstreamCone` and any domain subspace `dom`. -/
theorem cut_sweeping_local_unsat_implies_global_multiround_soundness
    (localMiter : (Nat → Bool) → Bool)
    (upstreamCone : (Nat → Bool) → (Nat → Bool))
    (dom : (Nat → Bool) → Bool)
    (hcutUnsat : ∀ cutEnv, localMiter cutEnv = false) :
    ∀ env, dom env = true → localMiter (upstreamCone env) = false := by
  intro env _hdom
  exact hcutUnsat (upstreamCone env)

end LakefillQXagFraigSymbolicInferenceProofs

/-- Executable sanity check for hash-consed `XAG`/`FRAIG` symbolic `QSub` and bilinear phase inference. -/
def verifyLakefillQXagFraigModuleSanity (_ : Unit) : Bool :=
  open LakefillQXagFraigSymbolicInferenceProofs in
  let v0 := litVar 0
  let v1 := litVar 1
  let cCone := mkXorSmart (mkAndSmart v0 v1) (litNot v0)
  let smartOk :=
    (mkXorSmart cCone cCone == litZero) &&
    (mkXorSmart cCone (litNot cCone) == litOne) &&
    (mkAndSmart cCone litZero == litZero) &&
    (mkAndSmart cCone cCone == cCone) &&
    (mkAndSmart cCone (litNot cCone) == litZero)
  let u4Ok :=
    (condCzUpdateCoeff (mxUpdateCoeff litZero (mkAndSmart cCone v1)) cCone v1 == litZero) &&
    (evalMultiRoundMbuKickback (fun i => i == 0)
      [{ measBit := true, ctrl1 := cCone, ctrl2 := v1 },
       { measBit := false, ctrl1 := v0, ctrl2 := cCone }] == 1)
  let sepOk :=
    (gidneyCarryAnfMonomials 15 == 65535) &&
    (gidneyCarryXagNodes 15 == 46) &&
    (binom 12 6 == 924)
  let sampleDag : List TseitinNodeDef :=
    [TseitinNodeDef.andNode 1 false 0 true,
     TseitinNodeDef.xorNode 0 0,
     TseitinNodeDef.primaryIn 0]
  let env0 : Nat → Bool := fun i => i == 0
  let dagOk := satisfiesTseitin env0 (evalTseitinDag env0 sampleDag) sampleDag
  smartOk && u4Ok && sepOk && dagOk

/-- **(`lakefillq_xag_fraig_module_closure`)**:
    Module closure certifying arbitrary-degree `XAG` `Law U4` phase cancellation, multi-round
    `MBU` unit quantum phase invariant, linear `O(|G|)` `XAG` size vs exponential explicit `ANF`
    central binomial lower bound, and `verifyLakefillQXagFraigModuleSanity () = true`. -/
theorem lakefillq_xag_fraig_module_closure
    (c1 c2 : LakefillQXagFraigSymbolicInferenceProofs.XagLit)
    (env : Nat → Bool)
    (sessions : List LakefillQXagFraigSymbolicInferenceProofs.MbuSessionStep)
    (ops : List LakefillQXagFraigSymbolicInferenceProofs.LakefillXagOp)
    (m : Nat) :
    LakefillQXagFraigSymbolicInferenceProofs.condCzUpdateCoeff
      (LakefillQXagFraigSymbolicInferenceProofs.mxUpdateCoeff
        LakefillQXagFraigSymbolicInferenceProofs.litZero
        (LakefillQXagFraigSymbolicInferenceProofs.mkAndSmart c1 c2)) c1 c2 =
      LakefillQXagFraigSymbolicInferenceProofs.litZero ∧
    LakefillQXagFraigSymbolicInferenceProofs.evalMultiRoundMbuKickback env sessions = 1 ∧
    LakefillQXagFraigSymbolicInferenceProofs.totalXagNodeUpperBound ops ≤ 2 * ops.length ∧
    2 ^ m ≤ LakefillQXagFraigSymbolicInferenceProofs.binom (2 * m) m ∧
    verifyLakefillQXagFraigModuleSanity () = true := by
  exact ⟨LakefillQXagFraigSymbolicInferenceProofs.bilinear_xag_mbu_collapses_arbitrary_degree_to_zero
           c1 c2,
         LakefillQXagFraigSymbolicInferenceProofs.multiround_mbu_session_total_quantum_phase_unit
           env sessions,
         LakefillQXagFraigSymbolicInferenceProofs.xag_circuit_linear_node_bound ops,
         LakefillQXagFraigSymbolicInferenceProofs.central_binomial_anf_exponential_lower_bound m,
         by decide⟩

