#lang lakefillq

;; =============================================================================
;; examples/early_mbu_dqi_bch7.lfq
;;
;; Early-MBU Decoded Quantum Interferometry (`DQI`) on `BCH(7, 4, 3)` (`x* = 5`).
;; Demonstrates:
;;   - Coherent Dicke weight-<=1 preparation (`prepare-dicke-le1`, `w0 = sqrt(7/32)`,
;;     `w1 = sqrt(25/32)`, `b_mask = 44`)
;;   - Early Hadamard-dual `M_X` + reset (`mid-meas-x`) freeing all `7` error
;;     wires before syndrome decoding (`10 -> 3` live data qubits!)
;;   - Balanced Okasaki Braun-tree structural recursion (`fold-braun`) decoding
;;     all `7` BCH columns with chordal SSA wire recycling (`24` virtual wires
;;     recycled onto `10` physical qubits!)
;;   - Annotation-free `Law U4` (`QTainted`) + `Law U1` (`EraseBy`) verification
;;     proving exact cancellation of all `7` random `M_X` quantum phase taints
;;     prior to Walsh-Hadamard interference (`P(x* = 5) = 4/7`)
;; =============================================================================

(target-profile bluvstein-aod)

(defconst bch7-b-mask 44)
(defconst bch7-w0 (sqrt (/ 7.0 32.0)))
(defconst bch7-w1 (sqrt (/ 25.0 32.0)))
(defconst bch7-meas-syms '(m_e0 m_e1 m_e2 m_e3 m_e4 m_e5 m_e6))

(defq (early-mbu-dqi-bch7
       #:wires ([e7 (range 0 7)]
                [syn3 (range 7 10)])
       #:scratch ([v-parity (range 10 17)]
                  [v-and-sc (range 17 24)])
       #:domain (domain-guard (g-all-zero '(7 8 9))))
  ;; 1. Coherent weight-<=1 Max-XORSAT Dicke state preparation on `e7`:
  (prepare-dicke-le1 e7 bch7-w0 bch7-w1 bch7-b-mask)

  ;; 2. Parity-check syndrome encoding `syn3 ^= H * e7` (`col j = j + 1`):
  (for/seq ([j (in-range 7)])
    (define col (add1 j))
    (for/seq ([r (in-range 3)] #:when (bitwise-bit-set? col r))
      (cx (wref e7 j) (wref syn3 r))))

  ;; 3. Early-MBU `M_X` + reset on all 7 error wires (`e_0..e_6` freed to `|0>`):
  (for/seq ([j (in-range 7)])
    (mid-meas-x (wref e7 j) (list-ref bch7-meas-syms j)))

  ;; 4. Balanced Okasaki Braun-tree syndrome decoding (`fold-braun`):
  ;;    Each Braun node `j` allocates virtual SSA scratch `(v-parity[j], v-and-sc[j])`
  ;;    (chordally recycled onto freed physical wires `0` and `1`!), computes
  ;;    `p_anc = [syn3 == j + 1]` via `within-apply-mbu`, and cancels `m_ej` via `cond-z`!
  (fold-braun
   (lambda (col j)
     (define m-sym (list-ref bch7-meas-syms j))
     (define p-anc (wref v-parity j))
     (define sc1 (wref v-and-sc j))
     (define s0 (wref syn3 0))
     (define s1 (wref syn3 1))
     (define s2 (wref syn3 2))
     (within-apply-mbu
      (seq
       (for/seq ([r (in-range 3)] #:when (not (bitwise-bit-set? col r)))
         (x (wref syn3 r)))
       (temp-and s0 s1 sc1)
       (temp-and sc1 s2 p-anc)
       (for/seq ([r (in-range 3)] #:when (not (bitwise-bit-set? col r)))
         (x (wref syn3 r))))
      (cond-z m-sym p-anc)
      (list p-anc sc1)))
   (range 1 8))

  ;; 5. Final Walsh-Hadamard transform on `syn3` yielding `P(x* = 5) = 4/7`:
  (focus-zipper [sz syn3 (append e7 syn3)]
    (h (wref sz 0))
    (h (wref sz 1))
    (h (wref sz 2))))
