#lang lakefillq

;; =============================================================================
;; examples/hubbard_lcu_qsvt_block.lfq
;;
;; 2-Site Dimer Fermi-Hubbard / Anisotropic Heisenberg `LCU` + `QSVT` Degree-2
;; Chebyshev Block-Encoding (`T_2(H / alpha) = 2 (H / alpha)^2 - I`) in `#lang lakefillq`.
;;
;; Exercises:
;;   1. `NestedDyadicWalkerAliasBox` `PREP` (`Law U2` canonical `(idx0, idx1, coin)`
;;      dyadic alias preparation for weights `c / alpha = (3/8, 2/8, 2/8, 1/8)`
;;      with `alpha = 2.0 Ha` and `0` non-Clifford rotation-synthesis gates).
;;   2. Guarded 4-arm `qmatch` `SELECT` (`Law U3` orthogonal exhaustive partition)
;;      applying `P_0 = X_0 X_1`, `P_1 = Y_0 Y_1 = -(X_0 Z_0)(X_1 Z_1)`,
;;      `P_2 = Z_0 Z_1`, and `P_3 = -Z_0` onto `sys = (q[0], q[1])`.
;;   3. `Law U4` Berry-Gidney `M_X` `PREP-dagger` uncomputation (`0` uncompute `CCX`
;;      gates: destructive `mid-meas-x` on alias/keep scratch + Clifford `cond-cz`
;;      1-bit quantum phase fixup).
;;   4. `QSVT` Chebyshev degree-2 reflection fusion (`U_H * R_0 * U_H`) sharing a
;;      single `q_sig` signal-processing ancilla + shared `LCU` block ancillas
;;      (`m_anc + 1` ancillas vs `2 * m_anc` naive product ancillas, `alpha_out = 1`).
;; =============================================================================

(target-profile heron-r2)

;; Reusable `LCU` block-encoding step `U_H = PREP_BG^dag * SELECT * PREP_Walker`
;; parameterized by distinct measurement symbols for each walk step:
(define (emit-hubbard-walker-lcu-step sys blk sel tbl-w swap-w m-swap-sym m-tbl-sym)
  (match-define (list s0 s1) sys)
  (match-define (list idx0 idx1 coin) blk)
  (match-define (list sel0 sel1) sel)
  (seq
   ;; 1. Uniform dyadic index + coin superposition (`0` T-gates):
   (h idx0)
   (h idx1)
   (h coin)

   ;; 2. Forward Walker-alias table lookup & conditional routing (`Laws U1, U2`):
   ;;    For `p = (3/8, 2/8, 2/8, 1/8)`, bin `3` (`idx = 11`) has `keep = 1/2`
   ;;    and `alias = 00`; when `idx == 3` and `coin == 1`, route `sel -> 00`.
   (erase-by
    (seq
     (temp-and idx0 idx1 tbl-w)
     (temp-and tbl-w coin swap-w)
     (erase-by
      (seq
       (cx idx0 sel0)
       (cx idx1 sel1)
       (cx swap-w sel0)
       (cx swap-w sel1)
       ;; 3. Exhaustive 4-arm `SELECT` (`Law U3` `TotalOn`):
       (qmatch
        ([(g-eq-bits sel '(0 0))
          ;; Term 0 (`+3/8 * X_0 X_1`):
          (x s0)
          (x s1)]
         [(g-eq-bits sel '(1 0))
          ;; Term 1 (`+2/8 * Y_0 Y_1 = -(X_0 Z_0)(X_1 Z_1)`, using `sel0 == 1` for `-1`):
          (z s0)
          (x s0)
          (z s1)
          (x s1)
          (z sel0)]
         [(g-eq-bits sel '(0 1))
          ;; Term 2 (`+2/8 * Z_0 Z_1`):
          (z s0)
          (z s1)]
         [(g-eq-bits sel '(1 1))
          ;; Term 3 (`-1/8 * Z_0`, using `sel0 == 1` for `-1`):
          (z s0)
          (z sel0)])))
      ;; Restore routed `sel` register to `|00>` (`Law U1` & `Law U2`):
      (seq
       (cx swap-w sel1)
       (cx swap-w sel0)
       (cx idx1 sel1)
       (cx idx0 sel0))
      sel))
    ;; 4. `Law U4` Berry-Gidney `M_X` `PREP-dagger` (`0` uncompute `CCX` gates!):
    (seq
     (mid-meas-x swap-w m-swap-sym)
     (cond-cz m-swap-sym tbl-w coin)
     (mid-meas-x tbl-w m-tbl-sym)
     (cond-cz m-tbl-sym idx0 idx1))
    (list tbl-w swap-w))

   ;; 5. Close `PREP-dagger` interference on `(idx0, idx1, coin)`:
   (h idx0)
   (h idx1)
   (h coin)))

;; Exact QSVT signal-processing reflection `R_0 = 2 |000><000| - I` on `blk`
;; mediated by `1` signal-processing qubit `q-sig` (`|0>_sig` receives `+R_0`,
;; `|1>_sig` receives `-R_0`, and all `TempAND` scratch is erased via `MBU`):
(define (emit-qsvt-zero-block-reflection blk q-sig r-tmp1 r-tmp2)
  (match-define (list idx0 idx1 coin) blk)
  (seq
   (x idx0)
   (x idx1)
   (x coin)
   (within-apply-mbu
    (seq (temp-and idx0 idx1 r-tmp1)
         (temp-and r-tmp1 coin r-tmp2))
    (seq (cx r-tmp2 q-sig)
         (x q-sig)
         (z q-sig)
         (x q-sig)
         (cx r-tmp2 q-sig))
    (list r-tmp1 r-tmp2))
   (x coin)
   (x idx1)
   (x idx0)))

;; Single `LCU` block-encoding `U_H` (`H / alpha` in `<000| U_H |000>`):
(defq (hubbard-lcu-block-uh
       #:wires ([sys (range 0 2)]
                [blk (range 2 5)])
       #:scratch ([sel (range 5 7)]
                  [tbl (range 7 8)]
                  [swp (range 8 9)]))
  (emit-hubbard-walker-lcu-step sys blk sel (first tbl) (first swp) 'm_swp0 'm_tbl0))

;; Primary entry circuit: Fused `QSVT` Chebyshev degree-2 block encoding
;; `T_2(H / alpha) = 2 (H / alpha)^2 - I = <0_sig 000| U_H * R_0 * U_H |0_sig 000>`
;; using `1` signal-processing qubit `q_sig` + `3` shared Walker-LCU block wires!
(defq (hubbard-lcu-qsvt-chebyshev-t2
       #:wires ([sys (range 0 2)]
                [blk (range 2 5)]
                [sig (range 5 6)])
       #:scratch ([sel1 (range 6 8)]
                  [tbl1 (range 8 9)]
                  [swp1 (range 9 10)]
                  [rtmp (range 10 12)]
                  [sel2 (range 12 14)]
                  [tbl2 (range 14 15)]
                  [swp2 (range 15 16)]))
  (define q-sig (first sig))
  (seq
   (emit-hubbard-walker-lcu-step sys blk sel1 (first tbl1) (first swp1) 'm_swp_step1 'm_tbl_step1)
   (emit-qsvt-zero-block-reflection blk q-sig (first rtmp) (second rtmp))
   (emit-hubbard-walker-lcu-step sys blk sel2 (first tbl2) (first swp2) 'm_swp_step2 'm_tbl_step2)))
