#lang lakefillq

;; =============================================================================
;; examples/distributed_qrns_shor_u4.lfq
;;
;; Distributed `QRNS` (`0` Inter-QPU Carry Ebits) + `Law U4` Forward-Only GHZ
;; Window Lookup (`forward_ebits = 6`, `reverse_ebits = 0`, `carry_ebits = 0`)
;; in `#lang lakefillq` (`12` logical/physical qubits across `M* = 4` QPUs).
;;
;; Demonstrates:
;;   - Pairwise-coprime `QRNS(3, 5, 7, 11)` dynamic range guard (`T-DriftEps`:
;;     `3 * 5 * 7 * 11 = 1155 >= 15^2 = 225`, `0` inter-QPU ripple carries)
;;   - Convex `T-ParGuard` (`QParGrade = ParSliceable`) over `M_max = 256`
;;     selecting `M* = 4` under `Q_cap = 5` on `switched-optical-tree` (pruning
;;     U-curve-dominated `M >= 6` candidates and collapsing to `M* = 1` when
;;     `--q-cap >= 12` fits monolithically on one chip)
;;   - Forward GHZ cat broadcast (`cx e_j -> cat_p`) across remote QPUs `1..3`
;;     paired with zero-ebit `Law U4` local `M_X` + classical `Z` feedforward
;;     disentanglement (`mid-meas-x-cond-z`), preserving exact phase coherence
;;     across the closing QPU-0 inverse-QFT interference (`h`, `cz`, `h`).
;; =============================================================================

(target-profile heron-r2)

(define-cluster-profile distributed-qrns-shor-cluster
  #:workload 'Distributed-QRNS-Shor-U4
  #:paradigm 'algebraic-limb
  #:max-machines 256
  #:q-cap 5
  #:r-bell-hz 100000.0
  #:q-single 12
  #:q-data-dist 8
  #:q-local-fixed 1
  #:q-peer-sync 1
  #:window-bits 2
  #:num-windows 1
  #:local-toffolis 20000
  #:carry-scheme 'qrns-zero-carry
  #:lookup-scheme 'law-u4-ghz-mx
  #:interconnect-topology 'switched-optical-tree
  #:qpu-wire-slices '((0 1 2) (3 4 9) (5 6 10) (7 8 11)))

;; Zero-carry componentwise QRNS limb multiplication step for `e_0` (`g^{2^0} mod p_i`):
(define (qrns-window-bit0-limbs e0 r0 limb1 limb2 limb3 cat1 cat2 cat3)
  (match-define (list r1a r1b) limb1)
  (match-define (list r2a r2b) limb2)
  (match-define (list r3a r3b) limb3)
  (erase-by
   (seq
    ;; Forward GHZ cat fanout (`3` optical Bell pairs: QPU 0 -> QPUs 1, 2, 3):
    (cx e0 cat1)
    (cx e0 cat2)
    (cx e0 cat3)
    ;; QPU-local residue limb multiplications (`0` cross-QPU carry gates):
    (cx e0 r0)
    (ccx cat1 r1a r1b)
    (cx cat1 r1a)
    (ccx cat2 r2a r2b)
    (cx cat2 r2a)
    (ccx cat3 r3a r3b)
    (cx cat3 r3a))
   ;; Law U4 zero-ebit GHZ cat disentanglement (`M_X` + classical `Z` fixup -> `e0`):
   (seq
    (mid-meas-x-cond-z cat1 e0 'm_u4_b0_q1)
    (mid-meas-x-cond-z cat2 e0 'm_u4_b0_q2)
    (mid-meas-x-cond-z cat3 e0 'm_u4_b0_q3))
   (list cat1 cat2 cat3)))

;; Zero-carry componentwise QRNS limb multiplication step for `e_1` (`g^{2^1} mod p_i`):
(define (qrns-window-bit1-limbs e0 e1 r0 limb1 limb2 limb3 cat1 cat2 cat3)
  (match-define (list r1a r1b) limb1)
  (match-define (list r2a r2b) limb2)
  (match-define (list r3a r3b) limb3)
  (erase-by
   (seq
    ;; Forward GHZ cat fanout (`3` optical Bell pairs: QPU 0 -> QPUs 1, 2, 3):
    (cx e1 cat1)
    (cx e1 cat2)
    (cx e1 cat3)
    ;; QPU-local residue limb multiplications (`0` cross-QPU carry gates):
    (ccx e0 e1 r0)
    (cx cat1 r1b)
    (ccx cat1 r1b r1a)
    (cx cat2 r2b)
    (ccx cat2 r2b r2a)
    (cx cat3 r3b)
    (ccx cat3 r3b r3a))
   ;; Law U4 zero-ebit GHZ cat disentanglement (`M_X` + classical `Z` fixup -> `e1`):
   (seq
    (mid-meas-x-cond-z cat1 e1 'm_u4_b1_q1)
    (mid-meas-x-cond-z cat2 e1 'm_u4_b1_q2)
    (mid-meas-x-cond-z cat3 e1 'm_u4_b1_q3))
   (list cat1 cat2 cat3)))

(defq (distributed-qrns-shor-u4
       #:wires ([exp-win '(0 1)]
                [limb0 '(2)]
                [limb1 '(3 4)]
                [limb2 '(5 6)]
                [limb3 '(7 8)])
       #:scratch ([ghz-cats '(9 10 11)]))
  (match-define (list e0 e1) exp-win)
  (define r0 (first limb0))
  (match-define (list cat1 cat2 cat3) ghz-cats)

  (guard-par-partition
   distributed-qrns-shor-cluster
   (guard-drift-eps
    '(rns-range-spec #:modulus-n 15 #:power-m 2 #:rns-moduli (3 5 7 11))
    (seq
     ;; Seed unit residue `|1>` across the 4 independent QRNS channels:
     (x r0)
     (x (first limb1))
     (x (first limb2))
     (x (first limb3))

     ;; Prepare 2-bit Shor phase-estimation window superposition on QPU 0:
     (h e0)
     (h e1)

     ;; Windowed QRNS modular exponentiation (`6` forward ebits, `0` reverse, `0` carry):
     (qrns-window-bit0-limbs e0 r0 limb1 limb2 limb3 cat1 cat2 cat3)
     (qrns-window-bit1-limbs e0 e1 r0 limb1 limb2 limb3 cat1 cat2 cat3)

     ;; Close QPU-0 phase-estimation interferometer (requires `Law U4` phase cleanliness!):
     (h e1)
     (cz e0 e1)
     (h e0)))))
