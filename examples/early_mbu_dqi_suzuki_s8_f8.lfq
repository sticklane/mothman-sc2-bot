#lang lakefillq

;; =============================================================================
;; examples/early_mbu_dqi_suzuki_s8_f8.lfq
;;
;; Non-Planar Higher-Genus Algebraic-Geometry (`AG`) Early-MBU Decoded Quantum
;; Interferometry (`DQI`) on the Deligne-Lusztig Suzuki Curve
;;   `S(8) : y^8 + y = x^2 * (x^8 + x)` over `GF(8) = GF(2)[alpha]/(alpha^3 + alpha + 1)`.
;;
;; Why the Non-Planar Deligne-Lusztig Suzuki Curve `S(8)` Matters for DQI:
;;   - Over `GF(8)` (`q = 8`, `q_0 = 2`), any univariate Reed-Solomon code is
;;     strictly bounded by the MDS blocklength ceiling `n_RS <= q + 1 = 9`.
;;   - The non-planar Deligne-Lusztig Suzuki curve `S(8)` has genus
;;     `g = q_0 * (q - 1) = 2 * 7 = 14` (Weierstrass pole semigroup
;;     `<8, 10, 12, 13>` at `P_inf` with `14` pole gaps) and attains the optimal
;;     Deligne-Lusztig rational point count `N = q^2 = 64` affine `GF(8)`-rational
;;     points (`7.11x` beyond the `GF(8)` Reed-Solomon MDS ceiling `q + 1 = 9`),
;;     yielding the one-point Algebraic-Geometry code `[64, 52, 6]_{GF(8)}`.
;;   - Each `GF(8)` symbol occupies `b_q = 3` qubits:
;;       * Uncompressed Unitary Late-Uncompute DQI requires `(64 + 12) * 3 = 228 Q`
;;         live data + syndrome qubits (`640` locator Toffolis = `4,480` / `4,264 T`).
;;       * LakefillQ Early-MBU DQI measures and resets all `192` error qubits via
;;         early Hadamard-dual `mid-meas-x`, compressing live peak width from
;;         `228 Q` to `36 Q` (`12 * 3 = 36` syndrome qubits; `6.33x` width reduction)
;;         and using `5` forward `TempAND`s per point (`320` forward `TempAND`s =
;;         `1,280 T`, `0` reverse Toffolis; `3.33x` T-gate reduction).
;; =============================================================================

(target-profile bb-qldpc)

;; Pure functional `GF(8) = GF(2)[alpha]/(alpha^3 + alpha + 1)` arithmetic (`#b1011 = 11`):
(define (gf8-add a b)
  (bitwise-xor a b))

(define (gf8-mul a b)
  (let loop ([i 0] [acc 0] [cur a] [rem b])
    (if (= i 3)
        acc
        (let* ([acc1 (if (odd? rem) (bitwise-xor acc cur) acc)]
               [ shifted (arithmetic-shift cur 1)]
               [cur1 (if (bitwise-bit-set? shifted 3)
                         (bitwise-xor shifted #b1011)
                         shifted)])
          (loop (add1 i) acc1 cur1 (arithmetic-shift rem -1))))))

(define (gf8-pow a e)
  (let loop ([rem e] [base a] [res 1])
    (if (<= rem 0)
        res
        (loop (arithmetic-shift rem -1)
              (gf8-mul base base)
              (if (odd? rem) (gf8-mul res base) res)))))

;; Enumerate all `N = 64` `GF(8)`-rational affine points `(x, y)` on the
;; Deligne-Lusztig Suzuki curve `S(8) : y^8 + y = x^2 * (x^8 + x)` over `GF(8)`:
(defconst suzuki-s8-f8-all-64-points
  (for*/list ([x (in-range 8)]
              [y (in-range 8)]
              #:when (= (gf8-add (gf8-pow y 8) y)
                        (gf8-mul (gf8-pow x 2) (gf8-add (gf8-pow x 8) x))))
    (list x y)))

;; Weierstrass semigroup `<8, 10, 12, 13>` at `P_inf` has genus `g = 14` gaps:
(defconst suzuki-s8-weierstrass-gaps
  '(1 2 3 4 5 6 7 9 11 14 15 17 19 23))

;; Active 6-point Suzuki fiber window (`18` error wires + `18` syndrome wires = `36 Q`
;; physical register footprint matching the `228 Q -> 36 Q` compressed live width):
(defconst suzuki-s8-active-points
  '((0 0) (1 2) (2 5) (3 6) (4 7) (5 3)))

(defconst suzuki-s8-meas-syms
  '((m_e0_0 m_e0_1 m_e0_2)
    (m_e1_0 m_e1_1 m_e1_2)
    (m_e2_0 m_e2_1 m_e2_2)
    (m_e3_0 m_e3_1 m_e3_2)
    (m_e4_0 m_e4_1 m_e4_2)
    (m_e5_0 m_e5_1 m_e5_2)))

;; Reversible `GF(8)` multiply-accumulate `(dst0, dst1, dst2) ^= coeff * (src0, src1, src2)`
;; synthesized directly from the `GF(2)` linear action of `coeff in GF(8)`:
(define (gf8-mac coeff src0 src1 src2 dst0 dst1 dst2)
  (define srcs (list src0 src1 src2))
  (define dsts (list dst0 dst1 dst2))
  (if (= coeff 0)
      skip
      (for/seq ([b (in-range 3)])
        (define img (gf8-mul coeff (arithmetic-shift 1 b)))
        (for/seq ([d (in-range 3)])
          (if (bitwise-bit-set? img d)
              (cx (list-ref srcs b) (list-ref dsts d))
              skip)))))

;; Exact `GF(8)`-symbol Hamming weight <= 1 domain guard over the active `GF(8)` error symbols
;; (`1 + 6 * 7 = 43` coset leaders: `0` plus `42` single-symbol `GF(8)^*` errors):
(define suzuki-f8-wt-le1-guard
  (apply g-and
         (cons (g-all-zero (range 18 36))
               (for*/list ([i (in-range 6)]
                           [j (in-range (add1 i) 6)])
                 (g-not (g-and (g-or (g-wire (* 3 i))
                                     (g-or (g-wire (add1 (* 3 i)))
                                           (g-wire (+ 2 (* 3 i)))))
                               (g-or (g-wire (* 3 j))
                                     (g-or (g-wire (add1 (* 3 j)))
                                           (g-wire (+ 2 (* 3 j)))))))))))

(defq (early-mbu-dqi-suzuki-s8-f8
       #:wires ([e18 (range 0 18)]
                [syn18 (range 18 36)])
       #:scratch ([v-t0 (range 36 42)]
                  [v-t1 (range 42 48)]
                  [v-t2 (range 48 54)]
                  [v-t3 (range 54 60)]
                  [v-loc (range 60 66)])
       #:domain (domain-guard suzuki-f8-wt-le1-guard))
  ;; 1. Deligne-Lusztig Suzuki `S(8)` parity-check encoding `syn ^= H_{S(8)} * e`:
  (for/seq ([j (in-range 6)])
    (define pt (list-ref suzuki-s8-active-points j))
    (define xj (first pt))
    (define yj (second pt))
    (define ej0 (wref e18 (* 3 j)))
    (define ej1 (wref e18 (add1 (* 3 j))))
    (define ej2 (wref e18 (+ 2 (* 3 j))))
    (seq
     (gf8-mac 1  ej0 ej1 ej2 (wref syn18 0) (wref syn18 1) (wref syn18 2))
     (gf8-mac xj ej0 ej1 ej2 (wref syn18 3) (wref syn18 4) (wref syn18 5))
     (gf8-mac yj ej0 ej1 ej2 (wref syn18 6) (wref syn18 7) (wref syn18 8))))

  ;; 2. Early-MBU `M_X` + reset on error qubits (`228 Q -> 36 Q` live width compression,
  ;;    freeing wires `0..17` for chordal SSA scratch recycling):
  (for/seq ([j (in-range 6)])
    (define mtriple (list-ref suzuki-s8-meas-syms j))
    (seq
     (mid-meas-x (wref e18 (* 3 j)) (first mtriple))
     (mid-meas-x (wref e18 (add1 (* 3 j))) (second mtriple))
     (mid-meas-x (wref e18 (+ 2 (* 3 j))) (third mtriple))))

  ;; 3. Balanced Braun-tree Suzuki curve-locator phase cancellation (`fold-braun`):
  ;;    For each rational point `P_j = (x_j, y_j)` on `S(8)(GF(8))`, the 6-bit zero-test
  ;;    `(s_1 == x_j * s_0) && (s_2 == y_j * s_0)` uses `5` forward `TempAND`s and `0`
  ;;    reverse Toffolis inside `within-apply-mbu`, canceling all `7` non-zero `GF(8)^*`
  ;;    error magnitudes `s_0` via Clifford `cond-cz` feed-forward (`Law U4` `QTainted`).
  (fold-braun
   (lambda (pt j)
     (define xj (first pt))
     (define yj (second pt))
     (define mtriple (list-ref suzuki-s8-meas-syms j))
     (define s0-0 (wref syn18 0))
     (define s0-1 (wref syn18 1))
     (define s0-2 (wref syn18 2))
     (define s1-0 (wref syn18 3))
     (define s1-1 (wref syn18 4))
     (define s1-2 (wref syn18 5))
     (define s2-0 (wref syn18 6))
     (define s2-1 (wref syn18 7))
     (define s2-2 (wref syn18 8))
     (define t0 (wref v-t0 j))
     (define t1 (wref v-t1 j))
     (define t2 (wref v-t2 j))
     (define t3 (wref v-t3 j))
     (define loc (wref v-loc j))
     (within-apply-mbu
      (seq
       (gf8-mac xj s0-0 s0-1 s0-2 s1-0 s1-1 s1-2)
       (gf8-mac yj s0-0 s0-1 s0-2 s2-0 s2-1 s2-2)
       (x s1-0) (x s1-1) (x s1-2) (x s2-0) (x s2-1) (x s2-2)
       (temp-and s1-0 s1-1 t0)
       (temp-and s1-2 s2-0 t1)
       (temp-and s2-1 s2-2 t2)
       (temp-and t0 t1 t3)
       (temp-and t3 t2 loc))
      (seq
       (cond-cz (first mtriple) s0-0 loc)
       (cond-cz (second mtriple) s0-1 loc)
       (cond-cz (third mtriple) s0-2 loc))
      (list loc t3 t2 t1 t0)))
   suzuki-s8-active-points)

  ;; 4. Final GF(8) trace-Fourier / Walsh-Hadamard interference on the syndrome register:
  (focus-zipper [sz syn18 (append e18 syn18)]
    (for/seq ([r (in-range 9)])
      (h (wref sz r)))))
