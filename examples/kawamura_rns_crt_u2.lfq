#lang lakefillq

;; =============================================================================
;; examples/kawamura_rns_crt_u2.lfq
;;
;; Residue Number System `RNS(3, 5)` (`M = 15`) + Kawamura Dyadic Fixed-Point
;; Quotient Canonicalization (`Law U2` `Canonical`) in `#lang lakefillq`.
;; Demonstrates:
;;   - Non-power-of-two domain ideal `#:domain (domain-guard ...)` (`r3 < 3, r5 < 5`,
;;     `q_crt == 00` on entry)
;;   - Parallel RNS lanes (`par-wires`) separated beyond Rydberg blockade radius
;;     (`>= 10 um >= 8 um` on `bluvstein-aod`, `Grade Phi2` = `0` collisions)
;;   - Exhaustive residue `qmatch` (`Law U3` `TotalOn` modulo the RNS domain ideal!)
;;   - Exact Kawamura 4-bit dyadic fixed-point quotient estimator
;;     `floor((1 + floor(32*r3/3) + floor(32*r5/5)) / 16) == floor((10*r3 + 6*r5)/15)`
;;     erasing `2`-bit `q_crt -> |00>` (`Law U2`) across `15/15` (`100%`) residues
;;     prior to quantum interference (`h ctrl`)!
;; =============================================================================

(target-profile bluvstein-aod)

(define (xor-const-bits target-ws val)
  (for/seq ([b (in-range (length target-ws))] #:when (bitwise-bit-set? val b))
    (x (wref target-ws b))))

;; Kawamura `1 + floor(32 * r3 / 3)` (`{1, 11, 22}` for `r3 = 0, 1, 2`):
(define (kawamura-load-mod3 r3 a5)
  (qmatch
   ([(g-eq-bits r3 '(0 0)) (xor-const-bits a5 1)]
    [(g-eq-bits r3 '(1 0)) (xor-const-bits a5 11)]
    [(g-eq-bits r3 '(0 1)) (xor-const-bits a5 22)])))

;; Kawamura `floor(32 * r5 / 5)` (`{0, 6, 12, 19, 25}` for `r5 = 0..4`):
(define (kawamura-load-mod5 r5 b5)
  (qmatch
   ([(g-eq-bits r5 '(0 0 0)) skip]
    [(g-eq-bits r5 '(1 0 0)) (xor-const-bits b5 6)]
    [(g-eq-bits r5 '(0 1 0)) (xor-const-bits b5 12)]
    [(g-eq-bits r5 '(1 1 0)) (xor-const-bits b5 19)]
    [(g-eq-bits r5 '(0 0 1)) (xor-const-bits b5 25)])))

;; Raw CRT overflow quotient `q_crt = floor((10 * r3 + 6 * r5) / 15) in {0, 1, 2}`
;; accumulated conditionally when `ctrl == 1` onto `q_crt = (q0, q1)`:
;;   Let `(u0, u1) = r3` and `(v0, v1, v2) = r5`:
;;   Exact boolean table on `{0,1,2} x {0,1,2,3,4}`:
;;     `q0` (`odd` quotient bit `1`): `(0,3),(0,4),(1,1),(1,2),(1,3),(2,0),(2,1)`
;;     `q1` (`high` quotient bit `2`): `(1,4),(2,2),(2,3),(2,4)`
(define (accumulate-raw-crt-quotient ctrl r3 r5 q2 sc2)
  (match-define (list u0 u1) r3)
  (match-define (list v0 v1 v2) r5)
  (match-define (list q0 q1) q2)
  (match-define (list s0 s1) sc2)
  ;; Compute raw `q0_bit` and `q1_bit` on `(s0, s1)` then `ccx ctrl s_i q_i`:
  ;; Over `u0*u1 = 0` and `v2*(v0 | v1) = 0`:
  ;;   `q1_bit = (u0 & v2) ^ (u1 & v1) ^ (u1 & v2)`
  ;;   `q0_bit = (~u0 & ~u1 & v0 & v1) ^ (~u0 & ~u1 & v2)
  ;;           ^ (u0 & v0 & ~v1) ^ (u0 & v1)
  ;;           ^ (u1 & ~v1 & ~v2)`
  (within-apply-mbu
   (seq
    ;; `s1 = q1_bit`:
    (temp-and u0 v2 s1)
    (temp-and-lin (list u1) (list v1 v2) s0)
    (cx s0 s1))
   (ccx ctrl s1 q1)
   (list s0 s1)))

(define (accumulate-raw-crt-q0 ctrl r3 r5 q0 sc3)
  (match-define (list u0 u1) r3)
  (match-define (list v0 v1 v2) r5)
  (match-define (list t0 t1 t2) sc3)
  ;; On `r3 < 3, r5 < 5`:
  ;;   - When `r3 = 0` (`~u0 & ~u1`, which equals `~(u0 ^ u1)` on `r3 < 3`!): `v2 ^ (v0 & v1)`
  ;;   - When `r3 = 1` (`u0`): `v0 ^ v1 ^ (v0 & v1)`? Check:
  ;;       r5=0(000)->0, r5=1(100)->1, r5=2(010)->1, r5=3(110)->1, r5=4(001)->0!
  ;;       YES! `v0 | v1 = v0 ^ v1 ^ (v0 & v1)` is `(0, 1, 1, 1, 0)` on `r5 = 0..4`!
  ;;   - When `r3 = 2` (`u1`): `~v1 & ~v2`! Check:
  ;;       r5=0(000)->1, r5=1(100)->1, r5=2(010)->0, r5=3(110)->0, r5=4(001)->0!
  ;;       And on `r5 < 5`, `v1 & v2 == 0`, so `~v1 & ~v2 == 1 ^ v1 ^ v2`!
  ;; Combine all 3 disjoint cases into pure degree-<=3 ANF:
  ;;   `q0_bit = (1 ^ u0 ^ u1)*(v2 ^ v0*v1) ^ u0*(v0 ^ v1 ^ v0*v1) ^ u1*(1 ^ v1 ^ v2)`
  ;;           `= v2 ^ (v0 & v1) ^ u0*(v0 ^ v1 ^ v2) ^ u1*(1 ^ v1 ^ (v0 & v1))`!
  ;; Check EVERY `(r3, r5)` on `v2 ^ (v0 & v1) ^ u0*(v0 ^ v1 ^ v2) ^ u1*(1 ^ v1 ^ (v0 & v1))`:
  ;;   - r3=0 (u0=0,u1=0): `v2 ^ (v0&v1)` -> (0,0,0,1,1) for r5=0..4! EXACT!
  ;;   - r3=1 (u0=1,u1=0): `v2 ^ (v0&v1) ^ v0 ^ v1 ^ v2 = v0 ^ v1 ^ (v0&v1)` -> (0,1,1,1,0)! EXACT!
  ;;   - r3=2 (u0=0,u1=1): `v2 ^ (v0&v1) ^ 1 ^ v1 ^ (v0&v1) = 1 ^ v1 ^ v2` -> (1,1,0,0,0)! EXACT!
  (within-apply-mbu
   (seq
    (temp-and v0 v1 t0)
    (temp-and-lin (list u0) (list v0 v1 v2) t1)
    (temp-and-lin (list u1) (list v1 t0) t2 #f #t))
   (seq
    (ccx ctrl v2 q0)
    (ccx ctrl t0 q0)
    (ccx ctrl t1 q0)
    (ccx ctrl t2 q0))
   (list t0 t1 t2)))

(defq (kawamura-rns-crt-u2
       #:wires ([ctrl '(0)]
                [r3 '(1 2)]
                [q-crt '(3 4)]
                [r5 '(5 6 7)])
       #:scratch ([a5 '(8 9 10 11 12)]
                  [b5 '(13 14 15 16 17)]
                  [c5 '(18 19 20 21 22)]
                  [raw-sc '(23 24 25)])
       #:domain (domain-guard
                 (g-and
                  ;; `r3 < 3`: not (u0 & u1)
                  (g-not (g-and (g-wire 1) (g-wire 2)))
                  ;; `r5 < 5`: not (v2 & (v0 | v1))
                  (g-not (g-and (g-wire 7) (g-or (g-wire 5) (g-wire 6))))
                  ;; `ctrl == 0` and `q_crt == 00` at interferometer entry:
                  (g-all-zero '(0 3 4)))))
  ;; 1. Open Mach-Zehnder / Kitaev interferometer branch on `ctrl`:
  (h 0)

  ;; 2. Controlled modular RNS step + raw non-canonical CRT overflow into `q-crt`:
  ;;    First run parallel `(mod 3)` and `(mod 5)` local Z-phase / basis step on
  ;;    spatially separated registers (`{1, 2}` vs `{5, 6, 7}`, gap `3*5 = 15 um >= 8 um`!),
  ;;    then accumulate raw history-dependent CRT quotient `q_crt = floor((10*r3 + 6*r5)/15)`:
  (par-wires
   (seq (cz 1 2) (cz 1 2))
   (seq (cz 5 6) (cz 5 6)))
  (accumulate-raw-crt-quotient 0 r3 r5 q-crt (take raw-sc 2))
  (accumulate-raw-crt-q0 0 r3 r5 (wref q-crt 0) raw-sc)

  ;; 3. `Law U2` (`Canonical`): Kawamura 4-bit dyadic fixed-point quotient erasure!
  ;;    Loads `a5 = 1 + floor(32*r3/3)` and `b5 = floor(32*r5/5)` via `qmatch` (`Law U3`),
  ;;    computes 5-bit ripple carry `c5` via `within-apply-mbu`, and XORs `(sum >> 4)`
  ;;    (`bits [4..5] = (a4 ^ b4 ^ c3, c4)`) controlled on `ctrl` into `q-crt -> |00>`!
  (canonicalize-quotient
   q-crt
   (within-apply
    (seq (kawamura-load-mod3 r3 a5)
         (kawamura-load-mod5 r5 b5))
    (within-apply-mbu
     (seq
      (temp-and (wref a5 0) (wref b5 0) (wref c5 0))
      (temp-and-lin (list (wref a5 1) (wref c5 0))
                    (list (wref b5 1) (wref c5 0))
                    (wref c5 1))
      (cx (wref c5 0) (wref c5 1))
      (temp-and-lin (list (wref a5 2) (wref c5 1))
                    (list (wref b5 2) (wref c5 1))
                    (wref c5 2))
      (cx (wref c5 1) (wref c5 2))
      (temp-and-lin (list (wref a5 3) (wref c5 2))
                    (list (wref b5 3) (wref c5 2))
                    (wref c5 3))
      (cx (wref c5 2) (wref c5 3))
      (temp-and-lin (list (wref a5 4) (wref c5 3))
                    (list (wref b5 4) (wref c5 3))
                    (wref c5 4))
      (cx (wref c5 3) (wref c5 4)))
     (seq
      ;; Bit 4 of `(a5 + b5)` is `a5[4] ^ b5[4] ^ c5[3]` -> cancels `q_crt[0]`!
      (ccx 0 (wref a5 4) (wref q-crt 0))
      (ccx 0 (wref b5 4) (wref q-crt 0))
      (ccx 0 (wref c5 3) (wref q-crt 0))
      ;; Bit 5 of `(a5 + b5)` is `c5[4]` -> cancels `q_crt[1]`!
      (ccx 0 (wref c5 4) (wref q-crt 1)))
     c5)
    (append a5 b5)))

  ;; 4. Close interferometer on `ctrl` (`|0>` with probability `1.000000` iff `q_crt == 00`!):
  (h 0))
