#lang lakefillq

;; =============================================================================
;; examples/aes_sbox_dlog5_13q.lfq
;;
;; Minimum-Width `13`-Qubit In-Place Reversible `GF(2^8)` Discrete-Log FIPS-197
;; AES S-Box (`x8 |-> S(x8)`, `8` state qubits + `4` discrete-log ancillas `a4` +
;; `1` `TempAND/M_X` helper `h` = `13` physical qubits total, `0` SWAPs).
;;
;; Demonstrates:
;;   - Zero-SWAP `SL_8(GF(2))` tower-field isomorphism (`aes-to-tower-mat`) and
;;     fused FIPS-197 affine output map (`post-sbox-mat` + `0x63`)
;;   - Streaming `GF(2^4)` Karatsuba quadratic norm `delta(x)` into `a[0..3]`
;;     reusing the single helper wire `h` via `within-apply-mbu` (`0` uncompute CCXs)
;;   - Reversible 4-bit discrete-log permutation `phi_4 : d |-> k` (`9^k = d^{-1}`
;;     in `GF(16)*`, `0 |-> 0`), rank-optimal controlled `9^{2^i}` in-place fanout,
;;     and antilog `psi_4 : k |-> 9^k` + homogeneous norm cleanup (`a4, h -> |00000>`)
;;   - Static `T-ParGuard` proof (`QParGrade = ParNonPartitionable`) over a
;;     `256`-machine cluster: sequential Grover/S-box dependency chain selects
;;     `M* = 1` (`fallback_to_single_machine = #t`, `forward_ebits = 0`,
;;     `reverse_ebits = 0`), avoiding `sqrt(256) = 16x` Zalka total-work blowup.
;; =============================================================================

(target-profile heron-r2)

(define-cluster-profile aes-sbox-dlog5-cluster
  #:workload 'AES-SBox-DLog5-13Q
  #:paradigm 'grover-amplify
  #:max-machines 256
  #:q-cap 400
  #:r-bell-hz 100000.0
  #:q-single 'auto
  #:local-toffolis 'auto
  #:verify-circuit-match? #t)

;; Pure functional `GF(2)` `8x8` matrix algebra (`SL_8(GF(2))` basis conversion):
(define (cols->gf2-rows m col-masks)
  (for/list ([r (in-range m)])
    (for/list ([c (in-range m)])
      (if (bitwise-bit-set? (list-ref col-masks c) r) 1 0))))

(define (gf2-row-xor r1 r2)
  (map bitwise-xor r1 r2))

(define (list-set-idx xs idx val)
  (for/list ([x (in-list xs)] [i (in-naturals)])
    (if (= i idx) val x)))

(define (gf2-matmul A B)
  (define m (length A))
  (for/list ([r (in-range m)])
    (define row-a (list-ref A r))
    (for/list ([c (in-range m)])
      (bitwise-and
       1
       (foldl + 0
              (for/list ([k (in-range m)])
                (* (list-ref row-a k)
                   (list-ref (list-ref B k) c))))))))

(define (gf2-matinv M)
  (define m (length M))
  (define aug0
    (for/list ([r (in-range m)])
      (append (list-ref M r)
              (for/list ([c (in-range m)]) (if (= r c) 1 0)))))
  (define reduced
    (foldl
     (lambda (col aug)
       (define piv
         (first (filter (lambda (r) (= (list-ref (list-ref aug r) col) 1))
                        (range col m))))
       (define swapped
         (if (= piv col)
             aug
             (let ([rc (list-ref aug col)]
                   [rp (list-ref aug piv)])
               (list-set-idx (list-set-idx aug col rp) piv rc))))
       (define piv-row (list-ref swapped col))
       (for/list ([row (in-list swapped)] [r (in-naturals)])
         (if (and (not (= r col)) (= (list-ref row col) 1))
             (gf2-row-xor row piv-row)
             row)))
     aug0
     (range m)))
  (for/list ([row (in-list reduced)])
    (drop row m)))

;; Zero-SWAP `SL_8(GF(2))` Gauss-Jordan factorization into pure `(cx c t)` gates:
(define (gf2-mat->cx-seq mat wires)
  (define m (length mat))
  (define final-state
    (foldl
     (lambda (col st)
       (match-define (list rows pairs) st)
       (define pivot-step
         (if (zero? (list-ref (list-ref rows col) col))
             (let* ([piv (first (filter (lambda (r)
                                          (= (list-ref (list-ref rows r) col) 1))
                                        (range (add1 col) m)))]
                    [new-col-row (gf2-row-xor (list-ref rows col)
                                              (list-ref rows piv))])
               (list (list-set-idx rows col new-col-row)
                     (cons (list piv col) pairs)))
             (list rows pairs)))
       (match-define (list rows1 pairs1) pivot-step)
       (define c-row (list-ref rows1 col))
       (foldl
        (lambda (r st2)
          (match-define (list rws prs) st2)
          (if (and (not (= r col))
                   (= (list-ref (list-ref rws r) col) 1))
              (list (list-set-idx rws r (gf2-row-xor (list-ref rws r) c-row))
                    (cons (list col r) prs))
              st2))
        (list rows1 pairs1)
        (range m)))
     (list mat '())
     (range m)))
  (define cx-pairs (second final-state))
  (for/seq ([p (in-list cx-pairs)])
    (cx (wref wires (first p)) (wref wires (second p)))))

(defconst tower-to-aes-mat
  (cols->gf2-rows 8 '(#x01 #xbc #x5c #xb0 #xf2 #x5b #x5f #x6f)))
(defconst aes-to-tower-mat (gf2-matinv tower-to-aes-mat))
(defconst aes-affine-mat
  (for/list ([r (in-range 8)])
    (for/list ([c (in-range 8)])
      (if (<= (modulo (- r c) 8) 4) 1 0))))
(defconst post-sbox-mat (gf2-matmul aes-affine-mat tower-to-aes-mat))
(defconst aes-sbox-const #x63)

;; 9 Karatsuba quadratic output column masks for `GF((2^2)^2)` multiplication:
(defconst dlog5-karatsuba9-masks
  '((0 1 2 3)
    (0 2)
    (1 3)
    (0)
    (1)
    (0 1)
    (2 3)
    (2)
    (3)))

(define (karatsuba-gf16-streaming-xor forms-a forms-b dst-wires h-wire)
  (match-define (list a0 a1 a2 a3) forms-a)
  (match-define (list b0 b1 b2 b3) forms-b)
  (define pairs9
    (list (list a0 b0)
          (list a1 b1)
          (list (lin-xor a0 a1) (lin-xor b0 b1))
          (list a2 b2)
          (list a3 b3)
          (list (lin-xor a2 a3) (lin-xor b2 b3))
          (list (lin-xor a0 a2) (lin-xor b0 b2))
          (list (lin-xor a1 a3) (lin-xor b1 b3))
          (list (lin-xor a0 a1 a2 a3) (lin-xor b0 b1 b2 b3))))
  (for/seq ([idx (in-range 9)])
    (define pr (list-ref pairs9 idx))
    (define y-cols (list-ref dlog5-karatsuba9-masks idx))
    (within-apply-mbu
     (temp-and-lin (first pr) (second pr) h-wire)
     (for/seq ([c (in-list y-cols)])
       (cx h-wire (wref dst-wires c)))
     (list h-wire))))

(define (uv-sq-xor xH-wires a4-wires)
  (match-define (list h0 h1 h2 h3) xH-wires)
  (match-define (list a0 a1 a2 a3) a4-wires)
  (seq (cx h2 a0)
       (cx h2 a1) (cx h3 a1)
       (cx h1 a2) (cx h2 a2) (cx h3 a2)
       (cx h0 a3) (cx h3 a3)))

;; Synthesized 4-bit reversible discrete-log `phi` (`d |-> k` s.t. `9^k = d^{-1}`, `0 |-> 0`)
;; and antilog `psi` (`k |-> 9^k`, `0 |-> 0`) schedules for primitive `g = 9` in `GF(16)*`:
(defconst dlog5-phi-specs
  '((ccx-pol 1 0 3 1 0)
    (cx 0 1) (cx 1 2) (cx 3 1) (cx 2 3)
    (ccx-pol 0 1 1 0 2)
    (ccx-pol 1 1 2 0 0)
    (ccx-pol 2 0 3 1 0)
    (ccx-pol 0 0 3 1 2)
    (c3x-pol 0 1 2 0 3 0 1)
    (c3x-pol 0 0 1 0 2 1 3)))

(defconst dlog5-psi-specs
  '((ccx-pol 0 1 2 1 1)
    (ccx-pol 2 1 3 0 0)
    (cx 1 3) (cx 3 2)
    (ccx-pol 0 0 2 1 1)
    (ccx-pol 2 1 3 0 1)
    (ccx-pol 0 1 1 1 2)
    (ccx-pol 1 1 3 1 0)
    (ccx-pol 0 1 2 0 3)
    (c3x-pol 1 1 2 0 3 0 0)))

(define (emit-dlog5-perm4 a4-wires h-wire specs)
  (define av (list->vector a4-wires))
  (for/seq ([sp (in-list specs)])
    (cond
      [(= (length sp) 3)
       (cx (vector-ref av (second sp))
           (vector-ref av (third sp)))]
      [(= (length sp) 6)
       (match-define (list _ c1 v1 c2 v2 t) sp)
       (define w1 (vector-ref av c1))
       (define w2 (vector-ref av c2))
       (define wt (vector-ref av t))
       (seq (if (zero? v1) (x w1) skip)
            (if (zero? v2) (x w2) skip)
            (ccx w1 w2 wt)
            (if (zero? v1) (x w1) skip)
            (if (zero? v2) (x w2) skip))]
      [else
       (match-define (list _ c1 v1 c2 v2 c3 v3 t) sp)
       (define w1 (vector-ref av c1))
       (define w2 (vector-ref av c2))
       (define w3 (vector-ref av c3))
       (define wt (vector-ref av t))
       (seq (if (zero? v1) (x w1) skip)
            (if (zero? v2) (x w2) skip)
            (if (zero? v3) (x w3) skip)
            (within-apply-mbu
             (temp-and w1 w2 h-wire)
             (ccx h-wire w3 wt)
             (list h-wire))
            (if (zero? v1) (x w1) skip)
            (if (zero? v2) (x w2) skip)
            (if (zero? v3) (x w3) skip))])))

;; Rank-optimal 4-step controlled `GF(16)` fanout multiplications `x |-> 9^{2^i} * x`:
(defconst dlog5-fanout-specs
  '(((1 (0 3)) (0 (1 2 3)) (3 (1 2)) (2 (0 1 3)))
    ((0 (2)) (1 (3)) (3 (0 1 2)) (2 (0 3)))
    ((0 (1 2)) (1 (0 2 3)) (2 (0 1)) (3 (0)))
    ((2 (1)) (3 (0 1)) (1 (0 3)) (0 (1 2 3)))))

(define (emit-ctrl-gf16-mul-pair ctrl-w nib-a nib-b h-wire fanout-steps)
  (define va (list->vector nib-a))
  (define vb (list->vector nib-b))
  (for/seq ([st (in-list fanout-steps)])
    (match-define (list src dsts) st)
    (seq (within-apply-mbu
          (temp-and ctrl-w (vector-ref va src) h-wire)
          (for/seq ([d (in-list dsts)])
            (cx h-wire (vector-ref va d)))
          (list h-wire))
         (within-apply-mbu
          (temp-and ctrl-w (vector-ref vb src) h-wire)
          (for/seq ([d (in-list dsts)])
            (cx h-wire (vector-ref vb d)))
          (list h-wire)))))

(defqfree (aes-sbox-dlog5-13q
           #:wires ([x8 (qvec 8)])
           #:scratch ([a4 (qvec 4)]
                      [helper1 (qvec 1)]))
  (define h-wire (first helper1))
  (define c4-wires (take x8 4))
  (define xH-wires (drop x8 4))
  (define c4-forms (map list c4-wires))
  (define xH-forms (map list xH-wires))
  (define xL-forms (map lin-xor c4-forms xH-forms))

  (guard-par-partition
   aes-sbox-dlog5-cluster
   (multishot-reset
    4
    (seq
     ;; (a) Basis isomorphism `GF(2^8) -> GF((2^2)^2)^2` and `(xL, xH) |-> (xL ^ xH, xH)`:
     (gf2-mat->cx-seq aes-to-tower-mat x8)
     (for/seq ([i (in-range 4)])
       (cx (wref xH-wires i) (wref c4-wires i)))

     ;; (b)-(e) `5`-ancilla discrete-log inversion + homogeneous quadratic cleanup (`a4, h -> |00000>`):
     (erase-by
      (seq
       (karatsuba-gf16-streaming-xor xL-forms c4-forms a4 h-wire)
       (uv-sq-xor xH-wires a4)
       (emit-dlog5-perm4 a4 h-wire dlog5-phi-specs)
       (for/seq ([i (in-range 4)])
         (emit-ctrl-gf16-mul-pair (wref a4 i)
                                  c4-wires
                                  xH-wires
                                  h-wire
                                  (list-ref dlog5-fanout-specs i))))
      (seq
       (emit-dlog5-perm4 a4 h-wire dlog5-psi-specs)
       (karatsuba-gf16-streaming-xor xL-forms c4-forms a4 h-wire)
       (uv-sq-xor xH-wires a4))
      a4)

     ;; (f) Fused FIPS-197 affine transformation + `0x63` constant in-place on `x8`:
     (gf2-mat->cx-seq post-sbox-mat x8)
     (for/seq ([r (in-range 8)] #:when (bitwise-bit-set? aes-sbox-const r))
       (x (wref x8 r)))))))
