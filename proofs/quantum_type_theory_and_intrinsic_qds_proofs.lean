  (realtimeQueueWorstCaseTicks 64 < batchedQueueWorstCaseTicks 64) &&
  checkF47RealtimeAndAcyclicEGraph 2 5 3 &&
  !(checkF47RealtimeAndAcyclicEGraph 2 3 3) &&
  (effectiveCorrectableFaults 7 2 < effectiveCorrectableFaults 7 1) &&
  checkF48CorrelatedCrosstalkSafe 2 &&
  smtPluginCanonical48BugSuite

theorem thm28e_phase12_master_48bug_and_qds16_soundness :
    fullPhase12CircuitSpecValid fullPhase12BugF45 = false ∧
    fullPhase12CircuitSpecValid fullPhase12BugF46 = false ∧
    fullPhase12CircuitSpecValid fullPhase12BugF47 = false ∧
    fullPhase12CircuitSpecValid fullPhase12BugF48 = false ∧
    fullPhase12CircuitSpecValid canonicalValidFullPhase12Circuit = true ∧
