/-- **Representation State (`RepState` — `Fix F9`)**:
    Distinguishes redundant Carry-Save states (`.redundantCS`, where distinct pairs `(S, C)`
    can represent the same residue mod `M` and phase oracles are forbidden) from consolidated
    canonical residues (`.canonicalMod`, where `C = 0` and `S = (S + 2C) mod M` is unique). -/
inductive RepState : Type where
  | redundantCS  : RepState
  | canonicalMod : RepState
  deriving DecidableEq, Repr

/-- Carry-Save modular state tagged with its `RepState` (`Fix F9`). -/
structure CarrySaveModPair where
  s    : Nat
  c    : Nat
  mode : RepState
  deriving DecidableEq, Repr

/-- Quotient Carry-Save Consolidation (`consolidateMod M` — `Fix F9`):
    Collapses any redundant pair `(s, c)` modulo `M` into its unique canonical representative
    `⟨(s + 2 * c) % M, 0, .canonicalMod⟩`. -/
def consolidateMod (M : Nat) (p : CarrySaveModPair) : CarrySaveModPair :=
  { s    := (p.s + 2 * p.c) % M
    c    := 0
    mode := .canonicalMod }

/-- Evaluates a phase oracle `chi : Nat → Nat → Bool` on the physical registers `(s, c)`. -/
def evalPhaseOracle (chi : Nat → Nat → Bool) (p : CarrySaveModPair) : Bool :=
  chi p.s p.c

/-- Concrete carry-rail phase oracle that leaks representation history if applied before
    consolidation (`Issue F9` counterexample). -/
def chiCarryRailLeak (s c : Nat) : Bool :=
  let _ := s
  decide (c > 0)

/-- **Theorem 13A (`quotient_carry_save_consolidation_and_phase_invariance` — `Fix F9`)**:
    1. **Positive Soundness (`Fix F9`)**: For any modulus `M` and any two carry-save pairs
       `p1, p2 : CarrySaveModPair` with `(p1.s + 2 * p1.c) % M = (p2.s + 2 * p2.c) % M`,
       `consolidateMod M p1 = consolidateMod M p2`, both project to `.mode = .canonicalMod`
       with `.c = 0`, and **every phase oracle `chi` is strictly path-independent** after
       consolidation (`evalPhaseOracle chi (consolidateMod M p1) = evalPhaseOracle chi (consolidateMod M p2)`).
    2. **Negative Counterexample (`Issue F9`)**: For unconsolidated pairs `(x, 0)` vs `(x - 2, 1)`
       (specifically `⟨6, 0, .redundantCS⟩` and `⟨4, 1, .redundantCS⟩` modulo `256`), both represent
       the same integer `6` (`(6 + 2*0) % 256 = (4 + 2*1) % 256 = 6`), yet they are distinct physical
       basis states and `chiCarryRailLeak` distinguishes them (`false ≠ true`) unless consolidated! -/
theorem quotient_carry_save_consolidation_and_phase_invariance
    (M : Nat) (p1 p2 : CarrySaveModPair) (chi : Nat → Nat → Bool)
    (hEquiv : (p1.s + 2 * p1.c) % M = (p2.s + 2 * p2.c) % M) :
    consolidateMod M p1 = consolidateMod M p2 ∧
    (consolidateMod M p1).mode = .canonicalMod ∧
    (consolidateMod M p1).c = 0 ∧
    evalPhaseOracle chi (consolidateMod M p1) = evalPhaseOracle chi (consolidateMod M p2) ∧
    (let raw1 : CarrySaveModPair := ⟨6, 0, .redundantCS⟩
     let raw2 : CarrySaveModPair := ⟨4, 1, .redundantCS⟩
     (raw1.s + 2 * raw1.c) % 256 = (raw2.s + 2 * raw2.c) % 256 ∧
     raw1 ≠ raw2 ∧
     evalPhaseOracle chiCarryRailLeak raw1 ≠ evalPhaseOracle chiCarryRailLeak raw2 ∧
     consolidateMod 256 raw1 = consolidateMod 256 raw2) := by
  refine ⟨?_, rfl, rfl, ?_, by decide⟩
  · unfold consolidateMod
    rw [hEquiv]
  · unfold evalPhaseOracle consolidateMod
    rw [hEquiv]

/-- **Locked Binomial Pebble Checkpoint State (`PebbleCkptState` — `Fix F10`)**:
    Tracks an input bit `x`, an outer checkpoint pebble `pCkpt` at step $s$, an inner recursive
    pebble `pInner` used during $B(s-1, k)$, and the compile-time lock flag `locked : Bool`. -/
structure PebbleCkptState where
  x      : Bool
  pCkpt  : Bool
  pInner : Bool
  locked : Bool
  deriving DecidableEq, Repr

/-- Outer checkpoint computation $U_{\text{ckpt}}$ toggling `pCkpt` by `f x`. -/
def applyCkptU (f : Bool → Bool) (st : PebbleCkptState) : PebbleCkptState :=
  { st with pCkpt := xor st.pCkpt (f st.x) }

/-- Inner recursive pebbling $B(s-1, k)$:
    - When `st.locked = true` (`Fix F10`), `pCkpt` is read-only and cannot be evicted or overwritten
      by inner recursion, while `pInner` is cleanly computed and uncomputed (`h pCkpt ⊕ h pCkpt = 0`).
    - When `st.locked = false` (`Issue F10` premature eviction bug), the inner schedule evicts/resets
      `pCkpt := false`, destroying the outer checkpoint! -/
def applyInnerRecursiveB (h : Bool → Bool) (st : PebbleCkptState) : PebbleCkptState :=
  if st.locked then
    { st with pInner := xor (xor st.pInner (h st.pCkpt)) (h st.pCkpt) }
  else
    { st with pCkpt := false }

/-- Full outer conjugation $U_{\text{ckpt}}^\dagger (B(s-1, k) (U_{\text{ckpt}} \text{st}))$. -/
def runNestedPebbleSchedule (f h : Bool → Bool) (st : PebbleCkptState) : PebbleCkptState :=
  applyCkptU f (applyInnerRecursiveB h (applyCkptU f st))

/-- **Fredkin Conditional Swap (`fredkinCswap` — `Issue F11` & `Fix F11`)**:
    When `c = true`, swaps `(kL, kR)` to `(kR, kL)`. -/
def fredkinCswap (c : Bool) (kL kR : Nat) : Nat × Nat :=
  if c then (kR, kL) else (kL, kR)

/-- **Naive Post-Swap Comparator Uncomputation (`naivePostSwapCompareUncompute` — `Issue F11` Bug)**:
    Computes `c := decide (kL > kR)`, swaps `(kL', kR') := fredkinCswap c kL kR`, and then
    attempts to uncompute `c` by re-evaluating `decide (kL' > kR')` on the **already-swapped** wires! -/
def naivePostSwapCompareUncompute (kL kR : Nat) : Bool × (Nat × Nat) :=
  let c := decide (kL > kR)
  let (kL', kR') := fredkinCswap c kL kR
  let cAfter := xor c (decide (kL' > kR'))
  (cAfter, (kL', kR'))

/-- **Symmetric Reverse-Pass Comparator Uncomputation (`symmetricReversePassUncompute` — `Fix F11`)**:
    Restores the comparison ancilla `c` using the pre-swap key order (or reverse-pass uncomputation)
    so `c ⊕ decide (kL > kR) = false` identically for all `(kL, kR)`. -/
def symmetricReversePassUncompute (kL kR : Nat) : Bool :=
  let c := decide (kL > kR)
  xor c (decide (kL > kR))

theorem post_fredkin_cswap_gt_always_false (kL kR : Nat) :
    let c := decide (kL > kR)
    let p := fredkinCswap c kL kR
    decide (p.1 > p.2) = false := by
  dsimp [fredkinCswap]
  by_cases h : kL > kR
  · simp [h]
    omega
  · simp [h]

/-- **Theorem 13B (`locked_pebble_checkpoint_and_fredkin_comparator_uncompute` — `Fixes F10 & F11`)**:
    1. **Locked Binomial Pebble Checkpoint Preservation (`Fix F10`)**:
       When `locked = true`, `runNestedPebbleSchedule f h ⟨x, false, false, true⟩ = ⟨x, false, false, true⟩`
       restores both `pCkpt = false` and `pInner = false` for all `f, h, x`, whereas when `locked = false`
       (`Issue F10` premature checkpoint eviction), `runNestedPebbleSchedule (fun _ => true) h ⟨true, false, false, false⟩`
       leaves `pCkpt = true ≠ false`!
    2. **Fredkin Comparator Post-Swap Uncomputation Paradox (`Issue F11`)**:
       For all `kL, kR : Nat`, after `c := decide (kL > kR)` and `(kL', kR') := fredkinCswap c kL kR`,
       we have **`decide (kL' > kR') = false` unconditionally**, so the naive post-swap uncomputation
       leaves `cAfter = xor c false = c = decide (kL > kR)`, which equals **`true ≠ false` whenever `kL > kR`**!
    3. **Symmetric Reverse-Pass Uncomputation (`Fix F11`)**:
       `symmetricReversePassUncompute kL kR = false` for all `kL, kR : Nat`. -/
theorem locked_pebble_checkpoint_and_fredkin_comparator_uncompute
    (f h : Bool → Bool) (x : Bool) (kL kR : Nat) :
    runNestedPebbleSchedule f h ⟨x, false, false, true⟩ = ⟨x, false, false, true⟩ ∧
    (runNestedPebbleSchedule (fun _ => true) h ⟨true, false, false, false⟩).pCkpt = true ∧
    decide ((fredkinCswap (decide (kL > kR)) kL kR).1 > (fredkinCswap (decide (kL > kR)) kL kR).2) = false ∧
    (naivePostSwapCompareUncompute kL kR).1 = decide (kL > kR) ∧
    (kL > kR → (naivePostSwapCompareUncompute kL kR).1 = true) ∧
    symmetricReversePassUncompute kL kR = false := by
  refine ⟨?_, rfl, post_fredkin_cswap_gt_always_false kL kR, ?_, ?_, ?_⟩
  · dsimp [runNestedPebbleSchedule, applyCkptU, applyInnerRecursiveB]
    rw [bool_xor_false_left, bool_xor_self, bool_xor_false_left, bool_xor_self]
  · unfold naivePostSwapCompareUncompute
    dsimp
    rw [post_fredkin_cswap_gt_always_false kL kR]
    exact bool_xor_false_right (decide (kL > kR))
  · intro hGt
    unfold naivePostSwapCompareUncompute
    dsimp
    rw [post_fredkin_cswap_gt_always_false kL kR, bool_xor_false_right]
    exact decide_eq_true hGt
  · unfold symmetricReversePassUncompute
    exact bool_xor_self (decide (kL > kR))

/-- **QEC Timeline Operations (`QecTimelineOp` — `Fix F12`)**:
    Models multi-round QEC + `0-DSP` FPGA syndrome decoding with explicit `qecBarrier` resets. -/
inductive QecTimelineOp : Type where
  | qecRound (measNs decodeNs : Nat) : QecTimelineOp
  | qecBarrier                       : QecTimelineOp
  deriving DecidableEq, Repr

/-- Tracks both the current QEC window latency and the peak per-window latency across all rounds. -/
structure QecLatencyState where
  currentWindowNs : Nat
  peakWindowNs    : Nat
  deriving DecidableEq, Repr

def stepQecLatency (st : QecLatencyState) : QecTimelineOp → QecLatencyState
  | .qecRound m d =>
      let cur := st.currentWindowNs + m + d
      { currentWindowNs := cur, peakWindowNs := Nat.max st.peakWindowNs cur }
  | .qecBarrier =>
      { currentWindowNs := 0, peakWindowNs := st.peakWindowNs }

def runQecTimeline (ops : List QecTimelineOp) : QecLatencyState :=
  ops.foldl stepQecLatency ⟨0, 0⟩

/-- Generates `N` consecutive `440 ns` QEC rounds (`100 ns` Meas + `340 ns` 0-DSP FPGA decode),
    each separated by `qecBarrier` (`Fix F12`). -/
def repeatBarrieredRounds : Nat → List QecTimelineOp
  | 0     => []
  | n + 1 => .qecRound 100 340 :: .qecBarrier :: repeatBarrieredRounds n

/-- 3 consecutive un-barriered QEC rounds (`Issue F12` counterexample: accumulates `1320 ns > 1000 ns`). -/
def threeUnbarrieredRounds : List QecTimelineOp :=
  [.qecRound 100 340, .qecRound 100 340, .qecRound 100 340]

/-- **LIFO Cat-Link Stack Checker (`evalCatLinkStack` — `Fix F12`)**:
    Each `(true, linkId)` pushes `linkId` onto the active cross-QPU Bell-link stack;
    each `(false, linkId)` requires the top of the stack to equal `linkId` (strict LIFO discipline). -/
def stepCatLinkStack (stk : Option (List Nat)) (ev : Bool × Nat) : Option (List Nat) :=
  match stk with
  | none => none
  | some ids =>
      if ev.1 then
        some (ev.2 :: ids)
      else
        match ids with
        | top :: rest => if top == ev.2 then some rest else none
        | []          => none

def evalCatLinkStack (events : List (Bool × Nat)) : Option (List Nat) :=
  events.foldl stepCatLinkStack (some [])

theorem foldl_barriered_invariant (N : Nat) (peak : Nat) :
    peak ≤ 440 →
    (List.foldl stepQecLatency ⟨0, peak⟩ (repeatBarrieredRounds N)).currentWindowNs = 0 ∧
    (List.foldl stepQecLatency ⟨0, peak⟩ (repeatBarrieredRounds N)).peakWindowNs ≤ 440 := by
  induction N generalizing peak with
  | zero =>
     intro hPeak
     exact ⟨rfl, hPeak⟩
  | succ n ih =>
    intro hPeak
    simp only [repeatBarrieredRounds, List.foldl, stepQecLatency]
    have hMax : Nat.max peak (0 + 100 + 340) ≤ 440 := by
      simp only [Nat.max_def]
      split <;> omega
    exact ih (Nat.max peak (0 + 100 + 340)) hMax

/-- **Theorem 13C (`qec_window_reset_and_lifo_cat_link_deadlock_freedom` — `Fix F12`)**:
    1. **QEC Window Latency Reset (`Fix F12`)**: For ANY number of rounds `N : Nat`,
       `repeatBarrieredRounds N` resets `currentWindowNs = 0` at every `qecBarrier` and satisfies
       `peakWindowNs ≤ 440 ≤ 1000` (`0` Terhal syndrome backlog across arbitrarily long computations!).
    2. **Un-Barriered Accumulation Counterexample (`Issue F12`)**: Without `qecBarrier`, 3 consecutive
       `440 ns` rounds (`threeUnbarrieredRounds`) accumulate `peakWindowNs = 1320 > 1000`, violating
       the `1000 ns` superconducting QEC cycle deadline!
    3. **LIFO Cat-Link Deadlock Freedom (`Fix F12`)**: Properly nested LIFO cat-links
       `[(true, 0), (true, 1), (false, 1), (false, 0)]` evaluate to `some []` (0 orphaned links,
       deadlock-free), whereas crossed non-LIFO links `[(true, 0), (true, 1), (false, 0), (false, 1)]`
       are rejected (`none`). -/
theorem qec_window_reset_and_lifo_cat_link_deadlock_freedom (N : Nat) :
    (runQecTimeline (repeatBarrieredRounds N)).currentWindowNs = 0 ∧
    (runQecTimeline (repeatBarrieredRounds N)).peakWindowNs ≤ 440 ∧
    (runQecTimeline (repeatBarrieredRounds N)).peakWindowNs ≤ 1000 ∧
    (runQecTimeline threeUnbarrieredRounds).peakWindowNs = 1320 ∧
    (runQecTimeline threeUnbarrieredRounds).peakWindowNs > 1000 ∧
    evalCatLinkStack [(true, 0), (true, 1), (false, 1), (false, 0)] = some [] ∧
    evalCatLinkStack [(true, 0), (true, 1), (false, 0), (false, 1)] = none := by
  have hBar := foldl_barriered_invariant N 0 (by omega)
  have h1000 : (runQecTimeline (repeatBarrieredRounds N)).peakWindowNs ≤ 1000 := by
    unfold runQecTimeline
    have h440 := hBar.2
    omega
  refine ⟨hBar.1, hBar.2, h1000, by decide, by decide, by decide, by decide⟩

