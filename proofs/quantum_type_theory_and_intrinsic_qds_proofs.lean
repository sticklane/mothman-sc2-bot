def smtPluginCanonical40BugSuite : Bool :=
  (allPhase10NewBugs.length == 4) &&
  (allPhase10NewBugs.all fun b => checkPhase10SpecHardwareSafetyNBE b == .satCounterexample) &&
  (checkPhase10SpecHardwareSafetyNBE (validPhase10Spec "QDS_Canonical_Phase10") == .unsat)

theorem thm26g_phase10_master_40bug_and_hardware_safety_soundness :
    checkPhase10SpecHardwareSafetyNBE fullPhase10BugF37 = .satCounterexample ∧
    checkPhase10SpecHardwareSafetyNBE fullPhase10BugF38 = .satCounterexample ∧
    checkPhase10SpecHardwareSafetyNBE fullPhase10BugF39 = .satCounterexample ∧
    checkPhase10SpecHardwareSafetyNBE fullPhase10BugF40 = .satCounterexample ∧
