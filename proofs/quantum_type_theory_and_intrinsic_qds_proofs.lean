structure CoreProblemQSubPhysWitness where
  problemId            : CoreProblemId
  u1Cert               : EraseByCert
  u2Repr               : QuotientReprTag
  u2ResidualQCrt       : Nat
  u3Partition          : OrthogonalPartitionCert
  u3Delta              : Nat
  u3Modulus            : Nat
  u4TaintState         : PhaseTaintState
  nQubits              : Nat
