  (isValidPpmBusPair ⟨0, 4⟩ ⟨3, 7⟩ == false) &&
  (isValidHomologicalCodeSwitch ⟨0, true⟩ == true) &&
  (isValidHomologicalCodeSwitch ⟨1, true⟩ == false) &&
  (checkBitboardMatchesSymbolic64 sampleCompositeAnfExpr6 == true) &&
