/-- Master 20-Bug Completeness Suite (`smtPluginCanonical20BugSuite` — `Simplifications S8, S10, S12` & `Fixes F1–F20`). -/
def smtPluginCanonical20BugSuite : Bool :=
  (allF1ToF20Phase5Bugs.length == 20) &&
  (allF1ToF20Phase5Bugs.all fun b => (evalCanonicalNBE b ([] : List (VoqcGate 4))).soundVerdict == .satCounterexample) &&
  (allCanonicalPhase5ValidSpecs.all fun c => (evalCanonicalNBE c ([] : List (VoqcGate 4))).soundVerdict == .unsat)

/-- **Theorem 18C (`nested_parDiag_inside_withQFree_purity_and_master_20bug_soundness_f20` — Master Theorem `S1–S12` & `F1–F20`)**:
    1. **Nested `ParDiag` Purity Characterization (`Fix F20`)**:
       `isValidNestedParDiagInWithQFree e1 e2 l1 l2 c1 c2 = true` if and only if
       `e1 = 0 ∧ e2 = 0 ∧ l1 = 0 ∧ l2 = 0 ∧ c1 = .cssClosed ∧ c2 = .cssClosed`.
    2. **Rejection of Impure Nested `ParDiag` (`Issue F20` Counterexamples)**:
       Non-zero ebit allocation (`e1 = 1`) or open CSS round (`c2 = .cssOpenX`) inside `withQFree`
       evaluates to `false`.
    3. **Master 20-Bug Completeness (`F1–F20`)**:
       All 20 adversarial bug specifications `F1..F20` evaluate to `.satCounterexample` under
       single-pass `evalCanonicalNBE`, while all 11 canonical `QDS-1..13` / `WS 14` specifications
       evaluate to `.unsat` (`smtPluginCanonical20BugSuite = true`). -/
theorem nested_parDiag_inside_withQFree_purity_and_master_20bug_soundness_f20
    (e1 e2 l1 l2 : Nat) (c1 c2 : CSSRoundState) :
    (isValidNestedParDiagInWithQFree e1 e2 l1 l2 c1 c2 = true ↔
      (e1 = 0 ∧ e2 = 0 ∧ l1 = 0 ∧ l2 = 0 ∧ c1 = .cssClosed ∧ c2 = .cssClosed)) ∧
    isValidNestedParDiagInWithQFree 1 0 0 0 .cssClosed .cssClosed = false ∧
    isValidNestedParDiagInWithQFree 0 0 0 0 .cssClosed .cssOpenX = false ∧
    (evalCanonicalNBE fullPhase5BugF17 ([] : List (VoqcGate 4))).soundVerdict = .satCounterexample ∧
    (evalCanonicalNBE fullPhase5BugF18 ([] : List (VoqcGate 4))).soundVerdict = .satCounterexample ∧
    (evalCanonicalNBE fullPhase5BugF19 ([] : List (VoqcGate 4))).soundVerdict = .satCounterexample ∧
    (evalCanonicalNBE fullPhase5BugF20 ([] : List (VoqcGate 4))).soundVerdict = .satCounterexample ∧
