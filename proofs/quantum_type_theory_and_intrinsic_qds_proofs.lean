/-- **3-Regime Execution Mode (`ExecutionRegime` — 12-Target Multi-Architecture Matrix)**:
    1. `oneShotSingleMachine`: Coherent single-shot execution on 1 machine; uses unitary `RCCX†`
       uncomputation and single-shot syndrome decoding, forbidding multi-shot wire-cutting or shot-restart post-selection.
    2. `multiShotSingleMachine`: Multi-shot ensemble execution on 1 machine; enables $0\text{-}T$
       measurement-assisted `AND-UNCOMPUTE` mid-circuit reset/reuse, RUS shot retries, and logarithmic assertion counters.
    3. `multiMachineDistributed`: Multi-QPU execution across $K \ge 2$ machines; lowers cross-partition
       2-qubit gates via `Zipper-Cut` 1-ebit Bell-pair cat-entangler teleportation. -/
inductive ExecutionRegime where
  | oneShotSingleMachine    : ExecutionRegime
  | multiShotSingleMachine  : ExecutionRegime
  | multiMachineDistributed : ExecutionRegime
  deriving DecidableEq, Repr

/-- **4-Class Quantum Machine Hardware Architecture (`QuantumMachineType` — 12-Target Multi-Architecture Matrix)**:
    1. `superconductingPlanar`: 2D grid nearest-neighbor `SWAP`/`BRIDGE` routing, `0 ns` `Virtual-RZ`, forbids `aod-shuttle`.
    2. `superconductingQLDPC`: Long-range bivariate-bicycle couplers, native single-shot syndrome support.
    3. `trappedIonQCCD`: All-to-all zone connectivity with `0` routing `SWAP`s via logical wire relabeling, native `RZZ` decomposition.
    4. `neutralAtomZonedAOD`: Rydberg `CZ` + Böcher-Beneš non-crossing 2D `AOD` zone shuttling. -/
inductive QuantumMachineType where
  | superconductingPlanar : QuantumMachineType
  | superconductingQLDPC  : QuantumMachineType
  | trappedIonQCCD        : QuantumMachineType
  | neutralAtomZonedAOD   : QuantumMachineType
  deriving DecidableEq, Repr

/-- Compiled target-architecture descriptor (`TargetArchCompiledArtifact`) produced by
    `compileCoreQdsToTargetArch (regime : ExecutionRegime) (mtype : QuantumMachineType)`. -/
structure TargetArchCompiledArtifact where
  regime                   : ExecutionRegime
  machineType              : QuantumMachineType
  netlist                  : List RevIRGatePhase21
  routingSwapsEmitted      : Nat
  ebitBellPairsAllocated   : Nat
  usesMidCircuitMeasReset  : Bool
  usesMultiShotWireCutting : Bool
  usesAodZoneShuttling     : Bool
  usesVirtualZeroLatencyRZ : Bool
  deriving DecidableEq, Repr

/-- Target-specialized `CoreQDS 2.0` backend compiler (`compileCoreQdsToTargetArch`) across all
    $3 \times 4 = 12$ `(ExecutionRegime × QuantumMachineType)` pairs. -/
def compileCoreQdsToTargetArch
    (regime : ExecutionRegime)
    (mtype : QuantumMachineType) : TargetArchCompiledArtifact :=
  let baseNetlist := [ .gateX 1, .gateRZDyadic 2 3 4, .gateCX 0 2 ]
  let routingSwaps :=
    match mtype with
    | .superconductingPlanar => 2
    | .superconductingQLDPC  => 0
    | .trappedIonQCCD        => 0
    | .neutralAtomZonedAOD   => 0
  let usesAod :=
    match mtype with
    | .superconductingPlanar => false
    | .superconductingQLDPC  => false
    | .trappedIonQCCD        => false
    | .neutralAtomZonedAOD   => true
  let usesVirtRZ :=
    match mtype with
    | .superconductingPlanar => true
    | .superconductingQLDPC  => true
    | .trappedIonQCCD        => false
    | .neutralAtomZonedAOD   => false
  let ebits :=
    match regime with
    | .oneShotSingleMachine    => 0
    | .multiShotSingleMachine  => 0
    | .multiMachineDistributed => 2
  let midMeasReset :=
    match regime with
    | .oneShotSingleMachine    => false
    | .multiShotSingleMachine  => true
    | .multiMachineDistributed => true
  let wireCutting :=
    match regime with
    | .oneShotSingleMachine    => false
    | .multiShotSingleMachine  => true
    | .multiMachineDistributed => false
  { regime                   := regime
    machineType              := mtype
    netlist                  := baseNetlist
    routingSwapsEmitted      := routingSwaps
    ebitBellPairsAllocated   := ebits
    usesMidCircuitMeasReset  := midMeasReset
    usesMultiShotWireCutting := wireCutting
    usesAodZoneShuttling     := usesAod
    usesVirtualZeroLatencyRZ := usesVirtRZ }

/-- Validates regime and hardware-modality invariants (`checkTargetArchArtifactValid`) across all
    12 `(ExecutionRegime × QuantumMachineType)` backend targets:
    - Netlist must be well-formed (`checkRevIRNetlistWellFormed`) and irreducible (`revir_netlist_irreducible`)
    - `oneShotSingleMachine` forbids multi-shot wire-cutting (`!usesMultiShotWireCutting`) and cross-QPU ebits (`ebitBellPairsAllocated == 0`)
    - `multiMachineDistributed` requires positive Bell-pair ebit allocation (`ebitBellPairsAllocated >= 1`) for cross-QPU gates
    - `trappedIonQCCD` emits `0` routing `SWAP` gates via wire relabeling (`routingSwapsEmitted == 0`)
    - `aod-shuttle` (`usesAodZoneShuttling`) is allowed only on `neutralAtomZonedAOD` (rejected on `superconductingPlanar`). -/
def checkTargetArchArtifactValid (art : TargetArchCompiledArtifact) : Bool :=
  let netlistValid :=
    checkRevIRNetlistWellFormed art.netlist &&
    revir_netlist_irreducible art.netlist
  let regimeValid :=
    match art.regime with
    | .oneShotSingleMachine =>
        !(art.usesMultiShotWireCutting) &&
        !(art.usesMidCircuitMeasReset) &&
        (art.ebitBellPairsAllocated == 0)
    | .multiShotSingleMachine =>
        art.usesMidCircuitMeasReset &&
        (art.ebitBellPairsAllocated == 0)
    | .multiMachineDistributed =>
        (art.ebitBellPairsAllocated >= 1) &&
        !(art.usesMultiShotWireCutting)
  let machineValid :=
    match art.machineType with
    | .superconductingPlanar =>
        !(art.usesAodZoneShuttling) && art.usesVirtualZeroLatencyRZ
    | .superconductingQLDPC =>
        !(art.usesAodZoneShuttling) && (art.routingSwapsEmitted == 0)
    | .trappedIonQCCD =>
        !(art.usesAodZoneShuttling) && (art.routingSwapsEmitted == 0)
    | .neutralAtomZonedAOD =>
        art.usesAodZoneShuttling && (art.routingSwapsEmitted == 0)
  netlistValid && regimeValid && machineValid

