def validPhase10Spec (name : String) : FullPhase10CircuitSpec :=
  { phase9                                 := validPhase9Spec name
    spatialBlockadeAndZoneSafe             := true
    pauliFrameFlushedBeforeNonClifford     := true
    erasureLeakageDischargedBeforeEntangle := true
    asymmetricIdleProtectedByXy4Dd         := true }

def fullPhase10BugF37 : FullPhase10CircuitSpec :=
  { validPhase10Spec "F37_RydbergBlockadeCrosstalkAndZoneOverflow" with spatialBlockadeAndZoneSafe := false }

def fullPhase10BugF38 : FullPhase10CircuitSpec :=
