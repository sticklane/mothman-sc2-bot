      effectiveLindbladActionMilli g1 + effectiveLindbladActionMilli g2 ∧
    (w.logicalQSubWellTyped && checkQPhysGradeAll3 (extractQPhysGrade w)) =
      checkQSubPhysicalLoweringSound w ∧
