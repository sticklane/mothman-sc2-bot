/-- **Theorem 20A (`fixF21_and_fixF22_reject_unflagged_hook_and_uncultivated_t` — `Fixes F21 & F22`)**:
    1. **Fix F21 (Flag-Verified Hook-Error Rejection)**: `isFlagHookSafe fg = true` if and only if
       `maxUnflaggedHookWeight fg ≤ 1`; the unflagged 4-CNOT stabilizer schedule `unflaggedNaiveScheduleF21`
       is statically rejected (`false`), while `flaggedSyndromeScheduleQec4` is accepted (`true`).
    2. **Fix F22 (Uncultivated / Flag-Triggered Magic-State Rejection)**:
       `isCultivatedRankSufficient actualRank requiredRank = true` if and only if
       `actualRank ≥ requiredRank ∧ requiredRank > 0`; raw rank-0 injection (`actualRank = 0 < 2`)
       is statically rejected (`false`), while rank-2 cultivated states (`actualRank = 2 ≥ 2`) are accepted (`true`). -/
theorem fixF21_and_fixF22_reject_unflagged_hook_and_uncultivated_t
    (fg : FaultGrade) (actualRank requiredRank : Nat) :
    (isFlagHookSafe fg = true ↔ maxUnflaggedHookWeight fg ≤ 1) ∧
    isFlagHookSafe flaggedSyndromeScheduleQec4 = true ∧
    isFlagHookSafe unflaggedNaiveScheduleF21 = false ∧
    (isCultivatedRankSufficient actualRank requiredRank = true ↔
      (actualRank ≥ requiredRank ∧ requiredRank > 0)) ∧
    isCultivatedRankSufficient 2 2 = true ∧
    isCultivatedRankSufficient 0 2 = false := by
  refine ⟨?_, by decide, by decide, ?_, by decide, by decide⟩
  · unfold isFlagHookSafe
    exact decide_eq_true_iff
  · unfold isCultivatedRankSufficient
    simp only [decide_eq_true_iff, Bool.and_eq_true]

/-- **Theorem 20B (`fixF23_and_fixF24_reject_ppm_bus_collision_and_open_gauge` — `Fixes F23 & F24`)**:
    1. **Fix F23 (Parallel Lattice-Surgery PPM Bus Collision Rejection)**:
       `isValidPpmBusPair a b = true` if and only if `ppmPairCongestion a b ≤ 1`; overlapping bus
       intervals `⟨0, 4⟩` and `⟨3, 7⟩` are statically rejected (`false`), while disjoint bus intervals
       `⟨0, 3⟩` and `⟨4, 7⟩` are accepted (`true`).
    2. **Fix F24 (Homological Code-Switching Open-Gauge / Non-Zero Boundary Rejection)**:
       `isValidHomologicalCodeSwitch st = true` if and only if `st.d1d2Residual = 0 ∧ st.allGaugeChecksFixed = true`;
       both non-zero boundary residuals (`⟨1, true⟩`) and unfixed gauge checks (`⟨0, false⟩`) are rejected (`false`). -/
theorem fixF23_and_fixF24_reject_ppm_bus_collision_and_open_gauge
    (a b : BusInterval) (st : HomologicalSwitchState) :
    (isValidPpmBusPair a b = true ↔ ppmPairCongestion a b ≤ 1) ∧
    isValidPpmBusPair ⟨0, 3⟩ ⟨4, 7⟩ = true ∧
    isValidPpmBusPair ⟨0, 4⟩ ⟨3, 7⟩ = false ∧
    (isValidHomologicalCodeSwitch st = true ↔
      (st.d1d2Residual = 0 ∧ st.allGaugeChecksFixed = true)) ∧
    isValidHomologicalCodeSwitch ⟨0, true⟩ = true ∧
    isValidHomologicalCodeSwitch ⟨1, true⟩ = false ∧
    isValidHomologicalCodeSwitch ⟨0, false⟩ = false := by
  refine ⟨?_, by decide, by decide, ?_, rfl, rfl, rfl⟩
  · unfold isValidPpmBusPair
    exact decide_eq_true_iff
  · unfold isValidHomologicalCodeSwitch
    simp only [Bool.and_eq_true, beq_iff_eq]

/-- **Full Phase-6 24-Bug Circuit Specification (`FullPhase6CircuitSpec` — `Simplifications S13–S14` & `Fixes F1–F24`)**:
    Extends `FullPhase5CircuitSpec` (`F1..F20`) with the 4 Phase-6 QEC invariants (`F21..F24`):
    - `flagHookWeightSafe`: unflagged data fault weight $\le 1$ (`Fix F21` & `QEC-4`)
    - `magicStateCultivatedSufficient`: magic-state fidelity rank $r_{\text{actual}} \ge r_{\text{req}}$ with clean flags (`Fix F22` & `QEC-5`)
    - `ppmFingerTreeBusCollisionFree`: parallel lattice-surgery PPM bus congestion $\le 1$ (`Fix F23` & `QEC-6`)
    - `homologicalCodeSwitchClosed`: $\partial_1 \circ \partial_2 = 0$ and all gauge checks fixed (`Fix F24` & `QEC-7`) -/
structure FullPhase6CircuitSpec where
  phase5                         : FullPhase5CircuitSpec
  flagHookWeightSafe             : Bool
  magicStateCultivatedSufficient : Bool
  ppmFingerTreeBusCollisionFree  : Bool
  homologicalCodeSwitchClosed    : Bool
  deriving DecidableEq, Repr

/-- Single-pass Phase-6 bitboard + hash-consed NbE soundness checker (`checkPhase6SpecBitboardNBE` — `S13–S14` & `F1–F24`). -/
def checkPhase6SpecBitboardNBE (spec : FullPhase6CircuitSpec) : SmtResult :=
  if checkPhase5SpecNBE spec.phase5 &&
     spec.flagHookWeightSafe &&
     spec.magicStateCultivatedSufficient &&
     spec.ppmFingerTreeBusCollisionFree &&
     spec.homologicalCodeSwitchClosed then
    .unsat
  else
    .satCounterexample

def validPhase6Spec (name : String) : FullPhase6CircuitSpec :=
  { phase5                         := validPhase5Spec name
    flagHookWeightSafe             := true
    magicStateCultivatedSufficient := true
    ppmFingerTreeBusCollisionFree  := true
    homologicalCodeSwitchClosed    := true }

def fullPhase6BugF21 : FullPhase6CircuitSpec :=
  { validPhase6Spec "F21_UnflaggedStabilizerHookError" with flagHookWeightSafe := false }

def fullPhase6BugF22 : FullPhase6CircuitSpec :=
  { validPhase6Spec "F22_UncultivatedOrFlaggedMagicState" with magicStateCultivatedSufficient := false }

def fullPhase6BugF23 : FullPhase6CircuitSpec :=
  { validPhase6Spec "F23_ParallelPpmFingerTreeBusCollision" with ppmFingerTreeBusCollisionFree := false }

def fullPhase6BugF24 : FullPhase6CircuitSpec :=
  { validPhase6Spec "F24_HomologicalSwitchOpenGaugeBoundary" with homologicalCodeSwitchClosed := false }

def allF1ToF24Phase6Bugs : List FullPhase6CircuitSpec :=
  (allF1ToF20Phase5Bugs.map fun b =>
    { validPhase6Spec b.phase4.base.name with phase5 := b }) ++
  [ fullPhase6BugF21, fullPhase6BugF22, fullPhase6BugF23, fullPhase6BugF24 ]

def allCanonicalPhase6ValidSpecs : List FullPhase6CircuitSpec :=
  (allCanonicalPhase5ValidSpecs.map fun c =>
    { validPhase6Spec c.phase4.base.name with phase5 := c }) ++
  [ validPhase6Spec "QEC4_FlagHookVerifiedSyndrome"
  , validPhase6Spec "QEC5_CultivatedMagicStateFactory"
  , validPhase6Spec "QEC6_FingerTreeLatticeSurgeryBus"
  , validPhase6Spec "QEC7_HomologicalCodeSwitchBoundary"
  , validPhase6Spec "QEC8_MultiQpuPauliFrameTracker" ]

/-- Master 24-Bug Completeness Suite (`smtPluginCanonical24BugSuite` — `Simplifications S1–S14` & `Fixes F1–F24`). -/
def smtPluginCanonical24BugSuite : Bool :=
  (allF1ToF24Phase6Bugs.length == 24) &&
  (allCanonicalPhase6ValidSpecs.length == 16) &&
  (allF1ToF24Phase6Bugs.all fun b => checkPhase6SpecBitboardNBE b == .satCounterexample) &&
  (allCanonicalPhase6ValidSpecs.all fun c => checkPhase6SpecBitboardNBE c == .unsat)

/-- **Theorem 20C (`phase6_master_qec_and_bitboard_nbe_soundness_f1_to_f24` — Master Theorem `S1–S14`, `OQP-1..10`, `QEC-1..8`, `F1–F24`)**:
    Unites `Simplifications S1–S14`, `OQP-1..10`, `QEC-1..8`, and `Fixes F1–F24`:
    1. `checkPhase6SpecBitboardNBE spec = .unsat` if and only if `checkPhase5SpecNBE spec.phase5 = true`
       and all four QEC invariants (`F21..F24`) hold.
    2. Each of `fullPhase6BugF21`, `fullPhase6BugF22`, `fullPhase6BugF23`, and `fullPhase6BugF24`
       evaluates to `.satCounterexample`.
    3. All `24` adversarial bug classes (`F1..F24`) evaluate to `.satCounterexample` while all `16`
       canonical `QDS-1..13` + `WS 14` + `QEC-1..8` specifications evaluate to `.unsat`
       (`smtPluginCanonical24BugSuite = true`). -/
theorem phase6_master_qec_and_bitboard_nbe_soundness_f1_to_f24
    (spec : FullPhase6CircuitSpec) :
    (checkPhase6SpecBitboardNBE spec = .unsat ↔
      (checkPhase5SpecNBE spec.phase5 = true ∧
       spec.flagHookWeightSafe = true ∧
       spec.magicStateCultivatedSufficient = true ∧
       spec.ppmFingerTreeBusCollisionFree = true ∧
       spec.homologicalCodeSwitchClosed = true)) ∧
    checkPhase6SpecBitboardNBE fullPhase6BugF21 = .satCounterexample ∧
    checkPhase6SpecBitboardNBE fullPhase6BugF22 = .satCounterexample ∧
    checkPhase6SpecBitboardNBE fullPhase6BugF23 = .satCounterexample ∧
    checkPhase6SpecBitboardNBE fullPhase6BugF24 = .satCounterexample ∧
    smtPluginCanonical24BugSuite = true := by
  refine ⟨?_, by decide, by decide, by decide, by decide, by decide⟩
  unfold checkPhase6SpecBitboardNBE
  cases h : checkPhase5SpecNBE spec.phase5 &&
            spec.flagHookWeightSafe &&
            spec.magicStateCultivatedSufficient &&
            spec.ppmFingerTreeBusCollisionFree &&
            spec.homologicalCodeSwitchClosed
  · simp only [Bool.false_eq_true, ↓reduceIte, reduceCtorEq, false_iff]
    intro ⟨h1, h2, h3, h4, h5⟩
    simp [h1, h2, h3, h4, h5] at h
  · simp only [↓reduceIte, true_iff]
    simp only [Bool.and_eq_true] at h
    exact ⟨h.1.1.1.1, h.1.1.1.2, h.1.1.2, h.1.2, h.2⟩

/-- Consolidated executable sanity check across all `Parts 1–20` (`#eval` returns `true`). -/
def verifyAllParts1To20Sanity : Bool :=
  verifyAllParts1To18Sanity &&
  (isFlagHookSafe flaggedSyndromeScheduleQec4 == true) &&
  (isFlagHookSafe unflaggedNaiveScheduleF21 == false) &&
