-- === Module: Refinement-Typed Quantum Specification & Liquid/Gospel Contract Soundness ===
-- ============================================================================

/-- **Compile-Time Pebble Lock State (`LockState` — `Fixes F10 & F15`)**:
    Tracks whether a binomial pebble checkpoint is currently locked against inner eviction. -/
inductive LockState : Type where
  | pebbleUnlocked : LockState
  | pebbleLocked   : LockState
  deriving DecidableEq, Repr

/-- **Liquid Haskell / Gospel Wire Refinement Predicate (`WireRefinement` — `Simplification S10` & `Fix F15`)**:
    Refines a wire handle with its representation state (`rep`), checkpoint lock (`lock`),
    basis-coherence mode (`mode`), algebraic degree bound (`deg`), and clean-restoration flag (`deltaZero`). -/
structure WireRefinement where
  rep       : RepState
  lock      : LockState
  mode      : BasisMode
  deg       : Nat
  deltaZero : Bool
  deriving DecidableEq, Repr

/-- **Non-Forgetful Refinement Subtyping (`checkRefinementSubtype` — `Fix F15`)**:
    A refinement `sub` is a valid subtype of `sup` across module/signature boundaries if and only if
    `rep`, `lock`, `mode`, and `deltaZero` are preserved identically (`sub.rep = sup.rep`,
    `sub.lock = sup.lock`, `sub.mode = sup.mode`, `sub.deltaZero = sup.deltaZero`) and
    `sub.deg ≤ sup.deg`. Any forgetful cast that widens `.redundantCS` to `.canonicalMod`,
    `.pebbleUnlocked` to `.pebbleLocked`, or `.hadamardMixed` to `.qfree` is statically rejected! -/
def checkRefinementSubtype (sub sup : WireRefinement) : Bool :=
  (sub.rep == sup.rep) &&
  (sub.lock == sup.lock) &&
  (sub.mode == sup.mode) &&
  (sub.deltaZero == sup.deltaZero) &&
  decide (sub.deg ≤ sup.deg)

/-- `Issue F15` Counterexample 1: Forgetful cast from `.redundantCS` to `.canonicalMod` without `consolidateMod`. -/
def f15ForgetfulRepCast : Bool :=
  checkRefinementSubtype
    ⟨.redundantCS,  .pebbleLocked, .qfree, 1, true⟩
    ⟨.canonicalMod, .pebbleLocked, .qfree, 1, true⟩

/-- `Issue F15` Counterexample 2: Forgetful cast from `.pebbleUnlocked` to `.pebbleLocked`. -/
def f15ForgetfulLockCast : Bool :=
  checkRefinementSubtype
    ⟨.canonicalMod, .pebbleUnlocked, .qfree, 1, true⟩
    ⟨.canonicalMod, .pebbleLocked,   .qfree, 1, true⟩

/-- `Issue F15` Counterexample 3: Forgetful cast from `.hadamardMixed` to `.qfree`. -/
def f15ForgetfulModeCast : Bool :=
  checkRefinementSubtype
    ⟨.canonicalMod, .pebbleLocked, .hadamardMixed, 1, true⟩
    ⟨.canonicalMod, .pebbleLocked, .qfree,         1, true⟩

/-- **Theorem 16A (`refinement_subtyping_monotonicity_and_f15_forgetful_cast_rejection` — `Simplification S10` & `Fix F15`)**:
    1. **Reflexivity & Transitivity**: `checkRefinementSubtype` is a reflexive and transitive preorder
       on `WireRefinement`.
    2. **Exact Invariant Preservation**: `checkRefinementSubtype r1 r2 = true` implies
       `r1.rep = r2.rep ∧ r1.lock = r2.lock ∧ r1.mode = r2.mode ∧ r1.deltaZero = r2.deltaZero ∧ r1.deg ≤ r2.deg`.
    3. **Forgetful Cast Rejection (`Fix F15`)**: All three `Issue F15` forgetful module-boundary casts
       (`f15ForgetfulRepCast`, `f15ForgetfulLockCast`, `f15ForgetfulModeCast`) evaluate to `false`! -/
theorem refinement_subtyping_monotonicity_and_f15_forgetful_cast_rejection
    (r1 r2 r3 : WireRefinement) :
    checkRefinementSubtype r1 r1 = true ∧
    (checkRefinementSubtype r1 r2 = true →
     checkRefinementSubtype r2 r3 = true →
     checkRefinementSubtype r1 r3 = true) ∧
    (checkRefinementSubtype r1 r2 = true ↔
      (r1.rep = r2.rep ∧ r1.lock = r2.lock ∧ r1.mode = r2.mode ∧
       r1.deltaZero = r2.deltaZero ∧ r1.deg ≤ r2.deg)) ∧
    f15ForgetfulRepCast = false ∧
    f15ForgetfulLockCast = false ∧
    f15ForgetfulModeCast = false := by
  refine ⟨?_, ?_, ?_, by decide, by decide, by decide⟩
  · unfold checkRefinementSubtype
    simp
  · intro h12 h23
    unfold checkRefinementSubtype at h12 h23 ⊢
    simp only [Bool.and_eq_true, beq_iff_eq, decide_eq_true_eq] at h12 h23 ⊢
    refine ⟨⟨⟨⟨?_, ?_⟩, ?_⟩, ?_⟩, ?_⟩
    · exact Eq.trans h12.1.1.1.1 h23.1.1.1.1
    · exact Eq.trans h12.1.1.1.2 h23.1.1.1.2
    · exact Eq.trans h12.1.1.2 h23.1.1.2
    · exact Eq.trans h12.1.2 h23.1.2
    · omega
  · unfold checkRefinementSubtype
    simp only [Bool.and_eq_true, beq_iff_eq, decide_eq_true_eq]
    exact ⟨fun h => ⟨h.1.1.1.1, h.1.1.1.2, h.1.1.2, h.1.2, h.2⟩,
           fun h => ⟨⟨⟨⟨h.1, h.2.1⟩, h.2.2.1⟩, h.2.2.2.1⟩, h.2.2.2.2⟩⟩

/-- **SMT Verification Condition Result (`SmtResult` — `Simplification S10`)**:
    Models the result of querying the SMT solver (`Z3` / internal decidable $\mathbb{F}_2[x]$ +
    Presburger arithmetic solver) on the negated verification condition $\neg \text{VC}(C)$:
    - `.unsat`: $\neg \text{VC}(C)$ is unsatisfiable, so $\text{VC}(C)$ is universally valid (`accepted`).
    - `.satCounterexample`: $\neg \text{VC}(C)$ is satisfiable, yielding an explicit bug witness (`rejected`). -/
inductive SmtResult : Type where
  | unsat             : SmtResult
  | satCounterexample : SmtResult
  deriving DecidableEq, Repr

/-- **Full Phase-4 16-Bug Circuit Specification (`FullPhase4CircuitSpec` — `Simplifications S8, S9, S10` & `Fixes F1–F16`)**:
    Combines the 9 checks of `CanonicalCircuitCheckSpec` (`F1..F12`) with the 4 Phase-4 compiler
    and refinement plugin checks (`F13..F16`). -/
structure FullPhase4CircuitSpec where
  base                        : CanonicalCircuitCheckSpec
  voqcBarrierCommutationValid : Bool
  stimDetectorsDeterministic  : Bool
  refinementSubtypingMonotone : Bool
  bbTorusShiftCssClosed       : Bool
  deriving DecidableEq, Repr

/-- Certifying compiler typechecker `typeofCertifiedCompiler` (`typeof-certified-compiler` in Redex). -/
def typeofCertifiedCompiler (spec : FullPhase4CircuitSpec) : Bool :=
  verifyCanonicalQDSCircuit spec.base &&
  spec.voqcBarrierCommutationValid &&
  spec.stimDetectorsDeterministic &&
  spec.refinementSubtypingMonotone &&
  spec.bbTorusShiftCssClosed

/-- SMT-backed Liquid Haskell / OCaml Gospel refinement VC decision procedure (`decideCanonicalRefinementVC` — `Simplification S10`):
    Checks whether the negated refinement verification condition $\neg \text{VC}(\text{spec})$ is satisfiable.
    Returns `.unsat` when no counterexample exists, or `.satCounterexample` when any `F1..F16` invariant is violated. -/
def decideCanonicalRefinementVC (spec : FullPhase4CircuitSpec) : SmtResult :=
  if typeofCertifiedCompiler spec then
    .unsat
  else
    .satCounterexample

def validPhase4Spec (name : String) : FullPhase4CircuitSpec :=
