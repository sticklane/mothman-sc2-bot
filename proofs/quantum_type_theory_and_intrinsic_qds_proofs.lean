  let s1 := varBitboard0 ^^^ varBitboard1 ^^^ varBitboard2
  let c1 := (varBitboard0 &&& varBitboard1) ^^^ (varBitboard2 &&& (varBitboard0 ^^^ varBitboard1))
  let vec : BitboardVec6 := ⟨varBitboard0, s1, c1, c0 ^^^ varBitboard3, varBitboard4, varBitboard5⟩
  { gadgetId         := 1
    name             := "GADGET1_SkewCarrySaveMerge"
    baselineToffolis := 4
    superoptToffolis := 3
