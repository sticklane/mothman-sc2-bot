  , gadget6SpeculativeWindowedLut ]

def totalBaselineGadgetToffolis : Nat :=
  allSuperoptGadgets1To6.foldl (fun acc g => acc + g.baselineToffolis) 0

def totalSuperoptGadgetToffolis : Nat :=
  allSuperoptGadgets1To6.foldl (fun acc g => acc + g.superoptToffolis) 0

def totalBaselineGadgetDepth : Nat :=
  allSuperoptGadgets1To6.foldl (fun acc g => acc + g.baselineDepth) 0

def totalSuperoptGadgetDepth : Nat :=
  allSuperoptGadgets1To6.foldl (fun acc g => acc + g.superoptDepth) 0

/-- **Theorem 21C (`thm21c_gadget1_to_6_superopt_equivalence_and_toffoli_reduction` — `Simplification S15` & `GADGET-1..6`)**:
    Proves that across all 6 superoptimized gadgets (`GADGET-1..6`):
    1. Every gadget preserves exact 64-bit bitboard semantics (`bb_vec_eq g.baselineVec g.superoptVec = true`)
       while strictly reducing Toffoli count (`g.superoptToffolis < g.baselineToffolis`) and circuit depth
       (`g.superoptDepth < g.baselineDepth`).
    2. Total Toffoli count across the 6-gadget suite drops from `31` to `18` ($41.9\%$ reduction),
       and total circuit depth drops from `41` to `24` ($41.5\%$ reduction). -/
theorem thm21c_gadget1_to_6_superopt_equivalence_and_toffoli_reduction :
    (allSuperoptGadgets1To6.all fun g =>
      bb_vec_eq g.baselineVec g.superoptVec &&
      decide (g.superoptToffolis < g.baselineToffolis) &&
      decide (g.superoptDepth < g.baselineDepth)) = true ∧
    totalBaselineGadgetToffolis = 31 ∧
    totalSuperoptGadgetToffolis = 18 ∧
    totalBaselineGadgetDepth = 41 ∧
    totalSuperoptGadgetDepth = 24 := by
  refine ⟨by decide, rfl, rfl, rfl, rfl⟩

/-- **Bidirectional Meet-in-the-Middle (MITM) Search Space & Optimality Model (`Simplification S15`)**:
    For branching factor `b` and target depth `2 * r`, bidirectional MITM explores forward and
    backward balls of radius `r`, requiring `2 * (b ^ r)` states instead of `b ^ (2 * r)`. -/
def mitmBidirectionalStates (b r : Nat) : Nat :=
  2 * (b ^ r)

def exhaustiveUnidirectionalStates (b r : Nat) : Nat :=
  b ^ (2 * r)

/-- Given a finite list of candidate circuits `[d_0, d_1, ...]` reachable via `r`-step forward +
    `r`-step backward MITM collision (`d_i ≤ 2 * r`), `mitmMinDepth` selects the minimum depth. -/
def mitmMinDepth (candidates : List Nat) (fallback : Nat) : Nat :=
  candidates.foldl Nat.min fallback

theorem foldl_min_le_acc (xs : List Nat) (acc : Nat) :
    xs.foldl Nat.min acc ≤ acc := by
  induction xs generalizing acc with
  | nil => exact Nat.le_refl acc
  | cons x xs ih =>
    simp only [List.foldl_cons]
    have h1 := ih (Nat.min acc x)
    have h2 : Nat.min acc x ≤ acc := Nat.min_le_left acc x
    omega

theorem foldl_min_le_mem (xs : List Nat) (acc c : Nat) (hMem : c ∈ xs) :
    xs.foldl Nat.min acc ≤ c := by
  induction xs generalizing acc with
  | nil => contradiction
  | cons x xs ih =>
    simp only [List.mem_cons] at hMem
    simp only [List.foldl_cons]
    rcases hMem with rfl | hTail
    · have h1 := foldl_min_le_acc xs (Nat.min acc c)
      have h2 : Nat.min acc c ≤ c := Nat.min_le_right acc c
      omega
    · exact ih (Nat.min acc x) hTail

/-- **Theorem 21D (`thm21d_mitm_bidirectional_synthesis_optimality` — `Simplification S15`)**:
    Proves that:
    1. Whenever a circuit of depth `c` belongs to the bidirectional MITM collision set `candidates`,
       `mitmMinDepth candidates fallback ≤ c` (guarantees minimum-cost circuit selection).
    2. For branching factor $b = 16$ and target depth $d = 6$ ($r = 3$), bidirectional MITM explores
       `2 * 16^3 = 8,192` states versus `16^6 = 16,777,216` unidirectional states ($2048\times$ reduction). -/
theorem thm21d_mitm_bidirectional_synthesis_optimality
    (candidates : List Nat) (fallback c : Nat) (hMem : c ∈ candidates) :
    mitmMinDepth candidates fallback ≤ c ∧
    mitmBidirectionalStates 16 3 = 8192 ∧
    exhaustiveUnidirectionalStates 16 3 = 16777216 ∧
    mitmBidirectionalStates 16 3 < exhaustiveUnidirectionalStates 16 3 := by
  refine ⟨foldl_min_le_mem candidates fallback c hMem, rfl, rfl, by decide⟩

