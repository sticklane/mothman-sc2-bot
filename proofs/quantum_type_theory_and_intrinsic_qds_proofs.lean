  , predicateMaxWeight  := 2
  , hasBijectionInverse := true
  , isCanonicalQuotient := false
  , phaseTaintMask      := 0 }

def dropRule2Witness : QSubJudgment :=
  { supportMaxWeight    := 2
  , predicateMaxWeight  := 2
  , hasBijectionInverse := true
  , isCanonicalQuotient := true
  , phaseTaintMask      := 0 }

def dropRule3Witness : QSubJudgment :=
