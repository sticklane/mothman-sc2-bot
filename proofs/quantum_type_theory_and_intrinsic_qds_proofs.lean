  c.qunityOrthogonalCaseSafe &&
  c.rccxPhaseCommuteAndCatalystSafe &&
  c.realtimeQueueAndAcyclicEGraphSafe &&
  c.chromaticTransversalCrosstalkSafe

def canonicalValidFullPhase12Circuit : FullPhase12CircuitSpec :=
  { toFullPhase11CircuitSpec          := validPhase11Spec "QDS_Canonical_Phase12"
    qunityOrthogonalCaseSafe          := true
    rccxPhaseCommuteAndCatalystSafe   := true
    realtimeQueueAndAcyclicEGraphSafe := true
    chromaticTransversalCrosstalkSafe := true }

def fullPhase12BugF45 : FullPhase12CircuitSpec :=
