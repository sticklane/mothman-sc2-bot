      decide (s.okasakiCostOrLines < s.baselineCostOrLines) &&
      decide (s.unflaggedHookWeight ≤ 1) &&
      decide (s.qecWindowNs ≤ 1000)) = true := by
  refine ⟨by decide, by decide, by decide, by decide, ?_, ?_, ?_, by decide, by decide⟩
  · unfold cultivateMagicStateRank
    simp
  · unfold cultivateMagicStateRank
    have hNe : (r == r + 1) = false := by
      rw [beq_eq_false_iff_ne]
      omega
    rw [hNe]
    rfl
