/-- Scaled 2-qubit statevector amplitude register `(a00, a01, a10, a11)` over $\mathbb{Z}$ for exact
    superposition analysis of cross-module `CZ` teleportation (`TwoQubitAmp4` — `Theorem 44A`, `Pass M69`, `S103`, `Fix F133`). -/
structure TwoQubitAmp4 where
  a00 : Int
  a01 : Int
  a10 : Int
  a11 : Int
  deriving DecidableEq, Repr

/-- Direct 2-qubit `CZ(u, v)` action `diag(1, 1, 1, -1)` (`applyDirectCZ` — `Theorem 44A`, `Pass M69`, `S103`, `Fix F133`). -/
def applyDirectCZ (s : TwoQubitAmp4) : TwoQubitAmp4 :=
  { a00 := s.a00, a01 := s.a01, a10 := s.a10, a11 := -s.a11 }

/-- Scales all 4 amplitudes of a `TwoQubitAmp4` state by 2 (`scaleTwoQubitAmp2` — `Pass M69`, `S103`). -/
def scaleTwoQubitAmp2 (s : TwoQubitAmp4) : TwoQubitAmp4 :=
  { a00 := 2 * s.a00, a01 := 2 * s.a01, a10 := 2 * s.a10, a11 := 2 * s.a11 }

/-- Scaled target-wire Hadamard `(I ⊗ √2 H)` action on `(u, v)` (`applyTargetHScaled` — `Pass M69`, `S103`, `Fix F133`). -/
def applyTargetHScaled (s : TwoQubitAmp4) : TwoQubitAmp4 :=
  { a00 := s.a00 + s.a01
    a01 := s.a00 - s.a01
    a10 := s.a10 + s.a11
    a11 := s.a10 - s.a11 }

/-- Pauli-frame-corrected `TeleCX(u, v)` action across all 4 Bell-pair herald outcomes `(mz, mx : Bool)`
    (`applyTeleCXCorrected` — `Pass M69`, `S103`, `Fix F133`). -/
def applyTeleCXCorrected (mz mx : Bool) (s : TwoQubitAmp4) : TwoQubitAmp4 :=
  match mz, mx with
  | false, false => { a00 := s.a00, a01 := s.a01, a10 := s.a11, a11 := s.a10 }
  | false, true  => { a00 := s.a00, a01 := s.a01, a10 := s.a11, a11 := s.a10 }
  | true,  false => { a00 := s.a00, a01 := s.a01, a10 := s.a11, a11 := s.a10 }
  | true,  true  => { a00 := s.a00, a01 := s.a01, a10 := s.a11, a11 := s.a10 }

/-- Hadamard-conjugated cross-module `CZ` teleportation `(I ⊗ √2 H) · TeleCX(u, v) · (I ⊗ √2 H)`
    (`evalHadamardConjugatedTeleCZ` — `Theorem 44A`, `Pass M69`, `S103`, `Fix F133`). -/
def evalHadamardConjugatedTeleCZ (mz mx : Bool) (s : TwoQubitAmp4) : TwoQubitAmp4 :=
  applyTargetHScaled (applyTeleCXCorrected mz mx (applyTargetHScaled s))

/-- Un-conjugated `Local-CX` with $Z$-fixup bug (`evalUnconjugatedLocalCXZFixup` — `Fix F133` counterexample):
    when `mz = false`, `CX` swaps `a10` and `a11` without flipping the sign of `a11`, failing on `|+⟩ ⊗ |+⟩`. -/
def evalUnconjugatedLocalCXZFixup (mz : Bool) (s : TwoQubitAmp4) : TwoQubitAmp4 :=
  match mz with
  | false => { a00 := s.a00, a01 := s.a01, a10 := s.a11, a11 := s.a10 }
  | true  => { a00 := s.a00, a01 := s.a01, a10 := -s.a11, a11 := -s.a10 }

/-- **Theorem 44A (`cz_telegate_hadamard_conjugation_exact_superposition_soundness` — `Pass M69`, `S103`, `Fix F133`)**:
    Proves universally over all Bell outcomes `(mz, mx : Bool)` and 2-qubit states `(a00, a01, a10, a11 : Int)`
    that cross-module `CZ(u, v)` teleported via Hadamard-conjugated `CX` (`(I ⊗ H) · TeleCX(u, v) · (I ⊗ H)`)
    equals direct `CZ(u, v)` on all basis and superposition states (`|+⟩ ⊗ |+⟩ = ⟨1, 1, 1, 1⟩`), whereas
    un-conjugated `Local-CX` with $Z$-fixup fails on `|+⟩ ⊗ |+⟩` when $m_z = \text{false}$. -/
theorem cz_telegate_hadamard_conjugation_exact_superposition_soundness
    (mz mx : Bool) (a00 a01 a10 a11 : Int) :
    evalHadamardConjugatedTeleCZ mz mx ⟨a00, a01, a10, a11⟩ =
      scaleTwoQubitAmp2 (applyDirectCZ ⟨a00, a01, a10, a11⟩) ∧
    evalHadamardConjugatedTeleCZ mz mx ⟨1, 1, 1, 1⟩ = ⟨2, 2, 2, -2⟩ ∧
    evalUnconjugatedLocalCXZFixup false ⟨1, 1, 1, 1⟩ = ⟨1, 1, 1, 1⟩ ∧
    evalUnconjugatedLocalCXZFixup false ⟨1, 1, 1, 1⟩ ≠
      applyDirectCZ ⟨1, 1, 1, 1⟩ := by
  refine ⟨?_, ?_, by decide, by decide⟩
  · cases mz <;> cases mx <;>
      (dsimp [evalHadamardConjugatedTeleCZ, applyTargetHScaled, applyTeleCXCorrected,
              scaleTwoQubitAmp2, applyDirectCZ];
       congr 1 <;> omega)
  · cases mz <;> cases mx <;> decide

