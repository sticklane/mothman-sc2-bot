    usesFloat64Angles    := false }

theorem canonical_repair_p1_sound_helper (minVol : Nat) (hVol : minVol ≤ 693) :
    checkP1ActiveVolumeBelowBqpCliff 1 minVol 1000 0 0 = true := by
