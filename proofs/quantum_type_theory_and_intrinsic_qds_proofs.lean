/-- **Fault-Propagating Symbolic ANF Polynomial Grade (`FaultGrade` — `Simplification S13` & `QEC-4`)**:
    Tracks symbolic mid-circuit fault variables $e_0, e_1 \in \mathbb{F}_2$ propagating through
    `CNOT` ladders onto data wires (`dataFaultMask0`, `dataFaultMask1 : Nat`, bitmasks of data wires
    infected by $e_0, e_1$) and flag detector wires (`flag0Triggered`, `flag1Triggered : Bool`). -/
structure FaultGrade where
  dataFaultWeightE0 : Nat
  dataFaultWeightE1 : Nat
  flag0Triggered    : Bool
  flag1Triggered    : Bool
  deriving DecidableEq, Repr

/-- Computes the maximum unflagged data fault weight induced by any single mid-circuit fault $e_k$
    (`maxUnflaggedHookWeight` — `Simplification S13` & `QEC-4`):
    If a fault variable $e_k$ triggers a flag detector (`flagTriggered = true`), the syndrome decoder
    is alerted to the hook error, leaving effective unflagged data weight $\le 1$. If `flagTriggered = false`,
    its full data weight (`dataFaultWeight`) propagates undetected! -/
def effectiveUnflaggedWeight (dataWeight : Nat) (flagged : Bool) : Nat :=
  if flagged then Nat.min dataWeight 1 else dataWeight

def maxUnflaggedHookWeight (fg : FaultGrade) : Nat :=
  Nat.max (effectiveUnflaggedWeight fg.dataFaultWeightE0 fg.flag0Triggered)
          (effectiveUnflaggedWeight fg.dataFaultWeightE1 fg.flag1Triggered)

/-- Admissibility check for flag-verified syndrome extraction (`isFlagHookSafe` — `QEC-4` & `Fix F21`):
    Every single-fault channel must have effective unflagged data weight $\le 1$ ($\lfloor (d-1)/2 \rfloor$). -/
def isFlagHookSafe (fg : FaultGrade) : Bool :=
  decide (maxUnflaggedHookWeight fg ≤ 1)

/-- Concrete flag-verified Chamberland–Beverland / Chao–Reichardt weight-4 stabilizer schedule (`QEC-4`):
    A single $X$-fault at the midpoint of the CNOT ladder spreads to weight 2 on data wires (`dataFaultWeightE0 = 2`),
    but simultaneously flips the bridge flag qubit (`flag0Triggered = true`), bounding unflagged hook weight to $1$. -/
def flaggedSyndromeScheduleQec4 : FaultGrade :=
  { dataFaultWeightE0 := 2
    dataFaultWeightE1 := 1
    flag0Triggered    := true
    flag1Triggered    := false }

/-- Concrete unflagged naive 4-CNOT stabilizer schedule (`Issue F21` counterexample):
    Midpoint fault $e_0$ spreads to 2 data wires (`dataFaultWeightE0 = 2`) with `flag0Triggered = false`,
    producing an unflagged weight-2 hook error (`maxUnflaggedHookWeight = 2 > 1`)! -/
def unflaggedNaiveScheduleF21 : FaultGrade :=
  { dataFaultWeightE0 := 2
    dataFaultWeightE1 := 1
    flag0Triggered    := false
    flag1Triggered    := false }

/-- **Magic-State Cultivation Fidelity-Rank Step (`cultivateMagicStateRank` — `QEC-5` & `Fix F22`)**:
    Combines two rank-$r$ magic states via `OkasakiBinomialCollimationQueue` (`QDS-13`) and
    `BrodalOkasakiSkewHeap` (`QDS-11`) only when both input states have matching rank $r_1 = r_2 = r$
    and pass the clean double-check detector (`flagClean = true`), advancing fidelity rank to $r + 1$. -/
def cultivateMagicStateRank (r1 r2 : Nat) (flagClean : Bool) : Option Nat :=
  if (r1 == r2) && flagClean then
    some (r1 + 1)
  else
    none

/-- Checks whether a cultivated magic state meets the target fault-tolerant `Toffoli`/`CCZ` rank threshold
    (`isCultivatedRankSufficient` — `QEC-5` & `Fix F22`). -/
def isCultivatedRankSufficient (actualRank requiredRank : Nat) : Bool :=
  decide (actualRank ≥ requiredRank && requiredRank > 0)

/-- Quantitative Benchmark Entry for each of the 8 Quantum Error Correction Problems (`QEC-1..8`). -/
structure QecProblemSpec where
  qecId               : Nat
