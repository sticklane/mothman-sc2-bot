/-- **6-Wire Bitboard Signature (`BitboardVec6` — `Simplification S15` & `Fix F25`)**:
    Represents the exact 64-point truth-table vector `(bb0, bb1, bb2, bb3, bb4, bb5)` of a
    6-wire reversible/fault-propagating gadget over $\mathbb{F}_2^6$ ($4$ data wires $x_0..x_3$
    and $2$ fault/ancilla wires $e_0, e_1$). -/
structure BitboardVec6 where
  bb0 : Bitboard64
  bb1 : Bitboard64
  bb2 : Bitboard64
  bb3 : Bitboard64
  bb4 : Bitboard64
  bb5 : Bitboard64
  deriving DecidableEq, Repr

/-- Exact 64-bit bitboard vector equality (`bb_vec_eq` — `Simplification S15` & `Fix F25`). -/
def bb_vec_eq (u v : BitboardVec6) : Bool :=
  (u.bb0 == v.bb0) && (u.bb1 == v.bb1) && (u.bb2 == v.bb2) &&
  (u.bb3 == v.bb3) && (u.bb4 == v.bb4) && (u.bb5 == v.bb5)

/-- Evaluates a `BitboardVec6` at a single 6-bit basis state `pt : UInt64` ($0 \le \text{pt} < 64$). -/
def evalBitboardVecAtPoint (u : BitboardVec6) (pt : UInt64) :
    Bool × Bool × Bool × Bool × Bool × Bool :=
  ( bitboardGetBit u.bb0 pt
  , bitboardGetBit u.bb1 pt
  , bitboardGetBit u.bb2 pt
  , bitboardGetBit u.bb3 pt
  , bitboardGetBit u.bb4 pt
  , bitboardGetBit u.bb5 pt )

/-- Exhaustive 64-state basis equivalence check across all $2^6 = 64$ inputs (`basisEquiv64`). -/
def basisEquiv64 (u v : BitboardVec6) : Bool :=
  (List.range 64).all fun k =>
    let pt := k.toUInt64
    evalBitboardVecAtPoint u pt == evalBitboardVecAtPoint v pt

/-- Incomplete 16-row subspace check (`subspaceEquiv16_BugF25` — `Issue F25` bug):
    Checks only the lower 16 truth-table rows ($e_0 = 0, e_1 = 0$, mask `0x000000000000FFFF`),
    which unsoundly accepts counterfeit circuits that corrupt wires when $e_0 = 1$ or $e_1 = 1$! -/
def mask16Subspace : Bitboard64 := 0x000000000000FFFF

def subspaceEquiv16_BugF25 (u v : BitboardVec6) : Bool :=
  ((u.bb0 &&& mask16Subspace) == (v.bb0 &&& mask16Subspace)) &&
  ((u.bb1 &&& mask16Subspace) == (v.bb1 &&& mask16Subspace)) &&
  ((u.bb2 &&& mask16Subspace) == (v.bb2 &&& mask16Subspace)) &&
  ((u.bb3 &&& mask16Subspace) == (v.bb3 &&& mask16Subspace)) &&
  ((u.bb4 &&& mask16Subspace) == (v.bb4 &&& mask16Subspace)) &&
  ((u.bb5 &&& mask16Subspace) == (v.bb5 &&& mask16Subspace))

/-- Canonical identity 6-wire bitboard vector. -/
def idBitboardVec6 : BitboardVec6 :=
  ⟨varBitboard0, varBitboard1, varBitboard2, varBitboard3, varBitboard4, varBitboard5⟩

/-- Counterfeit 6-wire bitboard vector (`counterfeitVecF25` — `Issue F25` witness):
    Agrees with `idBitboardVec6` on all 16 rows where $e_0 = 0, e_1 = 0$, but XORs fault variable
    $e_0$ (`varBitboard4`) onto wire 0 whenever $e_0 = 1$ (e.g., at point `pt = 16`). -/
def counterfeitVecF25 : BitboardVec6 :=
  { idBitboardVec6 with bb0 := varBitboard0 ^^^ varBitboard4 }

/-- **Theorem 21A (`thm21a_f25_bitboard_subspace_completeness` — `Simplification S15` & `Fix F25`)**:
    Proves that:
    1. Two reversible circuits have identical 64-bit bitboard vectors (`bb_vec_eq u v = true`)
       if and only if `u = v`.
    2. For `idBitboardVec6`, `basisEquiv64 idBitboardVec6 idBitboardVec6 = true`.
    3. **Fix F25 (Rejection of 16-Row Subspace Counterfeit)**: `counterfeitVecF25` fools the
       16-row subspace check (`subspaceEquiv16_BugF25 idBitboardVec6 counterfeitVecF25 = true`),
       but is caught by full 64-bit bitboard verification (`bb_vec_eq idBitboardVec6 counterfeitVecF25 = false`
       and `basisEquiv64 idBitboardVec6 counterfeitVecF25 = false`, disagreeing at basis state `pt = 16`). -/
theorem thm21a_f25_bitboard_subspace_completeness (u v : BitboardVec6) :
    (bb_vec_eq u v = true ↔ u = v) ∧
    basisEquiv64 idBitboardVec6 idBitboardVec6 = true ∧
    subspaceEquiv16_BugF25 idBitboardVec6 counterfeitVecF25 = true ∧
    bb_vec_eq idBitboardVec6 counterfeitVecF25 = false ∧
    basisEquiv64 idBitboardVec6 counterfeitVecF25 = false ∧
    evalBitboardVecAtPoint idBitboardVec6 16 ≠ evalBitboardVecAtPoint counterfeitVecF25 16 := by
  refine ⟨?_, by decide, by decide, by decide, by decide, by decide⟩
  rcases u with ⟨u0, u1, u2, u3, u4, u5⟩
  rcases v with ⟨v0, v1, v2, v3, v4, v5⟩
  unfold bb_vec_eq
  simp only [Bool.and_eq_true, beq_iff_eq, BitboardVec6.mk.injEq]
  exact ⟨fun h => ⟨h.1.1.1.1.1, h.1.1.1.1.2, h.1.1.1.2, h.1.1.2, h.1.2, h.2⟩,
         fun h => ⟨⟨⟨⟨⟨h.1, h.2.1⟩, h.2.2.1⟩, h.2.2.2.1⟩, h.2.2.2.2.1⟩, h.2.2.2.2.2⟩⟩

/-- **Zero-Cost `HMR_CZ` Uncomputation Admissibility (`isValidHmrCzSubstitution` — `Fix F26`)**:
    Substituting a 1-Toffoli `CCX(c1, c2, t)` uncomputation with a 0-Toffoli `HMR_CZ(t, c1, c2)`
    measurement-and-reset uncomputation is semantics-preserving if and only if the target wire's
    current bitboard `bb_t` equals the exact bitwise AND of the two control bitboards (`bb_c1 &&& bb_c2`),
    leaving zero residual bitboard (`(bb_t ^^^ (bb_c1 &&& bb_c2)) == 0`) prior to reset. -/
def isValidHmrCzSubstitution (bb_c1 bb_c2 bb_t : Bitboard64) : Bool :=
  bb_t == (bb_c1 &&& bb_c2)

/-- Residual uncomputation garbage left on target wire `t` after `CCX(c1, c2, t)` uncomputation. -/
def uncomputeResidualBitboard (bb_c1 bb_c2 bb_t : Bitboard64) : Bitboard64 :=
  bb_t ^^^ (bb_c1 &&& bb_c2)

/-- **Theorem 21B (`thm21b_f26_hmr_cz_zero_cost_substitution_soundness` — `Fix F26`)**:
    Proves that:
    1. `isValidHmrCzSubstitution bb_c1 bb_c2 bb_t = true` **if and only if** `bb_t = bb_c1 &&& bb_c2`.
    2. For a clean quadratic product target `bb_t := varBitboard0 &&& varBitboard1`,
       `isValidHmrCzSubstitution` holds (`true`) and `uncomputeResidualBitboard` is `0`.
    3. **Fix F26 (Rejection of Non-Pure-Quadratic Target in `HMR_CZ`)**: When `bb_t` carries a
       residual linear term (`varBitboard2 ^^^ (varBitboard0 &&& varBitboard1)`), substituting
       `HMR_CZ` is statically rejected (`isValidHmrCzSubstitution = false`) and leaves non-zero
       residual bitboard `varBitboard2 ≠ 0`! -/
theorem thm21b_f26_hmr_cz_zero_cost_substitution_soundness
    (bb_c1 bb_c2 bb_t : Bitboard64) :
    (isValidHmrCzSubstitution bb_c1 bb_c2 bb_t = true ↔ bb_t = (bb_c1 &&& bb_c2)) ∧
    isValidHmrCzSubstitution varBitboard0 varBitboard1 (varBitboard0 &&& varBitboard1) = true ∧
    uncomputeResidualBitboard varBitboard0 varBitboard1 (varBitboard0 &&& varBitboard1) = 0 ∧
    isValidHmrCzSubstitution varBitboard0 varBitboard1
      (varBitboard2 ^^^ (varBitboard0 &&& varBitboard1)) = false ∧
    uncomputeResidualBitboard varBitboard0 varBitboard1
      (varBitboard2 ^^^ (varBitboard0 &&& varBitboard1)) = varBitboard2 := by
  refine ⟨?_, by decide, by decide, by decide, by decide⟩
  unfold isValidHmrCzSubstitution
  exact beq_iff_eq

/-- **AlphaDev / AlphaCode Superoptimized Gadget Specification (`SuperoptGadgetSpec` — `Simplification S15` & `GADGET-1..6`)**:
    Records the baseline and MITM-superoptimized Toffoli counts, depths, and 64-bit bitboard signatures
    across all 6 core quantum data structure and QEC gadgets. -/
structure SuperoptGadgetSpec where
  gadgetId         : Nat
  name             : String
  baselineToffolis : Nat
  superoptToffolis : Nat
  baselineDepth    : Nat
  superoptDepth    : Nat
  baselineVec      : BitboardVec6
  superoptVec      : BitboardVec6
  deriving DecidableEq, Repr

/-- `GADGET-1`: Skew-Binary Carry-Save Merge (`QDS-4`) — $4 \to 3$ Toffolis, $7 \to 4$ depth. -/
def gadget1SkewCarryMerge : SuperoptGadgetSpec :=
