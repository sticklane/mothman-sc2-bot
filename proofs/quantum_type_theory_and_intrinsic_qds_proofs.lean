def allSuperoptGadgets1To6 : List SuperoptGadgetSpec :=
  [ gadget1SkewCarryMerge
  , gadget2DivstepSwapSub
  , gadget3Gf16InversionSBox
  , gadget4Bb288FlaggedSchedule
