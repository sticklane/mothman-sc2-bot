-- ============================================================================

/-- **VOQC + Stim/BB Gate IR (`VoqcGate n` — `Simplification S9` & `Fix F13`)**:
    Represents the intermediate gate set lowered from `IxQMonad` before `VOQC` peephole
    optimization and `Stim` / `[[288, 12, 18]]` Bivariate Bicycle syndrome emission. -/
inductive VoqcGate (n : Nat) : Type where
  | vX          (w : Fin n)                     : VoqcGate n
  | vH          (w : Fin n)                     : VoqcGate n
  | vZ          (w : Fin n)                     : VoqcGate n
  | vCnot       (c t : Fin n) (dp : SymPoly n)  : VoqcGate n
  | vToffoli    (c1 c2 t : Fin n) (dp : SymPoly n) : VoqcGate n
  | vHmrCz      (peb c1 c2 : Fin n)             : VoqcGate n
  | vQecBarrier                                 : VoqcGate n
  deriving DecidableEq, Repr

/-- True if a single `VoqcGate` is a self-inverse involutory gate (`X`, `H`, `Z`, `CNOT`, `CCX`)
    that cancels with an immediately adjacent identical gate when no barrier or non-commuting
    conjugate gate intervenes (`Fix F13`). -/
def isSelfInverseVoqcGate {n : Nat} : VoqcGate n → Bool
  | .vX _            => true
  | .vH _            => true
  | .vZ _            => true
  | .vCnot _ _ _     => true
  | .vToffoli _ _ _ _ => true
  | .vHmrCz _ _ _    => false
  | .vQecBarrier     => false

/-- Commutator-aware adjacent self-inverse gate cancellation (`voqcStepInsert` / `voqcOptimizeCanonical` — `Simplification S9` & `Fix F13`):
    Cancels `g` with the head of the optimized accumulator if and only if they are identical
    and `isSelfInverseVoqcGate g = true`. Because `vZ`, `vHmrCz`, and `vQecBarrier` remain in
    place unless identically paired, a `vCnot c t` separated from another `vCnot c t` by `vZ t`,
    `vHmrCz`, or `vQecBarrier` is NEVER unsoundly cancelled across the intervening operation! -/
def voqcStepInsert {n : Nat} (g : VoqcGate n) (acc : List (VoqcGate n)) : List (VoqcGate n) :=
  match acc with
  | []      => [g]
  | h :: tl =>
      if isSelfInverseVoqcGate g && (g == h) then
        tl
      else
        g :: h :: tl

def voqcOptimizeCanonical {n : Nat} (circ : List (VoqcGate n)) : List (VoqcGate n) :=
  circ.foldr voqcStepInsert []

/-- Symbolic $\mathbb{F}_2[x]$ ANF polynomial delta accumulated by a `VoqcGate` on wire `w`. -/
def voqcGateAnfDelta {n : Nat} (g : VoqcGate n) (w : Fin n) : SymPoly n :=
  match g with
  | .vX t               => singleWireDelta t ⟨true, false, false, false⟩ w
  | .vCnot _ t dp       => singleWireDelta t dp w
  | .vToffoli _ _ t dp  => singleWireDelta t dp w
  | .vH _               => 0
  | .vZ _               => 0
  | .vHmrCz _ _ _       => 0
  | .vQecBarrier        => 0

def voqcListAnfDelta {n : Nat} : List (VoqcGate n) → Fin n → SymPoly n
  | [],      _ => 0
  | g :: gs, w => symPolyAdd (voqcGateAnfDelta g w) (voqcListAnfDelta gs w)

def voqcGateToffolis {n : Nat} : VoqcGate n → Nat
  | .vToffoli _ _ _ _ => 1
  | .vX _             => 0
  | .vH _             => 0
  | .vZ _             => 0
  | .vCnot _ _ _      => 0
  | .vHmrCz _ _ _     => 0
  | .vQecBarrier      => 0

def voqcListToffolis {n : Nat} : List (VoqcGate n) → Nat
  | []      => 0
  | g :: gs => voqcGateToffolis g + voqcListToffolis gs

theorem voqcStepInsert_preserves_anf {n : Nat} (g : VoqcGate n) (acc : List (VoqcGate n)) (w : Fin n) :
    voqcListAnfDelta (voqcStepInsert g acc) w =
      symPolyAdd (voqcGateAnfDelta g w) (voqcListAnfDelta acc w) := by
  cases acc with
  | nil =>
    simp [voqcStepInsert, voqcListAnfDelta]
  | cons h tl =>
    dsimp [voqcStepInsert]
    cases hCond : isSelfInverseVoqcGate g && (g == h)
    · rfl
    · dsimp
      have hEq : g = h := by
        rw [Bool.and_eq_true, beq_iff_eq] at hCond
        exact hCond.2
      subst hEq
      simp only [voqcListAnfDelta, ← symPolyAdd_assoc, symPolyAdd_self, symPolyAdd_zero_left]

theorem voqcOptimizeCanonical_preserves_anf {n : Nat} (circ : List (VoqcGate n)) (w : Fin n) :
    voqcListAnfDelta (voqcOptimizeCanonical circ) w = voqcListAnfDelta circ w := by
  induction circ with
  | nil => rfl
  | cons g gs ih =>
    unfold voqcOptimizeCanonical at ih ⊢
    simp only [List.foldr_cons, voqcListAnfDelta]
    rw [voqcStepInsert_preserves_anf, ih]

theorem voqcStepInsert_nonincreasing_toffolis {n : Nat} (g : VoqcGate n) (acc : List (VoqcGate n)) :
    voqcListToffolis (voqcStepInsert g acc) ≤ voqcGateToffolis g + voqcListToffolis acc := by
  cases acc with
  | nil =>
    simp [voqcStepInsert, voqcListToffolis]
  | cons h tl =>
    dsimp [voqcStepInsert]
    cases hCond : isSelfInverseVoqcGate g && (g == h)
    · dsimp [voqcListToffolis]
      omega
    · dsimp [voqcListToffolis]
      omega

theorem voqcOptimizeCanonical_nonincreasing_toffolis {n : Nat} (circ : List (VoqcGate n)) :
    voqcListToffolis (voqcOptimizeCanonical circ) ≤ voqcListToffolis circ := by
  induction circ with
  | nil => simp [voqcOptimizeCanonical, voqcListToffolis]
  | cons g gs ih =>
    unfold voqcOptimizeCanonical at ih ⊢
    simp only [List.foldr_cons, voqcListToffolis]
    have hStep := voqcStepInsert_nonincreasing_toffolis g (List.foldr voqcStepInsert [] gs)
    omega

/-- **2-Qubit Computational Basis + Phase State (`TwoQubitPhaseState` — `Issue F13`)**:
    Models exact 2-qubit unitary action of `CNOT(0, 1)` and `Z(1)` on `|x0, x1⟩` with phase sign `p`:
    - `CNOT(0, 1) |x0, x1⟩ = |x0, x0 ⊕ x1⟩`
    - `Z(1) |x0, x1⟩ = (-1)^{x1} |x0, x1⟩`
    Under exact execution, `CNOT(0, 1); Z(1); CNOT(0, 1)` produces phase `(-1)^{x0 ⊕ x1}` ($Z_0 Z_1$),
    whereas naive cancellation of `CNOT(0, 1)` across `Z(1)` (`Issue F13` bug) produces phase
    `(-1)^{x1}` ($Z_1$), which disagrees whenever `x0 = true`! -/
structure TwoQubitPhaseState where
  x0    : Bool
  x1    : Bool
  phase : PhaseSign
  deriving DecidableEq, Repr

def evalCnot01Phase (st : TwoQubitPhaseState) : TwoQubitPhaseState :=
  { st with x1 := xor st.x1 st.x0 }

def evalZ1Phase (st : TwoQubitPhaseState) : TwoQubitPhaseState :=
  { st with phase := mulPhase st.phase (boolToPhase st.x1) }

/-- Exact semantics of `CNOT(0, 1); Z(1); CNOT(0, 1)` (`Z_0 Z_1` phase kickback). -/
def evalExactCnotZ1Cnot (st : TwoQubitPhaseState) : TwoQubitPhaseState :=
  evalCnot01Phase (evalZ1Phase (evalCnot01Phase st))

/-- Unsound naive cancellation of `CNOT(0, 1)` across `Z(1)` (`Issue F13` bug: reduces to `Z(1)`). -/
def evalNaiveBuggyF13Cancel (st : TwoQubitPhaseState) : TwoQubitPhaseState :=
  evalZ1Phase st

/-- Concrete circuit `CNOT(0, 1); Z(1); CNOT(0, 1)` in `VoqcGate 2` for testing `Fix F13`. -/
def f13CnotZ1CnotCircuit : List (VoqcGate 2) :=
  [ .vCnot ⟨0, by decide⟩ ⟨1, by decide⟩ ⟨false, true, false, false⟩
  , .vZ    ⟨1, by decide⟩
  , .vCnot ⟨0, by decide⟩ ⟨1, by decide⟩ ⟨false, true, false, false⟩ ]

/-- **Theorem 15A (`voqc_canonical_gate_cancel_soundness_and_f13_barrier_rejection` — `Simplification S9` & `Fix F13`)**:
    1. **Symbolic $\mathbb{F}_2[x]$ ANF Preservation**: For EVERY circuit `circ : List (VoqcGate n)`
       and wire `w : Fin n`, `voqcListAnfDelta (voqcOptimizeCanonical circ) w = voqcListAnfDelta circ w`.
    2. **Monotone Non-Increasing Toffoli Count**: `voqcListToffolis (voqcOptimizeCanonical circ) ≤ voqcListToffolis circ`.
    3. **Adjacent Self-Inverse Cancellation**: Adjacent `X;X`, `H;H`, `CNOT;CNOT`, and `CCX;CCX` pairs
       reduce to `[]` under `voqcOptimizeCanonical`.
    4. **Non-Commuting `Z_1` & Barrier Preservation (`Fix F13`)**: In `CNOT(0,1); Z(1); CNOT(0,1)`,
       `voqcOptimizeCanonical` refuses to cancel the `CNOT`s across `Z(1)` (`length = 3`), and on input
       `|1, 0⟩` (`⟨true, false, .plus⟩`), `evalExactCnotZ1Cnot` yields phase `.minus` ($Z_0 Z_1 |1, 0\rangle = -|1, 0\rangle$)
       whereas naive cancellation `evalNaiveBuggyF13Cancel` yields `.plus` ($\neq \text{.minus}$)! -/
theorem voqc_canonical_gate_cancel_soundness_and_f13_barrier_rejection
    {n : Nat} (circ : List (VoqcGate n)) (w : Fin n) :
    voqcListAnfDelta (voqcOptimizeCanonical circ) w = voqcListAnfDelta circ w ∧
    voqcListToffolis (voqcOptimizeCanonical circ) ≤ voqcListToffolis circ ∧
    voqcOptimizeCanonical ([.vX ⟨0, by decide⟩, .vX ⟨0, by decide⟩] : List (VoqcGate 2)) = [] ∧
    voqcOptimizeCanonical ([.vH ⟨0, by decide⟩, .vH ⟨0, by decide⟩] : List (VoqcGate 2)) = [] ∧
    (voqcOptimizeCanonical f13CnotZ1CnotCircuit).length = 3 ∧
    (evalExactCnotZ1Cnot ⟨true, false, .plus⟩).phase = .minus ∧
    (evalNaiveBuggyF13Cancel ⟨true, false, .plus⟩).phase = .plus ∧
    evalExactCnotZ1Cnot ⟨true, false, .plus⟩ ≠ evalNaiveBuggyF13Cancel ⟨true, false, .plus⟩ := by
  refine ⟨voqcOptimizeCanonical_preserves_anf circ w,
          voqcOptimizeCanonical_nonincreasing_toffolis circ,
          by decide, by decide, by decide, by decide, by decide, by decide⟩

/-- **`Stim` Detector Wire Specification (`StimDetectorWireSpec n` — `Simplification S9` & `Fix F14`)**:
    Tracks the compile-time basis mode, carry-save quotient representation state, and symbolic
    $\mathbb{F}_2[x]$ ANF polynomial delta $\Delta_w(x)$ at a candidate `DETECTOR(w)` site. -/
structure StimDetectorWireSpec (n : Nat) where
  mode  : BasisMode
  rep   : RepState
  delta : SymPoly n
  deriving DecidableEq, Repr

/-- Certifying `Stim` detector admissibility predicate (`isDeterministicStimDetector` — `Fix F14`):
    A wire `w` can be annotated with `DETECTOR(w)` if and only if it is in the computational
    `QFree` basis, has consolidated `canonicalMod` representation, and has zero polynomial residual
    (`delta = 0`, meaning $\text{ANFPoly}(w) = x_w$ so an ancilla initialized to $|0\rangle$ is deterministically $|0\rangle$). -/
def isDeterministicStimDetector {n : Nat} (spec : StimDetectorWireSpec n) : Bool :=
  (spec.mode == .qfree) && (spec.rep == .canonicalMod) &&
  !spec.delta.cConst && !spec.delta.cLin0 && !spec.delta.cLin1 && !spec.delta.cQuad

/-- Noiseless detector firing probability scaled by $2$ (`0` = $0\%$, `1` = $50\%$ random coin flip
    on `hadamardMixed` superposition, `2` = $100\%$ deterministic flip from unconsolidated carry
    or non-zero $\Delta_w(x)$). -/
def stimNoiselessFireProb2x {n : Nat} (spec : StimDetectorWireSpec n)
    (x0 x1 carryBit : Bool) : Nat :=
  match spec.mode with
  | .hadamardMixed => 1
  | .qfree =>
      match spec.rep with
      | .redundantCS => if carryBit then 2 else 0
      | .canonicalMod => if evalSymPoly spec.delta x0 x1 then 2 else 0

/-- **Theorem 15B (`stim_detector_deterministic_soundness_and_f14_superpos_rejection` — `Simplification S9` & `Fix F14`)**:
    Proves the exact bidirectional characterization of deterministic `Stim` detectors:
    1. `isDeterministicStimDetector spec = true` **if and only if** for all input assignments
       `x0, x1, carryBit : Bool`, the noiseless detector firing probability is identically $0$
       (`stimNoiselessFireProb2x spec x0 x1 carryBit = 0`).
    2. **Superposition Detector Rejection (`Issue F14` Counterexample 1)**: A wire in `.hadamardMixed`
       superposition (`H|0⟩ = |+⟩`) has `isDeterministicStimDetector = false` and fires with $50\%$
       noiseless probability (`stimNoiselessFireProb2x = 1 ≠ 0`).
    3. **Unconsolidated Carry-Save Detector Rejection (`Issue F14` Counterexample 2)**: A wire in
       `.redundantCS` with an active carry rail (`carryBit = true`) has `isDeterministicStimDetector = false`
       and fires with $100\%$ noiseless false-alarm probability (`stimNoiselessFireProb2x = 2 ≠ 0`). -/
theorem stim_detector_deterministic_soundness_and_f14_superpos_rejection
    {n : Nat} (spec : StimDetectorWireSpec n) :
    (isDeterministicStimDetector spec = true ↔
      (∀ x0 x1 carryBit : Bool, stimNoiselessFireProb2x spec x0 x1 carryBit = 0)) ∧
    isDeterministicStimDetector (⟨.hadamardMixed, .canonicalMod, 0⟩ : StimDetectorWireSpec 4) = false ∧
    stimNoiselessFireProb2x (⟨.hadamardMixed, .canonicalMod, 0⟩ : StimDetectorWireSpec 4) false false false = 1 ∧
    isDeterministicStimDetector (⟨.qfree, .redundantCS, 0⟩ : StimDetectorWireSpec 4) = false ∧
    stimNoiselessFireProb2x (⟨.qfree, .redundantCS, 0⟩ : StimDetectorWireSpec 4) false false true = 2 := by
  refine ⟨?_, by decide, by decide, by decide, by decide⟩
  rcases spec with ⟨mode, rep, ⟨c0, l0, l1, q⟩⟩; constructor
  · intro hDet x0 x1 carryBit; cases mode
    · cases rep
      · contradiction
      · cases c0 <;> cases l0 <;> cases l1 <;> cases q
        · unfold stimNoiselessFireProb2x evalSymPoly; cases x0 <;> cases x1 <;> rfl
        all_goals contradiction
    · contradiction
  · intro hAllZero; cases mode
    · cases rep
      · have h := hAllZero false false true; contradiction
      · cases c0 <;> cases l0 <;> cases l1 <;> cases q
        · rfl
        · have h := hAllZero true true false; contradiction
        · have h := hAllZero false true false; contradiction
        · have h := hAllZero false true false; contradiction
        · have h := hAllZero true false false; contradiction
        · have h := hAllZero true false false; contradiction
        · have h := hAllZero true false false; contradiction
        · have h := hAllZero true false false; contradiction
        all_goals (have h := hAllZero false false false; contradiction)
    · have h := hAllZero false false false; contradiction

/-- **CSS Syndrome Extraction Round State (`CSSRoundState` — `Fix F16`)**:
    Tracks whether the `[[288, 12, 18]]` Bivariate Bicycle qLDPC code is between syndrome rounds
    (`.cssClosed`, where $H_X$ and $H_Z$ check ancillas are idle/unentangled) or mid-extraction
    (`.cssOpenX` / `.cssOpenZ`, where CNOT check schedules are partially applied). -/
inductive CSSRoundState : Type where
  | cssClosed : CSSRoundState
  | cssOpenX  : CSSRoundState
  | cssOpenZ  : CSSRoundState
  deriving DecidableEq, Repr

/-- Action of a $\mathbb{Z}_{12} \times \mathbb{Z}_{12}$ Bivariate Bicycle torus automorphism shift
    $\sigma_{a,b}$ on a torus coordinate $(x, y) \in \text{Fin } 12 \times \text{Fin } 12$. -/
def bbTorusShiftCoord (a b x y : Fin 12) : Fin 12 × Fin 12 :=
  ( ⟨(x.val + a.val) % 12, Nat.mod_lt _ (by decide)⟩
  , ⟨(y.val + b.val) % 12, Nat.mod_lt _ (by decide)⟩ )

/-- Action of a bivariate polynomial stabilizer check monomial $x^{dx} y^{dy} \in \mathbb{F}_2[\mathbb{Z}_{12} \times \mathbb{Z}_{12}]$
    ($H_X$ or $H_Z$ parity check tap) on $(x, y) \in \text{Fin } 12 \times \text{Fin } 12$. -/
def bbCheckMonomialTap (dx dy x y : Fin 12) : Fin 12 × Fin 12 :=
  bbTorusShiftCoord dx dy x y

/-- Checks whether a torus shift $\sigma_{a,b}$ executed in state `st` causes a CSS syndrome
    parity misalignment (`Issue F16`):
    - When `st = .cssClosed`, $\sigma_{a,b}$ commutes with all $H_X, H_Z$ monomials, producing `false` (0 misalignment).
    - When `st = .cssOpenX` or `.cssOpenZ` and `(a, b) ≠ (0, 0)`, shifting data qubits mid-round
      switches which check ancilla receives the remaining CNOT taps, producing `true` (syndrome corruption!). -/
def bbSyndromeMisaligned (st : CSSRoundState) (a b : Fin 12) : Bool :=
  match st with
  | .cssClosed => false
  | .cssOpenX  => decide (a.val ≠ 0 ∨ b.val ≠ 0)
  | .cssOpenZ  => decide (a.val ≠ 0 ∨ b.val ≠ 0)

theorem mod12_shift_comm (u v w : Nat) :
    ((u + v) % 12 + w) % 12 = ((u + w) % 12 + v) % 12 := by
  omega

/-- **Theorem 15C (`bb_torus_automorphism_css_round_alignment_and_f16` — `Simplification S9` & `Fix F16`)**:
    1. **Exact Stabilizer Commutativity ($H_{X,Z} \sigma_{a,b} = \sigma_{a,b} H_{X,Z}$)**:
       For all torus shifts $(a, b)$ and all bivariate check monomials $(dx, dy)$ on $\mathbb{Z}_{12} \times \mathbb{Z}_{12}$,
       applying $\sigma_{a,b}$ followed by check tap $(dx, dy)$ equals applying check tap $(dx, dy)$
       followed by $\sigma_{a,b}$ on every physical torus coordinate $(x, y) \in \text{Fin } 12 \times \text{Fin } 12$.
    2. **Closed-Round Syndrome Alignment (`Fix F16`)**: When `st = .cssClosed`, `bbSyndromeMisaligned .cssClosed a b = false`
       for all shifts $(a, b)$.
    3. **Mid-Round Torus Shift Rejection (`Issue F16` Counterexample)**: Executing a non-trivial torus
       shift $\sigma_{1, 0}$ inside `.cssOpenX` or `.cssOpenZ` misaligns CSS syndrome parities
       (`bbSyndromeMisaligned .cssOpenX ⟨1, _⟩ ⟨0, _⟩ = true`). -/
theorem bb_torus_automorphism_css_round_alignment_and_f16
    (a b dx dy x y : Fin 12) :
    (let s1 := bbTorusShiftCoord a b x y
     let s2 := bbCheckMonomialTap dx dy x y
     bbCheckMonomialTap dx dy s1.1 s1.2 = bbTorusShiftCoord a b s2.1 s2.2) ∧
    bbSyndromeMisaligned .cssClosed a b = false ∧
    bbSyndromeMisaligned .cssOpenX ⟨1, by decide⟩ ⟨0, by decide⟩ = true ∧
    bbSyndromeMisaligned .cssOpenZ ⟨0, by decide⟩ ⟨1, by decide⟩ = true := by
  refine ⟨?_, rfl, by decide, by decide⟩
  dsimp [bbCheckMonomialTap, bbTorusShiftCoord]
  ext
  · exact mod12_shift_comm x.val a.val dx.val
  · exact mod12_shift_comm y.val b.val dy.val

