  let t0 := varBitboard0 ^^^ varBitboard1
  let t1 := varBitboard2 &&& varBitboard3
  let y0 := varBitboard3 ^^^ (varBitboard0 &&& t0) ^^^ t1
  let y1 := varBitboard2 ^^^ (varBitboard1 &&& varBitboard3)
  let y2 := varBitboard1 ^^^ t1 ^^^ (t0 &&& varBitboard2)
  let y3 := t0 ^^^ (varBitboard0 &&& varBitboard2)
  let vec : BitboardVec6 := ⟨y0, y1, y2, y3, varBitboard4, varBitboard5⟩
