/-- **Admissibility Predicate for Single-Argument `withQFree(compute, action)` (`isValidWithQFreeCompute` — `Fix F17`)**:
    A forward block `compute` can be automatically inverted by `withQFree` if and only if
    its output representation state is `.canonicalMod` (no unconsolidated `.redundantCS` carry rail)
    and its basis mode is unitary `.qfree` (no `HMR_CZ` measurement or Hadamard superposition). -/
def isValidWithQFreeCompute (outRep : RepState) (mode : BasisMode) : Bool :=
  (outRep == .canonicalMod) && (mode == .qfree)

/-- Models the residual carry garbage after running `compute ; action ; compute†` without `consolidateMod`
    when `action` reads only the low sum rail (`Issue F17`):
    If `outRep = .redundantCS` and `carryBit = true`, the high carry rail disagrees with a consolidated
    modular wire (`residualCarryError = true`). -/
def withQFreeCarryMismatch (outRep : RepState) (carryBit : Bool) : Bool :=
  match outRep with
  | .canonicalMod => false
  | .redundantCS  => carryBit

/-- **Theorem 18A (`withQFree_canonical_mod_invertibility_and_f17_rejection` — `Fix F17`)**:
    1. `isValidWithQFreeCompute outRep .qfree = true` **if and only if** `withQFreeCarryMismatch outRep carryBit = false`
       for all `carryBit : Bool`.
    2. **Unconsolidated Carry-Save Rejection (`Issue F17` Counterexample)**: Passing an unconsolidated
       `g-skew-add-cs` block (`outRep = .redundantCS`) into `withQFree` is statically rejected
       (`isValidWithQFreeCompute .redundantCS .qfree = false`) and exhibits a concrete carry-rail
       mismatch (`withQFreeCarryMismatch .redundantCS true = true`). -/
theorem withQFree_canonical_mod_invertibility_and_f17_rejection
    (outRep : RepState) :
    (isValidWithQFreeCompute outRep .qfree = true ↔
      (∀ carryBit : Bool, withQFreeCarryMismatch outRep carryBit = false)) ∧
    isValidWithQFreeCompute .redundantCS .qfree = false ∧
    withQFreeCarryMismatch .redundantCS true = true := by
  refine ⟨?_, rfl, rfl⟩
  cases outRep
  · constructor
    · intro h; contradiction
    · intro hAll
      have h := hAll true
      contradiction
  · constructor
    · intro _ carryBit; rfl
    · intro _; rfl

/-- **3-Qubit Computational Basis + Phase State (`ThreeQubitPhaseState` — `Fix F18`)**:
    Models the 3-wire Fredkin gate `CSWAP(c, a, b)` and phase gate `Z(a)` on `|xc, xa, xb⟩` with phase `p`. -/
structure ThreeQubitPhaseState where
  xc    : Bool
  xa    : Bool
  xb    : Bool
  phase : PhaseSign
  deriving DecidableEq, Repr

def evalCswapCAB (st : ThreeQubitPhaseState) : ThreeQubitPhaseState :=
  if st.xc then
    { st with xa := st.xb, xb := st.xa }
  else
    st

def evalZaPhase3 (st : ThreeQubitPhaseState) : ThreeQubitPhaseState :=
  { st with phase := mulPhase st.phase (boolToPhase st.xa) }

/-- Exact semantics of `CSWAP(c, a, b) ; Z(a) ; CSWAP(c, a, b)` (`Z_a^{1-x_c} Z_b^{x_c}`). -/
def evalExactCswapZaCswap (st : ThreeQubitPhaseState) : ThreeQubitPhaseState :=
  evalCswapCAB (evalZaPhase3 (evalCswapCAB st))

/-- Buggy naive cancellation of `CSWAP(c, a, b)` across `Z(a)` (`Issue F18` bug: reduces to `Z(a)`). -/
def evalNaiveBuggyF18Cancel (st : ThreeQubitPhaseState) : ThreeQubitPhaseState :=
  evalZaPhase3 st

/-- **Kuperberg Collimation Rank-Match Predicate (`isValidKuperbergCollimation` — `Fix F19`)**:
    Two dihedral coset states $|+\_{r_1, s_1}\rangle$ and $|+\_{r_2, s_2}\rangle$ can be collimated
    to eliminate the $(r_1)$-th LSB of $s_1 \pm s_2$ if and only if $r_1 = r_2$. -/
def isValidKuperbergCollimation (r1 r2 : Nat) : Bool :=
  r1 == r2

/-- **Theorem 18B (`voqc_cswap_three_wire_barrier_and_kuperberg_rank_match_f18_f19` — `Fixes F18 & F19`)**:
    1. **3-Wire `CSWAP` Non-Commutation with $Z_a$ (`Fix F18`)**: On input `|xc=1, xa=0, xb=1⟩`
       (`⟨true, false, true, .plus⟩`), `evalExactCswapZaCswap` produces phase `.minus`
       ($Z_b |1, 0, 1\rangle = -|1, 0, 1\rangle$), whereas naive `CSWAP` cancellation
       `evalNaiveBuggyF18Cancel` produces phase `.plus` ($Z_a |1, 0, 1\rangle = +|1, 0, 1\rangle \neq -|1, 0, 1\rangle$)!
    2. **General 3-Wire `CSWAP` Conjugation Identity**: For all `xc, xa, xb : Bool`,
       `evalExactCswapZaCswap ⟨xc, xa, xb, .plus⟩` has phase `boolToPhase (if xc then xb else xa)`.
    3. **Kuperberg Collimation Rank Equality (`Fix F19`)**: `isValidKuperbergCollimation r1 r2 = true ↔ r1 = r2`,
       and mismatched ranks `(r1 = 1, r2 = 2)` evaluate to `false`. -/
theorem voqc_cswap_three_wire_barrier_and_kuperberg_rank_match_f18_f19
    (xc xa xb : Bool) (r1 r2 : Nat) :
    (evalExactCswapZaCswap ⟨true, false, true, .plus⟩).phase = .minus ∧
    (evalNaiveBuggyF18Cancel ⟨true, false, true, .plus⟩).phase = .plus ∧
    evalExactCswapZaCswap ⟨true, false, true, .plus⟩ ≠ evalNaiveBuggyF18Cancel ⟨true, false, true, .plus⟩ ∧
    (evalExactCswapZaCswap ⟨xc, xa, xb, .plus⟩).phase = boolToPhase (if xc then xb else xa) ∧
    (isValidKuperbergCollimation r1 r2 = true ↔ r1 = r2) ∧
    isValidKuperbergCollimation 1 2 = false := by
  refine ⟨by decide, by decide, by decide, ?_, ?_, by decide⟩
  · cases xc <;> cases xa <;> cases xb <;> rfl
  · unfold isValidKuperbergCollimation
    exact beq_iff_eq

/-- **Nested `ParDiag` Purity Inside `withQFree` (`isValidNestedParDiagInWithQFree` — `Fix F20`)**:
    A parallel diagonal composition `ParDiag(C1, C2)` nested inside `withQFree` is invertible
    without orphaned Bell pairs or mid-round syndrome corruption if and only if both branches have
    `ebits = 0`, `liveLinks = 0`, and `cssRound = .cssClosed`. -/
def isValidNestedParDiagInWithQFree
    (ebits1 ebits2 liveLinks1 liveLinks2 : Nat)
    (css1 css2 : CSSRoundState) : Bool :=
  (ebits1 == 0) && (ebits2 == 0) &&
  (liveLinks1 == 0) && (liveLinks2 == 0) &&
  (css1 == .cssClosed) && (css2 == .cssClosed)

def validPhase5Spec (name : String) : FullPhase5CircuitSpec :=
  { phase4                          := validPhase4Spec name
    withQFreeComputeCanonical       := true
    voqcThreeWireCswapBarrierValid  := true
    kuperbergCollimationRankMatched := true
    nestedParDiagInWithQFreePure    := true }

