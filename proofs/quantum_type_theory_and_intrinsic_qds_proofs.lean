/-- Minimum required clean ancilla pebbles $h + 1$ for dead-lock-free reversible evaluation of a height-$h$
    tree (`minRequiredPebblesForHeight` — `Fix F65`, `Simplification S45`, `Pass M22`). -/
def minRequiredPebblesForHeight (subtreeHeight : Nat) : Nat :=
  subtreeHeight + 1

/-- Static Komlos pebbling reservation guard ensuring `availablePebbles ≥ subtreeHeight + 1` and
    complete ghost/spooky pebble uncomputation (`checkF65KomlosPebblingReserveSafe` — `Fix F65`, `S45`, `Pass M22`). -/
