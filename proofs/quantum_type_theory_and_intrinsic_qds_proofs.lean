inductive CoreProblemId where
  | CoreAES192_256 : CoreProblemId
  | CoreSPHINCS    : CoreProblemId
  | CoreECC256     : CoreProblemId
  | CoreRSA2048    : CoreProblemId
  | CoreDQIBCH     : CoreProblemId
