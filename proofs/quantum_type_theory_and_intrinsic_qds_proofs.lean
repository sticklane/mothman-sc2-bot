  let (fOut, gOut) := bitboardCswapMux cond varBitboard2 varBitboard3
  let vec : BitboardVec6 := ⟨varBitboard0, varBitboard1, fOut, gOut ^^^ (cond &&& fOut), varBitboard4, varBitboard5⟩
  { gadgetId         := 2
