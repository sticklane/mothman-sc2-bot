/-- Spatial blockade & QCCD zone capacity checker (`checkF37SpatialPar` — `Fix F37`):
    Verifies that parallel neutral-atom or trapped-ion operations respect both the Rydberg
    blockade exclusion radius (`interAtomDistanceUm >= blockadeRadiusUm`) and QCCD zone/batch
    capacity limits (`activeZones <= maxZones` and `ionsInZone <= maxIonsPerZone`). -/
def checkF37SpatialPar
    (interAtomDistanceUm blockadeRadiusUm activeZones maxZones ionsInZone maxIonsPerZone : Nat) : Bool :=
  decide (interAtomDistanceUm ≥ blockadeRadiusUm) &&
  decide (activeZones ≤ maxZones) &&
  decide (ionsInZone ≤ maxIonsPerZone)

/-- **Theorem 26A (`f37_spatial_blockade_and_zone_capacity_soundness` — Fix `F37`)**:
    Proves that `checkF37SpatialPar` accepts a parallel schedule iff Rydberg blockade distance
    and QCCD zone/ion capacities are simultaneously respected, accepting valid schedules (`12 >= 8`, `4 <= 4`)
    and rejecting blockade crosstalk (`5 < 8`) or zone overflow (`5 > 4`). -/
theorem f37_spatial_blockade_and_zone_capacity_soundness
    (interAtomDistanceUm blockadeRadiusUm activeZones maxZones ionsInZone maxIonsPerZone : Nat) :
    (checkF37SpatialPar interAtomDistanceUm blockadeRadiusUm activeZones maxZones ionsInZone maxIonsPerZone = true ↔
      (interAtomDistanceUm ≥ blockadeRadiusUm ∧
       activeZones ≤ maxZones ∧
       ionsInZone ≤ maxIonsPerZone)) ∧
    checkF37SpatialPar 12 8 4 4 4 4 = true ∧
    checkF37SpatialPar 5 8 4 4 4 4 = false ∧
    checkF37SpatialPar 12 8 5 4 4 4 = false := by
  refine ⟨?_, by decide, by decide, by decide⟩
  unfold checkF37SpatialPar
  simp only [Bool.and_eq_true, decide_eq_true_iff]
  exact ⟨fun h => ⟨h.1.1, h.1.2, h.2⟩, fun h => ⟨⟨h.1, h.2.1⟩, h.2.2⟩⟩

/-- Software Pauli frame polarity (`FramePolarity` — `Fix F38` & `Pass M6`). -/
inductive FramePolarity where
  | frameClean    : FramePolarity
  | frameTwistedX : FramePolarity
  deriving DecidableEq, Repr

/-- Evaluates a non-Clifford `CCX` (`Toffoli`) target wire under software Pauli frame `frameC0` (`evalCcxWithFrame`).
    When `frameC0 = .frameTwistedX` is un-flushed before `CCX`, control `c0` is inverted (`!c0`),
    inducing a non-Clifford `CNOT(c1, t)` corruption error (`Fix F38`). -/
def evalCcxWithFrame (frameC0 : FramePolarity) (c0 c1 t : Bool) : Bool :=
  match frameC0 with
  | .frameClean    => xor t (c0 && c1)
  | .frameTwistedX => xor t ((!c0) && c1)

/-- `Pass M6` frame flush before non-Clifford `CCX`/`RCCX` (`passM6FlushFrame`). -/
def passM6FlushFrame (_frame : FramePolarity) : FramePolarity :=
  .frameClean

/-- `Pass M6` sign conjugation of continuous trapped-ion `RZZ(θ)` angle under twisted Pauli X-frame (`passM6ConjugateRzzAngle`). -/
def passM6ConjugateRzzAngle (frameParity : FramePolarity) (thetaMillirad : Int) : Int :=
  match frameParity with
  | .frameClean    => thetaMillirad
  | .frameTwistedX => -thetaMillirad

/-- **Theorem 26B (`f38_twisted_pauli_frame_nonclifford_corruption_and_m6_fix` — Fix `F38` & `Pass M6`)**:
    Proves that:
    1. An un-flushed `.frameTwistedX` before `CCX` corrupts the output on `(c0 = false, c1 = true, t = false)`,
    2. Flushing via `passM6FlushFrame` restores exact `CCX` semantics for all `(c0, c1, t)`, and
    3. Conjugating `RZZ(θ) -> RZZ(-θ)` under `.frameTwistedX` is an exact involution. -/
theorem f38_twisted_pauli_frame_nonclifford_corruption_and_m6_fix
    (c0 c1 t : Bool) (theta : Int) :
    evalCcxWithFrame .frameTwistedX false true false ≠
      evalCcxWithFrame .frameClean false true false ∧
    evalCcxWithFrame (passM6FlushFrame .frameTwistedX) c0 c1 t =
      evalCcxWithFrame .frameClean c0 c1 t ∧
    passM6ConjugateRzzAngle .frameTwistedX (passM6ConjugateRzzAngle .frameTwistedX theta) = theta := by
  refine ⟨by decide, rfl, ?_⟩
  dsimp [passM6ConjugateRzzAngle]
  omega

/-- Physical subspace modality tracking leakage / pending heralded erasure (`SubspaceModality` — `Fix F39`). -/
inductive SubspaceModality where
  | qubitSubspace01      : SubspaceModality
  | leakedErasurePending : SubspaceModality
  deriving DecidableEq, Repr

/-- Static type guard rejecting 2-qubit entangling gates on wires with undischarged erasure/leakage (`checkF39EntangleClean`). -/
def checkF39EntangleClean (m1 m2 : SubspaceModality) : Bool :=
  (m1 == .qubitSubspace01) && (m2 == .qubitSubspace01)

/-- Heralded erasure readout + dual-rail/Rydberg reload discharging `.leakedErasurePending -> .qubitSubspace01` (`measHeraldedErasureDischarge`). -/
def measHeraldedErasureDischarge (_m : SubspaceModality) : SubspaceModality :=
  .qubitSubspace01

/-- **Theorem 26C (`f39_leakage_subspace_heralded_erasure_discharge` — Fix `F39`)**:
    Proves that `checkF39EntangleClean` statically rejects entangling gates on `.leakedErasurePending`
    wires and accepts them once discharged via `measHeraldedErasureDischarge`. -/
theorem f39_leakage_subspace_heralded_erasure_discharge (m : SubspaceModality) :
    checkF39EntangleClean .leakedErasurePending .qubitSubspace01 = false ∧
    checkF39EntangleClean .qubitSubspace01 .leakedErasurePending = false ∧
    checkF39EntangleClean (measHeraldedErasureDischarge m) .qubitSubspace01 = true ∧
    measHeraldedErasureDischarge m = .qubitSubspace01 := by
  refine ⟨rfl, rfl, rfl, rfl⟩

/-- Dynamical decoupling modality for idle branch wires during mid-circuit readout/shuttling (`DDModality` — `Fix F40`). -/
inductive DDModality where
  | unprotectedIdle : DDModality
  | xy4Decoupled    : DDModality
  deriving DecidableEq, Repr

/-- Type guard requiring `XY4` dynamical decoupling whenever idle duration exceeds `thresholdNs` (`checkF40IdleBranchSafe`). -/
def checkF40IdleBranchSafe (idleNs thresholdNs : Nat) (dd : DDModality) : Bool :=
  decide (idleNs ≤ thresholdNs) || (dd == .xy4Decoupled)

/-- First-order quasi-static dephasing phase accumulation over a 4-interval `XY4` (`X - Y - X - Y`) cycle (`xy4FirstOrderPhaseResidual`). -/
def xy4FirstOrderPhaseResidual (deltaOmega tau : Int) : Int :=
  (deltaOmega * tau) - (deltaOmega * tau) + (deltaOmega * tau) - (deltaOmega * tau)

/-- **Theorem 26D (`f40_asymmetric_idle_xy4_dd_phase_cancellation` — Fix `F40`)**:
    Proves that the symmetric 4-pulse `XY4` cycle cancels first-order quasi-static dephasing
    (`xy4FirstOrderPhaseResidual deltaOmega tau = 0`), while `checkF40IdleBranchSafe` rejects
    unprotected long-idle branches (`600 > 100`) and accepts `XY4`-protected branches. -/
theorem f40_asymmetric_idle_xy4_dd_phase_cancellation
    (deltaOmega tau : Int) (idleNs thresholdNs : Nat) :
    xy4FirstOrderPhaseResidual deltaOmega tau = 0 ∧
    checkF40IdleBranchSafe 600 100 .unprotectedIdle = false ∧
    checkF40IdleBranchSafe idleNs thresholdNs .xy4Decoupled = true := by
  refine ⟨?_, by decide, ?_⟩
  · unfold xy4FirstOrderPhaseResidual
    omega
  · unfold checkF40IdleBranchSafe
    simp

/-- Cumulative additive error bound over `V` sequential circuit steps (`cumulativeCircuitError`). -/
def cumulativeCircuitError : Nat → (Nat → Nat) → Nat
  | 0,     _   => 0
  | V + 1, err => cumulativeCircuitError V err + err V

/-- **Lemma 1A (`telescoping_additive_error_bound`)**:
    Proves by structural induction on circuit volume `V` that if each step error satisfies
    `err i ≤ pL`, then `cumulativeCircuitError V err ≤ V * pL`. -/
theorem telescoping_additive_error_bound
    (V pL : Nat) (err : Nat → Nat) :
    (∀ i, i < V → err i ≤ pL) →
    cumulativeCircuitError V err ≤ V * pL := by
  induction V with
  | zero =>
      intro _
      simp [cumulativeCircuitError]
  | succ k ih =>
      intro hBound
      have hk : cumulativeCircuitError k err ≤ k * pL :=
        ih (fun i hi => hBound i (Nat.lt_succ_of_lt hi))
      have hlast : err k ≤ pL := hBound k (Nat.lt_succ_self k)
      unfold cumulativeCircuitError
      have hmul : (k + 1) * pL = k * pL + pL := by
        rw [Nat.add_mul, Nat.one_mul]
      omega

/-- **Lemma 1B (`bernoulli_scaled_survival_verified`)**:
    Proves the integer-scaled Bernoulli survival lower bound `(S - p)^V + V * p * S^(V - 1) ≥ S^V`
    both symbolically at `V = 1` and across calibrated circuit volumes (`V = 2, 3`). -/
theorem bernoulli_scaled_survival_verified (S p : Nat) :
    p ≤ S →
    (S - p) ^ 1 + 1 * p * S ^ (1 - 1) ≥ S ^ 1 ∧
    (1000 - 3) ^ 2 + 2 * 3 * 1000 ^ 1 ≥ 1000 ^ 2 ∧
    (1000 - 1) ^ 3 + 3 * 1 * 1000 ^ 2 ≥ 1000 ^ 3 := by
  intro hp
  refine ⟨?_, by decide, by decide⟩
  simp only [Nat.pow_one, Nat.sub_self, Nat.pow_zero, Nat.mul_one, Nat.one_mul]
  omega

/-- **Lemma 2A (`mixed_pauli_erasure_min_fault_weight`)**:
    Proves that for any logical operator of weight `L_weight ≥ d` covered by `u` unheralded
    Pauli errors (each spanning at most 2 distance steps) and `e` heralded erasures
    (`L_weight ≤ 2 * u + e`), the combined fault weight satisfies `2 * u + e ≥ d`. -/
theorem mixed_pauli_erasure_min_fault_weight
    (d L_weight u e : Nat) :
    L_weight ≥ d →
    L_weight ≤ 2 * u + e →
    2 * u + e ≥ d := by
  intro hMinDist hCover
  omega

/-- **Lemma 2B (`erasure_doubles_correctable_faults_all_odd_distances`)**:
    Proves that for every odd code distance `d = 2 * k + 1` (`k ≥ 1`), converting unheralded
    Pauli errors to heralded erasures exactly doubles the correctable fault weight
    (`d - 1 = 2 * ((d - 1) / 2)`), including `27 - 1 = 2 * ((27 - 1) / 2)` at `d = 27`. -/
theorem erasure_doubles_correctable_faults_all_odd_distances
    (k : Nat) :
    k ≥ 1 →
    heraldedErasureCorrectableWeight (2 * k + 1) =
      2 * unheraldedCorrectableWeight (2 * k + 1) ∧
    27 - 1 = 2 * ((27 - 1) / 2) := by
  intro _hk
  constructor
  · unfold heraldedErasureCorrectableWeight unheraldedCorrectableWeight
    omega
  · decide

/-- Minimum odd code distance `minOddCodeDistance logVol invLogLambda = 2 * (logVol * invLogLambda) + 1`. -/
def minOddCodeDistance (logVol invLogLambda : Nat) : Nat :=
  2 * (logVol * invLogLambda) + 1

/-- **Theorem 26E (`volume_reduction_steps_down_code_distance_by_2`)**:
    Proves that reducing logarithmic spacetime volume from `logVol1 + 1` to `logVol1`
    steps down the required odd QEC code distance by 2 (`d - 2`):
    `minOddCodeDistance logVol1 1 + 2 = minOddCodeDistance (logVol1 + 1) 1`. -/
theorem volume_reduction_steps_down_code_distance_by_2 (logVol1 : Nat) :
    minOddCodeDistance logVol1 1 + 2 = minOddCodeDistance (logVol1 + 1) 1 := by
  unfold minOddCodeDistance
  omega

/-- **Theorem 26E Concrete Verification (`rsa2048_and_ecc256_code_distance_step_down_verified`)**:
    Verifies the `d -> d - 2` code-distance step-down for both RSA-2048 (`d = 27 -> 25`,
    saving `1458 -> 1250` physical qubits per logical qubit) and ECC-256 (`d = 23 -> 21`,
    saving `1058 -> 882` physical qubits per logical qubit). -/
theorem rsa2048_and_ecc256_code_distance_step_down_verified :
    minOddCodeDistance 12 1 + 2 = minOddCodeDistance 13 1 ∧
    minOddCodeDistance 12 1 = 25 ∧
    minOddCodeDistance 13 1 = 27 ∧
    2 * (25 ^ 2) < 2 * (27 ^ 2) ∧
    minOddCodeDistance 10 1 + 2 = minOddCodeDistance 11 1 ∧
    minOddCodeDistance 10 1 = 21 ∧
    minOddCodeDistance 11 1 = 23 ∧
    2 * (21 ^ 2) < 2 * (23 ^ 2) := by
  decide

/-- Physical qubit footprint synthesizer from type grade `(logicalQubits, codeDistance, factoryFootprint)` (`synthesize_physical_qubits_from_type_grade`). -/
def synthesize_physical_qubits_from_type_grade
    (logicalQubits codeDistance factoryFootprint : Nat) : Nat :=
  logicalQubits * (2 * codeDistance * codeDistance) + factoryFootprint

/-- **Corollary 26F (`type_grade_compression_monotonically_reduces_physical_qubits` — `Table 6F`)**:
    Proves that compressing the type grade `(q1 ≤ q2, d1 ≤ d2, f1 ≤ f2)` monotonically reduces
    total physical qubit count, and verifies the strict reduction chain across Regimes 0–5 (`Table 6F`). -/
theorem type_grade_compression_monotonically_reduces_physical_qubits
    (q1 q2 d1 d2 f1 f2 : Nat) :
    q1 ≤ q2 → d1 ≤ d2 → f1 ≤ f2 →
    synthesize_physical_qubits_from_type_grade q1 d1 f1 ≤
      synthesize_physical_qubits_from_type_grade q2 d2 f2 ∧
    synthesize_physical_qubits_from_type_grade 28 19 0 <
      synthesize_physical_qubits_from_type_grade 28 21 7200 ∧
    synthesize_physical_qubits_from_type_grade 28 21 7200 <
      synthesize_physical_qubits_from_type_grade 36 23 14400 ∧
    synthesize_physical_qubits_from_type_grade 36 23 14400 <
      synthesize_physical_qubits_from_type_grade 44 25 21600 ∧
    synthesize_physical_qubits_from_type_grade 44 25 21600 <
      synthesize_physical_qubits_from_type_grade 52 27 28800 := by
  intro hq hd hf
  refine ⟨?_, by decide, by decide, by decide, by decide⟩
  unfold synthesize_physical_qubits_from_type_grade
  have hd_sq : 2 * d1 * d1 ≤ 2 * d2 * d2 := by
    have h1 : 2 * d1 ≤ 2 * d2 := Nat.mul_le_mul_left 2 hd
    exact Nat.mul_le_mul h1 hd
  have hmul : q1 * (2 * d1 * d1) ≤ q2 * (2 * d2 * d2) :=
    Nat.mul_le_mul hq hd_sq
  exact Nat.add_le_add hmul hf

/-- **Full Phase-10 40-Bug Circuit Specification (`FullPhase10CircuitSpec` — `Fixes F1–F40`)**:
    Extends `FullPhase9CircuitSpec` (`F1..F36`) with the 4 Phase-10 physical & frame safety invariants (`F37..F40`):
    - `spatialBlockadeAndZoneSafe`: Rydberg blockade radius and QCCD zone capacities respected (`Fix F37`)
    - `pauliFrameFlushedBeforeNonClifford`: software Pauli frame flushed/conjugated via `Pass M6` (`Fix F38`)
    - `erasureLeakageDischargedBeforeEntangle`: pending erasure leakage discharged before 2Q gate (`Fix F39`)
    - `asymmetricIdleProtectedByXy4Dd`: long-idle branch wires protected by `XY4` dynamical decoupling (`Fix F40`). -/
structure FullPhase10CircuitSpec where
  phase9                                  : FullPhase9CircuitSpec
  spatialBlockadeAndZoneSafe              : Bool
  pauliFrameFlushedBeforeNonClifford      : Bool
  erasureLeakageDischargedBeforeEntangle  : Bool
  asymmetricIdleProtectedByXy4Dd          : Bool
  deriving DecidableEq, Repr

def checkPhase10SpecHardwareSafetyNBE (spec : FullPhase10CircuitSpec) : SmtResult :=
  if (checkPhase9SpecMultiLayerCompilerNBE spec.phase9 == .unsat) &&
     spec.spatialBlockadeAndZoneSafe &&
     spec.pauliFrameFlushedBeforeNonClifford &&
     spec.erasureLeakageDischargedBeforeEntangle &&
     spec.asymmetricIdleProtectedByXy4Dd then
    .unsat
  else
