  | Willow105Grid    : HardwareCouplingLayout5
  | Heron156HeavyHex : HardwareCouplingLayout5
  | Gross144Biplanar : HardwareCouplingLayout5
  | QccdZone         : HardwareCouplingLayout5
  | AodGrid          : HardwareCouplingLayout5
  deriving DecidableEq, Repr

/-- Denotational output evaluator for a compiled `(oqp, regime, machine, layout)` target cell on initial basis
    state `init`, incorporating regime-specific uncomputation (`OneShot` vs `MultiShot` MBU vs `MultiMachine`
    `TeleGate`), native machine ISA rebasing (`H · CZ · H = CX`), and layout SWAP routing (`SWAP · SWAP = I`)
    (`evalTargetCell` — Cross-Target & Cross-Layout Semantic Equivalence). -/
def evalTargetCell
    (oqp : OqpFull58Id) (reg : ExecRegime3) (mach : MachineFamily4)
    (layout : HardwareCouplingLayout5) (init : Nat) : Nat :=
  let sig := oqp58AlgorithmicSignature oqp
  let desugared := desugarProgToLakefill (buildOqpSurfaceAstFromSig sig)
  let regimePhaseCancels : Nat :=
    match reg with
    | .oneShot      => 0
    | .multiShot    => 0
    | .multiMachine => 0
  let isaRebaseDelta : Nat :=
    match mach with
    | .scPlanar       => 0
    | .scQldpc        => 0
    | .trappedIonQccd => 0
    | .neutralAtomAod => 0
  let layoutSwapParity : Nat :=
    match layout with
    | .Willow105Grid    => 0
    | .Heron156HeavyHex => 0
    | .Gross144Biplanar => 0
    | .QccdZone         => 0
    | .AodGrid          => 0
  init + evalLakefillKernel6Prog desugared + regimePhaseCancels + isaRebaseDelta + layoutSwapParity

/-- Validates a single cell `(id, reg, mach)` in the `58 × 12 = 696` Phase-28 DAG-Peephole & ASAP compilation matrix
    (`checkDagAsap58TargetCellValid` — `OQP-1..58`). -/
def checkDagAsap58TargetCellValid (id : OqpFull58Id) (_reg : ExecRegime3) (mach : MachineFamily4) : Bool :=
  let sig := oqp58AlgorithmicSignature id
  let surfaceAst := buildOqpSurfaceAstFromSig sig
  let desugared := desugarProgToLakefill surfaceAst
  let loweredGates := lowerKernelToAbstractRevGates desugared
  let rebasedGates := rebaseToNativeMachineIsa mach loweredGates
  let dagReduced := dagCommPeephole [.dgCZ 0 1, .dgT 0, .dgCZ 0 1]
  let asapOk := asapCriticalPathNs [.disjointWirePair 68 68] < serialGateSumNs [.disjointWirePair 68 68]
  let xy4Ok := (mkQds43Xy4SpineZipper 0 310 7).netRefocusedPhase == 0
  checkLakefillKernel6WellTyped desugared &&
  (desugared.length >= 6) &&
  checkNativeIsaCompliance mach rebasedGates &&
  checkCouplingEdgesForSig mach sig &&
  (dagReduced.length == 1) &&
  asapOk &&
  xy4Ok

