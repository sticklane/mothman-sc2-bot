def checkCoreQdsCombinatorCompositionSafe
    (requiresInvertibleUnitary hasNestedHybridFeedback requiresAodShuttle targetSupportsAod : Bool) : Bool :=
  (!requiresInvertibleUnitary || !hasNestedHybridFeedback) &&
