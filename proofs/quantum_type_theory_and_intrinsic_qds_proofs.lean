/-- **Quantitative Abbott–Altenkirch–Ghani Polynomial Container (`QContainer` — `Simplification S11`)**:
    Unifies `QDS-1..13` under a single container functor $\llbracket S \triangleleft P \rrbracket(A) = \sum_{s : S} (P(s) \to A)$
    equipped with a position-indexed payload vector of length `P s`. -/
structure QContainer (S : Type) (P : S → Nat) (A : Type) where
  shape   : S
  payload : Fin (P shape) → A

/-- Generic position-wise functor map `qmap` across any `QContainer S P`. -/
def qmap {S : Type} {P : S → Nat} {A B : Type}
    (f : A → B) (c : QContainer S P A) : QContainer S P B :=
  { shape   := c.shape
    payload := fun i => f (c.payload i) }

/-- McBride 1-hole derivative position count $\partial_X (\text{Pos}(s)) = \text{Pos}(s) - 1$ for non-empty shapes. -/
def mcbrideDerivPositions (posCount : Nat) : Nat :=
  posCount - 1

/-- Sethi–Ullman pebble bound $h + 1$ for generic binary tree catamorphism `qfold` of height $h$. -/
def sethiUllmanTreePebbles (h : Nat) : Nat :=
  h + 1

/-- Quantitative Benchmark Entry for each of the 10 Open Quantum Algorithm Problems (`OQP-1..10`). -/
structure OqpBenchmarkSpec where
  oqpId               : Nat
  baselineDepthOrCost : Nat
  okasakiDepthOrCost  : Nat
  reverseToffolis     : Nat
  qecWindowNs         : Nat
  deriving DecidableEq, Repr

def oqp1CoulombSpec   : OqpBenchmarkSpec := ⟨1,  24,   4, 0, 320⟩ -- 3D Skew Carry-Save adder depth 4 vs 24
def oqp2SparseLcuSpec : OqpBenchmarkSpec := ⟨2,  37,  10, 0, 320⟩ -- Gray-code JW zipper 3.7x reduction
def oqp3QsvtDirtySpec : OqpBenchmarkSpec := ⟨3,  40,  20, 0, 320⟩ -- Pauli-twirled dirty-borrow 0 clean ancillas
def oqp4QtdaHomSpec   : OqpBenchmarkSpec := ⟨4, 142,  10, 0, 320⟩ -- Combinadics + Braun popcount depth 6, 14.2x reduction
def oqp5KuperbergSpec : OqpBenchmarkSpec := ⟨5,  32,  16, 0, 320⟩ -- Binomial collimation queue
def oqp6MqGroverSpec  : OqpBenchmarkSpec := ⟨6, 416,  10, 0, 320⟩ -- Gray-code Macaulay + HMR_CZ 41.6x reduction, 0 rev Toffolis
def oqp7IsogenySpec   : OqpBenchmarkSpec := ⟨7,  48,  12, 0, 320⟩ -- History-independent Crit-Bit Johnson walk
def oqp8MetropolisSpec: OqpBenchmarkSpec := ⟨8,  64,  15, 0, 320⟩ -- Locked binomial pebble rewind
