def checkF73CobbleSubnormalizationFusionSafe
    (alphaNum alphaDen gatesBefore alphaFusedNum alphaFusedDen gatesFused : Nat)
    (usesUnclonedPostselection : Bool) : Bool :=
  (alphaDen > 0) && (alphaFusedDen > 0) && (!usesUnclonedPostselection) &&
  (alphaFusedNum * gatesFused * alphaDen <= alphaNum * gatesBefore * alphaFusedDen)

