    (oqp : OqpFull60Id) (basis : MultiBasisProbe) (reg : ExecRegime3)
    (mach : MachineFamily4) (layout : HardwareCouplingLayout5) (init : Nat) : Nat :=
  let sig := oqp60AlgorithmicSignature oqp
  let desugared := desugarProgToLakefill (buildOqpSurfaceAstFromSig sig)
  let basisProbeWeight : Nat :=
    match basis with
    | .BasisZero      => 0
    | .BasisPlusProbe => 4
  let regimeDelta : Nat :=
    match reg with
    | .oneShot      => 0
    | .multiShot    => 0
    | .multiMachine => 0
  let machDelta : Nat :=
    match mach with
    | .scPlanar       => 0
    | .scQldpc        => 0
    | .trappedIonQccd => 0
    | .neutralAtomAod => 0
  let layoutDelta : Nat :=
    match layout with
    | .Willow105Grid    => 0
    | .Heron156HeavyHex => 0
    | .Gross144Biplanar => 0
    | .QccdZone         => 0
    | .AodGrid          => 0
  init + evalLakefillKernel6Prog desugared + basisProbeWeight + regimeDelta + machDelta + layoutDelta

