-- === Module: Compositional Grade Homomorphisms & Canonical Container Quotients ===
-- ============================================================================

/-- **Runtime Primitive Gate (`PrimGate n` — `Simplifications S5, S6, S7`)**:
    Unindexed runtime gate representation obtained after erasing compile-time `UnifiedQGrade`
    indices (`Simplification S7`). -/
inductive PrimGate (n : Nat) : Type where
  | gCnot           (c t : Fin n) (deltaP : SymPoly n)     : PrimGate n
  | gToffoli        (c1 c2 t : Fin n) (deltaP : SymPoly n) : PrimGate n
  | gCatEntangle    (q0 q1 : Fin n) (deltaP : SymPoly n)   : PrimGate n
  | gCatDisentangle (q0 q1 : Fin n) (deltaP : SymPoly n)   : PrimGate n
  deriving DecidableEq, Repr

/-- **Simplification S5 (`IxQMonad n gIn gOut α` — Atkey Indexed Quantum Monad)**:
    Provides `do`-notation (`ixPure`, `ixBind`) over Hoare-threaded `UnifiedQGrade n` indices
    `gIn` and `gOut` while accumulating the erased gate trace `trace : List (PrimGate n)`. -/
structure IxQMonad (n : Nat) (gIn gOut : UnifiedQGrade n) (α : Type) where
  val   : α
  trace : List (PrimGate n)
  deriving DecidableEq, Repr

/-- Indexed monadic unit `ixPure` (`g → g`, empty gate trace `[]`). -/
def ixPure {n : Nat} {g : UnifiedQGrade n} {α : Type} (a : α) : IxQMonad n g g α :=
  { val := a, trace := [] }

/-- Indexed monadic bind `ixBind` (`(g0 → g1) → (g1 → g2) → (g0 → g2)`). -/
def ixBind {n : Nat} {g0 g1 g2 : UnifiedQGrade n} {α β : Type}
    (m : IxQMonad n g0 g1 α) (f : α → IxQMonad n g1 g2 β) : IxQMonad n g0 g2 β :=
  let m2 := f m.val
  { val := m2.val, trace := m.trace ++ m2.trace }

theorem ixBind_ixPure_left {n : Nat} {g0 g1 : UnifiedQGrade n} {α β : Type}
    (a : α) (f : α → IxQMonad n g0 g1 β) :
    ixBind (ixPure a) f = f a := by
  simp [ixBind, ixPure]

theorem ixBind_ixPure_right {n : Nat} {g0 g1 : UnifiedQGrade n} {α : Type}
    (m : IxQMonad n g0 g1 α) :
    ixBind m ixPure = m := by
  cases m with
  | mk v tr =>
    simp [ixBind, ixPure]

theorem ixBind_assoc {n : Nat} {g0 g1 g2 g3 : UnifiedQGrade n} {α β γ : Type}
    (m : IxQMonad n g0 g1 α) (f : α → IxQMonad n g1 g2 β) (k : β → IxQMonad n g2 g3 γ) :
    ixBind (ixBind m f) k = ixBind m (fun x => ixBind (f x) k) := by
  cases m with
  | mk v tr =>
    simp [ixBind, List.append_assoc]

/-- **Theorem 14A (`ixQMonad_left_right_id_and_assoc_laws` — `Simplification S5`)**:
    Proves that the Atkey Indexed Quantum Monad `IxQMonad n gIn gOut α` satisfies all three
    indexed monad laws (`ixBind_ixPure_left`, `ixBind_ixPure_right`, and `ixBind_assoc`) across
    arbitrary grade transitions `g0 → g1 → g2 → g3`. -/
theorem ixQMonad_left_right_id_and_assoc_laws
    {n : Nat} {g0 g1 g2 g3 : UnifiedQGrade n} {α β γ : Type}
    (a : α) (m : IxQMonad n g0 g1 α)
    (f : α → IxQMonad n g1 g2 β) (k : β → IxQMonad n g2 g3 γ) :
    ixBind (ixPure a) f = f a ∧
    ixBind m ixPure = m ∧
    ixBind (ixBind m f) k = ixBind m (fun x => ixBind (f x) k) := by
  exact ⟨ixBind_ixPure_left a f, ixBind_ixPure_right m, ixBind_assoc m f k⟩

/-- **Simplification S7 (`erasePCirc` — Zero-Cost Grade Erasure)**:
    Erases all compile-time `UnifiedQGrade n` indices from `PCirc n gIn gOut` into a flat
    runtime gate list `List (PrimGate n)`. -/
def erasePCirc {n : Nat} {gIn gOut : UnifiedQGrade n} : PCirc n gIn gOut → List (PrimGate n)
  | .pId                       => []
  | .pCnot c t dp              => [.gCnot c t dp]
  | .pToffoli c1 c2 t dp       => [.gToffoli c1 c2 t dp]
  | .pCatEntangle q0 q1 dp     => [.gCatEntangle q0 q1 dp]
  | .pCatDisentangle q0 q1 dp  => [.gCatDisentangle q0 q1 dp]
  | .pSeq c1 c2                => erasePCirc c1 ++ erasePCirc c2

def toffoliCountGate {n : Nat} : PrimGate n → Nat
  | .gToffoli _ _ _ _       => 1
  | .gCnot _ _ _            => 0
  | .gCatEntangle _ _ _     => 0
  | .gCatDisentangle _ _ _  => 0

def toffoliCountList {n : Nat} : List (PrimGate n) → Nat
  | []      => 0
  | g :: gs => toffoliCountGate g + toffoliCountList gs

theorem toffoliCountList_append {n : Nat} (xs ys : List (PrimGate n)) :
    toffoliCountList (xs ++ ys) = toffoliCountList xs + toffoliCountList ys := by
  induction xs with
  | nil => simp [toffoliCountList]
  | cons x xs ih =>
    simp only [List.cons_append, toffoliCountList, ih]
    omega

theorem erasePCirc_toffoli_conservation {n : Nat} {gIn gOut : UnifiedQGrade n}
    (c : PCirc n gIn gOut) :
    gIn.toffolis + toffoliCountList (erasePCirc c) = gOut.toffolis := by
  induction c with
  | pId =>
    simp [erasePCirc, toffoliCountList]
  | pCnot c t dp =>
    simp [erasePCirc, toffoliCountList, toffoliCountGate, seqGrade, cnotGrade]
  | pToffoli c1 c2 t dp =>
    simp [erasePCirc, toffoliCountList, toffoliCountGate, seqGrade, toffoliGrade]
  | pCatEntangle q0 q1 dp =>
    simp [erasePCirc, toffoliCountList, toffoliCountGate, seqGrade, catEntangleGrade]
  | pCatDisentangle q0 q1 dp =>
    simp [erasePCirc, toffoliCountList, toffoliCountGate, seqGrade, catDisentangleHmrCzGrade]
  | pSeq c1 c2 ih1 ih2 =>
    simp only [erasePCirc, toffoliCountList_append]
    omega

/-- **Simplification S6 (`invertPrimGate` & `synthQFreeAdjoint` — Automatic `withQFree` Adjoint Synthesis)**:
    Automatically synthesizes $U^\dagger$ by reversing the `QFree` gate list and inverting each
    primitive gate, eliminating manual `U_dag` blocks and guaranteeing $\Delta_w(U ; U^\dagger) = 0$. -/
def invertPrimGate {n : Nat} : PrimGate n → PrimGate n
  | .gCnot c t dp             => .gCnot c t dp
  | .gToffoli c1 c2 t dp      => .gToffoli c1 c2 t dp
  | .gCatEntangle q0 q1 dp    => .gCatDisentangle q0 q1 dp
  | .gCatDisentangle q0 q1 dp => .gCatEntangle q0 q1 dp

def synthQFreeAdjoint {n : Nat} (u : List (PrimGate n)) : List (PrimGate n) :=
  (u.map invertPrimGate).reverse

def gateWireDelta {n : Nat} (g : PrimGate n) (w : Fin n) : SymPoly n :=
  match g with
  | .gCnot _ t dp            => singleWireDelta t dp w
  | .gToffoli _ _ t dp       => singleWireDelta t dp w
  | .gCatEntangle _ q1 dp    => singleWireDelta q1 dp w
  | .gCatDisentangle _ q1 dp => singleWireDelta q1 dp w

def listWireDelta {n : Nat} : List (PrimGate n) → Fin n → SymPoly n
  | [],      _ => 0
  | g :: gs, w => symPolyAdd (gateWireDelta g w) (listWireDelta gs w)

theorem gateWireDelta_invert {n : Nat} (g : PrimGate n) (w : Fin n) :
    gateWireDelta (invertPrimGate g) w = gateWireDelta g w := by
  cases g <;> rfl

theorem listWireDelta_append {n : Nat} (xs ys : List (PrimGate n)) (w : Fin n) :
    listWireDelta (xs ++ ys) w = symPolyAdd (listWireDelta xs w) (listWireDelta ys w) := by
  induction xs with
  | nil =>
    simp [listWireDelta, symPolyAdd_zero_left]
  | cons x xs ih =>
    simp only [List.cons_append, listWireDelta, ih, symPolyAdd_assoc]

theorem synthQFreeAdjoint_cancels_delta {n : Nat} (u : List (PrimGate n)) (w : Fin n) :
    symPolyAdd (listWireDelta u w) (listWireDelta (synthQFreeAdjoint u) w) = 0 := by
  induction u with
  | nil =>
    simp [synthQFreeAdjoint, listWireDelta, symPolyAdd_zero_left]
  | cons g gs ih =>
    unfold synthQFreeAdjoint at ih ⊢
    simp only [List.map_cons, List.reverse_cons, listWireDelta, listWireDelta_append,
               gateWireDelta_invert, symPolyAdd_zero_right]
    rw [symPolyAdd_assoc (gateWireDelta g w), ← symPolyAdd_assoc (listWireDelta gs w),
        ih, symPolyAdd_zero_left, symPolyAdd_self]

/-- **Theorem 14B (`withQFree_auto_adjoint_and_grade_erasure_bisimulation` — `Simplifications S6 & S7`)**:
    1. **Zero-Cost Grade Erasure Homomorphism & Resource Conservation (`Simplification S7`)**:
       `erasePCirc (.pSeq c1 c2) = erasePCirc c1 ++ erasePCirc c2`, and for any `c : PCirc n gIn gOut`,
       `toffoliCountList (erasePCirc c) = gOut.toffolis - gIn.toffolis` (and `gIn.toffolis + toffoliCountList (erasePCirc c) = gOut.toffolis`).
    2. **Automatic `withQFree` Adjoint Synthesis (`Simplification S6`)**:
       For any `QFree` gate list `u : List (PrimGate n)` and any wire `w : Fin n`,
       `listWireDelta (u ++ synthQFreeAdjoint u) w = 0`, guaranteeing 100% automatic restoration
       of all polynomial deltas without manual `U_dag` code! -/
theorem withQFree_auto_adjoint_and_grade_erasure_bisimulation
    {n : Nat} {g0 g1 g2 : UnifiedQGrade n}
    (c1 : PCirc n g0 g1) (c2 : PCirc n g1 g2) (u : List (PrimGate n)) (w : Fin n) :
    erasePCirc (.pSeq c1 c2) = erasePCirc c1 ++ erasePCirc c2 ∧
    g0.toffolis + toffoliCountList (erasePCirc c1) = g1.toffolis ∧
    toffoliCountList (erasePCirc c1) = g1.toffolis - g0.toffolis ∧
    listWireDelta (u ++ synthQFreeAdjoint u) w = 0 := by
  have hConserv := erasePCirc_toffoli_conservation c1
  refine ⟨rfl, hConserv, by omega, ?_⟩
  rw [listWireDelta_append]
  exact synthQFreeAdjoint_cancels_delta u w

/-- **Simplification S8 (`CanonicalCircuitCheckSpec` & `verifyCanonicalQDSCircuit` — Single 12-Bug Verifier)**:
    Consolidates all 12 static/dynamic checks (`F1..F12`) into a single decidable verifier function
    over a 6-field summary record:
    1. `hmrMaxDegree ≤ 2` (`F1`: rejects cubic/higher degree in 0-Toffoli `HMR+CZ`)
    2. `dirtyAnfRestored = true` (`F2 & F3`: rejects odd toggle parity and uncomputed `x_0 ∧ x_1` garbage)
    3. `toffoliZonesHot = true` (`F4`: rejects Toffoli on cold/BBTorus zones)
    4. `withQFreeBasisAndDaggerValid = true` (`F5 & F6 & F11`: rejects non-`QFree` `H` in uncompute and mismatched/post-swap comparator `U_dag`)
    5. `disjointParallelWires = true` (`F7`: rejects overlapping parallel wire slices)
    6. `lifoCatLinksClosed = true` (`F8 & F12`: rejects orphaned or non-LIFO crossed cat-links)
    7. `quotientConsolidatedBeforeOracle = true` (`F9`: rejects phase oracle on unconsolidated redundant carry-save pairs)
    8. `pebbleCheckpointsLocked = true` (`F10`: rejects unlocked premature pebble checkpoint eviction)
    9. `qecPeakWindowNs ≤ 1000` (`F12`: rejects un-barriered multi-round QEC latency > 1000 ns) -/
structure CanonicalCircuitCheckSpec where
  name                             : String
  hmrMaxDegree                     : Nat
  dirtyAnfRestored                 : Bool
  toffoliZonesHot                  : Bool
  withQFreeBasisAndDaggerValid     : Bool
  disjointParallelWires            : Bool
  lifoCatLinksClosed               : Bool
  quotientConsolidatedBeforeOracle : Bool
  pebbleCheckpointsLocked          : Bool
  qecPeakWindowNs                  : Nat
  deriving DecidableEq, Repr

def verifyCanonicalQDSCircuit (spec : CanonicalCircuitCheckSpec) : Bool :=
  decide (spec.hmrMaxDegree ≤ 2) &&
  spec.dirtyAnfRestored &&
  spec.toffoliZonesHot &&
  spec.withQFreeBasisAndDaggerValid &&
  spec.disjointParallelWires &&
  spec.lifoCatLinksClosed &&
  spec.quotientConsolidatedBeforeOracle &&
  spec.pebbleCheckpointsLocked &&
  decide (spec.qecPeakWindowNs ≤ 1000)

/-- Baseline valid specification template. -/
def validSpecTemplate (name : String) : CanonicalCircuitCheckSpec :=
  { name                             := name
    hmrMaxDegree                     := 2
    dirtyAnfRestored                 := true
    toffoliZonesHot                  := true
    withQFreeBasisAndDaggerValid     := true
    disjointParallelWires            := true
    lifoCatLinksClosed               := true
    quotientConsolidatedBeforeOracle := true
    pebbleCheckpointsLocked          := true
    qecPeakWindowNs                  := 440 }

