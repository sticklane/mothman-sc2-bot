-- ============================================================================
-- === Module: Intrinsic Canonical Skew-Binary Numerals ===
-- ============================================================================

/-- Weight of rank `k` in Okasaki's Skew-Binary number system: $w_k = 2^{k+1} - 1$. -/
def skewWeight (k : Nat) : Nat :=
  2 ^ (k + 1) - 1

theorem two_pow_succ_ge_one (k : Nat) : 1 ≤ 2 ^ (k + 1) := by
  induction k with
  | zero => decide
  | succ k ih =>
    rw [Nat.pow_succ]
    omega

theorem skewWeight_merge_identity (k : Nat) :
    1 + (skewWeight k + skewWeight k) = skewWeight (k + 1) := by
  unfold skewWeight
  have hpow : 1 ≤ 2 ^ (k + 1) := two_pow_succ_ge_one k
  have hnext : 2 ^ (k + 1 + 1) = 2 ^ (k + 1) * 2 := by
    rw [Nat.pow_succ]
  omega

/-- **Intrinsic Strictly Increasing Skew-Binary Spine (`StrictSkewSpine`)**:
    Instead of an arbitrary `List Nat` that requires an extrinsic `strictlyIncreasingFrom`
    boolean check, `StrictSkewSpine` stores relative non-negative rank offsets `offset : Nat`
    from the current minimum allowed rank `minRank : Nat`:
    - `.nil`: empty spine
    - `.cons offset tail`: represents rank `r = minRank + offset` (so `minRank ≤ r` holds
      automatically!), followed by `tail` evaluated at minimum rank `r + 1` (so the next rank
      is strictly `≥ r + 1 > r` by construction!). -/
inductive StrictSkewSpine : Type where
  | nil  : StrictSkewSpine
  | cons (offset : Nat) (tail : StrictSkewSpine) : StrictSkewSpine
  deriving DecidableEq, Repr

/-- Denotational value of a `StrictSkewSpine` starting at minimum rank `minRank`. -/
def evalStrictSpine (minRank : Nat) : StrictSkewSpine → Nat
  | .nil => 0
  | .cons offset tail =>
      let r := minRank + offset
      skewWeight r + evalStrictSpine (r + 1) tail

/-- **Intrinsic Canonical Skew-Binary Number (`CanonicalSkewNum`)**:
    Encodes Okasaki's Canonical Skew Invariant (*at most the lowest non-zero digit may be `2`,
    and all higher non-zero digits are `1`*) directly in the algebraic data type:
    - `.allSingle spine`: all non-zero digits are `1` at strictly increasing ranks starting
      from `minRank = 0`.
    - `.doubleLowest k spine`: the lowest non-zero digit is `2` at rank `k` (`2 * w_k`),
      and all remaining non-zero digits are `1` at strictly increasing ranks starting from
      `minRank = k + 1`!
    Non-canonical lists such as `[2, 0]`, `[1, 1, 1]`, or `[0, 1, 1]` are **unrepresentable**! -/
inductive CanonicalSkewNum : Type where
  | allSingle    (spine : StrictSkewSpine) : CanonicalSkewNum
  | doubleLowest (k : Nat) (spine : StrictSkewSpine) : CanonicalSkewNum
  deriving DecidableEq, Repr

/-- Denotational integer value of an intrinsic `CanonicalSkewNum`. -/
def evalCanonicalSkew : CanonicalSkewNum → Nat
  | .allSingle spine =>
      evalStrictSpine 0 spine
  | .doubleLowest k spine =>
      (skewWeight k + skewWeight k) + evalStrictSpine (k + 1) spine

/-- **Worst-Case $O(1)$ Intrinsic Skew-Binary Increment (`canonicalSkewInc`)**:
    Inspects *only* the top constructor and at most the head of `spine`:
    1. On `.doubleLowest k (.cons 0 tail)`: merges `1 + 2 * w_k = w_{k+1}` with existing
       rank `(k + 1) + 0 = k + 1` to form `.doubleLowest (k + 1) tail`!
    2. On `.doubleLowest k (.cons (off + 1) tail)`: merges `1 + 2 * w_k = w_{k+1}` into a
       single digit at rank `k + 1`, followed by `.cons off tail` (since `(k + 1) + (off + 1)
       = (k + 2) + off`)!
    3. On `.doubleLowest k .nil`: merges `1 + 2 * w_k = w_{k+1}` into `.allSingle (.cons (k + 1) .nil)`.
    4. On `.allSingle (.cons 0 tail)`: rank `0` becomes `.doubleLowest 0 tail`.
    5. On `.allSingle (.cons (off + 1) tail)`: prepends rank `0` before `.cons off tail`. -/
def canonicalSkewInc : CanonicalSkewNum → CanonicalSkewNum
  | .doubleLowest k (.cons 0 tail) =>
      .doubleLowest (k + 1) tail
  | .doubleLowest k (.cons (off + 1) tail) =>
      .allSingle (.cons (k + 1) (.cons off tail))
  | .doubleLowest k .nil =>
      .allSingle (.cons (k + 1) .nil)
  | .allSingle .nil =>
      .allSingle (.cons 0 .nil)
  | .allSingle (.cons 0 tail) =>
      .doubleLowest 0 tail
  | .allSingle (.cons (off + 1) tail) =>
      .allSingle (.cons 0 (.cons off tail))

/-- **Worst-Case $O(1)$ Intrinsic Skew-Binary Decrement (`canonicalSkewDec`)**:
    Exact syntactic inverse of `canonicalSkewInc`! -/
def canonicalSkewDec : CanonicalSkewNum → CanonicalSkewNum
  | .doubleLowest 0 tail =>
      .allSingle (.cons 0 tail)
  | .doubleLowest (k + 1) tail =>
      .doubleLowest k (.cons 0 tail)
  | .allSingle .nil =>
      .allSingle .nil
  | .allSingle (.cons 0 .nil) =>
      .allSingle .nil
  | .allSingle (.cons 0 (.cons off tail)) =>
      .allSingle (.cons (off + 1) tail)
  | .allSingle (.cons (k + 1) .nil) =>
      .doubleLowest k .nil
  | .allSingle (.cons (k + 1) (.cons off tail)) =>
      .doubleLowest k (.cons (off + 1) tail)

/-- **Theorem 1A (`evalCanonicalSkew_canonicalSkewInc_exact`)**:
    For *every* `s : CanonicalSkewNum` (universally quantified with **ZERO extrinsic
    canonicality hypothesis**!), `canonicalSkewInc` increments the integer value by `1` in
    worst-case $O(1)$ time! -/
theorem evalCanonicalSkew_canonicalSkewInc_exact (s : CanonicalSkewNum) :
    evalCanonicalSkew (canonicalSkewInc s) = evalCanonicalSkew s + 1 := by
  cases s with
  | allSingle spine =>
    cases spine with
    | nil => rfl
    | cons off tail =>
      cases off with
      | zero => dsimp [canonicalSkewInc, evalCanonicalSkew, evalStrictSpine, skewWeight]; omega
      | succ off' =>
        dsimp [canonicalSkewInc, evalCanonicalSkew, evalStrictSpine, skewWeight]
        have h_idx : 1 + off' + 1 = 0 + (off' + 1) + 1 := by omega
        rw [h_idx]; omega
  | doubleLowest k spine =>
    cases spine with
    | nil =>
      dsimp [canonicalSkewInc, evalCanonicalSkew, evalStrictSpine]
      have hmerge := skewWeight_merge_identity k; have h_idx : 0 + (k + 1) = k + 1 := by omega
      rw [h_idx]; omega
    | cons off tail =>
      cases off with
      | zero =>
        dsimp [canonicalSkewInc, evalCanonicalSkew, evalStrictSpine]
        have hmerge := skewWeight_merge_identity k; have h_idx : k + 1 + 0 = k + 1 := by omega
        rw [h_idx]; omega
      | succ off' =>
        dsimp [canonicalSkewInc, evalCanonicalSkew, evalStrictSpine]
        have hmerge := skewWeight_merge_identity k
        have h_idx1 : 0 + (k + 1) = k + 1 := by omega
        have h_idx2 : k + 1 + 1 + off' = k + 1 + (off' + 1) := by omega
        rw [h_idx1, h_idx2]; omega

/-- **Theorem 1B (`canonicalSkewDec_canonicalSkewInc_unconditional_inverse`)**:
    Because `CanonicalSkewNum` makes non-canonical states unrepresentable at the type level,
    `canonicalSkewDec (canonicalSkewInc s) = s` holds **unconditionally for ALL `s : CanonicalSkewNum`**
    without any `(_hcan : skewCanonical terms = true)` hypothesis! -/
theorem canonicalSkewDec_canonicalSkewInc_unconditional_inverse (s : CanonicalSkewNum) :
    canonicalSkewDec (canonicalSkewInc s) = s := by
  cases s with
  | allSingle spine =>
    cases spine with
    | nil => rfl
    | cons off tail =>
      cases off with
      | zero => rfl
      | succ off' => rfl
  | doubleLowest k spine =>
    cases spine with
    | nil => rfl
    | cons off tail =>
      cases off with
      | zero => rfl
      | succ off' => rfl

-- ============================================================================
-- === Module: Borrow-Phase-Indexed Symbiotic Quantum Zipper ===
-- ============================================================================

/-- Compile-time phase of the dirty-borrowed parent-context spine (`X_acc` idle wires). -/
inductive BorrowPhase where
  | clean             : BorrowPhase
  | dirtyToggledPass1 : BorrowPhase
  deriving DecidableEq, Repr

/-- Length-indexed vector `Vec α n`. -/
inductive Vec (α : Type) : Nat → Type where
  | nil  : Vec α 0
  | cons {n : Nat} (head : α) (tail : Vec α n) : Vec α (n + 1)
  deriving DecidableEq, Repr

/-- **Intrinsic Symbiotic Huet Zipper (`SymbioticZipper`)**:
    Indexed at the type level by:
    - `leftLen  : Nat`         (number of slices in reversed left parent-context trail)
    - `rightLen : Nat`         (number of slices in unvisited right trail)
    - `focusWidth : Nat`       (active focus slice qubit width, e.g. `24` for `Z_skew_octal`)
    - `phase    : BorrowPhase` (`.clean` vs `.dirtyToggledPass1`) -/
structure SymbioticZipper (α : Type) (leftLen rightLen focusWidth : Nat) (phase : BorrowPhase) where
  leftTrail  : Vec α leftLen
  focus      : α
  rightTrail : Vec α rightLen
  deriving DecidableEq, Repr

/-- **O(1) Focus Shift Right**:
    Only typechecks when `rightLen = r + 1` (non-empty right trail) AND `phase = .clean`!
    Attempting to shift focus while `phase = .dirtyToggledPass1` is a compile-time type error! -/
def symZipperMoveRight {α : Type} {l r w : Nat}
    (z : SymbioticZipper α l (r + 1) w .clean) : SymbioticZipper α (l + 1) r w .clean :=
  match z.rightTrail with
  | .cons rHead rTail => ⟨.cons z.focus z.leftTrail, rHead, rTail⟩

/-- **O(1) Focus Shift Left**:
    Only typechecks when `leftLen = l + 1` (non-empty left trail) AND `phase = .clean`! -/
def symZipperMoveLeft {α : Type} {l r w : Nat}
    (z : SymbioticZipper α (l + 1) r w .clean) : SymbioticZipper α l (r + 1) w .clean :=
  match z.leftTrail with
  | .cons lHead lTail => ⟨lTail, lHead, .cons z.focus z.rightTrail⟩

/-- **Pass 1 Dirty-Spine Toggle**:
    Transitions the type index from `.clean` to `.dirtyToggledPass1`. -/
def symZipperTogglePass1 {l r w : Nat}
    (z : SymbioticZipper Bool (l + 1) r w .clean) :
    SymbioticZipper Bool (l + 1) r w .dirtyToggledPass1 :=
  match z.leftTrail with
  | .cons d ls => ⟨.cons (xor d z.focus) ls, z.focus, z.rightTrail⟩

/-- **Pass 2 Dirty-Spine Toggle**:
    Restores the dirty-borrowed spine and transitions `.dirtyToggledPass1` back to `.clean`. -/
def symZipperTogglePass2 {l r w : Nat}
    (z : SymbioticZipper Bool (l + 1) r w .dirtyToggledPass1) :
    SymbioticZipper Bool (l + 1) r w .clean :=
  match z.leftTrail with
  | .cons d ls => ⟨.cons (xor d z.focus) ls, z.focus, z.rightTrail⟩

/-- **Theorem 2A (`symZipperMoveLeft_symZipperMoveRight_unconditional_bijection`)**:
    For every `z : SymbioticZipper α l (r + 1) w .clean`, moving right then left is an
    exact syntactic identity without any boundary side-conditions! -/
theorem symZipperMoveLeft_symZipperMoveRight_unconditional_bijection
    {α : Type} {l r w : Nat} (z : SymbioticZipper α l (r + 1) w .clean) :
    symZipperMoveLeft (symZipperMoveRight z) = z := by
  cases z with
  | mk left f right =>
    cases right with
    | cons rHead rTail =>
      rfl

/-- **Theorem 2B (`symZipperTogglePass2_symZipperTogglePass1_exact_restoration`)**:
    For every `z : SymbioticZipper Bool (l + 1) r w .clean`, executing Pass 1 followed by
    Pass 2 restores the exact initial state and phase `.clean`! -/
theorem symZipperTogglePass2_symZipperTogglePass1_exact_restoration
    {l r w : Nat} (z : SymbioticZipper Bool (l + 1) r w .clean) :
    symZipperTogglePass2 (symZipperTogglePass1 z) = z := by
  cases z with
  | mk left f right =>
    cases left with
    | cons d ls =>
      dsimp [symZipperTogglePass1, symZipperTogglePass2]
      congr 1
      cases d <;> cases f <;> rfl

