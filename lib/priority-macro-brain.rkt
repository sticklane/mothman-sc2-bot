  (define protoss-early-flood-idle-bank-break?
    (and (eq? race 'Protoss)
         (< frame 4704)
         early-ling-rush-defense-active?
         (>= minerals 200)
         (or (and (hash? open-facility-slots)
                  (<= (+ (hash-ref open-facility-slots 'gateway 0)
                         (hash-ref open-facility-slots 'warp-gate 0))
