             (and zerg-skytoss-cap-direct?
                  (not (and (= (bldg-count-equivalent total-bldg-counts 'hydralisk-den) 0)
                            (>= minerals 100) (< minerals 180)
                            (>= gas 100) (< gas 180)))))))
  ;; L39-P0-2d (`#31/#58 ZvP` 14-29 Tempests `1,530M/21G`, `SpireDrop 3 -> 0`):
