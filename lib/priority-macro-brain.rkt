  ;; alongside Viking/Liberator/Starport addons while TvT SiegeTank < 4 so gas never drains below 125G Tank floor!
  (define (terran-tvt-tank4-defer-air-sym? nsym)
    (and terran-tvt-tank4-gas-lock?
