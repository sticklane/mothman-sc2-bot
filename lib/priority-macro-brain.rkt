  (define zerg-enemy-fast-harass-pressure?
    (and (eq? race 'Zerg)
         (>= (+ (unit-count-equivalent enemy-u-counts 'reaper)
                (unit-count-equivalent enemy-u-counts 'hellion))
             2)))
  (define zerg-enemy-early-ranged-harass?
    (and (eq? race 'Zerg)
         (or zerg-enemy-fast-harass-pressure?
             (>= (for/sum ([u (in-list '(adept stalker marine roach))])
                   (unit-count-equivalent enemy-u-counts u))
                 3))))
  (define zerg-2base-rw-allowed-with-bn?
    (and (eq? race 'Zerg)
         (or (and (>= frame 4032) (>= workers 26))
             (and zerg-enemy-early-ranged-harass? (>= frame 3360) (>= workers 20)))
         ;; L58 (#37 norman): Never force RoachWarren on top of an existing BanelingNest
         ;; once HydraliskDen/Spire is started/ready (Ling-Bane-Hydra/Muta committed!)
         ;; OR while actively under a major attack on < 3 bases / < 24 army!
         (= (bldg-count-equivalent total-bldg-counts 'hydralisk-den) 0)
         (= (bldg-count-equivalent total-bldg-counts 'spire) 0)
         (not (and under-attack? (> enemy-threat-supply 0)
                   (or (< active-bases 3) (< army-supply 24))
                   (or (not zerg-enemy-early-ranged-harass?)
                       (>= enemy-threat-supply 12)
                       (>= frame 5376))))
         (not zerg-zvz-rush-suppress-t15-tech?)))
  ;; L51-1D (`#61 ZvT` 4m `ESCROW_LOCKOUT(roach-warren, 465M)`) + L58 (`#37 norman` ZvP):
  ;; Once ZvT/ZvP already has BOTH BanelingNest and HydraliskDen (started or ready — Ling-Bane-Hydra active!),
  ;; drop mandatory RoachWarren priority & escrow lock so it never starves Banelings/Hydras!
  (define zerg-zvt-skip-rw-when-bn-hydra-ready?
    (and (eq? race 'Zerg)
         (memq enemy-race '(Terran Protoss))
         (> (bldg-count-equivalent total-bldg-counts 'baneling-nest) 0)
         (> (bldg-count-equivalent total-bldg-counts 'hydralisk-den) 0)
         (= (bldg-count-equivalent total-bldg-counts 'roach-warren) 0)))
  (define zerg-roach-warren-1-priority-due?
    (and (eq? race 'Zerg)
         (not zerg-zvt-skip-rw-when-bn-hydra-ready?)
         (not zerg-zvz-rush-suppress-t15-tech?)
         (not zerg-banshee-suppress-ground-t15-tech?)
         (> (bldg-count-equivalent ready-bldg-counts 'spawning-pool) 0)
         (= (bldg-count-equivalent total-bldg-counts 'roach-warren) 0)
         (or (>= active-bases 3)
             (= (bldg-count-equivalent total-bldg-counts 'baneling-nest) 0)
             zerg-2base-rw-allowed-with-bn?)
         (>= workers (if zerg-enemy-early-ranged-harass? 20 24))
         (>= frame 3360)
         (or (>= (unit-count-equivalent unit-counts 'queen) (min 2 active-bases))
             (>= frame 4480)
             zerg-enemy-early-ranged-harass?)
         (or zerg-enemy-early-ranged-harass?
             (and (not under-early-rush-crisis?)
                  (not early-rush-override-active?)))
         (not early-ling-rush-defense-active?)
         (not enemy-air-dominant?)
         (not opp-cap-air-override?)
         (or (>= active-bases 2) (>= frame 4480) zerg-enemy-fast-harass-pressure?)))
  (define zerg-cloak-air-hydraden-due?
    (or zerg-air-hydraden-before-spire?
        (and zerg-cloaked-air-crisis?
             (not zerg-cap-air-spire-due?)
             (not zerg-cap-air-corruptor-priority-due?)
             has-lair-or-hive-ready?
             (= (bldg-count-equivalent total-bldg-counts 'hydralisk-den) 0)
             (= (bldg-count-equivalent total-bldg-counts 'spire) 0))))
  (define zerg-cloak-air-aa-unit-sym
    (cond
      [(and (or enemy-cap-air? opp-cap-air-override? enemy-bc-present?)
            (not zerg-corruptor-capped?)
            (or (> (bldg-count-equivalent ready-bldg-counts 'spire) 0)
                (> (bldg-count-equivalent ready-bldg-counts 'greater-spire) 0)))
       'corruptor]
      [(> (bldg-count-equivalent ready-bldg-counts 'hydralisk-den) 0)
       'hydralisk]
      [else 'corruptor]))
  (define zerg-cloak-air-aa-unit-due?
    (and (eq? race 'Zerg)
         (or zerg-cloaked-air-crisis? enemy-cap-air? opp-cap-air-override? enemy-bc-present?)
         (or (not (eq? zerg-cloak-air-aa-unit-sym 'corruptor))
             (not zerg-corruptor-capped?))
         (or (> (bldg-count-equivalent ready-bldg-counts 'hydralisk-den) 0)
             (> (bldg-count-equivalent ready-bldg-counts 'spire) 0)
             (> (bldg-count-equivalent ready-bldg-counts 'greater-spire) 0))
         (or (not (hash? open-facility-slots)) (> open-larva-cnt 0))))
  (define zerg-cloak-air-queen-due?
    (and zerg-cloaked-air-crisis?
         (> (bldg-count-equivalent ready-bldg-counts 'spawning-pool) 0)
         (< (unit-count-equivalent unit-counts 'queen) desired-queens)))
  ;; W17-P0-2a-belief (`#1 Z v titania`):
  ;; 1) Never let `lair@1260` / `spore-crawler@940` escrow block ALL Zerg combat units when `minerals >= 400`
  ;;    or `open-larva-cnt >= 8`!
  ;; 2) When Zerg has NO ready Lair-tier AA (`hydralisk-den == 0 && spire == 0 && greater-spire == 0`)
  ;;    AND high bank (`minerals >= 600` or `minerals >= 400 && open-larva-cnt >= 8`), NEVER let anti-air
  ;;    unit-cap rules (`roach <= 4`, `ravager <= 1`, `zergling <= 12`, `slice15-all-suppressed-units`)
  ;;    leave ZERO eligible combat units while Larvae rot at 14.2k M / 1k G!
  (define zerg-no-lair-aa-tech-ready?
    (and (eq? race 'Zerg)
         (= (bldg-count-equivalent ready-bldg-counts 'hydralisk-den) 0)
         (= (bldg-count-equivalent ready-bldg-counts 'spire) 0)
         (= (bldg-count-equivalent ready-bldg-counts 'greater-spire) 0)))
  (define zerg-high-bank-or-larva-overflow?
    (and (eq? race 'Zerg)
         (not under-early-rush-crisis?)
         (or (>= minerals 400)
             (and (hash? open-facility-slots) (>= open-larva-cnt 8)))))
  (define zerg-no-aa-high-bank-combat-fallback?
    (and zerg-no-lair-aa-tech-ready?
         (not under-early-rush-crisis?)
         (or (>= minerals 600)
             (and (>= minerals 400)
                  (hash? open-facility-slots)
                  (>= open-larva-cnt 8)))))
  ;; L30-P0-2 (`#41/#42` Zerg Midgame Army Calibration): Cap Zergling share once RoachWarren/HydraliskDen
  ;; is ready so Zerg builds real Roach/Ravager/Hydra armies instead of naked Zergling waves!
  (define zerg-midgame-gas-army-cnt
    (if (eq? race 'Zerg)
        (+ (unit-count-equivalent unit-counts 'roach)
           (unit-count-equivalent unit-counts 'ravager)
           (unit-count-equivalent unit-counts 'hydralisk)
           (unit-count-equivalent unit-counts 'lurker)
           (unit-count-equivalent unit-counts 'baneling)
           (unit-count-equivalent unit-counts 'ultralisk)
           (unit-count-equivalent unit-counts 'mutalisk)
           (unit-count-equivalent unit-counts 'corruptor))
        0))
  ;; L33-P0-2 (`#34` Anti-Bio Baneling Scaling): Detect Bio-heavy Terran (`>= 12 Marines` or `>= 14 Bio`),
  ;; unlock BanelingNest if missing, and elevate Banelings (`u >= 568`, target `12..24`) ahead of naked Lings/Roaches!
  (define enemy-terran-marine-cnt (unit-count-equivalent enemy-u-counts 'marine))
  (define enemy-terran-bio-cnt
    (+ enemy-terran-marine-cnt
       (unit-count-equivalent enemy-u-counts 'marauder)))
  (define zerg-enemy-heavy-bio?
    (and (eq? race 'Zerg)
         (or (>= enemy-terran-marine-cnt 12)
             (>= enemy-terran-bio-cnt 14))
         (not enemy-air-dominated-now?)
         (not opp-cap-air-override?)
         (not enemy-heavy-cap-air?)))
  (define zerg-anti-bio-baneling-target
    (if zerg-enemy-heavy-bio?
        (let ([min-floor (cond
                           [(>= enemy-terran-marine-cnt 24) 18]
                           [(>= enemy-terran-marine-cnt 18) 14]
                           [else 12])])
          (min 24 (max min-floor (inexact->exact (ceiling (* 0.55 enemy-terran-bio-cnt))))))
        0))
  (define zerg-anti-bio-baneling-nest-due?
    (and zerg-enemy-heavy-bio?
         (not zerg-banshee-suppress-ground-t15-tech?)
         (= (bldg-count-equivalent total-bldg-counts 'baneling-nest) 0)
         (> (bldg-count-equivalent ready-bldg-counts 'spawning-pool) 0)
         (>= workers 24)
         (not under-early-rush-crisis?)
         (not zerg-zvz-rush-suppress-t15-tech?)
         (not (and (or under-attack? (> enemy-threat-supply 0))
                   (< minerals 225)
                   (> (+ (bldg-count-equivalent ready-bldg-counts 'roach-warren)
                         (bldg-count-equivalent ready-bldg-counts 'hydralisk-den))
                      0)))))
  (define zerg-anti-bio-baneling-due?
    (and zerg-enemy-heavy-bio?
         (> (bldg-count-equivalent ready-bldg-counts 'baneling-nest) 0)
         (>= (unit-count-equivalent unit-counts 'zergling) 2)
         (< (unit-count-equivalent unit-counts 'baneling) zerg-anti-bio-baneling-target)))
  (define zerg-anti-bio-needs-morph-lings?
    (and zerg-enemy-heavy-bio?
         (> (bldg-count-equivalent ready-bldg-counts 'baneling-nest) 0)
         (< (unit-count-equivalent unit-counts 'baneling) zerg-anti-bio-baneling-target)
         (< (unit-count-equivalent unit-counts 'zergling)
            (if (>= enemy-terran-marine-cnt 18) 12 8))))
  ;; L37-P0-1 (`#860`, `#34 ZvT AxeFighter` 0 Banelings vs 153 Marines w/ ready BanelingNest):
  ;; Against >= 18 Terran Marines with ready BanelingNest, elevate Banelings (625u, blk=#t) &
  ;; morph-lings (605u) strictly above Roach/Hydra/Drone so 12-18+ Banelings actually morph!
  (define zerg-zvt-heavy-marine-baneling-due?
    (and zerg-anti-bio-baneling-due?
         (>= enemy-terran-marine-cnt 18)
         (not zerg-zvt-banshee-aa-rush?)
         (not supply-preempt-now?)))
  (define zerg-zvt-heavy-marine-morph-lings-due?
    (and zerg-anti-bio-needs-morph-lings?
         (>= enemy-terran-marine-cnt 18)
         (not zerg-zvt-banshee-aa-rush?)
         (>= gas 25)
         (or (not (hash? open-facility-slots)) (> open-larva-cnt 0))
         (not supply-preempt-now?)))
  ;; L33/L34-P0-2 (`#64/#37/#76/#19/#01` Midgame Zerg Combat-Army Floor):
  ;; Trigger ONLY after 3-base economy is established (`workers >= 46 & active-bases >= 3`) — NEVER delay
  ;; 3rd Hatch or `w4`/`w6` Drone saturation, NEVER escrow-lock Roach/Hydra (`blk = #f` when peaceful!),
  ;; and keep Hatch #4 unlocked once `army-supply >= 20` OR `minerals >= 600`!
  (define zerg-midgame-combat-army-supply
    (if (eq? race 'Zerg)
        (+ (* 0.5 (unit-count-equivalent unit-counts 'zergling))
           (* 0.5 (unit-count-equivalent unit-counts 'baneling))
           (* 2.0 (unit-count-equivalent unit-counts 'roach))
           (* 3.0 (unit-count-equivalent unit-counts 'ravager))
           (* 2.0 (unit-count-equivalent unit-counts 'hydralisk))
           (* 3.0 (unit-count-equivalent unit-counts 'lurker))
           (* 2.0 (unit-count-equivalent unit-counts 'mutalisk))
           (* 2.0 (unit-count-equivalent unit-counts 'corruptor))
           (* 6.0 (unit-count-equivalent unit-counts 'ultralisk))
           (* 4.0 (unit-count-equivalent unit-counts 'brood-lord))
           (* 3.0 (unit-count-equivalent unit-counts 'viper))
           (* 2.0 (unit-count-equivalent unit-counts 'infestor))
           (* 3.0 (unit-count-equivalent unit-counts 'swarm-host)))
        0.0))
  (define zerg-midgame-combat-supply-now
    (if (eq? race 'Zerg)
        (max zerg-midgame-combat-army-supply
             (max 0.0 (- (exact->inexact army-supply)
                         (* 2.0 (unit-count-equivalent unit-counts 'queen)))))
        0.0))
  (define zerg-enemy-confirmed-tiny?
    (and (not under-attack?)
         (< enemy-threat-supply 8.0)
         (<= believed-opp-army-sup 8.0)
         (hash? enemy-u-counts)
         (> (hash-count enemy-u-counts) 0)
         (< (+ enemy-ground-combat-supply (* 2.5 enemy-air-combat-cnt)) 8.0)))
  (define zerg-midgame-army-floor-due?
    (and (eq? race 'Zerg)
         (>= workers 46)
         (>= active-bases 3)
         (< zerg-midgame-combat-supply-now 28.0)
         (not zerg-enemy-confirmed-tiny?)
         (not under-early-rush-crisis?)
         (not enemy-air-dominated-now?)
         (not opp-cap-air-override?)
         (or (> (bldg-count-equivalent ready-bldg-counts 'roach-warren) 0)
             (> (bldg-count-equivalent ready-bldg-counts 'hydralisk-den) 0)
             (> (bldg-count-equivalent ready-bldg-counts 'baneling-nest) 0))))
  (define zerg-midgame-floor-defer-hatch4?
    (and zerg-midgame-army-floor-due?
         (>= total-townhalls-incl-pending 3)
         (< army-supply 20)
         (< minerals 600)))
  ;; L51-1D (`H2H #01 ZvZ` HydraDen @421s late + InfestationPit/Hive starved Hydras):
  ;; Start ZvZ HydraliskDen earlier (~5:15-5:45 once Lair is ready, >=38 Drones, >=20 army,
  ;; not in midgame army floor emergency, gas>=50) and defer InfestationPit (plus ZvZ Hive)
  ;; until hydralisk >= 8 (unless gas >= 250 or cap-air)!
  (define zerg-zvz-midgame-hydraden-due?
    (and (eq? race 'Zerg)
         (eq? enemy-race 'Zerg)
         has-lair-or-hive-ready?
         (= (bldg-count-equivalent total-bldg-counts 'hydralisk-den) 0)
         (not zerg-midgame-army-floor-due?)
         (>= army-supply 20)
         (not keep-spire-aa?)
         (not zerg-cap-air-spire-due?)
         (not zerg-cap-air-corruptor-priority-due?)
         (not under-early-rush-crisis?)
         (not early-rush-override-active?)
         (not supply-preempt-now?)
         (>= workers 38)
         (or (>= frame 7056)
             (and (>= active-bases 3) (>= workers 42)))
         (>= gas 50)))
  (define zerg-defer-infestation-pit-for-hydras?
    (and (eq? race 'Zerg)
         (not enemy-cap-air?)
         (not opp-cap-air-override?)
         (not enemy-heavy-cap-air?)
         (< gas 250)
         (or zerg-zvz-midgame-hydraden-due?
             (and (> (bldg-count-equivalent ready-bldg-counts 'hydralisk-den) 0)
                  (< (unit-count-equivalent unit-counts 'hydralisk) 8)))))
  (define zerg-tech-ready-ling-cap
    (cond
      [(not (eq? race 'Zerg)) 999]
      [(or under-early-rush-crisis?
           early-ling-rush-defense-active?
           zvz-early-ling-defense-due?
           zvz-early-ling-wave2-hold?
           zerg-anti-bio-needs-morph-lings?
           (and (or under-attack? (> enemy-threat-supply army-supply))
                (< army-supply (min 20 enemy-threat-supply))
                (< (unit-count-equivalent unit-counts 'zergling) 16)))
       999]
      [(and (or (> (bldg-count-equivalent ready-bldg-counts 'roach-warren) 0)
                (> (bldg-count-equivalent ready-bldg-counts 'hydralisk-den) 0))
            (not zerg-no-aa-high-bank-combat-fallback?))
       (cond
         [(and (>= minerals 400)
               (or (< gas 25)
                   (and (< gas 100)
                        (= (bldg-count-equivalent total-bldg-counts 'lair) 0)
                        (= (bldg-count-equivalent total-bldg-counts 'hive) 0)
                        (or eff-req-aa? eff-req-det? (>= enemy-banshee-cnt 1)
                            keep-spire-aa? enemy-cap-air? enemy-cloaked-threat-active?
                            (>= frame 5376)))))
          (min 16 (max 12 (* 2 zerg-midgame-gas-army-cnt)))]
         [(>= gas 25)
          (min 20 (max 8 (inexact->exact (floor (* 1.5 zerg-midgame-gas-army-cnt)))))]
         [(>= minerals 1000) 36]
         [else (min 24 (max 12 (* 2 zerg-midgame-gas-army-cnt)))])]
      [else 999]))
  ;; L33-P0-2 (`#17/#62/#77 TvT0Tank -> 0`): Never let speculative `missile-turret`
  ;; (no explicit cloaked threat AND 0 enemy combat air) outrank or escrow-block
  ;; TvT Siege Tank #1/#2 when Factory+TechLab is ready!
  (define terran-tvt-protect-tank-over-spec-turret?
    (and (eq? race 'Terran)
         (eq? enemy-race 'Terran)
         (not enemy-explicit-cloaked-threat?)
         (not terran-enemy-banshee-starport-tl?)
         (= enemy-air-combat-cnt 0)
         (> (bldg-count-equivalent ready-bldg-counts 'factory-techlab) 0)
         (< (unit-count-equivalent unit-counts 'siege-tank) 2)))
  ;; L37-P0-1 + L42-P0-2a (`#860`, `#74 TvP/TvT who` DTs / 8 Banshees @210s):
  ;; On confirmed DT/DarkShrine/Banshee/Lurker OR pre-6m StarportTechLab, lock EBay + 1 MissileTurret/base
  ;; (`u >= 1255..1260, blk=#t`) AND >= 4 Vikings (`u >= 940, blk=#t`) ahead of Tank/Starport/Rax/Hellion!
  (define terran-confirmed-cloak-threat?
    (and (eq? race 'Terran)
         (or (> (unit-count-equivalent enemy-u-counts 'dark-templar) 0)
             (> (bldg-count-equivalent enemy-b-counts 'dark-shrine) 0)
             (>= enemy-banshee-cnt 1)
             terran-enemy-banshee-starport-tl?
             (> (unit-count-equivalent enemy-u-counts 'lurker) 0)
             (> (bldg-count-equivalent enemy-b-counts 'lurker-den) 0))))
  (define terran-confirmed-cloak-ebay-lock?
    (and terran-confirmed-cloak-threat?
         (= (bldg-count-equivalent total-bldg-counts 'engineering-bay) 0)
         (= (bldg-count-equivalent total-bldg-counts 'missile-turret) 0)
         (> (bldg-count-equivalent ready-bldg-counts 'barracks) 0)
         (or terran-enemy-banshee-starport-tl?
             (> (bldg-count-equivalent total-bldg-counts 'orbital-command) 0)
             (= (+ (hash-ref ready-bldg-counts 'command-center 0)
                   (hash-ref ready-bldg-counts 'command-center-flying 0))
                0))))
  ;; L59-P2 + L61 (`#5143784` & `#74 TvT who`): Keep low-econ `missile-turret` #2+ non-blocking
  ;; (and non-Banshee Turret #1 when OC is ready), while NEVER downgrading Turret #1 against active
  ;; enemy Banshees/StarportTechLab so Starport/Tank can never preempt Turret #1 & Marines!
  (define terran-turret-low-econ-nonblocking?
    (and (eq? race 'Terran)
         (< minerals 100)
         (or (< workers 18) (< army-supply 6))
         (or (>= (bldg-count-equivalent total-bldg-counts 'missile-turret) 1)
             (and (not terran-enemy-banshee-starport-tl?)
                  (= enemy-banshee-cnt 0)
                  (> (bldg-count-equivalent ready-bldg-counts 'orbital-command) 0)))))
  (define terran-cloak-pre-turret1-defer-starport-tank?
    (and terran-cloaked-det-crisis?
         (= (bldg-count-equivalent total-bldg-counts 'missile-turret) 0)
         (or (>= enemy-banshee-cnt 1)
             terran-enemy-banshee-starport-tl?
             terran-confirmed-cloak-threat?)
         (or (= (bldg-count-equivalent total-bldg-counts 'engineering-bay) 0)
             (> (bldg-count-equivalent ready-bldg-counts 'engineering-bay) 0))))
  (define terran-banshee-marine-aa-urgent?
    (and terran-cloaked-det-crisis?
         (>= enemy-banshee-cnt 1)
         (< (unit-count-equivalent unit-counts 'marine) 8)
         (> (bldg-count-equivalent ready-bldg-counts 'barracks) 0)
         (or (not (hash? open-facility-slots))
             (> (hash-ref open-facility-slots 'barracks 0) 0))
         (>= supply-left 1)
         (not supply-preempt-now?)))
  (define terran-confirmed-cloak-turret-lock?
    (and terran-confirmed-cloak-threat?
         (not terran-tvt-protect-tank-over-spec-turret?)
         (not terran-turret-low-econ-nonblocking?)
         (> (bldg-count-equivalent ready-bldg-counts 'engineering-bay) 0)
         (< (bldg-count-equivalent total-bldg-counts 'missile-turret)
            (min (if terran-enemy-banshee-starport-tl? 3 2) (max 1 active-bases)))))
  ;; L44-P0-2b (`#62 SmoothBrain` TvT0Tank -> 0): Once >= 2 Missile Turrets (or >= 1 Turret + >= 1 Viking)
  ;; are up in TvT against light/probed Banshee/StarportTechLab (< 3 Banshees & < 4 combat air),
  ;; keep FactoryTechLab #1 and SiegeTank #1–2 (`125G`) active unless 2 Banshees still need Viking #2!
  (define terran-tvt-turrets-stabilized?
    (and (eq? race 'Terran)
         (eq? enemy-race 'Terran)
         (< enemy-banshee-cnt 3)
         (< enemy-air-combat-cnt 4)
         (not enemy-air-dominated-now?)
         (not enemy-heavy-cap-air?)
         (or (>= (bldg-count-equivalent total-bldg-counts 'missile-turret) 2)
             (and (>= (bldg-count-equivalent total-bldg-counts 'missile-turret) 1)
                  (>= (unit-count-equivalent unit-counts 'viking-fighter) 1)))
         (or (< enemy-banshee-cnt 2)
             (>= (unit-count-equivalent unit-counts 'viking-fighter) 2)
             (= (bldg-count-equivalent ready-bldg-counts 'starport) 0)
             (and (hash? open-facility-slots)
                  (<= open-starport-slots 0)))))
  (define terran-tvt-tank1-with-factl-due?
    ;; L59 (`#74 who` TvT0Tank vs Cloaked Banshees): Once >= 1 Missile Turret is down and
    ;; Factory+TechLab is ready at 0 Siege Tanks, never block Siege Tank #1 when Starport is
    ;; unbuilt/busy or gas >= 200 — guarantees TvT builds Tank #1 alongside Starport/Viking!
    (and (eq? race 'Terran)
         (eq? enemy-race 'Terran)
         (> (bldg-count-equivalent ready-bldg-counts 'factory-techlab) 0)
         (= (unit-count-equivalent unit-counts 'siege-tank) 0)
         (>= (bldg-count-equivalent total-bldg-counts 'missile-turret) 1)
         (or (= (bldg-count-equivalent ready-bldg-counts 'starport) 0)
             (and (hash? open-facility-slots) (<= open-starport-slots 0))
             (>= gas 200))))
  (define terran-tvt-turrets-tank2-needed?
    (or (and terran-tvt-turrets-stabilized?
             (< (unit-count-equivalent unit-counts 'siege-tank) 2))
        terran-tvt-tank1-with-factl-due?))
  (define terran-det-starport-due?
    ;; L59 (`#74 who` TvT 0 Vikings vs 8 Cloaked Banshees): Once >= 1 Missile Turret is down
    ;; and Factory is ready with 0 Starports under active Banshee/StarportTechLab threat, force
    ;; Starport #1 (u=945, blk=#t) so Vikings/Raven always unlock!
    (and terran-cloaked-det-crisis?
         (or (>= enemy-banshee-cnt 1) terran-enemy-banshee-starport-tl?)
         (= (bldg-count-equivalent total-bldg-counts 'starport) 0)
         (> (bldg-count-equivalent ready-bldg-counts 'factory) 0)
         (>= (bldg-count-equivalent total-bldg-counts 'missile-turret) 1)))
  (define (terran-confirmed-cloak-defer-prod-sym? nsym)
    (or (and terran-cloak-pre-turret1-defer-starport-tank?
             (memq nsym '(starport siege-tank cyclone factory medivac liberator
                          factory-techlab factory-reactor
                          starport-techlab starport-reactor
                          barracks-techlab barracks-reactor
                          stimpack combat-shield concussive-shells)))
        (and terran-confirmed-cloak-turret-lock?
             (< minerals 225)
             (not (and terran-tvt-turrets-tank2-needed?
                       (>= (bldg-count-equivalent total-bldg-counts 'missile-turret) 2)
                       (memq nsym '(factory-techlab siege-tank))))
             (not (and terran-det-starport-due? (eq? nsym 'starport)))
             (memq nsym '(barracks starport factory siege-tank hellion marauder
                          barracks-reactor barracks-techlab
                          factory-techlab factory-reactor
                          starport-techlab starport-reactor
                          stimpack combat-shield concussive-shells)))
        (and terran-enemy-banshee-starport-tl?
             terran-confirmed-cloak-ebay-lock?
             (< minerals 275)
             (memq nsym '(viking-fighter siege-tank starport barracks factory hellion marauder
                          barracks-reactor barracks-techlab
                          factory-techlab factory-reactor
                          starport-techlab starport-reactor
                          stimpack combat-shield concussive-shells)))
        (and terran-enemy-banshee-starport-tl?
             (> (bldg-count-equivalent ready-bldg-counts 'starport) 0)
             (< (unit-count-equivalent unit-counts 'viking-fighter) 4)
             (or (< gas 150) (< minerals 225))
             (not (and terran-tvt-turrets-tank2-needed?
                       (memq nsym '(factory-techlab siege-tank))))
             (memq nsym '(siege-tank cyclone barracks hellion marauder medivac liberator
                          factory factory-techlab factory-reactor
                          barracks-reactor barracks-techlab
                          starport-techlab starport-reactor
                          stimpack combat-shield concussive-shells)))))
  (define terran-det-ebay-due?
    (and terran-cloaked-det-crisis?
         (= (bldg-count-equivalent total-bldg-counts 'engineering-bay) 0)
         (> (bldg-count-equivalent ready-bldg-counts 'barracks) 0)))
  (define terran-det-turret-due?
    (and terran-cloaked-det-crisis?
         (not terran-tvt-protect-tank-over-spec-turret?)
         (> (bldg-count-equivalent ready-bldg-counts 'engineering-bay) 0)
         (< (bldg-count-equivalent total-bldg-counts 'missile-turret)
            (min 3 (max 1 active-bases)))))
  ;; L43-P0-2a (`PolyMorph T` 141-tick Viking leak): Strictly gate Terran `viking-fighter` demand
  ;; behind real combat air, TvT, scouted Stargate/Spire/Starport/FusionCore/FleetBeacon, Colossus/RoboBay,
  ;; or capital-air override — pure Overlord/ground Zerg armies NEVER trigger Viking production!
  (define terran-enemy-air-tech-scouted?
    (or (> (bldg-count-equivalent enemy-b-counts 'stargate) 0)
        (> (bldg-count-equivalent enemy-b-counts 'fleet-beacon) 0)
        (> (bldg-count-equivalent enemy-b-counts 'spire) 0)
        (> (bldg-count-equivalent enemy-b-counts 'greater-spire) 0)
        (> (bldg-count-equivalent enemy-b-counts 'starport) 0)
        (> (bldg-count-equivalent enemy-b-counts 'starport-techlab) 0)
        (> (bldg-count-equivalent enemy-b-counts 'fusion-core) 0)))
  (define terran-viking-justified?
    (or (>= enemy-air-combat-cnt 1)
        (eq? enemy-race 'Terran)
        terran-enemy-air-tech-scouted?
        (> (unit-count-equivalent enemy-u-counts 'colossus) 0)
        (> (bldg-count-equivalent enemy-b-counts 'robotics-bay) 0)
        enemy-cap-air?
        opp-cap-air-override?
        terran-enemy-banshee-starport-tl?
        (and eff-req-aa?
             (= (hash-count enemy-u-counts) 0)
             (= (hash-count enemy-b-counts) 0))))
  (define terran-zero-air-suppress-viking?
    (and (eq? race 'Terran)
         (not terran-viking-justified?)))
  (define terran-det-viking-due?
    (and terran-cloaked-det-crisis?
         terran-viking-justified?
         (or eff-req-aa? (>= enemy-banshee-cnt 1) terran-enemy-banshee-starport-tl?)
         (> (bldg-count-equivalent ready-bldg-counts 'starport) 0)
         (or (not (hash? open-facility-slots)) (> open-starport-slots 0))
         (< (unit-count-equivalent unit-counts 'viking-fighter)
            (if terran-tvt-turrets-tank2-needed?
                (max 1 enemy-banshee-cnt)
                6))))
  ;; L62 (`#1660` `#78 PvT VeTerran`): When on 1 base already at >=300M (within ~4s of 400M
  ;; Natural Nexus!) with 0 active DTs/Banshees/Lurkers and non-overwhelming threat, let Nexus #2
  ;; drop first instead of burning 380M of Nexus escrow on reactive Robo/Forge for a scouted Widow Mine!
  (define protoss-1base-near-nat-defer-spec-det?
    (and (eq? race 'Protoss)
         (= active-bases 1)
         (<= total-townhalls-incl-pending 1)
         (>= minerals 300)
         (= (unit-count-equivalent enemy-u-counts 'dark-templar) 0)
         (= (bldg-count-equivalent enemy-b-counts 'dark-shrine) 0)
         (= (unit-count-equivalent enemy-u-counts 'banshee) 0)
         (= (unit-count-equivalent enemy-u-counts 'lurker) 0)
         (= (unit-count-equivalent enemy-u-counts 'lurker-burrowed) 0)
         (<= enemy-threat-supply army-supply)))
  ;; L63 (`#1704` Early DT / Dark Shrine / Warp Prism Observer #1 + Mineral-Line Cannon):
  ;; Against Dark Shrine / Dark Templar, guarantee BOTH Observer #1 AND mineral-line Photon Cannon #1
  ;; (+ Forge #1) ahead of greedy tech; against bare PvP Warp Prism (0 DT/DarkShrine), guarantee
  ;; Observer #1 urgently & Cannon #1 if Forge is ready without stealing Forge from Immortals!
  (define protoss-confirmed-dt-shrine-threat?
    (and (eq? race 'Protoss)
         (or (> (unit-count-equivalent enemy-u-counts 'dark-templar) 0)
             (> (bldg-count-equivalent enemy-b-counts 'dark-shrine) 0))))
  (define protoss-dt-shrine-prism-threat?
    (and (eq? race 'Protoss)
         (or protoss-confirmed-dt-shrine-threat?
             (and (eq? enemy-race 'Protoss)
                  (or (> (unit-count-equivalent enemy-u-counts 'warp-prism) 0)
                      (> (unit-count-equivalent enemy-u-counts 'warp-prism-phasing) 0))))))
  (define (protoss-dt-greedy-tech-deferred-sym? nsym)
    (and (or (and protoss-confirmed-dt-shrine-threat?
                  (or (= (unit-count-equivalent unit-counts 'observer) 0)
                      (= (bldg-count-equivalent total-bldg-counts 'photon-cannon) 0)))
             (and protoss-dt-shrine-prism-threat?
                  (= (unit-count-equivalent unit-counts 'observer) 0)))
         (or (memq nsym '(twilight-council templar-archive dark-shrine robotics-bay
                          stargate fleet-beacon charge blink colossus disruptor))
             (and (eq? nsym 'immortal)
                  (= (unit-count-equivalent unit-counts 'observer) 0))
             (and (eq? nsym 'nexus)
                  (>= total-townhalls-incl-pending 2)))))
  (define protoss-det-forge-due?
    (and (eq? race 'Protoss)
         (not protoss-1base-near-nat-defer-spec-det?)
         (= (bldg-count-equivalent total-bldg-counts 'forge) 0)
         (> (bldg-count-equivalent ready-bldg-counts 'gateway) 0)
         (or (and enemy-cloaked-threat-active?
                  (= (bldg-count-equivalent total-bldg-counts 'robotics-facility) 0))
             (and protoss-confirmed-dt-shrine-threat?
                  (= (bldg-count-equivalent total-bldg-counts 'photon-cannon) 0)
                  (or (= (bldg-count-equivalent total-bldg-counts 'robotics-facility) 0)
                      (> (unit-count-equivalent unit-counts 'observer) 0)
                      (< gas 75))))))
  (define protoss-det-cannon-due?
    (and (eq? race 'Protoss)
         (or enemy-cloaked-threat-active?
             protoss-confirmed-dt-shrine-threat?
             (and protoss-dt-shrine-prism-threat?
                  (> (bldg-count-equivalent ready-bldg-counts 'forge) 0)))
         (> (bldg-count-equivalent ready-bldg-counts 'forge) 0)
         (< (bldg-count-equivalent total-bldg-counts 'photon-cannon)
            (min 3 (max 1 active-bases)))))
  ;; L29-P0-2 + L60 (`#1580`/`#1582` `#75 who` PvP WarpPrism+DT):
  ;; Upon ANY cloaked/burrowed enemy threat (`DT`, `Banshee`, `Lurker`, `Ghost`, `Burrowed`, `DarkShrine`)
  ;; OR scouted enemy `WarpPrism`/`DarkShrine`/`DT` in Protoss with `0` Observers, immediately force
  ;; `Observer #1` (`u = 1240.0, blk = #t`) ahead of Immortal escrow (`250M/100G`) & Twilight/RoboBay!
  (define protoss-anti-dt-or-prism-obs1-urgent?
    (and (eq? race 'Protoss)
         (= (unit-count-equivalent unit-counts 'observer) 0)
         (or enemy-cloaked-threat-active?
             protoss-dt-shrine-prism-threat?)))
  (define (emergency-cloak-det-boost-info nsym)
    (and (or enemy-cloaked-threat-active?
             protoss-anti-dt-or-prism-obs1-urgent?
             protoss-confirmed-dt-shrine-threat?
             terran-enemy-banshee-starport-tl?
             zerg-zvt-banshee-aa-rush?
             zerg-zvt-late-lair-emergency-spore-due?
             (and (eq? race 'Zerg) (>= enemy-banshee-cnt 1)))
         (case race
           [(Protoss)
            (let ([obs-cnt (unit-count-equivalent unit-counts 'observer)]
                  [cannon-cnt (bldg-count-equivalent total-bldg-counts 'photon-cannon)]
                  [robo-cnt (bldg-count-equivalent total-bldg-counts 'robotics-facility)]
                  [ready-robo-cnt (bldg-count-equivalent ready-bldg-counts 'robotics-facility)]
                  [forge-cnt (bldg-count-equivalent total-bldg-counts 'forge)]
                  [ready-forge-cnt (bldg-count-equivalent ready-bldg-counts 'forge)]
                  [cannon-tgt (if (or under-attack? (> enemy-threat-supply 0))
                                  (min 2 (max 1 active-bases))
                                  1)])
              (cond
                [(= obs-cnt 0)
                 (case nsym
                   [(observer)
                    (and (> ready-robo-cnt 0)
                         (or (not (hash? open-facility-slots)) (> open-robo-slots 0))
                         (cons 1240.0 #t))]
                   [(photon-cannon)
                    (and (or enemy-cloaked-threat-active? protoss-confirmed-dt-shrine-threat?)
                         (> ready-forge-cnt 0)
                         (> (bldg-count-equivalent ready-bldg-counts 'pylon) 0)
                         (< cannon-cnt cannon-tgt)
                         (cons 1200.0 #t))]
                   [(robotics-facility)
                    (and (= robo-cnt 0)
                         (= cannon-cnt 0)
                         (or (>= gas 60) (> forge-cnt 0))
                         (> (bldg-count-equivalent ready-bldg-counts 'cybernetics-core) 0)
                         (not protoss-1base-near-nat-defer-spec-det?)
                         (cons 1185.0 #t))]
                   [(forge)
                    (and (or enemy-cloaked-threat-active? protoss-confirmed-dt-shrine-threat?)
                         (= forge-cnt 0)
                         (= cannon-cnt 0)
                         (not protoss-1base-near-nat-defer-spec-det?)
                         (> (bldg-count-equivalent ready-bldg-counts 'gateway) 0)
                         (or (and (= robo-cnt 0) (< gas 60))
                             (and (= ready-robo-cnt 0)
                                  (or under-attack? (> enemy-threat-supply 0) protoss-confirmed-dt-shrine-threat?)))
                         (cons (if (< gas 60) 1190.0 1160.0) #t))]
                   [else #f])]
                ;; L63 (`#1704` Early DT): Even after Observer #1 is out, guarantee mineral-line
                ;; Photon Cannon #1 (+ Forge #1 if missing) against confirmed Dark Shrine / DT!
                [(and protoss-confirmed-dt-shrine-threat? (= cannon-cnt 0))
                 (case nsym
                   [(photon-cannon)
                    (and (> ready-forge-cnt 0)
                         (> (bldg-count-equivalent ready-bldg-counts 'pylon) 0)
                         (cons 885.0 (>= minerals 150)))]
                   [(forge)
                    (and (= forge-cnt 0)
                         (not protoss-1base-near-nat-defer-spec-det?)
                         (> (bldg-count-equivalent ready-bldg-counts 'gateway) 0)
                         (cons 875.0 (>= minerals 150)))]
                   [else #f])]
                [else #f]))]
           [(Zerg)
            (let ([overseer-cnt (unit-count-equivalent unit-counts 'overseer)]
                  [spore-cnt (bldg-count-equivalent total-bldg-counts 'spore-crawler)]
                  [lair-cnt (bldg-count-equivalent total-bldg-counts 'lair)]
                  [hive-cnt (bldg-count-equivalent total-bldg-counts 'hive)]
                  [spore-tgt (if zerg-mass-banshee-escalation?
                                 (min 5 (max 2 active-bases))
                                 (min 2 (max 1 active-bases)))])
              (cond
                ;; L55-M2 (`#25 onlyfans`): Weaponless Overseer #1 cannot kill Banshees — keep Spore
                ;; Crawler active up to `min(2, active-bases)` whenever Banshees or
                ;; `zerg-zvt-banshee-aa-rush?` threaten (preserving `1640.0` > `queen@1630` when
                ;; `zerg-banshee-spore-floor-needed?` and Lair is started/ready or `< 100G`, else
                ;; `1190.0` > `queen@960`) so Queens never starve a `75M` Spore!
                [(and (eq? nsym 'spore-crawler)
                      (or (= overseer-cnt 0)
                          zerg-zvt-banshee-aa-rush?
                          zerg-zvt-late-lair-emergency-spore-due?
                          (>= enemy-banshee-cnt 1))
                      (> (bldg-count-equivalent ready-bldg-counts 'spawning-pool) 0)
                      (< spore-cnt (if zerg-zvt-late-lair-emergency-spore-due? (max 1 spore-tgt) spore-tgt)))
                 (cons (if (and zerg-banshee-spore-floor-needed?
                                (or has-lair-or-hive-ready?
                                    (> lair-cnt 0)
                                    (< gas 100)))
                           1640.0
                           1190.0)
                       #t)]
                [(= overseer-cnt 0)
                 (case nsym
                   [(overseer)
                    (and has-lair-or-hive-ready?
                         (> (unit-count-equivalent unit-counts 'overlord) 0)
                         (cons 1240.0 #t))]
                   [(lair)
                    (and (= lair-cnt 0)
                         (= hive-cnt 0)
                         (> (bldg-count-equivalent ready-bldg-counts 'spawning-pool) 0)
                         (> (bldg-count-equivalent ready-bldg-counts 'hatchery) 0)
                         (cons (if (>= gas 100) 1210.0 1165.0) #t))]
                   [else #f])]
                [else #f]))]
           [(Terran)
            (let* ([raven-cnt (unit-count-equivalent unit-counts 'raven)]
                   [turret-cnt (bldg-count-equivalent total-bldg-counts 'missile-turret)]
                   [oc-cnt (bldg-count-equivalent total-bldg-counts 'orbital-command)]
                   [ready-cc-cnt (+ (hash-ref ready-bldg-counts 'command-center 0)
                                    (hash-ref ready-bldg-counts 'command-center-flying 0))]
                   [ebay-cnt (bldg-count-equivalent total-bldg-counts 'engineering-bay)]
                   [ready-ebay-cnt (bldg-count-equivalent ready-bldg-counts 'engineering-bay)]
                   [turret-tgt (if (or terran-confirmed-cloak-threat?
                                       (= oc-cnt 0)
                                       under-attack?
                                       (> enemy-threat-supply 0))
                                   (min (if terran-enemy-banshee-starport-tl? 3 2) (max 1 active-bases))
                                   1)])
              (cond
                [(and terran-confirmed-cloak-threat?
                      (eq? nsym 'missile-turret)
                      (not terran-tvt-protect-tank-over-spec-turret?)
                      (> ready-ebay-cnt 0)
                      (< turret-cnt turret-tgt))
                 (cons 1260.0 (not terran-turret-low-econ-nonblocking?))]
                [(and terran-confirmed-cloak-ebay-lock?
                      (eq? nsym 'engineering-bay))
                 (cons 1255.0 #t)]
                [(= raven-cnt 0)
                 (case nsym
                   [(raven)
                    (and (= turret-cnt 0)
                         (> (bldg-count-equivalent ready-bldg-counts 'starport) 0)
                         (> (bldg-count-equivalent ready-bldg-counts 'starport-techlab) 0)
                         (or (not (hash? open-facility-slots)) (> open-starport-slots 0))
                         (cons (if (>= gas 150) 1230.0 1165.0) #t))]
                   [(missile-turret)
                    (and (not terran-tvt-protect-tank-over-spec-turret?)
                         (> ready-ebay-cnt 0)
                         (< turret-cnt turret-tgt)
                         (cons 1200.0 (not terran-turret-low-econ-nonblocking?)))]
                   [(orbital-command)
                    (and (= oc-cnt 0)
                         (= turret-cnt 0)
                         (> ready-cc-cnt 0)
                         (> (bldg-count-equivalent ready-bldg-counts 'barracks) 0)
                         (cons 1185.0 #t))]
                   [(engineering-bay)
                    (and (= ebay-cnt 0)
                         (= turret-cnt 0)
                         (> (bldg-count-equivalent ready-bldg-counts 'barracks) 0)
                         (cons 1175.0 #t))]
                   [else #f])]
                [else #f]))]
           [else #f])))
  ;; W10-P0-2-belief + L22-P0-2 (`#35 TvZ`): Restore Pro #1 Terran BO `Dep->Rax->Ref->CC->Dep->Rax/Fact`
  ;; in TvT/TvP, and in TvZ force wall SupplyDepot #2 (`u >= 650, blk=#t`) right after Barracks #1 (`sup >= 16`)
  ;; strictly BEFORE Refinery #1 & Barracks #2 so the ramp wall seals BEFORE early Lings arrive!
  (define terran-suppress-rax2-before-depot2?
    (and (eq? race 'Terran)
         (= terran-total-depots 1)
         (>= (bldg-count-equivalent total-bldg-counts 'barracks) 1)
         (not terran-early-rush-hold?)
         (not early-ling-rush-defense-active?)
         (not early-worker-rush-active?)
         (not under-early-rush-crisis?)))
  (define terran-tvz-wall-depot2-due?
    (and terran-suppress-rax2-before-depot2?
         (eq? enemy-race 'Zerg)
         (>= supply-used 16)
         (< minerals 400)))
  (define terran-depot2-before-rax2?
    (and terran-suppress-rax2-before-depot2?
         (or terran-tvz-wall-depot2-due?
             (and (or (>= total-townhalls-incl-pending 2)
                      (<= supply-left 1))
                  (or (<= supply-left 5) (>= supply-used 19))))))
  ;; L24/L25-P0-2 (`#02/#08/#23/#26/#29/#32/#35/#47`, `T111Stall 5 -> <=1`): During peaceful 1-base
  ;; natural window once Barracks >= 1 and minerals >= 150 (once OC #1 started or frame >= 2240; 200M earlier),
  ;; lock CommandCenter #2 cleanly at `u = 625.0, blk = #t` strictly ABOVE `factory`/`orbital`/`scv@575`!
  ;; L63B (`#1752` Bug #1B): Cap < 4:00 (`< 5376f`) Bunkers at 1 unless >= 6 Marines/Bio AND under-attack?!
  (define terran-bunker-cap
    (let ([m-cnt (unit-count-equivalent unit-counts 'marine)]
          [bio-cnt (+ (unit-count-equivalent unit-counts 'marine)
                      (unit-count-equivalent unit-counts 'marauder))])
      (cond
        [(< frame 5376)
         (if (and under-attack? (>= bio-cnt 6)) 2 1)]
        [(and terran-early-ground-rush-survival-due? (>= m-cnt 4)) 2]
        [(and early-ling-rush-defense-active? (>= m-cnt 4) (>= minerals 250)) 2]
        [(and early-proxy-marauder-rush-active? under-attack? (>= bio-cnt 6)) 2]
        [(and under-attack? (>= bio-cnt 4) (> enemy-threat-supply (* 1.25 (max 4 army-supply)))) 2]
        [else 1])))
  (define terran-missile-turret-cap
    (if (or terran-cloaked-det-crisis? eff-req-det? requires-detection?
            enemy-cloaked-threat-active? enemy-cap-air? enemy-air-dominant?
            eff-req-aa? (> enemy-air-combat-cnt 0))
        (min 3 (max 2 active-bases))
        1))
  (define terran-1base-nat-cc-lock?
    (and (eq? race 'Terran)
         (= active-bases 1)
         (<= total-townhalls-incl-pending 1)
         (or (>= frame 1800) terran-tvz-post-wall-nat-ready?)
         (>= minerals (if (or terran-tvz-post-wall-nat-ready?
                              (> (bldg-count-equivalent total-bldg-counts 'orbital-command) 0)
                              (>= frame 2240))
                          150
                          200))
         (>= (bldg-count-equivalent total-bldg-counts 'barracks) 1)
         (not terran-1base-cc-lock-broken?)
         (not terran-early-reaper2-defer-oc-cc?)
         (not terran-tvt-1base-tank-core-due?)
         (not under-attack?)
         (not under-early-rush-crisis?)
         (not early-ling-rush-defense-active?)
         (not early-proxy-marauder-rush-active?)
         (not terran-early-rush-hold?)
         (not early-enemy-real-combat-arrived?)
         (not active-1base-t3-rush-pending?)
         (not terran-tvz-wall-depot2-due?)
         (not (and tvz-early-wall-marine-before-cc-escrow? (< minerals 400)))
         (<= enemy-threat-supply (if terran-tvz-sealed-wall-holds-light-lings? 3.0 2.0))))
  ;; L22-P0-2 (`#36/#6 PvZ`): Textbook Pro 14-Pylon -> 16-Gateway -> 17-Assimilator!
  ;; Once Pylon #1 is ready and >= 16 workers with 0 Gateways, Gateway #1 (`u=530`, `blk=#t`)
  ;; strictly outranks Probe #17 (`488`) so Gateway #1 drops immediately at 150M!
  (define protoss-first-gateway-due?
    (and (eq? race 'Protoss)
         (= (bldg-count-equivalent total-bldg-counts 'gateway) 0)
         (> (bldg-count-equivalent ready-bldg-counts 'pylon) 0)
         (>= workers 16)))
  ;; W9-P0-1-belief (#17) + L22/L30-P0-2 (`#17/#32 TvT`): Always pair Factory TechLab + Siege Tanks alongside Bio,
  ;; scale to 2nd Factory in TvT (`min>=150/gas>=100`, dropping 300M/225G open-slot block once >=1 Tank or >=2 enemy Tanks),
  ;; cap TvT Barracks <= 3 until >= 2 Tanks, and suppress redundant Factory/Starport at supply >= 194 (`#11`)!
  (define terran-maxed-suppress-extra-prod?
    (and (eq? race 'Terran)
         (>= supply-used 194)))
  ;; L30/L31/L34-P0-2 (`#17/#38/#02 TvT` `barracks:109`): Align Brain `barracks` caps with Runtime:
  ;; (a) Cap TvT Barracks `<= 2` until `>= 2` Siege Tanks OR `>= 2` Factories exist (unless `min >= 500`);
  ;; (b) Cap Terran Barracks `<= 8` whenever `min < 1000` so Brain never repeatedly schedules Rax #9+!
  (define terran-tvt-rax-cap-for-tanks?
    (and (eq? race 'Terran)
         (eq? enemy-race 'Terran)
         (not enemy-air-dominated-now?)
         (< (unit-count-equivalent unit-counts 'siege-tank) 2)
         (< (bldg-count-equivalent total-bldg-counts 'factory) 2)
         (< minerals 500)))
  ;; L46-P0-2b (`#29`/`#65` ProdStall -> 0, `#62` 3x EBay, `#56` TvT0Tank):
  ;; - Hard-cap true 2-base Terran (`active-bases <= 2` & `total-townhalls-incl-pending <= 2`, `< 800M`) at <= 4 Barracks;
  ;; - Hard-cap Engineering Bay <= 1 on <= 2 bases (<= 2 max ever);
  ;; - Hard-cap TvT Medivacs <= 2 while Siege Tanks < 4!
  (define terran-2base-rax4-capped?
    (and (eq? race 'Terran)
         (<= active-bases 2)
         (<= total-townhalls-incl-pending 2)
         (>= (bldg-count-equivalent total-bldg-counts 'barracks) 4)
         (< minerals 800)))
  (define terran-rax-hard-cap-reached?
    (or (and (eq? race 'Terran)
             (>= (bldg-count-equivalent total-bldg-counts 'barracks) 8)
             (< minerals 1000))
        terran-2base-rax4-capped?))
  (define terran-ebay-cap
    (if (>= active-bases 3) 2 1))
  (define terran-ebay-capped?
    (and (eq? race 'Terran)
         (>= (max (bldg-count-equivalent total-bldg-counts 'engineering-bay)
                  (bldg-count-equivalent ready-bldg-counts 'engineering-bay))
             terran-ebay-cap)))
  (define terran-tvt-medivac-tank4-capped?
    (and (eq? race 'Terran)
         (eq? enemy-race 'Terran)
         (< (unit-count-equivalent unit-counts 'siege-tank) 4)
         (>= (unit-count-equivalent unit-counts 'medivac) 2)))
  ;; L47-P0-2b (`#60 Creepy` 4x CyberCore wasted 600M): Explicitly cap Cybernetics Core <= 1
  ;; (<= 2 ONLY on >= 3 bases with confirmed capital air & >= 1 Stargate + >= 400M)!
  (define protoss-cyber-core-cap
    (if (and (eq? race 'Protoss)
             (>= active-bases 3)
             (or enemy-cap-air? enemy-heavy-cap-air?)
             (> (bldg-count-equivalent total-bldg-counts 'stargate) 0)
             (>= minerals 400))
        2
        1))
  (define protoss-cyber-core-capped?
    (and (eq? race 'Protoss)
         (>= (max (bldg-count-equivalent total-bldg-counts 'cybernetics-core)
                  (bldg-count-equivalent ready-bldg-counts 'cybernetics-core))
             protoss-cyber-core-cap)))
  ;; L48-P0-2b + L60 (`#12`/`#33`/`#51` PvPNatDelay): Defer Gateway #3+, PhotonCannon #2+,
  ;; TwilightCouncil, non-detection Forge, and peaceful RoboticsFacility/Stargate strictly behind Natural Nexus #2!
  (define (pvp-nat-deferred-bldg-sym? nsym)
    (and pvp-nat-defer-gate3-cannon2?
         (not (emergency-cloak-det-boost-info nsym))
         (or (and (eq? nsym 'gateway)
                  (>= (bldg-count-equivalent total-bldg-counts 'gateway) 2))
             (and (eq? nsym 'photon-cannon)
                  (>= (bldg-count-equivalent total-bldg-counts 'photon-cannon) 1))
             (eq? nsym 'twilight-council)
             (and pvp-early-nat-nexus-due?
                  (< frame 4032)
                  (< minerals 525)
                  (not protoss-anti-dt-or-prism-obs1-urgent?)
                  (memq nsym '(robotics-facility stargate)))
             (and (eq? nsym 'forge)
                  (not enemy-cloaked-threat-active?)
                  (not requires-detection?)
                  (not eff-req-det?)))))
  ;; L36-P0-2 (`#840`, `#5138233` TvP 14 Widow Mines + `#5138231` Factory #2@175s -> Starport@342s):
  ;; 1. Hard-cap TvP Widow Mines at <= 2 early (< 5:00 [6720f] or < 3 bases) and <= 3 midgame.
  ;; 2. Block TvP Factory #2+ until Starport #1 AND Natural CC (>= 2 CCs) are started (unless >= 600M & >= 300G).
  (define terran-tvp-widow-mine-cap
    (if (or (< frame 6720) (< active-bases 3)) 2 3))
  (define terran-tvp-widow-mine-capped?
    (and (eq? race 'Terran)
         (eq? enemy-race 'Protoss)
         (>= (unit-count-equivalent unit-counts 'widow-mine) terran-tvp-widow-mine-cap)))
  (define terran-tvp-block-2nd-factory?
    (and (eq? race 'Terran)
         (eq? enemy-race 'Protoss)
         (>= (bldg-count-equivalent total-bldg-counts 'factory) 1)
         (or (= (bldg-count-equivalent total-bldg-counts 'starport) 0)
             (< total-townhalls-incl-pending 2))
         (not (and (>= minerals 600) (>= gas 300)))))
  ;; L41-P0-2b (`#62 TvT0Tank` 4 Factories @156s w/ 0 TechLabs until 319s):
  ;; Force FactoryTechLab #1 strictly BEFORE building Factories #2-#4 (unless >= 600M & >= 300G
  ;; or active early ground-rush Hellion survival)!
  (define terran-block-extra-factory-before-techlab1?
    (and (eq? race 'Terran)
         (>= (bldg-count-equivalent total-bldg-counts 'factory) 1)
         (= (bldg-count-equivalent total-bldg-counts 'factory-techlab) 0)
         (not terran-early-ground-rush-survival-due?)
         (not (and (>= minerals 600) (>= gas 300)))))
  (define terran-2nd-factory-due?
    (and (eq? race 'Terran)
         (not terran-maxed-suppress-extra-prod?)
         (not terran-tvp-block-2nd-factory?)
         (not terran-block-extra-factory-before-techlab1?)
         (not terran-early-tvt-mass-reaper-defer-tech?)
         (not terran-cloak-pre-turret1-defer-starport-tank?)
         (>= desired-factories 2)
         (= (bldg-count-equivalent total-bldg-counts 'factory) 1)
         (> (bldg-count-equivalent ready-bldg-counts 'factory-techlab) 0)
         ;; Never steal minerals/gas from Factory #1 before Tank #1 (unless >=2 enemy Tanks or 300M/225G)!
         (or (not (hash? open-facility-slots))
             (<= (hash-ref open-facility-slots 'factory 0) 0)
             (and (or (eq? enemy-race 'Terran) (>= enemy-siege-tank-cnt 2))
                  (or (>= (unit-count-equivalent unit-counts 'siege-tank) 1)
                      (>= enemy-siege-tank-cnt 2)))
             (and (>= minerals 300) (>= gas 225)))
         (>= gas (if (or (eq? enemy-race 'Terran) (>= enemy-siege-tank-cnt 2)) 100 150))
         (or (not (eq? enemy-race 'Terran))
             (>= minerals 100))
         (not under-early-rush-crisis?)
         (not terran-early-rush-hold?)
         (not early-ling-rush-defense-active?)
         (not early-proxy-marauder-rush-active?)
         (not terran-cloaked-det-crisis?)
         (not enemy-cap-air?)
         (not enemy-air-dominated-now?)))
  ;; L29-P0-2 (`#17/#47 TvT0Tank`): Guarantee TvT Factory #1/#2 TechLab (`u = 890, blk = #t`
  ;; strictly above Starport/SiegeTank/SCV!) and block Hellion/WidowMine from stealing bare Factory
  ;; slots or gas until >= 2 Siege Tanks are built!
  (define terran-tvt-factl-target
    (if (and (eq? race 'Terran)
             (or (eq? enemy-race 'Terran) (>= enemy-siege-tank-cnt 2)))
        (min 3 (max desired-factories (bldg-count-equivalent ready-bldg-counts 'factory)))
        desired-factories))
  ;; L59-P2 (`#5143672 Blinkstep` 51 Blink Stalkers vs bare Factory 8 Hellions + 5 WMs + 0 Tanks):
  ;; In TvP against >= 4 Stalkers (or >= 2 Stalkers + Twilight), attach FactoryTechLab immediately
  ;; and train Siege Tanks (< 3) instead of bare-Factory Hellion/WidowMine spam!
  (define terran-tvp-anti-stalker-tank-due?
    (and (eq? race 'Terran)
         (eq? enemy-race 'Protoss)
         (or (>= (unit-count-equivalent enemy-u-counts 'stalker) 4)
             (and (>= (unit-count-equivalent enemy-u-counts 'stalker) 2)
                  (> (bldg-count-equivalent enemy-b-counts 'twilight-council) 0)))
         (not early-worker-rush-active?)
         (not terran-confirmed-cloak-turret-lock?)
         (not enemy-air-dominated-now?)))
  (define terran-tvp-anti-stalker-tank-train-due?
    (and terran-tvp-anti-stalker-tank-due?
         (> (bldg-count-equivalent ready-bldg-counts 'factory-techlab) 0)
         (or (not (hash? open-facility-slots)) (> (hash-ref open-facility-slots 'factory 0) 0))
         (< (unit-count-equivalent unit-counts 'siege-tank) 3)
         (not (and (> (bldg-count-equivalent ready-bldg-counts 'starport) 0)
                   (< (unit-count-equivalent unit-counts 'medivac) 2)
                   (>= (+ (unit-count-equivalent unit-counts 'marine)
                          (unit-count-equivalent unit-counts 'marauder))
                       6)
                   (< minerals 150)))
         (not supply-preempt-now?)))
  (define terran-factory-techlab-due?
    (and (eq? race 'Terran)
         (not terran-early-tvt-mass-reaper-defer-tech?)
         (> (bldg-count-equivalent ready-bldg-counts 'factory) 0)
         (< (bldg-count-equivalent total-bldg-counts 'factory-techlab)
            (min terran-tvt-factl-target (bldg-count-equivalent ready-bldg-counts 'factory)))
         (not (facility-addon-slot-occupied? 'factory-techlab ready-bldg-counts total-bldg-counts #:min-ready-floor 1))
         (or early-proxy-marauder-rush-active?
             (and terran-tvp-anti-stalker-tank-due? (>= workers 16))
             ;; L52-1C (`#77 TvT VeTerran`): Attach FactoryTechLab #1 immediately upon Factory #1 completion in TvT!
             (and (eq? enemy-race 'Terran)
                  (= (bldg-count-equivalent total-bldg-counts 'factory-techlab) 0)
                  (not early-worker-rush-active?)
                  (not terran-early-ground-rush-survival-due?))
             (and (or (eq? enemy-race 'Terran) (>= workers 22))
                  (not under-early-rush-crisis?)
                  (not terran-early-rush-hold?)))))
  (define terran-tvt-factl-priority-due?
    (and terran-factory-techlab-due?
         (eq? enemy-race 'Terran)
         (not enemy-air-dominated-now?)
         (not terran-early-ground-rush-survival-due?)
         (not terran-early-tvt-mass-reaper-defer-tech?)
         (not early-proxy-marauder-rush-active?)
         (or (and (not under-attack?)
                  (<= enemy-threat-supply army-supply))
             (and (= (bldg-count-equivalent total-bldg-counts 'factory-techlab) 0)
                  (not terran-1base-nat-cc-lock?)
                  (not early-worker-rush-active?)
                  (>= gas 25)))))
  ;; L38-P0-2 (`#889`, Loop 37 `#65 TvZ Clicadinha` `BarracksTechLab:4` before `FactoryTechLab #1`):
  ;; Across TvZ/TvP, once Factory #1 is ready and `factory-techlab == 0`, prioritize `factory-techlab #1`
  ;; (`u = 795.0` when `barracks-techlab >= 1`, `615.0` when `0`, `blk = #t` at `gas >= 25`) and defer
  ;; `barracks-techlab #2+` (`<= 520.0, blk = #f`) so Siege Tank #1 is never delayed 283s -> 387s!
  (define terran-first-factl-priority-due?
    (and terran-factory-techlab-due?
         (= (bldg-count-equivalent total-bldg-counts 'factory-techlab) 0)
         (not terran-tvt-factl-priority-due?)
         (not terran-1base-nat-cc-lock?)
         (not terran-early-ground-rush-survival-due?)
         (not terran-cloaked-det-crisis?)
         (not terran-confirmed-cloak-turret-lock?)
         (not enemy-air-dominated-now?)
         (not supply-preempt-now?)
         (>= gas 25)))
  (define (terran-defer-extra-rax-tl-for-factl1? nsym)
    (and (or terran-first-factl-priority-due? terran-tvt-factl-priority-due?)
         (eq? nsym 'barracks-techlab)
         (>= (bldg-count-equivalent total-bldg-counts 'barracks-techlab) 1)))
  ;; L52-1C (`#1280`/`#1281` `#77 TvT VeTerran`): Block `widow-mine` pre-TechLab and while `siege-tank < 4`
  ;; in TvT, and defer `hellion` on Tech-Lab Factory while `siege-tank < 4` (outside early Reaper/ground rush)!
  (define terran-tvt-block-widow-mine?
    (and (eq? race 'Terran)
         (or (and (eq? enemy-race 'Terran)
                  (or (= (bldg-count-equivalent total-bldg-counts 'factory-techlab) 0)
                      terran-factory-techlab-due?
                      (< (unit-count-equivalent unit-counts 'siege-tank) 4)))
             (and terran-tvp-anti-stalker-tank-due?
                  (or (= (bldg-count-equivalent total-bldg-counts 'factory-techlab) 0)
                      (< (unit-count-equivalent unit-counts 'siege-tank) 3))))))
  (define terran-tvt-no-hellion-wm?
    (and (eq? race 'Terran)
         (or (and (not terran-early-ground-rush-survival-due?)
                  (or (and (eq? enemy-race 'Terran)
                           (or terran-factory-techlab-due?
                               (< (unit-count-equivalent unit-counts 'siege-tank) 4)))
                      (and terran-tvp-anti-stalker-tank-due?
                           (or (= (bldg-count-equivalent total-bldg-counts 'factory-techlab) 0)
                               (< (unit-count-equivalent unit-counts 'siege-tank) 3)))
                      (and terran-factory-techlab-due?
                           (<= (bldg-count-equivalent ready-bldg-counts 'factory) 1)
                           (< (unit-count-equivalent enemy-u-counts 'zergling) 16))))
             ;; L44-P0-2b (`#62 SmoothBrain` TvT0Tank): Strictly block Hellion #2+ before FactoryTechLab #1
             ;; in TvT unless >= 3 enemy Reapers are present!
             (and (eq? enemy-race 'Terran)
                  (= (bldg-count-equivalent total-bldg-counts 'factory-techlab) 0)
                  (>= (unit-count-equivalent unit-counts 'hellion) 1)
                  (< enemy-reaper-cnt 3)))))
  ;; L52-1C P1 (`#1280`/`#1281`): Research `interference-matrix` (`807`, `50M/50G`) at ready
  ;; `starport-techlab` once `raven >= 1` so live Terran Ravens unlock Interference Matrix (`3747`)!
  (define terran-interference-matrix-due?
    (and (eq? race 'Terran)
         (>= (unit-count-equivalent unit-counts 'raven) 1)
         (> (bldg-count-equivalent ready-bldg-counts 'starport-techlab) 0)
         (or (not (hash? open-facility-slots))
             (> (hash-ref open-facility-slots 'starport-techlab 0) 0))
         (not (step-already-satisfied? 'interference-matrix))
         (not supply-preempt-now?)
         (not zero-townhall-rebuild-due?)
         (not early-worker-rush-active?)
         (not terran-early-ground-rush-survival-due?)
         (>= gas 50)))
  (define terran-siege-tank-core-due?
    (and (eq? race 'Terran)
         (not terran-early-ground-rush-survival-due?)
         (not enemy-air-dominated-now?)
         (> (bldg-count-equivalent ready-bldg-counts 'factory-techlab) 0)
         (or early-proxy-marauder-rush-active?
             (not terran-early-rush-hold?))
         ;; Preserve #5122349 Medivac #1 priority for Bio in TvP/TvZ (>=6 bio, open ready Starport, 0 Medivacs, <225G),
         ;; NEVER starving TvT core Siege Tanks (<4) or firing when Starport slot is busy!
         (not (and (not early-proxy-marauder-rush-active?)
                   (not (and (eq? enemy-race 'Terran)
                             (< (unit-count-equivalent unit-counts 'siege-tank) 4)))
                   (> (bldg-count-equivalent ready-bldg-counts 'starport) 0)
                   (or (not (hash? open-facility-slots))
                       (> open-starport-slots 0))
                   (= (unit-count-equivalent unit-counts 'medivac) 0)
                   (>= (+ (unit-count-equivalent unit-counts 'marine)
                          (unit-count-equivalent unit-counts 'marauder)) 6)
                   (< gas 225)))
         (< (unit-count-equivalent unit-counts 'siege-tank) (if (>= active-bases 2) 8 3))))
  ;; W16-P1-1a (`#5136362`) + L29-P0-2 (`#24 Pvonlyfans 4.95x 30m Tie`):
  ;; Cap anti-air-only Phoenix (`<= 8` unless enemy air `>= 12`, and `<= 6` whenever `< 10` ground-hitting
  ;; combat supply or `>= 9:00` [`frame >= 12096`] with `>= 800M` banked), and pivot to ground/building-killing
  ;; finishers (`tempest`/`void-ray`/`immortal`/`stalker`/`zealot`) so air dominance converts into clean wins!
  (define protoss-phoenix-cnt
    (if (eq? race 'Protoss)
        (unit-count-equivalent unit-counts 'phoenix)
        0))
  (define protoss-ground-hitting-combat-supply
    (if (eq? race 'Protoss)
        (+ (* 2 (unit-count-equivalent unit-counts 'zealot))
           (* 2 (unit-count-equivalent unit-counts 'stalker))
           (* 2 (unit-count-equivalent unit-counts 'adept))
           (* 2 (unit-count-equivalent unit-counts 'sentry))
           (* 2 (unit-count-equivalent unit-counts 'dark-templar))
           (* 2 (unit-count-equivalent unit-counts 'high-templar))
           (* 4 (unit-count-equivalent unit-counts 'immortal))
           (* 4 (unit-count-equivalent unit-counts 'archon))
           (* 4 (unit-count-equivalent unit-counts 'void-ray))
           (* 3 (unit-count-equivalent unit-counts 'oracle))
           (* 6 (unit-count-equivalent unit-counts 'carrier))
           (* 5 (unit-count-equivalent unit-counts 'tempest))
           (* 6 (unit-count-equivalent unit-counts 'colossus))
           (* 3 (unit-count-equivalent unit-counts 'disruptor)))
        0))
  (define protoss-phoenix-closure-needed?
    (and (eq? race 'Protoss)
         (>= protoss-phoenix-cnt 6)
         (or (< protoss-ground-hitting-combat-supply 10)
             (and (>= frame 12096) (>= minerals 800)))))
  ;; L43-P0-2b (Live `#5138711 PrismForge` PvP `9` Phoenixes into `57` Stalkers):
  ;; Cap Phoenix <= 2 when enemy has >= 15 Stalkers and 0 Stargate air, funneling gas into Immortals + Charge + 8 Gateways!
  (define protoss-pvp-mass-stalker-no-air?
    (and (eq? race 'Protoss)
         (eq? enemy-race 'Protoss)
         (>= (unit-count-equivalent enemy-u-counts 'stalker) 15)
         (= enemy-air-combat-cnt 0)
         (= (bldg-count-equivalent enemy-b-counts 'stargate) 0)
         (= (bldg-count-equivalent enemy-b-counts 'fleet-beacon) 0)))
  ;; L48-P0-2a (Live `#5138327`/`#5138328` `Phoenix:16..22` vs Tempests + Local `#82`/`#57` `Phoenix:12`):
  ;; - Cap Phoenix <= 0 against ANY capital air (`enemy-cap-air?` / `protoss-anti-tempest-pvp-due?` / Tempest / Carrier / BC / Mothership);
  ;; - Cap Phoenix <= 4 in PvT Bio / non-BC when `0` Banshees & `enemy-ground-combat-supply >= 10`!
  (define protoss-phoenix-cap
    (cond
      [(or enemy-heavy-cap-air?
           enemy-cap-air?
           (> (+ (unit-count-equivalent enemy-u-counts 'tempest)
                 (unit-count-equivalent enemy-u-counts 'carrier)
                 (unit-count-equivalent enemy-u-counts 'battlecruiser)
                 (unit-count-equivalent enemy-u-counts 'mothership)
                 (bldg-count-equivalent enemy-b-counts 'fleet-beacon))
              0))
       0]
      [protoss-pvp-mass-stalker-no-air? 2]
      [(and (eq? enemy-race 'Terran)
            (= enemy-banshee-cnt 0)
            (>= enemy-ground-combat-supply 10))
       4]
      [protoss-phoenix-closure-needed? 6]
      [(>= enemy-air-combat-cnt 12) 12]
      [else 8]))
  (define protoss-phoenix-capped?
    (and (eq? race 'Protoss)
         (>= protoss-phoenix-cnt protoss-phoenix-cap)))
  (define (protoss-phoenix-closure-finisher-u nsym)
    (and protoss-phoenix-closure-needed?
         (case nsym
           [(tempest)
            (and (> (bldg-count-equivalent ready-bldg-counts 'stargate) 0)
                 (> (bldg-count-equivalent ready-bldg-counts 'fleet-beacon) 0)
                 (or (not (hash? open-facility-slots)) (> open-stargate-slots 0))
                 910.0)]
           [(void-ray)
            (and (> (bldg-count-equivalent ready-bldg-counts 'stargate) 0)
                 (or (not (hash? open-facility-slots)) (> open-stargate-slots 0))
                 900.0)]
           [(immortal)
            (and (> (bldg-count-equivalent ready-bldg-counts 'robotics-facility) 0)
                 (or (not (hash? open-facility-slots)) (> open-robo-slots 0))
                 890.0)]
           [(stalker)
            (and (> (bldg-count-equivalent ready-bldg-counts 'cybernetics-core) 0)
                 (or (not (hash? open-facility-slots)) (> open-gw-slots-live 0))
                 880.0)]
           [(zealot)
            (and (> ready-protoss-gateways 0)
                 (or (not (hash? open-facility-slots)) (> open-gw-slots-live 0))
                 850.0)]
           [else #f])))
  ;; L51-1C (`#18 RustyNikolaj` 11 Siege Tanks + 29 Vikings -> 0 Immortals!):
  ;; RoboticsFacility cannot build AA Stalkers/Phoenixes; once we have >= 6 Stalkers (and >= 1 Observer in PvT)
  ;; facing >= 2 Siege Tanks without heavy Capital Air, keep Robo training Immortals (< 4)!
  (define protoss-heavy-armored-ground-immortal-needed?
    (and (eq? race 'Protoss)
         (not enemy-heavy-cap-air?)
         (> (bldg-count-equivalent ready-bldg-counts 'robotics-facility) 0)
         (or (not (hash? open-facility-slots)) (> open-robo-slots 0))
         (>= (+ (unit-count-equivalent enemy-u-counts 'siege-tank)
                (unit-count-equivalent enemy-u-counts 'siege-tank-sieged))
             2)
         (>= (unit-count-equivalent unit-counts 'stalker) 6)
         (or (not (eq? enemy-race 'Terran))
             (>= (unit-count-equivalent unit-counts 'observer) 1))
         (< (unit-count-equivalent unit-counts 'immortal) 4)))
  ;; W9-P0-3-belief + W10-P0-3-belief: Continuous Protoss midgame Robo/Templar/Gateway production (ArmyVal@8m -> 2,200+)
  (define protoss-robo-immortal-due?
    (and (eq? race 'Protoss)
         (not protoss-anti-dt-or-prism-obs1-urgent?)
         (> (bldg-count-equivalent ready-bldg-counts 'robotics-facility) 0)
         (or (not (hash? open-facility-slots)) (> open-robo-slots 0))
         (or protoss-phoenix-closure-needed?
             protoss-heavy-armored-ground-immortal-needed?
             (and (not enemy-air-dominant?)
                  (not protoss-cloaked-air-crisis?)))
         (or protoss-phoenix-closure-needed?
             protoss-heavy-armored-ground-immortal-needed?
             (eq? enemy-race 'Protoss)
             (> (+ (unit-count-equivalent enemy-u-counts 'stalker)
                   (unit-count-equivalent enemy-u-counts 'immortal)
                   (unit-count-equivalent enemy-u-counts 'roach)
                   (unit-count-equivalent enemy-u-counts 'marauder)
                   (unit-count-equivalent enemy-u-counts 'siege-tank)) 0)
             (< (unit-count-equivalent unit-counts 'immortal) 3))
         (< (unit-count-equivalent unit-counts 'immortal) (if (>= active-bases 3) 8 5))))
  ;; L36-P0-2 (`#840`, `#5138232`) + L38-P0-2 (`#5138250` PvZ continuous Immortals):
  ;; Keep PvZ Robotics Facility & ranged Stalkers continuously active so Protoss never faces
  ;; Roach-Ling with an idle Robo (escrow Immortal from 175M/100G, target 4..6 on >=2 bases/Roaches)!
  ;; L43-P0-2b (`Clicadinha P` Roach:31 & Live `#5140050 sludgement2`):
  ;; On >= 6 enemy Roaches/Ravagers scouted in PvZ, lock RoboticsFacility #1 & Immortal floor >= 4
  ;; (`u = 665.0, blk = #t`, from >= 50G or gas income) strictly ahead of TwilightCouncil, extra Zealots (>= 2),
  ;; repeat ShieldBattery spam, Forge, Stalker gas drain, and 3rd Nexus!
  (define protoss-pvz-mass-roach-immortal-lock?
    (and (eq? race 'Protoss)
