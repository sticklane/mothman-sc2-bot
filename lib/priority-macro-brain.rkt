                  (not (memq rid '(hellion marine bunker)))))))
    ;; Supply candidate ignores non-supply floors (PV4); gas-blocked escrow never blocks 0-gas extractors
    ;; OR 0-gas combat-units/workers (e.g. SiegeTank gas-escrow at 55G must never starve Marine/SCV #29!),
    ;; except Terran 1-1-1 Factory/Starport/TvT-Tank/TvT-FactoryTechLab milestones and active emergency cloak detectors!
    (define app-min-floor
      (cond
        [(and zero-townhall-rebuild-due?
              reserved-cand
              (eq? (normalize-brain-sym (priority-candidate-id reserved-cand)) race-expand-sym))
         min-floor]
        [(eq? cat 'supply) 0]
        [worker-rush-anti-deadlock-probe? 0]
        [early-worker-rush-defense-ignores-escrow? 0]
        [(and wd-worker-plateau-boost?
              (eq? cat 'worker)
              reserved-cand
              (not (memq (priority-candidate-category reserved-cand) '(supply expansion))))
         0]
        [(and wd-idle-bank-flush-now?
              (memq cat '(combat-unit worker))
              (not (and early-worker-rush-pause-workers? (eq? cat 'worker)))
              reserved-cand
              (not (memq (priority-candidate-category reserved-cand) '(supply expansion)))
              (not (memq (normalize-brain-sym (priority-candidate-id reserved-cand))
                         '(hatchery nexus command-center))))
         0]
        [pt-worker-ignores-non-nat-escrow? 0]
        [(and reserved-gas-blocked?
              (memq csym '(extractor refinery assimilator))
              (not (terran-defer-for-111-sym? csym))
              (not (and (eq? race 'Protoss)
                        (eq? csym 'assimilator)
                        (or (and (eq? (normalize-brain-sym (priority-candidate-id reserved-cand)) 'robotics-bay)
                                 protoss-midgame-robo-bay-due?
                                 (>= gas 100))
                            (and (eq? (normalize-brain-sym (priority-candidate-id reserved-cand)) 'colossus)
                                 protoss-colossus-core2-due?
                                 (>= gas 100)))))
              (not (and (eq? race 'Zerg)
                        (eq? csym 'extractor)
                        (eq? (normalize-brain-sym (priority-candidate-id reserved-cand)) 'spire)
                        zerg-cap-air-spire-due?
                        (>= gas 140)
                        (< rem-min 225)))
              (not (and (eq? race 'Terran)
                        (eq? csym 'refinery)
                        (>= (bldg-count-equivalent total-bldg-counts 'refinery) 2)
                        (eq? (normalize-brain-sym (priority-candidate-id reserved-cand)) 'siege-tank)
                        (or terran-111-tvt-tank-due? terran-tvt-tank4-lock-due?)
                        (>= gas 75)))
              (< gas (priority-candidate-gas-cost reserved-cand)))
         0]
        [(and reserved-gas-blocked?
              (= (priority-candidate-gas-cost c) 0)
              (or (memq cat '(combat-unit worker))
                  (and (eq? race 'Terran)
                       (eq? csym 'barracks)
                       (eq? (normalize-brain-sym (priority-candidate-id reserved-cand)) 'siege-tank)
                       terran-tvt-tank4-lock-due?
                       (>= (unit-count-equivalent unit-counts 'siege-tank) 2)
                       (< (bldg-count-equivalent total-bldg-counts 'barracks) (if (>= active-bases 2) 4 2))))
              (let ([rid (normalize-brain-sym (priority-candidate-id reserved-cand))])
                (and (not (emergency-cloak-det-boost-info rid))
                     (not (and (eq? race 'Terran) (eq? rid 'factory)))
                     (not (and (eq? race 'Terran)
                               (eq? rid 'factory-techlab)
                               terran-tvt-factl-priority-due?))
                     (not (and (eq? race 'Terran)
                               (eq? rid 'siege-tank)
                               (or terran-111-tvt-tank-due?
                                   (and terran-tvt-tank4-lock-due?
                                        (< (unit-count-equivalent unit-counts 'siege-tank) 2)
                                        (>= gas 100))
                                   (and terran-core-tank-floor-due? (>= gas 100)))
                               (or (eq? cat 'worker)
                                   (and (not under-attack?)
                                        (>= army-supply (if (eq? enemy-race 'Terran) 12 4))))))
                     (not (and (eq? race 'Terran)
                               (eq? rid 'viking-fighter)
                               terran-det-viking-due?
                               terran-enemy-banshee-starport-tl?
                               (< (unit-count-equivalent unit-counts 'viking-fighter) 4)
                               (>= gas 25)))
                     (not (and (eq? race 'Terran)
                               (eq? cat 'worker)
                               (>= minerals 100)
                               (and (eq? rid 'starport) terran-111-starport-due?)))
                     ;; L39-P0-2c + L42-P0-2c (`#04 PvT`, `#05 PvZ`): Never let 0-gas Zealot warp-ins (or >=34W Probes at >=100G)
                     ;; bypass RoboticsBay or core Colossus #1-#2 mineral escrow while waiting on gas!
                     (not (and (eq? race 'Protoss)
                               (or (and (eq? csym 'zealot)
                                        (or (and (eq? rid 'colossus) protoss-colossus-core2-due?)
                                            (and (eq? rid 'robotics-bay) protoss-midgame-robo-bay-due?)))
                                   (and (eq? cat 'worker)
                                        (eq? rid 'colossus)
                                        protoss-colossus-core2-due?
                                        (>= workers 34)
                                        (>= gas 100)))))
                     ;; L40-P0-2a (`#75 PvT who` 10 Banshees@209s): Never let 0-gas Probe (>=20W) or Zealot
                     ;; bypass urgent anti-air Stalker mineral escrow while gas ticks 25..49G!
                     (not (and (eq? race 'Protoss)
                               (eq? rid 'stalker)
                               protoss-urgent-aa-reaper-stalker-due?
                               (or (not (eq? cat 'worker)) (>= workers 20))))
                     ;; L40-P0-2b (`#31 ZvP` Tempest:13): Never let 0-gas Drone/Zergling drain bank below
                     ;; Spire's 200M cost while gas is >=140G waiting on Spire!
                     (not (and (eq? race 'Zerg)
                               (eq? rid 'spire)
                               zerg-cap-air-spire-due?
                               (>= gas 140)
                               (< rem-min 250))))))
         0]
        [protoss-aa-stalker-ignores-heavy-escrow? 0]
        [terran-early-marine-ignores-macro-escrow? 0]
        [terran-marine-scv-ignores-cc-escrow? 0]
        [terran-bio-scv-ignores-air-escrow? 0]
        [protoss-probe-or-immortal-ignores-stalker-escrow? 0]
        [protoss-defending-stalker-ignores-immortal-escrow? 0]
        [zerg-zero-gas-ignores-corruptor-escrow? 0]
        [zerg-overseer1-ignores-corruptor-escrow? 0]
        [zerg-roach-ignores-hydra-escrow? 0]
        [zerg-combat-ignores-lair-spore-escrow? 0]
        [zerg-excess-gas-dump-ignores-escrow? 0]
        [zerg-midgame-combat-ignores-hive-hatch4-escrow? 0]
        [zerg-anti-tank-morph-ignores-nonspire-escrow? 0]
        [protoss-early-breach-zealot-ignores-escrow? 0]
        [terran-tvt-factl-ignores-starport-escrow? 0]
        [early-ling-rush-defense-ignores-escrow? 0]
        [terran-bio-ignores-factory-techlab-escrow? 0]
        [marauder-rush-defense-ignores-other-escrow? 0]
        [terran-rush-survival-ignores-other-escrow? 0]
        [terran-early-marine-ignores-factory-min-escrow? 0]
        [terran-early-scv-ignores-factory-min-escrow? 0]
        [(and high-bank-tech-unlock? (memq cat '(combat-unit worker))) 0]
        [(eq? cat 'worker) min-floor-for-worker]
        [else min-floor]))
    (define app-gas-floor
      (cond
        [(eq? cat 'supply) 0]
        [protoss-aa-stalker-ignores-heavy-escrow? 0]
        [(and terran-bio-scv-ignores-air-escrow?
              (or (not (or enemy-cap-air? enemy-air-dominated-now?)) (<= open-starport-slots 0) (>= gas 125)))
         0]
        [protoss-probe-or-immortal-ignores-stalker-escrow? 0]
        [protoss-defending-stalker-ignores-immortal-escrow? 0]
        [zerg-zero-gas-ignores-corruptor-escrow? 0]
        [zerg-overseer1-ignores-corruptor-escrow? 0]
        [zerg-roach-ignores-hydra-escrow? 0]
        [zerg-combat-ignores-lair-spore-escrow? 0]
        [zerg-excess-gas-dump-ignores-escrow? 0]
        [zerg-midgame-combat-ignores-hive-hatch4-escrow? 0]
        [zerg-anti-tank-morph-ignores-nonspire-escrow? 0]
        [protoss-early-breach-zealot-ignores-escrow? 0]
        [terran-tvt-factl-ignores-starport-escrow? 0]
        [early-ling-rush-defense-ignores-escrow? 0]
        [terran-bio-ignores-factory-techlab-escrow? 0]
        [marauder-rush-defense-ignores-other-escrow? 0]
        [terran-rush-survival-ignores-other-escrow? 0]
        [(and high-bank-tech-unlock? (>= gas 400) (memq cat '(combat-unit worker))) 0]
        [else gas-floor]))
    (define floor-min-ok? (>= (- rem-min m-cost) app-min-floor))
    (define floor-gas-ok?
      (or (= g-cost 0)
          (and (>= (- rem-gas g-cost) app-gas-floor)
               (not (and (terran-tvt-tank4-defer-air-sym? csym) (< rem-gas 200)))
               (not (and (protoss-colossus-core2-defer-sym? csym) (< rem-gas 200)))
               (not (and terran-enemy-banshee-starport-tl?
                         (terran-confirmed-cloak-defer-prod-sym? csym)
                         (< rem-gas 150)))
               (not (and (protoss-banshee-defer-non-aa-sym? csym) (< rem-gas 150))))))

    (cond
      [(and tech-cap-ok? unit-cap-ok? prereq-ok? slot-ok? worker-cap-ok? supply-ok? min-ok? gas-ok? floor-min-ok? floor-gas-ok?)
       (set! rem-min (- rem-min m-cost))
       (set! rem-gas (- rem-gas g-cost))
       (set! rem-sup (- rem-sup s-cost))
       (when (or (memq csym SC2-SINGLETON-TECH-BUILDINGS)
                 (memq csym SC2-DUAL-CAP-TECH-BUILDINGS)
                 (memq csym '(hatchery gateway robotics-facility stargate starport starport-reactor shield-battery spine-crawler bunker
                              photon-cannon missile-turret
                              extractor refinery assimilator barracks-techlab factory factory-techlab spore-crawler)))
         (hash-update! seen-tech-counts csym add1 0))
       (when (memq csym '(queen observer warp-prism phoenix raven zealot roach ravager cyclone hellion corruptor overseer overlord-transport sentry lurker baneling zergling ghost liberator thor widow-mine))
         (hash-update! seen-unit-counts csym add1 0))
       (when (memq pslot UNIT-MORPH-SOURCE-SLOTS)
         (hash-update! used-morph-slots pslot
                       (lambda (n) (+ n (if (eq? pslot 'high-templar) 2 1)))
                       0))
       (when (and rem-slots (not (eq? pslot 'worker)) (not (memq pslot UNIT-MORPH-SOURCE-SLOTS)))
         (hash-update! rem-slots pslot sub1 0))
       (set! scheduled-cands (cons c scheduled-cands))
       (set! decision-entries
             (cons (priority-decision-entry rank-idx id cat act m-cost g-cost s-cost
                                            u-score blk-ok? 'scheduled
                                            app-min-floor app-gas-floor #f)
                   decision-entries))
       ;; L31-P0-2 (`SupBlk 5.9% -> <=4.0%`, `#14/#18/#19/H2H#02`): Under active supply deficit
       ;; (sniped Depots/Pylons/Overlords), schedule concurrent replacement copies (`ceil((deficit+6)/8)`)
       ;; and escrow the next replacement copy if minerals fall short of the full concurrent replacement!
       (when (and (eq? cat 'supply)
                  emergency-supply-deficit-active?
                  (> emergency-supply-needed-now 1))
         (let loop ([extra-rem (- emergency-supply-needed-now 1)])
           (when (> extra-rem 0)
             (define extra-slot-ok?
               (cond
                 [(eq? pslot 'worker) (and (not zero-alive-workers?) (> workers 0))]
                 [(not rem-slots) #t]
                 [else (> (hash-ref rem-slots pslot 0) 0)]))
             (cond
               [(and extra-slot-ok? (>= rem-min m-cost) (>= rem-gas g-cost))
                (set! rem-min (- rem-min m-cost))
                (set! rem-gas (- rem-gas g-cost))
                (when (and rem-slots (not (eq? pslot 'worker)) (not (memq pslot UNIT-MORPH-SOURCE-SLOTS)))
                  (hash-update! rem-slots pslot sub1 0))
                (set! scheduled-cands (cons c scheduled-cands))
                (set! decision-entries
                      (cons (priority-decision-entry rank-idx id cat act m-cost g-cost s-cost
                                                     u-score blk-ok? 'scheduled
                                                     app-min-floor app-gas-floor #f)
                            decision-entries))
                (loop (sub1 extra-rem))]
               [(and extra-slot-ok? blk-ok? (not reserved-cand) (< rem-min m-cost))
                (set! min-floor (max min-floor m-cost))
                (set! min-floor-for-worker (max min-floor-for-worker m-cost))
                (when (eq? pslot 'worker)
                  (set! worker-build-escrowed? #t))
                (set! reserved-cand c)
                (set! escrowed-entries (cons (list u-score m-cost g-cost id cat) escrowed-entries))
                (set! decision-entries
                      (cons (priority-decision-entry rank-idx id cat act m-cost g-cost s-cost
                                                     u-score blk-ok? 'escrowed-saving
                                                     app-min-floor app-gas-floor #f)
                            decision-entries))]))))]
      [else
       ;; If candidate is ready (`prereq-ok?` and `slot-ok?`) and `blk-ok?` (income-feasible),
       ;; and waiting on minerals or gas (with sufficient supply), reserve mineral/gas/slot escrow!
       ;; When a gas-costing item is > 40G short on gas (even if `rem-min < m-cost`),
       ;; lock ONLY gas (`min-escrow-amt = 0`) so 0-gas production is never mineral-starved while waiting on gas.
       (define worker-slot-escrow-ok?
         (or (not (eq? pslot 'worker))
             (not worker-build-escrowed?)))
       (define high-bank-skip-tech-escrow?
         (and (>= minerals 460)
              (>= rem-sup 2)
              ;; Do not skip escrow when a gas-costing tech/upgrade actually needs gas below high gas bank,
              ;; or when Zerg Spire is actively waiting on gas against Capital Air!
              (not (and zerg-cap-air-spire-due? (eq? csym 'spire) (< rem-gas spire-gas)))
              (or (>= gas 400) (>= rem-gas g-cost))
              (memq cat '(tech-upgrade counter-tech production-scaling))
              (not (and node (eq? (sc2-tech-node-kind node) 'train)))))
       ;; L20-P0-2 (`EscrowLock 17 -> <=5`, `#20/#24`): Never hold escrow on static defense at >= 275M
       ;; (EXCEPT active emergency cloak detection!).
       (define static-def-skip-escrow?
         (and (memq csym '(bunker photon-cannon spore-crawler spine-crawler))
              (not (emergency-cloak-det-boost-info csym))
              (>= minerals 275)))
       (define rem-escrow-plausible?
         (or (not (and (eq? cat 'expansion)
                       (>= active-bases 2)
                       (not slice15-base-loss-expand-now?)
                       (not zerg-late-low-min-high-gas-3rd-hatch-due?)
                       (not protoss-3rd-nexus-oversat-urgent?)))
             (can-fund-within-frames?
              rem-min rem-gas m-cost g-cost
              mineral-harvesters gas-harvesters
              workers ready-bldg-counts race
              #:frames (if (or (and zerg-3rd-hatch-pro-due? zerg-3rd-hatch-rw-ready-or-early? (>= minerals 185))
                               terran-3rd-cc-due?
                               (and protoss-3rd-nexus-pro-due? (>= minerals 275))
                               protoss-3rd-nexus-oversat-urgent?
                               step-post-t3-tech-expand-due?)
                           320
                           120))))
       ;; W4-P0-1c + L53-1C (`#39 norman` `ESCROW_LOCKOUT: immortal, 455M/92G`):
       ;; Never hold a blocking Immortal escrow when workers < 16, Robo not ready, OR under active
       ;; base attack / heavy threat (`> 1.3 * army`) with open Gateway slots, `minerals >= 275`, and `gas >= 50`!
       (define unbuildable-immortal-escrow?
         (and (eq? csym 'immortal)
              (or (< workers 16)
                  (= (bldg-count-equivalent ready-bldg-counts 'robotics-facility) 0)
                  (and (or under-attack?
                           (> enemy-threat-supply (* 1.3 army-supply)))
                       (or (not (hash? open-facility-slots))
                           (> open-gw-slots-live 0))
                       (>= minerals 275)
                       (>= gas 50)))))
       ;; W5-P0-4-belief: When top reserved-cand is pure-gas-starved? (or gas-blocked under threat / low army),
       ;; never let a lower-priority 400M expansion stack a 400M mineral floor behind it (`gas_starved_min_lockout`).
       (define skip-exp-behind-gas-starved?
         (and (eq? cat 'expansion)
              (not protoss-3rd-nexus-oversat-urgent?)
              (or (and reserved-pure-gas-starved?
                       (or under-attack? (< army-supply 20) (>= active-bases 2)))
                  (and reserved-gas-blocked?
                       (or under-attack? (< army-supply 20))))))
       (define escrowed-now? #f)
       (when (and tech-cap-ok? unit-cap-ok? prereq-ok? slot-ok? worker-slot-escrow-ok? blk-ok? supply-ok?
                  rem-escrow-plausible?
                  (not unbuildable-immortal-escrow?)
                  (not skip-exp-behind-gas-starved?)
                  (not high-bank-skip-tech-escrow?)
                  (not static-def-skip-escrow?)
                  (or (< rem-min m-cost) (< rem-gas g-cost)))
         ;; W2-P1-1a + W5-P0-4-belief + W8-P0-3-belief (#29): Whenever a gas-costing item lacks gas AND
         ;; either has no gas income, is >= 30G short on gas, OR already has >= m-cost + 150M banked,
         ;; lock gas-floor ONLY (`min-escrow-amt = 0`) so 0-gas production/CCs never mineral-lock!
         (define pure-gas-starved?
           (and (> g-cost 0)
                (< rem-gas g-cost)
                (not (and has-gas-income?
                          (or (and (eq? csym 'colossus) protoss-colossus-core2-due? (>= rem-gas 100))
                              (and (eq? csym 'siege-tank)
                                   terran-tvt-tank4-lock-due?
                                   (< (unit-count-equivalent unit-counts 'siege-tank) 2)
                                   (>= rem-gas 95))
                              (and (eq? csym 'viking-fighter) terran-det-viking-due? terran-enemy-banshee-starport-tl? (>= rem-gas 25))
                              (and (eq? csym 'robotics-bay) protoss-midgame-robo-bay-due? (>= rem-gas 125))
                              (and (eq? csym 'spire) zerg-cap-air-spire-due? (>= rem-gas (max 100 (- spire-gas 60))))
                              (and (eq? csym 'lair) zerg-air-lair-remorph-due? (>= rem-gas 60))
                              (and (eq? csym 'stalker) protoss-urgent-aa-reaper-stalker-due?
                                   (or (>= rem-gas 25)
                                       (and protoss-confirmed-banshee-or-sptl? (>= rem-gas 10)))))))
                (or (not has-gas-income?)
                    (<= rem-gas (- g-cost 30))
                    (and (eq? csym 'corruptor) (>= minerals 350))
                    (>= rem-min (+ m-cost 150)))))
         (define min-escrow-amt (if pure-gas-starved? 0 m-cost))
         (set! min-floor (max min-floor min-escrow-amt))
         (unless pure-gas-starved?
           (set! min-floor-for-worker (max min-floor-for-worker min-escrow-amt)))
         (when (> g-cost 0)
           (set! gas-floor (max gas-floor g-cost)))
         (when (and (eq? pslot 'worker) (> min-escrow-amt 0))
           (set! worker-build-escrowed? #t))
         (when (and pslot (not pure-gas-starved?) (not (memq pslot '(worker larva townhall))))
           (set! reserved-slots (cons pslot reserved-slots)))
         (set! escrowed-now? #t)
         (set! escrowed-entries (cons (list u-score min-escrow-amt g-cost id cat) escrowed-entries))
         (unless reserved-cand
           (set! reserved-cand c)
           (when pure-gas-starved?
             (set! reserved-pure-gas-starved? #t))
           (when (and (> g-cost 0) (< rem-gas g-cost))
             (set! reserved-gas-blocked? #t))))

       (define outcome-sym
         (cond
           [escrowed-now? 'escrowed-saving]
           [(not prereq-ok?) 'prerequisite-unmet]
           [(not slot-ok?) 'facility-busy]
           [(not supply-ok?) 'insufficient-supply]
           [(and min-ok? gas-ok? (or (not floor-min-ok?) (not floor-gas-ok?))) 'blocked-by-escrow]
           [else 'insufficient-resources]))
       (define blocked-by-id
         (and (eq? outcome-sym 'blocked-by-escrow)
              reserved-cand
              (priority-candidate-id reserved-cand)))
       (set! decision-entries
             (cons (priority-decision-entry rank-idx id cat act m-cost g-cost s-cost
                                            u-score blk-ok? outcome-sym
                                            app-min-floor app-gas-floor blocked-by-id)
                   decision-entries))]))

  ;; High-bank deadlock guard (L20-P0-2: lower non-expansion/non-supply floor release 600M -> 460M!)
  (define high-bank-release?
    (or (high-bank-unlock-allowed? minerals 600 supply-left reserved-cand)
        (and (high-bank-unlock-allowed? minerals 460 supply-left reserved-cand)
             (or (not reserved-cand)
                 (not (eq? (priority-candidate-category reserved-cand) 'expansion))))))
  (when high-bank-release?
    (set! min-floor 0)
    (when (>= gas 400)
      (set! gas-floor 0)))
  ;; L39-P0-2d (`#31/#58 ZvP` 14-29 Tempests): Protect Spire (200G) / Corruptor (100G) gas floor
  ;; even on 0-Larva frames so downstream L2 never drains gas on ground units/upgrades!
  (when (and zerg-cap-air-corruptor-gas-guard?
             (not supply-preempt-now?)
             (< gas (if zerg-cap-air-spire-due? spire-gas 100)))
    (set! gas-floor (max gas-floor (if zerg-cap-air-spire-due? spire-gas 100))))
  ;; L54-1B (`#58` `corruptor` escrow un-locker): keep `min-floor = 0` when `corruptor` waits on `< 100G` with `>= 350M`!
  (when (and reserved-cand
             (eq? (normalize-brain-sym (priority-candidate-id reserved-cand)) 'corruptor)
             (< gas 100)
             (>= minerals 350))
    (set! min-floor 0))
  ;; L40-P0-2a + L55-M3 (`#25 ZvT` 15 Banshees): Protect 100G floor until HydraDen is ready,
  ;; dropping to 50G once `(ready 'hydralisk-den) > 0` so Hydralisks (`100M/50G`) train immediately!
  (when (and zerg-banshee-aa-gas-protect?
             (not supply-preempt-now?))
    (define banshee-gas-floor
      (if (> (bldg-count-equivalent ready-bldg-counts 'hydralisk-den) 0) 50 100))
    (when (< gas banshee-gas-floor)
      (set! gas-floor (max gas-floor banshee-gas-floor))))
  ;; L41-P0-2a (`#04 PvT` Sole H2H Loss): Protect 150G floor for RoboticsBay on 2-base PvT once army >= 16 & >= 1 Immortal!
  (when (and protoss-midgame-robo-bay-due?
             protoss-pvt-robo-bay-gas-reserve-due?
             (not supply-preempt-now?)
             (< gas 150))
    (set! gas-floor (max gas-floor 150)))
  ;; L41-P0-2c (`#49/#73` Post-Lair-Loss): Protect 100G floor to immediately re-morph Lair vs Stargate/Tempest/VoidRay!
  (when (and zerg-air-lair-remorph-due?
             (not supply-preempt-now?)
             (< gas 100))
    (set! gas-floor (max gas-floor 100)))
  ;; L42-P0-2b (`TvT0Tank 4 -> 0`): Protect 125G floor for TvT Siege Tanks #1-#4 (unless >= 2 enemy combat air/Banshee)!
  (when (and terran-tvt-tank4-gas-lock?
             (< gas 125))
    (set! gas-floor (max gas-floor 125)))
  ;; L42-P0-2c (`H2H #04 PvT`): Protect 200G floor for core Colossi #1-#2 once RoboticsBay is ready!
