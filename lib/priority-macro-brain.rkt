  (define (protoss-pvp-immortal-defer-sym? nsym)
    (and protoss-pvp-immortal-cadence-due?
         (not (and protoss-anti-tempest-pvp-due?
                   (memq nsym '(stargate stalker blink void-ray tempest gateway twilight-council))))
