                                   (bldg-count-equivalent ready-bldg-counts 'warp-gate)) 0)
                             (> (bldg-count-equivalent ready-bldg-counts 'pylon) 0))
                        (and (or protoss-12pool-2gate-cap-active?
                                 (and (eq? enemy-race 'Zerg)
                                      (< frame 3360)
                                      (>= enemy-zergling-cnt 6)
                                      (<= (unit-count-equivalent unit-counts 'zealot) 2)))
                             (>= (+ (bldg-count-equivalent total-bldg-counts 'gateway)
                                    (bldg-count-equivalent total-bldg-counts 'warp-gate)) 2)
                             (>= (unit-count-equivalent unit-counts 'zealot) 1)
                             (>= minerals 150)
                             (hash? open-facility-slots)
                             (= (+ (hash-ref open-facility-slots 'gateway 0)
                                   (hash-ref open-facility-slots 'warp-gate 0)) 0))))
               (cons (if protoss-early-flood-idle-bank-break? 910.0 600.0) #t)]
              [(and (eq? nsym 'shield-battery)
                    (> (bldg-count-equivalent ready-bldg-counts 'cybernetics-core) 0)
                    (> (bldg-count-equivalent ready-bldg-counts 'pylon) 0)
                    (< (bldg-count-equivalent total-bldg-counts 'shield-battery)
                       (if (or (and protoss-12pool-2gate-cap-active? (not protoss-early-flood-idle-bank-break?))
                               (< minerals 200))
                           1
                           2))
                    (or protoss-early-flood-idle-bank-break?
                        (>= (unit-count-equivalent unit-counts 'zealot) 1)
                        (>= minerals 100)))
               (cons (if protoss-early-flood-idle-bank-break? 930.0 915.0)
                     (or protoss-early-flood-idle-bank-break?
                         (>= (unit-count-equivalent unit-counts 'zealot) 1)
                         (>= minerals 100)))]
              [(and protoss-early-flood-idle-bank-break?
                    (eq? nsym 'pylon)
                    (< (bldg-count-equivalent total-bldg-counts 'pylon) 4)
                    (or (<= (bldg-count-equivalent ready-bldg-counts 'pylon) 1)
                        (and (>= (+ (bldg-count-equivalent total-bldg-counts 'gateway)
                                    (bldg-count-equivalent total-bldg-counts 'warp-gate)) 2)
                             (>= minerals 250))))
               (cons 905.0 #t)]
              [else #f])]
           [else #f])))
  ;; W18-P0-3-belief (`#29 T v Creepy`): NEVER escrow or train Reaper past 2:30 (`frame >= 3360`)
  ;; or whenever under attack / enemy threat > 0 / enemy combat units seen / >= 1 Reaper already trained!
  (define terran-suppress-reaper-now?
    (and (eq? race 'Terran)
         (or (>= frame 3360)
             under-attack?
             (> enemy-threat-supply 0)
             early-enemy-combat-seen?
             (>= (unit-count-equivalent unit-counts 'reaper) 1))))
  (define pvz-first-zealot-wall-due?
    (and (eq? race 'Protoss)
         (eq? enemy-race 'Zerg)
         (<= active-bases 1)
         (> (+ (bldg-count-equivalent ready-bldg-counts 'gateway)
               (bldg-count-equivalent ready-bldg-counts 'warp-gate))
            0)
         (< army-supply 2)
         (= (unit-count-equivalent unit-counts 'zealot) 0)
         (not pvt-fast-kiter-threat?)))
  ;; W6-P0-4-belief (#36): In PvZ when early Pool / Ling flood is observed, pump continuous Zealots
  ;; ahead of CyberCore / Assimilator / extra non-urgent Pylons until >= 4 Zealots.
  (define pvz-early-ling-flood-active?
    (and (eq? race 'Protoss)
         (eq? enemy-race 'Zerg)
         (not early-worker-rush-active?)
         (< frame 4200)
         (not pvt-fast-kiter-threat?)
         (or (and (< frame 2688)
                  (> (bldg-count-equivalent enemy-b-counts 'spawning-pool) 0)
                  (<= (bldg-count-equivalent enemy-b-counts 'hatchery) 1))
             (>= (unit-count-equivalent enemy-u-counts 'zergling) 4)
             (and early-enemy-combat-arrived? (< frame 3600))
             under-early-rush-crisis?)))
  (define pvz-early-ling-zealot-pump?
    (and pvz-early-ling-flood-active?
         (> (+ (bldg-count-equivalent ready-bldg-counts 'gateway)
               (bldg-count-equivalent ready-bldg-counts 'warp-gate))
            0)
         (< (unit-count-equivalent unit-counts 'zealot) 4)))
  ;; L40-P0-2c (`#72` 12PoolBot `EarlyRushIdleBank` 255..300M):
  ;; On 1 base vs early Ling flood, unlock Gateway #2 (>=150M) and Gateway #3 (>=240M) whenever
  ;; existing Gateways are busy (`open-gw-slots == 0`), even while Zealot #1 is training!
  (define pvz-ling-extra-gate-due?
    (and pvz-early-ling-zealot-pump?
         (let ([cur-gw (+ (bldg-count-equivalent total-bldg-counts 'gateway)
                          (bldg-count-equivalent total-bldg-counts 'warp-gate))])
           (and (< cur-gw (if protoss-12pool-2gate-cap-active? 2 3))
                (>= minerals (if (< cur-gw 2) 150 240))
                (if (hash? open-facility-slots)
                    (= (+ (hash-ref open-facility-slots 'gateway 0)
                          (hash-ref open-facility-slots 'warp-gate 0))
                       0)
                    (>= (unit-count-equivalent unit-counts 'zealot) 1))))))
  (define pvz-ling-allow-cyber-now?
    (and pvz-early-ling-zealot-pump?
         (= (bldg-count-equivalent total-bldg-counts 'cybernetics-core) 0)
         (>= (+ (bldg-count-equivalent total-bldg-counts 'gateway)
                (bldg-count-equivalent total-bldg-counts 'warp-gate))
             2)
         (or (>= minerals 220)
             (and (>= (unit-count-equivalent unit-counts 'zealot) 1)
                  (>= minerals 150)))
         (hash? open-facility-slots)
         (= (+ (hash-ref open-facility-slots 'gateway 0)
               (hash-ref open-facility-slots 'warp-gate 0))
            0)))
  ;; L41-P0-2c (`#72` 12PoolBot `bank=130M/88G sched=(probe@2.2)`): Pause Probe drain below 150M
  ;; once >= 16 Probes exist & Gateway is busy training Zealots (<4 Zealots) so 100M stays ready for next Zealot/Battery!
  (define protoss-12pool-pause-probe-for-zealot?
    (and (eq? race 'Protoss)
         (eq? enemy-race 'Zerg)
         (< frame 3360)
         (or early-ling-rush-defense-active? pvz-early-ling-zealot-pump?)
         (>= workers 16)
         (> (+ (bldg-count-equivalent ready-bldg-counts 'gateway)
               (bldg-count-equivalent ready-bldg-counts 'warp-gate)) 0)
         (< (unit-count-equivalent unit-counts 'zealot) 4)
         (< minerals 150)))
  (define pvz-suppress-nonurgent-pylon?
    (and pvz-early-ling-zealot-pump?
         (or (>= supply-left 4)
             (> pending-supply 0))))
  (define zvz-suppress-nonurgent-overlord?
    (and zvz-early-ling-defense-due?
         (>= supply-left 2)
         (< (unit-count-equivalent unit-counts 'zergling) 8)))
  ;; W7-P0-3-belief (#12/#33) + L21-P0-2 (#19 ZvP): Hoisted enemy-air-combat-cnt so mass-air AA
  ;; & Overlord escrow suppression can reference it cleanly before supply-preempt-now? / supply-crisis?!
  (define enemy-air-combat-cnt
    (for/sum ([u (in-list '(mutalisk corruptor brood-lord viper phoenix oracle void-ray voidray
                            carrier tempest mothership banshee liberator liberator-ag
                            viking-fighter battlecruiser))])
      (unit-count-equivalent enemy-u-counts u)))
  ;; L21-P0-2 + L30-P0-2 (`#19 ZvP` AirAAStarve: 29 Phoenixes vs 0 Hydras post-Lair):
  ;; When >= 4 Stargate air units (air-relevant vs ground, or >= 6 Stargate air, or Stargate + >= 2 Stargate air)
  ;; are active and Zerg has ready Lair, force HydraliskDen (`1400, blk=#t`) & >= 12-16 Hydralisks (`1100, blk=#t`)
  ;; — and NEVER let Roach bypass HydraliskDen/Hydralisk gas escrow!
  (define enemy-stargate-air-cnt
    (+ (unit-count-equivalent enemy-u-counts 'phoenix)
       (unit-count-equivalent enemy-u-counts 'oracle)
       (unit-count-equivalent enemy-u-counts 'void-ray)
       (unit-count-equivalent enemy-u-counts 'voidray)
       (unit-count-equivalent enemy-u-counts 'carrier)
       (unit-count-equivalent enemy-u-counts 'tempest)
       (unit-count-equivalent enemy-u-counts 'mothership)))
  (define zerg-stargate-mass-air-active?
    (and (eq? race 'Zerg)
         (or (>= enemy-stargate-air-cnt 6)
             (and (>= enemy-stargate-air-cnt 4)
                  (> (* 2 enemy-stargate-air-cnt)
                     (for/sum ([u (in-list '(zealot stalker adept sentry immortal colossus archon
                                             high-templar dark-templar disruptor))])
                       (unit-count-equivalent enemy-u-counts u))))
             (and (> (bldg-count-equivalent enemy-b-counts 'stargate) 0)
                  (>= enemy-stargate-air-cnt 2)))))
  ;; L59-P2 (`#5143226 VoidCrushAgain` 17 Void Rays vs 0 Hydras/0 Corruptors/25 Overlords):
  ;; Under heavy enemy air (`>= 3` Void Rays, `zerg-stargate-mass-air-active?`, or `enemy-cap-air?` /
  ;; `enemy-air-dominant?` w/ >=4 combat air), freeze non-AA ground upgrades & structures, cap
  ;; concurrent Overlord queue at <= 2 in flight, and force nonstop 8-10 Queens + Hydra/Corruptor + Spore!
  (define enemy-void-ray-cnt
    (+ (unit-count-equivalent enemy-u-counts 'void-ray)
       (unit-count-equivalent enemy-u-counts 'voidray)))
  (define zerg-heavy-air-aa-freeze?
    (and (eq? race 'Zerg)
         (or (>= enemy-void-ray-cnt 3)
             zerg-stargate-mass-air-active?
             enemy-cap-air?
             (>= enemy-air-combat-cnt 6))))
  (define zerg-heavy-air-ov-capped?
    (and zerg-heavy-air-aa-freeze?
         (>= pending-supply 2)))
  (define (zerg-heavy-air-frozen-sym? nsym)
    (and zerg-heavy-air-aa-freeze?
         (< (+ (unit-count-equivalent unit-counts 'hydralisk)
               (unit-count-equivalent unit-counts 'corruptor))
            10)
         (or (memq nsym '(zerg-ground-armor-1 zerg-ground-armor-2 zerg-ground-armor-3
                          zerg-melee-weapons-1 zerg-melee-weapons-2 zerg-melee-weapons-3
                          burrow baneling-nest roach-warren lurker-den ultralisk-cavern
                          centrifical-hooks glial-reconstitution tunneling-claws
                          adaptive-talons seismic-spines chitinous-plating anabolic-synthesis))
             (and (eq? nsym 'evolution-chamber)
                  (or (>= (bldg-count-equivalent total-bldg-counts 'evolution-chamber) 1)
                      (= (unit-count-equivalent unit-counts 'hydralisk) 0)))
             (and (eq? nsym 'hatchery)
                  (>= active-bases 3)))))
  (define zerg-heavy-air-queen-due?
    (and zerg-heavy-air-aa-freeze?
         (> (bldg-count-equivalent ready-bldg-counts 'spawning-pool) 0)
         (< (unit-count-equivalent unit-counts 'queen) (min 10 (max 8 (+ active-bases 5))))
         (not supply-lockout-active?)
         (not zero-townhall-rebuild-due?)))
  (define zerg-heavy-air-spore-due?
    (and zerg-heavy-air-aa-freeze?
         (> (bldg-count-equivalent ready-bldg-counts 'spawning-pool) 0)
         (< (bldg-count-equivalent total-bldg-counts 'spore-crawler) (min 4 (max 2 active-bases)))
         (not zero-townhall-rebuild-due?)))
  (define zerg-mass-air-aa-tech-due?
    (and zerg-stargate-mass-air-active?
         has-lair-or-hive-ready?
         (= (bldg-count-equivalent total-bldg-counts 'hydralisk-den) 0)
         (or (not enemy-cap-air?)
             (and (= (bldg-count-equivalent total-bldg-counts 'spire) 0)
                  (= (bldg-count-equivalent total-bldg-counts 'greater-spire) 0)))
         (not (and (or enemy-cap-air? opp-cap-air-override?
                       (> (unit-count-equivalent enemy-u-counts 'battlecruiser) 0)
                       (> (bldg-count-equivalent enemy-b-counts 'fusion-core) 0))
                   (>= minerals 180)
                   (>= gas 180)))))
  ;; L31-P0-2 (`#19` 7 Hydras vs 34 Phoenixes): Scale Hydralisk target proportionally to enemy Stargate air!
  (define zerg-mass-air-hydra-target
    (if (>= enemy-stargate-air-cnt 6)
        (max 12 (min 28 enemy-stargate-air-cnt))
        16))
  (define zerg-mass-air-hydra-due?
    (and zerg-stargate-mass-air-active?
         (> (bldg-count-equivalent ready-bldg-counts 'hydralisk-den) 0)
         (< (unit-count-equivalent unit-counts 'hydralisk) zerg-mass-air-hydra-target)))
  ;; L31-P0-2 (`SupBlk 5.9% -> <=4.0%`, `#14/#18/#19/H2H#02`) + L59-P2 (`#5143226` Overlord-snipe cap):
  ;; Signed deficit-aware emergency supply replacement whenever supply-used >= supply-cap AND
  ;; (+ (- supply-cap supply-used) (* 8 pending-supply)) <= 2 — capped at <= 2 concurrent Overlords
  ;; under heavy enemy air (`zerg-heavy-air-aa-freeze?`) to break 25-Overlord death spirals!
  (define raw-supply-left (- supply-cap supply-used))
  (define supply-deficit (max 0 (- supply-used supply-cap)))
  (define emergency-supply-target-concurrent
    (if (and (not zero-townhall-rebuild-due?)
             (not zerg-heavy-air-ov-capped?)
             (< supply-cap 200)
             (>= supply-used supply-cap)
             (<= (+ raw-supply-left (* 8 pending-supply)) 2))
        (max 1 (min (if zerg-heavy-air-aa-freeze? 2 4) (quotient (+ supply-deficit 6 7) 8)))
        0))
  (define emergency-supply-needed-now
    (if (> emergency-supply-target-concurrent 0)
        (max 1 (- emergency-supply-target-concurrent pending-supply))
        0))
  (define emergency-supply-deficit-active? (> emergency-supply-needed-now 0))
  (define zerg-mass-air-suppress-overlord?
    (and zerg-stargate-mass-air-active?
         (not supply-lockout-active?)
         (not emergency-supply-deficit-active?)
         (>= supply-left 2)
         (or zerg-mass-air-aa-tech-due?
             (and zerg-mass-air-hydra-due?
                  (< (+ (unit-count-equivalent unit-counts 'hydralisk)
                        (unit-count-equivalent unit-counts 'corruptor))
                     8)
                  (>= supply-left 4)))))
  ;; L20-P0-2 (3D Visual-QA `#25 ZvP`): Never over-schedule Overlords when headroom >= 14 OR
  ;; at >= 4:00 (`5376f`) with 0 active combat units (`army-supply <= 0`) and >= 6 supply headroom!
  (define zerg-overlord-overbuilt-suppress?
    (and (eq? race 'Zerg)
         (not supply-lockout-active?)
         (not emergency-supply-deficit-active?)
         (or (>= (+ raw-supply-left (* 8 pending-supply))
                 (cond
                   [(>= active-bases 4) 22]
                   [(>= active-bases 3) 18]
                   [else 14]))
             (and (>= frame 5376)
                  (<= army-supply 0)
                  (>= (+ raw-supply-left (* 8 pending-supply)) 6)
                  (> (bldg-count-equivalent ready-bldg-counts 'spawning-pool) 0)))))
  ;; L20-P0-2 + L21-P0-2 (3D Visual-QA `#36 P v 12PoolBot`): Active base breach / early Ling rush
  ;; with < 4 Protoss combat units -> suppress non-defense tech REGARDLESS of Gateway count, and
  ;; prioritize `zealot` (`u >= 940`, `blk = #t`) whenever >= 1 Gateway is ready!
  (define protoss-early-breach-combat-cnt
    (if (eq? race 'Protoss)
        (for/sum ([u (in-list '(zealot stalker adept sentry immortal colossus disruptor
                                high-templar dark-templar archon phoenix void-ray oracle
                                tempest carrier mothership))])
          (unit-count-equivalent unit-counts u))
        0))
  ;; L45-P0-2a (`H2H #03 PvP` nat_sec=260.8s): A single non-attacking PvP opening scout
  ;; (not under-attack?, 0 enemy Forge/Cannon/Zealot, army >= threat <= max(2, army)) is NOT a base breach!
  (define pvp-benign-opening-scout?
    (and (eq? race 'Protoss)
         (eq? enemy-race 'Protoss)
         (not under-attack?)
         (not under-early-rush-crisis?)
         (= (bldg-count-equivalent enemy-b-counts 'forge) 0)
         (= (bldg-count-equivalent enemy-b-counts 'photon-cannon) 0)
         (= (unit-count-equivalent enemy-u-counts 'zealot) 0)
         (<= enemy-threat-supply (max 2.0 army-supply))
         (>= army-supply enemy-threat-supply)))
  (define protoss-early-breach-zealot-due?
    (and (eq? race 'Protoss)
         (not protoss-post-worker-rush-release-cyber?)
         (not pvp-benign-opening-scout?)
         (or early-worker-rush-active? under-attack? (> enemy-threat-supply 0))
         (> (+ (bldg-count-equivalent ready-bldg-counts 'gateway)
               (bldg-count-equivalent ready-bldg-counts 'warp-gate))
            0)
         (< protoss-early-breach-combat-cnt 4)
         (< frame 6720)
         (not early-proxy-marauder-rush-active?)
         (not eff-req-aa?)
         (not eff-req-det?)
         ;; L36-P0-2 (`#5138232` PvZ 0 Stalkers till 313s): Do not force Zealot@940 ahead of Stalker
         ;; when CyberCore + >=50G are ready against ranged Roaches/Ravagers, Reapers, or Air!
         (not (and (> (bldg-count-equivalent ready-bldg-counts 'cybernetics-core) 0)
                   (>= gas 50)
                   (or (>= (unit-count-equivalent enemy-u-counts 'reaper) 2)
                       (>= enemy-roach-ravager-cnt 3)
                       (and (>= enemy-roach-ravager-cnt 1)
                            (>= (unit-count-equivalent unit-counts 'zealot) 2)))))))
  (define protoss-early-breach-no-tech?
    (and (eq? race 'Protoss)
         (not protoss-post-worker-rush-release-cyber?)
         (not pvp-benign-opening-scout?)
         (< protoss-early-breach-combat-cnt 4)
         (not early-proxy-marauder-rush-active?)
         (or (and early-worker-rush-active?
                  (< (unit-count-equivalent unit-counts 'zealot) 2))
             early-ling-rush-defense-active?
             (and (< frame 5376)
                  (or under-attack? (> enemy-threat-supply 0))
                  (not eff-req-aa?)
                  (not eff-req-det?)))))
  (define (protoss-early-breach-suppressed-sym? nsym)
    (and (or protoss-early-breach-zealot-due? protoss-early-breach-no-tech?)
         (not (and (eq? nsym 'cybernetics-core)
                   (or pvz-ling-allow-cyber-now?
                       (and protoss-early-flood-idle-bank-break?
                            (>= (unit-count-equivalent unit-counts 'zealot) 1)))))
         (or (eq? nsym 'nexus)
             (memq nsym '(cybernetics-core stargate twilight-council robotics-facility
                          robotics-bay forge templar-archive dark-shrine fleet-beacon
                          assimilator warp-gate-research))
             (and (eq? nsym 'immortal)
                  (= (bldg-count-equivalent ready-bldg-counts 'robotics-facility) 0)))))
  ;; W4-P0-1b + W6-P0-4-belief + W7-P0-4-belief + L36-P0-2 (`#5138232`): Unconditional Protoss
  ;; root-tech CyberneticsCore priority once Gateway #1 is ready; strictly hard-capped at == 1
  ;; across BOTH `total-bldg-counts` and `ready-bldg-counts` so a duplicate CyberCore is NEVER built!
  (define protoss-cyber-core-exists?
    (> (max (bldg-count-equivalent total-bldg-counts 'cybernetics-core)
            (bldg-count-equivalent ready-bldg-counts 'cybernetics-core))
       0))
  (define protoss-root-cyber-due?
    (and (eq? race 'Protoss)
         (> (+ (bldg-count-equivalent ready-bldg-counts 'gateway)
               (bldg-count-equivalent ready-bldg-counts 'warp-gate))
            0)
         (> (bldg-count-equivalent ready-bldg-counts 'pylon) 0)
         (not protoss-cyber-core-exists?)
         (or (not pvz-early-ling-zealot-pump?)
             pvz-ling-allow-cyber-now?)
         (or pvz-ling-allow-cyber-now?
             (and (not protoss-early-breach-zealot-due?)
                  (not protoss-early-breach-no-tech?)))
         (not (and early-worker-rush-active?
                   (< (unit-count-equivalent unit-counts 'zealot) 2)))
         (or protoss-post-worker-rush-release-cyber?
             (not (and under-early-rush-crisis?
                       (< (unit-count-equivalent unit-counts 'zealot) 1))))))
  (define protoss-cyber-before-pylon2?
    (and protoss-root-cyber-due?
         (= (bldg-count-equivalent total-bldg-counts 'pylon) 1)
         (>= supply-left 3)
         (not supply-lockout-active?)
         (>= minerals 100)))

  (define max-crisis-pending-supply
    (cond
      [emergency-supply-deficit-active? (max 4 emergency-supply-target-concurrent)]
      [(< raw-supply-left 0) 3]
      [(and (hash? open-facility-slots) (or (>= supply-cap 66) (>= prod-fac-count 5))) 3]
      [else 2]))
  (define supply-margin (compute-supply-preemption-margin supply-cap))
  ;; L49-W1/W1B Law 3a + L51-1B (`H2H #05 PvZ` 19/23 Pylon #2 when Gateway ready):
  (define wd-supply-urgent?
    (wd-preemptive-supply-urgent?
     supply-used supply-cap pending-supply
     (cond
       [(eq? race 'Zerg) active-bases]
       [(and (eq? race 'Protoss) (= supply-cap 23))
        (+ (bldg-count-equivalent ready-bldg-counts 'gateway)
           (bldg-count-equivalent ready-bldg-counts 'warp-gate))]
       [else prod-fac-count])
     race))
  (define supply-preempt-now?
    (and (not zero-townhall-rebuild-due?)
         (or ;; L31-P0-2 (`#14/#18/#19/H2H#02`): Deficit-aware emergency supply replacement whenever
             ;; supply-used >= supply-cap AND (+ (- supply-cap supply-used) (* 8 pending-supply)) <= 2!
             emergency-supply-deficit-active?
             ;; L24/L26-P0-2 (`#14` `SB=27.3%/25.6%`): Immediately replace lost/sniped supply whenever
             ;; over cap (`raw-supply-left < 0`, up to `pending-supply < 3`!) OR at/over cap past the 14/15
             ;; opener (`raw-supply-left <= 0`, `supply-cap >= 20`, `pending-supply < 2`)!
             (and (< supply-cap 200)
                  (or (and (< raw-supply-left 0) (< pending-supply 3))
                      (and (<= raw-supply-left 0) (>= supply-cap 20) (< pending-supply 2))))
             (and early-rush-override-active?
                  (not early-ling-rush-defense-active?)
                  (not early-worker-rush-active?)
                  (< supply-cap 200)
                  (<= pending-supply 0)
                  (<= supply-left 3))
             (and early-worker-rush-active?
                  (< supply-cap 200)
                  (<= pending-supply 0)
                  (<= supply-left 1))
             (and early-ling-rush-defense-active?
                  (< supply-cap 200)
                  (<= pending-supply 0)
                  (<= supply-left 2))
             (and (not zvz-suppress-nonurgent-overlord?)
                  (not zerg-mass-air-suppress-overlord?)
                  (not zerg-overlord-overbuilt-suppress?)
                  (not pvz-suppress-nonurgent-pylon?)
                  (not early-ling-rush-defense-active?)
                  (not early-worker-rush-active?)
                  (not protoss-cyber-before-pylon2?)
                  (or (supply-preemption-needed? supply-used supply-cap pending-supply #:race race)
                      wd-supply-urgent?)))))
  (define supply-crisis?
    (and (not zero-townhall-rebuild-due?)
         (or supply-lockout-active?
             supply-preempt-now?
             (and (not zvz-suppress-nonurgent-overlord?)
                  (not zerg-mass-air-suppress-overlord?)
                  (not zerg-overlord-overbuilt-suppress?)
                  (not pvz-suppress-nonurgent-pylon?)
                  (not early-worker-rush-active?)
                  (not protoss-cyber-before-pylon2?)
                  (< supply-cap 200)
                  (< (+ supply-cap (* 8 pending-supply)) 200)
                  (< pending-supply max-crisis-pending-supply)
                  (or (and (= pending-supply 0) (<= supply-left supply-buffer))
                      (<= (+ supply-left (* 8 pending-supply)) (max 0 (quotient supply-buffer 2)))
                      (and (>= active-bases 3)
                           (>= minerals 400)
                           (<= (+ supply-left (* 8 pending-supply)) (max 8 supply-buffer))))))))

  (define race-expand-sym
    (case race [(Zerg) 'hatchery] [(Terran) 'command-center] [else 'nexus]))
  ;; W15-P0-1: Tier-A 1-base T3 rush holds Natural #2 until the T3 structure starts,
  ;; then `step-post-t3-tech-expand-due?` immediately prioritizes expanding behind the tech!
  (define active-1base-t3-rush-pending?
    (and (= active-bases 1)
         (<= total-townhalls-incl-pending 1)
         (not under-early-rush-crisis?)
         (not crisis-defer?)
         (not (and under-attack? (< army-supply (+ enemy-threat-supply 4))))
         (not (has-started-t3-tech-struct? race total-bldg-counts))
         (ormap (lambda (s)
                  (define nd (lookup-sc2-tech-node s))
                  (and nd
                       (eq? (sc2-tech-node-race nd) race)
                       (t3-explicit-rush-intent-matches?
                        s steps-so-far post-bo-goals raw-mirror-signals
                        effective-phase-supply workers active-bases)))
                T3-CANONICAL-STRUCT-SYMS)))
  (define step-post-t3-tech-expand-due?
    (and (not early-enemy-combat-arrived?)
         (not terran-early-rush-hold?)
         (not pvz-early-ling-flood-active?)
         (post-t3-tech-expand-due?
          race active-bases total-townhalls-incl-pending workers
          army-supply enemy-threat-supply total-bldg-counts
          #:under-attack? under-attack?
          #:under-early-rush-crisis? under-early-rush-crisis?
          #:early-rush-override? early-rush-override-active?
          #:crisis-defer? crisis-defer?
          #:supply-preempt-now? supply-preempt-now?
          #:natural-blocked? ws-natural-blocked?)))
  ;; L25/L26-P0-2 + L44-P0-2a + L60 (`#1580`/`#1582` `#12/#33/#51 PvPNatDelay 1:45 -> ~1:32`):
  ;; Unpressured PvP natural Nexus starts ramping cleanly by 85-95s (`f >= 1904` w/ `>= 19` Probes,
  ;; or `f >= 2128` w/ `>= 18` Probes) once CyberCore + Gateway + Assimilator are down, ONLY when no
  ;; proxy/cannon/Stargate/DT threat is observed!
  (define pvp-early-nat-nexus-due?
    (and (eq? race 'Protoss)
         (eq? enemy-race 'Protoss)
         (= active-bases 1)
         (<= total-townhalls-incl-pending 1)
         (or (>= frame 2128)
             (and (>= frame 1904) (>= workers 19)))
         (>= (bldg-count-equivalent total-bldg-counts 'pylon) 1)
         (>= (bldg-count-equivalent total-bldg-counts 'gateway) 1)
         (>= (bldg-count-equivalent total-bldg-counts 'cybernetics-core) 1)
         (>= (bldg-count-equivalent total-bldg-counts 'assimilator) 1)
         (or (>= workers 18) (>= frame 2688))
         (not under-attack?)
         (not under-early-rush-crisis?)
         (or (not early-enemy-combat-arrived?)
             (and (not under-attack?)
                  (= (bldg-count-equivalent enemy-b-counts 'forge) 0)
                  (<= enemy-threat-supply 2.0)
                  (<= (unit-count-equivalent enemy-u-counts 'zealot) 0)))
         (not eff-req-aa?)
         (not eff-req-det?)
         (not requires-detection?)
         (not enemy-cap-air?)
         ;; L27-P0-2 (`#21 PvP` Nat <= 195s): Normal home enemy Forge/Stargate must NOT delay
         ;; natural Nexus past 160s (`f >= 3584`, ensuring start < 195s) when peaceful & 0 air units;
         ;; proxy within 45t still sets `under-attack?` / `enemy-threat-supply >= 4` / `photon-cannon > 0`!
         (or (>= frame 3584)
             (and (= (bldg-count-equivalent enemy-b-counts 'stargate) 0)
                  (= (bldg-count-equivalent enemy-b-counts 'forge) 0)))
         (= (bldg-count-equivalent enemy-b-counts 'photon-cannon) 0)
         (= (bldg-count-equivalent enemy-b-counts 'dark-shrine) 0)
         (= enemy-air-combat-cnt 0)
         ;; L45-P0-2a (`H2H #03 PvP` nat_sec=260.8s): Allow harmless opening scout/Stalker
         ;; (`<= (max 2.0 army-supply)` when no enemy Forge proxy), while keeping Forge proxy blocked!
         (<= enemy-threat-supply
             (if (= (bldg-count-equivalent enemy-b-counts 'forge) 0)
                 (max 2.0 army-supply)
                 0))))
  ;; L46-P0-2a + L47/L48-P0-2b + L60 (`#12/#33/#51` PvPNatDelay): While still on 1 base
  ;; in unpressured PvP (`1904f..6720f`), defer Gateway #3+, PhotonCannon #2+, TwilightCouncil,
  ;; non-detection Forge, and peaceful RoboticsFacility/Stargate strictly behind Natural Nexus #2!
  (define pvp-nat-defer-gate3-cannon2?
    (and (eq? race 'Protoss)
         (eq? enemy-race 'Protoss)
         (= active-bases 1)
         (<= total-townhalls-incl-pending 1)
         (>= frame 1904)
         (< frame 6720)
         (>= (bldg-count-equivalent total-bldg-counts 'cybernetics-core) 1)
         (not under-attack?)
         (not under-early-rush-crisis?)
         (= (bldg-count-equivalent enemy-b-counts 'photon-cannon) 0)
         (= (unit-count-equivalent enemy-u-counts 'dark-templar) 0)
         (<= enemy-threat-supply
             (if (= (bldg-count-equivalent enemy-b-counts 'forge) 0)
                 (max 2.0 army-supply)
                 0))))
  ;; L47/L48-P0-2b (`#53 zig-reapers`): Defer `orbital-command` and `command-center #2` against:
  ;; (a) >= 2 pre-5:00 Reapers until >= 6 Marines OR >= 1 Bunker/Hellion exist;
  ;; (b) >= 1 threatening pre-4:00 (`< 5376f`) TvT Reaper until >= 4 Marines OR >= 1 Bunker/Hellion exist!
  (define terran-early-reaper2-defer-oc-cc?
    (and (eq? race 'Terran)
         (< frame 6720)
         (= (bldg-count-equivalent total-bldg-counts 'bunker) 0)
         (= (unit-count-equivalent unit-counts 'hellion) 0)
         (or (and (>= (unit-count-equivalent enemy-u-counts 'reaper) 2)
                  (< (unit-count-equivalent unit-counts 'marine) 6))
             (and (eq? enemy-race 'Terran)
                  (< frame 5376)
                  (>= (unit-count-equivalent enemy-u-counts 'reaper) 1)
                  (or under-attack?
                      (> enemy-threat-supply 0)
                      early-enemy-combat-arrived?)
                  (< (unit-count-equivalent unit-counts 'marine) 4)))))
  (define (terran-early-reaper2-deferred-sym? nsym)
    (and terran-early-reaper2-defer-oc-cc?
         (or (eq? nsym 'orbital-command)
             (and (eq? nsym 'command-center)
                  (>= total-townhalls-incl-pending 1)))))
  ;; L48-P0-2b (`H2H #01 ZvZ` `SB 5.6%`, `escrow=7:hatchery` blocking Hydralisk/Roach/Ling/Overlord):
  ;; In ZvZ (>= 1 Hatchery exists), NEVER hold blocking `hatchery` escrow when `supply-left <= 2`
  ;; OR when actively threatened and outnumbered (`enemy-threat-supply > 0 && army-supply < enemy-threat-supply + 4`)!
  (define zvz-hatchery-nonblocking-now?
    (and (eq? race 'Zerg)
         (eq? enemy-race 'Zerg)
         (> total-townhalls-incl-pending 0)
         (not zero-townhall-rebuild-due?)
         (or (<= supply-left 2)
             (and (> enemy-threat-supply 0)
                  (< army-supply (+ enemy-threat-supply 4))))))
  (define natural-exp-window?
    (and (<= total-townhalls-incl-pending 1)
         (not terran-1base-cc-lock-broken?)
         (not terran-early-reaper2-defer-oc-cc?)
         (not active-1base-t3-rush-pending?)
         (not early-rush-override-active?)
         (not early-ling-rush-defense-active?)
         (not protoss-pvz-12pool-block-nexus2?)
         (not early-proxy-marauder-rush-active?)
         (not terran-early-rush-hold?)
         (not pvz-early-ling-flood-active?)
         (not zvz-safe-pool-first-due?)
         (or pvp-early-nat-nexus-due?
             (natural-expansion-window-active?
              race frame workers (max eff-th-total-cnt total-townhalls-incl-pending)
              ready-bldg-counts total-bldg-counts
              under-attack? enemy-threat-supply
              (or under-early-rush-crisis?
                  early-enemy-combat-arrived?
                  (and (> enemy-threat-supply 0)
                       (< army-supply (+ enemy-threat-supply 2))))
              #:enemy-race enemy-race))))
  ;; W4-P0-1c + W5-P0-2-belief + L44-P0-2a + L62 (`#1660` `#63 SmoothBrain`) + L62B (`#1680` Fix 5):
  ;; 620.0 hard opening escrow (< 5400f & < 36 supply, or < 46 supply for Protoss 1-base
  ;; natural windows once >= 250M is banked so 0..249M early banks never stall Probe/Robo/Stalker
  ;; production while >= 250M keeps Nexus above Immortal@562 at 36..45 supply!);
  ;; keep 1-base natural expansion at 560.0 up to 7200f (5:20) when not under-attack so PvP never stalls on 1 base.
  (define early-nat-exp-window?
    (and natural-exp-window?
         (< frame 5400)
         (or (< supply-used 36)
             (and (eq? race 'Protoss) (< supply-used 46) (>= minerals 250))
             (and pvp-early-nat-nexus-due? (< supply-used 46)))))
  (define mid-nat-exp-window?
    (and natural-exp-window?
         (< frame 7200)
         (not under-attack?)))
  ;; L22-P0-2 (`#32 TvT`): Never let midgame 1-base Natural (`command-center@910`) outrank/block
  ;; `factory-techlab` or core `siege-tank` (<2 Tanks in TvT) when a ready Factory needs them!
  (define terran-tvt-1base-tank-core-due?
    (and (eq? race 'Terran)
         (eq? enemy-race 'Terran)
         (> (bldg-count-equivalent ready-bldg-counts 'factory) 0)
         (or (and (= (bldg-count-equivalent total-bldg-counts 'factory-techlab) 0)
                  (not (facility-addon-slot-occupied? 'factory-techlab ready-bldg-counts total-bldg-counts #:min-ready-floor 1)))
             (and (> (bldg-count-equivalent ready-bldg-counts 'factory-techlab) 0)
                  (< (unit-count-equivalent unit-counts 'siege-tank) 2)
                  (or (not (hash? open-facility-slots))
                      (> (hash-ref open-facility-slots 'factory 0) 0))
                  (>= gas 100)))))
  ;; L21/L22-P0-2 (`#30 PvP 2.07x B=1/10`, `#27`, `#32`): Unblock midgame 1-base Natural expansion
  ;; past 3:20 (`4480f`) with >= 10 army supply, >= 175M banked (so it never stalls SCVs/Tanks at 85-145M!),
  ;; no active base attack/rush, and not blocking urgent TvT FactoryTechLab / first 2 Siege Tanks:
  ;; boost Nexus/CC to `u = 910.0` (strictly above TwilightCouncil@892, Stargate@880, PhotonCannon@870)!
  ;; L31-P0-2 (`#08` nat=430s, `#26`): On 1 base past 3:15 (`frame >= 4368`, `workers >= 20`, no early rush),
  ;; raise Natural `command-center` (`u = 835.0 >= 830.0`, `blk = #t`) strictly above `starport@810` regardless
  ;; of transient `< 150M` bank so Starport never steals `saving_for`!
  (define terran-1base-past-315-nat-cc-due?
    (and (eq? race 'Terran)
         (= active-bases 1)
         (<= total-townhalls-incl-pending 1)
         (>= frame 4368)
         (>= workers 20)
         (not terran-1base-cc-lock-broken?)
         (not terran-early-reaper2-defer-oc-cc?)
         (not terran-tvt-1base-tank-core-due?)
         (not under-attack?)
         (not under-early-rush-crisis?)
         (not early-ling-rush-defense-active?)
         (not early-proxy-marauder-rush-active?)
         (not terran-early-rush-hold?)
         (not active-1base-t3-rush-pending?)
         (<= enemy-threat-supply (if (< army-supply 8) 2.0 (* 1.15 army-supply)))))
  ;; L42-P0-2c (`1BaseLock 4 -> 0`, `#51 PvP`, `#59 TvP`, `#68 TvP`):
  ;; Past 4:30 (`frame >= 6048`), if STILL on 1 base (`active-bases == 1 && total-townhalls-incl-pending <= 1`)
  ;; with >= 16 workers and not under active main-base invasion, force natural expansion commit (`u >= 910, blk = #t`,
  ;; NO 175M cliff!) strictly ahead of extra Gateways/Barracks/Factories/Bunkers/Robo/Upgrades!
  (define late-1base-commit-expand-due?
    (and (= active-bases 1)
         (<= total-townhalls-incl-pending 1)
         (>= frame 6048)
         (>= workers 16)
         (not zero-townhall-rebuild-due?)
         (not zvz-hatchery-nonblocking-now?)
         (not terran-1base-cc-lock-broken?)
         (not terran-early-reaper2-defer-oc-cc?)
         (not (and ws-natural-blocked? (< minerals 350)))
         (not terran-tvt-1base-tank-core-due?)
         (not under-attack?)
         (not under-early-rush-crisis?)
         (not early-ling-rush-defense-active?)
         (not early-proxy-marauder-rush-active?)
         (not terran-early-rush-hold?)
         (not active-1base-t3-rush-pending?)
         (not supply-preempt-now?)
         (<= enemy-threat-supply (max 2.0 army-supply))))
  ;; L45-P0-2a (`1BaseLock 4 -> 0`, `#38/#59/#62/#68`):
  ;; Once past 4:30 (`late-1base-commit-expand-due?`) with >= 20 workers & >= 16 standing army
  ;; and < 400M banked, pause non-urgent marine/scv/zealot/stalker/probe training so 50M drips
  ;; NEVER trap 1-base Terran/Protoss at 7M-41M while command-center/nexus(u=910) waits!
  (define late-1base-commit-pause-units?
    (and late-1base-commit-expand-due?
         (>= workers 20)
         (>= army-supply 16)
         (< minerals 400)))
  (define midgame-1base-natural-due?
    (or late-1base-commit-expand-due?
        (and (memq race '(Protoss Terran))
             (= active-bases 1)
             (<= total-townhalls-incl-pending 1)
             (or (and (>= frame 4480)
                      (>= minerals 175)
                      (>= army-supply (if (eq? race 'Protoss) 8 10)))
                 (and (eq? race 'Protoss)
                      (>= frame 4032)
                      (>= minerals 250)
                      (>= army-supply 8)))
             (not terran-1base-cc-lock-broken?)
             (not (and ws-natural-blocked? (< minerals 350)))
             (not terran-tvt-1base-tank-core-due?)
             (or (not under-attack?)
                 (and (eq? race 'Protoss)
                      (>= minerals 275)
                      (<= enemy-threat-supply (* 0.75 (max 4 army-supply)))))
             (not under-early-rush-crisis?)
             (not early-ling-rush-defense-active?)
             (not early-proxy-marauder-rush-active?)
             (not terran-early-rush-hold?)
             (not active-1base-t3-rush-pending?)
             (<= enemy-threat-supply (* 1.25 (max 10 army-supply))))))
  (define has-protoss-mid-tech?
    (or (> (bldg-count-equivalent total-bldg-counts 'robotics-facility) 0)
        (> (bldg-count-equivalent total-bldg-counts 'twilight-council) 0)
        (> (bldg-count-equivalent total-bldg-counts 'stargate) 0)))
  (define enemy-armored-air-cnt
    (for/sum ([u (in-list '(void-ray voidray carrier tempest battlecruiser corruptor brood-lord mothership))])
      (unit-count-equivalent enemy-u-counts u)))
  ;; L19-P0-2: Scale Protoss Gateway hard cap (5 -> 8 -> 11 -> 12) to close midgame Prod8 (-5 vs Pro) deficit!
  (define protoss-gateway-hard-cap (min 12 (+ (* 3 (max 1 active-bases)) 2)))
  (define enemy-ground-combat-cnt
    (for/sum ([u (in-list '(zealot stalker adept immortal colossus archon high-templar dark-templar sentry
                            marine marauder siege-tank siege-tank-sieged hellion hellbat cyclone thor ghost
                            zergling baneling roach ravager hydralisk lurker lurker-burrowed ultralisk))])
      (unit-count-equivalent enemy-u-counts u)))
  (define enemy-reaper-cnt (unit-count-equivalent enemy-u-counts 'reaper))
  ;; L48-W2 (`H2H #02 TvT`): Exclude air-to-air mirror `viking-fighter` from TvT ground-threatening air!
  (define enemy-tvt-ground-attack-air-cnt
    (+ (unit-count-equivalent enemy-u-counts 'banshee)
       (unit-count-equivalent enemy-u-counts 'liberator)
       (unit-count-equivalent enemy-u-counts 'liberator-ag)
       (unit-count-equivalent enemy-u-counts 'battlecruiser)))
  (define enemy-air-dominant?
    (or enemy-cap-air?
        (and (>= enemy-air-combat-cnt 4)
             (>= (* 2 enemy-air-combat-cnt) enemy-ground-combat-cnt))))
  ;; W16-P1-1a + L19-P0-2 (`#5136362`, `#5136357`, `#43 ZvP`): Latched heavy capital-air & Battlecruiser predicates
  ;; so fog-of-war flicker NEVER drops `enemy-cap-air?` / `zerg-cap-air-spire-due?` mid-match!
  (define enemy-bc-present?
    (or (> (unit-count-equivalent enemy-u-counts 'battlecruiser) 0)
        (> (bldg-count-equivalent enemy-b-counts 'fusion-core) 0)))
  (define raw-enemy-heavy-cap-air?
    (or enemy-cap-air?
        opp-cap-air-override?
        enemy-bc-present?
        (> (unit-count-equivalent enemy-u-counts 'carrier) 0)
        (> (unit-count-equivalent enemy-u-counts 'tempest) 0)
        (> (unit-count-equivalent enemy-u-counts 'mothership) 0)
        (> (bldg-count-equivalent enemy-b-counts 'fleet-beacon) 0)))
  (define enemy-heavy-cap-air?
    (enemy-cap-air-latch-update! race enemy-race frame raw-enemy-heavy-cap-air?))
  ;; L32-P0-2 + L48-W2 (`#20` 168 Banshees, `#22` 30 Phoenixes, `H2H #02 TvT` mirror Vikings):
  ;; In TvT, mirror air-to-air `viking-fighter` MUST NOT trigger `enemy-air-dominated-now?`
  ;; (require >= 4 ground-attacking air Banshee/Liberator/BC or `enemy-heavy-cap-air?`).
  (define enemy-air-dominated-now?
    (if (and (eq? race 'Terran) (eq? enemy-race 'Terran))
        (or enemy-heavy-cap-air?
            (and (>= enemy-tvt-ground-attack-air-cnt 4)
                 (>= enemy-tvt-ground-attack-air-cnt enemy-ground-combat-cnt)))
        (and (>= enemy-air-combat-cnt 4)
             (>= enemy-air-combat-cnt enemy-ground-combat-cnt))))
  ;; W16-P1-1b (`#16`, `#5134985`, `#5135912`, `#5136228`): Zerg anti-Siege-Tank counter comp (>= 3 observed Tanks)
  (define enemy-siege-tank-cnt
    (+ (unit-count-equivalent enemy-u-counts 'siege-tank)
       (unit-count-equivalent enemy-u-counts 'siege-tank-sieged)))
  (define zerg-anti-tank-comp-due?
    (and (eq? race 'Zerg)
         (>= enemy-siege-tank-cnt 3)
         (not enemy-air-dominant?)
         (not opp-cap-air-override?)
         (not enemy-heavy-cap-air?)))
  ;; W10-P0-1/3-belief + W11-P0-1/3-belief: Cloaked / real air-harass response (never Phoenix/Observer/Medivac!)
  ;; + hard Observer/WarpPrism/Battery caps + Observer defer (<8 army unless cloaked threat)
  (define enemy-banshee-cnt (unit-count-equivalent enemy-u-counts 'banshee))
  (define enemy-explicit-cloaked-threat?
    (or (>= enemy-banshee-cnt 1)
        (> (unit-count-equivalent enemy-u-counts 'dark-templar) 0)
        (> (bldg-count-equivalent enemy-b-counts 'dark-shrine) 0)
        (> (unit-count-equivalent enemy-u-counts 'lurker) 0)
        (> (bldg-count-equivalent enemy-b-counts 'lurker-den) 0)
        (> (unit-count-equivalent enemy-u-counts 'ghost) 0)
        (and (hash? enemy-u-counts)
             (ormap (lambda (s) (> (hash-ref enemy-u-counts s 0) 0))
                    '(lurker-burrowed widow-mine-burrowed roach-burrowed baneling-burrowed
                      zergling-burrowed infestor-burrowed swarm-host-burrowed ultralisk-burrowed
                      drone-burrowed queen-burrowed hydralisk-burrowed ravager-burrowed)))))
  (define passive-only-cloak-here?
    (enemy-passive-only-cloak? enemy-u-counts enemy-b-counts))
  (define enemy-cloaked-threat-active?
    (or enemy-explicit-cloaked-threat?
        (and eff-req-det? (not passive-only-cloak-here?))))
  (define enemy-real-air-harass-cnt
    (for/sum ([u (in-list '(banshee oracle mutalisk liberator liberator-ag))])
      (unit-count-equivalent enemy-u-counts u)))
  ;; L37-P0-1 + L40-P0-2a + L42-P0-2a (`CloakLoss 3 -> 0`: `#73 Z`, `#74 T`, `#75 P` vs 8-10 Banshees @210s):
  ;; Unified 3-race anti-Banshee trigger on >= 1 observed Banshee OR >= 1 StarportTechLab <= 6:00 (`frame <= 8064`):
  ;; - Zerg: rush Lair -> HydraDen + >= 8 Hydras + >= 6-7 Queens + 1 Spore/base, blocking Baneling/Roach drain even >= 150G!
  ;; - Terran: EBay + 1 MissileTurret/base (`u >= 1260`) + >= 4 Vikings (`u >= 940`) ahead of Tank/Starport/Rax/Hellion!
  ;; - Protoss: Stalker floor >= 8 + Phoenix >= 3 (if Stargate ready) ahead of 3rd Nexus/Charge/Forge/Stargate (<6 Stalkers)!
  (define enemy-starport-cnt
    (bldg-count-equivalent enemy-b-counts 'starport))
  (define enemy-starport-tl-cnt
    (bldg-count-equivalent enemy-b-counts 'starport-techlab))
  (define terran-enemy-banshee-starport-tl?
    (and (eq? race 'Terran)
         (or (>= enemy-banshee-cnt 1)
             (and (>= enemy-starport-tl-cnt 1) (<= frame 8064))
             (>= enemy-starport-tl-cnt 2))))
  (define zerg-zvt-banshee-aa-rush?
    (and (eq? race 'Zerg)
         (or (>= enemy-banshee-cnt 1)
             (>= enemy-starport-tl-cnt 2)
             (and (>= enemy-starport-tl-cnt 1) (<= frame 8064)))))
  ;; L63 (`#1704` ZvT Mass-Banshee AA Escalation): Against >= 3 Banshees (or >= 2 w/ >= 2
  ;; Starports/TechLabs), escalate Spore/base (up to 5), >= 6 Queens, high Hydra target (up to 24),
  ;; fast Spire + Corruptor pivot, and keep AA gas protection active even alongside Marines!
  (define zerg-mass-banshee-escalation?
    (and (eq? race 'Zerg)
         (or (>= enemy-banshee-cnt 3)
             (and (>= enemy-banshee-cnt 2)
                  (or (>= enemy-starport-cnt 2)
                      (>= enemy-starport-tl-cnt 2))))))
  (define zerg-mass-banshee-aa-target
    (if zerg-mass-banshee-escalation?
        (min 24 (max 12 (* 2 enemy-banshee-cnt)))
        0))
  (define zerg-mass-banshee-spire-due?
    (and zerg-mass-banshee-escalation?
         has-lair-or-hive-ready?
         (= (bldg-count-equivalent total-bldg-counts 'spire) 0)
         (= (bldg-count-equivalent total-bldg-counts 'greater-spire) 0)
         ;; L63 (`#1713`): If Hydralisk Den is already ready with < 4 Hydras, train immediate
         ;; Hydras first before starting Spire escrow!
         (or (= (bldg-count-equivalent ready-bldg-counts 'hydralisk-den) 0)
             (>= (unit-count-equivalent unit-counts 'hydralisk) 4))
         (or (> (bldg-count-equivalent total-bldg-counts 'hydralisk-den) 0)
             (>= enemy-banshee-cnt 5))))
  (define zerg-mass-banshee-corruptor-due?
    (and zerg-mass-banshee-escalation?
         (or (> (bldg-count-equivalent ready-bldg-counts 'spire) 0)
             (> (bldg-count-equivalent ready-bldg-counts 'greater-spire) 0))
         (< (unit-count-equivalent unit-counts 'corruptor)
            (min 14 (max 6 enemy-banshee-cnt)))
         (not supply-preempt-now?)))
  (define zerg-mass-banshee-throttle-drone?
    (and zerg-mass-banshee-escalation?
         (>= workers 40)
         (< (+ (unit-count-equivalent unit-counts 'hydralisk)
               (unit-count-equivalent unit-counts 'corruptor)
               (unit-count-equivalent unit-counts 'queen))
            12)))
  ;; L47-P0-2b + L63: Lock >= 1 Spore/base (up to 5 under mass Banshees) + >= 5 (or >= 6 under mass
  ;; Banshees) Queens ahead of Lair escrow / HydraDen / Zergling drain!
  (define zerg-banshee-spore-floor-needed?
    (and zerg-zvt-banshee-aa-rush?
         (> (bldg-count-equivalent ready-bldg-counts 'spawning-pool) 0)
         (< (bldg-count-equivalent total-bldg-counts 'spore-crawler)
            (min (if zerg-mass-banshee-escalation? 5 3) (max 1 active-bases)))))
  (define zerg-banshee-queen5-floor-needed?
    (and zerg-zvt-banshee-aa-rush?
         (> (bldg-count-equivalent ready-bldg-counts 'spawning-pool) 0)
         (< (unit-count-equivalent unit-counts 'queen)
            (if (and zerg-mass-banshee-escalation?
                     (or (not has-lair-or-hive-ready?)
                         (> (bldg-count-equivalent total-bldg-counts 'hydralisk-den) 0)
                         (> (bldg-count-equivalent total-bldg-counts 'spire) 0)))
                6
                5))))
  (define zerg-has-lair-aa-struct-started?
    (> (+ (bldg-count-equivalent total-bldg-counts 'hydralisk-den)
          (bldg-count-equivalent total-bldg-counts 'spire)
          (bldg-count-equivalent total-bldg-counts 'greater-spire))
       0))
  (define zerg-banshee-suppress-ground-t15-tech?
    (and zerg-zvt-banshee-aa-rush?
         (not zerg-has-lair-aa-struct-started?)))
  (define zerg-banshee-hydra-target
    (if zerg-mass-banshee-escalation?
        zerg-mass-banshee-aa-target
        (min 16 (max 8 (* 2 (max 1 enemy-banshee-cnt))))))
  (define zerg-banshee-aa-gas-protect?
    (and zerg-zvt-banshee-aa-rush?
         (or zerg-mass-banshee-escalation?
             (and (or (>= enemy-banshee-cnt 2)
                      (and (>= enemy-banshee-cnt 1) (< enemy-ground-combat-cnt 6))
                      (and (>= enemy-starport-tl-cnt 1) (<= frame 8064) (< enemy-ground-combat-cnt 6)))
                  (< enemy-ground-combat-cnt 6)))
         (< (+ (unit-count-equivalent unit-counts 'hydralisk)
               (unit-count-equivalent unit-counts 'corruptor))
            zerg-banshee-hydra-target)
         (or has-lair-or-hive-ready?
             (> (bldg-count-equivalent total-bldg-counts 'lair) 0)
             (> (bldg-count-equivalent total-bldg-counts 'hydralisk-den) 0)
             (> (bldg-count-equivalent total-bldg-counts 'spire) 0))))
  (define (zerg-banshee-defer-ground-gas-sym? nsym)
    (or (and zerg-banshee-aa-gas-protect?
             (or (< gas 250)
                 (< minerals 225)
                 (= (bldg-count-equivalent total-bldg-counts 'hydralisk-den) 0))
             ;; Under mass Banshees + Marines (`>= 12` Marines), still allow Banelings while deferring
             ;; ground-only Roach/Ravager/Evo/ground upgrades until AA reaches target!
             (not (and zerg-mass-banshee-escalation?
                       (eq? nsym 'baneling)
                       (>= (unit-count-equivalent enemy-u-counts 'marine) 12)))
             (memq nsym '(baneling roach ravager evolution-chamber
                          zerg-melee-weapons-1 zerg-missile-weapons-1 zerg-ground-armor-1
                          centrifugical-hooks glial-reconstitution)))
        ;; L44-P0-2b (`#73 Z v who` CloakLoss -> 0): Strictly defer BanelingNest, RoachWarren, Baneling morphs,
        ;; and SpineCrawler #2+ once Banshees / <= 6m StarportTechLab are scouted until Hydralisks >= 8!
        (and zerg-zvt-banshee-aa-rush?
             (< (+ (unit-count-equivalent unit-counts 'hydralisk)
                   (unit-count-equivalent unit-counts 'corruptor))
                zerg-banshee-hydra-target)
             (or (and (memq nsym '(baneling baneling-nest roach-warren))
                      (< enemy-ground-combat-cnt 12))
                 (and (eq? nsym 'spine-crawler)
                      (>= (bldg-count-equivalent total-bldg-counts 'spine-crawler) 1)
                      (< enemy-ground-combat-cnt 10))))))
  (define zerg-banshee-lair-rush-due?
    (and zerg-zvt-banshee-aa-rush?
         (= (bldg-count-equivalent total-bldg-counts 'lair) 0)
         (= (bldg-count-equivalent total-bldg-counts 'hive) 0)
         (> (bldg-count-equivalent ready-bldg-counts 'spawning-pool) 0)
         (> (bldg-count-equivalent ready-bldg-counts 'hatchery) 0)))
  (define zerg-cloaked-air-crisis?
    (and (eq? race 'Zerg)
         (or (>= enemy-real-air-harass-cnt 1)
             zerg-zvt-banshee-aa-rush?
             (and enemy-cloaked-threat-active?
                  (or eff-req-aa? (>= enemy-air-combat-cnt 1)))
             enemy-cap-air?)))
  ;; L40-P0-2a + L42-P0-2a (`#75 PvT who` 10 Banshees@209s):
  ;; Detect confirmed Banshee / <= 6m StarportTechLab for Stalker >= 8 + Phoenix >= 3 priority,
  ;; while keeping bare Medivac Starport at Stalker floor 6 (preserving W41 #04 PvT RoboticsBay!).
  (define protoss-confirmed-banshee-or-sptl?
    (and (eq? race 'Protoss)
         (or (>= enemy-banshee-cnt 1)
             (and (>= enemy-starport-tl-cnt 1) (<= frame 8064))
             (>= enemy-starport-tl-cnt 2))))
  (define protoss-enemy-starport-banshee-threat?
    (and (eq? race 'Protoss)
         (or protoss-confirmed-banshee-or-sptl?
             (>= enemy-starport-tl-cnt 1)
             (and (> (bldg-count-equivalent enemy-b-counts 'starport) 0)
                  (<= frame 8064)))))
  (define protoss-cloaked-air-crisis?
    (and (eq? race 'Protoss)
         (or (and enemy-cloaked-threat-active? eff-req-aa?)
             (>= enemy-banshee-cnt 1)
             enemy-air-dominant?)))
  (define terran-cloaked-det-crisis?
    (and (eq? race 'Terran)
         (or enemy-cloaked-threat-active?
             terran-enemy-banshee-starport-tl?)))
  (define protoss-shield-battery-hard-cap
    (if (or enemy-air-dominant?
            protoss-cloaked-air-crisis?
            ;; L57-B2 (`L54-1C` strictly under `>= 2` Reapers): Cap Shield Battery at 1 until >= 2 Gateways AND >= 2 Stalkers!
            (and (eq? race 'Protoss)
                 (>= enemy-reaper-cnt 2)
                 (or (< (+ (bldg-count-equivalent total-bldg-counts 'gateway)
                           (bldg-count-equivalent total-bldg-counts 'warp-gate))
                        2)
                     (< (unit-count-equivalent unit-counts 'stalker) 2))))
        1
        (min 3 (max 1 active-bases))))
  (define protoss-observer-cap
    (cond
      [(and (< army-supply 8)
            (not enemy-cloaked-threat-active?)
            (not eff-req-det?))
       0]
      [(or enemy-air-dominant?
           enemy-cap-air?
           (>= enemy-air-combat-cnt 4)
           (and (or protoss-cloaked-air-crisis? protoss-enemy-starport-banshee-threat?)
                (< (unit-count-equivalent unit-counts 'stalker) 6))
           ;; L58: In PvT with 0 Immortals/Colossi and 0 Banshees (Widow Mines / bio-tank),
           ;; cap Observers at 1 so Robo never loops Observers #2/#3 ahead of Immortal #1!
           (and (eq? enemy-race 'Terran)
                (= (+ (unit-count-equivalent unit-counts 'immortal)
                      (unit-count-equivalent unit-counts 'colossus)) 0)
                (= enemy-banshee-cnt 0)))
       1]
      [(or enemy-cloaked-threat-active? (>= active-bases 3)) 2]
      [else 1]))
  (define protoss-warp-prism-cap
    (if (or enemy-cap-air?
            enemy-air-dominant?
            eff-req-aa?
            protoss-cloaked-air-crisis?
            under-attack?
            (> enemy-threat-supply 0)
            (< active-bases 2)
            (< army-supply 20))
        0
        1))
  (define open-stargate-slots
    (if (hash? open-facility-slots)
        (hash-ref open-facility-slots 'stargate 0)
        0))
  (define open-starport-slots
    (if (hash? open-facility-slots)
        (hash-ref open-facility-slots 'starport 0)
        0))
  (define open-robo-slots
    (if (hash? open-facility-slots)
        (hash-ref open-facility-slots 'robotics-facility 0)
        0))
  (define open-gw-slots-live
    (if (hash? open-facility-slots)
        (+ (hash-ref open-facility-slots 'gateway 0)
           (hash-ref open-facility-slots 'warp-gate 0))
        0))
  (define open-larva-cnt
    (if (hash? open-facility-slots)
        (hash-ref open-facility-slots 'larva 0)
        0))
  ;; L46-P0-2b (`#73` ZvP DT CloakLoss -> 0): On scouted DarkShrine or DarkTemplar,
  ;; lock Lair -> Overseer (protecting gas from non-detector drains) + >= 8 Roaches!
  (define zerg-zvp-dt-threat?
    (and (eq? race 'Zerg)
         (or (> (unit-count-equivalent enemy-u-counts 'dark-templar) 0)
             (> (bldg-count-equivalent enemy-b-counts 'dark-shrine) 0))))
  (define zerg-zvp-dt-lair-due?
    (and zerg-zvp-dt-threat?
         (= (bldg-count-equivalent total-bldg-counts 'lair) 0)
         (= (bldg-count-equivalent total-bldg-counts 'hive) 0)
         (> (bldg-count-equivalent ready-bldg-counts 'spawning-pool) 0)
         (> (bldg-count-equivalent ready-bldg-counts 'hatchery) 0)))
  (define zerg-zvp-dt-overseer-due?
    (and zerg-zvp-dt-threat?
         has-lair-or-hive-ready?
         (< (unit-count-equivalent unit-counts 'overseer) 2)
         (> (unit-count-equivalent unit-counts 'overlord) 0)))
  (define zerg-zvp-dt-rw-due?
    (and zerg-zvp-dt-threat?
         (not zerg-zvp-dt-lair-due?)
         (= (bldg-count-equivalent total-bldg-counts 'roach-warren) 0)
         (> (bldg-count-equivalent ready-bldg-counts 'spawning-pool) 0)
         (> (bldg-count-equivalent total-bldg-counts 'spore-crawler) 0)
         (not supply-preempt-now?)))
  (define zerg-zvp-dt-roach-due?
    (and zerg-zvp-dt-threat?
         (not zerg-zvp-dt-lair-due?)
         (not (and has-lair-or-hive-ready?
                   (= (unit-count-equivalent unit-counts 'overseer) 0)))
         (> (bldg-count-equivalent ready-bldg-counts 'roach-warren) 0)
         (< (unit-count-equivalent unit-counts 'roach) 8)
         (or (not (hash? open-facility-slots)) (> open-larva-cnt 0))
         (>= gas 25)
         (not supply-preempt-now?)))
  (define (zerg-zvp-dt-defer-gas-sym? nsym)
    (and zerg-zvp-dt-threat?
         (or (and zerg-zvp-dt-lair-due? (< gas 125))
             (and has-lair-or-hive-ready?
                  (= (unit-count-equivalent unit-counts 'overseer) 0)
                  (< gas 75)))
         (memq nsym '(baneling roach ravager hydralisk evolution-chamber
                      metabolic-boost zerg-melee-weapons-1 zerg-missile-weapons-1
                      zerg-ground-armor-1 glial-reconstitution centrifugical-hooks))))
  (define ready-protoss-gateways
    (if (eq? race 'Protoss)
        (bldg-count-equivalent ready-bldg-counts 'gateway)
        0))
  (define terran-total-depots
    (if (eq? race 'Terran)
        (bldg-count-equivalent total-bldg-counts 'supply-depot)
        0))
  ;; L35-P0-2 Pillar 3 (`#41 TvZ Thessaloniki` w4=0 + `#53 TvT zig-reapers` w4=3):
  ;; Before 5:00 (`frame < 6720`), when facing `>= 3` Reapers OR `>= 12` Zerglings OR active early ground attack
  ;; (`under-attack? & army-supply < 12`, excluding air/cloak/proxy-Marauder rushes), disable
  ;; `siege-tank`/`starport`/`viking-fighter`/`orbital-command` escrow-blocking over `hellion` (`u >= 665` when
  ;; Factory ready), `marine` (`u >= 655`), and `bunker` (`u >= 640`) until `>= 4` Hellions OR `>= 10` Marines!
  ;; L60 + L61 + L61B (`#1580`/`#1615`/`#1618`/`#1641` `#53 zig-reapers`): In early TvT (`< 5:30` = `7392f`),
  ;; when `>= 3` enemy Reapers (any base/army), OR `>= 2` Reapers (1-base OR `< 6` Marine+Hellion+Cyclone
  ;; OR `< 21` workers, so Natural FE doesn't bypass defense while `l42-t-62-2reaper-factl` at 6 Marines/22W stays intact!),
  ;; OR `>= 1` Reaper `< 4:00` (`5376f`) with `< 20` workers under attack/threat, strictly defer
  ;; `engineering-bay`, `factory-techlab`, `barracks-techlab`, `armory`, `factory #2+`, and `barracks-reactor` (< 150M)
  ;; until `marine + hellion + cyclone >= 8` (or `>= 4` Hellions/Cyclones w/ Bunker)!
  (define terran-early-tvt-mass-reaper-stabilized?
    (or (>= (+ (unit-count-equivalent unit-counts 'marine)
               (unit-count-equivalent unit-counts 'hellion)
               (unit-count-equivalent unit-counts 'cyclone))
            8)
        (and (>= (+ (unit-count-equivalent unit-counts 'hellion)
                    (unit-count-equivalent unit-counts 'cyclone))
                 4)
             (>= (bldg-count-equivalent total-bldg-counts 'bunker) 1))))
  (define terran-early-tvt-mass-reaper-defer-tech?
    (and (eq? race 'Terran)
         (eq? enemy-race 'Terran)
         (< frame 7392)
         (or (>= enemy-reaper-cnt 3)
             (and (>= enemy-reaper-cnt 2)
                  (or (= active-bases 1)
                      (< (+ (unit-count-equivalent unit-counts 'marine)
                            (unit-count-equivalent unit-counts 'hellion)
                            (unit-count-equivalent unit-counts 'cyclone))
                         6)
                      (< workers 21)))
             (and (>= enemy-reaper-cnt 1)
                  (< frame 5376)
                  (< workers 20)
                  (or under-attack? (> enemy-threat-supply 0))))
         (not enemy-cloaked-threat-active?)
         (not terran-enemy-banshee-starport-tl?)
         (not enemy-air-dominated-now?)
         (not terran-early-tvt-mass-reaper-stabilized?)))
  (define terran-early-ground-rush-defense-met?
    (or (>= (unit-count-equivalent unit-counts 'hellion) 4)
        (>= (unit-count-equivalent unit-counts 'marine) 10)))
  (define terran-early-ground-rush-survival-due?
    (and (eq? race 'Terran)
         (or (< frame 6720)
             (and (eq? enemy-race 'Terran) (>= enemy-reaper-cnt 3) (< frame 7392)))
         (not terran-early-ground-rush-defense-met?)
         (not enemy-cloaked-threat-active?)
         (not terran-enemy-banshee-starport-tl?)
         (not enemy-air-dominated-now?)
         (not early-proxy-marauder-rush-active?)
         (or (>= enemy-reaper-cnt 3)
             (>= enemy-zergling-cnt 12)
             (and under-attack?
                  (< army-supply 12)
                  (= enemy-air-combat-cnt 0)
                  (< enemy-siege-tank-cnt 1)
                  ;; L42-P0-2b (`#62 SmoothBrain` TvT0Tank): Require >= 3 Reapers (or >= 4 non-Reaper ground attackers)
                  ;; before early Hellion can preempt FactoryTechLab #1, while preserving early Bunker vs 2 Reapers before Factory!
                  (or (not (eq? enemy-race 'Terran))
                      (and (>= enemy-threat-supply 4)
                           (or (>= enemy-reaper-cnt 3)
                               (>= (- enemy-ground-combat-cnt enemy-reaper-cnt) 4)))
                      (and (= (bldg-count-equivalent total-bldg-counts 'factory) 0)
                           (>= enemy-reaper-cnt 2)))))))
  (define terran-rush-survival-hellion-due?
    (and terran-early-ground-rush-survival-due?
         (> (bldg-count-equivalent ready-bldg-counts 'factory) 0)
         (or (not (hash? open-facility-slots))
             (> (hash-ref open-facility-slots 'factory 0) 0))
         (< (unit-count-equivalent unit-counts 'hellion)
            (if (and (eq? enemy-race 'Terran)
                     (= (bldg-count-equivalent total-bldg-counts 'factory-techlab) 0)
                     (< enemy-reaper-cnt 3))
                1
                4))
         (>= supply-left 2)))
  (define terran-rush-survival-marine-due?
    (and (or terran-early-ground-rush-survival-due? terran-early-reaper2-defer-oc-cc?)
         (> (bldg-count-equivalent ready-bldg-counts 'barracks) 0)
         (or (not (hash? open-facility-slots))
             (> (hash-ref open-facility-slots 'barracks 0) 0))
         (< (unit-count-equivalent unit-counts 'marine) 10)
         (>= supply-left 1)))
  ;; L63B (`#1752` Bug #1B): Remove empty-Bunker `(>= minerals 150)` / `(>= minerals 100)` bypasses;
  ;; require >= 2 Marines (>= 1 only vs >= 2 Reapers) for Bunker #1, and cap < 4:00 Bunkers at 1
  ;; unless >= 6 Marines AND under-attack?!
  (define terran-rush-survival-bunker-due?
    (and (or terran-early-ground-rush-survival-due? terran-early-reaper2-defer-oc-cc?)
         (> (bldg-count-equivalent ready-bldg-counts 'barracks) 0)
         (< (bldg-count-equivalent total-bldg-counts 'bunker)
            (if (and (or (>= frame 5376) under-attack?)
                     (>= (unit-count-equivalent unit-counts 'marine)
                         (if (< frame 5376) 6 4)))
                2
                1))
         (or (>= (unit-count-equivalent unit-counts 'marine) 2)
             (and (>= enemy-reaper-cnt 2)
                  (= (bldg-count-equivalent total-bldg-counts 'bunker) 0)
                  (>= (unit-count-equivalent unit-counts 'marine) 1)))))
  ;; L43-P0-2b (`#53 zig-reapers` >= 4 Reapers in TvT): Commit to Reactor Marines + >= 4 Hellions +
  ;; mineral-line Bunker strictly ahead of Marauder / EngineeringBay / BarracksTechLab / WidowMine / Stim / Orbital!
  (define terran-rush-survival-rax-reactor-due?
    (and terran-early-ground-rush-survival-due?
         (>= enemy-reaper-cnt 4)
         (> (bldg-count-equivalent ready-bldg-counts 'barracks) 0)
         (= (bldg-count-equivalent total-bldg-counts 'barracks-reactor) 0)
         (not (facility-addon-slot-occupied? 'barracks-reactor ready-bldg-counts total-bldg-counts #:min-ready-floor 0))
         (or (>= (bldg-count-equivalent total-bldg-counts 'bunker) 1)
             (>= (unit-count-equivalent unit-counts 'marine) 4)
             (>= (bldg-count-equivalent ready-bldg-counts 'barracks) 2))
         (>= gas 50)))
  ;; L63 (`#1704` < 4:30 TvT Reaper Hold): Unlock Factory #1 (for Hellions!) once gas >= 100
  ;; and either Bunker #1 or >= 2 Marines exist, and don't stall Orbital Command once Bunker #1
  ;; or Hellion #1 is already up!
  (define terran-early-reaper-fac1-unlock?
    (and (eq? race 'Terran)
         (eq? enemy-race 'Terran)
         (< frame 6048)
         (>= enemy-reaper-cnt 2)
         (= (bldg-count-equivalent total-bldg-counts 'factory) 0)
         (> (bldg-count-equivalent ready-bldg-counts 'barracks) 0)
         (>= gas 100)
         (or (>= (bldg-count-equivalent total-bldg-counts 'bunker) 1)
             (>= (unit-count-equivalent unit-counts 'marine) 2))))
  (define terran-reaper-oc1-unlock?
    (and (eq? race 'Terran)
         (eq? enemy-race 'Terran)
         (< frame 6048)
         (>= enemy-reaper-cnt 2)
         (= (bldg-count-equivalent total-bldg-counts 'orbital-command) 0)
         (> (bldg-count-equivalent ready-bldg-counts 'command-center) 0)
         (> (bldg-count-equivalent ready-bldg-counts 'barracks) 0)
         (or (>= (bldg-count-equivalent total-bldg-counts 'bunker) 1)
             (>= (unit-count-equivalent unit-counts 'hellion) 1))
         (>= (unit-count-equivalent unit-counts 'marine) 3)
         (not supply-preempt-now?)))
  (define (terran-rush-survival-defer-tech-sym? nsym)
    (or (and terran-early-tvt-mass-reaper-defer-tech?
             (or (memq nsym '(engineering-bay factory-techlab barracks-techlab armory))
                 (and (eq? nsym 'factory)
                      (>= (bldg-count-equivalent total-bldg-counts 'factory) 1))
                 (and (eq? nsym 'barracks-reactor)
                      (not (and terran-rush-survival-rax-reactor-due? (>= minerals 150))))))
        (and terran-early-ground-rush-survival-due?
             (or (memq nsym '(siege-tank starport viking-fighter factory-techlab
                              engineering-bay marauder widow-mine barracks-techlab
                              stimpack combat-shield concussive-shells armory))
                 (and (eq? nsym 'orbital-command)
                      (= (bldg-count-equivalent total-bldg-counts 'bunker) 0)
                      (= (unit-count-equivalent unit-counts 'hellion) 0))
                 (and (eq? nsym 'cyclone)
                      (< (unit-count-equivalent unit-counts 'hellion) 4)
                      (< minerals 200))
                 (and (eq? nsym 'refinery)
                      (>= (bldg-count-equivalent total-bldg-counts 'refinery) 1))
                 (and (eq? nsym 'barracks)
