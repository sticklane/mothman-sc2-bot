         (or (>= enemy-marauder-cnt 3)
             (and (< frame 5600) (>= enemy-marauder-cnt 2))
             (and (< frame 4480)
                  (>= enemy-early-rax-cnt 2)
                  (<= (bldg-count-equivalent enemy-b-counts 'command-center) 1)
