    (if (and (eq? race 'Terran)
             (eq? enemy-race 'Terran)
             (or (>= enemy-tvt-viking-cnt 2)
                 (>= enemy-siege-tank-cnt 3)))
        (min 20 (max 6 (+ enemy-tvt-viking-cnt 2)))
        0))
  (define terran-tvt-viking-control-due?
