             (and (eq? enemy-race 'Protoss)
                  (not enemy-cap-air?)
                  (= (unit-count-equivalent enemy-u-counts 'void-ray) 0)
                  (= (unit-count-equivalent enemy-u-counts 'oracle) 0)
