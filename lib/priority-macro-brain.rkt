  ;; Track 5: Dynamic Counter-Tech & Proactive Intel/Detection/Harass Goals
  (when (and (eq? race 'Zerg) has-lair-or-hive-ready?)
    (define cur-overseers (unit-count-equivalent unit-counts 'overseer))
