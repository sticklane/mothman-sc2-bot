                    (>= bio-cnt 6))
               (cons 878.0 #f)]
              [(and (eq? nsym 'factory)
                    (> (bldg-count-equivalent ready-bldg-counts 'barracks) 0)
                    (= (bldg-count-equivalent total-bldg-counts 'factory) 0)
                    (>= gas 100)
                    (>= army-supply 6))
               (cons 870.0 #t)]
              [(and (eq? nsym 'marauder)
                    (> (bldg-count-equivalent ready-bldg-counts 'barracks-techlab) 0))
               (cons 855.0 (>= gas 25))]
