         (memq race '(Terran Protoss))
         (not eff-req-det?)
         (not opp-cap-air-override?)
         (not (protoss-enemy-capital-air? enemy-u-counts))
         ;; L39-P0-2c + L48-P0-2a (`H2H #04 PvT`): Do not misclassify standard unbreached 2-base
