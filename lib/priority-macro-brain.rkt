      (add-goal-spec! 'baneling 'army-production 'morph baneling-cap
                      (cond
                        [(and baneling-light-bio-rec? (< cur-banelings 6)) 486.0]
                        [baneling-light-bio-rec? 474.0]
                        [(< cur-banelings 4) 472.0]
                        [else 448.0])
