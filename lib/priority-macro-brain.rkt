  ;; L27-P0-2 (`#03/#18/#21/#24/#33` Protoss W@4m 26 -> 28+): Limit Protoss to at most ONE
  ;; T2 tech structure (`robotics-facility` OR `twilight-council`, counting existing/pending
  ;; `stargate` too!) while `< 4:00` (`frame < 5376`) AND `< 30` Probes (on `<= 2` bases,
  ;; `< 450M`), so `2:00..4:00` Probes train continuously on 2 Nexuses!
  (define protoss-early-t2-cap-window?
    (and (eq? race 'Protoss)
         (<= active-bases 2)
         (< frame 5376)
         (< workers 30)
         (< minerals 450)))
  (define protoss-existing-t2-tech-cnt
    (if (eq? race 'Protoss)
        (+ (bldg-count-equivalent total-bldg-counts 'robotics-facility)
           (bldg-count-equivalent total-bldg-counts 'twilight-council)
           (bldg-count-equivalent total-bldg-counts 'stargate))
        0))
  (define (protoss-early-2nd-t2-tech-deferred? nsym [extra-t2-cnt 0])
    (and protoss-early-t2-cap-window?
         (not (and protoss-anti-tempest-pvp-due?
                   (memq nsym '(stargate twilight-council))))
         (> (+ protoss-existing-t2-tech-cnt extra-t2-cnt) 0)
         (or (eq? nsym 'twilight-council)
             (and (eq? nsym 'robotics-facility)
                  (not enemy-cloaked-threat-active?)
                  (not eff-req-det?)
                  (not early-proxy-marauder-rush-active?)))))
  (define protoss-fast-warpgate-due?
    (and (eq? race 'Protoss)
         (> (bldg-count-equivalent ready-bldg-counts 'cybernetics-core) 0)
         (or (not (hash? open-facility-slots))
             (> (hash-ref open-facility-slots 'cybernetics-core 0) 0))
         (= (hash-ref total-bldg-counts 'warp-gate 0) 0)
         (not (step-already-satisfied? 'warp-gate-research))
         (not under-early-rush-crisis?)
         (not early-ling-rush-defense-active?)
         (not early-proxy-marauder-rush-active?)
         (not protoss-early-breach-zealot-due?)
         (not protoss-early-breach-no-tech?)
         ;; L26-P0-2: NEVER escrow 50M/50G WarpGate ahead of Natural Nexus #2!
         (not (and natural-exp-window?
                   (or (not (eq? enemy-race 'Protoss))
                       (>= minerals 200))))
         (not midgame-1base-natural-due?)
         (or (>= gas 25) has-gas-income?)
         (or (not under-attack?) (>= army-supply 6))))
  (define protoss-forge-gated-off?
    (and (eq? race 'Protoss)
         (not protoss-forge-threat-exception?)
         (not (and (>= active-bases 2)
                   (>= army-supply 16)
                   (>= protoss-total-gw-cnt protoss-tech-gw-floor)))))
  ;; L61 (`#1615`/`#1618` `#42 PvZ Thessaloniki` Zergling:34, `#57 PvT Mulebot` Marine:32):
  ;; Before 3:30 (`frame < 4704`), while Protoss has `<= 4` combat units and an active enemy
  ;; ground rush is at base (excluding benign PvP opening scout & proxy-Marauder), strictly defer
  ;; `robotics-facility` (150M/100G) so Shield Battery + Stalker/Adept + Pylons deploy first!
  (define protoss-early-flood-defer-robo?
    (and (eq? race 'Protoss)
         (< frame 4704)
         (<= protoss-early-breach-combat-cnt 4)
         (not pvp-benign-opening-scout?)
         (not early-proxy-marauder-rush-active?)
         (not enemy-cloaked-threat-active?)
         (not eff-req-det?)
         (or under-attack?
             under-early-rush-crisis?
             early-ling-rush-defense-active?
             (> enemy-threat-supply 0)
             (>= (unit-count-equivalent enemy-u-counts 'zergling) 6)
             (>= (unit-count-equivalent enemy-u-counts 'marine) 4))))
  (define protoss-early-flood-battery-due?
    (and protoss-early-flood-defer-robo?
         (< (unit-count-equivalent enemy-u-counts 'reaper) 2)
         (> (bldg-count-equivalent ready-bldg-counts 'cybernetics-core) 0)
         (> (bldg-count-equivalent ready-bldg-counts 'pylon) 0)
         (= (bldg-count-equivalent total-bldg-counts 'shield-battery) 0)
         (not supply-preempt-now?)))
  (define protoss-early-flood-ranged-sym
    (if (>= gas 50) 'stalker 'adept))
  (define protoss-early-flood-ranged-due?
    (and protoss-early-flood-defer-robo?
         (> (bldg-count-equivalent ready-bldg-counts 'cybernetics-core) 0)
         (> (+ (bldg-count-equivalent ready-bldg-counts 'gateway)
               (bldg-count-equivalent ready-bldg-counts 'warp-gate))
            0)
         (or (not (hash? open-facility-slots))
             (> (+ (hash-ref open-facility-slots 'gateway 0)
                   (hash-ref open-facility-slots 'warp-gate 0))
                0))
         (>= supply-left 2)
         (not supply-preempt-now?)
         (or (>= gas 50)
             (and (>= gas 25)
                  (or (eq? enemy-race 'Zerg)
                      (>= (unit-count-equivalent enemy-u-counts 'marine) 4))))))
  (define protoss-2base-robo-due?
    (and (eq? race 'Protoss)
         (not protoss-early-flood-defer-robo?)
         (not (protoss-early-2nd-t2-tech-deferred? 'robotics-facility))
         (or (>= active-bases 2)
             (>= workers 28)
             (and (eq? enemy-race 'Zerg)
                  (or (>= total-townhalls-incl-pending 2)
                      (>= workers 22)
                      (>= frame 3136))))
         (> (bldg-count-equivalent ready-bldg-counts 'cybernetics-core) 0)
         (= (bldg-count-equivalent total-bldg-counts 'robotics-facility) 0)
         (= (bldg-count-equivalent total-bldg-counts 'stargate) 0)
         (not protoss-aa-stargate-due?)
         (>= gas 75)
         (not under-early-rush-crisis?)
         (not pvz-early-ling-zealot-pump?)
         (or (and (not under-attack?) (<= enemy-threat-supply 0))
             (and (>= army-supply 6) (>= gas 100))
             (and (eq? enemy-race 'Zerg) (>= army-supply 4) (>= gas 100)))))
  ;; L38-P0-2 (`#889`, Prod L36 `#5138250` PvZ late Robo/Immortal@356s):
  ;; Accelerate PvZ RoboticsFacility #1 (<= 155s) at u = 588.0, blk = #t (>= 75G) strictly ahead of
  ;; TwilightCouncil & Stalker #2+ gas drain once CyberCore is ready & Natural Nexus #2 is started
  ;; (or >= 22 workers / frame >= 3136 / enemy Roach/Ravager/RoachWarren), keeping CyberCore == 1!
  (define protoss-pvz-fast-robo-due?
    (and (eq? race 'Protoss)
         (eq? enemy-race 'Zerg)
         (not protoss-early-flood-defer-robo?)
         (> (bldg-count-equivalent ready-bldg-counts 'cybernetics-core) 0)
         (= (bldg-count-equivalent total-bldg-counts 'robotics-facility) 0)
         (= (bldg-count-equivalent total-bldg-counts 'stargate) 0)
         (not protoss-aa-stargate-due?)
         (not under-early-rush-crisis?)
         (not early-ling-rush-defense-active?)
         (not pvz-early-ling-zealot-pump?)
         (not protoss-early-breach-zealot-due?)
         (not protoss-early-breach-no-tech?)
         (not supply-preempt-now?)
         (not (and natural-exp-window? (< total-townhalls-incl-pending 2)))
         (or (not (protoss-early-2nd-t2-tech-deferred? 'robotics-facility))
             (>= enemy-roach-ravager-cnt 1)
             (> (bldg-count-equivalent enemy-b-counts 'roach-warren) 0))
         (or (>= total-townhalls-incl-pending 2)
             (>= workers 22)
             (>= frame 3136)
             (>= enemy-roach-ravager-cnt 1)
             (> (bldg-count-equivalent enemy-b-counts 'roach-warren) 0))
         (>= gas 75)
         (or (>= gas 100)
             (step-already-satisfied? 'warp-gate-research)
             (> (hash-ref total-bldg-counts 'warp-gate 0) 0))
         (or (and (not under-attack?) (<= enemy-threat-supply 0))
             (>= army-supply 4)
             (>= enemy-roach-ravager-cnt 1))))
  (define (protoss-pvz-fast-robo-defer-sym? nsym)
    (and protoss-pvz-fast-robo-due?
         (or (eq? nsym 'twilight-council)
             (and (eq? nsym 'stalker)
                  (>= (unit-count-equivalent unit-counts 'stalker) 1)
                  (< gas 150)
                  (not under-attack?)
                  (<= enemy-threat-supply 0)
                  (not protoss-urgent-aa-reaper-stalker-due?)))))
  ;; W12-P0-2-belief + L59 (`#1500` 9:00 Income Cliff): Pro-timed Protoss 3rd Nexus (~5:00-5:30 vs Pro 5:11)!
  ;; Keeps `protoss-3rd-nexus-pro-due?` true on safe 2-base midgame (preserving Robo Twilight cap @ 535.0),
  ;; while `exp-u` 595/625 boost yields to `protoss-colossus-core2-due?`, `protoss-midgame-colossus-due?`,
  ;; and `protoss-robo-immortal-due?` so Colossus #1/#2 & Immortal #1 are never starved!
  (define protoss-3rd-nexus-pro-due?
    (and (eq? race 'Protoss)
         (= active-bases 2)
         (= total-townhalls-incl-pending 2)
         (not under-attack?)
         (not under-early-rush-crisis?)
         (not early-rush-override-active?)
         (not early-proxy-marauder-rush-active?)
         (not early-enemy-combat-arrived?)
         (not protoss-cloaked-air-crisis?)
         (not protoss-confirmed-banshee-or-sptl?)
         (not protoss-pvz-mass-roach-immortal-lock?)
         (not (and (>= (unit-count-equivalent enemy-u-counts 'mutalisk) 2)
                   (< (unit-count-equivalent unit-counts 'phoenix) 3)))
         (<= enemy-threat-supply (* 1.25 (max 10 army-supply)))
         (>= frame 6048)
         (>= workers 34)
         (>= army-supply 10)
         (>= (bldg-count-equivalent total-bldg-counts 'gateway) 3)
         (or (>= minerals 275)
             (and (>= army-supply 20) (>= frame 7392) (<= enemy-threat-supply 0)))))
  ;; L59 (`#1500` 9:00 Income Cliff): On safe 2-base Protoss at 5:00-5:30, 3rd Nexus yields ONLY to
  ;; Colossus #1/#2, PvP Immortal cadence, armored-ground Immortal counter, or Immortal #1 (with ready
  ;; Robo + >=100G) — NOT routine Immortal #2/#3 in peaceful PvT/PvZ (which trapped 3rd Nexus to 7:24!).
  (define protoss-3rd-nexus-yields-to-robo?
    (or protoss-colossus-core2-due?
        protoss-midgame-colossus-due?
        protoss-pvp-immortal-cadence-due?
        (and protoss-robo-immortal-due?
             (or protoss-heavy-armored-ground-immortal-needed?
                 (and (= (unit-count-equivalent unit-counts 'immortal) 0)
                      (>= gas 100))))))
  ;; L49-W2 (`#1173`/`#1174` `#05 PvZ` 74 Probes trapped on 2 mined-out bases 6:32->10:40) +
  ;; L50-W1 (`#1200`/`#1201` Fix 1C `#12 PvP` 73 Probes trapped on 2 bases) +
  ;; L50-W2 (`#1212`/`#1213` W2-2 `#04 PvT`) + L51-1C (`#12 puck` 6 Phoenixes disabled Colossus yet still
  ;; blocked 3rd Nexus!): Yield to Colossus #1 ONLY when `protoss-colossus-core2-gas-guard?` is actually true,
  ;; and don't let light non-capital air trap 48+ Probes on 2 bases once >= 10 Stalkers exist!
  (define protoss-3rd-nexus-oversat-urgent?
    (and (eq? race 'Protoss)
         (= active-bases 2)
         (= total-townhalls-incl-pending 2)
         (>= workers 48)
         (>= army-supply 20)
         (not (and protoss-colossus-core2-gas-guard?
                   (= (unit-count-equivalent unit-counts 'colossus) 0)
                   (>= gas 120)))
         (not under-attack?)
         (not under-early-rush-crisis?)
         (not early-rush-override-active?)
         (not early-ling-rush-defense-active?)
         (not early-proxy-marauder-rush-active?)
         (or (not protoss-cloaked-air-crisis?)
             (and (not enemy-cloaked-threat-active?)
                  (= enemy-banshee-cnt 0)
                  (not enemy-heavy-cap-air?)
                  (>= (unit-count-equivalent unit-counts 'stalker) 10)))
         (not protoss-confirmed-banshee-or-sptl?)
         (not protoss-anti-tempest-pvp-due?)
         (not (and enemy-cloaked-threat-active?
                   (= (unit-count-equivalent unit-counts 'observer) 0)))
         (or (not enemy-air-dominated-now?)
             (and (>= (unit-count-equivalent unit-counts 'stalker) 10)
                  (not enemy-heavy-cap-air?)))
         (not enemy-heavy-cap-air?)
         (not protoss-pvz-mass-roach-immortal-lock?)
         (<= enemy-threat-supply (* 1.25 (max 20 army-supply)))))
  ;; L44/L45-P0-2a (`H2H #03 PvP` / `#04 PvT` Gateway 5-8 mineral drain fix + 3+ base unlock):
  ;; Hold Gateway #5+ ONLY on < 3 bases while Nexus #3, Immortal #4 (PvP), Colossus #2 (RoboBay up),
  ;; or pre-5:00 (< 6720f) economy is scaling without >= 350..400M surplus — NEVER throttle Gateways on >= 3 bases!
  (define protoss-gw-core-tech-hold-active?
    (and (eq? race 'Protoss)
         (< active-bases 3)
         (not protoss-anti-tempest-pvp-due?)
         (< minerals 400)
         (or protoss-pvp-immortal-cadence-due?
             protoss-colossus-core2-due?
             protoss-3rd-nexus-pro-due?
             protoss-3rd-nexus-oversat-urgent?
             (and (eq? enemy-race 'Protoss)
                  (< (unit-count-equivalent unit-counts 'immortal) 4))
             (and (> (bldg-count-equivalent total-bldg-counts 'robotics-bay) 0)
                  (< (unit-count-equivalent unit-counts 'colossus) 2))
             (and (< frame 6720)
                  (< minerals 350)))))
  (define protoss-gw-scale-defer-for-core-tech?
    (and protoss-gw-core-tech-hold-active?
         (>= (bldg-count-equivalent total-bldg-counts 'gateway) 4)))
  ;; L45-P0-2a (`H2H #04 PvT` 7b / 5GW / PkA 2,825): Hard-cap Protoss at <= 4 Nexuses
  ;; while Gateways < 8 OR standing army-supply < 75 so 400M expands never starve Gateway/army scaling!
  (define protoss-5th-plus-nexus-capped?
    (and (eq? race 'Protoss)
         (>= total-townhalls-incl-pending 4)
         (or (< (bldg-count-equivalent total-bldg-counts 'gateway) 8)
             (< army-supply 75))))
  ;; W12-P0-2-belief (#24/#12/#09) + L44/L45-P0-2a: Restore Protoss Gateway #2/#3/#4 on 2 bases (>=3:20 or after Robo/Stargate),
  ;; gate #5/#6 on 2b behind >= 5:00+36w / >= 42w+350M / anti-Tempest, and scale #6–#8 cleanly on >= 3 bases once >= 150M!
  (define protoss-midgame-gateway-scale-due?
    (and (eq? race 'Protoss)
         (not protoss-gw-scale-defer-for-core-tech?)
         (or (>= active-bases 2)
             (and (>= frame 4032)
                  (>= workers 22)
                  (or under-attack? (> enemy-threat-supply 0) (>= minerals 350))))
         (> (bldg-count-equivalent ready-bldg-counts 'cybernetics-core) 0)
         (not under-early-rush-crisis?)
         (not early-rush-override-active?)
         (not pvz-early-ling-zealot-pump?)
         (>= workers 22)
         (or (> (bldg-count-equivalent total-bldg-counts 'robotics-facility) 0)
             (> (bldg-count-equivalent total-bldg-counts 'stargate) 0)
             protoss-anti-tempest-pvp-due?
             (>= frame 4480)
             (>= workers 26))
         (let* ([cur-gw (bldg-count-equivalent total-bldg-counts 'gateway)]
                [open-gw open-gw-slots-live]
                [tgt-gw (min protoss-gateway-hard-cap
                             (cond
                               [(or (>= active-bases 3)
                                    (and (>= workers 52) (>= minerals 350)))
                                8]
                               [(or protoss-anti-tempest-pvp-due?
                                    (and (>= active-bases 2) (>= frame 6720) (>= workers 36))
                                    (and (>= workers 42) (>= minerals 350)))
                                6]
                               [(or (>= workers 24) (>= frame 4480))
                                4]
                               [else 3]))])
           (and (< cur-gw tgt-gw)
                ;; Preserve W6-P0-2: on 2-base before 5:00 with 5 Gateways already & 0 Forge (unlocked),
                ;; drop Forge #1 before Gateway #6 (Gateway #6 fires immediately after or at >=5:00 / 3b!).
                (not (and (>= cur-gw 5)
                          (< active-bases 3)
                          (< frame 6720)
                          (not protoss-anti-tempest-pvp-due?)
                          (= (bldg-count-equivalent total-bldg-counts 'forge) 0)
                          (not protoss-forge-gated-off?)))
                (or (<= open-gw 0)
                    (and (< cur-gw 4) (>= minerals 150))
                    (and protoss-anti-tempest-pvp-due? (<= open-gw 1) (>= minerals 175))
                    (and (>= active-bases 3) (< cur-gw 8) (>= minerals 150))
                    (and (<= open-gw 1) (< cur-gw 6) (>= minerals 175))
                    (>= minerals (if (< cur-gw 6) 200 250)))))))
  ;; W6-P0-1b-belief (#1) + W7-P0-3-belief + W11-P0-1-belief (#16/#28): Unconditional Zerg Hatchery caps:
  ;; <= 4 Hatches until army-supply >= 45, and <= 5 hard cap ALWAYS!
  (define zerg-air-tech-needed?
    (or enemy-cap-air? opp-cap-air-override? eff-req-aa? keep-spire-aa?
        zvp-stargate-threat? enemy-air-dominant? (> enemy-air-combat-cnt 0)))
  ;; L25-P0-2 (`#19/#25/#31`): Prevent Zerg quad-tech bloat (LurkerDen + InfestationPit + Burrow
  ;; + 2nd Evo + non-AA Spire -> u <= 420, blk = #f) whenever < 3 Hatcheries OR < 20 combat supply!
  (define (zerg-quad-tech-deferred-sym? nsym)
    (and (eq? race 'Zerg)
         (or (< total-townhalls-incl-pending 3)
             (< army-supply 20)
             (and (eq? nsym 'spire)
                  (> (bldg-count-equivalent total-bldg-counts 'hydralisk-den) 0)
                  (< army-supply 24)))
         (or (memq nsym '(lurker-den infestation-pit burrow))
             (and (eq? nsym 'evolution-chamber)
                  (>= (bldg-count-equivalent total-bldg-counts 'evolution-chamber) 1))
             (and (eq? nsym 'spire)
                  (if (> (bldg-count-equivalent total-bldg-counts 'hydralisk-den) 0)
                      ;; L58: Once HydraDen is started/ready, defer 200M/200G Spire on <3 bases
                      ;; or <24 army unless true Capital Air / air-dominant Spire lock!
                      (not (or enemy-cap-air? opp-cap-air-override? enemy-air-dominant? zerg-cap-air-spire-due?))
                      (not zerg-air-tech-needed?))))))
  (define zerg-hard-hatch-cap?
    (and (eq? race 'Zerg)
         (>= total-townhalls-incl-pending 5)))
  (define zerg-4base-hatch-capped?
    (or zerg-hard-hatch-cap?
        (and (eq? race 'Zerg)
             (>= (max active-bases total-townhalls-incl-pending) 4)
             (< army-supply 45))))
  ;; W7-P0-4 + W8-P0-2 + L58: Zerg at-most-one of roach-warren / baneling-nest on < 3 bases
  ;; (or < 24 army supply) even under attack (except >= 10 Marines exempted via `zerg-anti-bio-baneling-nest-due?`),
  ;; Pro 3rd Hatchery (~28-32W / ~180-220s), and peaceful early Queens (2-3 by 4m).
  (define zerg-2base-second-t15-tech-blocked?
    (and (eq? race 'Zerg)
         (or (< active-bases 3)
             (< army-supply 24))))
  ;; L62 (`#1660` `#64 ZvZ Clicadinha`): Against heavy ZvZ Roach/Ravager mass (`>= 8`, `0` air/cloak),
  ;; cap Zergling over-investment and block BanelingNest/Baneling/MeleeWeapons/extra Spine#2+/Spore#2+,
  ;; redirecting economy directly into Roach Warren + Roach/Ravager parity!
  (define zerg-zvz-heavy-roach-enemy?
    (and (eq? race 'Zerg)
         (eq? enemy-race 'Zerg)
         (>= enemy-roach-ravager-cnt 8)
         (= enemy-air-combat-cnt 0)
         (not enemy-cloaked-threat-active?)
         (not enemy-air-dominated-now?)))
  (define (zerg-zvz-heavy-roach-deferred-sym? nsym)
    (and zerg-zvz-heavy-roach-enemy?
         (not (emergency-cloak-det-boost-info nsym))
         (or (memq nsym '(baneling-nest baneling
                          zerg-melee-weapons-1 zerg-melee-weapons-2 zerg-melee-weapons-3))
             (and (eq? nsym 'spine-crawler)
                  (>= (bldg-count-equivalent total-bldg-counts 'spine-crawler) 1))
             (and (eq? nsym 'spore-crawler)
                  (>= (bldg-count-equivalent total-bldg-counts 'spore-crawler) 1))
             (and (eq? nsym 'zergling)
                  (> (bldg-count-equivalent ready-bldg-counts 'roach-warren) 0)
                  (or (>= gas 25)
                      (>= (unit-count-equivalent unit-counts 'zergling) 10))))))
  (define zerg-zvz-heavy-roach-rw-due?
    (and zerg-zvz-heavy-roach-enemy?
         (= (bldg-count-equivalent total-bldg-counts 'roach-warren) 0)
         (> (bldg-count-equivalent ready-bldg-counts 'spawning-pool) 0)))
  ;; L62B (`#1680` Fix 4): Cap ZvZ Roach/Ravager parity boost once Zerg has >= 8 Roaches+Ravagers
  ;; OR ready Hydralisk Den OR HydraDen transition due — and keep its floor strictly below
  ;; `lair` (`472.0` / `585.0`), `hydralisk-den` (`468.0` / `560.0`), and `hydralisk` (`518.0`)!
  (define zerg-zvz-heavy-roach-unit-due?
    (and zerg-zvz-heavy-roach-enemy?
         (> (bldg-count-equivalent ready-bldg-counts 'roach-warren) 0)
         (< (+ (unit-count-equivalent unit-counts 'roach)
               (unit-count-equivalent unit-counts 'ravager))
            8)
         (= (bldg-count-equivalent ready-bldg-counts 'hydralisk-den) 0)
         (not zerg-zvz-midgame-hydraden-due?)
         (not supply-preempt-now?)))
  (define zerg-3rd-hatch-pro-due?
    (and (eq? race 'Zerg)
         (= active-bases 2)
         (= total-townhalls-incl-pending 2)
         (not under-attack?)
         (not under-early-rush-crisis?)
         (or (not early-enemy-combat-arrived?)
             (<= enemy-threat-supply 2))
         (<= enemy-threat-supply (* 1.25 (max 6 army-supply)))
         (> (bldg-count-equivalent total-bldg-counts 'spawning-pool) 0)
         (if (memq enemy-race '(Protoss Terran))
             (or (>= workers 24)
                 (and (>= frame 3808) (>= workers 22)))
             (or (>= workers 28)
                 (and (>= frame 4032) (>= workers 24))))))
  ;; L49-W1B + L59 + L59C (`#1566` Fix #3 — `#011 ZeroKill`):
  ;; In ZvP/ZvT, require `roach-warren` built/in-progress (or early safe `< 2:00` / `2688f`) BEFORE
  ;; boosting 3rd Hatch (`u=608.0`) above `roach-warren` (`555`) — never starve `roach-warren` until 6:00!
  (define zerg-3rd-hatch-rw-ready-or-early?
    (or (eq? enemy-race 'Zerg)
        (< frame 2688)
        (> (bldg-count-equivalent total-bldg-counts 'roach-warren) 0)))
  (define zerg-3rd-hatch-pro-u
    (if (and zerg-3rd-hatch-pro-due?
             zerg-3rd-hatch-rw-ready-or-early?
             (not zerg-anti-bio-baneling-nest-due?)
             (memq enemy-race '(Protoss Terran))
             (or (> (bldg-count-equivalent total-bldg-counts 'roach-warren) 0)
                 (>= minerals 160)
                 (>= workers 26)
                 (>= frame 3920)))
        608.0
        505.0))
  ;; Defer premature unpressured 2-base BanelingNest (< 4:30 unless early Bio/Zealot/Adept/Ling pressure),
  ;; EvolutionChamber (< 3 bases & < 5:00), and Lair (< 3 bases & < 5:00 unless air/cloak threat) behind 3rd Hatch!
  (define zerg-early-light-ground-pressure?
    (and (eq? race 'Zerg)
         (or zerg-enemy-heavy-bio?
             (>= (+ (unit-count-equivalent enemy-u-counts 'marine)
                    (unit-count-equivalent enemy-u-counts 'zealot)
                    (unit-count-equivalent enemy-u-counts 'adept)
                    (unit-count-equivalent enemy-u-counts 'zergling))
                 4)
             under-attack?
             under-early-rush-crisis?
             early-ling-rush-defense-active?)))
  (define zerg-2base-defer-baneling-nest?
    (and (eq? race 'Zerg)
         (memq enemy-race '(Protoss Terran))
         (not zerg-early-light-ground-pressure?)
         (not zerg-anti-bio-baneling-nest-due?)
         (or (< frame 6048)
             (and (< total-townhalls-incl-pending 3) (< frame 7392)))))
  (define zerg-2base-defer-evo-for-3rd-hatch?
    (and (eq? race 'Zerg)
         (memq enemy-race '(Protoss Terran))
         (< total-townhalls-incl-pending 3)
         (or (< frame 6720)
             (< workers 36))
         (not under-attack?)
         (not under-early-rush-crisis?)
         (not zerg-cloaked-air-crisis?)
         (not enemy-air-dominant?)))
  ;; L53-1B + L55-M1 (`#07`/`#52`/`#16`/`#25`):
  ;; Boost `ZvT` `Lair` (`u = 525.0`, `blk = #t` — above `queen@518`/`drone@488`, strictly below
  ;; `roach-warren@555` & `3rd-hatch@595`) once `workers >= 26`, `gas >= 100`, `frame >= 3696` (2:45)
  ;; on `>= 2` bases, ONLY when unpressured (`not under-attack?`, `not early-rush-override-active?`,
  ;; `< 2` Reapers) and grounded (`army-supply >= 8` or `roach-warren > 0`)!
  (define zerg-zvt-early-lair-due?
    (and (eq? race 'Zerg)
         (eq? enemy-race 'Terran)
         (>= active-bases 2)
         (>= workers 26)
         (>= frame 3696)
         (>= gas 100)
         (> (bldg-count-equivalent ready-bldg-counts 'spawning-pool) 0)
         (> (bldg-count-equivalent ready-bldg-counts 'hatchery) 0)
         (= (bldg-count-equivalent total-bldg-counts 'lair) 0)
         (= (bldg-count-equivalent total-bldg-counts 'hive) 0)
         (or (>= army-supply 8)
             (> (bldg-count-equivalent total-bldg-counts 'roach-warren) 0))
         (< enemy-reaper-cnt 2)
         (not under-attack?)
         (not early-rush-override-active?)
         (not zerg-anti-bio-baneling-nest-due?)
         (not supply-preempt-now?)
         (not under-early-rush-crisis?)
         (not early-worker-rush-active?)
         (not early-ling-rush-defense-active?)
         (<= enemy-threat-supply (max 4.0 army-supply))
         (not (and (< total-townhalls-incl-pending 3) (>= frame 10000) (>= gas 600) (< minerals 400)))))
  (define zerg-2base-defer-lair-for-3rd-hatch?
    (and (eq? race 'Zerg)
         (memq enemy-race '(Protoss Terran))
         (< total-townhalls-incl-pending 3)
         (< frame 6720)
         (not zerg-zvt-early-lair-due?)
         (not zerg-cloaked-air-crisis?)
         (not zerg-zvt-banshee-aa-rush?)
         (not zerg-zvp-dt-lair-due?)
         (not zerg-cap-air-spire-due?)
         (not (dyn-plan-ctx-keep-spire-aa? dp-ctx))
         (not enemy-air-dominant?)
         (not enemy-cap-air?)
         (not opp-cap-air-override?)
         (not eff-req-aa?)
         (not eff-req-det?)
         (not enemy-cloaked-threat-active?)))
  (define (zerg-2base-3rd-hatch-deferred-sym? sym)
    (define nsym (normalize-brain-sym sym))
