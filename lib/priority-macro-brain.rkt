         (not under-early-rush-crisis?)
         (<= enemy-threat-supply 0)
         (>= workers 16)
         (< (unit-count-equivalent unit-counts 'queen) zerg-early-pro-queen-target)
         (or (and (< frame 4928) (>= minerals 75))
             (and (< frame 6272)
                  (> army-supply 0)
