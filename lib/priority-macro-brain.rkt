           (and nd (> (sc2-tech-node-gas-cost nd) 0)))))
  ;; W12-P0-4-belief (#28): Build HydraliskDen IMMEDIATELY on Lair finish vs Air threats before Spire!
  (define zerg-air-hydraden-before-spire?
