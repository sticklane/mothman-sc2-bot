;; Select the best targetable enemy unit for `attacker-type` within weapon domain
;; (filters out untargetable projectiles/larva/eggs, enforces air/ground weapon
;; domain matching, de-prioritizes passive scouts/decoys/interceptors/broodlings
;; when real threats exist, and prioritizes Light/Bio clumps for Banelings).
(define PREP-LIGHT-XS (make-flvector 256))
(define PREP-LIGHT-YS (make-flvector 256))

(define (prep-enemy-target-descriptors enemy-units include-nearby-light?)
  (define-values (light-xs light-ys light-cnt)
    (if include-nearby-light?
        (let* ([n (length enemy-units)]
               [cap (flvector-length PREP-LIGHT-XS)]
               [xs (if (<= n cap) PREP-LIGHT-XS (make-flvector n))]
               [ys (if (<= n cap) PREP-LIGHT-YS (make-flvector n))])
          (let loop ([rem enemy-units] [cnt 0])
            (if (null? rem)
                (values xs ys cnt)
                (let ([o (car rem)])
                  (if (bitwise-bit-set? (fast-enemy-sym-flags (unit-type-sym o)) 6)
                      (let ([ox-raw (hash-ref o 'x 0.0)]
                            [oy-raw (hash-ref o 'y 0.0)])
                        (flvector-set! xs cnt (if (flonum? ox-raw) ox-raw (exact->inexact ox-raw)))
                        (flvector-set! ys cnt (if (flonum? oy-raw) oy-raw (exact->inexact oy-raw)))
                        (loop (cdr rem) (add1 cnt)))
                      (loop (cdr rem) cnt))))))
        (values #f #f 0)))
  (let loop ([rem enemy-units] [rev '()])
    (if (null? rem)
        (reverse rev)
        (let* ([e (car rem)]
               [et (unit-type-sym e)]
               [flags (fast-enemy-sym-flags et)])
          (if (or (bitwise-bit-set? flags 0)
                  (eq? (hash-ref e 'hallucination #f) #t))
              (loop (cdr rem) rev)
              (let* ([ex-raw (hash-ref e 'x 9999.0)]
                     [ey-raw (hash-ref e 'y 9999.0)]
                     [ex (if (flonum? ex-raw) ex-raw (exact->inexact ex-raw))]
                     [ey (if (flonum? ey-raw) ey-raw (exact->inexact ey-raw))]
                     [eflying?
                      (or (bitwise-bit-set? flags 8)
                          (eq? (hash-ref e 'is-flying #f) #t)
                          (eq? (hash-ref e 'flying? #f) #t)
                          (eq? (hash-ref e 'flying #f) #t))]
                     [hp-raw (hash-ref e 'hp 100.0)]
                     [hp
                      (cond
                        [(and (flonum? hp-raw) (fl= (fl- hp-raw hp-raw) 0.0)) hp-raw]
                        [(exact-integer? hp-raw) (->fl hp-raw)]
                        [else (exact->inexact (fast-finite-real hp-raw 100.0))])]
                     [changeling?
                      (or (bitwise-bit-set? flags 1)
                          (eq? (hash-ref e 'changeling? #f) #t))]
                     [mobile-det? (bitwise-bit-set? flags 2)]
                     [static-det? (bitwise-bit-set? flags 3)]
                     [passive? (bitwise-bit-set? flags 4)]
                     [struct? (bitwise-bit-set? flags 5)]
                     [light-bio? (bitwise-bit-set? flags 6)]
                     [armored? (bitwise-bit-set? flags 7)]
                     [base-adj
                      (fl+ (if changeling? -220.0 0.0)
                           (if struct? 30.0 0.0))]
                     [adj-plain
                      (if passive? (fl+ base-adj 250.0) base-adj)]
                     [adj-stealth
                      (fl+ base-adj
                           (fl+ (if (or mobile-det? static-det?) -180.0 0.0)
                                (if (and passive? (not mobile-det?)) 250.0 0.0)))]
                     [bane-light-bonus
                      (if (and include-nearby-light? light-bio?)
                          (let jloop ([j 0] [cnt 0])
                            (if (= j light-cnt)
                                (fl- -45.0 (fl* 12.0 (->fl cnt)))
                                (let ([dx (fl- ex (flvector-ref light-xs j))])
                                  (if (fl<= (flabs dx) 2.2)
                                      (let ([dy (fl- ey (flvector-ref light-ys j))])
                                        (jloop (add1 j)
                                               (if (fl<= (fl+ (fl* dx dx) (fl* dy dy)) 4.84)
                                                   (add1 cnt)
                                                   cnt)))
                                      (jloop (add1 j) cnt)))))
                          (if (or armored? struct?) 80.0 0.0))])
                (loop (cdr rem)
                      (cons (vector e ex ey eflying? hp adj-plain adj-stealth bane-light-bonus) rev))))))))

(define (select-target-enemy-from-prepped ux uy prepped [attacker-type 'marine] [ally-has-stealth? #f])
  (define baneling-attacker? (eq? attacker-type 'baneling))
  (define stealth-active?
    (or ally-has-stealth?
        (hash-ref RUNTIME-STEALTH-SET attacker-type #f)))
  (define can-air? (fast-can-attack-air? attacker-type))
  (define can-gnd? (fast-can-attack-ground? attacker-type))
  (define fx (if (flonum? ux) ux (exact->inexact ux)))
  (define fy (if (flonum? uy) uy (exact->inexact uy)))
  (define focus-r (if (flonum? SC2-ENGAGEMENT-FOCUS-FIRE-RADIUS)
                      SC2-ENGAGEMENT-FOCUS-FIRE-RADIUS
                      (exact->inexact SC2-ENGAGEMENT-FOCUS-FIRE-RADIUS)))
  (define focus-r2 (fl* focus-r focus-r))
  (let loop ([rem prepped]
             [best-valid #f]
             [best-valid-sc +inf.0]
             [best-any #f]
             [best-any-sc +inf.0])
    (if (null? rem)
        (if best-valid
            (values best-valid #t)
            (values best-any #f))
        (let* ([v (car rem)]
               [eflying? (vector-ref v 3)]
               [valid? (if eflying? can-air? can-gnd?)])
          (if (or valid? (not best-valid))
              (let* ([ex (vector-ref v 1)]
                     [ey (vector-ref v 2)]
                     [dx (fl- ex fx)]
                     [dy (fl- ey fy)]
                     [d2 (fl+ (fl* dx dx) (fl* dy dy))]
                     [adj-base (if stealth-active? (vector-ref v 6) (vector-ref v 5))]
                     [adj (if baneling-attacker? (fl+ adj-base (vector-ref v 7)) adj-base)]
                     [cur-best (if valid? best-valid-sc best-any-sc)]
                     [hp (vector-ref v 4)]
                     [pruned?
                      (and (fl< cur-best +inf.0)
                           (if (fl> d2 focus-r2)
                               (let ([margin (fl- cur-best (fl+ adj (fl+ 100.0 (fl* 0.02 hp))))])
                                 (or (fl<= margin 0.0)
                                     (fl> (fl* 16.0 d2) (fl* margin margin))))
                               (let ([margin (fl- cur-best (fl+ adj (fl* 0.05 hp)))])
                                 (or (fl<= margin 0.0)
                                     (fl> (fl* 4.0 d2) (fl* margin margin))))))])
                (if pruned?
                    (loop (cdr rem) best-valid best-valid-sc best-any best-any-sc)
                    (let* ([e (vector-ref v 0)]
                           [d (flsqrt d2)]
                           [sc (fl+ adj
                                    (if (fl<= d focus-r)
                                        (fl+ (fl* 2.0 d) (fl* 0.05 hp))
                                        (fl+ 100.0 (fl+ (fl* 4.0 d) (fl* 0.02 hp)))))])
                      (if valid?
                          (if (fl< sc best-valid-sc)
                              (loop (cdr rem) e sc best-any best-any-sc)
                              (loop (cdr rem) best-valid best-valid-sc best-any best-any-sc))
                          (if (fl< sc best-any-sc)
                              (loop (cdr rem) best-valid best-valid-sc e sc)
                              (loop (cdr rem) best-valid best-valid-sc best-any best-any-sc))))))
              (loop (cdr rem) best-valid best-valid-sc best-any best-any-sc))))))

(define (select-target-enemy-for-unit ux uy enemy-units [attacker-type 'marine] [ally-has-stealth? #f])
  (define baneling-attacker? (eq? attacker-type 'baneling))
  (define prepped (prep-enemy-target-descriptors enemy-units baneling-attacker?))
  (define-values (tgt _valid?)
    (select-target-enemy-from-prepped ux uy prepped attacker-type ally-has-stealth?))
  tgt)


