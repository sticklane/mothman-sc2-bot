        (tel-keep-push! 'escrow-suppressed-until-frame 0))
      (tel-push! 'repaired-prereqs (hash-ref last-tel-ht 'priority-repaired-prereqs '()))
      (tel-push! 'unwalled-opponent-posterior b-unwalled-post)
      (tel-push! 'proxy-all-in-posterior b-proxy-post)
      (tel-push! 'multi-prong-window-posterior b-multi-prong-post)
      (tel-push! 'vanguard-count vanguard-cnt)
      (tel-push! 'reserve-count reserve-cnt)
      (tel-push! 'role-leases (rt-role-leases rt))
      (tel-push! 'wall-reserved-aabbs step-wall-aabbs)
      (tel-push! 'personality (let ([p (mastermind-state-personality mstate)])
                                (cond
                                  [(bot-personality? p) (bot-personality-name p)]
                                  [(symbol? p) p]
                                  [else 'UNKNOWN])))
      (tel-push! 'pda-bucket (diagnose-bot-anomaly pda))
      (if (null? tel-chgs)
          th
          (apply hash-set* th tel-chgs))))

  (define rt-pos-cache (rt-enemy-pos-cache rt))
  (define rt-valid-tags (ensure-rt-valid-enemy-tags! rt obs))
  (define final-actions
    (sanitize-stale-target-actions
     (append accepted preserved-tactical-directives pro-apm-acts)
     obs
     #:pos-cache rt-pos-cache
     #:precomputed-valid-tags rt-valid-tags))
  (define final-mirror-actions
    (sanitize-stale-target-actions
     mirror-acts
     obs
     #:pos-cache rt-pos-cache
     #:precomputed-valid-tags rt-valid-tags))

  ;; Structured step state log (`lib/sc2-logging.rkt`) — defer heavy Bayesian posteriors & snapshot allocation
  ;; until `should-emit-step-log?` fires (every 22 frames or on posture / build-goal transitions).
  (define step-frame (safe-nonneg-int (hash-ref obs 'frame 0) 0))
  (define prev-state-log (hash-ref last-tel-ht 'state-log #f))
  (define prev-mind-posture
    (and (hash? prev-state-log)
         (let ([m (hash-ref prev-state-log 'mind #f)])
           (and (hash? m) (hash-ref m 'posture #f)))))
  (define prev-goal-sym
    (and (hash? prev-state-log)
         (let ([g (hash-ref prev-state-log 'goals #f)])
           (and (hash? g) (hash-ref g 'active-bo-goal-sym #f)))))
  (define cur-mind-posture (live-bot-runtime-posture rt))
  (define cur-goal-sym
    (let* ([raw-ag (hash-ref telemetry0 'bo-active-goal #f)]
           [def-sym (if (pro-bo-goal? raw-ag) (pro-bo-goal-target-sym raw-ag) 'none)]
           [ps (hash-ref telemetry0 'priority-summary #f)]
           [sf (if (hash? ps) (hash-ref ps 'saving-for 'none) 'none)])
      (cond
        [(symbol? sf) sf]
        [(and (string? sf) (> (string-length sf) 0)) (string->symbol sf)]
        [else def-sym])))
  ;; Accumulate shimmer alerts & addon swaps across frames between 22-frame state-log emissions.
  (define frame-shimmer-cnt
    (for/sum ([a (in-list tactic-acts)])
      (if (and (pair? a)
               (memq (car a) '(blind-skillshot-shimmer emergency-detector-response shimmer-alert)))
          1
          0)))
  (define frame-addon-cnt
    (for/sum ([a (in-list econ-acts)])
      (if (and (pair? a) (memq (car a) '(terran-addon-swap swap-addon))) 1 0)))
  (when (> frame-shimmer-cnt 0)
    (hash-set! door-st-cache 'win-shimmer-alerts
               (+ (hash-ref door-st-cache 'win-shimmer-alerts 0) frame-shimmer-cnt)))
  (when (> frame-addon-cnt 0)
    (hash-set! door-st-cache 'win-swapped-addons
               (+ (hash-ref door-st-cache 'win-swapped-addons 0) frame-addon-cnt)))
  (define state-changed?
    (or (not (hash? prev-state-log))
        (not (eq? prev-mind-posture cur-mind-posture))
        (not (eq? prev-goal-sym cur-goal-sym))))
  (define emit-state-log?
    (should-emit-step-log? step-frame 22 state-changed?))
  (define-values (state-log-hash state-log-line)
    (cond
      [(or emit-state-log? (not (hash? prev-state-log)))
       (define step-our-race (live-bot-runtime-actual-race rt))
       (define step-enemy-race
         (let ([tel-er (hash-ref telemetry0 'effective-enemy-race #f)]
               [box-er (unbox (rt-enemy-race-box rt))])
           (cond
             [(memq tel-er '(Zerg Terran Protoss)) tel-er]
             [(memq box-er '(Zerg Terran Protoss)) box-er]
             [else (hash-ref obs 'enemy-race (hash-ref obs 'opponent-requested-race 'Random))])))
       (define step-matchup (resolve-matchup-symbol step-our-race step-enemy-race))
       (define mmact (mirror-mind-state-last-action-reading mmstate))
       (define enemy-units-obs (hash-ref obs 'enemy-units '()))
       (define enemy-bldgs-obs (hash-ref obs 'enemy-buildings '()))
       (define ally-units-obs (hash-ref obs 'ally-units '()))
       (define combat-enemy-cnt
         (for/sum ([e (in-list enemy-units-obs)])
           (if (and (hash? e) (combat-unit-record? e)) 1 0)))
       (define bluff-post
         (compute-bayesian-bluff-posterior
          enemy-units-obs
          enemy-bldgs-obs
          mmtech
          mmledger
          #:prior 0.08
          #:opponent-scouted-us? (or (mirror-mind-state-ever-scouted-by-enemy? mmstate)
                                     (and mmact (action-lens-reading-opponent-scouted-us? mmact) #t))))
       (define bayes-priors
         (evaluate-strategic-posteriors-from-signals
          #:bluff-prior 0.08
          #:bluff-posterior bluff-post
          #:frame step-frame
          #:combat-count combat-enemy-cnt
          #:unaccounted-minerals (if (shadow-ledger? mmledger) (safe-finite-real (shadow-ledger-unaccounted-minerals mmledger) 0.0) 0.0)
          #:unaccounted-gas (if (shadow-ledger? mmledger) (safe-finite-real (shadow-ledger-unaccounted-gas mmledger) 0.0) 0.0)
          #:dark-matter-hypothesis (if (shadow-ledger? mmledger) (shadow-ledger-dark-matter-hypothesis mmledger) 'accounted-visible-macro)
          #:predicted-enemy-bases (if (shadow-ledger? mmledger) (safe-nonneg-int (shadow-ledger-predicted-enemy-bases mmledger) 1) 1)
          #:feint-or-poke-detected? (and mmact (action-lens-reading-feint-or-poke-detected? mmact) #t)
          #:proxy-or-rush-detected? (and mmact (action-lens-reading-proxy-or-rush-detected? mmact) #t)
          #:branch-posteriors (hash)))
       (define self-army-val
         (max 0.0 (safe-finite-real (hash-ref obs 'army-supply
                                              (lambda ()
                                                (for/sum ([u (in-list ally-units-obs)])
                                                  (if (and (hash? u) (combat-unit-record? u)) 1 0))))
                                    0.0)))
       (define enemy-army-val
         (max 0.0 (safe-finite-real (hash-ref obs 'enemy-threat-supply combat-enemy-cnt) 0.0)))
       (define mm-sig-ht (and mmstate (mirror-mind-state-signals-ht mmstate)))
       (define mm-wp (and (hash? mm-sig-ht) (hash-ref mm-sig-ht 'win-prob #f)))
       (define mm-sb (and (hash? mm-sig-ht) (hash-ref mm-sig-ht 'snowball-adv #f)))
       (define win-prob-est
         (if (and (real? mm-wp) (rational? mm-wp))
             (max 0.0 (min 1.0 (exact->inexact mm-wp)))
             (max 0.0 (min 1.0 (/ 1.0 (+ 1.0 (exp (* -0.025 (safe-finite-real fap-score 0.0)))))))))
       (define snowball-adv
         (if (and (real? mm-sb) (rational? mm-sb))
             (exact->inexact mm-sb)
             (/ (lanchester-snowball-advantage self-army-val enemy-army-val) 20.0)))
       (define prio-sum (hash-ref telemetry0 'priority-summary (hash)))
       (define escrow-blocked-ids
         (for/list ([d (in-list (hash-ref prio-sum 'decisions '()))]
                    #:when (and (hash? d)
                                (memq (hash-ref d 'outcome 'none) '(blocked-by-escrow escrowed-saving))
                                (hash-ref d 'id #f)))
           (hash-ref d 'id #f)))
       (define burrowed-cnt
         (for/sum ([u (in-list ally-units-obs)])
           (if (and (hash? u)
                    (or (eq? (hash-ref u 'burrowed #f) #t)
                        (eq? (hash-ref u 'is-burrowed #f) #t)
                        (hash-ref ZERG-SHALLOW-BURROW-SET (unit-type-sym u) #f)))
               1
               0)))
       (define shimmer-cnt (hash-ref door-st-cache 'win-shimmer-alerts 0))
       (define addon-cnt (hash-ref door-st-cache 'win-swapped-addons 0))
       (hash-set! door-st-cache 'win-shimmer-alerts 0)
       (hash-set! door-st-cache 'win-swapped-addons 0)
       ;; Map safest owned landed Town Hall and natural ramp into 8x8 sectors (0..63) for dynamic retreat-sector.
       (define map-w-sec (max 64.0 (safe-finite-real (hash-ref obs 'map-width 200.0) 200.0)))
       (define map-h-sec (max 64.0 (safe-finite-real (hash-ref obs 'map-height 200.0) 200.0)))
       (define (coord->sector8 px py)
         (define col (min 7 (max 0 (inexact->exact (floor (* 8.0 (/ (exact->inexact px) map-w-sec)))))))
         (define row (min 7 (max 0 (inexact->exact (floor (* 8.0 (/ (exact->inexact py) map-h-sec)))))))
         (+ (* row 8) col))
       (define log-base-x (exact->inexact (hash-ref obs 'base-x 32.0)))
       (define log-base-y (exact->inexact (hash-ref obs 'base-y 32.0)))
       (define log-enemy-x (exact->inexact (hash-ref obs 'enemy-x 160.0)))
       (define log-enemy-y (exact->inexact (hash-ref obs 'enemy-y 160.0)))
       (define log-nat-x (exact->inexact (hash-ref obs 'nat-x (+ log-base-x (* 0.18 (- log-enemy-x log-base-x))))))
       (define log-nat-y (exact->inexact (hash-ref obs 'nat-y (+ log-base-y (* 0.18 (- log-enemy-y log-base-y))))))
       (define owned-th-recs
         (for/list ([b (in-list (hash-ref obs 'ally-buildings '()))]
                    #:when (and (hash? b)
                                (not (eq? (hash-ref b 'flying #f) #t))
                                (not (eq? (hash-ref b 'is-flying #f) #t))
                                (memq (fast-canonical-structure-sym (unit-type-sym b))
                                      '(hatchery lair hive nexus command-center orbital-command planetary-fortress))))
           b))
       (define-values (safest-th-sec safe-th-secs)
         (if (null? owned-th-recs)
             (let ([bs (coord->sector8 log-base-x log-base-y)]
                   [ns (coord->sector8 log-nat-x log-nat-y)])
               (values bs (remove-duplicates (list bs ns))))
             (let* ([scored
                     (for/list ([th (in-list owned-th-recs)])
                       (define tx (exact->inexact (hash-ref th 'x log-base-x)))
                       (define ty (exact->inexact (hash-ref th 'y log-base-y)))
                       (define e-thr
                         (for/sum ([e (in-list enemy-units-obs)]
                                   #:when (and (hash? e) (combat-unit-record? e)))
                           (if (<= (fast-dist2d tx ty (hash-ref e 'x 9999.0) (hash-ref e 'y 9999.0)) 16.0)
                               1.0 0.0)))
                       (define a-def
                         (for/sum ([u (in-list ally-units-obs)]
                                   #:when (and (hash? u) (combat-unit-record? u)))
                           (if (<= (fast-dist2d tx ty (hash-ref u 'x 9999.0) (hash-ref u 'y 9999.0)) 14.0)
                               1.0 0.0)))
                       (cons (- a-def (* 2.5 e-thr)) (coord->sector8 tx ty)))]
                    [best-pair (argmax car scored)]
                    [nat-sec (coord->sector8 log-nat-x log-nat-y)]
                    [nat-safe?
                     (zero? (for/sum ([e (in-list enemy-units-obs)]
                                      #:when (and (hash? e) (combat-unit-record? e)))
                              (if (<= (fast-dist2d log-nat-x log-nat-y (hash-ref e 'x 9999.0) (hash-ref e 'y 9999.0)) 14.0)
                                  1 0)))])
               (values (if (and (>= (length owned-th-recs) 2) nat-safe?)
                           nat-sec
                           (cdr best-pair))
                       (remove-duplicates (append (map cdr scored) (if nat-safe? (list nat-sec) '())))))))
       (define dyn-retreat-sector
         (best-retreat-sector (live-bot-runtime-perception rt) safest-th-sec safe-th-secs))
       (define state-rec
         (extract-bot-step-log-record
          (hash 'frame step-frame
                'race step-our-race
                'enemy-race step-enemy-race
                'matchup step-matchup
                'posture cur-mind-posture
                'personality (hash-ref telemetry0 'personality 'default)
                'experiment-id (hash-ref telemetry0 'experiment-id #f)
                'experiment-tag (hash-ref telemetry0 'experiment-tag #f)
                'enemy-archetype (mastermind-state-enemy-archetype mstate)
                'win-prob win-prob-est
                'confidence (mirror-mind-state-overall-accuracy mmstate)
                'bluff-posterior (bayesian-strategic-priors-bluff-posterior bayes-priors)
                'rush-posterior (apply-worker-rush-posterior-floor
                                 (bayesian-strategic-priors-rush-posterior bayes-priors)
                                 (and rt (opponent-world-model-last-summary (rt-opponent-world-model rt))))
                'hidden-expand-posterior (bayesian-strategic-priors-hidden-expand-posterior bayes-priors)
                'tech-switch-posterior (bayesian-strategic-priors-tech-switch-posterior bayes-priors)
                'pad-camped-posterior (hash-ref telemetry0 'pad-camped-posterior 0.0))
          (hash 'active-bo-goal (hash-ref telemetry0 'bo-active-goal #f)
                'saving-for (hash-ref prio-sum 'saving-for 'none)
                'reserved-min-floor (hash-ref prio-sum 'reserved-min-floor 0)
                'reserved-gas-floor (hash-ref prio-sum 'reserved-gas-floor 0)
                'target-workers (hash-ref telemetry0 'target-workers 0)
                'target-army-supply (hash-ref telemetry0 'target-army-supply 0)
                'scheduled-ids (hash-ref prio-sum 'scheduled-ids '())
                'escrow-blocked-ids escrow-blocked-ids)
          (hash 'combat-posture (hash-ref telemetry0 'fap-posture 'hold)
                'snowball-adv snowball-adv
                'retreat-sector dyn-retreat-sector
                'burrowed-count burrowed-cnt
                'shimmer-alerts shimmer-cnt
                'swapped-addons addon-cnt
                'issued-orders (length final-actions))))
       (values (bot-step-log-record->hash state-rec)
               (if emit-state-log? (format-bot-step-log-line state-rec) ""))]
      [else (values prev-state-log "")]))
  (define step-elapsed-us
    (max 0.0 (* 1000.0 (- (current-inexact-monotonic-milliseconds) t0-step-ms))))
  ;; Loop 66 Phase C1: Compact arbiter telemetry & cross-step feedback flags for wire codec
  (define arb-ledger-step (rt-arbiter-ledger rt))
  (define arb-sum-step (arbiter-telemetry-summary arb-ledger-step))
  (define arb-ov-total (hash-ref arb-sum-step 'total-overrides 0))
  (define arb-top-pairs (hash-ref arb-sum-step 'top-pairs '()))
  (define arb-top-reason
    (if (pair? arb-top-pairs) (second (first arb-top-pairs)) 'none))
  (define step-gas-starvation-boost?
    (>= (arbiter-recent-override-count arb-ledger-step 'l2-macro-runtime 'budget-gas step-frame #:window-frames 224) 3))
  (define step-apm-pressure-backoff?
    (>= (arbiter-recent-override-count arb-ledger-step 'l2-macro-runtime 'apm-cap-deferred step-frame #:window-frames 112) 3))
  (define telemetry
    (hash-set* telemetry0
               'step-elapsed-us step-elapsed-us
               'state-log state-log-hash
               'state-log-line state-log-line
               'arbiter-overrides arb-ov-total
               'arbiter-top-reason arb-top-reason))
  (set-live-bot-runtime-last-telemetry! rt telemetry)
  (hash 'actions final-actions
        'mirror-actions final-mirror-actions
        'telemetry telemetry
        'posture (live-bot-runtime-posture rt)
        'actual-race (live-bot-runtime-actual-race rt)
        'role-leases (rt-role-leases rt)
        'wall-reserved-aabbs step-wall-aabbs
        'watchdog-expand-ring-syms (hash-ref door-st-cache 'watchdog-expand-ring-syms '())
        'gas-starvation-boost? step-gas-starvation-boost?
        'apm-pressure-backoff? step-apm-pressure-backoff?
        'arbiter-ledger arb-ledger-step))

;; =============================================================================
;; S-Expression Wire Parser for `sim/racket_sc2_ipc_bot.rkt`
;; =============================================================================

(define (parse-unit-tuple tup)
  (match tup
    [(list id type x y hp energy)
     (sanitize-unit-record
      (hash 'id id 'type type 'x x 'y y 'hp hp 'energy energy)
      32.5 32.5)]
    [(list id type x y hp)
     (sanitize-unit-record
      (hash 'id id 'type type 'x x 'y y 'hp hp)
      32.5 32.5)]
    [(? hash? h) (sanitize-unit-record h 32.5 32.5)]
    [_ (hash 'id 101 'type 'zergling 'x 32.5 'y 32.5 'hp 35)]))

(define (parse-bldg-tuple tup)
  (match tup
    [(list id type x y hp-pct build-prog halted-flag)
     (define spct (max 0.0 (min 1.0 (safe-finite-real hp-pct 1.0))))
     (sanitize-bldg-record
      (hash 'id id
            'type type
            'x x
            'y y
            'hp (max 1 (safe-exact-int (* 500.0 spct) 500))
            'hp-pct spct
            'build-progress (max 0.0 (min 1.0 (safe-finite-real build-prog 1.0)))
            'halted (eq? halted-flag #t))
      32.5 32.5)]
    [(list id type x y hp)
     (sanitize-bldg-record
      (hash 'id id 'type type 'x x 'y y 'hp hp)
      32.5 32.5)]
    [(? hash? h) (sanitize-bldg-record h 32.5 32.5)]
    [_ (hash 'id 201 'type 'hatchery 'x 32.5 'y 32.5 'hp 1500)]))

(define (parse-effect-tuple tup)
  (match tup
    [(list type x y)
     (sanitize-effect-record (hash 'type type 'x x 'y y))]
    [(? hash? h) (sanitize-effect-record h)]
    [_ (hash 'type 'none 'x 0.0 'y 0.0)]))

(define (parse-order-tuple tup)
  (match tup
    [(list uid ab-id tx ty)
     (hash 'unit-id uid 'ability-id ab-id 'target-x tx 'target-y ty)]
    [(list uid ab-id)
     (hash 'unit-id uid 'ability-id ab-id)]
    [(? hash? h) h]
    [_ (hash)]))

(define (parse-frame-state-sexp sexp)
  (match sexp
    [(cons 'frame-state kvs)
     (define h (make-hash))
     (let loop ([rem (if (list? kvs) kvs '())])
       (match rem
         [(list* k v rest)
          (define key-str (if (keyword? k) (keyword->string k) (format "~a" k)))
          (case (string->symbol key-str)
            [(frame)          (hash-set! h 'frame (safe-nonneg-int v 0))]
            [(race)           (hash-set! h 'race v)]
            [(minerals)       (hash-set! h 'minerals (safe-nonneg-int v 0))]
            [(gas)            (hash-set! h 'gas (safe-nonneg-int v 0))]
            [(supply-used)    (hash-set! h 'supply-used (safe-nonneg-int v 12))]
            [(supply-cap)     (hash-set! h 'supply-cap (min 200 (safe-nonneg-int v 15)))]
            [(supply-left)    (hash-set! h 'supply-left (safe-nonneg-int v 0))]
            [(pending-supply) (hash-set! h 'pending-supply (safe-nonneg-int v 0))]
            [(start-pos)
             (when (and (list? v) (>= (length v) 2))
               (hash-set! h 'base-x (safe-coord (first v) 32.5))
               (hash-set! h 'base-y (safe-coord (second v) 32.5)))]
            [(natural-pos)
             (when (and (list? v) (>= (length v) 2))
               (hash-set! h 'natural-x (safe-coord (first v) 45.0))
               (hash-set! h 'natural-y (safe-coord (second v) 45.0)))]
            [(third-pos)
             (when (and (list? v) (>= (length v) 2))
               (hash-set! h 'third-x (safe-coord (first v) 60.5))
               (hash-set! h 'third-y (safe-coord (second v) 40.5)))]
            [(enemy-base)
             (when (and (list? v) (>= (length v) 2))
               (hash-set! h 'enemy-x (safe-coord (first v) 160.5))
               (hash-set! h 'enemy-y (safe-coord (second v) 160.5)))]
            [(enemy-expand-pos)
             (when (and (list? v) (>= (length v) 2))
               (hash-set! h 'enemy-expand-x (safe-coord (first v) 148.0))
               (hash-set! h 'enemy-expand-y (safe-coord (second v) 148.0)))]
            [(researched-upgrades)
             (hash-set! h 'researched-upgrades (if (list? v) (filter symbol? v) '()))]
            [(pending-upgrades)
             (hash-set! h 'pending-upgrades (if (list? v) (filter symbol? v) '()))]
            [(depleting-bases)
             (hash-set! h 'depleting-bases (safe-nonneg-int v 0))]
            [(mineral-harvesters)
             (hash-set! h 'mineral-harvesters (safe-nonneg-int v 0))]
            [(ideal-mineral-harvesters)
             (hash-set! h 'ideal-mineral-harvesters (safe-nonneg-int v 0))]
            [(gas-harvesters)
             (hash-set! h 'gas-harvesters (safe-nonneg-int v 0))]
            [(ideal-gas-harvesters)
             (hash-set! h 'ideal-gas-harvesters (safe-nonneg-int v 0))]
            [(busy-facilities)
             (hash-set! h 'busy-facilities (safe-nonneg-int v 0))]
            [(busy-townhalls)
             (hash-set! h 'busy-townhalls (safe-nonneg-int v 0))]
            [(army-supply)
             (hash-set! h 'army-supply (safe-nonneg-int v 0))]
            [(in-progress-orders)
             (hash-set! h 'in-progress-orders (if (list? v) (map parse-order-tuple v) '()))]
            [(enemy-race)             (hash-set! h 'enemy-race v)]
            [(opponent-requested-race)(hash-set! h 'opponent-requested-race v)]
            [(map-grids)              (when (hash? v) (hash-set! h 'map-grids v))]
            [(expansion-candidates)   (when (list? v) (hash-set! h 'expansion-candidates v))]
            [(my-units)       (hash-set! h 'ally-units (if (list? v) (map parse-unit-tuple v) '()))]
            [(my-buildings)   (hash-set! h 'ally-buildings (if (list? v) (map parse-bldg-tuple v) '()))]
            [(enemy-units)    (hash-set! h 'enemy-units (if (list? v) (map parse-unit-tuple v) '()))]
            [(enemy-buildings)(hash-set! h 'enemy-buildings (if (list? v) (map parse-bldg-tuple v) '()))]
            [(effects)        (hash-set! h 'effects (if (list? v) (map parse-effect-tuple v) '()))])
          (loop rest)]
         [_ (void)]))
     (sanitize-obs-hash h)]
    [_ (sanitize-obs-hash (hash))]))

(define (runtime-step-sexp! rt sexp)
  (define res (step-live-bot-runtime! rt sexp))
  (append (hash-ref res 'mirror-actions '())
          (hash-ref res 'actions '())))
