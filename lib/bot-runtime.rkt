    (if maybe-harass-raid?
        (filter (lambda (u)
                  (define ut (unit-type-sym u))
                  (and (memq ut '(zergling marine zealot reaper adept hellion oracle phoenix mutalisk banshee))
                       (not (and p6-ling-hold-active? (eq? (fast-canonical-unit-sym ut) 'zergling)))
                       (not (and p6-zealot-pocket-active? (eq? (fast-canonical-unit-sym ut) 'zealot)))
                       (not (harass-unit-busy-or-engaged? u))))
                combat-units)
        '()))
  ;; W15-P0-2-rt: Include ALL mobile/retreatable harass units (`reaper`, `hellion`, `banshee`,
  ;; `oracle`, `phoenix`, `adept`, `mutalisk`, Blink-researched `stalker`, small `<=8` `zergling`
  ;; runbys) in `dedicated-harass-units` and NEVER block them with `fog-belief-suppress?`!
  (define fog-only-suppress-harass? (l34-ctx-fog-belief-suppress? ctx))
  (define p6-staging-active?
    (and live-obs?
         (hash? (l34-ctx-l34-sc ctx))
         (hash-ref (l34-ctx-l34-sc ctx) 'l58-staging-active? #f)))
  (define raw-dedicated-harass-units
    (if maybe-harass-raid?
        (filter (lambda (u)
                  (define ut (unit-type-sym u))
                  (and (not (memq ut '(medivac warp-prism warp-prism-phasing)))
                       (not (and p6-ling-hold-active? (eq? (fast-canonical-unit-sym ut) 'zergling)))
                       (not (and p6-zealot-pocket-active? (eq? (fast-canonical-unit-sym ut) 'zealot)))
                       (if fog-only-suppress-harass?
                           (l34-solo-harass-exempt-unit? ctx u)
                           (l34-mobile-retreatable-unit? ctx u))
                       (not (harass-unit-busy-or-engaged? u))))
                combat-units)
        '()))
  ;; L58: Stop 1-unit home-side dedicated harass trickles in live full-matches (require real pack sizes
  ;; at home `<= 36t` from Main for Zergling >= 6, Hellion >= 4, Mutalisk >= 6, Adept >= 2; already-deployed
  ;; forward raiders `> 36t` from Main and single Oracle/Banshee/Reaper cross freely!).
  (define dedicated-harass-units
    (if (and p6-staging-active? (pair? raw-dedicated-harass-units))
        (let ([type-cnts
               (for/fold ([ht (hasheq)]) ([u (in-list raw-dedicated-harass-units)])
                 (define c (fast-canonical-unit-sym (unit-type-sym u)))
                 (hash-set ht c (add1 (hash-ref ht c 0))))])
          (filter (lambda (u)
                    (define c (fast-canonical-unit-sym (unit-type-sym u)))
                    (define ux0 (exact->inexact (hash-ref u 'x base-x)))
                    (define uy0 (exact->inexact (hash-ref u 'y base-y)))
                    (define already-forward? (> (fast-dist2d ux0 uy0 (exact->inexact base-x) (exact->inexact base-y)) 36.0))
                    (or already-forward?
                        (case c
                          [(zergling) (>= (hash-ref type-cnts 'zergling 0) 6)]
                          [(hellion)  (>= (hash-ref type-cnts 'hellion 0) 4)]
                          [(mutalisk) (>= (hash-ref type-cnts 'mutalisk 0) 6)]
                          [(adept)    (>= (hash-ref type-cnts 'adept 0) 2)]
                          [else #t])))
                  raw-dedicated-harass-units))
        raw-dedicated-harass-units))
  (define allow-harass-raid?
    (and (not endgame-hunt-active?)
         maybe-harass-raid?
         (not (l34-ctx-under-tactics-base-attack? ctx))
         (if live-obs?
             (or (and (not combat-suppress-attack?)
                      (hash-ref obs 'enable-economic-disruption #f))
                 (and (not combat-suppress-attack?)
                      bo-fork-active?
                      (>= (length cheap-blockers) 2)
                      (refractory-allow-action?! (live-bot-runtime-cooldown-tracker rt)
                                                 '(live-harass-raid)
                                                 frame
                                                 336))
                 (and (pair? dedicated-harass-units)
                      (or (not combat-suppress-attack?) fog-only-suppress-harass?)
                      (not (l34-ctx-enemy-near-home? ctx))
                      (refractory-allow-action?! (live-bot-runtime-cooldown-tracker rt)
                                                 '(live-harass-raid-dedicated)
                                                 frame
                                                 196))
                 (and (not combat-suppress-attack?)
                      (>= live-combat-supply 18)
                      (>= (length cheap-blockers) 3)
                      (refractory-allow-action?! (live-bot-runtime-cooldown-tracker rt)
                                                 '(live-harass-raid)
                                                 frame
                                                 280)))
             (or (and (pair? dedicated-harass-units)
                      (or (not combat-suppress-attack?) fog-only-suppress-harass?)
                      (not (l34-ctx-enemy-near-home? ctx)))
                 (and (not combat-suppress-attack?)
                      (or (hash-ref obs 'enable-economic-disruption #f)
                          (and bo-fork-active? (>= (length cheap-blockers) 2))
                          (>= cur-intel-staleness 224)
                          (eq? mm-verdict 'punish-And-Deny-Greedy-Expand)
                          (>= (length cheap-blockers) 3)))))))
  (when (and allow-harass-raid?
             (or (pair? cheap-blockers)
                 (pair? dedicated-harass-units)))
    (define hx (if bo-fork-active? bo-sx enemy-x))
    (define hy (if bo-fork-active? bo-sy enemy-y))
    (cond
      [(and (pair? dedicated-harass-units)
            (or live-obs? fog-only-suppress-harass?))
       (define ded-ids
         (map (lambda (u) (hash-ref u 'id 111))
              (take dedicated-harass-units (min (if fog-only-suppress-harass? 8 3)
                                                (length dedicated-harass-units)))))
       (for ([did (in-list ded-ids)])
         (when (and (exact-integer? did) (> did 0))
           (set-add! wave3-handled-tags did)))
       (l34-emit! ctx (list 'harass-workers ded-ids hx hy))]
      [else
       (define blocker (car cheap-blockers))
       (define bid (hash-ref blocker 'id 110))
       (if (eq? (unit-type-sym blocker) 'zergling)
           (l34-emit! ctx (list 'burrow-block bid enemy-exp-x enemy-exp-y))
           (l34-emit! ctx (list 'patrol-block-expansion bid enemy-exp-x enemy-exp-y)))
       (when (>= (length cheap-blockers) 2)
         (define raider-ids
           (map (lambda (u) (hash-ref u 'id 111))
                (take (cdr cheap-blockers) (min 3 (length (cdr cheap-blockers))))))
         (l34-emit! ctx (list 'harass-workers raider-ids hx hy)))]))

  (when (and (not endgame-hunt-active?)
             bo-rally-override?
             (null? enemy-units)
             (or (not live-obs?) (null? enemy-bldgs))
             (pair? combat-units)
             (or (not live-obs?)
                 (refractory-allow-action?! (live-bot-runtime-cooldown-tracker rt)
                                            '(bo-timing-rally)
                                            frame
                                            28)))
    (define bo-march-units
      (for/list ([u (in-list combat-units)]
                 #:when (let* ([uid (hash-ref u 'id -1)]
                               [ut (unit-type-sym u)]
                               [ux (exact->inexact (hash-ref u 'x base-x))]
                               [uy (exact->inexact (hash-ref u 'y base-y))]
                               [dx (- ux fbo-rally-tx)]
                               [dy (- uy fbo-rally-ty)])
                          (and (not (set-member? wave3-handled-tags uid))
                               (not (set-member? splash-evading-tags uid))
                               (not (set-member? disruptor-handled-tags uid))
                               (not (set-member? tbrain-committed-tags uid))
                               (not (memq ut '(overlord overseer observer warp-prism warp-prism-phasing medivac queen)))
                               (> (+ (* dx dx) (* dy dy)) 36.0))))
        u))
    (when (pair? bo-march-units)
      (if (<= (length bo-march-units) 8)
          (for ([u (in-list bo-march-units)])
            (l34-emit! ctx (list 'attack-pos (hash-ref u 'id 110) bo-rally-tx bo-rally-ty)))
          (l34-emit! ctx (list 'attack-pos
                       (map (lambda (u) (hash-ref u 'id 110)) bo-march-units)
                       bo-rally-tx
                       bo-rally-ty)))))

  ;; L48-W2 (Post-Fight Counter-Attack After Surviving Heavy Worker Rush):
  ;; Once `>= 8` pure enemy workers committed early (`< 4500f`) and `< 4` remain within `32t`
  ;; of our base with `0` enemy combat units, immediately send `>= 2` Zealots / `>= 6` Zerglings /
  ;; `>= 2` Marines straight to `(enemy-x, enemy-y)` to finish the empty enemy main!
  (when (and live-obs? (not endgame-hunt-active?) rt)
    (define rush-st-p6 (rt-rush-defense-state rt))
    (define-values (p6-home-ew-cnt p6-home-ec-cnt)
      (for/fold ([wc 0] [cc 0]) ([e (in-list enemy-units)])
        (if (and (hash? e)
                 (real? (hash-ref e 'x #f)) (real? (hash-ref e 'y #f))
                 (<= (fast-dist2d (exact->inexact base-x) (exact->inexact base-y)
                                  (exact->inexact (hash-ref e 'x 9999.0))
                                  (exact->inexact (hash-ref e 'y 9999.0)))
                     32.0))
            (if (memq (fast-canonical-unit-sym (unit-type-sym e)) '(probe scv drone))
                (values (add1 wc) cc)
                (if (combat-unit-record? e)
                    (values wc (add1 cc))
                    (values wc cc)))
            (values wc cc))))
    (when (and (< frame 4500) (= p6-home-ec-cnt 0) (>= p6-home-ew-cnt 8))
      (hash-set! rush-st-p6 'saw-heavy-worker-rush? #t))
    (when (and (eq? (hash-ref rush-st-p6 'saw-heavy-worker-rush? #f) #t)
               (< p6-home-ew-cnt 4)
               (= p6-home-ec-cnt 0))
      (hash-set! rush-st-p6 'survived-heavy-worker-rush? #t))
    (when (or (>= frame 6720) (>= p6-home-ec-cnt 3))
      (hash-set! rush-st-p6 'survived-heavy-worker-rush? #f))
    (when (and (eq? (hash-ref rush-st-p6 'survived-heavy-worker-rush? #f) #t)
               (< frame 6720)
               (< p6-home-ew-cnt 4)
               (= p6-home-ec-cnt 0)
               (pair? combat-units))
      (define-values (zlt-c lng-c mar-c)
        (for/fold ([z 0] [l 0] [m 0]) ([u (in-list combat-units)])
          (case (fast-canonical-unit-sym (unit-type-sym u))
            [(zealot) (values (add1 z) l m)]
            [(zergling) (values z (add1 l) m)]
            [(marine) (values z l (add1 m))]
            [else (values z l m)])))
      (when (or (>= zlt-c 2) (>= lng-c 6) (>= mar-c 2))
        (for ([u (in-list combat-units)])
          (define uid (hash-ref u 'id -1))
          (define ut (fast-canonical-unit-sym (unit-type-sym u)))
          (when (and (> uid 0)
                     (memq ut '(zealot zergling marine stalker adept roach reaper))
                     (not (set-member? wave3-handled-tags uid))
                     (not (set-member? splash-evading-tags uid))
                     (not (set-member? disruptor-handled-tags uid))
                     (not (set-member? tbrain-committed-tags uid)))
            (set-add! wave3-handled-tags uid)
            (l34-emit-preserved! ctx (list 'attack-pos uid enemy-x enemy-y)))))))

  (when (and (not endgame-hunt-active?)
             (null? enemy-units)
             (not bo-rally-override?)
             (not combat-suppress-attack?)
             (or (not live-obs?)
                 (and (null? enemy-bldgs)
                      (< (length combat-units) live-attack-wave-min)
                      (refractory-ready? (live-bot-runtime-cooldown-tracker rt)
                                         '(idle-nat-rally)
                                         frame
                                         44))))
    (define idle-rally-candidates
      (filter (lambda (u) (not (set-member? wave3-handled-tags (hash-ref u 'id -1))))
              combat-units))
    (when (and (>= (length idle-rally-candidates) 2)
               (or (not live-obs?)
                   (refractory-allow-action?! (live-bot-runtime-cooldown-tracker rt)
                                              '(idle-nat-rally)
                                              frame
                                              44)))
      (for ([u (in-list (take idle-rally-candidates 2))])
        (l34-emit! ctx (list 'attack-pos (hash-ref u 'id 110) nat-x nat-y)))))

  ;; L20-P0-3 / L25-P0-3 (`DRIP_FEED_COLLAPSE 12 -> <= 4`): While staging for cross-map mass
  ;; parity OR defensive ground counter-volley (enemy outside Main mineral line), rally scattered
  ;; reinforcements cohesively via `attack-pos` ONLY (never passive `move` -> `OBRet = 0`!) to
  ;; our safe defensive muster point (Main ramp when Natural/3rd camped, else Natural/3rd)!
  (define l25-cv-stage-p6?
    (and live-obs?
         (hash? (l34-ctx-l34-sc ctx))
         (hash-ref (l34-ctx-l34-sc ctx) 'l25-counter-volley-staging? #f)
         (not (hash-ref (l34-ctx-l34-sc ctx) 'l25-enemy-within-14-of-main? #f))))
  (when (and live-obs?
             (not endgame-hunt-active?)
             (or l25-cv-stage-p6?
                 (and (not (l34-ctx-enemy-within-14-of-th? ctx))
                      (hash? (l34-ctx-l34-sc ctx))
                      (hash-ref (l34-ctx-l34-sc ctx) 'l20-mass-staging-active? #f)))
             (pair? combat-units)
             (refractory-ready? (live-bot-runtime-cooldown-tracker rt)
                                '(l20-mass-stage-rally)
                                frame
                                44))
    (define use-third-stage? (>= (or (l34-ctx-live-owned-townhalls ctx) 1) 3))
    (define-values (stage-x stage-y)
      (if (l34-ctx-enemy-within-14-of-th? ctx)
          (let* ([fbx (exact->inexact base-x)]
                 [fby (exact->inexact base-y)]
                 [dx (fl- (exact->inexact nat-x) fbx)]
                 [dy (fl- (exact->inexact nat-y) fby)]
                 [d (flmax 1.0 (flsqrt (fl+ (fl* dx dx) (fl* dy dy))))]
                 [step (flmin 5.0 (fl* 0.35 d))])
            (values (safe-coord (fl+ fbx (fl* step (fl/ dx d))) base-x)
                    (safe-coord (fl+ fby (fl* step (fl/ dy d))) base-y)))
          (if use-third-stage?
              (values (l34-ctx-third-x ctx) (l34-ctx-third-y ctx))
              (values nat-x nat-y))))
    (define fstage-x (exact->inexact stage-x))
    (define fstage-y (exact->inexact stage-y))
    (define stage-vis-enemy-pts
      (if (pair? enemy-units)
          (for/list ([e (in-list enemy-units)]
                     #:when (and (hash? e)
                                 (combat-unit-record? e)
                                 (not (eq? (hash-ref e 'snapshot? #f) #t))
                                 (eqv? (hash-ref e 'display-type 1) 1)
                                 (real? (hash-ref e 'x #f))
                                 (real? (hash-ref e 'y #f))))
            (cons (exact->inexact (hash-ref e 'x 0.0))
                  (exact->inexact (hash-ref e 'y 0.0))))
          '()))
    (define stage-cands
      (for/list ([u (in-list combat-units)]
                 #:when (let* ([uid (hash-ref u 'id -1)]
                               [ut (unit-type-sym u)]
                               [ux (exact->inexact (hash-ref u 'x base-x))]
                               [uy (exact->inexact (hash-ref u 'y base-y))])
                          (and (> uid 0)
                               (not (set-member? wave3-handled-tags uid))
                               (not (set-member? splash-evading-tags uid))
                               (not (set-member? disruptor-handled-tags uid))
                               (not (set-member? tbrain-committed-tags uid))
                               (not (l34-solo-harass-exempt-unit? ctx u))
                               (not (memq ut '(overlord overseer observer warp-prism warp-prism-phasing medivac queen
                                               carrier swarm-host swarm-host-mp
                                               siege-tank-sieged widow-mine-burrowed lurker-burrowed liberator-ag)))
                               (not (for/or ([ep (in-list stage-vis-enemy-pts)])
                                      (fl<= (fast-dist2d ux uy (car ep) (cdr ep)) 14.0)))
                               (not (l34-within-r2? ux uy fstage-x fstage-y 100.0 10.0)))))
        u))
    (when (pair? stage-cands)
      (when (refractory-allow-action?! (live-bot-runtime-cooldown-tracker rt)
                                       '(l20-mass-stage-rally)
                                       frame
                                       44)
        (if (<= (length stage-cands) 8)
            (for ([u (in-list stage-cands)])
              (l34-emit! ctx (list 'attack-pos (hash-ref u 'id 110) stage-x stage-y)))
            (l34-emit! ctx (list 'attack-pos
                                 (map (lambda (u) (hash-ref u 'id 110)) stage-cands)
                                 stage-x
                                 stage-y))))))

  ;; L23-P0-3 (`#16` Visual-QA): Rally charged idle Zerg Vipers (`energy >= 75`) out of the
  ;; main base corner to rejoin our main non-caster combat army even between fights!
  (when (and live-obs?
             (not endgame-hunt-active?)
             (pair? combat-units))
    (define-values (v-list army-sx army-sy army-cnt)
      (for/fold ([vs '()] [sx 0.0] [sy 0.0] [cnt 0])
                ([u (in-list combat-units)])
        (define ut (unit-type-sym u))
        (cond
          [(and (eq? ut 'viper)
                (>= (hash-ref u 'energy 0) 75)
                (not (set-member? wave3-handled-tags (hash-ref u 'id -1)))
                (not (set-member? splash-evading-tags (hash-ref u 'id -1))))
           (values (cons u vs) sx sy cnt)]
          [(not (memq ut '(viper infestor infestor-burrowed queen overseer overseer-siege-mode overlord-transport)))
           (define cx0 (hash-ref u 'x #f))
           (define cy0 (hash-ref u 'y #f))
           (if (and (real? cx0) (real? cy0))
               (values vs (fl+ sx (exact->inexact cx0)) (fl+ sy (exact->inexact cy0)) (add1 cnt))
               (values vs sx sy cnt))]
          [else (values vs sx sy cnt)])))
    (when (pair? v-list)
      (define vtx
        (if (>= army-cnt 2)
            (safe-coord (fl/ army-sx (exact->inexact army-cnt)) nat-x)
            (if (>= (or (l34-ctx-live-owned-townhalls ctx) 1) 3) third-x nat-x)))
      (define vty
        (if (>= army-cnt 2)
            (safe-coord (fl/ army-sy (exact->inexact army-cnt)) nat-y)
            (if (>= (or (l34-ctx-live-owned-townhalls ctx) 1) 3) third-y nat-y)))
      (define fvtx (exact->inexact vtx))
      (define fvty (exact->inexact vty))
      (for ([vu (in-list v-list)])
        (define vid (hash-ref vu 'id -1))
        (define vx (exact->inexact (hash-ref vu 'x base-x)))
        (define vy (exact->inexact (hash-ref vu 'y base-y)))
        (when (and (> vid 0)
                   (not (l34-within-r2? vx vy fvtx fvty 144.0 12.0))
                   (refractory-allow-action?! (live-bot-runtime-cooldown-tracker rt)
                                              (list 'l23-viper-rally vid)
                                              frame
                                              32))
          (l34-emit! ctx (list 'move vid vtx vty))))))

  ;; ---------------------------------------------------------------------------
  ;; Pro Mechanic #9: Enemy Changeling Sniping & Active Deception/Scout Spells
  ;; ---------------------------------------------------------------------------
  (for ([ec (in-list enemy-changelings)])
    (l34-emit! ctx (list 'snipe-enemy-changeling (hash-ref ec 'id 9099))))

  (when has-ally-roach?
    (for ([ba (in-list (execute-roach-tunneling-burrow-micro obs))])
      (l34-emit! ctx ba)))
  (when (not (null? ally-infestors))
    ;; W8-TAC-2: Never emit Neural Parasite (249) from `execute-infestor-burrow-cast-micro`
    ;; when the `'neural-parasite` upgrade (id=101) has not been researched!
    (define infestor-neural-ok? (l34-has-upgrade? ctx 'neural-parasite))
    (for ([ia (in-list (execute-infestor-burrow-cast-micro obs))])
      (unless (or (and (not infestor-neural-ok?)
                       (pair? ia)
                       (memq (car ia) '(infestor-burrow-cast cast-spell))
                       (>= (length ia) 3)
                       (eq? (third ia) 'neural-parasite))
                  (and live-obs?
                       (pair? ia)
                       (>= (length ia) 2)
                       (set-member? wave3-handled-tags (second ia))))
        (l34-emit! ctx ia))))
  (define has-ripple-or-shimmer?
    (or enemy-unit-shimmer?
        (let ([rs (hash-ref obs 'shimmer-and-burrow-ripples #f)])
          (and (list? rs) (pair? rs)))))
  (when has-ripple-or-shimmer?
    ;; W12-P0-4-rt (`w12-tac-1`): Exclude already-revealed (`buff=49` / `cloak=2`) enemies and
    ;; casters that already emitted a spell this tick (`wave3-handled-tags` / `oracle-cast-tags`)
    ;; so `blind-skillshot-shimmer` never double-casts Revelation (2146) or spams buff-49 DTs!
    (define (enemy-already-revealed? e)
      (and (hash? e)
           (or (eqv? (hash-ref e 'cloak 0) 2)
               (eq? (hash-ref e 'cloak #f) 'cloaked-detected)
               (let ([bfs (hash-ref e 'buffs '())])
                 (and (list? bfs)
                      (for/or ([b (in-list bfs)])
                        (or (eqv? b 49) (eq? b 'oracle-revelation) (eq? b 'revelation))))))))
    (define shimmer-oracle-tags (l34-ctx-oracle-cast-tags ctx))
    (define shimmer-ally-units
      (for/list ([u (in-list ally-units)]
                 #:when (let ([uid (and (hash? u) (hash-ref u 'id -1))])
                          (and (exact-integer? uid)
                               (not (set-member? wave3-handled-tags uid))
                               (not (set-member? shimmer-oracle-tags uid)))))
        u))
    (define shimmer-enemy-units
      (for/list ([e (in-list enemy-units)]
                 #:when (not (enemy-already-revealed? e)))
        e))
    (define shimmer-obs
      (if live-obs?
          (hash-set* obs 'ally-units shimmer-ally-units 'enemy-units shimmer-enemy-units)
          obs))
    (define shimmer-acts (execute-shimmer-and-burrow-ripple-response shimmer-obs))
    (define resolved-shimmer-acts
      (if (pair? shimmer-acts)
          shimmer-acts
          (let ([synth-ripples
                 (for/list ([e (in-list (if live-obs? shimmer-enemy-units enemy-units))]
                            #:when (and (hash? e)
                                        (not (and live-obs? (enemy-already-revealed? e)))
                                        (or (hash-ref e 'is-shimmer? #f)
                                            (hash-ref e 'cloaked #f)
                                            (hash-ref e 'is-cloaked? #f)
                                            (hash-ref e 'burrowed #f)
                                            (hash-ref e 'is-burrowed? #f)
                                            (memq (hash-ref e 'display-type 1) '(2 hidden))
                                            (memq (hash-ref e 'cloak-state 0) (if live-obs? '(1 cloaked) '(2 cloaked cloaked-detected)))
                                            (memq (hash-ref e 'cloak 0) (if live-obs? '(1 cloaked) '(1 2 cloaked cloaked-detected)))
                                            (memq (unit-type-sym e)
                                                  '(lurker-burrowed roach-burrowed infestor-burrowed swarm-host-burrowed
                                                    widow-mine-burrowed baneling-burrowed ultralisk-burrowed
                                                    hydralisk-burrowed zergling-burrowed queen-burrowed drone-burrowed)))))
                   (hash 'x (safe-coord (hash-ref e 'x enemy-x) enemy-x)
                         'y (safe-coord (hash-ref e 'y enemy-y) enemy-y)
                         'indicator-kind (if (or (hash-ref e 'burrowed #f) (hash-ref e 'is-burrowed? #f))
                                             'burrow-ripple
                                             'cloaked-shimmer)))])
            (if (pair? synth-ripples)
                (execute-shimmer-and-burrow-ripple-response
                 (hash-set shimmer-obs 'shimmer-and-burrow-ripples synth-ripples))
                '()))))
    (define shimmer-psi-storm-ok? (l34-has-upgrade? ctx 'psi-storm))
    (for ([sa (in-list resolved-shimmer-acts)])
      (unless (and (not shimmer-psi-storm-ok?)
                   (pair? sa)
                   (eq? (car sa) 'blind-skillshot-shimmer)
                   (pair? (cdr sa))
                   (pair? (cddr sa))
                   (eq? (caddr sa) 'psi-storm))
        (l34-emit! ctx sa))))

  ;; L49-W1 (Overseer Anti-Cloak Combat Escort): When paired with friendly anti-air / burrow-stealth
  ;; squads (`corruptor`/`hydralisk`/`mutalisk`) engaging enemy units within `<= 22t` (and not already
  ;; handled by shimmer/Widow-Mine response!), keep Overseer tethered `1.5t` behind our anti-air
  ;; centroid (unmorphing Oversight if morphed) so its `11.0t` detection illuminates cloaked Observers!
  (when (and (pair? ally-overseers) (pair? combat-units) (pair? enemy-units))
    (define-values (aasx aasy aacnt)
      (for/fold ([sx 0.0] [sy 0.0] [cnt 0]) ([au (in-list combat-units)])
        (if (and (hash? au)
                 (memq (fast-canonical-unit-sym (unit-type-sym au))
                       '(corruptor hydralisk mutalisk))
                 (real? (hash-ref au 'x #f)) (real? (hash-ref au 'y #f)))
            (values (fl+ sx (exact->inexact (hash-ref au 'x base-x)))
                    (fl+ sy (exact->inexact (hash-ref au 'y base-y)))
                    (add1 cnt))
            (values sx sy cnt))))
    (when (> aacnt 0)
      (define aax (fl/ aasx (exact->inexact aacnt)))
      (define aay (fl/ aasy (exact->inexact aacnt)))
      (define near-e
        (for/fold ([best #f] [bd 22.01] #:result best) ([e (in-list enemy-units)])
          (if (and (hash? e) (real? (hash-ref e 'x #f)) (real? (hash-ref e 'y #f)))
              (let ([d (fast-dist2d aax aay
                                    (exact->inexact (hash-ref e 'x 9999.0))
                                    (exact->inexact (hash-ref e 'y 9999.0)))])
                (if (fl< d bd) (values e d) (values best bd)))
              (values best bd))))
      (when near-e
        (define nex (exact->inexact (hash-ref near-e 'x aax)))
        (define ney (exact->inexact (hash-ref near-e 'y aay)))
        (define bdx (fl- aax nex))
        (define bdy (fl- aay ney))
        (define bd (flmax 0.1 (flsqrt (fl+ (fl* bdx bdx) (fl* bdy bdy)))))
        (define ov-tx (safe-coord (fl+ aax (fl* 1.5 (fl/ bdx bd))) aax))
        (define ov-ty (safe-coord (fl+ aay (fl* 1.5 (fl/ bdy bd))) aay))
        (for ([ov (in-list ally-overseers)])
          (define ovid (hash-ref ov 'id 0))
          (when (and (> ovid 0) (not (set-member? wave3-handled-tags ovid)))
            (define ovx (exact->inexact (hash-ref ov 'x base-x)))
            (define ovy (exact->inexact (hash-ref ov 'y base-y)))
            (cond
              [(eq? (unit-type-sym ov) 'overseer-siege-mode)
               (set-add! wave3-handled-tags ovid)
               (l34-emit-preserved! ctx (list 'cast-spell ovid 'morph-overseer-mode))]
              [(fl> (fast-dist2d ovx ovy ov-tx ov-ty) 1.5)
               (set-add! wave3-handled-tags ovid)
               (l34-emit-preserved! ctx (list 'move ovid ov-tx ov-ty))]))))))

  (when (and (or (hash-ref obs 'enable-deception-and-buffs #f)
                 (not (null? ally-sentries))
                 (not (null? ally-overseers)))
             (or (not live-obs?)
                 (refractory-allow-action?! (live-bot-runtime-cooldown-tracker rt)
                                            '(deception-scout-spells)
                                            frame
                                            336)))
    (l34-emit! ctx '(cast-deception-and-scout-spells
             sentry-hallucination-phoenix-scout
             sentry-hallucination-archon-tank
             overseer-spawn-changeling)))

  ;; ---------------------------------------------------------------------------
  ;; Pro Mechanic #10: Protective Buff Aura, Throttled Pre-Split 3-Wing Squads,
  ;;                   Throttled Concave Arc, & High-Ground Mastery
  ;; ---------------------------------------------------------------------------
  (define army-cx prelim-army-cx)
  (define army-cy prelim-army-cy)
  (define use-eb-for-target? (and live-obs? (null? enemy-units)))
  (define visible-enemies-for-target
    (if use-eb-for-target? enemy-bldgs enemy-units))
  (define target-ex
    (if (null? visible-enemies-for-target)
        (if bo-rally-override? bo-rally-tx enemy-x)
        (safe-coord (/ (if use-eb-for-target? sum-eb-x sum-eu-x)
                       (max 1 (length visible-enemies-for-target)))
                    enemy-x)))
  (define target-ey
    (if (null? visible-enemies-for-target)
        (if bo-rally-override? bo-rally-ty enemy-y)
        (safe-coord (/ (if use-eb-for-target? sum-eb-y sum-eu-y)
                       (max 1 (length visible-enemies-for-target)))
                    enemy-y)))

  (when (and (or (hash-ref obs 'enable-deception-and-buffs #f)
                 (not (null? ally-sentries))
                 (not (null? ally-infestors))
                 ;; W8-TAC-3: In live games only emit protective buff-aura spread when we actually
                 ;; have a Sentry or Infestor (prevents spurious ATTACK-pos 23 on casting High Templars!).
                 (and (not live-obs?) (not (null? enemy-units)) (not (null? combat-units))))
             (or (not live-obs?)
                 (refractory-allow-action?! (live-bot-runtime-cooldown-tracker rt)
                                            '(buff-aura-position)
                                            frame
                                            44)))
    (define use-shroud?
      (or (not (null? ally-infestors))
          (eq? (live-bot-runtime-actual-race rt) 'Zerg)))
    (define aura-type (if use-shroud? 'microbial-shroud 'guardian-shield))
    (define aura-radius (if use-shroud? 3.5 4.5))
    (l34-emit! ctx (list 'cast-protective-buff-aura aura-type army-cx army-cy aura-radius))
    (l34-emit! ctx (list 'position-in-buff-aura-with-splash-spread
                 aura-type army-cx army-cy aura-radius 1.6 #t)))

  ;; Loop 65 Gap C7 (`#1829`/`#1837`): Retire redundant LIVE Phase 6 `'pre-split-wings` /
  ;; `'form-concave-arc` wire tokens so L2c `concave-positioning.rkt` is the SINGLE concave
  ;; authority in live games; retain offline non-live synthetic test compatibility only!
  (when (and (not live-obs?)
             (not endgame-hunt-active?)
             (or (not (null? enemy-units))
                 (and bo-rally-override?
                      (pair? combat-units)
                      (memq 'pre-split-vs-emp bo-micro-dirs))
                 (hash-ref obs 'pre-split-engage #f)
                 (hash-ref obs 'form-concave #f)))
    (define dx (- target-ex army-cx))
    (define dy (- target-ey army-cy))
    (define d (max 1.0 (sqrt (+ (* dx dx) (* dy dy)))))
    (define nx (/ (- dy) d))
    (define ny (/ dx d))
    (define wing-spread 6.0)
    (define mid-x (safe-coord (+ army-cx (* 0.5 dx)) army-cx))
    (define mid-y (safe-coord (+ army-cy (* 0.5 dy)) army-cy))
    (define left-x (safe-coord (+ mid-x (* wing-spread nx)) mid-x))
    (define left-y (safe-coord (+ mid-y (* wing-spread ny)) mid-y))
    (define right-x (safe-coord (- mid-x (* wing-spread nx)) mid-x))
    (define right-y (safe-coord (- mid-y (* wing-spread ny)) mid-y))
    (l34-emit! ctx (list 'pre-split-wings left-x left-y mid-x mid-y right-x right-y))
    (l34-emit! ctx (list 'form-concave-arc target-ex target-ey 10 120)))

  ;; High-Ground Terrain & Vision Mastery
  (define our-z our-z-early)
  (define enemy-z enemy-z-early)
  (when (and (not endgame-hunt-active?)
             (or (not (= our-z enemy-z))
                 (not (null? enemy-units))
                 (hash-ref obs 'high-ground-check #f))
             (or (not live-obs?)
                 (refractory-allow-action?! (live-bot-runtime-cooldown-tracker rt)
                                            '(high-ground-posture)
                                            frame
                                            28)))
    (define has-spotter? (or (not live-obs?) has-non-overlord-spotter?))
    (cond
      [(> our-z enemy-z)
       (l34-emit! ctx (list 'high-ground-tactics 'hold-high-ground-ramp-arc nat-x nat-y #f))]
      [(> enemy-z our-z)
       (l34-emit! ctx (list 'high-ground-tactics 'uphill-vision-spotter-and-concave target-ex target-ey has-spotter?))]
      [else
       (l34-emit! ctx (list 'high-ground-tactics 'contest-high-ground-control nat-x nat-y #f))]))

  ;; Spatio-Temporal Enemy Army Reachability & Counter-Positioning / Backstab / Surround Maneuver
  (define mm-rt (live-bot-runtime-mirror-mind rt))
  (define mm-tech (mirror-mind-state-last-tech-observation mm-rt))
  (define mm-shadow (mirror-mind-state-last-shadow-ledger mm-rt))
  (define door-st-reach (rt-door-state rt))
  (define reach-cache (hash-ref door-st-reach 'reach-m-cache #f))
  (define n-ally-reach (length ally-units))
  (define n-enemy-reach (length enemy-units))
  (define reach-heavy-ttl? (and live-obs? (> frame 120) (>= (+ n-ally-reach n-enemy-reach) 30)))
  (define reach-ttl (if (= (modulo frame 16) 8) 15 11))
  (define reach-m
    (if (and reach-cache
             (= base-x (vector-ref reach-cache 4))
             (= base-y (vector-ref reach-cache 5))
             (= nat-x (vector-ref reach-cache 6))
             (= nat-y (vector-ref reach-cache 7))
             (= enemy-exp-x (vector-ref reach-cache 8))
             (= enemy-exp-y (vector-ref reach-cache 9))
             (if reach-heavy-ttl?
                 (and (>= frame (vector-ref reach-cache 11))
                      (< (- frame (vector-ref reach-cache 11)) reach-ttl)
                      (= n-ally-reach (vector-ref reach-cache 12))
                      (= n-enemy-reach (vector-ref reach-cache 13)))
                 (and (eq? ally-units (vector-ref reach-cache 0))
                      (eq? enemy-units (vector-ref reach-cache 1))
                      (eq? mm-tech (vector-ref reach-cache 2))
                      (eq? mm-shadow (vector-ref reach-cache 3)))))
        (vector-ref reach-cache 10)
        (let ([m (evaluate-enemy-army-spatio-temporal-reachability
                  frame
                  ally-units
                  enemy-units
                  mm-tech
                  mm-shadow
                  #:our-base-x base-x #:our-base-y base-y
                  #:our-nat-x nat-x #:our-nat-y nat-y
                  #:enemy-exp-x enemy-exp-x
                  #:enemy-exp-y enemy-exp-y)])
          (hash-set! door-st-reach 'reach-m-cache
                     (vector ally-units enemy-units mm-tech mm-shadow
                             base-x base-y nat-x nat-y enemy-exp-x enemy-exp-y m
                             frame n-ally-reach n-enemy-reach))
          m)))
  (set-mirror-mind-state-last-reachability-model! mm-rt reach-m)
  (define raw-sp-maneuver
    (enemy-army-reachability-model-recommended-spatial-maneuver reach-m))
  (define enemy-main-cleared-or-empty?
    (and (null? enemy-units)
         (or (null? enemy-bldgs)
             (not (ormap (lambda (eb)
                           (<= (dist2d (safe-finite-real (hash-ref eb 'x enemy-x) enemy-x)
                                       (safe-finite-real (hash-ref eb 'y enemy-y) enemy-y)
                                       enemy-x enemy-y)
                               16.0))
                         enemy-bldgs)))))
  (define sp-maneuver
    (if (and (eq? raw-sp-maneuver 'pre-rotate-intercept-incoming-threat)
             enemy-main-cleared-or-empty?
             (<= (hash-ref obs 'enemy-threat-supply 0) 0))
        'multiprong-rotate-and-pin
        raw-sp-maneuver))
  (define-values (sp-tx sp-ty)
    (if (and live-obs?
             (or eff-wave-commit?
                 bo-rally-override?
                 (>= (length combat-units) live-attack-wave-min)
                 (and (>= frame 6000) enemy-main-cleared-or-empty? (>= (length combat-units) 4))))
        (case sp-maneuver
          [(pre-rotate-intercept-incoming-threat)
           (values nat-x nat-y)]
          [(backstab-undefended-enemy-expansion)
           (cond
             [bo-fork-active? (values bo-sx bo-sy)]
             [bo-rally-override? (values bo-rally-tx bo-rally-ty)]
             [(null? visible-enemies-for-target) (values enemy-exp-x enemy-exp-y)]
             [else (values target-ex target-ey)])]
          [else
           (if bo-rally-override?
               (values bo-rally-tx bo-rally-ty)
               (values target-ex target-ey))])
        (case sp-maneuver
          [(backstab-undefended-enemy-expansion)
           (cond
             [bo-fork-active? (values bo-sx bo-sy)]
             [bo-rally-override? (values bo-rally-tx bo-rally-ty)]
             [else (values enemy-exp-x enemy-exp-y)])]
          [(surround-and-crush-isolated-enemy-cluster)
           (if bo-rally-override?
               (values bo-rally-tx bo-rally-ty)
               (values target-ex target-ey))]
          [(pre-rotate-intercept-incoming-threat)
           (values nat-x nat-y)]
          [(safe-to-expand-enemy-pinned-far)
           (values third-x third-y)]
          [else
           (if bo-rally-override?
               (values bo-rally-tx bo-rally-ty)
               (values target-ex target-ey))])))
  (when (and (not endgame-hunt-active?)
             (or (not live-obs?)
                 (refractory-allow-action?! (live-bot-runtime-cooldown-tracker rt)
                                            '(spatial-maneuver)
                                            frame
                                            28)))
    (l34-emit! ctx (list 'execute-spatial-maneuver sp-maneuver sp-tx sp-ty)))

  (hash-set! splash-st 'wave3-preserved-frame frame)
  (hash-set! splash-st 'wave3-preserved-set wave3-preserved-set)

)

(define (l34-phase7-direct-tactics! ctx)
  (define actions (l34-ctx-actions ctx))
  (define ally-bldgs (l34-ctx-ally-bldgs ctx))
  (define ally-overseers (l34-ctx-ally-overseers ctx))
  (define ally-units (l34-ctx-ally-units ctx))
  (define ally-zerg-burrow-candidate? (l34-ctx-ally-zerg-burrow-candidate? ctx))
  (define base-x (l34-ctx-base-x ctx))
  (define base-y (l34-ctx-base-y ctx))
  (define creep-ally-slice-rev (l34-ctx-creep-ally-slice-rev ctx))
  (define creep-enemy-slice-rev (l34-ctx-creep-enemy-slice-rev ctx))
  (define disruptor-handled-tags (l34-ctx-disruptor-handled-tags ctx))
  (define enemy-bldgs (l34-ctx-enemy-bldgs ctx))
  (define enemy-near-home? (l34-ctx-enemy-near-home? ctx))
  (define enemy-units (l34-ctx-enemy-units ctx))
  (define enemy-x (l34-ctx-enemy-x ctx))
  (define enemy-y (l34-ctx-enemy-y ctx))
  (define frame (l34-ctx-frame ctx))
  (define has-ally-changeling-or-overseer? (l34-ctx-has-ally-changeling-or-overseer? ctx))
  (define has-ally-dropperlord? (l34-ctx-has-ally-dropperlord? ctx))
  (define has-ally-harass-sym? (l34-ctx-has-ally-harass-sym? ctx))
  (define has-ally-map-elem-or-recall? (l34-ctx-has-ally-map-elem-or-recall? ctx))
  (define has-ally-queen-or-tumor? (l34-ctx-has-ally-queen-or-tumor? ctx))
  (define has-ally-queen? (l34-ctx-has-ally-queen? ctx))
  (define has-ally-static-def-or-nydus? (l34-ctx-has-ally-static-def-or-nydus? ctx))
  (define has-ally-swarm-host-or-locust? (l34-ctx-has-ally-swarm-host-or-locust? ctx))
  (define has-ally-unwalled-punish-unit? (l34-ctx-has-ally-unwalled-punish-unit? ctx))
  (define has-ally-wall-block-bldg? (l34-ctx-has-ally-wall-block-bldg? ctx))
  (define has-ally-zergling? (l34-ctx-has-ally-zergling? ctx))
  (define has-enemy-burrow-or-sh-counter? (l34-ctx-has-enemy-burrow-or-sh-counter? ctx))
  (define has-enemy-changeling? (l34-ctx-has-enemy-changeling? ctx))
  (define has-enemy-creep-tumor? (l34-ctx-has-enemy-creep-tumor? ctx))
  (define has-enemy-dropperlord? (l34-ctx-has-enemy-dropperlord? ctx))
  (define has-enemy-harass-sym? (l34-ctx-has-enemy-harass-sym? ctx))
  (define has-enemy-map-elem-or-recall? (l34-ctx-has-enemy-map-elem-or-recall? ctx))
  (define has-enemy-overseer? (l34-ctx-has-enemy-overseer? ctx))
  (define has-enemy-static-def-or-nydus? (l34-ctx-has-enemy-static-def-or-nydus? ctx))
  (define has-enemy-static-det? (l34-ctx-has-enemy-static-det? ctx))
  (define has-enemy-swarm-host-or-locust? (l34-ctx-has-enemy-swarm-host-or-locust? ctx))
  (define l34-sc (l34-ctx-l34-sc ctx))
  (define leases (l34-ctx-leases ctx))
  (define nat-x (l34-ctx-nat-x ctx))
  (define nat-y (l34-ctx-nat-y ctx))
  (define obs (l34-ctx-obs ctx))
  (define reserve-count (l34-ctx-reserve-count ctx))
  (define rt (l34-ctx-rt ctx))
  (define splash-evading-tags (l34-ctx-splash-evading-tags ctx))
  (define stasis-frozen-tags (l34-ctx-stasis-frozen-tags ctx))
  (define vanguard-count (l34-ctx-vanguard-count ctx))
  (define wave3-handled-tags (l34-ctx-wave3-handled-tags ctx))
  (define direct-claimed-ht (pooled-hasheqv! l34-sc 'direct-claimed-ht))
  (for ([tid (in-set wave3-handled-tags)])
    (when (and (exact-integer? tid) (> tid 0))
      (hash-set! direct-claimed-ht tid #t)))
  (for ([tid (in-set disruptor-handled-tags)])
    (when (and (exact-integer? tid) (> tid 0))
      (hash-set! direct-claimed-ht tid #t)))
  (for ([tid (in-set splash-evading-tags)])
    (when (and (exact-integer? tid) (> tid 0))
      (hash-set! direct-claimed-ht tid #t)))
  (for ([tid (in-list stasis-frozen-tags)])
    (hash-set! direct-claimed-ht tid #t))
  (when (hash? leases)
    (for ([uid (in-hash-keys leases)])
      (when (unit-leased-above? leases uid 'army frame)
        (hash-set! direct-claimed-ht uid #t))))

  (define direct-prev-tel (live-bot-runtime-last-telemetry rt))
  (define direct-our-race
    (let ([r (live-bot-runtime-actual-race rt)])
      (if (and (symbol? r) (not (eq? r 'Unknown)))
          r
          (hash-ref obs 'race 'Zerg))))
  (define direct-enemy-race
    (if (hash? direct-prev-tel)
        (hash-ref direct-prev-tel 'effective-enemy-race (hash-ref obs 'enemy-race 'Unknown))
        (hash-ref obs 'enemy-race 'Unknown)))
  (define zerg-or-random? (memq direct-our-race '(Zerg Random)))
  (define has-any-enemy? (or (pair? enemy-units) (pair? enemy-bldgs)))
  (define has-ally-overseer? (pair? ally-overseers))
  (define direct-seen-sexps #f)
  (define unclaimed-allies-cache #f)
  (define direct-bunker-loaded-ht (pooled-hasheqv! l34-sc 'direct-bunker-loaded-ht))

  (define (emit-direct-batch! raw-acts)
    (when (pair? raw-acts)
      (unless direct-seen-sexps
        (set! direct-seen-sexps (pooled-mutable-set! l34-sc 'direct-seen-sexps)))
      (define newly-claimed '())
      (for ([act (in-list raw-acts)]
            #:when (and (pair? act) (symbol? (car act))))
        (define-values (filtered-act actor-ids)
          (cond
            [(null? (cdr act)) (values act '())]
            [else
             (define head (car act))
             (define arg1 (cadr act))
             (cond
               [(and (eq? head 'bunker-load)
                     (pair? (cddr act))
                     (exact-integer? (caddr act))
                     (> (caddr act) 0))
                (define bio-id (caddr act))
                ;; Loop 64 P2 #5 (`< 4:30` proxy-rush Bunker loading):
                ;; Allow `bunker-load` in `< 4:30` (`< 6048f`) home defense even when Phase 5b
                ;; claimed the Marine in `wave3-handled-tags` for generic attack/kite!
                (define early-bunker-load-override?
                  (and (< frame 6048)
                       enemy-near-home?
                       (not (hash-ref direct-bunker-loaded-ht bio-id #f))
                       (set-member? wave3-handled-tags bio-id)
                       (not (set-member? splash-evading-tags bio-id))
                       (not (set-member? disruptor-handled-tags bio-id))
                       (not (memv bio-id stasis-frozen-tags))
                       (not (and (hash? leases) (unit-leased-above? leases bio-id 'army frame)))))
                (if (and (hash-ref direct-claimed-ht bio-id #f)
                         (not early-bunker-load-override?))
                    (values #f '())
                    (begin
                      (hash-set! direct-bunker-loaded-ht bio-id #t)
                      (values act (list bio-id))))]
               [(and (eq? head 'transport-juggle)
                     (exact-integer? arg1)
                     (> arg1 0)
                     (pair? (cddr act))
                     (list? (caddr act)))
                (if (hash-ref direct-claimed-ht arg1 #f)
                    (values #f '())
                    (let ([unclaimed-pax
                           (for/list ([p (in-list (caddr act))]
                                      #:when (and (exact-integer? p)
                                                  (> p 0)
                                                  (not (hash-ref direct-claimed-ht p #f))))
                             p)])
                      (if (null? unclaimed-pax)
                          (values #f '())
                          (values (list* head arg1 unclaimed-pax (cdddr act))
                                  (cons arg1 unclaimed-pax)))))]
               [(and (pair? arg1) (exact-integer? (car arg1)))
                (define free-ids
                  (for/list ([uid (in-list arg1)]
                             #:when (and (exact-integer? uid)
                                         (> uid 0)
                                         (not (hash-ref direct-claimed-ht uid #f))))
                    uid))
                (if (null? free-ids)
                    (values #f '())
                    (values (cons head (cons free-ids (cddr act))) free-ids))]
               [(and (exact-integer? arg1) (> arg1 0))
                (if (hash-ref direct-claimed-ht arg1 #f)
                    (values #f '())
                    (values act (list arg1)))]
               [else (values act '())])]))
        (when (and filtered-act (not (set-member? direct-seen-sexps filtered-act)))
          ;; Strict Layering Invariant (#5131238, #5130439): in live games (`live-obs?`),
          ;; Layer 3/4 tactical planners must NEVER emit unbudgeted macro build/train/expand/research commands
          ;; using stale start-of-frame resources (which built 50 ShieldBatteries & 27 MissileTurrets!).
          ;; L59 Tier-1B (`#1499` L38586): Exempt offensive Warp Prism warp-ins (`warp-in` or
          ;; `train-unit wg 'warp-in-*` while an ally `warp-prism-phasing` is active)!
          (define is-warp-prism-warp-in?
            (and (pair? filtered-act)
                 (or (eq? (car filtered-act) 'warp-in)
                     (and (eq? (car filtered-act) 'train-unit)
                          (>= (length filtered-act) 3)
                          (memq (third filtered-act)
                                '(warp-in-zealot warp-in-stalker warp-in-adept warp-in-dark-templar
                                  warp-in-sentry warp-in-high-templar))
                          (ormap (lambda (u)
                                   (and (hash? u) (eq? (unit-type-sym u) 'warp-prism-phasing)))
                                 ally-units)))))
          ;; L59-P2 (`sc2-trn-n17`): Throttle duplicate `(train-unit wg 'warp-in-*)` per WarpGate
          ;; (`448f` WarpGate cooldown) in live mode so WarpGates never spam `99x` reject code `21`!
          (define warp-in-cd-blocked?
            (and (l34-ctx-live-obs? ctx)
                 is-warp-prism-warp-in?
                 (eq? (car filtered-act) 'train-unit)
                 (exact-integer? (cadr filtered-act))
                 (> (cadr filtered-act) 0)
                 (not (refractory-allow-action?! (live-bot-runtime-cooldown-tracker rt)
                                                 (list 'direct-wg-warp-in (cadr filtered-act))
                                                 frame
                                                 448))))
          (define skip-layer34-macro-leak?
            (and (l34-ctx-live-obs? ctx)
                 (pair? filtered-act)
                 (or warp-in-cd-blocked?
                     (and (not is-warp-prism-warp-in?)
                          (memq (car filtered-act) '(build expand train train-unit research))))))
          (define skip-worker-proxy-pull?
            (and (list? filtered-act)
                 (eq? (car filtered-act) 'pull-workers-attack)
                 (let ([tid (and (>= (length filtered-act) 5) (third filtered-act))])
                   (not (and (exact-integer? tid)
                             (for/or ([eb (in-list enemy-bldgs)])
                               (and (= (hash-ref eb 'id -1) tid)
                                    (memq (fast-canonical-structure-sym (unit-type-sym eb))
                                          '(nydus-canal nydus-worm)))))))))
          (define skip-dummy?
            (and (list? filtered-act)
                 (eq? (car filtered-act) 'cast-spell)
                 (or (and (>= (length filtered-act) 5)
                          (real? (fourth filtered-act))
                          (real? (fifth filtered-act))
                          (let ([tx (fourth filtered-act)] [ty (fifth filtered-act)])
                            (and (or (and (= tx 46.0) (= ty 46.0))
                                     (and (= tx 88.0) (= ty 88.0))
                                     (and (= tx 152.0) (= ty 152.0)))
                                 (not (for/or ([eu (in-list enemy-units)])
                                        (let ([ex (hash-ref eu 'x -999.0)]
                                              [ey (hash-ref eu 'y -999.0)])
                                          (and (real? ex) (real? ey) (= (- ex ex) 0) (= (- ey ey) 0)
                                               (let ([dx (- (exact->inexact tx) (exact->inexact ex))]
                                                     [dy (- (exact->inexact ty) (exact->inexact ey))])
                                                 (<= (+ (* dx dx) (* dy dy)) 64.0)))))))))
                     (and (= (length filtered-act) 4)
                          (equal? (fourth filtered-act) 1)
                          (not (for/or ([eu (in-list enemy-units)]) (= (hash-ref eu 'id -1) 1)))))))
          ;; L58-P1 (`sc2-ab-t11`, `sc2-ab-t12`): Drop ANY `(repair sid tid)` from direct tactics
          ;; (e.g. proactive full-HP Bunker/PF repair in `static-defense.rkt`) whose target has
          ;; `hp >= max-hp - 0.5` -> eliminates `28:TooMuchLife` wire rejections!
          (define skip-full-hp-repair?
            (and (list? filtered-act)
                 (eq? (car filtered-act) 'repair)
                 (>= (length filtered-act) 3)
                 (let ([tid (third filtered-act)])
                   (and (exact-integer? tid) (> tid 0)
                        (let ([tgt (or (for/first ([b (in-list ally-bldgs)]
                                                   #:when (and (hash? b) (eqv? (hash-ref b 'id -1) tid)))
                                         b)
                                       (for/first ([u (in-list ally-units)]
                                                   #:when (and (hash? u) (eqv? (hash-ref u 'id -1) tid)))
                                         u))])
                          (and (hash? tgt)
                               (let ([chp (or (hash-ref tgt 'hp #f) (hash-ref tgt 'health #f))]
                                     [mhp (or (hash-ref tgt 'max-hp #f) (hash-ref tgt 'health-max #f))])
                                 (and (real? chp) (real? mhp) (> mhp 0)
                                      (>= (exact->inexact chp) (- (exact->inexact mhp) 0.5))))))))))
          ;; L58-P1 (`sc2-runby-ro07`): Enforce Adept Psionic Transfer (`2544`) `248f` (`11.07s`)
          ;; per-Adept cooldown across direct tactics (`multitask-harass-and-proxy.rkt`) so Adepts
          ;; NEVER spam `2544` while on cooldown (`6:Cooldown`)!
          (define skip-adept-shade-cd?
            (and (list? filtered-act)
                 (memq (car filtered-act) '(cast cast-spell))
                 (>= (length filtered-act) 3)
                 (memq (third filtered-act) '(adept-phase-shift psionic-transfer))
                 (let ([aid (second filtered-act)])
                   (and (exact-integer? aid) (> aid 0)
                        (not (refractory-allow-action?! (live-bot-runtime-cooldown-tracker rt)
                                                        (list 'adept-shade aid)
                                                        frame
                                                        248))))))
          ;; L58-P2 (`sc2-ab-z06`): Never let zero-cooldown `plan-changeling-free-unit-tactics` dump
          ;; an Overseer's entire `160e` into back-to-back Changelings (`181`) before `Contaminate (1825)`!
          ;; Enforce per-Overseer `336f` cooldown, active Changeling cap, and Contaminate energy hold!
          (define skip-overseer-changeling-spam?
            (and (list? filtered-act)
                 (memq (car filtered-act) '(cast cast-spell))
                 (>= (length filtered-act) 3)
                 (eq? (third filtered-act) 'spawn-changeling)
                 (let ([oid (second filtered-act)])
                   (and (exact-integer? oid) (> oid 0)
                        (let* ([ov (for/first ([u (in-list ally-units)]
                                               #:when (and (hash? u) (eqv? (hash-ref u 'id -1) oid)))
                                     u)]
                               [ov-en (if (hash? ov) (exact->inexact (hash-ref ov 'energy 0.0)) 0.0)]
                               [ox (if (and (hash? ov) (real? (hash-ref ov 'x #f))) (exact->inexact (hash-ref ov 'x 0.0)) #f)]
                               [oy (if (and (hash? ov) (real? (hash-ref ov 'y #f))) (exact->inexact (hash-ref ov 'y 0.0)) #f)]
                               [near-contam-or-fight?
                                (and ox oy (>= ov-en 100.0)
                                     (or (for/or ([eb (in-list enemy-bldgs)])
                                           (and (hash? eb)
                                                (real? (hash-ref eb 'x #f)) (real? (hash-ref eb 'y #f))
                                                (<= (fast-dist2d ox oy
                                                                 (exact->inexact (hash-ref eb 'x 9999.0))
                                                                 (exact->inexact (hash-ref eb 'y 9999.0)))
                                                    28.0)))
                                         (for/or ([e (in-list enemy-units)])
                                           (and (hash? e) (combat-unit-record? e)
                                                (real? (hash-ref e 'x #f)) (real? (hash-ref e 'y #f))
                                                (<= (fast-dist2d ox oy
                                                                 (exact->inexact (hash-ref e 'x 9999.0))
                                                                 (exact->inexact (hash-ref e 'y 9999.0)))
                                                    16.0)))))])
                          (or near-contam-or-fight?
                              (not (refractory-allow-action?! (live-bot-runtime-cooldown-tracker rt)
                                                              (list 'overseer-changeling oid)
                                                              frame
                                                              336))))))))
          ;; L58-P3 (`sc2-runby-ro01`): Protect burrowed Widow Mine `1.07s` Sentinel Missile lock-on
          ;; from every-tick `widow-mine-retarget (2099)` target-flipping AND skip reloading mines
          ;; (`weapon-cooldown > 0.0`, eliminates `6:Cooldown` rejections)!
          (define skip-widow-mine-retarget-spam?
            (and (list? filtered-act)
                 (memq (car filtered-act) '(widow-mine-retarget widow-mine-attack))
                 (>= (length filtered-act) 3)
                 (let ([wmid (second filtered-act)])
                   (and (exact-integer? wmid) (> wmid 0)
                        (let* ([wm (for/first ([u (in-list ally-units)]
                                               #:when (and (hash? u) (eqv? (hash-ref u 'id -1) wmid)))
                                     u)]
                               [wcd (if (hash? wm) (hash-ref wm 'weapon-cooldown (hash-ref wm 'weapon_cooldown 0.0)) 0.0)]
                               [oab (if (hash? wm) (hash-ref wm 'order-ability-id 0) 0)])
                          (or (and (real? wcd) (> (exact->inexact wcd) 0.0))
                              (and (exact-integer? oab) (= oab 2099))
                              (not (refractory-allow-action?! (live-bot-runtime-cooldown-tracker rt)
                                                              (list 'wm-retarget wmid)
                                                              frame
                                                              40))))))))
          ;; L58-P3 (`sc2-det-d04`, `sc2-blk-b06`, `sc2-blk-b07`, `sc2-trn-n05`): Authoritative full-army
          ;; emergency-only Nexus Mass Recall (`3757`) gate across ALL direct tactics (#6 & #7).
          ;; Because direct planners receive `free-allies` (not full `ally-units`), they dramatically
          ;; underestimated friendly army strength and yanked healthy full-HP armies back to the Nexus!
          ;; Allow `3757` ONLY on:
          ;;  (a) Genuine home-defense recall (>= 3 enemy combat within 18t of a Nexus, home defense
          ;;      outnumbered, and recalled cluster > 42t from that Nexus), OR
          ;;  (b) Genuine survival emergency on FULL `ally-units`: NOT Warp Prism squad, NOT healthy
          ;;      worker raid, NOT stealth detector-snipe squad, local cluster ACTUALLY TAKING HEAVY
          ;;      DAMAGE (`avg-hp < 0.75` AND (`avg-hp < 0.50` OR `>= 3` units `< 45%` HP)) AND genuinely
          ;;      outgunned (`enemy-power-16t > 1.75 * ally-power-12t`).
          (define skip-premature-mass-recall?
            (and (list? filtered-act)
                 (memq (car filtered-act) '(cast cast-spell))
                 (>= (length filtered-act) 5)
                 (memq (third filtered-act) '(mass-recall nexus-mass-recall))
                 (real? (fourth filtered-act))
                 (real? (fifth filtered-act))
                 (let* ([rx (exact->inexact (fourth filtered-act))]
                        [ry (exact->inexact (fifth filtered-act))]
                        [recall-unit-pwr
                         (lambda (u)
                           (define ut (fast-canonical-unit-sym (unit-type-sym u)))
                           (define ehp (exact->inexact (unit-total-hp-and-shield u)))
                           (define sup (exact->inexact (unit-supply-cost ut)))
                           (max 40.0 (+ (* 0.5 ehp) (* 80.0 sup))))]
                        [home-defense-emergency?
                         (for/or ([b (in-list ally-bldgs)]
                                  #:when (and (hash? b)
                                              (eq? (fast-canonical-structure-sym (unit-type-sym b)) 'nexus)
                                              (real? (hash-ref b 'x #f)) (real? (hash-ref b 'y #f))))
                           (define nbx (exact->inexact (hash-ref b 'x 0.0)))
                           (define nby (exact->inexact (hash-ref b 'y 0.0)))
                           (and (> (fast-dist2d nbx nby rx ry) 42.0)
                                (let-values ([(ecnt epwr)
                                              (for/fold ([c 0] [p 0.0]) ([e (in-list enemy-units)])
                                                (if (and (hash? e) (combat-unit-record? e)
                                                         (not (hash-ref e 'snapshot? #f))
                                                         (real? (hash-ref e 'x #f)) (real? (hash-ref e 'y #f))
                                                         (<= (fast-dist2d nbx nby
                                                                          (exact->inexact (hash-ref e 'x 9999.0))
                                                                          (exact->inexact (hash-ref e 'y 9999.0)))
                                                             18.0))
                                                    (values (add1 c) (+ p (recall-unit-pwr e)))
                                                    (values c p)))])
                                  (and (>= ecnt 3)
                                       (let ([dpwr
                                              (for/sum ([a (in-list ally-units)]
                                                        #:when (and (hash? a) (combat-unit-record? a)
                                                                    (not (hash-ref a 'hallucination? #f))
                                                                    (not (hash-ref a 'is-hallucination #f))
                                                                    (real? (hash-ref a 'x #f)) (real? (hash-ref a 'y #f))
                                                                    (<= (fast-dist2d nbx nby
                                                                                     (exact->inexact (hash-ref a 'x 9999.0))
                                                                                     (exact->inexact (hash-ref a 'y 9999.0)))
                                                                        22.0)))
                                                (recall-unit-pwr a))])
                                         (< dpwr (* 0.85 epwr)))))))]
                        [has-warp-prism-16?
                         (for/or ([u (in-list ally-units)])
                           (and (hash? u)
                                (memq (unit-type-sym u) '(warp-prism warp-prism-phasing))
                                (real? (hash-ref u 'x #f)) (real? (hash-ref u 'y #f))
                                (<= (fast-dist2d rx ry
                                                 (exact->inexact (hash-ref u 'x 9999.0))
                                                 (exact->inexact (hash-ref u 'y 9999.0)))
                                    16.0)))]
                        [stealth-snipe-active?
                         (let ([dt-c (count (lambda (a)
                                              (and (hash? a)
                                                   (eq? (fast-canonical-unit-sym (unit-type-sym a)) 'dark-templar)
                                                   (real? (hash-ref a 'x #f)) (real? (hash-ref a 'y #f))
                                                   (<= (fast-dist2d rx ry
                                                                    (exact->inexact (hash-ref a 'x 9999.0))
                                                                    (exact->inexact (hash-ref a 'y 9999.0)))
                                                       20.0)))
                                            ally-units)]
                               [aa-c (count (lambda (a)
                                              (and (hash? a)
                                                   (memq (fast-canonical-unit-sym (unit-type-sym a))
                                                         '(phoenix stalker void-ray voidray tempest carrier archon sentry))
                                                   (real? (hash-ref a 'x #f)) (real? (hash-ref a 'y #f))
                                                   (<= (fast-dist2d rx ry
                                                                    (exact->inexact (hash-ref a 'x 9999.0))
                                                                    (exact->inexact (hash-ref a 'y 9999.0)))
                                                       20.0)))
                                            ally-units)]
                               [stat-det (count (lambda (eb)
                                                  (and (hash? eb)
                                                       (memq (fast-canonical-structure-sym (unit-type-sym eb))
                                                             '(missile-turret photon-cannon spore-crawler))
                                                       (real? (hash-ref eb 'x #f)) (real? (hash-ref eb 'y #f))
                                                       (<= (fast-dist2d rx ry
                                                                        (exact->inexact (hash-ref eb 'x 9999.0))
                                                                        (exact->inexact (hash-ref eb 'y 9999.0)))
                                                           24.0)))
                                                enemy-bldgs)]
                               [mob-det (count (lambda (e)
                                                 (and (hash? e)
                                                      (memq (fast-canonical-unit-sym (unit-type-sym e))
                                                            '(overseer overseer-siege-mode observer observer-siege-mode raven))
                                                      (real? (hash-ref e 'x #f)) (real? (hash-ref e 'y #f))
                                                      (<= (fast-dist2d rx ry
                                                                       (exact->inexact (hash-ref e 'x 9999.0))
                                                                       (exact->inexact (hash-ref e 'y 9999.0)))
                                                          24.0)))
                                               enemy-units)])
                           (and (>= dt-c 2) (>= aa-c 2) (= stat-det 0) (<= mob-det 3)))]
                        [survival-emergency?
                         (and (not has-warp-prism-16?)
                              (not stealth-snipe-active?)
                              (let-values ([(hsum msum cnt low45 apwr)
                                            (for/fold ([hs 0.0] [ms 0.0] [c 0] [l45 0] [ap 0.0])
                                                      ([u (in-list ally-units)])
                                              (if (and (hash? u)
                                                       (combat-unit-record? u)
                                                       (not (hash-ref u 'hallucination? #f))
                                                       (not (hash-ref u 'is-hallucination #f))
                                                       (real? (hash-ref u 'x #f)) (real? (hash-ref u 'y #f))
                                                       (<= (fast-dist2d rx ry
                                                                        (exact->inexact (hash-ref u 'x 9999.0))
                                                                        (exact->inexact (hash-ref u 'y 9999.0)))
                                                           12.0))
                                                  (let* ([cur (exact->inexact (unit-total-hp-and-shield u))]
                                                         [mhp (exact->inexact (hash-ref u 'max-hp (hash-ref u 'health-max 100.0)))]
                                                         [msh (exact->inexact (hash-ref u 'max-shield (hash-ref u 'max-shields 0.0)))]
                                                         [tot (max cur (max 1.0 (+ mhp msh)))]
                                                         [rat (/ cur tot)])
                                                    (values (+ hs cur) (+ ms tot) (add1 c)
                                                            (if (< rat 0.45) (add1 l45) l45)
                                                            (+ ap (recall-unit-pwr u))))
                                                  (values hs ms c l45 ap)))])
                                (and (> cnt 0)
                                     (let ([avg-rat (/ hsum (max 1.0 msum))]
                                           [epwr
                                            (for/sum ([e (in-list enemy-units)]
                                                      #:when (and (hash? e) (combat-unit-record? e)
                                                                  (not (hash-ref e 'snapshot? #f))
                                                                  (real? (hash-ref e 'x #f)) (real? (hash-ref e 'y #f))
                                                                  (<= (fast-dist2d rx ry
                                                                                   (exact->inexact (hash-ref e 'x 9999.0))
                                                                                   (exact->inexact (hash-ref e 'y 9999.0)))
                                                                      16.0)))
                                              (recall-unit-pwr e))])
                                       (and (< avg-rat 0.75)
                                            (or (< avg-rat 0.50) (>= low45 3))
                                            (> epwr (* 1.75 (max 1.0 apwr))))))))])
                   (not (or home-defense-emergency? survival-emergency?)))))
          (unless (or skip-layer34-macro-leak? skip-worker-proxy-pull? skip-dummy?
                      skip-full-hp-repair? skip-adept-shade-cd? skip-overseer-changeling-spam?
                      skip-widow-mine-retarget-spam? skip-premature-mass-recall?
                      (runtime-suppressed-live-ability-action? filtered-act))
            (set-add! direct-seen-sexps filtered-act)
            (l34-emit! ctx filtered-act)
            (for ([uid (in-list actor-ids)])
              (set! newly-claimed (cons uid newly-claimed))))))
      (when (pair? newly-claimed)
        (set! unclaimed-allies-cache #f)
        (for ([uid (in-list newly-claimed)])
          (hash-set! direct-claimed-ht uid #t)))))

  (define (unclaimed-ally-units-now)
    (or unclaimed-allies-cache
        (let ([res
               (if (zero? (hash-count direct-claimed-ht))
                   ally-units
