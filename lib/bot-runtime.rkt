  ;; Detect when 1-base Terran natural `(expand ...)` orders expire/reject in `order-ledger`
  ;; without starting CC #2: on expiration #1 lower ramp Depots & allow a fast retry (`24f`);
  ;; after `>= 2` retries/expirations (within `80f`, or `360f` safety window), lower ramp Depots
  ;; AND immediately fall back to high-ground in-base CC (ending the `280s` `ESCROW_LOCKOUT` loop!).
  (define door-st-cc (rt-door-state rt))
  (when (or (<= frame 4) (>= (length ccs) 2))
    (hash-remove! door-st-cc 'terran-cc-nat-retry-st)
    (when (>= (length ccs) 2)
      (hash-remove! door-st-cc 'terran-cc-needs-depot-lower-until)))
  (define cc-retry-st0
    (and live-game?
         (= (length ccs) 1)
         (hash-ref door-st-cc 'terran-cc-nat-retry-st #f)))
  (define pend-cc-pre (order-ledger-pending-count-for-type oledger 'command-center frame))
  (define cc-retry-st
    (cond
      [(and live-game? (= (length ccs) 1) (hash? cc-retry-st0))
       (define last-ef (hash-ref cc-retry-st0 'last-exp-f -1))
       (define counted? (hash-ref cc-retry-st0 'last-exp-counted? #t))
       (define old-fails
         (filter (lambda (f) (and (exact-integer? f) (<= 0 (- frame f)) (<= (- frame f) 360)))
                 (hash-ref cc-retry-st0 'fail-frames '())))
       (if (and (> last-ef 0)
                (not counted?)
                (= pend-cc-pre 0)
                (>= (- frame last-ef) 8))
           (let ([new-fails (cons frame old-fails)]
                 [new-st (hasheq 'last-exp-f last-ef
                                 'last-exp-counted? #t
                                 'fail-frames (cons frame old-fails))])
             (hash-set! door-st-cc 'terran-cc-nat-retry-st new-st)
             (hash-set! door-st-cc 'terran-cc-needs-depot-lower-until (+ frame 160))
             new-st)
           (if (equal? old-fails (hash-ref cc-retry-st0 'fail-frames '()))
               cc-retry-st0
               (let ([pruned (hash-set cc-retry-st0 'fail-frames old-fails)])
                 (hash-set! door-st-cc 'terran-cc-nat-retry-st pruned)
                 pruned)))]
      [else #f]))
  (define cc-fail-frames-now (if (hash? cc-retry-st) (hash-ref cc-retry-st 'fail-frames '()) '()))
  (define cc-fails-within-80 (count (lambda (f) (<= (- frame f) 80)) cc-fail-frames-now))
  (define cc-fails-total (length cc-fail-frames-now))
  (define terran-nat-cc-in-base-fallback?
    (and live-game?
         (= (length ccs) 1)
         (or (>= cc-fails-within-80 2)
             (>= cc-fails-total 2))))
  (define terran-nat-cc-fast-retry?
    (and live-game?
         (= (length ccs) 1)
         (= cc-fails-total 1)
         (hash? cc-retry-st)
         (>= (- frame (hash-ref cc-retry-st 'last-exp-f -9999)) 24)))
  (define terran-cc-expand-cd
    (cond
      [terran-nat-cc-in-base-fallback? 8]
      [terran-nat-cc-fast-retry? 24]
      [(and live-game? (< (length ccs) 2)) 196]
      [else SC2-EXPANSION-COOLDOWN-FRAMES]))
  (when (and (>= (l2-ctx-minerals ctx) (sc2-min-cost 'command-center))
                (or terran-contained-bank-breakout?
                    terran-3rd-cc-overdue-override?
                    brain-sched-t-nat-cc?
                    terran-nat-cc-in-base-fallback?
                    (l2-non-combat-min-ok? ctx (sc2-min-cost 'command-center) 'command-center))
                (or brain-sched-t-nat-cc?
                    terran-nat-cc-in-base-fallback?
                    (not blocked-nat-expanded-early?))
                (not under-early-cheese?)
                (not early-survival-crisis?)
                (or terran-contained-bank-breakout?
                    (and brain-sched-t-nat-cc? terran-light-poke-ok?)
                    (not crisis-freeze-expand-or-gas?))
                (or terran-contained-bank-breakout?
                    brain-sched-t-nat-cc?
                    (not under-base-attack?))
                (< (length ccs) SC2-MAX-ACTIVE-BASES)
                (= pend-cc-pre 0)
                (or terran-contained-bank-breakout?
                    terran-3rd-cc-overdue-override?
                    (< (length ccs) SC2-MIN-DESIRED-BASES)
                    (and (= (length ccs) 2)
                         (>= eff-phase-supply 42)
                         (or (not live-game?) (>= live-army-supply 10) (>= (l2-ctx-minerals ctx) 550))
                         (or (not live-game?)
                             (memq 'starport ready-bldg-types)
                             (>= (l2-ctx-minerals ctx) 550))
                         (or live-game?
                             (memq 'starport (l2-ctx-bldg-types ctx))
                             (memq 'factory (l2-ctx-bldg-types ctx))
                             (l2-plan-wants-now? ctx 'command-center)))
                    (and (< (length ccs) desired-bases)
                         (or (not live-game?)
                             (>= (length ccs) 3)
                             (and (>= eff-phase-supply 42)
                                  (not crisis-tech-upgrade-deferral?)
                                  (or (>= live-army-supply 8)
                                      (>= (l2-ctx-minerals ctx) 750))))
                         (or (not (and live-game?
                                       (= (length ccs) 2)
                                       (not (memq 'starport ready-bldg-types))))
                             (>= (l2-ctx-minerals ctx) 550))
                         (or (not (and endgame-corner-hunt?
                                       (< (l2-unit-count ctx 'viking) 2)))
                             (>= (- (l2-ctx-minerals ctx) (sc2-min-cost 'command-center)) 150))
                         (>= total-workers (* (length ccs)
                                              (if (>= (length ccs) 3) 16 SC2-MIN-WORKERS-PER-BASE-FOR-EXPAND)))
                         (or (coupled-macro-plan-should-expand? macro-plan)
                             (eq? (l2-ctx-prio-saving-for-sym ctx) 'command-center)
                             (>= frame SC2-MACRO-EXPAND-FRAME-THRESHOLD))))
                (or terran-nat-cc-in-base-fallback?
                    terran-nat-cc-fast-retry?
                    (not (l2-build-issue-blocked? ctx 'command-center)))
                (or terran-nat-cc-in-base-fallback?
                    terran-nat-cc-fast-retry?
                    (refractory-ready? cd-tracker '(macro-expand Terran) frame terran-cc-expand-cd))
                (or (and live-game? (= (length ccs) 1)
                         (or natural-blocked? natural-pad-camped? terran-nat-cc-in-base-fallback?))
                    (let-values ([(cand-ex cand-ey)
                                  (if (and live-game?
                                           (= (length ccs) 1)
                                           forward-proxy-detected?
                                           (< live-army-supply 10)
                                           (< (l2-ctx-minerals ctx) 550))
                                      (values #f #f)
                                      (l2-select-uncamped-expansion-pad ctx (< (length ccs) SC2-MIN-DESIRED-BASES)))])
                      (set! terran-exp-x cand-ex)
                      (set! terran-exp-y cand-ey)
                      ;; When 1-base Terran's natural pad is camped (`cand-ex == #f`, `#5131251` & `#5130502`),
                      ;; build the 2nd CC safely on the high ground in-main (morph Orbital + float later)!
                      (or (and cand-ex cand-ey)
                          terran-contained-bank-breakout?
                          brain-sched-t-nat-cc?
                          (and live-game?
                               (= (length ccs) 1)
                               (not forward-proxy-detected?)
                               (>= total-workers 17)
                               (memq 'barracks (l2-ctx-bldg-types ctx)))
                          (and live-game? (= (length ccs) 2) (>= (l2-ctx-minerals ctx) 500)))))
                (or terran-nat-cc-in-base-fallback?
                    terran-nat-cc-fast-retry?
                    (refractory-allow-action?! cd-tracker
                                               '(macro-expand Terran)
                                               frame
                                               terran-cc-expand-cd)))
       (cond
         [(and live-game?
               (= (length ccs) 1)
               (or natural-blocked?
                   natural-pad-camped?
                   terran-nat-cc-in-base-fallback?
                   (l2-enemy-early-pool-detected? ctx)
                   (not (and terran-exp-x terran-exp-y))))
          (when terran-nat-cc-in-base-fallback?
            (hash-set! door-st-cc 'terran-cc-needs-depot-lower-until (+ frame 160))
            (hash-remove! door-st-cc 'terran-cc-nat-retry-st)
            (when (and (refractory-cooldown-tracker? cd-tracker)
                       (hash? (refractory-cooldown-tracker-table cd-tracker)))
              (hash-remove! (refractory-cooldown-tracker-table cd-tracker)
                            (fast-build-issue-lock-key 'command-center))))
          (let-values ([(in-ccx in-ccy) (l2-interior-offset ctx 5.0 0.0)])
            (l2-emit-build-verified! ctx 'command-center in-ccx in-ccy))]
         [(and terran-exp-x terran-exp-y
               (l2-arbiter-authorize-spend!
                ctx 'command-center 'macro 820.0
                #:minerals (sc2-min-cost 'command-center)
                #:gas 0
                #:essential? #t))
          (when (and live-game? (= (length ccs) 1))
            (hash-set! door-st-cc 'terran-cc-nat-retry-st
                       (hasheq 'last-exp-f frame
                               'last-exp-counted? #f
                               'fail-frames cc-fail-frames-now))
            (hash-set! door-st-cc 'terran-cc-needs-depot-lower-until (+ frame 64)))
          (l2-emit! ctx (list 'expand terran-exp-x terran-exp-y))
          (l2-record-expand-pad-issued! ctx terran-exp-x terran-exp-y)
          (l2-record-build-issue-lock! ctx 'command-center)
          (order-ledger-record-issued! oledger (+ 810000 (modulo frame 10000)) 'expand 'command-center terran-exp-x terran-exp-y frame)
          (l2-spend-resources-and-supply! ctx (sc2-min-cost 'command-center) 0 0)]
         [(or terran-contained-bank-breakout?
              (and live-game? (= (length ccs) 2) (>= (l2-ctx-minerals ctx) 500)))
          (let-values ([(in-ccx in-ccy)
                        (l2-interior-offset ctx (* 4.0 (add1 (modulo (length ccs) 2)))
                                            (* -2.5 (modulo (length ccs) 2)))])
            (l2-emit-build-verified! ctx 'command-center in-ccx in-ccy))]))
  (define pending-cc-count
       (order-ledger-pending-count-for-type oledger 'command-center frame))
  (set-l2-ctx-pending-cc-count! ctx pending-cc-count)
  (define reserved-expansion-minerals
       (if live-game?
           (compute-natural-expansion-mineral-reserve
            #:race 'Terran
            #:frame frame
            #:active-bases (length ccs)
            #:pending-bases pending-cc-count
            #:workers total-workers
            #:under-attack? (or under-base-attack? early-survival-crisis?)
            #:enemy-threat-supply live-enemy-threat-supply
            #:natural-blocked? natural-blocked?
            #:escrow-expired? (or escrow-suppressed-active?
                                  early-survival-crisis?
                                  (l2-macro-brain-expand-backed-off? ctx)
                                  (>= cur-escrow-age-frames max-escrow-timeout-frames)
                                  urgent-combat-or-intel-need?
                                  (not (null? orphaned-prereqs))))
           0))
  (set-l2-ctx-reserved-expansion-minerals! ctx reserved-expansion-minerals)
  (l2-protect-unemitted-scheduled-expansion! ctx 'command-center)
  (define terran-saving-for-cc-expand?
       (or (l2-saving-for-expansion-now? ctx (length ccs))
           (and (> reserved-expansion-minerals 0) (< (l2-ctx-minerals ctx) reserved-expansion-minerals))))
  (set-l2-ctx-terran-saving-for-cc-expand?! ctx terran-saving-for-cc-expand?)
  (define terran-saving-for-expand?
       (or terran-saving-for-cc-expand?
           terran-saving-for-orbital?))
  (set-l2-ctx-terran-saving-for-expand?! ctx terran-saving-for-expand?)
  (define cur-bunker-cnt
       (+ (count (lambda (b) (eq? (fast-canonical-structure-sym (unit-type-sym b)) 'bunker)) ally-bldgs)
          (order-ledger-pending-count-for-type oledger 'bunker frame)))
  (define unfinished-bunker-cnt
       (+ (count (lambda (b)
                   (and (hash? b)
                        (eq? (fast-canonical-structure-sym (unit-type-sym b)) 'bunker)
                        (< (hash-ref b 'build-progress 1.0) SC2-BUILD-COMPLETE-PROGRESS)))
                 ally-bldgs)
          (order-ledger-pending-count-for-type oledger 'bunker frame)))
  ;; W8-P0-3-rt / L25-P0-3 / L49-W1 / L63B Bug #1B: Require Marine backing (>= 2 Marines, or >= 1 only
  ;; vs >= 2 Reapers or active base breach), cap < 4:00 Bunkers at 1 unless >= 6 Marines & attack/crisis,
  ;; allow 0 unfinished Bunkers in parallel, and protect < 2:15 1-base Natural CC from non-breach Bunkers!
  (define l2-terran-cur-marines (l2-unit-count ctx 'marine))
  (define l2-terran-enemy-reapers
    (max (count (lambda (e)
                  (and (hash? e)
                       (eq? (fast-canonical-unit-sym (unit-type-sym e)) 'reaper)))
                enemy-units)
         (let* ([rt3 (l2-ctx-rt ctx)]
                [os (and rt3 (opponent-world-model-last-summary (rt-opponent-world-model rt3)))]
                [kc (and os (opponent-world-summary-known-unit-counts os))])
           (if (hash? kc) (hash-ref kc 'reaper 0) 0))))
  (define l2-terran-bunker-marine-ok?
    (or (not live-game?)
        (>= l2-terran-cur-marines 2)
        (and (>= l2-terran-cur-marines 1)
             (or (>= l2-terran-enemy-reapers 2)
                 under-base-attack?))))
  (define l2-terran-protect-early-nat-cc-bunker?
    (and live-game?
         (= (length ccs) 1)
         (< frame 3024)
         (not under-base-attack?)
         (not (l2-ctx-worker-rush-active? ctx))
         (not (l2-ctx-in-base-proxy-detected? ctx))
         (< (- (l2-ctx-minerals ctx) (sc2-min-cost 'bunker))
            (sc2-min-cost 'command-center))))
  (define desired-bunker-cnt
       (if (and crisis-tech-upgrade-deferral?
                (or (not live-game?)
                    (if (< frame 5376)
                        (and (>= l2-terran-cur-marines 6)
                             (or under-base-attack? early-survival-crisis?))
                        (and (or early-survival-crisis?
                                 under-early-cheese?
                                 (and under-base-attack?
                                      (>= live-enemy-threat-supply 8)
                                      (> live-enemy-threat-supply live-army-supply)))
                             (>= l2-terran-cur-marines 4))))
                (or (>= live-army-supply 4)
                    (>= (l2-ctx-minerals ctx) 200)))
           2
           1))
  ;; L51-2B (`#20 TvZ PolyMorph`): Drop unnecessary `92s` (`< 2:30`) 1-base main Bunker against
  ;; peaceful zero-threat Hatch-first Zerg when no enemy combat unit is within 36t of Main or 30t of Natural.
  (define terran-zero-threat-early-zerg?
    (and live-game?
         (eq? (l2-ctx-effective-enemy-race ctx) 'Zerg)
         (<= (length ccs) 1)
         (< frame 3360)
         (not (l2-ctx-worker-rush-active? ctx))
         (not (l2-ctx-in-base-proxy-detected? ctx))
         (not forward-proxy-detected?)
         (not under-base-attack?)
         (not (for/or ([e (in-list enemy-units)])
                (and (hash? e)
                     (combat-unit-record? e)
                     (not (memq (unit-type-sym e) '(drone overlord overseer larva egg)))
                     (or (<= (dist2d base-x base-y (hash-ref e 'x 9999.0) (hash-ref e 'y 9999.0)) 36.0)
                         (<= (dist2d nat-x nat-y (hash-ref e 'x 9999.0) (hash-ref e 'y 9999.0)) 30.0)))))))
  (when (and (not terran-zero-threat-early-zerg?)
             (not l2-terran-protect-early-nat-cc-bunker?)
             l2-terran-bunker-marine-ok?
             (or early-survival-crisis?
                    under-early-cheese?
                    under-base-attack?
                    forward-proxy-detected?
                    (and (>= live-enemy-threat-supply 6)
                         (or (not live-game?)
                             (> live-enemy-threat-supply (* 1.15 live-army-supply)))))
                (not (and live-game?
                          (= (length ccs) 1)
                          terran-saving-for-cc-expand?
                          (l2-terran-1base-cc-intent? ctx)
                          (not early-survival-crisis?)
                          (not under-early-cheese?)
                          (not under-base-attack?)
                          (<= live-enemy-threat-supply live-army-supply)
                          (>= (l2-ctx-minerals ctx) 150)
                          (< (- (l2-ctx-minerals ctx) (sc2-min-cost 'bunker)) (sc2-min-cost 'command-center))))
                (memq 'barracks (l2-ctx-bldg-types ctx))
                ;; W6-P0-3-rt: Defer Bunker #2+ until Factory #1 drops when 100G is banked
                (or (= cur-bunker-cnt 0)
                    (not (l2-terran-need-factory1-now? ctx))
                    (>= (- (l2-ctx-minerals ctx) (sc2-min-cost 'bunker)) (sc2-min-cost 'factory)))
                (< cur-bunker-cnt desired-bunker-cnt)
                (< unfinished-bunker-cnt 1)
                (= (order-ledger-pending-count-for-type oledger 'bunker frame) 0)
                (l2-save-cancel-rebuild-ready? ctx 'bunker 60)
                (or (not (and p1-reaper-or-ling-swarm-override?
                              (memq 'factory ready-bldg-types)
                              (> (hash-ref open-prod-slots 'factory 0) 0)))
                    (>= (- (l2-ctx-minerals ctx) (sc2-min-cost 'bunker))
                        (l2-terran-early-fast-rush-min-reserve ctx)))
                (>= (l2-ctx-minerals ctx) (sc2-min-cost 'bunker))
                ;; L37-P0-2 (`#74 TvP who` WarpPrism DTs): Never let a blind Bunker (`100M`) spend
                ;; minerals ahead of urgent `MissileTurret #1` when Engineering Bay is already ready
                ;; and an un-turreted cloaked/DT/Banshee threat is active!
                (or (not (and live-game?
                              (memq 'engineering-bay ready-bldg-types)
                              (= (+ (l2-cur-ally-canon-bldg-count ctx 'missile-turret)
                                    (order-ledger-pending-count-for-type oledger 'missile-turret frame))
                                 0)
                              enemy-cloaked-or-burrowed-active?))
                    (>= (- (l2-ctx-minerals ctx) (sc2-min-cost 'bunker))
                        (sc2-min-cost 'missile-turret)))
                ;; W18-P0-3-rt (`#29` / `w18-tac-3`): Outside active main-base breach (`not under-base-attack?`),
                ;; when Brain ranked Marine higher than Bunker, keep 50M for an idle Barracks Marine!
                (>= (- (l2-ctx-minerals ctx) (sc2-min-cost 'bunker))
                    (if (and live-game? (not under-base-attack?))
                        (let-values ([(smin _sgas) (l2-scheduled-combat-reserve ctx 'bunker)])
                          (min (sc2-min-cost 'marine) smin))
                        0)))
       (define-values (bk-x bk-y)
         (cond
           [(<= (length ccs) 1)
            (define-values (b-ux b-uy b-px b-py) (l2-interior-basis ctx base-x base-y))
            (define lat-b (if (> cur-bunker-cnt 0) 3.0 0.0))
            (values (safe-coord (+ base-x (* 0.25 (- nat-x base-x)) (* lat-b b-px)) base-x)
                    (safe-coord (+ base-y (* 0.25 (- nat-y base-y)) (* lat-b b-py)) base-y))]
           [(> cur-bunker-cnt 0)
            (define-values (n-ax n-ay) (l2-interior-offset ctx 0.0 3.5 nat-x nat-y))
            (l2-offset-defense-anchor ctx n-ax n-ay 5.5)]
           [else
            (l2-offset-defense-anchor ctx nat-x nat-y 5.5)]))
       (l2-emit-build-verified! ctx 'bunker bk-x bk-y))
  (when (and (null? barracks-list)
                (or (not live-game-obs?) (memq 'supply-depot ready-bldg-types))
                (not (l2-building-present-or-pending? ctx 'barracks))
                (l2-save-cancel-rebuild-ready? ctx 'barracks 60)
                (>= (l2-ctx-minerals ctx) (sc2-min-cost 'barracks))
                (>= (- (l2-ctx-minerals ctx) (sc2-min-cost 'barracks)) hard-supply-lockout-reserve-min))
       ;; L48-W2 (Terran In-Main Barracks #1 Under Worker Rush / Early Crisis):
       ;; Never build Barracks #1 out on the exposed 12.7t ramp during a worker rush or early crisis!
       ;; Tuck Barracks #1 tightly inside the main behind the CC (`3.5t`) so the builder SCV stays safe!
       (define terran-rush-in-main-rax1?
         (or (l2-ctx-worker-rush-active? ctx)
             early-survival-crisis?
             under-base-attack?))
       (define wall-rax
         (and allow-exact-wall-slot?
              (not bypass-wall-depot1?)
              (not terran-rush-in-main-rax1?)
              (<= (length ccs) 2)
              (hash-ref terran-ramp-wall 'barracks #f)))
       (define-values (def-rx0 def-ry0) (l2-interior-offset ctx 5.5 0.0))
       (define rx0 (if (pair? wall-rax) (safe-coord (car wall-rax) def-rx0) def-rx0))
       (define ry0 (if (pair? wall-rax) (safe-coord (cdr wall-rax) def-ry0) def-ry0))
       (l2-emit-build-verified! ctx 'barracks rx0 ry0 SC2-BUILD-SITE-MIN-CLEARANCE
                             #:exact-wall-slot? (and allow-exact-wall-slot?
                                                     (not bypass-wall-depot1?)
                                                     (not terran-rush-in-main-rax1?)
                                                     (<= (length ccs) 2)
                                                     (pair? wall-rax))))
  (define terran-cannon-breakout-mode?
       (and live-game?
            in-base-proxy-completed-cannon?
            (< (l2-unit-count ctx 'siege-tank) 2)))
  (set-l2-ctx-terran-cannon-breakout-mode?! ctx terran-cannon-breakout-mode?)
  (define desired-refineries
       (if (and early-survival-crisis?
                (not terran-cannon-breakout-mode?)
                (null? active-refineries))
           0
           (min (* SC2-GEYSERS-PER-BASE (length ccs))
                (if live-game?
                    (cond
                      [(and (>= (length ccs) 4) (>= total-workers 62) (< (l2-ctx-gas ctx) 600)) 8]
                      [(and (>= (length ccs) 3) (>= total-workers 50) (< (l2-ctx-gas ctx) 450)) 6]
                      [(and (>= eff-phase-supply 56) (>= total-workers 42) (< (l2-ctx-gas ctx) 350)) 4]
                      [(and (>= eff-phase-supply 44) (>= total-workers 34) (< (l2-ctx-gas ctx) 300)) 3]
                      [(and (or (memq 'factory (l2-ctx-bldg-types ctx)) (>= eff-phase-supply 22))
                            (>= total-workers 21)
                            (< (l2-ctx-gas ctx) 250))
                       2]
                      [else 1])
                    (cond
                      [(>= supply-used 56) 4]
                      [(>= supply-used 44) 3]
                      [(or (memq 'factory (l2-ctx-bldg-types ctx)) (>= supply-used 22)) 2]
                      [else 1])))))
  ;; L23-P0-3 (`#35 TvZ` `tvz_late_depot2_loss`): Defer L2 Refinery in TvZ while `< 2:00`
  ;; (`< 2688f`) and `< 2` ACTUAL started Supply Depots in `ally-bldgs` so `Depot -> Barracks -> Depot`
  ;; seals the main ramp before a 3-tile Refinery can start ahead of a walking Depot #2 SCV!
  (define tvz-defer-ref-for-depot2?
    (and live-game?
         (eq? (l2-ctx-effective-enemy-race ctx) 'Zerg)
         (< frame 2688)
         (< (count (lambda (b)
                     (and (hash? b)
                          (eq? (fast-canonical-structure-sym (unit-type-sym b)) 'supply-depot)))
                   ally-bldgs)
            2)))
  ;; L34-P0-3 (`#74` TvT `CloakLoss -> 0`): Never let Refinery (`75M`) steal minerals below `100M`
  ;; when Engineering Bay is ready and an emergency or Brain-scheduled Missile Turret is needed!
  (define terran-defer-ref-for-urgent-turret?
    (and live-game?
         (memq 'engineering-bay ready-bldg-types)
         (let ([tech-obs-p1 (l2-ctx-tech-obs ctx)]
               [md-p1 (l2-ctx-macro-decision ctx)])
           (or (enemy-tech-observation-requires-detection? tech-obs-p1)
               (enemy-tech-observation-requires-anti-air? tech-obs-p1)
               (eq? (l2-ctx-prio-saving-for-sym ctx) 'missile-turret)
               (and (macro-brain-decision? md-p1)
                    (memq 'missile-turret (macro-brain-decision-scheduled-ids md-p1)))))
         (< (+ (count (lambda (t) (eq? t 'missile-turret)) (l2-ctx-bldg-types ctx))
               (order-ledger-pending-count-for-type oledger 'missile-turret frame))
            2)
         (< (- (l2-ctx-minerals ctx) (sc2-min-cost 'refinery))
            (sc2-min-cost 'missile-turret))))
  (when (and (memq 'barracks (l2-ctx-bldg-types ctx))
                (not terran-defer-ref-for-urgent-turret?)
                (or terran-cannon-breakout-mode? (not tvz-defer-ref-for-depot2?))
                (or terran-cannon-breakout-mode? (not crisis-freeze-expand-or-gas?))
                (l2-save-cancel-rebuild-ready? ctx 'refinery 60)
                (or (null? active-refineries) (not terran-saving-for-expand?) terran-cannon-breakout-mode?)
                ;; W6-P0-3-rt: Defer Refinery #2+ until Factory #1 drops once 100G is banked
                (or (null? active-refineries)
                    terran-cannon-breakout-mode?
                    (not (l2-terran-need-factory1-now? ctx))
                    (>= (- (l2-ctx-minerals ctx) (sc2-min-cost 'refinery)) (sc2-min-cost 'factory)))
                (let ([cur-ref-cnt (+ (length active-refineries)
                                      (order-ledger-pending-count-for-type oledger 'refinery frame))])
                  (and (< cur-ref-cnt desired-refineries)
                       (or (not live-game?)
                           terran-cannon-breakout-mode?
                           (>= total-workers
                               (pro-min-workers-for-next-gas-bldg 'Terran (l2-ctx-effective-enemy-race ctx) cur-ref-cnt)))))
                (or (< (length active-refineries) 2)
                    (l2-starport-escrow-ok? ctx (sc2-min-cost 'refinery) 0))
                ;; W12 (`Suite 5.17` / `#5112039`) + L23-P0-3: Unscheduled Refinery #3+ must never
                ;; steal from any Brain-scheduled build; unscheduled Refinery #1/#2 must never steal
                ;; from a Brain-scheduled major (>= 150M) structure + scheduled SCV!
                (or (not live-game?)
                    terran-cannon-breakout-mode?
                    (let ([md (l2-ctx-macro-decision ctx)])
                      (or (not (macro-brain-decision? md))
                          (let ([sids (macro-brain-decision-scheduled-ids md)])
                            (or (null? sids)
                                (memq 'refinery sids)
                                (if (>= (length active-refineries) 2)
                                    (not (ormap (lambda (sid)
                                                  (define n (lookup-sc2-tech-node sid))
                                                  (and n
                                                       (eq? (sc2-tech-node-kind n) 'build)
                                                       (not (eq? sid 'refinery))
                                                       (< (- (l2-ctx-minerals ctx) (sc2-min-cost 'refinery))
                                                          (sc2-min-cost sid))))
                                                sids))
                                    (let ([major-bldg-min
                                           (for/sum ([sid (in-list sids)])
                                             (define n (lookup-sc2-tech-node sid))
                                             (if (and n
                                                      (eq? (sc2-tech-node-kind n) 'build)
                                                      (not (eq? sid 'refinery))
                                                      (>= (sc2-min-cost sid) 150))
                                                 (sc2-min-cost sid)
                                                 0))])
                                      (or (<= major-bldg-min 0)
                                          (>= (- (l2-ctx-minerals ctx) (sc2-min-cost 'refinery))
                                              (+ major-bldg-min
                                                 (if (memq 'scv sids) (sc2-min-cost 'scv) 0)))))))))))
                (or (not live-game?)
                    (< (length active-refineries) 2)
                    (< (l2-ctx-gas ctx) 150)
                    (>= (- (l2-ctx-minerals ctx) (sc2-min-cost 'refinery)) (l2-ctx-bo-reserved-min ctx)))
                (>= (l2-ctx-minerals ctx) (sc2-min-cost 'refinery))
                (or terran-cannon-breakout-mode? (l2-non-combat-min-ok? ctx (sc2-min-cost 'refinery))))
       (l2-emit-gas-build-verified! ctx 'refinery (safe-coord (+ base-x 3.0)) (safe-coord (+ base-y 5.0)))))

(define (l2-terran-phase2-tech-starport! ctx)
  (define active-refineries (l2-ctx-active-refineries ctx))
  (define ally-bldgs (l2-ctx-ally-bldgs ctx))
  (define ally-combat-units (l2-ctx-ally-combat-units ctx))
  (define barracks-list (l2-ctx-barracks-list ctx))
  (define base-x (l2-ctx-base-x ctx))
  (define base-y (l2-ctx-base-y ctx))
  (define ccs (l2-ctx-ccs ctx))
  (define cd-tracker (l2-ctx-cd-tracker ctx))
  (define claimed-addon-fac-ids (l2-ctx-claimed-addon-fac-ids ctx))
  (define crisis-tech-upgrade-deferral? (l2-ctx-crisis-tech-upgrade-deferral? ctx))
  (define early-survival-crisis? (l2-ctx-early-survival-crisis? ctx))
  (define eff-phase-supply (l2-ctx-eff-phase-supply ctx))
  (define effective-enemy-race (l2-ctx-effective-enemy-race ctx))
  (define endgame-corner-hunt? (l2-ctx-endgame-corner-hunt? ctx))
  (define enemy-units (l2-ctx-enemy-units ctx))
  (define factories-list (l2-ctx-factories-list ctx))
  (define frame (l2-ctx-frame ctx))
  (define live-army-supply (l2-ctx-live-army-supply ctx))
  (define live-enemy-threat-supply (l2-ctx-live-enemy-threat-supply ctx))
  (define live-game? (l2-ctx-live-obs-harvesters? ctx))
  (define nat-x (l2-ctx-nat-x ctx))
  (define nat-y (l2-ctx-nat-y ctx))
  (define oledger (l2-ctx-oledger ctx))
  (define open-prod-slots (l2-ctx-open-prod-slots ctx))
  (define pending-cc-count (l2-ctx-pending-cc-count ctx))
  (define ready-bldg-types (l2-ctx-ready-bldg-types ctx))
  (define reserved-expansion-minerals (l2-ctx-reserved-expansion-minerals ctx))
  (define rt (l2-ctx-rt ctx))
  (define tech-obs (l2-ctx-tech-obs ctx))
  (define terran-cannon-breakout-mode? (l2-ctx-terran-cannon-breakout-mode? ctx))
  (define terran-saving-for-expand? (l2-ctx-terran-saving-for-expand? ctx))
  (define terran-saving-for-orbital? (l2-ctx-terran-saving-for-orbital? ctx))
  (define total-bldg-counts (l2-ctx-total-bldg-counts ctx))
  (define total-workers (l2-ctx-total-workers ctx))
  (define under-base-attack? (l2-ctx-under-base-attack? ctx))
  (define under-early-cheese? (l2-ctx-under-early-cheese? ctx))
  (define urgent-combat-or-intel-need? (l2-ctx-urgent-combat-or-intel-need? ctx))
  (define known-heavy-race? (and (memq effective-enemy-race '(Protoss Zerg Terran)) #t))
  (define-values (enemy-capital-air? enemy-queen-count-t enemy-caster-nonqueen? enemy-heavy-mech-or-bio? addon-threat-enemies-rev)
    (for/fold ([cap-air? #f] [qcnt 0] [caster? #f] [heavy? #f] [threats-rev '()])
              ([e (in-list enemy-units)])
      (define ut (unit-type-sym e))
      (define cut (fast-canonical-unit-sym ut))
      (values
       (or cap-air? (and (memq cut THOR-CAPITAL-AIR-SYMS) #t))
       (if (eq? cut 'queen) (add1 qcnt) qcnt)
       (or caster?
           (and (memq cut '(infestor infestor-burrowed viper high-templar archon
                                     lurker lurker-burrowed brood-lord))
                #t))
       (or heavy?
           (and live-game?
                (not known-heavy-race?)
                (memq ut '(stalker immortal marauder roach ravager siege-tank siege-tank-sieged thor colossus ultralisk))
                #t))
       (if (and live-game? (combat-unit-record? e))
           (cons e threats-rev)
           threats-rev))))
  (set-l2-ctx-enemy-capital-air?! ctx enemy-capital-air?)
  (define enemy-caster-or-queen-swarm?
       (or (>= enemy-queen-count-t 4) enemy-caster-nonqueen?))
  (define cur-rax-techlab-cnt
       (+ (count (lambda (t) (memq t '(barracks-techlab tech-lab))) (l2-ctx-bldg-types ctx))
          (order-ledger-pending-count-for-type oledger 'barracks-techlab frame)))
  (define desired-rax-techlabs
       (if (and live-game?
                (or known-heavy-race? enemy-heavy-mech-or-bio?))
           (cond
             [(>= (length barracks-list) 5) 3]
             [(>= (length barracks-list) 3) 2]
             [else 1])
           1))
  (define has-rax-techlab?
       (or (>= cur-rax-techlab-cnt desired-rax-techlabs)
           (and (= desired-rax-techlabs 1)
                (l2-building-present-or-pending? ctx 'barracks-techlab #t))))
  (define addon-threat-enemies (reverse addon-threat-enemies-rev))
  (define (facility-safe-for-addon? fac)
       (or (not live-game?)
           (and (not (l2-addon-pad-blocked? ctx fac))
                (let ([fx (exact->inexact (hash-ref fac 'x base-x))]
                      [fy (exact->inexact (hash-ref fac 'y base-y))])
                  (and (not (eq? (hash-ref fac 'under-attack #f) #t))
                       (not (for/or ([e (in-list addon-threat-enemies)])
                              (define dx (- fx (exact->inexact (hash-ref e 'x 9999.0))))
                              (define dy (- fy (exact->inexact (hash-ref e 'y 9999.0))))
                              ;; W18-P0-3-rt (`#14`): Tighten undamaged addon proximity veto `10t -> 6.5t`
                              ;; (`42.25` sq-dist) so enemies at the natural ramp never block in-main Factory TechLab!
                              (<= (+ (* dx dx) (* dy dy)) 42.25))))))))
  ;; L37-P0-2 (`#74 TvP who` WarpPrism DTs): Fire urgent anti-cloak Missile Turret (`100M`)
  ;; BEFORE Factory/Starport/Barracks/Reactor can spend minerals whenever Engineering Bay is
  ;; ready and confirmed DT/DarkShrine/Banshee/Brain-scheduled turret threat is active!
  (define p2-cloak-turret-urgent?
    (and live-game?
         (memq 'engineering-bay ready-bldg-types)
         (or (enemy-tech-observation-requires-detection? tech-obs)
             (eq? (l2-ctx-prio-saving-for-sym ctx) 'missile-turret)
             (and (macro-brain-decision? (l2-ctx-macro-decision ctx))
                  (memq 'missile-turret (macro-brain-decision-scheduled-ids (l2-ctx-macro-decision ctx))))
             (ormap (lambda (eb)
                      (and (hash? eb)
                           (memq (fast-canonical-structure-sym (unit-type-sym eb))
                                 '(dark-shrine lurker-den lurker-den-mp))))
                    (or (l2-ctx-enemy-bldgs ctx) '()))
             (ormap (lambda (e)
                      (and (hash? e)
                           (memq (fast-canonical-unit-sym (unit-type-sym e))
                                 '(dark-templar banshee lurker-burrowed lurker-mp-burrowed))))
                    enemy-units))))
  (when p2-cloak-turret-urgent?
    (define cur-t-pre
      (+ (count (lambda (t) (eq? t 'missile-turret)) (l2-ctx-bldg-types ctx))
         (order-ledger-pending-count-for-type oledger 'missile-turret frame)))
    (define want-t-pre (min 2 (max 1 (length ccs))))
    (when (and (< cur-t-pre want-t-pre)
               (>= (l2-ctx-minerals ctx) (sc2-min-cost 'missile-turret))
               (l2-save-cancel-rebuild-ready? ctx 'missile-turret 60)
               (refractory-allow-action?! cd-tracker
                                          (list 'static-detector 'missile-turret)
                                          frame
                                          (if (= cur-t-pre 0) 44 SC2-STATIC-DETECTOR-COOLDOWN-FRAMES)))
      (define-values (tx0 ty0)
        (if (and (> cur-t-pre 0) (>= (length ccs) 2))
            (l2-mineral-line-offset ctx nat-x nat-y 3.5)
            (l2-mineral-line-offset ctx base-x base-y 3.5)))
      (l2-emit-build-verified! ctx 'missile-turret tx0 ty0 #:waive-worker-reserve? #t)))
  ;; W3-P0-3a / L32-P0-3 (`#35`/`H2H #02` Terran Factory #2 Alignment): Align L2 `desired-factories`
  ;; with Macro Brain (`brain-sched-fac-now?` OR `>= 2` CCs in TvT/TvP at `eff-phase-supply >= 44` & `gas >= 100`)
  ;; so Factory #2 never stalls behind `eff-phase-supply >= 68`!
  (define brain-sched-fac-now?
    (and live-game?
         (or (eq? (l2-ctx-prio-saving-for-sym ctx) 'factory)
             (and (macro-brain-decision? (l2-ctx-macro-decision ctx))
                  (memq 'factory (macro-brain-decision-scheduled-ids (l2-ctx-macro-decision ctx)))))))
  (define tvp-fac2-prereqs-ok?
    (or (not (eq? effective-enemy-race 'Protoss))
        (and (>= (+ (length ccs)
                    (order-ledger-pending-count-for-type oledger 'command-center frame))
                 2)
             (l2-building-present-or-pending? ctx 'starport))))
  (define desired-factories
       (cond
         [(not live-game?) 1]
         [(and (eq? effective-enemy-race 'Terran)
               (>= (length ccs) 2)
               (or brain-sched-fac-now?
                   (and (>= eff-phase-supply 44)
                        (>= (l2-ctx-gas ctx) 100))))
          2]
         [(and (eq? effective-enemy-race 'Protoss)
               tvp-fac2-prereqs-ok?
               (or brain-sched-fac-now?
                   (and (>= eff-phase-supply 56)
                        (>= (l2-ctx-gas ctx) 125))))
          2]
         [(and (>= (length ccs) 3)
               tvp-fac2-prereqs-ok?
               (or brain-sched-fac-now?
                   (and (>= eff-phase-supply 106) (>= (l2-ctx-gas ctx) 200))))
          2]
         [else 1]))
  (define rush-factory-vs-proxy-cannon?
       (and terran-cannon-breakout-mode?
            (null? factories-list)))
  (define stimpack-ready-ahead-of-factory?
       (and (memq 'barracks-techlab ready-bldg-types)
            (not urgent-combat-or-intel-need?)
            (l2-upgrade-needed? ctx 'stimpack)
            (or (not live-game?)
                (>= (count (lambda (b)
                             (and (hash? b)
                                  (memq (unit-type-sym b) '(orbital-command orbital-command-flying))))
                           ally-bldgs)
                    2))
            (>= (l2-ctx-minerals ctx) (sc2-min-cost 'stimpack))
            (>= (l2-ctx-gas ctx) (sc2-gas-cost 'stimpack))))
  ;; L34-P0-3 (`#77` TvT 0 Tanks): Protect Siege Tank #1 (and Tank #2 in TvT when Brain
  ;; schedules `siege-tank`) from Factory #2 gas theft whenever a `factory-techlab` is ready
  ;; unless `min >= 300 & gas >= 225` (afford BOTH Tank and Factory #2)!
  ;; L37-P0-2: `l2-unit-count` canonicalizes `'siege-tank-sieged -> 'siege-tank`; never add both (avoids 2x double-count!)
  (define cur-tank-cnt-p2
    (+ (l2-unit-count ctx 'siege-tank)
       (order-ledger-pending-count-for-type oledger 'siege-tank frame)))
  (define brain-sched-tank-p2?
    (and live-game?
         (or (eq? (l2-ctx-prio-saving-for-sym ctx) 'siege-tank)
             (and (member '(train siege-tank) (l2-ctx-prio-scheduled-actions ctx)) #t)
             (and (macro-brain-decision? (l2-ctx-macro-decision ctx))
                  (memq 'siege-tank (macro-brain-decision-scheduled-ids (l2-ctx-macro-decision ctx)))))))
  (define fac2-defer-for-tank-unlock?
    (and live-game?
         (pair? factories-list)
         (memq 'factory-techlab ready-bldg-types)
         (or (= cur-tank-cnt-p2 0)
             (and (eq? effective-enemy-race 'Terran)
                  (< cur-tank-cnt-p2 2)
                  (or brain-sched-tank-p2?
                      (and (> (hash-ref open-prod-slots 'factory 0) 0)
                           (>= (l2-ctx-gas ctx) (sc2-gas-cost 'siege-tank))))))
         (not (and (>= (l2-ctx-minerals ctx) 300)
                   (>= (l2-ctx-gas ctx) 225)))))
  ;; Loop 63B Bug #1B (`#56` oc1 delay): Defer Factory #1 when 0 OCs are present/pending
  ;; and Brain scheduled `(morph orbital-command)` (or ranked `orbital-command` ahead of `factory`
  ;; while CC finishes an SCV with `facility-busy`) until >= 300M (covers both OC #1 + Factory #1).
  (define fac1-defer-for-oc1?
    (and live-game?
         (null? factories-list)
         (not (l2-building-present-or-pending? ctx 'orbital-command))
         (< (l2-ctx-minerals ctx) 300)
         (or (eq? (l2-ctx-prio-saving-for-sym ctx) 'orbital-command)
             (and (member '(morph orbital-command) (l2-ctx-prio-scheduled-actions ctx)) #t)
             (let ([md (l2-ctx-macro-decision ctx)])
               (and (macro-brain-decision? md)
                    (or (and (memq 'orbital-command (macro-brain-decision-scheduled-ids md)) #t)
                        (let ([sched (macro-brain-decision-priority-schedule md)])
                          (and (priority-schedule-result? sched)
                               (let loop ([rem (priority-schedule-decision-trace sched)])
                                 (cond
                                   [(null? rem) #f]
                                   [(not (priority-decision-entry? (car rem))) (loop (cdr rem))]
                                   [(eq? (priority-decision-entry-id (car rem)) 'orbital-command)
                                    (not (not (memq (priority-decision-entry-outcome (car rem))
                                                    '(scheduled facility-busy escrowed-saving))))]
                                   [(eq? (priority-decision-entry-id (car rem)) 'factory) #f]
                                   [else (loop (cdr rem))]))))))))))
  (when (and (memq 'barracks ready-bldg-types)
                (not fac2-defer-for-tank-unlock?)
                ;; L53-W2-1: Gate Factory #2+ behind Starport #1 (matching Brain 1-1-1 order)
                ;; unless banking >= 600M & >= 300G, AND when Starport #1 is ready & idle with
                ;; 0 Medivacs (+ >= 4 Bio), yield 100G so Medivac #1 trains before Factory #2!
                (or (not live-game?)
                    (null? factories-list)
                    (l2-building-present-or-pending? ctx 'starport)
                    (and (>= (l2-ctx-minerals ctx) 600)
                         (>= (l2-ctx-gas ctx) 300)))
                (not (and live-game?
                          (not (eq? effective-enemy-race 'Terran))
                          (pair? factories-list)
                          (memq 'starport ready-bldg-types)
                          (> (hash-ref open-prod-slots 'starport 0) 0)
                          (= (l2-unit-count ctx 'medivac) 0)
                          (>= (+ (l2-unit-count ctx 'marine) (l2-unit-count ctx 'marauder)) 4)
                          (< (l2-ctx-gas ctx) (+ (sc2-gas-cost 'factory) (sc2-gas-cost 'medivac)))))
                (or (not terran-saving-for-expand?) rush-factory-vs-proxy-cannon?)
                (or (not fac1-defer-for-oc1?) rush-factory-vs-proxy-cannon?)
                (or rush-factory-vs-proxy-cannon?
                    (not stimpack-ready-ahead-of-factory?)
                    (>= (- (l2-ctx-gas ctx) (sc2-gas-cost 'factory)) (sc2-gas-cost 'stimpack)))
                (l2-save-cancel-rebuild-ready? ctx 'factory 60)
                (< (+ (length factories-list) (order-ledger-pending-count-for-type oledger 'factory frame))
                   desired-factories)
                (or (null? factories-list)
                    brain-sched-fac-now?
                    (l2-can-spend-by-priority? ctx 'factory 'production-scaling)
                    (and (memq effective-enemy-race '(Terran Protoss))
                         (>= (length ccs) 2)
                         (>= eff-phase-supply 44)
                         (>= (l2-ctx-minerals ctx) (sc2-min-cost 'factory))
                         (>= (l2-ctx-gas ctx) (sc2-gas-cost 'factory)))
                    (>= (l2-ctx-minerals ctx) 400))
                (or rush-factory-vs-proxy-cannon?
                    (>= (- (l2-ctx-minerals ctx) reserved-expansion-minerals) (sc2-min-cost 'factory)))
                (>= (l2-ctx-minerals ctx) (sc2-min-cost 'factory))
                (>= (l2-ctx-gas ctx) (sc2-gas-cost 'factory))
                (or rush-factory-vs-proxy-cannon?
                    ;; W6-P0-3-rt: First Factory (150M/100G) emits immediately at 150M/100G
                    ;; without worker/combat surcharges (still respecting hard supply lockout)
                    (and (or (l2-terran-need-factory1-now? ctx) brain-sched-fac-now?)
                         (>= (- (l2-ctx-minerals ctx) (sc2-min-cost 'factory))
                             (l2-ctx-hard-supply-lockout-reserve-min ctx)))
                    (and (l2-non-combat-min-ok? ctx (sc2-min-cost 'factory) 'factory)
                         (l2-non-combat-gas-ok? ctx (sc2-gas-cost 'factory) 'factory))))
       (define fac-idx (length factories-list))
       (let-values ([(fx fy) (l2-interior-offset ctx (* (add1 fac-idx) SC2-TERRAN-FACILITY-STEP-X) SC2-TERRAN-FACILITY-STEP-Y)])
         (l2-emit-build-verified! ctx 'factory fx fy)))
  (define terran-factory1-gas-guard?
       (and live-game?
            (not stimpack-ready-ahead-of-factory?)
            (memq 'barracks ready-bldg-types)
            (null? factories-list)
            (= (order-ledger-pending-count-for-type oledger 'factory frame) 0)
            (l2-save-cancel-rebuild-ready? ctx 'factory 60)))
  (define (terran-factory1-gas-ok? gas-cost)
       (or (not terran-factory1-gas-guard?)
           (>= (- (l2-ctx-gas ctx) gas-cost) (sc2-gas-cost 'factory))))
  ;; W8-P0-3-rt / W17-P1-1-rt (`#14` <5:30 proxy 2-Rax Marauder rush): Defer Barracks addons
  ;; on a solo Barracks under active early rush/proxy threat (< 4000f < 6 Marines, OR < 7392f
  ;; < 16 army supply with enemy threat >= our army or >= 3 early Marauders / rush near natural)
  ;; so Barracks #1 pumps continuous Bio instead of locking for 18s on a TechLab!
  (define early-rush-enemy-near-nat-sup
       (if (and live-game? (< frame 7392) (< live-army-supply 16))
           (for/sum ([e (in-list enemy-units)]
                     #:when (and (hash? e)
                                 (combat-unit-record? e)
                                 (let ([ex (exact->inexact (hash-ref e 'x 9999.0))]
                                       [ey (exact->inexact (hash-ref e 'y 9999.0))])
                                   (or (<= (fast-dist2d ex ey base-x base-y) 32.0)
                                       (<= (fast-dist2d ex ey nat-x nat-y) 26.0)))))
             (max 1.0 (exact->inexact (sc2-supply-cost (fast-canonical-unit-sym (unit-type-sym e)) 1))))
           0.0))
  (define terran-early-proxy-or-marauder-pressure?
       (and live-game?
            (< frame 7392)
            (< live-army-supply 16)
            (or under-base-attack?
                under-early-cheese?
                early-survival-crisis?
                (l2-ctx-forward-proxy-detected? ctx)
                (> live-enemy-threat-supply live-army-supply)
                (> early-rush-enemy-near-nat-sup live-army-supply)
                (>= (count (lambda (e)
                             (and (hash? e)
                                  (eq? (fast-canonical-unit-sym (unit-type-sym e)) 'marauder)))
                           enemy-units)
                    (if (< frame 5600) 2 3)))))
