    (let ([r (exact->inexact SC2-NATURAL-BLOCK-RADIUS)]) (* r r)))
  (set-l2-ctx-nat-block-thresh2! ctx nat-block-thresh2)
  (define natural-blocked?
    (or (hash-ref obs 'natural-blocked #f)
        (l2-pad-camped-by-enemy? ctx nat-x nat-y 11.5)
        (and (<= (length townhalls) 1)
             (< frame 2500)
             (l2-any-natural-blocker? ctx))))
  (set-l2-ctx-natural-blocked?! ctx natural-blocked?)
  (define uncamped-pad-cache (pooled-hasheq! l2-sc 'uncamped-pad-cache))
  (set-l2-ctx-uncamped-pad-cache! ctx uncamped-pad-cache)
  (define early-base-under-attack?
    (or early-survival-crisis?
        (for/or ([b (in-list ally-bldgs)])
          (eq? (hash-ref b 'under-attack #f) #t))
        (let ([fbx (if (real? base-x) (exact->inexact base-x) #f)]
              [fby (if (real? base-y) (exact->inexact base-y) #f)]
              [fnx (if (real? nat-x) (exact->inexact nat-x) #f)]
              [fny (if (real? nat-y) (exact->inexact nat-y) #f)])
          (for/or ([e (in-list enemy-units)])
            (and (combat-unit-record? e)
                 (let ([ex (hash-ref e 'x 9999.0)]
                       [ey (hash-ref e 'y 9999.0)])
                   (if (and (real? ex) (= (- ex ex) 0)
                            (real? ey) (= (- ey ey) 0)
                            fbx fby fnx fny)
                       (let* ([fex (exact->inexact ex)]
                              [fey (exact->inexact ey)]
                              [dx1 (fl- fex fbx)]
                              [dy1 (fl- fey fby)]
                              [d1sq (fl+ (fl* dx1 dx1) (fl* dy1 dy1))])
                         (or (fl<= d1sq 784.0)
                             (and (or (>= active-bases 2) live-obs-harvesters?)
                                  (let* ([dx2 (fl- fex fnx)]
                                         [dy2 (fl- fey fny)]
                                         [d2sq (fl+ (fl* dx2 dx2) (fl* dy2 dy2))])
                                    (or (and (>= active-bases 2) (fl<= d2sq 784.0))
                                        (and live-obs-harvesters? (fl<= d2sq 256.0)))))))
                       (or (<= (min (dist2d base-x base-y ex ey)
                                    (if (>= active-bases 2)
                                        (dist2d nat-x nat-y ex ey)
                                        +inf.0))
                               28.0)
                           (and live-obs-harvesters?
                                (<= (dist2d nat-x nat-y ex ey) 16.0))))))))))
  (define blocked-nat-expanded-early? #f)
  (set-l2-ctx-blocked-nat-expanded-early?! ctx blocked-nat-expanded-early?)
  (when (and natural-blocked?
             (not early-survival-crisis?)
             (not early-base-under-attack?)
             (< active-bases SC2-MAX-ACTIVE-BASES)
             (= (order-ledger-pending-count-for-type oledger-early early-race-th-sym frame) 0)
             (or (not (eq? race 'Terran)) (memq 'barracks (l2-ctx-bldg-types ctx)))
             (or (not live-obs-harvesters?)
                 (and (<= active-bases 1)
                      (or (memq 'barracks (l2-ctx-bldg-types ctx))
                          (memq 'spawning-pool (l2-ctx-bldg-types ctx))
                          (memq 'gateway (l2-ctx-bldg-types ctx))
                          (memq 'warp-gate (l2-ctx-bldg-types ctx)))))
             (or (hash-ref obs 'natural-blocked #f)
                 (refractory-allow-action?! cd-tracker (list 'blocked-nat-expand race) frame SC2-EXPANSION-COOLDOWN-FRAMES)))
    (l2-emit! ctx (list 'clear-expansion-block nat-x nat-y))
    (if (eq? race 'Terran)
        (when (>= (l2-ctx-minerals ctx) (sc2-min-cost 'command-center))
          (set! blocked-nat-expanded-early? #t)
          (if live-obs-harvesters?
              (let-values ([(ccx ccy)
                            (order-ledger-resolve-build-coords!
                             oledger-early 'command-center
                             (safe-coord (+ base-x 6.0)) (safe-coord (- base-y 5.0))
                             ally-bldgs frame 2.5
                             #:expansion-pads expansion-pads)])
                (define sx (safe-coord ccx (+ base-x 6.0)))
                (define sy (safe-coord ccy (- base-y 5.0)))
                (l2-emit! ctx (list 'build 'command-center sx sy))
                (order-ledger-record-issued! oledger-early (+ 820000 (modulo frame 10000))
                                             'build 'command-center sx sy frame)
                (set-l2-ctx-bldg-types! ctx (cons 'command-center (l2-ctx-bldg-types ctx))))
              (l2-emit! ctx (list 'build 'command-center (safe-coord (+ base-x 4.0)) base-y)))
          (set-l2-ctx-minerals! ctx (max 0 (- (l2-ctx-minerals ctx) (sc2-min-cost 'command-center)))))
        (when (>= (l2-ctx-minerals ctx) (sc2-race-townhall-min-cost race))
          (define-values (bx3 by3)
            (if live-obs-harvesters?
                (l2-select-uncamped-expansion-pad ctx #f)
                (values third-x third-y)))
          (when (and bx3 by3)
            (set! blocked-nat-expanded-early? #t)
            (l2-emit! ctx (list 'expand bx3 by3))
            (order-ledger-record-issued! oledger-early (+ 830000 (modulo frame 10000))
                                         'expand early-race-th-sym bx3 by3 frame)
            (set-l2-ctx-minerals! ctx (max 0 (- (l2-ctx-minerals ctx) (sc2-race-townhall-min-cost race))))))))
  (define depleting-bases
    (hash-ref obs 'depleting-bases (if (hash-ref obs 'mined-out #f) 1 0)))
  (set-l2-ctx-depleting-bases! ctx depleting-bases)
  (define-values (prod-facilities gas-bldgs)
    (let ([pf-rev '()] [gb-rev '()])
      (for ([b (in-list ally-bldgs)])
        (define cs (fast-canonical-structure-sym (unit-type-sym b)))
        (cond
          [(memq cs '(hatchery lair hive gateway warp-gate warpgate robotics-facility stargate
                      barracks factory starport))
           (set! pf-rev (cons b pf-rev))]
          [(memq cs '(extractor assimilator refinery))
           (set! gb-rev (cons b gb-rev))]))
      (values (reverse pf-rev) (reverse gb-rev))))
  (set-l2-ctx-prod-facilities! ctx prod-facilities)
  (define mmstate (live-bot-runtime-mirror-mind rt))
  (define mstate (live-bot-runtime-mastermind rt))
  (define tech-obs
    (or (mirror-mind-state-last-tech-observation mmstate)
        (infer-enemy-implied-tech-and-upgrades enemy-units enemy-bldgs)))
  (set-l2-ctx-tech-obs! ctx tech-obs)
  (define has-th-harvesters?
    (or (hash-has-key? obs 'mineral-harvesters)
        (hash-has-key? obs 'ideal-mineral-harvesters)
        (for/or ([b (in-list townhalls)]) (and (hash? b) (hash-has-key? b 'assigned-harvesters)))))
  (define live-min-harvesters
    (and has-th-harvesters?
         (hash-ref obs 'mineral-harvesters
                   (lambda ()
                     (for/sum ([b (in-list townhalls)])
                       (if (hash? b) (safe-nonneg-int (hash-ref b 'assigned-harvesters 0) 0) 0))))))
  (define live-ideal-min-harvesters
    (and has-th-harvesters?
         (hash-ref obs 'ideal-mineral-harvesters
                   (lambda ()
                     (for/sum ([b (in-list townhalls)])
                       (if (hash? b)
                           (safe-nonneg-int (hash-ref b 'ideal-harvesters SC2-IDEAL-WORKERS-PER-MINERAL-LINE)
                                            SC2-IDEAL-WORKERS-PER-MINERAL-LINE)
                           SC2-IDEAL-WORKERS-PER-MINERAL-LINE))))))
  (define has-gas-harvesters?
    (or (hash-has-key? obs 'gas-harvesters)
        (hash-has-key? obs 'ideal-gas-harvesters)
        (for/or ([b (in-list gas-bldgs)]) (and (hash? b) (hash-has-key? b 'assigned-harvesters)))))
  (set-l2-ctx-has-gas-harvesters?! ctx has-gas-harvesters?)
  (define live-gas-harvesters
    (and has-gas-harvesters?
         (hash-ref obs 'gas-harvesters
                   (lambda ()
                     (for/sum ([b (in-list gas-bldgs)])
                       (if (hash? b) (safe-nonneg-int (hash-ref b 'assigned-harvesters 0) 0) 0))))))
  (set-l2-ctx-live-gas-harvesters! ctx live-gas-harvesters)
  (define live-ideal-gas-harvesters
    (and has-gas-harvesters?
         (hash-ref obs 'ideal-gas-harvesters
                   (lambda ()
                     (for/sum ([b (in-list gas-bldgs)])
                       (if (hash? b)
                           (safe-nonneg-int (hash-ref b 'ideal-harvesters SC2-IDEAL-WORKERS-PER-GEYSER)
                                            SC2-IDEAL-WORKERS-PER-GEYSER)
                           SC2-IDEAL-WORKERS-PER-GEYSER))))))
  (define macro-plan
    (evaluate-coupled-macro-governor
     #:race race
     #:frame frame
     #:minerals (l2-ctx-minerals ctx)
     #:gas (l2-ctx-gas ctx)
     #:supply-left (l2-ctx-supply-left ctx)
     #:active-bases active-bases
     #:depleting-bases depleting-bases
     #:workers active-worker-count
     #:pending-workers pending-workers
     #:mineral-harvesters live-min-harvesters
     #:ideal-mineral-harvesters live-ideal-min-harvesters
     #:gas-harvesters live-gas-harvesters
     #:ideal-gas-harvesters live-ideal-gas-harvesters
     #:production-facilities (max 1 (length prod-facilities))
     #:busy-facilities (hash-ref obs 'busy-facilities 0)
     #:busy-townhalls (hash-ref obs 'busy-townhalls 0)
     #:under-crisis? (or under-early-cheese? early-survival-crisis?)
     #:recommended-min-bases (mirror-mind-state-recommended-min-bases mmstate)))
  (set-l2-ctx-macro-plan! ctx macro-plan)
  (define target-workers (coupled-macro-plan-target-workers macro-plan))
  (set-l2-ctx-target-workers! ctx target-workers)
  (define desired-bases
    (max SC2-MIN-DESIRED-BASES
         (min SC2-MAX-ACTIVE-BASES (coupled-macro-plan-desired-bases macro-plan))))
  (set-l2-ctx-desired-bases! ctx desired-bases)
  (define res-upgs-tech (hash-ref obs 'researched-upgrades '()))
  (define tech-arch (mastermind-state-enemy-archetype mstate))
  (define tech-pred-u (mirror-mind-state-predicted-enemy-unit mmstate))
  (define tech-verdict (mirror-mind-state-mirror-macro-verdict mmstate))
  (define tech-det? (enemy-tech-observation-requires-detection? tech-obs))
  (define tech-aa? (enemy-tech-observation-requires-anti-air? tech-obs))
  (define tech-upg-adv (enemy-tech-observation-enemy-upgrade-advantage tech-obs))
  (define raw-bldg-types (l2-ctx-bldg-types ctx))
  (define tech-door-st (rt-door-state rt))
  (define tech-fast-v (hash-ref tech-door-st 'adaptive-tech-fast-vec #f))
  (define tech-plan
    (if (and (vector? tech-fast-v)
             (eq? race (vector-ref tech-fast-v 0))
             (eq? tech-arch (vector-ref tech-fast-v 1))
             (eq? tech-pred-u (vector-ref tech-fast-v 2))
             (eq? tech-verdict (vector-ref tech-fast-v 3))
             (eq? tech-det? (vector-ref tech-fast-v 4))
             (eq? tech-aa? (vector-ref tech-fast-v 5))
             (equal? tech-upg-adv (vector-ref tech-fast-v 6))
             (equal? raw-bldg-types (vector-ref tech-fast-v 7))
             (equal? unit-types (vector-ref tech-fast-v 8))
             (equal? res-upgs-tech (vector-ref tech-fast-v 9)))
        (vector-ref tech-fast-v 10)
        (let ()
          (define l2-sc (l2-ctx-l2-sc ctx))
          (define seen-bt (pooled-hasheq! l2-sc 'uniq-bt-seen))
          (define uniq-bldg-types
            (let loop ([xs raw-bldg-types] [acc '()])
              (if (null? xs)
                  (reverse acc)
                  (let ([s (car xs)])
                    (if (hash-has-key? seen-bt s)
                        (loop (cdr xs) acc)
                        (begin (hash-set! seen-bt s #t) (loop (cdr xs) (cons s acc))))))))
          (define seen-ut (pooled-hasheq! l2-sc 'uniq-ut-seen))
          (define uniq-unit-types
            (let loop ([xs unit-types] [acc '()])
              (if (null? xs)
                  (reverse acc)
                  (let ([s (car xs)])
                    (if (hash-has-key? seen-ut s)
                        (loop (cdr xs) acc)
                        (begin (hash-set! seen-ut s #t) (loop (cdr xs) (cons s acc))))))))
          (define tech-cache-tbl (hash-ref! tech-door-st 'adaptive-tech-plan-cache make-hash))
          (define tech-cache-key
            (list race
                  uniq-bldg-types
                  uniq-unit-types
                  res-upgs-tech
                  tech-arch
                  tech-pred-u
                  tech-verdict
                  tech-det?
                  tech-aa?
                  tech-upg-adv))
          (define plan
            (hash-ref!
             tech-cache-tbl
             tech-cache-key
             (lambda ()
               (evaluate-adaptive-build-and-tech-plan
                race
                #:ally-buildings uniq-bldg-types
                #:ally-units uniq-unit-types
                #:researched-upgrades res-upgs-tech
                #:enemy-archetype tech-arch
                #:mirror-predicted-unit tech-pred-u
                #:mirror-macro-verdict tech-verdict
                #:requires-detection? tech-det?
                #:requires-anti-air? tech-aa?
                #:enemy-upgrade-advantage tech-upg-adv
                #:minerals (l2-ctx-minerals ctx)
                #:gas (l2-ctx-gas ctx)))))
          (hash-set! tech-door-st
                     'adaptive-tech-fast-vec
                     (vector race tech-arch tech-pred-u tech-verdict tech-det? tech-aa?
                             tech-upg-adv raw-bldg-types unit-types res-upgs-tech plan))
          plan)))
  (set-l2-ctx-tech-plan! ctx tech-plan)
  (define ppf
    (evaluate-guns-vs-butter-ppf
     #:race race
     #:frame frame
     #:minerals (l2-ctx-minerals ctx)
     #:gas (l2-ctx-gas ctx)
     #:supply-left (l2-ctx-supply-left ctx)
     #:supply-cap supply-cap
     #:workers total-workers
     #:target-workers target-workers
     #:active-bases active-bases
     #:depleting-bases depleting-bases
     #:active-geysers (length gas-bldgs)
     #:current-gas-workers (hash-ref obs 'gas-workers (* SC2-IDEAL-WORKERS-PER-GEYSER (length gas-bldgs)))
     #:production-facilities (max 1 (length prod-facilities))
     #:busy-facilities (hash-ref obs 'busy-facilities 0)
     #:army-count (length ally-combat-units)
     #:missing-synergy-count (length (adaptive-tech-plan-missing-synergy-reqs tech-plan))
     #:under-crisis? (or under-early-cheese? early-survival-crisis?)
     #:mirror-macro-verdict (mirror-mind-state-mirror-macro-verdict mmstate)
     #:enemy-upgrade-advantage (enemy-tech-observation-enemy-upgrade-advantage tech-obs)
     #:enemy-active-research-count (length (enemy-tech-observation-active-research-buildings tech-obs))
     #:requires-detection? (enemy-tech-observation-requires-detection? tech-obs)
     #:requires-anti-air? (enemy-tech-observation-requires-anti-air? tech-obs)))
  (define gas-alloc (guns-vs-butter-ppf-recommended-gas-allocation ppf))
  (define worker-escape-threat-r2 (* SC2-WORKER-ESCAPE-THREAT-RADIUS SC2-WORKER-ESCAPE-THREAT-RADIUS))
  (for ([w (in-list workers)]
        #:unless worker-rush-active?)
    (define hull-v (hash-ref w 'hull-hp RUNTIME-MISSING))
    (define chp (hash-ref w 'hp SC2-DRONE-MAX-HP))
    (define cmhp (hash-ref w 'max-hp #f))
    (define wsym (unit-type-sym w))
    (define probe? (eq? wsym 'probe))
    (define sh (if (eq? hull-v RUNTIME-MISSING) (hash-ref w 'shield 0) 0))
    (define whp (if (eq? hull-v RUNTIME-MISSING) (+ chp sh) chp))
    (define fast-healthy?
      (and (real? cmhp)
           (> cmhp 0)
           (>= whp SC2-WOUNDED-WORKER-MIN-HP)
           (if probe?
               (and (>= chp cmhp)
                    (>= sh (hash-ref w 'max-shield (hash-ref w 'shield-max 20))))
               (>= whp cmhp))))
    (unless fast-healthy?
      (define wmax
        (+ (or cmhp (case wsym [(probe) 20] [(scv) 45] [else SC2-DRONE-MAX-HP]))
           (if probe? (hash-ref w 'max-shield (hash-ref w 'shield-max 20)) 0)))
      (when (or (< whp SC2-WOUNDED-WORKER-MIN-HP)
                (< (/ (exact->inexact whp) (max 1 wmax)) SC2-WOUNDED-WORKER-HP-PCT))
        (define wid (hash-ref w 'id 10))
        (when (and (not (worker-has-engine-build-order? w))
                   (not (order-ledger-unit-has-active-build? oledger-early wid w)))
          (define wx (exact->inexact (hash-ref w 'x base-x)))
          (define wy (exact->inexact (hash-ref w 'y base-y)))
          (define enemy-close?
            (for/or ([e (in-list enemy-units)])
              (define dx (- wx (exact->inexact (hash-ref e 'x 9999.0))))
              (define dy (- wy (exact->inexact (hash-ref e 'y 9999.0))))
              (<= (+ (* dx dx) (* dy dy)) worker-escape-threat-r2)))
          (when (and enemy-close?
                     (or (not live-obs-harvesters?)
                         (refractory-allow-action?! cd-tracker
                                                    (list 'wounded-mineral-walk wid)
                                                    frame
                                                    24)))
            (l2-emit! ctx (list 'mineral-walk wid base-x base-y)))))))
  (define enemy-exp-x (hash-ref obs 'enemy-expand-x (safe-coord (* 0.85 enemy-x) 148.0)))
  (set-l2-ctx-enemy-exp-x! ctx enemy-exp-x)
  (define enemy-exp-y (hash-ref obs 'enemy-expand-y (safe-coord (* 0.85 enemy-y) 148.0)))
  (set-l2-ctx-enemy-exp-y! ctx enemy-exp-y)
  (define corridor-mid-x (safe-coord (* 0.5 (+ nat-x enemy-exp-x)) 96.0))
  (set-l2-ctx-corridor-mid-x! ctx corridor-mid-x)
  (define corridor-mid-y (safe-coord (* 0.5 (+ nat-y enemy-exp-y)) 96.0))
  (set-l2-ctx-corridor-mid-y! ctx corridor-mid-y)
  (define scout-st (rt-scout-state rt))
  (set-l2-ctx-scout-st! ctx scout-st)
  (when (<= frame 4)
    (hash-clear! scout-st))
  (define non-building-workers
    (for/list ([w (in-list workers)]
               #:when (and (not (worker-has-engine-build-order? w))
                           (not (order-ledger-unit-has-active-build? oledger-early (hash-ref w 'id 0) w))))
      w))
  (set-l2-ctx-non-building-workers! ctx non-building-workers)
  (define force-synth-harass? (eq? (hash-ref obs 'enable-worker-harass #f) #t))
  (define already-dispatched-scout? (eq? (hash-ref scout-st 'dispatched? #f) #t))
  (define scout-rush-aborted-latch?
    (and (< frame 3600)
         (eq? (hash-ref scout-st 'aborted-rush? #f) #t)))
  (set-l2-ctx-scout-rush-aborted-latch?! ctx scout-rush-aborted-latch?)
  (define scout-eligible-window?
    (and (not (null? non-building-workers))
         (not worker-rush-active?)
         (not scout-rush-aborted-latch?)
         (not in-base-proxy-detected?)
         (or force-synth-harass?
             (and (>= frame 300)
                  (>= supply-used 14)
                  (< frame 3600)
                  (not under-early-cheese?)
                  (not early-survival-crisis?)
                  (>= (length workers) (if live-obs-harvesters? 13 2))))))
  (define latched-scout-id
    (or (hash-ref scout-st 'scout-id #f)
        (and (not already-dispatched-scout?)
             (hash-ref prev-tel-early 'scout-worker-id #f))))
  (define raw-scout-candidate
    (cond
      [in-base-proxy-detected? #f]
      [(and latched-scout-id
            (findf (lambda (w) (equal? (hash-ref w 'id -1) latched-scout-id))
                   non-building-workers))
       => values]
      [(and worker-rush-active? (< frame 3360))
       ;; Also catch a forward scout worker already out on the map in stateless/first-step rush encounters
       (findf (lambda (w)
                (define wx (hash-ref w 'x base-x))
                (define wy (hash-ref w 'y base-y))
                (and (> (dist2d wx wy base-x base-y) 16.0)
                     (or (< active-bases 2)
                         (> (dist2d wx wy nat-x nat-y) 14.0))))
              non-building-workers)]
      [already-dispatched-scout?
       (and force-synth-harass?
            (not worker-rush-active?)
            (not scout-rush-aborted-latch?)
            (not live-obs-harvesters?)
            (pair? non-building-workers)
            (select-far-mineral-patch-non-carrying-worker
             non-building-workers base-x base-y step-mineral-patches))]
      [scout-eligible-window?
       (select-far-mineral-patch-non-carrying-worker
        non-building-workers base-x base-y step-mineral-patches)]
      [else #f]))
  (define rush-retreating-scout
    (and (l2-scout-encounters-early-worker-rush? ctx raw-scout-candidate)
         raw-scout-candidate))
  (when rush-retreating-scout
    (hash-set! scout-st 'dispatched? #t)
    (hash-set! scout-st 'scout-id (hash-ref rush-retreating-scout 'id #f))
    (hash-set! scout-st 'aborted-rush? #t))
  (define scout-worker
    (cond
      [(or rush-retreating-scout
           worker-rush-active?
           scout-rush-aborted-latch?
           in-base-proxy-detected?)
       #f]
      [already-dispatched-scout? raw-scout-candidate]
      [(and scout-eligible-window? raw-scout-candidate)
       (hash-set! scout-st 'dispatched? #t)
       (hash-set! scout-st 'scout-id (hash-ref raw-scout-candidate 'id #f))
       (hash-set! scout-st 'orbit-idx 0)
       (hash-set! scout-st 'evading-until 0)
       raw-scout-candidate]
      [else #f]))
  (set-l2-ctx-scout-worker! ctx scout-worker)
  (define rush-retreating-scout-id
    (and rush-retreating-scout (hash-ref rush-retreating-scout 'id #f)))
  (define scout-worker-id (and scout-worker (hash-ref scout-worker 'id #f)))
  (set-l2-ctx-scout-worker-id! ctx scout-worker-id)
  (define active-leased-scout (or rush-retreating-scout scout-worker))
  (define active-leased-scout-id (and active-leased-scout (hash-ref active-leased-scout 'id #f)))
  (when active-leased-scout-id
    (acquire-unit-lease! leases active-leased-scout-id 'scout frame 32
                         #:x (hash-ref active-leased-scout 'x base-x)
                         #:y (hash-ref active-leased-scout 'y base-y)))
  (define cur-rush-fight-ids (l2-ctx-cur-rush-fighting-wids ctx))
  (define cur-rush-dis-ids (l2-ctx-cur-rush-disengaging-wids ctx))
  (define harvest-eligible-workers
    (for/list ([w (in-list non-building-workers)]
               #:when (let ([wid (hash-ref w 'id -1)])
                        (and (not (and active-leased-scout-id (equal? wid active-leased-scout-id)))
                             (not (memv wid cur-rush-fight-ids))
                             (not (memv wid cur-rush-dis-ids))
                             (not (unit-leased-above? leases wid 'harvester frame)))))
      w))
  (define harvest-workers-pool
    (if (not (null? harvest-eligible-workers)) harvest-eligible-workers non-building-workers))
  (define gas-float-starved?
    (and (>= (l2-ctx-gas ctx) SC2-GAS-FLOAT-REBALANCE-THRESH)
         (< (l2-ctx-minerals ctx) SC2-MINERAL-STARVED-REBALANCE-THRESH)))
  (define gas-bldg
    (for/first ([b (in-list ally-bldgs)]
                #:when (let ([cs (fast-canonical-structure-sym (unit-type-sym b))])
                         (or (eq? cs 'extractor) (eq? cs 'assimilator) (eq? cs 'refinery))))
      b))
  (when (and (not live-obs-harvesters?)
             gas-bldg
             (not (null? harvest-workers-pool))
             (not gas-float-starved?)
             (> (gas-worker-allocation-desired-gas-workers gas-alloc) 0))
    (l2-emit! ctx (list 'harvest-gas (hash-ref (car harvest-workers-pool) 'id 10) (hash-ref gas-bldg 'id 103))))
  (when (not (null? harvest-workers-pool))
    (define patch-id (hash-ref obs 'mineral-patch-id SC2-SYNTHETIC-MINERAL-PATCH-ID))
    (when (and (not live-obs-harvesters?) gas-float-starved?)
      (define pull-workers
        (take harvest-workers-pool
              (min (if (>= (l2-ctx-gas ctx) SC2-GAS-FLOAT-CRITICAL-THRESH) 4 2)
                   (length harvest-workers-pool))))
      (l2-emit! ctx (list 'rebalance-gas-to-minerals
                   (for/list ([w (in-list pull-workers)]) (hash-ref w 'id 10))
                   patch-id)))
    (unless live-obs-harvesters?
      (l2-emit! ctx (list 'harvest-mineral (hash-ref (car harvest-workers-pool) 'id 10) patch-id)))
    ;; Lazy per-frame coordinate extraction so idle workers don't repeat hash-ref x/y lookups.
    (define lazy-eu-flxy #f)
    (define lazy-eb-flxy #f)
    (define lazy-other-es #f)
    (define lazy-other-flxy #f)
    (define (es->flxy es)
      (cond
        [(and (eq? es enemy-units) lazy-eu-flxy) lazy-eu-flxy]
        [(and (eq? es enemy-bldgs) lazy-eb-flxy) lazy-eb-flxy]
        [(and (eq? es lazy-other-es) lazy-other-flxy) lazy-other-flxy]
        [else
         (define n (length es))
         (define xs (make-flvector n))
         (define ys (make-flvector n))
         (let loop ([lst es] [i 0])
           (when (pair? lst)
             (define e (car lst))
             (define ex0 (hash-ref e 'x 9999))
             (define ey0 (hash-ref e 'y 9999))
             (flvector-set! xs i (if (flonum? ex0) ex0 (exact->inexact ex0)))
             (flvector-set! ys i (if (flonum? ey0) ey0 (exact->inexact ey0)))
             (loop (cdr lst) (+ i 1))))
         (define pv (vector xs ys n))
         (cond
           [(eq? es enemy-units) (set! lazy-eu-flxy pv)]
           [(eq? es enemy-bldgs) (set! lazy-eb-flxy pv)]
           [else
            (set! lazy-other-es es)
            (set! lazy-other-flxy pv)])
         pv]))
    (define (fold-es-bbox es mnx0 mxx0 mny0 mxy0)
      (cond
        [(null? es) (values mnx0 mxx0 mny0 mxy0)]
        [(or (and (eq? es enemy-units) lazy-eu-flxy)
             (and (eq? es enemy-bldgs) lazy-eb-flxy)
             (and (eq? es lazy-other-es) lazy-other-flxy))
         => (lambda (pv)
              (let ([xs (vector-ref pv 0)]
                    [ys (vector-ref pv 1)]
                    [n (vector-ref pv 2)])
                (let loop ([i 0] [mnx mnx0] [mxx mxx0] [mny mny0] [mxy mxy0])
                  (if (< i n)
                      (let ([ex (flvector-ref xs i)] [ey (flvector-ref ys i)])
                        (loop (+ i 1) (flmin mnx ex) (flmax mxx ex) (flmin mny ey) (flmax mxy ey)))
                      (values mnx mxx mny mxy)))))]
        [else
         (let loop ([lst es] [mnx mnx0] [mxx mxx0] [mny mny0] [mxy mxy0])
           (if (null? lst)
               (values mnx mxx mny mxy)
               (let* ([e (car lst)]
                      [ex0 (hash-ref e 'x 9999)]
                      [ey0 (hash-ref e 'y 9999)]
                      [ex (if (flonum? ex0) ex0 (exact->inexact ex0))]
                      [ey (if (flonum? ey0) ey0 (exact->inexact ey0))])
                 (loop (cdr lst) (flmin mnx ex) (flmax mxx ex) (flmin mny ey) (flmax mxy ey)))))]))
    (define lazy-enemy-bbox #f)
    (define (get-idle-enemy-bbox)
      (or lazy-enemy-bbox
          (let-values ([(mnx1 mxx1 mny1 mxy1) (fold-es-bbox enemy-units +inf.0 -inf.0 +inf.0 -inf.0)])
            (let-values ([(mnx mxx mny mxy) (fold-es-bbox enemy-bldgs mnx1 mxx1 mny1 mxy1)])
              (define res (vector (fl- mnx 6.5) (fl+ mxx 6.5) (fl- mny 6.5) (fl+ mxy 6.5)))
              (set! lazy-enemy-bbox res)
              res))))
    (define (worker-near-enemy-list? wx wy es)
      (if (null? es)
          #f
          (let* ([pv (es->flxy es)]
                 [xs (vector-ref pv 0)]
                 [ys (vector-ref pv 1)]
                 [n (vector-ref pv 2)])
            (let loop ([i 0])
              (and (< i n)
                   (let ([dx (fl- wx (flvector-ref xs i))])
                     (or (and (fl<= (flabs dx) 6.5)
                              (let ([dy (fl- wy (flvector-ref ys i))])
                                (and (fl<= (flabs dy) 6.5)
                                     (fl<= (fl+ (fl* dx dx) (fl* dy dy)) 42.25))))
                         (loop (+ i 1)))))))))
    (define idle-rush-fight-ids (l2-ctx-cur-rush-fighting-wids ctx))
    (define idle-rush-dis-ids (l2-ctx-cur-rush-disengaging-wids ctx))
    (define idle-rush-fight-empty? (null? idle-rush-fight-ids))
    (define idle-rush-dis-empty? (null? idle-rush-dis-ids))
    (define idle-return-workers
      (for/list ([w (in-list harvest-workers-pool)]
                 #:when (let ([ords (hash-ref w 'orders SANITIZE-MISSING)])
                          (and (not (eq? ords SANITIZE-MISSING))
                               (or (null? ords) (equal? ords '(idle)))
                               (let ([wid (hash-ref w 'id 10)])
                                 (and (or idle-rush-fight-empty? (not (memv wid idle-rush-fight-ids)))
                                      (or idle-rush-dis-empty? (not (memv wid idle-rush-dis-ids)))))
                               (let* ([wx (exact->inexact (hash-ref w 'x base-x))]
                                      [wy (exact->inexact (hash-ref w 'y base-y))]
                                      [ep (get-idle-enemy-bbox)])
                                 (or (fl< wx (vector-ref ep 0))
                                     (fl> wx (vector-ref ep 1))
                                     (fl< wy (vector-ref ep 2))
                                     (fl> wy (vector-ref ep 3))
                                     (not (or (worker-near-enemy-list? wx wy enemy-units)
                                              (worker-near-enemy-list? wx wy enemy-bldgs))))))))
        w))
    (when (not (null? idle-return-workers))
      (define idle-ids (map (lambda (w) (hash-ref w 'id 10)) idle-return-workers))
      (l2-emit! ctx (list 'return-workers-to-gather idle-ids))
      (define safe-idle-patch-id
        (let ([live-mps (if (pair? step-mineral-patches)
                            (filter (lambda (mp)
                                      (and (hash? mp)
                                           (> (hash-ref mp 'id 0) 0)
                                           (> (hash-ref mp 'mineral-contents 1000) 0)
                                           (not (worker-near-enemy-list?
                                                 (exact->inexact (hash-ref mp 'x base-x))
                                                 (exact->inexact (hash-ref mp 'y base-y))
                                                 enemy-units))))
                                    step-mineral-patches)
                            '())])
          (if (null? live-mps)
              patch-id
              (let* ([ally-ths
                      (filter (lambda (b)
                                (and (hash? b)
                                     (not (eq? (hash-ref b 'flying #f) #t))
                                     (not (eq? (hash-ref b 'is-flying #f) #t))
                                     (memq (fast-canonical-structure-sym (unit-type-sym b))
                                           '(hatchery lair hive nexus command-center orbital-command planetary-fortress))))
                              (l2-get-ready-bldgs ctx))]
                     [unsat-mp
                      (for/first ([th (in-list (sort ally-ths >
                                                     #:key (lambda (b)
                                                             (- (hash-ref b 'ideal-harvesters 16)
                                                                (hash-ref b 'assigned-harvesters 0)))))]
                                  #:when (> (hash-ref th 'ideal-harvesters 16)
                                            (hash-ref th 'assigned-harvesters 0))
                                  #:do [(define tx (exact->inexact (hash-ref th 'x base-x)))
                                        (define ty (exact->inexact (hash-ref th 'y base-y)))
                                        (define near-th-mps
                                          (filter (lambda (mp)
                                                    (<= (fast-dist2d tx ty (hash-ref mp 'x 9999.0) (hash-ref mp 'y 9999.0)) 12.0))
                                                  live-mps))]
                                  #:when (pair? near-th-mps))
                        (argmax (lambda (mp) (hash-ref mp 'mineral-contents 1000)) near-th-mps))])
                (hash-ref (or unsat-mp (argmax (lambda (mp) (hash-ref mp 'mineral-contents 1000)) live-mps))
                          'id patch-id)))))
      (for ([wid (in-list idle-ids)]
            #:unless (and (not live-obs-harvesters?)
                          (equal? wid (hash-ref (car harvest-workers-pool) 'id 10))))
        (l2-emit! ctx (list 'harvest-mineral wid safe-idle-patch-id)))))
  (when rush-retreating-scout-id
    (l2-emit! ctx (list 'mineral-walk rush-retreating-scout-id base-x base-y)))
  (when (and force-synth-harass?
             (not rush-retreating-scout)
             (not worker-rush-active?)
             (not scout-rush-aborted-latch?)
             (not in-base-proxy-detected?)
             (not (null? workers)))
    (l2-emit! ctx (list 'worker-harass
                 (or scout-worker-id
                     (let ([pick (select-far-mineral-patch-non-carrying-worker
                                  (if (pair? non-building-workers) non-building-workers workers)
                                  base-x base-y step-mineral-patches)])
                       (hash-ref (or pick (last workers)) 'id 10)))
                 enemy-x enemy-y)))
  (l2-rebalance-offline-mined-out-workers! ctx))

(define (l2-phase5-threat-proxy! ctx)
  (define active-bases (l2-ctx-active-bases ctx))
  (define ally-bldgs (l2-ctx-ally-bldgs ctx))
  (define ally-combat-supply-early (l2-ctx-ally-combat-supply-early ctx))
  (define ally-units (l2-ctx-ally-units ctx))
  (define base-x (l2-ctx-base-x ctx))
  (define base-y (l2-ctx-base-y ctx))
  (define blocked-nat-expanded-early? (l2-ctx-blocked-nat-expanded-early? ctx))
  (define cd-tracker (l2-ctx-cd-tracker ctx))
  (define depleting-bases (l2-ctx-depleting-bases ctx))
  (define desired-bases (l2-ctx-desired-bases ctx))
  (define early-race-th-sym (l2-ctx-early-race-th-sym ctx))
  (define early-survival-crisis? (l2-ctx-early-survival-crisis? ctx))
  (define enemy-bldgs (l2-ctx-enemy-bldgs ctx))
  (define enemy-exp-x (l2-ctx-enemy-exp-x ctx))
  (define enemy-exp-y (l2-ctx-enemy-exp-y ctx))
  (define enemy-rush-workers (l2-ctx-enemy-rush-workers ctx))
  (define enemy-units (l2-ctx-enemy-units ctx))
  (define enemy-x (l2-ctx-enemy-x ctx))
  (define enemy-y (l2-ctx-enemy-y ctx))
  (define forward-proxy-detected? (l2-ctx-forward-proxy-detected? ctx))
  (define forward-proxy-structures (l2-ctx-forward-proxy-structures ctx))
  (define frame (l2-ctx-frame ctx))
  (define in-base-proxy-structures (l2-ctx-in-base-proxy-structures ctx))
  (define leases (l2-ctx-leases ctx))
  (define live-obs-harvesters? (l2-ctx-live-obs-harvesters? ctx))
  (define nat-x (l2-ctx-nat-x ctx))
  (define nat-y (l2-ctx-nat-y ctx))
  (define obs (l2-ctx-obs ctx))
  (define oledger-early (l2-ctx-oledger-early ctx))
  (define race (l2-ctx-race ctx))
  (define rt (l2-ctx-rt ctx))
  (define scout-st (l2-ctx-scout-st ctx))
  (define scout-worker (l2-ctx-scout-worker ctx))
  (define tech-obs (l2-ctx-tech-obs ctx))
  (define under-early-cheese? (l2-ctx-under-early-cheese? ctx))
  (define unit-types (l2-ctx-unit-types ctx))
  (when scout-worker
    (define sw-id (hash-ref scout-worker 'id 10))
    (define sw-x (hash-ref scout-worker 'x base-x))
    (define sw-y (hash-ref scout-worker 'y base-y))
    (define dist-to-enemy (dist2d sw-x sw-y enemy-x enemy-y))
    (cond
      [(not live-obs-harvesters?)
       (define wp-x (if (and (> (dist2d sw-x sw-y enemy-exp-x enemy-exp-y) 9.0)
                             (> dist-to-enemy 20.0)
                             (< (modulo frame 672) 336))
                        enemy-exp-x
                        enemy-x))
       (define wp-y (if (and (> (dist2d sw-x sw-y enemy-exp-x enemy-exp-y) 9.0)
                             (> dist-to-enemy 20.0)
                             (< (modulo frame 672) 336))
                        enemy-exp-y
                        enemy-y))
       (l2-emit! ctx (list 'worker-scout sw-id wp-x wp-y))
       (l2-emit! ctx (list 'mineral-harass sw-id enemy-x enemy-y enemy-exp-x enemy-exp-y))]
      [else
       (define ex (exact->inexact enemy-x))
       (define ey (exact->inexact enemy-y))
       (define vdx (- ex (exact->inexact base-x)))
       (define vdy (- ey (exact->inexact base-y)))
       (define vlen (max 1.0 (sqrt (+ (* vdx vdx) (* vdy vdy)))))
       (define ux (/ vdx vlen))
       (define uy (/ vdy vlen))
       (define px (- uy))
       (define py ux)
       (define orbit-waypoints
         (list (cons (safe-coord (+ ex (* 6.0 ux) (* 5.5 px)) enemy-x)
                     (safe-coord (+ ey (* 6.0 uy) (* 5.5 py)) enemy-y))
               (cons (safe-coord (+ ex (* 7.5 ux) (* 2.5 px)) enemy-x)
                     (safe-coord (+ ey (* 7.5 uy) (* 2.5 py)) enemy-y))
               (cons (safe-coord (+ ex (* 7.5 ux) (* -2.5 px)) enemy-x)
                     (safe-coord (+ ey (* 7.5 uy) (* -2.5 py)) enemy-y))
               (cons (safe-coord (+ ex (* 6.0 ux) (* -5.5 px)) enemy-x)
                     (safe-coord (+ ey (* 6.0 uy) (* -5.5 py)) enemy-y))
               (cons (safe-coord (+ ex (* 3.5 ux) (* -7.0 px)) enemy-x)
                     (safe-coord (+ ey (* 3.5 uy) (* -7.0 py)) enemy-y))))
       (when (<= (dist2d sw-x sw-y enemy-exp-x enemy-exp-y) 10.5)
         (hash-set! scout-st 'visited-nat? #t))
       (define ranged-enemies-near
         (count (lambda (e)
                  (define et (fast-canonical-unit-sym (unit-type-sym e)))
                  (and (<= (dist2d sw-x sw-y (hash-ref e 'x 9999.0) (hash-ref e 'y 9999.0)) 7.5)
                       (or (>= (safe-finite-real (hash-ref e 'range 0.0) 0.0) 2.0)
                           (memq et '(marine marauder reaper stalker adept sentry queen
                                      hydralisk roach cyclone hellion photon-cannon bunker
                                      planetary-fortress spine-crawler)))))
                (append enemy-units enemy-bldgs)))
       (define pulled-workers-chasing
         (count (lambda (e)
                  (and (memq (unit-type-sym e) '(probe scv drone))
                       (<= (dist2d sw-x sw-y (hash-ref e 'x 9999.0) (hash-ref e 'y 9999.0)) 4.5)))
                enemy-units))
       (define sw-total-hp (unit-total-hp-and-shield scout-worker 40))
       (define sw-low-hp? (< sw-total-hp 22))
       (when (or (> ranged-enemies-near 0)
                 (>= pulled-workers-chasing 2)
                 sw-low-hp?)
         (hash-set! scout-st 'evading-until (+ frame 40)))
       (define evading? (< frame (hash-ref scout-st 'evading-until 0)))
       (cond
         [evading?
          (when (refractory-allow-action?! cd-tracker (list 'scout-evade sw-id) frame 12)
            (if (or sw-low-hp? (> ranged-enemies-near 0) (>= pulled-workers-chasing 2))
