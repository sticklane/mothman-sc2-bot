                             8]
                            [(or (>= total-workers 38)
                                 (>= eff-phase-supply 60)
                                 (>= gw-ref-minerals 350)
                                 brain-sched-gate-aligned?)
                             6]
                            [(or (>= total-workers 30)
                                 (>= eff-phase-supply 46)) 5]
                            [(>= eff-phase-supply 32) 4]
                            [else 3])]
                         [(and brain-sched-gate-aligned?
                               (>= gw-ref-minerals 300))
                          (if (>= gw-ref-minerals 550) 4 3)]
                         [(or (and (memq 'cybernetics-core (l2-ctx-bldg-types ctx))
