            SC2-RESUME-BLDG-RUSH-COOLDOWN-FRAMES
            SC2-RESUME-BLDG-COOLDOWN-FRAMES))
      (define bx (exact->inexact (hash-ref b 'x base-x)))
      (define by (exact->inexact (hash-ref b 'y base-y)))
      (define raw-scvs
        (filter (lambda (w)
                  (define wid (hash-ref w 'id 10))
                  (and (not (set-member? assigned-resume-scvs wid))
                       (not (worker-has-engine-build-order? w))
                       (not (order-ledger-unit-has-active-build? oledger-early wid w))))
                workers))
      (define cand-scvs
        (if (pair? raw-scvs)
            raw-scvs
            (filter (lambda (w) (not (set-member? assigned-resume-scvs (hash-ref w 'id 10))))
                    workers)))
      (define healthy-cands
        (let ([hc (filter (lambda (w) (>= (unit-total-hp-and-shield w) 16.0)) cand-scvs)])
          (if (pair? hc) hc cand-scvs)))
      (define avail-scv
        (and (pair? healthy-cands)
             (argmin (lambda (w)
                       (define wx (exact->inexact (hash-ref w 'x base-x)))
                       (define wy (exact->inexact (hash-ref w 'y base-y)))
                       (- (dist2d wx wy bx by) (* 0.15 (unit-total-hp-and-shield w))))
                     healthy-cands)))
      (when (and avail-scv
                 (refractory-allow-action?! cd-tracker
                                            (list 'resume-halted-building bid)
                                            frame
                                            resume-cd))
        (define scv-id (hash-ref avail-scv 'id 10))
        (set-add! assigned-resume-scvs scv-id)
        (when resume-rush-mode?
          (hash-set! resume-scv-until-ht scv-id (+ frame 16)))
        (l2-emit! ctx (list 'resume-halted-building scv-id bid)))))
  (define non-builder-defense-workers
    (filter (lambda (w)
              (define wid (hash-ref w 'id 0))
              (and (not (set-member? assigned-resume-scvs wid))
                   (not (and (pair? halted-terran-bldgs)
                             (< frame (hash-ref resume-scv-until-ht wid -1))))
                   (not (worker-has-engine-build-order? w))
                   (not (order-ledger-unit-has-active-build? oledger-early wid w))))
            workers))
  (set-l2-ctx-non-builder-defense-workers! ctx non-builder-defense-workers))

(define (l2-phase2-worker-rush! ctx)
  (define ally-bldgs (l2-ctx-ally-bldgs ctx))
  (define ally-combat-units (l2-ctx-ally-combat-units ctx))
  (define base-x (l2-ctx-base-x ctx))
  (define base-y (l2-ctx-base-y ctx))
  (define enemy-rush-workers (l2-ctx-enemy-rush-workers ctx))
  (define enemy-x (l2-ctx-enemy-x ctx))
  (define enemy-y (l2-ctx-enemy-y ctx))
  (define frame (l2-ctx-frame ctx))
  (define ground-enemy-units-for-cheese (l2-ctx-ground-enemy-units-for-cheese ctx))
  (define live-obs-harvesters? (l2-ctx-live-obs-harvesters? ctx))
  (define minerals (l2-ctx-minerals ctx))
  (define non-builder-defense-workers (l2-ctx-non-builder-defense-workers ctx))
  (define obs (l2-ctx-obs ctx))
  (define prev-rush-fighting-wids (l2-ctx-prev-rush-fighting-wids ctx))
  (define race (l2-ctx-race ctx))
  (define rush-def-st (l2-ctx-rush-def-st ctx))
  (define worker-rush-active? (l2-ctx-worker-rush-active? ctx))
  (define workers (l2-ctx-workers ctx))
  ;; L48-W2 (Post-Fight Counter-Attack Latch): Track whether a heavy worker rush (`>= 8` pure enemy
  ;; workers) hit our base early (`< 4500f`) and has now been repelled (`< 4` enemy rush workers left),
  ;; so L3/L4 immediately dispatches our breakout Zealots/Zerglings/Marines to `(enemy-x, enemy-y)`!
  (let* ([non-w-near-main?
          (ormap (lambda (e)
                   (and (hash? e)
                        (not (memq (unit-type-sym e) '(probe scv drone)))
                        (combat-unit-record? e)
                        (<= (dist2d base-x base-y
                                    (exact->inexact (hash-ref e 'x 9999.0))
                                    (exact->inexact (hash-ref e 'y 9999.0)))
                            14.0)))
                 ground-enemy-units-for-cheese)])
    (when (and (< frame 4500)
               (not non-w-near-main?)
               (>= (length enemy-rush-workers) 8))
      (hash-set! rush-def-st 'saw-heavy-worker-rush? #t))
    (when (and (eq? (hash-ref rush-def-st 'saw-heavy-worker-rush? #f) #t)
               (< (length enemy-rush-workers) 4)
               (not non-w-near-main?))
      (hash-set! rush-def-st 'survived-heavy-worker-rush? #t))
    (when (or (>= frame 6720) non-w-near-main?)
      (hash-set! rush-def-st 'survived-heavy-worker-rush? #f)))
  (when (and (or worker-rush-active? (not (null? prev-rush-fighting-wids)))
             (not (null? non-builder-defense-workers)))
    (define has-owned-townhall?
      (ormap (lambda (b)
               (and (hash? b)
                    (memq (fast-canonical-structure-sym (unit-type-sym b))
                          '(hatchery lair hive nexus
                            command-center orbital-command planetary-fortress))))
             ally-bldgs))
    (define has-breakout-prod-bldg?
      (ormap (lambda (b)
               (and (hash? b)
                    (memq (fast-canonical-structure-sym (unit-type-sym b))
                          '(spawning-pool barracks gateway warp-gate
                            spine-crawler bunker photon-cannon))))
             ally-bldgs))
    (hash-set! rush-def-st 'has-breakout-prod-bldg? has-breakout-prod-bldg?)
    (when worker-rush-active?
      (hash-set! rush-def-st 'worker-rush-active-until
                 (max (hash-ref rush-def-st 'worker-rush-active-until -1) (+ frame 24))))
    (define ready-townhall-coords
      (let ([pts (for/list ([b (in-list ally-bldgs)]
                            #:when (and (hash? b)
                                        (>= (hash-ref b 'build-progress 1.0) SC2-BUILD-COMPLETE-PROGRESS)
                                        (memq (fast-canonical-structure-sym (unit-type-sym b))
                                              '(hatchery lair hive nexus
                                                command-center orbital-command planetary-fortress))))
                   (cons (exact->inexact (hash-ref b 'x base-x))
                         (exact->inexact (hash-ref b 'y base-y))))])
        (if (null? pts)
            (list (cons (exact->inexact base-x) (exact->inexact base-y)))
            pts)))
    (define (dist-to-owned-townhall x y)
      (for/fold ([best +inf.0]) ([bc (in-list ready-townhall-coords)])
        (min best (dist2d x y (car bc) (cdr bc)))))
    ;; L48-W2 (Kinematic Kiting Detector — 100% Generalizable SC2 Physics):
    ;; Track per-enemy worker `(x, y)` displacement across `>= 4f` ticks. Flag `fleeing-away?` ONLY on
    ;; genuine kiting pull-backs — BOTH moving away from our TownHall (`Δd_th > +0.55t`) AND toward
    ;; `(enemy-x, enemy-y)` (`Δd_eb < -0.55t`) outside the melee-collision ring (`cur-th-d >= 4.2t` or
    ;; combined displacement `Δd_th - Δd_eb >= 1.60t`), OR unmistakable radial retreat (`cur-th-d >= 5.5t`
    ;; & `Δd_th > +1.15t`) — so static 16v15 melee-ball jostling (`r02`/`r05`/`r06`) NEVER false-latches!
    (define ew-prev-pos-ht
      (let ([h (hash-ref rush-def-st 'ew-prev-pos-ht #f)])
        (if (hash? h)
            h
            (let ([nh (make-hasheqv)])
              (hash-set! rush-def-st 'ew-prev-pos-ht nh)
              nh))))
    (define fleeing-ew-ids (make-hasheqv))
    (define max-flee-d-th 0.0)
    (define th-close-ew-cnt 0)
    (for ([ew (in-list enemy-rush-workers)])
      (define eid (hash-ref ew 'id 0))
      (when (and (exact-integer? eid) (> eid 0))
        (define ex (exact->inexact (hash-ref ew 'x base-x)))
        (define ey (exact->inexact (hash-ref ew 'y base-y)))
        (define cur-th-d (dist-to-owned-townhall ex ey))
        (when (<= cur-th-d 8.5)
          (set! th-close-ew-cnt (add1 th-close-ew-cnt)))
        (define cur-eb-d (dist2d ex ey (exact->inexact enemy-x) (exact->inexact enemy-y)))
        (define prev (hash-ref ew-prev-pos-ht eid #f))
        (when (and (vector? prev) (= (vector-length prev) 5))
          (define pf (vector-ref prev 0))
          (define dt (- frame pf))
          (when (and (>= dt 1) (<= dt 32))
            (define d-th (- cur-th-d (vector-ref prev 3)))
            (define d-eb (- cur-eb-d (vector-ref prev 4)))
            (when (or (and (> d-th 0.55)
                           (< d-eb -0.55)
                           (or (>= cur-th-d 4.2)
                               (>= (- d-th d-eb) 1.60)))
                      (and (>= cur-th-d 5.5)
                           (> d-th 1.15)))
              (hash-set! fleeing-ew-ids eid #t)
              (when (> d-th max-flee-d-th)
                (set! max-flee-d-th d-th)))))
        (when (or (not (vector? prev))
                  (< frame (vector-ref prev 0))
                  (>= (- frame (vector-ref prev 0)) 4))
          (hash-set! ew-prev-pos-ht eid (vector frame ex ey cur-th-d cur-eb-d)))))
    (when (and worker-rush-active? (>= (length enemy-rush-workers) 6))
      (define prev-seen (hash-ref rush-def-st 'ew-rush-last-seen -9999))
      (cond
        [(or (< frame prev-seen) (> (- frame prev-seen) 112))
         (hash-set! rush-def-st 'ew-rush-start-frame frame)
         (hash-set! rush-def-st 'ew-peak-cnt (length enemy-rush-workers))]
        [else
         (hash-set! rush-def-st 'ew-peak-cnt
                    (max (hash-ref rush-def-st 'ew-peak-cnt 0) (length enemy-rush-workers)))])
      (hash-set! rush-def-st 'ew-rush-last-seen frame))
    (define ew-rush-elapsed
      (- frame (hash-ref rush-def-st 'ew-rush-start-frame frame)))
    (define ew-est-kills
      (max 0 (- (hash-ref rush-def-st 'ew-peak-cnt 0) (length enemy-rush-workers))))
    (when (or (>= (hash-count fleeing-ew-ids) 3)
              (and (>= (hash-count fleeing-ew-ids) 2)
                   (>= max-flee-d-th 1.25))
              (and worker-rush-active?
                   (>= (length enemy-rush-workers) 6)
                   (>= ew-rush-elapsed 268)
                   (< ew-est-kills 2)
                   (not (and (not has-breakout-prod-bldg?)
                             (or (= (hash-count fleeing-ew-ids) 0)
                                 (>= th-close-ew-cnt 4))))))
      (hash-set! rush-def-st 'kiting-rush-until
                 (max (hash-ref rush-def-st 'kiting-rush-until -1) (+ frame 224))))
    (define enemy-kiting-rush-detected?
      (and worker-rush-active?
           (< frame (hash-ref rush-def-st 'kiting-rush-until -1))))
    (define kiting-or-breakout-rush?
      (or enemy-kiting-rush-detected?
          has-breakout-prod-bldg?))
    (define (ew-fleeing-away? ew)
      (hash-has-key? fleeing-ew-ids (hash-ref ew 'id 0)))
    (define base-mineral-patches
      (filter (lambda (mp)
                (and (hash? mp)
                     (<= (dist-to-owned-townhall
                          (hash-ref mp 'x base-x)
                          (hash-ref mp 'y base-y))
                         14.0)))
              (let ([mps (hash-ref obs 'mineral-patches '())])
                (if (list? mps) mps '()))))
    (define (dist-to-mineral-line x y)
      (if (null? base-mineral-patches)
          +inf.0
          (for/fold ([best +inf.0]) ([mp (in-list base-mineral-patches)])
            (min best (dist2d x y (hash-ref mp 'x base-x) (hash-ref mp 'y base-y))))))

    (define ew-cnt (max 1 (length enemy-rush-workers)))
    (define ew-cx
      (if (null? enemy-rush-workers)
          (exact->inexact enemy-x)
          (/ (for/sum ([ew (in-list enemy-rush-workers)]) (exact->inexact (hash-ref ew 'x base-x)))
             ew-cnt)))
    (define ew-cy
      (if (null? enemy-rush-workers)
          (exact->inexact enemy-y)
          (/ (for/sum ([ew (in-list enemy-rush-workers)]) (exact->inexact (hash-ref ew 'y base-y)))
             ew-cnt)))
    (define far-mp
      (and (not (null? base-mineral-patches))
           (argmax (lambda (mp)
                     (dist2d ew-cx ew-cy
                             (hash-ref mp 'x base-x)
                             (hash-ref mp 'y base-y)))
                   base-mineral-patches)))
    (define fallback-dx (- base-x ew-cx))
    (define fallback-dy (- base-y ew-cy))
    (define fallback-d (max 1.0 (sqrt (+ (* fallback-dx fallback-dx) (* fallback-dy fallback-dy)))))
    (define far-px
      (if far-mp
          (safe-coord (hash-ref far-mp 'x base-x) base-x)
          (safe-coord (+ base-x (* 4.0 (/ fallback-dx fallback-d))) base-x)))
    (define far-py
      (if far-mp
          (safe-coord (hash-ref far-mp 'y base-y) base-y)
          (safe-coord (+ base-y (* 4.0 (/ fallback-dy fallback-d))) base-y)))
    (define far-patch-id
      (if far-mp
          (safe-nonneg-int (hash-ref far-mp 'id 0) 0)
          (safe-nonneg-int (hash-ref obs 'mineral-patch-id 0) 0)))

    ;; Physical pull trigger: ONLY once rush workers enter <= 9.0 tiles of TownHall (<= 7.0 vs >= 8-worker all-ins
    ;; with 0 combat units so workers NEVER conga-line single-file out to an 8.8-tile ramp Pylon!),
    ;; <= 6.5 tiles of mineral line, or <= 4.5 tiles of an in-main friendly structure.
    (define heavy-worker-allin-no-army?
      (and (>= (length enemy-rush-workers) 8)
           (null? ally-combat-units)))
    ;; L50-W1 (`#08 TvP vs Chance` / `r15` Owned-Structure Defense): Never filter out or leash
    ;; workers away from enemy rushers within `<= 5.5t` of ANY owned early structure in main!
    (define protected-rush-bldgs
      (filter (lambda (b)
                (and (hash? b)
                     (memq (fast-canonical-structure-sym (unit-type-sym b))
                           '(barracks gateway supply-depot pylon spawning-pool))
                     (real? (hash-ref b 'x #f))
                     (real? (hash-ref b 'y #f))
                     (<= (dist-to-owned-townhall (hash-ref b 'x base-x)
                                                 (hash-ref b 'y base-y))
                         22.0)))
              ally-bldgs))
    (define (near-protected-rush-bldg? px py [rad 5.5])
      (ormap (lambda (b)
               (<= (dist2d px py
                           (exact->inexact (hash-ref b 'x base-x))
                           (exact->inexact (hash-ref b 'y base-y)))
                   rad))
             protected-rush-bldgs))
    (define protected-bldg-under-attack?
      (ormap (lambda (b)
               (define bx (exact->inexact (hash-ref b 'x base-x)))
               (define by (exact->inexact (hash-ref b 'y base-y)))
               (define outer-or-damaged?
                 (or (> (dist-to-owned-townhall bx by) 6.5)
                     (let ([mhp (hash-ref b 'max-hp #f)])
                       (and (real? mhp) (> mhp 0)
                            (< (+ (exact->inexact (hash-ref b 'hp mhp))
                                  (exact->inexact (hash-ref b 'shield (hash-ref b 'shields 0.0))))
                               (* 0.99 (+ (exact->inexact mhp)
                                          (exact->inexact (hash-ref b 'max-shield 0.0)))))))))
               (and outer-or-damaged?
                    (or (ormap (lambda (ew)
                                 (<= (dist2d (exact->inexact (hash-ref ew 'x 9999.0))
                                             (exact->inexact (hash-ref ew 'y 9999.0))
                                             bx by)
                                     5.5))
                               enemy-rush-workers)
                        (ormap (lambda (eb)
                                 (<= (dist2d (exact->inexact (hash-ref eb 'x 9999.0))
                                             (exact->inexact (hash-ref eb 'y 9999.0))
                                             bx by)
                                     5.5))
                               (or (l2-ctx-in-base-proxy-structures ctx) '())))))
             protected-rush-bldgs))
    ;; L49-W2 + L50-W1 (`r16` Protoss Anti-Kiting Leash; `#08 Chance` / `r15` Structure Guard):
    ;; Restrict the tight `8.5t` mineral-walk pullback strictly to Protoss while Gateway trains
    ;; Zealot #1 AND no outer/damaged owned structure is under attack!
    (define prod-training-first-defender?
      (and worker-rush-active?
           has-owned-townhall?
           has-breakout-prod-bldg?
           (< (l2-ctx-ally-combat-supply-early ctx) 4.0)
           (ormap (lambda (b)
                    (and (hash? b)
                         (let ([bs (fast-canonical-structure-sym (unit-type-sym b))])
                           (or (and (memq bs '(gateway barracks))
                                    (<= (dist-to-owned-townhall (hash-ref b 'x base-x)
                                                                (hash-ref b 'y base-y))
                                        16.0)
                                    (or (< (hash-ref b 'build-progress 1.0) SC2-BUILD-COMPLETE-PROGRESS)
                                        (> (hash-ref b 'order-ability-id 0) 0)
                                        (and (eq? race 'Protoss) (null? ally-combat-units))
                                        (and (eq? race 'Terran) (null? ally-combat-units))))
                               (and (eq? bs 'spawning-pool)
                                    (<= (dist-to-owned-townhall (hash-ref b 'x base-x)
                                                                (hash-ref b 'y base-y))
                                        16.0)
                                    (null? ally-combat-units))))))
                  ally-bldgs)))
    (define tight-protoss-first-def-leash?
      (and (or (eq? race 'Protoss)
               ;; L58-P3 (`sc2-reg-r15`): Apply the same `8.5t` anti-kiting chase leash for Terran
               ;; while Barracks trains Marine #1 under detected Probe kiting (0 Marines out yet,
               ;; no owned structure under attack) so SCVs don't trickle out `12t` to the ramp!
               (and (eq? race 'Terran)
                    enemy-kiting-rush-detected?
                    (null? ally-combat-units)))
           prod-training-first-defender?
           (not protected-bldg-under-attack?)))
    (define rush-th-pull-rad (if (or heavy-worker-allin-no-army? tight-protoss-first-def-leash?) 7.0 9.0))
    (define rush-bldg-th-rad (if (or heavy-worker-allin-no-army? tight-protoss-first-def-leash?) 6.8 9.5))
    (define rush-chase-leash-rad (if (or heavy-worker-allin-no-army? tight-protoss-first-def-leash?) 8.5 10.5))
    (define primary-engage-enemies
      (if worker-rush-active?
          (filter (lambda (ew)
                    (define ex (hash-ref ew 'x 9999.0))
                    (define ey (hash-ref ew 'y 9999.0))
                    (or (near-protected-rush-bldg? ex ey 5.5)
                        (and (<= (dist-to-owned-townhall ex ey) rush-chase-leash-rad)
                             (or (<= (dist-to-owned-townhall ex ey) rush-th-pull-rad)
                                 (<= (dist-to-mineral-line ex ey) 6.5)
                                 (ormap (lambda (b)
                                          (and (hash? b)
                                               (<= (dist-to-owned-townhall
                                                    (hash-ref b 'x base-x)
                                                    (hash-ref b 'y base-y))
                                                   rush-bldg-th-rad)
                                               (<= (dist2d ex ey
                                                           (hash-ref b 'x base-x)
                                                           (hash-ref b 'y base-y))
                                                   4.5)))
                                        ally-bldgs)))))
                  enemy-rush-workers)
          '()))
    (unless (null? primary-engage-enemies)
      (hash-set! rush-def-st 'last-rush-engage-frame frame))
    (define last-engage-frame (hash-ref rush-def-st 'last-rush-engage-frame -9999))
    ;; L48-W2: Raise hysteresis `14f -> 48f` (`2.1s`) whenever enemy rush workers hover in the
    ;; `7.1..8.8t` skirmish band (or `<= 11.0t` during a breakout defense), eliminating `7.1t`
    ;; ping-pong snap-backs while still letting defenders snap back to mining after `14f` if all
    ;; enemy workers cleanly retreat past `8.8t` (Suite 36.3)!
    (define ew-hover-hyst-rad (if has-breakout-prod-bldg? 11.0 8.8))
    (define any-ew-hovering?
      (ormap (lambda (ew)
               (<= (dist-to-owned-townhall
                    (hash-ref ew 'x 9999.0)
                    (hash-ref ew 'y 9999.0))
                   ew-hover-hyst-rad))
             enemy-rush-workers))
    (define engage-hysteresis-frames
      (if (and any-ew-hovering?
               (or enemy-kiting-rush-detected? (>= (length enemy-rush-workers) 6)))
          48
          14))
    (define in-engage-hysteresis?
      (and worker-rush-active?
           (not (null? prev-rush-fighting-wids))
           (<= (- frame last-engage-frame) engage-hysteresis-frames)))
    (define worker-rush-engage-enemies
      (cond
        [(not (null? primary-engage-enemies)) primary-engage-enemies]
        [in-engage-hysteresis?
         (filter (lambda (ew)
                   (define ex (hash-ref ew 'x 9999.0))
                   (define ey (hash-ref ew 'y 9999.0))
                   (or (near-protected-rush-bldg? ex ey 5.5)
                       (<= (dist-to-owned-townhall ex ey) rush-chase-leash-rad)))
                 enemy-rush-workers)]
        [else '()]))

    ;; Mixed Probe+Zealot / worker+combat rush detection near main mineral line
    (define enemy-combat-near-main
      (filter (lambda (e)
                (and (not (memq (unit-type-sym e) '(probe scv drone)))
                     (or (combat-unit-record? e)
                         (memq (fast-canonical-unit-sym (unit-type-sym e))
                               '(zealot zergling adept stalker marine reaper hellion hellbat roach marauder)))
                     (let ([ex (hash-ref e 'x 9999.0)]
                           [ey (hash-ref e 'y 9999.0)])
                       (or (<= (dist-to-owned-townhall ex ey) 11.0)
                           (<= (dist-to-mineral-line ex ey) 8.5)))))
              ground-enemy-units-for-cheese))
    (define mixed-worker-combat-rush?
      (and (not (null? enemy-combat-near-main))
           (not (null? enemy-rush-workers))))
    ;; L39-P0-1a + L40-P0-1b + L41-P0-1b + L42-P0-1a (`r02`/`r05`/`r06` 3-Race Pure Worker All-In):
    ;; Latch `heavy-pure-worker-allin?` once triggered (`>= 10` pure enemy workers) until `< 3`
    ;; remain (or non-worker enemy combat enters), AND track `heavy-pure-worker-allin-12plus?`
    ;; (`>= 11` pure enemy workers latched down to `>= 3`) so full `15`-Probe all-ins commit with
    ;; ZERO mid-fight `3666` disengage pulls (`max-total-dis-heavy-rush = 0` when `hw <= ew + 2`)
    ;; while preserving 10-Probe early-warning `10 HP` disengage!
    (define prev-heavy-allin?
      (eq? (hash-ref rush-def-st 'heavy-pure-worker-allin-latched? #f) #t))
    (define prev-heavy-allin-12plus?
      (eq? (hash-ref rush-def-st 'heavy-pure-worker-allin-12plus? #f) #t))
    (define pure-worker-rush-now?
      (and (not mixed-worker-combat-rush?)
           (null? enemy-combat-near-main)))
    (define heavy-pure-worker-allin?
      (and pure-worker-rush-now?
           (or (>= (length enemy-rush-workers) 10)
               (and prev-heavy-allin?
                    (>= (length enemy-rush-workers) 3)))))
    (define heavy-pure-worker-allin-12plus?
      (and pure-worker-rush-now?
           (or (>= (length enemy-rush-workers) 11)
               (and prev-heavy-allin-12plus?
                    (>= (length enemy-rush-workers) 3)))))
    (hash-set! rush-def-st 'heavy-pure-worker-allin-latched? heavy-pure-worker-allin?)
    (hash-set! rush-def-st 'heavy-pure-worker-allin-12plus? heavy-pure-worker-allin-12plus?)
    (define safe-evac-mp
      (if (and (not (null? enemy-combat-near-main))
               (not (null? base-mineral-patches)))
          (argmax (lambda (mp)
                    (define mpx (hash-ref mp 'x base-x))
                    (define mpy (hash-ref mp 'y base-y))
                    (for/fold ([best +inf.0]) ([ec (in-list enemy-combat-near-main)])
                      (min best (dist2d mpx mpy (hash-ref ec 'x 9999.0) (hash-ref ec 'y 9999.0)))))
                  base-mineral-patches)
          far-mp))
    (define evac-patch-id
      (if safe-evac-mp
          (safe-nonneg-int (hash-ref safe-evac-mp 'id 0) 0)
          far-patch-id))
    (define evac-px
      (if safe-evac-mp
          (safe-coord (hash-ref safe-evac-mp 'x far-px) far-px)
          far-px))
    (define evac-py
      (if safe-evac-mp
          (safe-coord (hash-ref safe-evac-mp 'y far-py) far-py)
          far-py))

    ;; L48-P0-1b (`r02`/`r05`/`r06` `rush_probe` 3666 regression fix):
    ;; Revert `heavy-pure-worker-allin-12plus?` (`>= 11` pure enemy workers, `hw <= ew + 2`) back to
    ;; zero-disengage (`max-total-dis-heavy-rush = 0`) and `eff-disengage-hp = 10.0` (preserving `1`
    ;; critical disengage on `10`-Probe rushes for Suite 26 & `L42-T1c`, and `+24f/+45f` for Suite 36.1)
    ;; while KEEPING L47's `4f` lowest-HP focus-fire refresh + `<= 30.0` HP finish + tighter `4f` stack!
    (define heavy-worker-rush-8plus?
      (and worker-rush-active?
           (not mixed-worker-combat-rush?)
           (or (>= (length enemy-rush-workers) 8)
               heavy-pure-worker-allin?)))
    (define eff-disengage-hp
      (cond
        [(and kiting-or-breakout-rush? worker-rush-active?) 14.0]
        [heavy-pure-worker-allin? 10.0]
        [worker-rush-active? 13.9]
        [else SC2-FIGHTING-WORKER-DISENGAGE-HP]))
    (define eff-reengage-hp
      (if (and worker-rush-active? (>= (length enemy-rush-workers) 8))
          6
          SC2-FIGHTING-WORKER-REENGAGE-HP))
    ;; L48-W3c (`r15` 15/15 recovery + screen preservation): Restore Wave 2's snappy `28f` slide /
    ;; `48f` cooldown so wounded defenders dodge focus-fire and immediately re-engage while
    ;; `kiting-breakout-max-dis` (`2..3`) and `3..4` pinned miners keep active screen `>= 11`!
    (define dis-slide-frames
      (if (and kiting-or-breakout-rush? worker-rush-active?)
          28
          24))
    (define dis-cd-frames
      (if (and kiting-or-breakout-rush? worker-rush-active?)
          48
          45))
    (define raw-disengage-cands '())
    (for ([w (in-list non-builder-defense-workers)])
      (define wid (hash-ref w 'id 10))
      (define whp (unit-total-hp-and-shield w))
      (define wx (hash-ref w 'x base-x))
      (define wy (hash-ref w 'y base-y))
      (define entry (hash-ref rush-def-st wid #f))
      (define prev-dis-until (cond [(pair? entry) (car entry)] [(exact-integer? entry) entry] [else 0]))
      (define prev-cd-until  (cond [(pair? entry) (cdr entry)] [(exact-integer? entry) entry] [else 0]))
      (define close-thresh
        (if (and worker-rush-active?
                 (not mixed-worker-combat-rush?)
                 (not kiting-or-breakout-rush?)
                 (> whp 10))
            2.2
            6.0))
      (define enemy-close?
        (ormap (lambda (e)
                 (<= (dist2d wx wy (hash-ref e 'x 9999.0) (hash-ref e 'y 9999.0)) close-thresh))
               ground-enemy-units-for-cheese))
      (define w-cd (hash-ref w 'weapon-cooldown (hash-ref w 'weapon_cooldown #f)))
      (define just-swung-or-critical?
        (or kiting-or-breakout-rush?
            (<= whp 10)
            (<= whp 5.5)
            (not (real? w-cd))
            (> w-cd 0.0)))
      (define probe-shield-depleted?
        (and worker-rush-active?
             (eq? (unit-type-sym w) 'probe)
             (or (< whp 14.0)
                 (and (<= (hash-ref w 'shield (hash-ref w 'max-shield 20)) 2)
                      (< (hash-ref w 'hp 20) 20)))))
      (define needs-disengage?
        (or (<= whp eff-disengage-hp)
            probe-shield-depleted?))
      (define update-timer?
        (and needs-disengage?
             enemy-close?
             just-swung-or-critical?
             (or (>= frame prev-cd-until)
                 (and (<= whp 10)
                      (>= frame prev-dis-until)))))
      (define new-dis-until (if update-timer? (+ frame dis-slide-frames) prev-dis-until))
      (define new-cd-until  (if update-timer? (+ frame dis-cd-frames) prev-cd-until))
      (define near-enemy-combat?
        (and mixed-worker-combat-rush?
             (ormap (lambda (ec)
                      (<= (dist2d wx wy (hash-ref ec 'x 9999.0) (hash-ref ec 'y 9999.0)) 3.8))
                    enemy-combat-near-main)))
      (define cornered-at-evac?
        (and (<= (dist2d wx wy evac-px evac-py) 2.0)
             (<= (for/fold ([best +inf.0]) ([ec (in-list enemy-combat-near-main)])
                   (min best (dist2d evac-px evac-py (hash-ref ec 'x 9999.0) (hash-ref ec 'y 9999.0))))
                 3.8)))
      (define disengaging-now?
        (or (< frame new-dis-until)
            (and near-enemy-combat? (not cornered-at-evac?))))
      (when disengaging-now?
        (set! raw-disengage-cands
              (cons (list w wid near-enemy-combat? whp update-timer? new-dis-until new-cd-until)
                    raw-disengage-cands))))
    ;; L48-W3d (Kiting/Breakout Survival Restore): Restore Wave 2's winning `5` simultaneous wounded
    ;; worker mineral-walk disengages under `kiting-or-breakout-rush?` so focus-fire whiffs cleanly
    ;; while keeping static non-kiting pure worker brawls strictly at `0`!
    (define kiting-breakout-max-dis 5)
    (define max-noncrit-dis
      (cond
        [(and kiting-or-breakout-rush? worker-rush-active?) kiting-breakout-max-dis]
        [heavy-pure-worker-allin? 0]
        [(>= (length enemy-rush-workers) 6)
         (max 1 (min 2 (- (length non-builder-defense-workers) (length enemy-rush-workers) -2)))]
        [else 999]))
    ;; L42-P0-1a + L48-P0-1b + L48-W2 + L48-W3d (Two-Mode Worker-Rush Disengage):
    ;; - Static non-kiting pure `>= 11`-worker brawls (`not kiting-or-breakout-rush?`):
    ;;   ALWAYS keep `max-total-dis-heavy-rush = 0` all the way down until `< 3` enemy workers remain
    ;;   (even when we pull ahead by `+3` workers mid-fight — prevents mid-fight `3666` throw!).
    ;; - Live kiting rushes (`enemy-kiting-rush-detected?`) OR tech-breakout defenses (`has-breakout-prod-bldg?`):
    ;;   restore wounded-worker mineral-walk disengage (`<= 14` EHP or Probe `sh <= 2 & hp < 20`, up to
    ;;   `5` workers simultaneously so focus-fire whiffs and workers survive to Marine/Zealot breakout!).
    (define max-total-dis-heavy-rush
      (cond
        [(and kiting-or-breakout-rush? worker-rush-active?) kiting-breakout-max-dis]
        [heavy-pure-worker-allin-12plus? 0]
        [heavy-pure-worker-allin? 1]
        [else 999]))
    (define sorted-disengage-cands
      (sort (reverse raw-disengage-cands) < #:key fourth))
    (define-values (kept-disengage-entries capped-stay-fighting-wids)
      (let loop ([rem sorted-disengage-cands] [kept-rev '()] [capped-rev '()] [noncrit-kept 0] [total-kept 0])
        (cond
          [(null? rem)
           (values (reverse kept-rev) (reverse capped-rev))]
          [else
           (define e (car rem))
           (define wid (second e))
           (define combat-flee? (third e))
           (define whp (fourth e))
           (cond
             [(and (not combat-flee?) (>= total-kept max-total-dis-heavy-rush))
              (loop (cdr rem) kept-rev (cons wid capped-rev) noncrit-kept total-kept)]
             [(or combat-flee? (<= whp 10))
              (loop (cdr rem) (cons e kept-rev) capped-rev noncrit-kept (add1 total-kept))]
             [(< noncrit-kept max-noncrit-dis)
              (loop (cdr rem) (cons e kept-rev) capped-rev (add1 noncrit-kept) (add1 total-kept))]
             [else
              (loop (cdr rem) kept-rev (cons wid capped-rev) noncrit-kept total-kept)])])))
    (for ([e (in-list kept-disengage-entries)])
      (when (fifth e)
        (hash-set! rush-def-st (second e) (cons (sixth e) (seventh e)))))
    (define disengage-cands
      (map (lambda (e) (take e 4)) (reverse kept-disengage-entries)))
    (set-l2-ctx-cur-rush-disengaging-wids! ctx (map second kept-disengage-entries))

    ;; Terran SCV mutual & pocket Auto-Repair before emitting mineral-walk (so repair SCVs aren't double-ordered)
    ;; L39-P0-1a + L48-W2 (`#5140013` / `r05` / `r15` Terran vs 15-Probe rush): Disable Terran SCV
    ;; Pass A & Pass B auto-repair during ANY pure `>= 6`-worker rush (0 enemy combat units) OR
    ;; `heavy-pure-worker-allin?` so SCVs fight/mine instead of burning `3685` Repair!
    (define repair-busy-ht (make-hasheqv))
    (define scv-defenders
      (if (and worker-rush-active?
               (not heavy-pure-worker-allin?)
               (not (and pure-worker-rush-now?
                         (or (>= (length enemy-rush-workers) 6)
                             enemy-kiting-rush-detected?)))
               (>= minerals 5)
               (or (eq? race 'Terran)
                   (ormap (lambda (w) (eq? (unit-type-sym w) 'scv)) non-builder-defense-workers)))
          (filter (lambda (w) (and (eq? (unit-type-sym w) 'scv) (> (hash-ref w 'id 0) 0)))
                  non-builder-defense-workers)
          '()))
    (when (not (null? scv-defenders))
      (define (nearest-cheese-dist x y)
        (for/fold ([best +inf.0]) ([e (in-list ground-enemy-units-for-cheese)])
          (min best (dist2d x y (hash-ref e 'x 9999.0) (hash-ref e 'y 9999.0)))))
      (define wounded-scvs
        (sort (filter (lambda (w)
                        (define hp (unit-total-hp-and-shield w))
                        (and (> hp 1.0) (< hp 42.0)))
                      scv-defenders)
              <
              #:key (lambda (w)
                      (define hp (unit-total-hp-and-shield w))
                      (+ hp (if (< hp 36.0) 0.0 20.0)))))
      (when (and (not (null? wounded-scvs))
                 (or (not (null? ground-enemy-units-for-cheese))
                     (< (unit-total-hp-and-shield (car wounded-scvs)) 38.0)))
        (define repair-tgt-counts (make-hasheqv))
        (define max-repairers
          (cond [(< (length scv-defenders) 6) 1]
                [(>= (length enemy-rush-workers) 6) 2]
                [else 1]))
        (define total-repairers 0)
        (define (pick-repair-target rep-id rx ry max-dist)
          (let loop ([rem wounded-scvs] [best #f] [best-score +inf.0])
            (if (null? rem)
                best
                (let* ([t (car rem)]
                       [tid (hash-ref t 'id 0)]
                       [cnt (hash-ref repair-tgt-counts tid 0)])
                  (if (or (= tid rep-id) (>= cnt 2))
                      (loop (cdr rem) best best-score)
                      (let ([d (dist2d rx ry (hash-ref t 'x base-x) (hash-ref t 'y base-y))])
                        (if (and (<= d max-dist) (> (+ (unit-total-hp-and-shield t) (* cnt 12.0)) 0.0))
                            (let ([score (+ (unit-total-hp-and-shield t) (* cnt 16.0) (* 0.5 d))])
                              (if (< score best-score)
                                  (loop (cdr rem) t score)
                                  (loop (cdr rem) best best-score)))
                            (loop (cdr rem) best best-score))))))))
        ;; Pass A: safe disengaging SCVs mutual-repair each other instead of idling at evacuation patch
        (for ([dc (in-list (reverse disengage-cands))]
              #:break (>= total-repairers max-repairers))
          (match-define (list rw rwid near-comb? rwhp) dc)
          (define rx (hash-ref rw 'x base-x))
          (define ry (hash-ref rw 'y base-y))
          (when (and (eq? (unit-type-sym rw) 'scv)
                     (> rwid 0)
                     (not near-comb?)
                     (> rwhp 5.0)
                     (> (nearest-cheese-dist rx ry) 2.2))
            (define tgt (pick-repair-target rwid rx ry 10.0))
            (when tgt
              (define tid (hash-ref tgt 'id 0))
              (hash-set! repair-busy-ht rwid #t)
              (hash-update! repair-tgt-counts tid add1 0)
              (set! total-repairers (add1 total-repairers))
              (l2-emit! ctx (list 'repair rwid tid)))))
        ;; Pass B: healthy pocket SCVs repair badly injured frontline SCVs (< 36 HP) during >= 6-SCV brawl
        (when (and (>= (length scv-defenders) 6)
                   (< total-repairers max-repairers)
                   (< (unit-total-hp-and-shield (car wounded-scvs)) 36.0))
          (define cur-dis (l2-ctx-cur-rush-disengaging-wids ctx))
          (for ([rw (in-list scv-defenders)]
                #:break (>= total-repairers max-repairers))
            (define rwid (hash-ref rw 'id 0))
            (define rwhp (unit-total-hp-and-shield rw))
            (define rx (hash-ref rw 'x base-x))
            (define ry (hash-ref rw 'y base-y))
            (define safe-from-combat?
              (or (not mixed-worker-combat-rush?)
                  (andmap (lambda (ec)
                            (> (dist2d rx ry (hash-ref ec 'x 9999.0) (hash-ref ec 'y 9999.0)) 3.8))
                          enemy-combat-near-main)))
            (when (and (>= rwhp 28.0)
                       safe-from-combat?
                       (not (memv rwid cur-dis))
                       (not (hash-has-key? repair-busy-ht rwid))
                       (> (nearest-cheese-dist rx ry) 1.8))
              (define tgt (pick-repair-target rwid rx ry 6.5))
              (when (and tgt (< (unit-total-hp-and-shield tgt) 36.0))
                (define tid (hash-ref tgt 'id 0))
                (hash-set! repair-busy-ht rwid #t)
                (hash-update! repair-tgt-counts tid add1 0)
                (set! total-repairers (add1 total-repairers))
                (set-l2-ctx-cur-rush-disengaging-wids! ctx (cons rwid (l2-ctx-cur-rush-disengaging-wids ctx)))
                (l2-emit! ctx (list 'repair rwid tid))))))))

    (for ([dc (in-list (reverse disengage-cands))])
      (define wid (second dc))
      (unless (hash-has-key? repair-busy-ht wid)
        (if (> evac-patch-id 0)
            (l2-emit! ctx (list 'mineral-walk wid evac-patch-id evac-px evac-py))
            (l2-emit! ctx (list 'mineral-walk wid evac-px evac-py)))))

    ;; L49-W2 + L50-W1 (`r16` Protoss `<= 8.5t` Leash Recall; `#08 Chance` / `r15` Safe):
    ;; Strictly Protoss-only when no outer/damaged owned structure is under attack, and never
    ;; recalls workers defending within `<= 5.5t` of an owned early structure!
    (when (and tight-protoss-first-def-leash? pure-worker-rush-now?)
      (for ([w (in-list non-builder-defense-workers)])
        (define wid (hash-ref w 'id 0))
        (define wx (hash-ref w 'x base-x))
        (define wy (hash-ref w 'y base-y))
        (when (and (> wid 0)
                   (not (memv wid (l2-ctx-cur-rush-disengaging-wids ctx)))
                   (> (dist-to-owned-townhall wx wy) 8.5)
                   (> (dist-to-mineral-line wx wy) 5.5)
                   (not (near-protected-rush-bldg? wx wy 5.5)))
          (set-l2-ctx-cur-rush-disengaging-wids! ctx (cons wid (l2-ctx-cur-rush-disengaging-wids ctx)))
          (if (> far-patch-id 0)
              (l2-emit! ctx (list 'mineral-walk wid far-patch-id far-px far-py))
              (l2-emit! ctx (list 'move wid far-px far-py))))))

    (unless (null? worker-rush-engage-enemies)
      (define (dist-to-nearest-engage-enemy wx wy)
        (for/fold ([best +inf.0]) ([ew (in-list worker-rush-engage-enemies)])
          (min best (dist2d wx wy (hash-ref ew 'x ew-cx) (hash-ref ew 'y ew-cy)))))

      ;; Only workers inside `rush-chase-leash-rad` (or defending an attacked structure) and not disengaging fight
      (define healthy-rush-workers
        (filter (lambda (w)
                  (define wid (hash-ref w 'id 10))
                  (define whp (unit-total-hp-and-shield w))
                  (define wx (hash-ref w 'x base-x))
                  (define wy (hash-ref w 'y base-y))
                  (define entry (hash-ref rush-def-st wid #f))
                  (define in-post-slide-window?
                    (and (pair? entry) (>= frame (car entry)) (< frame (cdr entry))))
                  (and (not (memv wid (l2-ctx-cur-rush-disengaging-wids ctx)))
                       (or (<= (dist-to-owned-townhall wx wy) rush-chase-leash-rad)
                           (<= (dist-to-mineral-line wx wy) 2.5)
                           (and protected-bldg-under-attack?
                                (near-protected-rush-bldg? wx wy 5.5)))
                       (cond
                         ;; L48-W2 (`r02`/`r05`/`r06` static 16v15 zero-3666 fix): When static
                         ;; zero-disengage mode is active (`max-total-dis-heavy-rush = 0`), keep
                         ;; EVERY wounded defender down to `> 0 HP` in `cur-rush-fighting-wids` so
                         ;; `5..10 HP` workers never drop out into `L8806` snap-back / `L10790` `3666`!
                         [(and (= max-total-dis-heavy-rush 0)
                               heavy-pure-worker-allin-12plus?
                               (not kiting-or-breakout-rush?))
                          (> whp 0)]
                         [(memv wid capped-stay-fighting-wids) (> whp 5)]
                         [in-post-slide-window? (> whp 5)]
                         [(memv wid prev-rush-fighting-wids) (> whp eff-disengage-hp)]
                         [else (>= whp eff-reengage-hp)])))
                non-builder-defense-workers))

      ;; Sort farthest from engaging enemies first so kept miners are ALWAYS the safest far-patch workers
      (define safest-first
        (sort healthy-rush-workers
              >
              #:key (lambda (w)
                      (dist-to-nearest-engage-enemy
                       (hash-ref w 'x base-x)
                       (hash-ref w 'y base-y)))))

      (define unthreatened-miners-cnt
        (count (lambda (w)
                 (> (dist-to-nearest-engage-enemy
                     (hash-ref w 'x base-x)
                     (hash-ref w 'y base-y))
                    4.5))
               safest-first))
      (define enemies-inside-7.5?
        (ormap (lambda (ew)
                 (define ex (hash-ref ew 'x 9999.0))
                 (define ey (hash-ref ew 'y 9999.0))
                 (or (<= (dist-to-owned-townhall ex ey) 7.5)
                     (<= (dist-to-mineral-line ex ey) 7.5)))
               worker-rush-engage-enemies))

      (define total-w-cnt (length workers))
      (define h-cnt (length safest-first))
      (define e-cnt (length worker-rush-engage-enemies))
      (define eff-e-cnt (max e-cnt (length enemy-rush-workers)))
      (define breached-mineral-cnt
        (count (lambda (ew)
                 (<= (dist-to-mineral-line (hash-ref ew 'x 9999.0)
                                           (hash-ref ew 'y 9999.0))
                     5.5))
               worker-rush-engage-enemies))
      (define th-breach-cnt
        (count (lambda (ew)
                 (<= (dist-to-owned-townhall (hash-ref ew 'x 9999.0)
                                             (hash-ref ew 'y 9999.0))
                     6.0))
               worker-rush-engage-enemies))
      (define th-tight-stack-cnt
        (count (lambda (ew)
                 (<= (dist-to-owned-townhall (hash-ref ew 'x 9999.0)
                                             (hash-ref ew 'y 9999.0))
                     3.0))
               worker-rush-engage-enemies))
      (define th-tight-3.8-cnt
        (count (lambda (ew)
                 (<= (dist-to-owned-townhall (hash-ref ew 'x 9999.0)
                                             (hash-ref ew 'y 9999.0))
                     3.8))
               worker-rush-engage-enemies))
      (define townhall-damaged-by-rush?
        (and (>= th-breach-cnt 3)
             (ormap (lambda (b)
                      (and (hash? b)
                           (memq (fast-canonical-structure-sym (unit-type-sym b))
                                 '(hatchery lair hive nexus
                                   command-center orbital-command planetary-fortress))
                           (<= (dist-to-owned-townhall (hash-ref b 'x base-x)
                                                       (hash-ref b 'y base-y))
                               4.0)
                           (let* ([b-hp (hash-ref b 'hp 1500)]
                                  [b-max-hp (hash-ref b 'max-hp b-hp)]
                                  [b-sh (hash-ref b 'shield 0)]
                                  [b-max-sh (hash-ref b 'max-shield b-sh)]
                                  [tot-max (+ b-max-hp b-max-sh)])
                             (and (> tot-max 0)
                                  (< (+ b-hp b-sh) (* 0.98 tot-max))))))
                    ally-bldgs)))
      ;; #5125725 TownHall-Focus Stack-Breaker: enemy workers tightly stacked on TownHall (< 98% HP or >= 5 within 3.0t or >= 3 within 3.8t)
      (define th-focus-stack-trigger?
        (and (>= eff-e-cnt 6)
             (or (>= th-tight-stack-cnt 5)
                 townhall-damaged-by-rush?
                 (and (>= th-breach-cnt 3) (>= th-tight-3.8-cnt 3)))))
      (define all-hands-mineral-brawl?
        (and (>= eff-e-cnt 6)
             (or th-focus-stack-trigger?
                 (>= eff-e-cnt 11)
                 (>= breached-mineral-cnt 3)
                 (and (>= th-breach-cnt 3) (< unthreatened-miners-cnt 3))
                 (ormap (lambda (b)
                          (and (hash? b)
                               (<= (dist-to-owned-townhall (hash-ref b 'x base-x)
                                                           (hash-ref b 'y base-y))
                                   (if heavy-worker-allin-no-army? 7.5 9.5))
                               (let* ([b-hp (hash-ref b 'hp 1500)]
                                      [b-max-hp (hash-ref b 'max-hp b-hp)]
                                      [b-sh (hash-ref b 'shield 0)]
                                      [b-max-sh (hash-ref b 'max-shield b-sh)]
                                      [tot-max (+ b-max-hp b-max-sh)])
                                 (and (> tot-max 0)
                                      (< (+ b-hp b-sh) (* 0.96 tot-max))))))
                        ally-bldgs))))
      (define surplus-miners (max 0 (- h-cnt (+ eff-e-cnt 2))))
      (define breakout-min-target
        (if (and (eq? race 'Zerg)
                 (not (l2-building-present-or-pending? ctx 'spawning-pool)))
            200
            150))
      ;; L48-W2 + L48-W3b + L49-W1 (Pinned Breakout Miners — Preserving Screen & Zealot #2 Timing):
      ;; Pin `3..4` persistent zero-churn miners in `rush-def-st` (refreshed ONLY on death or
      ;; `< 15` EHP, NEVER pulling any `carrying-minerals?` worker off return-cargo!). Keep Protoss
      ;; / combat-assisted pinned miners active down to `h-cnt >= 4` (`4/3/2`) so wounded-Probe
      ;; mineral-walk slides (`kiting-breakout-max-dis = 5`) never unpin harvesters before Zealot #2!
      (define need-pinned-breakout-miners?
        (and has-owned-townhall?
             has-breakout-prod-bldg?
             (< (l2-ctx-ally-combat-supply-early ctx) 6.0)
             (>= h-cnt (cond
                         [(eq? race 'Protoss) 4]
                         ;; L58-P3 (`sc2-reg-r15`): Under detected kiting Probe rush with < 2 Marines,
                         ;; keep 2..3 Terran miners pinned down to `h-cnt >= 5` so wounded SCV slides
                         ;; don't unpin harvesters and starve Marine #2/#3 (preserves `L49-W2-4`!).
                         [(and (eq? race 'Terran)
                               enemy-kiting-rush-detected?
                               (< (l2-ctx-ally-combat-supply-early ctx) 2.0))
                          5]
                         [else 8]))
             (or enemy-kiting-rush-detected?
                 (and (eq? race 'Protoss) (< minerals 100))
                 (and (eq? race 'Zerg)
                      (< minerals 100)
                      (or (< (count (lambda (cu)
                                      (and (hash? cu)
                                           (eq? (fast-canonical-unit-sym (unit-type-sym cu)) 'zergling)))
                                    (or (l2-ctx-ally-combat-units ctx) '()))
                             6)
                          (not (ormap (lambda (b)
                                        (and (hash? b)
                                             (eq? (fast-canonical-structure-sym (unit-type-sym b)) 'spine-crawler)))
                                      ally-bldgs))))
                 (and (eq? race 'Terran) (< minerals 50)))))
      (define min-breakout-miners
        (cond
          [need-pinned-breakout-miners?
           (cond [(>= h-cnt 14) 4]
                 [(and (eq? race 'Protoss) (>= h-cnt 10)) 4]
                 [(>= h-cnt 6) 3]
                 [else 2])]
          [(and has-owned-townhall?
                (< (l2-ctx-ally-combat-supply-early ctx) 4.0)
                (>= h-cnt 6)
                (or (and enemy-kiting-rush-detected?
                         (< minerals breakout-min-target))
                    (and has-breakout-prod-bldg?
                         (< minerals (if (eq? race 'Protoss) 100 50))
                         (or (not all-hands-mineral-brawl?)
                             (> h-cnt (+ eff-e-cnt 2))))))
           (if (and (>= h-cnt 14) enemy-kiting-rush-detected?) 4 3)]
          [else 0]))
      (define base-keep-mining-cnt
        (cond
          [all-hands-mineral-brawl?
           (cond
             ;; L48-W3b (`r02`/`r05`/`r06` Static Brawl Zero-Peel): Once a pure `>= 11`-worker
             ;; static all-in commits (`not kiting-or-breakout-rush?`, `h-cnt <= eff-e-cnt + 2` OR
             ;; already mid-brawl with `prev-rush-fighting-wids`), NEVER peel fighters back to mine
             ;; when pulling ahead `+3` workers mid-fight (preserves Test 34.2 16v12 tick-0 surplus)!
             [(and heavy-pure-worker-allin-12plus?
                   (not kiting-or-breakout-rush?)
                   (or (<= h-cnt (+ eff-e-cnt 2))
                       (pair? prev-rush-fighting-wids)))
              0]
             [(>= h-cnt (+ eff-e-cnt 4)) (max 4 (- h-cnt (+ eff-e-cnt 2)))]
             [(> h-cnt (+ eff-e-cnt 2)) (min 4 (- h-cnt (+ eff-e-cnt 1)))]
             ;; L38-P0-1c + L47-P0-1b (`#5138248` / `r02`/`r05`/`r06` 15-Probe all-in): Commit ALL
             ;; healthy workers throughout the latched `>= 11`-worker brawl (even after enemy Probes
             ;; drop `15 -> 12 -> 8`!) when margin `<= +2` so zero fighters randomly peel back to mine!
             [(and (or heavy-pure-worker-allin-12plus? (>= eff-e-cnt 10))
                   (<= h-cnt (+ eff-e-cnt 2)))
              0]
             [(> h-cnt 4) 1]
             [else 0])]
          [(and (>= total-w-cnt 8) (>= unthreatened-miners-cnt 3))
           (max 4 surplus-miners)]
          [(and (>= total-w-cnt 7) (>= unthreatened-miners-cnt 3))
           (max 3 surplus-miners)]
          [(and enemies-inside-7.5? (< h-cnt 8))
           (min 2 (max 0 (sub1 h-cnt)))]
          [(>= total-w-cnt 8)
           (max 4 surplus-miners)]
          [(>= total-w-cnt 7)
           (max 3 surplus-miners)]
          [else
           (min 2 surplus-miners)]))
      (define keep-mining-cnt
        (min h-cnt (max min-breakout-miners base-keep-mining-cnt)))

      (define reserve-pool-w
        (and (eq? race 'Zerg)
             worker-rush-active?
             (>= minerals 180)
             (or (< eff-e-cnt 10) (> h-cnt (+ eff-e-cnt 2)) kiting-or-breakout-rush?)
             (not (l2-building-present-or-pending? ctx 'spawning-pool))
             (not (null? safest-first))
             (or (findf (lambda (w) (>= (unit-total-hp-and-shield w) 30.0)) safest-first)
                 (car safest-first))))
      (define reserve-pool-wid (and reserve-pool-w (hash-ref reserve-pool-w 'id 0)))
      (when (and (exact-integer? reserve-pool-wid) (> reserve-pool-wid 0))
        (set-l2-ctx-rush-pool-builder-wid! ctx reserve-pool-wid))
      (define raw-pulled-rush-workers
        (cond
          [need-pinned-breakout-miners?
           (define healthy-by-id (make-hasheqv))
           (for ([w (in-list safest-first)])
             (hash-set! healthy-by-id (hash-ref w 'id 0) w))
           (define prev-pinned-raw (hash-ref rush-def-st 'pinned-breakout-miners '()))
           (define prev-pinned
             (if (list? prev-pinned-raw)
                 (filter (lambda (pid)
                           (define pw (hash-ref healthy-by-id pid #f))
                           (and pw (>= (unit-total-hp-and-shield pw) 15.0)))
                         prev-pinned-raw)
                 '()))
           (define pinned-set (make-hasheqv))
           (define pinned-rev '())
           (define (try-pin! wid)
             (when (and (> wid 0)
                        (< (length pinned-rev) keep-mining-cnt)
                        (not (hash-has-key? pinned-set wid)))
               (hash-set! pinned-set wid #t)
               (set! pinned-rev (cons wid pinned-rev))))
           ;; Keep already-pinned healthy miners first so harvest trips are NEVER interrupted!
           (for ([pid (in-list prev-pinned)])
             (try-pin! pid))
           ;; Next pin any worker currently carrying minerals so `+5M` return-cargo finishes!
           (for ([w (in-list safest-first)])
             (when (or (eq? (hash-ref w 'carrying-minerals? #f) #t)
                       (worker-carrying-minerals-or-gas? w))
               (try-pin! (hash-ref w 'id 0))))
           ;; Top up to `keep-mining-cnt` from safest healthy (`>= 15` EHP) far-patch workers!
           (for ([w (in-list safest-first)])
             (when (>= (unit-total-hp-and-shield w) 15.0)
               (try-pin! (hash-ref w 'id 0))))
           (for ([w (in-list safest-first)])
             (try-pin! (hash-ref w 'id 0)))
           (define final-pinned (reverse pinned-rev))
           (hash-set! rush-def-st 'pinned-breakout-miners final-pinned)
           (filter (lambda (w)
                     (define wid (hash-ref w 'id 0))
                     (and (not (hash-has-key? pinned-set wid))
                          (not (eq? (hash-ref w 'carrying-minerals? #f) #t))
                          (not (worker-carrying-minerals-or-gas? w))))
                   safest-first)]
          [else
           (hash-set! rush-def-st 'pinned-breakout-miners '())
           (drop safest-first keep-mining-cnt)]))
      (define pulled-rush-workers
        (if (and (exact-integer? reserve-pool-wid) (> reserve-pool-wid 0))
            (filter (lambda (w) (not (equal? (hash-ref w 'id 0) reserve-pool-wid)))
                    raw-pulled-rush-workers)
            raw-pulled-rush-workers))
      ;; Compute shared enemy cluster & focus coordinates for both pulled workers & home breakout combat units
      (define raw-cl-x
        (/ (for/sum ([ew (in-list worker-rush-engage-enemies)])
             (exact->inexact (hash-ref ew 'x base-x)))
           e-cnt))
      (define raw-cl-y
        (/ (for/sum ([ew (in-list worker-rush-engage-enemies)])
             (exact->inexact (hash-ref ew 'y base-y)))
           e-cnt))
      (define cl-dx (- raw-cl-x (exact->inexact base-x)))
      (define cl-dy (- raw-cl-y (exact->inexact base-y)))
      (define cl-d (sqrt (+ (* cl-dx cl-dx) (* cl-dy cl-dy))))
      (define cl-x
        (safe-coord (if (> cl-d rush-chase-leash-rad) (+ base-x (* rush-chase-leash-rad (/ cl-dx cl-d))) raw-cl-x) base-x))
      (define cl-y
        (safe-coord (if (> cl-d rush-chase-leash-rad) (+ base-y (* rush-chase-leash-rad (/ cl-dy cl-d))) raw-cl-y) base-y))
      (define in-pack-engage-enemies
        (let* ([th-stack (if th-focus-stack-trigger?
                             (filter (lambda (ew)
                                       (<= (dist-to-owned-townhall
                                            (hash-ref ew 'x cl-x)
                                            (hash-ref ew 'y cl-y))
                                           4.2))
                                     worker-rush-engage-enemies)
                             '())]
               [near-pack
                (if (not (null? th-stack))
                    th-stack
                    (filter (lambda (ew)
                              (<= (dist2d cl-x cl-y
                                          (hash-ref ew 'x cl-x)
                                          (hash-ref ew 'y cl-y))
                                  3.5))
                            worker-rush-engage-enemies))]
               [base-pack (if (null? near-pack) worker-rush-engage-enemies near-pack)]
               [non-flee-pack (filter (lambda (ew) (not (ew-fleeing-away? ew))) base-pack)])
          (if (pair? non-flee-pack) non-flee-pack base-pack)))
      ;; L47-P0-1b (`r02`/`r05`/`r06` 4f Lowest-HP Focus-Fire Refresh) + L48-W2 (Skip Fleeing Targets):
      (define raw-lowest-ehp-enemy
        (argmin (lambda (ew)
                  (+ (* (if heavy-worker-rush-8plus? 10.0 5.0) (unit-total-hp-and-shield ew))
                     (dist-to-owned-townhall (hash-ref ew 'x cl-x) (hash-ref ew 'y cl-y))))
                in-pack-engage-enemies))
      (define lowest-ehp-enemy
        (if heavy-worker-rush-8plus?
            (let* ([prev-ff-f (hash-ref rush-def-st 'rush-focus-last-frame -9999)]
                   [prev-ff-id (hash-ref rush-def-st 'rush-focus-target-id #f)]
                   [prev-alive (and prev-ff-id
                                    (findf (lambda (ew)
                                             (and (equal? (hash-ref ew 'id -1) prev-ff-id)
                                                  (not (ew-fleeing-away? ew))))
                                           in-pack-engage-enemies))]
                   [refresh-due? (or (not prev-alive)
                                     (< frame prev-ff-f)
                                     (>= (- frame prev-ff-f) 4))]
                   [chosen (if refresh-due? raw-lowest-ehp-enemy prev-alive)])
              (when (and refresh-due? chosen)
                (hash-set! rush-def-st 'rush-focus-last-frame frame)
                (hash-set! rush-def-st 'rush-focus-target-id (hash-ref chosen 'id -1)))
              chosen)
            raw-lowest-ehp-enemy))
      (define raw-focus-x
        (if lowest-ehp-enemy
            (safe-coord (hash-ref lowest-ehp-enemy 'x cl-x) cl-x)
            cl-x))
      (define raw-focus-y
        (if lowest-ehp-enemy
            (safe-coord (hash-ref lowest-ehp-enemy 'y cl-y) cl-y)
            cl-y))
      (define fa-dx (- (exact->inexact raw-focus-x) (exact->inexact base-x)))
      (define fa-dy (- (exact->inexact raw-focus-y) (exact->inexact base-y)))
      (define fa-d (sqrt (+ (* fa-dx fa-dx) (* fa-dy fa-dy))))
      (define fa-max-rad (if enemy-kiting-rush-detected? 5.5 (if heavy-worker-allin-no-army? 7.5 10.5)))
      (define focus-amove-x
        (safe-coord (if (> fa-d fa-max-rad) (+ base-x (* fa-max-rad (/ fa-dx fa-d))) raw-focus-x) cl-x))
      (define focus-amove-y
        (safe-coord (if (> fa-d fa-max-rad) (+ base-y (* fa-max-rad (/ fa-dy fa-d))) raw-focus-y) cl-y))
      (define pocket-amove-x
        (safe-coord (if (> fa-d 5.5) (+ base-x (* 5.5 (/ fa-dx (max 0.1 fa-d)))) raw-focus-x) base-x))
      (define pocket-amove-y
        (safe-coord (if (> fa-d 5.5) (+ base-y (* 5.5 (/ fa-dy (max 0.1 fa-d)))) raw-focus-y) base-y))
      (define primary-focus-id
        (and lowest-ehp-enemy (hash-ref lowest-ehp-enemy 'id -1)))

      (unless (null? pulled-rush-workers)
        (set-l2-ctx-cur-rush-fighting-wids! ctx
              (map (lambda (w) (hash-ref w 'id 10)) pulled-rush-workers))

        ;; Partition defenders per-worker locally: max 3 normally (and always <= 3 for Pass-2 chasers to avoid
        ;; conga-lining in open space), or up to 8 in Pass-1 melee range when >= 6 enemy workers are mineral-walk
        ;; stacked inside our mineral line (<= 5.0 tiles from mineral patches) so 8 * 5 = 40 one-shots a stacked Probe!
        (define (mineral-line-stacked-enemy? ew)
          (define ex (hash-ref ew 'x cl-x))
          (define ey (hash-ref ew 'y cl-y))
          (and (>= e-cnt 6)
               (or (and th-focus-stack-trigger?
                        (<= (dist-to-owned-townhall ex ey) 4.2))
                   (and (or (<= (dist-to-mineral-line ex ey) 5.0)
                            (<= (dist-to-owned-townhall ex ey) 6.0))
                        (>= (count (lambda (other)
                                     (<= (dist2d ex ey
                                                 (hash-ref other 'x cl-x)
                                                 (hash-ref other 'y cl-y))
                                         1.75))
                                   worker-rush-engage-enemies)
                            4))
                   (and live-obs-harvesters?
                        primary-focus-id
                        (equal? (hash-ref ew 'id 0) primary-focus-id)
                        (or (<= (dist-to-mineral-line ex ey) 5.5)
                            (<= (dist-to-owned-townhall ex ey) 6.0))))))
        ;; L48-W3 (Fix W3-R1 — Static Non-Kiting `r02`/`r05`/`r06` Surface-Area Melee Physics):
        ;; Under static non-kiting `>= 11`-worker pure brawls (`not kiting-or-breakout-rush?`):
        ;; (a) cap per-target attackers at `<= 3` (matching physical melee contact around a 0.375r worker),
        ;; (b) Pass 1 strictly prioritizes enemies ALREADY in swing range (`<= 1.35t`, lowest-EHP first),
        ;; (c) Pass 2 scores by DISTANCE FIRST (`20*d + 0.35*ehp`) with `attack-pos` fallback, and
        ;; (d) disables `l44-pre-contact-stack-mp` (`0` pre-stack `3666` stall)!
        (define static-nonkiting-heavy-brawl?
          (and heavy-pure-worker-allin-12plus?
               (not kiting-or-breakout-rush?)))
        (define (effective-melee-cap ew)
          (define ehp (max 1.0 (exact->inexact (unit-total-hp-and-shield ew))))
          (define swings-needed (inexact->exact (ceiling (/ ehp 5.0))))
          (define is-primary?
            (and primary-focus-id (equal? (hash-ref ew 'id -1) primary-focus-id)))
          (cond
            [static-nonkiting-heavy-brawl?
             (min 3 (max 2 swings-needed))]
            [else
             (define cap
               (cond
                 [(and heavy-pure-worker-allin-12plus? is-primary?) 8]
                 [(mineral-line-stacked-enemy? ew) 8]
                 [heavy-pure-worker-allin-12plus? 6]
                 [else 3]))
             ;; L43-P0-1d (`r02`/`r05`/`r06`): Add `+2` overkill buffer (`+1` when `<= 6.5` EHP,
             ;; preserving Suite 30 `<= 3` cap on 6-HP Probes!) under `>= 11`-worker pure all-in
             ;; so shield-regen/jostling NEVER leaves `5–10 HP` Probes alive!
             (min cap (max 2 (if heavy-pure-worker-allin-12plus?
                                 (+ swings-needed (if (<= ehp 6.5) 1 2))
                                 swings-needed)))]))
        (define (effective-chaser-cap ew)
          (if static-nonkiting-heavy-brawl?
              (min 3 (effective-melee-cap ew))
              (min (if (and (>= e-cnt 6)
                            primary-focus-id
                            (equal? (hash-ref ew 'id -1) primary-focus-id)
                            (or heavy-pure-worker-allin-12plus?
                                (mineral-line-stacked-enemy? ew)))
                       6
                       3)
                   (effective-melee-cap ew))))
        (define assigned-target-counts (make-hasheqv))
        (define worker-assignments (make-hasheqv))
        (define frontline-first
          (sort pulled-rush-workers
                <
                #:key (lambda (w)
                        (dist-to-nearest-engage-enemy
                         (hash-ref w 'x base-x)
                         (hash-ref w 'y base-y)))))

        (define (enemy-worker-safe-from-combat? ew)
          (or (not mixed-worker-combat-rush?)
              (let ([ex (hash-ref ew 'x cl-x)]
                    [ey (hash-ref ew 'y cl-y)])
                (andmap (lambda (ec)
                          (> (dist2d ex ey (hash-ref ec 'x 9999.0) (hash-ref ec 'y 9999.0)) 2.5))
                        enemy-combat-near-main))))
        (define safe-engage-workers
          (let* ([base-ews
                  (if (and tight-protoss-first-def-leash? pure-worker-rush-now?)
                      (filter (lambda (ew)
                                (define ex (hash-ref ew 'x cl-x))
                                (define ey (hash-ref ew 'y cl-y))
                                (or (<= (dist-to-owned-townhall ex ey) 8.5)
                                    (<= (dist-to-mineral-line ex ey) 6.5)
                                    (near-protected-rush-bldg? ex ey 5.5)))
                              worker-rush-engage-enemies)
                      worker-rush-engage-enemies)]
                 [safe (filter enemy-worker-safe-from-combat? base-ews)])
            (if (null? safe) base-ews safe)))
        ;; L48-W2: Exclude `fleeing-away?` enemy workers outside `<= 1.6t` immediate melee range
        ;; so defenders NEVER chase uncatchable `3.94`-speed mineral-walking Probes!
        (define (targetable-ew-for-worker? ew wx wy)
          (or (not (ew-fleeing-away? ew))
              (<= (dist2d wx wy (hash-ref ew 'x cl-x) (hash-ref ew 'y cl-y)) 1.6)))
        (define (non-retreating-engage-worker? ew)
          (define ex (hash-ref ew 'x cl-x))
          (define ey (hash-ref ew 'y cl-y))
          (and (not (ew-fleeing-away? ew))
               (or (<= (dist-to-owned-townhall ex ey) rush-th-pull-rad)
                   (<= (dist-to-mineral-line ex ey) 6.5)
                   (near-protected-rush-bldg? ex ey 5.5)
                   (ormap (lambda (b)
                            (and (hash? b)
                                 (<= (dist-to-owned-townhall
                                      (hash-ref b 'x base-x)
                                      (hash-ref b 'y base-y))
                                     rush-bldg-th-rad)
                                 (<= (dist2d ex ey
                                             (hash-ref b 'x base-x)
                                             (hash-ref b 'y base-y))
                                     4.5)))
                          ally-bldgs))))

        ;; Pass 0 (L48-W3b Static Non-Kiting Sticky Swing Preservation):
        ;; Under `static-nonkiting-heavy-brawl?`, if a defender is ALREADY swinging at a live target
        ;; within `<= 1.5t` melee contact (`engaged-target-tag` or `order-ability-id == 23`), preserve
        ;; that target assignment FIRST so `4f` ticks never cancel mid-backswing or jitter!
        (when static-nonkiting-heavy-brawl?
          (define safe-ew-by-id (make-hasheqv))
          (for ([ew (in-list safe-engage-workers)])
            (define eid (hash-ref ew 'id 0))
            (when (> eid 0) (hash-set! safe-ew-by-id eid ew)))
          (for ([w (in-list frontline-first)])
            (define wid (hash-ref w 'id 10))
            (define etag (hash-ref w 'engaged-target-tag 0))
            (define otag (if (= (hash-ref w 'order-ability-id 0) 23) (hash-ref w 'order-target-tag 0) 0))
            (define cur-tid (if (> etag 0) etag otag))
            (when (> cur-tid 0)
              (define ew (hash-ref safe-ew-by-id cur-tid #f))
              (when (and ew
                         (< (hash-ref assigned-target-counts cur-tid 0) (effective-melee-cap ew))
                         (<= (dist2d (hash-ref w 'x base-x) (hash-ref w 'y base-y)
                                     (hash-ref ew 'x cl-x) (hash-ref ew 'y cl-y))
                             1.5))
                (hash-update! assigned-target-counts cur-tid add1 0)
                (hash-set! worker-assignments wid
                           (list cur-tid
                                 (safe-coord (hash-ref ew 'x cl-x) cl-x)
                                 (safe-coord (hash-ref ew 'y cl-y) cl-y)))))))

        ;; Pass 1: Immediate melee swing:
        ;; - Under `static-nonkiting-heavy-brawl?` (L48-W3 Fix W3-R1): STRICTLY direct melee contact
        ;;   (`<= 1.35t`, lowest-EHP among enemies ALREADY in swing range — NEVER walking `2.6t` past
        ;;   an adjacent Probe!), falling straight through to distance-first Pass 2 otherwise!
        ;; - Under kiting/breakout or smaller rushes: finish wounded (`<= 30` EHP `<= 2.6t`), else `<= 1.65t` / `2.5..3.2t`.
        (for ([w (in-list frontline-first)]
              #:unless (hash-has-key? worker-assignments (hash-ref w 'id 10)))
          (define wid (hash-ref w 'id 10))
          (define wx (hash-ref w 'x base-x))
          (define wy (hash-ref w 'y base-y))
          (define wounded-finish-cands
            (if (and heavy-pure-worker-allin-12plus? (not static-nonkiting-heavy-brawl?))
                (filter (lambda (ew)
                          (define eid (hash-ref ew 'id 0))
                          (and (> eid 0)
                               (targetable-ew-for-worker? ew wx wy)
                               (<= (unit-total-hp-and-shield ew) 30.0)
                               (< (hash-ref assigned-target-counts eid 0) (effective-melee-cap ew))
                               (<= (dist2d wx wy (hash-ref ew 'x cl-x) (hash-ref ew 'y cl-y)) 2.6)))
                        safe-engage-workers)
                '()))
          (define direct-contact-cands
            (if (and heavy-pure-worker-allin-12plus? (null? wounded-finish-cands))
                (filter (lambda (ew)
                          (define eid (hash-ref ew 'id 0))
                          (and (> eid 0)
                               (targetable-ew-for-worker? ew wx wy)
                               (< (hash-ref assigned-target-counts eid 0) (effective-melee-cap ew))
                               (<= (dist2d wx wy (hash-ref ew 'x cl-x) (hash-ref ew 'y cl-y))
                                   (if static-nonkiting-heavy-brawl? 1.35 1.65))))
                        safe-engage-workers)
                '()))
          (define melee-cands
            (cond
              [(pair? wounded-finish-cands) wounded-finish-cands]
              [(pair? direct-contact-cands) direct-contact-cands]
              [static-nonkiting-heavy-brawl? '()]
              [else
                (filter (lambda (ew)
                          (define eid (hash-ref ew 'id 0))
                          (define reach
                            (if (and (>= e-cnt 6)
                                     primary-focus-id
                                     (equal? eid primary-focus-id)
                                     (or (and th-focus-stack-trigger?
                                              (<= (dist-to-owned-townhall (hash-ref ew 'x cl-x) (hash-ref ew 'y cl-y)) 4.2))
                                         (and live-obs-harvesters?
                                              (<= (dist-to-mineral-line (hash-ref ew 'x cl-x) (hash-ref ew 'y cl-y)) 5.5))))
                                3.2
                                2.5))
                          (and (> eid 0)
                               (targetable-ew-for-worker? ew wx wy)
                               (< (hash-ref assigned-target-counts eid 0) (effective-melee-cap ew))
                               (<= (dist2d wx wy (hash-ref ew 'x cl-x) (hash-ref ew 'y cl-y)) reach)))
                        safe-engage-workers)]))
          (unless (null? melee-cands)
            (define chosen
              (argmin (lambda (ew)
                        (cond
                          [static-nonkiting-heavy-brawl?
                           (+ (* 10.0 (unit-total-hp-and-shield ew))
                              (dist2d wx wy (hash-ref ew 'x cl-x) (hash-ref ew 'y cl-y)))]
                          [heavy-pure-worker-allin-12plus?
                           (+ (* 15.0 (unit-total-hp-and-shield ew))
                              (* 2.5 (dist2d wx wy (hash-ref ew 'x cl-x) (hash-ref ew 'y cl-y))))]
                          [else
                           (+ (* 100.0 (unit-total-hp-and-shield ew))
                              (dist2d wx wy (hash-ref ew 'x cl-x) (hash-ref ew 'y cl-y)))]))
                      melee-cands))
            (define cid (hash-ref chosen 'id 0))
            (hash-update! assigned-target-counts cid add1 0)
            (hash-set! worker-assignments wid
                       (list cid
                             (safe-coord (hash-ref chosen 'x cl-x) cl-x)
                             (safe-coord (hash-ref chosen 'y cl-y) cl-y)))))

        ;; Pass 2: Targeted focus-fire within 4.5-6.0 tiles (7.0 for < 6 workers, 10.0 for heavy pure
        ;; worker all-in!) — under `static-nonkiting-heavy-brawl?` score DISTANCE FIRST (`20*d + 0.35*ehp`)
        ;; matching melee surface-area physics, falling back to `attack-pos` (`tid=0`) when caps fill!
        (define pass2-reach (cond [heavy-pure-worker-allin? 10.0] [(>= e-cnt 6) 6.0] [else 7.0]))
        (for ([w (in-list frontline-first)]
              #:unless (hash-has-key? worker-assignments (hash-ref w 'id 10)))
          (define wid (hash-ref w 'id 10))
          (define wx (hash-ref w 'x base-x))
          (define wy (hash-ref w 'y base-y))
          (define raw-local-cands
            (filter (lambda (ew)
                      (define eid (hash-ref ew 'id 0))
                      (and (> eid 0)
                           (targetable-ew-for-worker? ew wx wy)
                           (< (hash-ref assigned-target-counts eid 0) (effective-chaser-cap ew))
                           (<= (dist2d wx wy (hash-ref ew 'x cl-x) (hash-ref ew 'y cl-y)) pass2-reach)))
                    safe-engage-workers))
          (define local-cands
            (let ([non-ret (filter non-retreating-engage-worker? raw-local-cands)])
              (if (null? non-ret) raw-local-cands non-ret)))
          (cond
            [(not (null? local-cands))
             (define chosen
               (argmin (lambda (ew)
                         (cond
                           [static-nonkiting-heavy-brawl?
                            (+ (* 20.0 (dist2d wx wy (hash-ref ew 'x cl-x) (hash-ref ew 'y cl-y)))
                               (* 0.35 (unit-total-hp-and-shield ew)))]
                           [heavy-pure-worker-allin-12plus?
                            (+ (* 15.0 (unit-total-hp-and-shield ew))
                               (* 2.5 (dist2d wx wy (hash-ref ew 'x cl-x) (hash-ref ew 'y cl-y))))]
                           [else
                            (+ (* (if heavy-pure-worker-allin? 25.0 5.0) (unit-total-hp-and-shield ew))
                               (* 2.5 (dist2d wx wy (hash-ref ew 'x cl-x) (hash-ref ew 'y cl-y))))]))
                       local-cands))
             (define cid (hash-ref chosen 'id 0))
             (hash-update! assigned-target-counts cid add1 0)
             (hash-set! worker-assignments wid
                        (list cid
                              (safe-coord (hash-ref chosen 'x cl-x) cl-x)
                              (safe-coord (hash-ref chosen 'y cl-y) cl-y)))]
            [(and heavy-pure-worker-allin? (not static-nonkiting-heavy-brawl?) (pair? safe-engage-workers))
             ;; Focus-fire `23` (`attack-unit`) on the lowest-EHP uncapped NON-FLEEING enemy worker;
             ;; if all visible enemy workers are fleeing away, hold mineral pocket via `0` A-move (`<= 5.5t`)!
             (define uncapped-cands
               (filter (lambda (ew)
                         (define eid (hash-ref ew 'id 0))
                         (and (> eid 0)
                              (targetable-ew-for-worker? ew wx wy)
                              (< (hash-ref assigned-target-counts eid 0) (effective-chaser-cap ew))))
                       safe-engage-workers))
             (cond
               [(pair? uncapped-cands)
                (define chosen
                  (argmin (lambda (ew)
                            (+ (* 25.0 (unit-total-hp-and-shield ew))
                               (dist2d wx wy (hash-ref ew 'x cl-x) (hash-ref ew 'y cl-y))))
                          uncapped-cands))
                (define cid (hash-ref chosen 'id 0))
                (hash-update! assigned-target-counts cid add1 0)
                (hash-set! worker-assignments wid
                           (list cid
                                 (safe-coord (hash-ref chosen 'x cl-x) cl-x)
                                 (safe-coord (hash-ref chosen 'y cl-y) cl-y)))]
               [else
                (hash-set! worker-assignments wid (list 0 pocket-amove-x pocket-amove-y))])]
            [mixed-worker-combat-rush?
             (define safe-fallback
               (let ([cand (findf (lambda (ew)
                                    (and (> (hash-ref ew 'id 0) 0)
                                         (targetable-ew-for-worker? ew wx wy)
                                         (enemy-worker-safe-from-combat? ew)))
                                  safe-engage-workers)])
                 cand))
             (when safe-fallback
               (hash-set! worker-assignments wid
                          (list (hash-ref safe-fallback 'id 0)
                                (safe-coord (hash-ref safe-fallback 'x cl-x) cl-x)
                                (safe-coord (hash-ref safe-fallback 'y cl-y) cl-y))))]
            [else
             (hash-set! worker-assignments wid (list 0 pocket-amove-x pocket-amove-y))]))

        ;; L38-P0-1c + L40-P0-1b (`r02`/`r05`): Suppress `worker-drill-stack-attack` (`3666`) for any
        ;; worker already `<= 6.0t` from enemy rush workers during `heavy-pure-worker-allin?` so
        ;; Drones/SCVs never burn 50% of ticks on 0-DPS `3666` gather instead of `23` focus-fire!
        (define stacked-enemy-inside-minerals?
          (and (>= e-cnt 6)
               (or th-focus-stack-trigger?
                   (ormap (lambda (ew)
                            (and (mineral-line-stacked-enemy? ew)
                                 (<= (dist-to-mineral-line (hash-ref ew 'x cl-x)
                                                           (hash-ref ew 'y cl-y))
                                     1.5)))
                          worker-rush-engage-enemies))))
        (define drill-patch
          (and (>= e-cnt 6)
               (not mixed-worker-combat-rush?)
               (not (null? base-mineral-patches))
               (let ([th-coord
                      (argmin (lambda (bc) (dist2d cl-x cl-y (car bc) (cdr bc)))
                              ready-townhall-coords)])
                 (placement:select-worker-drill-stack-mineral-patch
                  cl-x cl-y (car th-coord) (cdr th-coord) base-mineral-patches))))
        (define drill-patch-id
          (and (hash? drill-patch) (safe-nonneg-int (hash-ref drill-patch 'id 0) 0)))
        (define drill-patch-near-focus?
          (and (hash? drill-patch)
               (exact-integer? drill-patch-id)
               (> drill-patch-id 0)
               (<= (dist2d focus-amove-x focus-amove-y
                           (hash-ref drill-patch 'x base-x)
                           (hash-ref drill-patch 'y base-y))
                   4.0)))
        (define drill-min-enemy-dist (if heavy-pure-worker-allin? 6.0 2.2))
        (define drill-converge-wids
          (if (and drill-patch-near-focus?
                   (or stacked-enemy-inside-minerals?
                       (and (>= e-cnt 6)
                            (<= (dist-to-owned-townhall cl-x cl-y) 7.5))))
              (let ([dpx (hash-ref drill-patch 'x base-x)]
                    [dpy (hash-ref drill-patch 'y base-y)])
                (for/list ([w (in-list frontline-first)]
                           #:when (let ([wid (hash-ref w 'id 0)]
                                        [wx (hash-ref w 'x base-x)]
                                        [wy (hash-ref w 'y base-y)])
                                    (and (> wid 0)
                                         (> (dist-to-nearest-engage-enemy wx wy) drill-min-enemy-dist)
                                         (<= (dist2d wx wy dpx dpy) 6.4))))
                  (hash-ref w 'id 0)))
              '()))
        ;; L44-P0-1c + L46-P0-1b + L48-W2 + L48-W3 (Fix W3-R1): Disable pre-contact mineral-patch
        ;; stack under static non-kiting `heavy-pure-worker-allin-12plus?` (`r02`/`r05`/`r06`) so
        ;; 16 defenders NEVER stall 4f giving 15 static Probes free first strikes (0 pre-stack `3666`!)!
        (define l44-pre-contact-stack-mp
          (and (not enemy-kiting-rush-detected?)
               (not static-nonkiting-heavy-brawl?)
               (or heavy-pure-worker-allin-12plus?
                   (and (>= e-cnt 10)
                        (not mixed-worker-combat-rush?)
                        (null? (or (l2-ctx-ally-combat-units ctx) '()))))
               (>= (length frontline-first) 8)
               (pair? base-mineral-patches)
               (let* ([min-ew-d
                       (for/fold ([md +inf.0]) ([w (in-list frontline-first)])
                         (min md (dist-to-nearest-engage-enemy
                                  (hash-ref w 'x base-x)
                                  (hash-ref w 'y base-y))))]
                      [prev-raw (hash-ref rush-def-st 'l44-pre-contact-stack-start #f)]
                      [prev-start (and (exact-integer? prev-raw)
                                       (>= frame prev-raw)
                                       (<= (- frame prev-raw) 180)
                                       prev-raw)]
                      [in-window? (and prev-start (<= (- frame prev-start) 4))]
                      [already-spent? (and prev-start (> (- frame prev-start) 4))]
                      [def-spread
                       (if (or in-window? already-spent?)
                           0.0
                           (let* ([dn (exact->inexact (length frontline-first))]
                                  [dcx (/ (for/sum ([w (in-list frontline-first)])
                                            (exact->inexact (hash-ref w 'x base-x)))
                                          dn)]
                                  [dcy (/ (for/sum ([w (in-list frontline-first)])
                                            (exact->inexact (hash-ref w 'y base-y)))
                                          dn)])
                             (for/fold ([ms 0.0]) ([w (in-list frontline-first)])
                               (max ms (dist2d dcx dcy
                                               (exact->inexact (hash-ref w 'x base-x))
                                               (exact->inexact (hash-ref w 'y base-y)))))))])
                 (and (> min-ew-d (if in-window? 2.5 5.0))
                      (<= min-ew-d 8.5)
                      (not already-spent?)
                      (or in-window? (> def-spread 3.2))
                      (let ([valid-mps (filter (lambda (mp) (> (safe-nonneg-int (hash-ref mp 'id 0) 0) 0))
                                               base-mineral-patches)])
                        (and (pair? valid-mps)
                             (begin
                               (unless prev-start
                                 (hash-set! rush-def-st 'l44-pre-contact-stack-start frame))
                               (argmin (lambda (mp)
                                         (dist2d cl-x cl-y
                                                 (exact->inexact (hash-ref mp 'x base-x))
                                                 (exact->inexact (hash-ref mp 'y base-y))))
                                       valid-mps))))))))
        ;; L43-P0-1d (`r02`/`r05`/`r06`): Fully suppress `use-converge-drill?` (`3666`) under
        ;; `heavy-pure-worker-allin-12plus?` so `r05` Dummy never burns 41 ticks on `3666` drill!
        (define use-converge-drill?
          (and (not l44-pre-contact-stack-mp)
               (not heavy-pure-worker-allin-12plus?)
               (pair? drill-converge-wids)
               (or stacked-enemy-inside-minerals?
                   (>= (length drill-converge-wids) 2))))
        (cond
          [l44-pre-contact-stack-mp
           (define smp-id (safe-nonneg-int (hash-ref l44-pre-contact-stack-mp 'id 0) 0))
           (define smp-x (safe-coord (hash-ref l44-pre-contact-stack-mp 'x base-x) base-x))
           (define smp-y (safe-coord (hash-ref l44-pre-contact-stack-mp 'y base-y) base-y))
           (set-l2-ctx-worker-pull-emitted-1ab?! ctx #t)
           (for ([w (in-list frontline-first)])
             (define wid (hash-ref w 'id 10))
             (when (and (exact-integer? wid) (> wid 0))
               (l2-emit! ctx (list 'mineral-walk wid smp-id smp-x smp-y))))]
          [else
        (define converge-drill-set
          (if use-converge-drill? (list->seteqv drill-converge-wids) (seteqv)))
        (when use-converge-drill?
          (l2-emit! ctx (list 'worker-drill-stack-attack
                              drill-converge-wids
                              drill-patch-id
                              (if (and (exact-integer? primary-focus-id) (>= primary-focus-id 0))
                                  primary-focus-id
                                  0)
                              focus-amove-x
                              focus-amove-y)))
        ;; Emit grouped pull-workers-attack commands (unit-targeted groups + Attack-Move group)
        (define target-order '())
        (define target-groups (make-hasheqv))
        (define target-coords (make-hasheqv))
        (for ([w (in-list frontline-first)])
          (define wid (hash-ref w 'id 10))
          (unless (set-member? converge-drill-set wid)
            (define asgn (hash-ref worker-assignments wid #f))
            (when asgn
              (match-define (list tid tx ty) asgn)
              (unless (hash-has-key? target-groups tid)
                (set! target-order (cons tid target-order))
                (hash-set! target-coords tid (cons tx ty)))
              (hash-set! target-groups tid (cons wid (hash-ref target-groups tid '()))))))
        (set-l2-ctx-worker-pull-emitted-1ab?! ctx #t)
        (for ([tid (in-list (reverse target-order))])
          (define wids (reverse (hash-ref target-groups tid '())))
          (define tc (hash-ref target-coords tid (cons focus-amove-x focus-amove-y)))
          (unless (null? wids)
            (l2-emit! ctx (list 'pull-workers-attack wids tid (car tc) (cdr tc)))))])
        (define all-pulled-wids
          (filter positive? (map (lambda (w) (hash-ref w 'id 0)) frontline-first)))
        (define close-drill-wids
          (for/list ([w (in-list frontline-first)]
                     #:when (let ([wid (hash-ref w 'id 0)]
                                  [wx (hash-ref w 'x base-x)]
                                  [wy (hash-ref w 'y base-y)])
                              (and (> wid 0)
                                   (or (<= (dist2d wx wy focus-amove-x focus-amove-y) 2.0)
                                       (<= (dist-to-nearest-engage-enemy wx wy) 2.0)))))
            (hash-ref w 'id 0)))
        (when (and (not heavy-pure-worker-allin?)
                   (not use-converge-drill?)
                   stacked-enemy-inside-minerals?
                   (not (null? all-pulled-wids))
                   (not (null? close-drill-wids))
                   (exact-integer? drill-patch-id)
                   (> drill-patch-id 0))
          (l2-emit! ctx (list 'worker-drill-stack-attack
                       close-drill-wids
                       drill-patch-id
                       (if (and (exact-integer? primary-focus-id) (>= primary-focus-id 0))
                           primary-focus-id
                           0)
                       focus-amove-x
                       focus-amove-y))))

      ;; L48-W2 (Zero-Trickle `< 6` Zergling Perimeter Hold + Marine Ranged-Kite Exclusion):
      ;; - Hold `< 6` Zerglings tightly inside main/natural defensive perimeter behind Hatchery
      ;;   whenever facing `>= 6` pure enemy workers or a kiting worker rush (unless a ready Spine
      ;;   Crawler is actively covering Probes inside `<= 7.0t` of TownHall) so Zerg NEVER trickles
      ;;   `2`-by-`2` up the ramp into 14 stacked kiting Probes (`r14` / `#5140006`)!
      ;; - Exclude `marine` from static melee `attack-unit` so L3/L4 `5.0`-range kiting shreds Probes!
      ;; - Never chase `fleeing-away?` workers outside `<= 1.6t`!
      (when worker-rush-active?
        (define ol-early (l2-ctx-oledger-early ctx))
        (define all-ally-combat (or (l2-ctx-ally-combat-units ctx) '()))
        (define home-combat-units
          (filter (lambda (cu)
                    (and (hash? cu)
                         (> (hash-ref cu 'id 0) 0)
                         (<= (dist2d (hash-ref cu 'x base-x) (hash-ref cu 'y base-y) base-x base-y) 14.0)))
                  all-ally-combat))
        (define all-ally-lings
          (filter (lambda (cu) (and (hash? cu) (eq? (fast-canonical-unit-sym (unit-type-sym cu)) 'zergling)))
                  all-ally-combat))
        (define all-ally-zealots
          (filter (lambda (cu) (and (hash? cu) (eq? (fast-canonical-unit-sym (unit-type-sym cu)) 'zealot)))
                  all-ally-combat))
        (define has-ready-spine?
          (ormap (lambda (b)
                   (and (hash? b)
                        (eq? (fast-canonical-structure-sym (unit-type-sym b)) 'spine-crawler)
                        (>= (hash-ref b 'build-progress 1.0) SC2-BUILD-COMPLETE-PROGRESS)))
                 ally-bldgs))
        (define spine-covering-in-main?
          (and has-ready-spine?
               (ormap (lambda (ew)
                        (<= (dist-to-owned-townhall (hash-ref ew 'x 9999.0)
                                                    (hash-ref ew 'y 9999.0))
                            7.0))
                      worker-rush-engage-enemies)))
        (define hold-lings-now?
          (and (eq? race 'Zerg)
               pure-worker-rush-now?
               (or (>= eff-e-cnt 6) enemy-kiting-rush-detected?)
               (pair? all-ally-lings)
               (< (length all-ally-lings) 6)
               (not spine-covering-in-main?)))
        ;; L48-W3 (`r16` Protoss Pocket Zealot #1 Leash): While `< 2` Zealots exist during a
        ;; pure `>= 6`-worker / kiting rush, leash Zealot #1 tightly inside the mineral-line
        ;; pocket (`<= 6.5t` of Nexus, attacking closest Probe `<= 2.5t`) to guard pinned miners
        ;; until `>= 2` Chrono'd Zealots accumulate and sweep!
        (define hold-solo-zealot-in-pocket?
          (and (eq? race 'Protoss)
               pure-worker-rush-now?
               (or (>= eff-e-cnt 6) enemy-kiting-rush-detected?)
               (pair? all-ally-zealots)
               (< (length all-ally-zealots) 2)))
        (define-values (zlt-pock-x zlt-pock-y)
          (let* ([pdx (- far-px (exact->inexact base-x))]
                 [pdy (- far-py (exact->inexact base-y))]
                 [pd (max 1.0 (sqrt (+ (* pdx pdx) (* pdy pdy))))])
            (values (safe-coord (+ (exact->inexact base-x) (* (min 3.5 pd) (/ pdx pd))) far-px)
                    (safe-coord (+ (exact->inexact base-y) (* (min 3.5 pd) (/ pdy pd))) far-py))))
        (when hold-lings-now?
          (hash-set! rush-def-st 'ling-hold-until (+ frame 24))
          (hash-set! rush-def-st 'ling-hold-pt (cons far-px far-py)))
        (when hold-solo-zealot-in-pocket?
          (hash-set! rush-def-st 'zealot-pocket-until (+ frame 24))
          (hash-set! rush-def-st 'zealot-pocket-pt (cons zlt-pock-x zlt-pock-y)))
        (for ([cu (in-list home-combat-units)])
          (define cid (hash-ref cu 'id 0))
          (define csym (fast-canonical-unit-sym (unit-type-sym cu)))
          (define cx (exact->inexact (hash-ref cu 'x base-x)))
          (define cy (exact->inexact (hash-ref cu 'y base-y)))
          (cond
            [(and hold-lings-now? (eq? csym 'zergling))
             ;; L48-W3c: `< 6` Zerglings DEFEND against any enemy rush worker inside `<= 7.5t` of
             ;; TownHall (fighting alongside Drones instead of moving away!) and ONLY hold at
             ;; `(far-px, far-py)` when Probes kite outside `> 7.5t` toward the ramp!
             (define in-main-probes
               (filter (lambda (ew)
                         (define ex (exact->inexact (hash-ref ew 'x cl-x)))
                         (define ey (exact->inexact (hash-ref ew 'y cl-y)))
                         (and (> (hash-ref ew 'id 0) 0)
                              (<= (dist-to-owned-townhall ex ey) 7.5)))
                       worker-rush-engage-enemies))
             (cond
               [(pair? in-main-probes)
                (define tgt (argmin (lambda (ew) (dist2d cx cy (hash-ref ew 'x cl-x) (hash-ref ew 'y cl-y)))
                                    in-main-probes))
                (define tid (hash-ref tgt 'id 0))
                (l2-emit! ctx (list 'attack-unit cid tid))
                (when ol-early
                  (order-ledger-record-issued! ol-early cid 'attack-unit 'worker-rush-focus
                                               #:target-id tid
                                               #:target-x (safe-coord (hash-ref tgt 'x far-px) far-px)
                                               #:target-y (safe-coord (hash-ref tgt 'y far-py) far-py)
                                               #:frame frame))]
               [else
                (l2-emit! ctx (list 'move cid far-px far-py))])]
            [(and hold-solo-zealot-in-pocket? (eq? csym 'zealot))
             ;; L49-W1: Guard the ENTIRE mineral-line pocket (`<= 7.5t` of Nexus) so Zealot #1
             ;; actively defends pinned Probes across the whole line until Chrono'd Zealot #2 pops!
             (define near-pocket-probes
               (filter (lambda (ew)
                         (define ex (exact->inexact (hash-ref ew 'x cl-x)))
                         (define ey (exact->inexact (hash-ref ew 'y cl-y)))
                         (and (> (hash-ref ew 'id 0) 0)
                              (<= (dist-to-owned-townhall ex ey) 7.5)))
                       worker-rush-engage-enemies))
             (cond
               [(pair? near-pocket-probes)
                (define tgt (argmin (lambda (ew) (dist2d cx cy (hash-ref ew 'x cl-x) (hash-ref ew 'y cl-y)))
                                    near-pocket-probes))
                (define tid (hash-ref tgt 'id 0))
                (l2-emit! ctx (list 'attack-unit cid tid))
                (when ol-early
                  (order-ledger-record-issued! ol-early cid 'attack-unit 'worker-rush-focus
                                               #:target-id tid
                                               #:target-x (safe-coord (hash-ref tgt 'x zlt-pock-x) zlt-pock-x)
                                               #:target-y (safe-coord (hash-ref tgt 'y zlt-pock-y) zlt-pock-y)
                                               #:frame frame))]
               [else
                (l2-emit! ctx (list 'move cid zlt-pock-x zlt-pock-y))])]
            [(memq csym '(zergling zealot reaper adept))
             (define non-flee-tgt
               (or (and lowest-ehp-enemy
                        (or (eq? csym 'zergling)
                            (not (ew-fleeing-away? lowest-ehp-enemy))
                            (<= (dist2d cx cy (hash-ref lowest-ehp-enemy 'x cl-x) (hash-ref lowest-ehp-enemy 'y cl-y)) 1.6))
                        lowest-ehp-enemy)
                   (let ([avail (filter (lambda (ew)
                                          (and (> (hash-ref ew 'id 0) 0)
                                               (or (eq? csym 'zergling)
                                                   (not (ew-fleeing-away? ew))
                                                   (<= (dist2d cx cy (hash-ref ew 'x cl-x) (hash-ref ew 'y cl-y)) 1.6))))
                                        worker-rush-engage-enemies)])
                     (and (pair? avail)
                          (argmin (lambda (ew) (dist2d cx cy (hash-ref ew 'x cl-x) (hash-ref ew 'y cl-y))) avail)))))
             (cond
               [non-flee-tgt
                (define tid (hash-ref non-flee-tgt 'id 0))
                (l2-emit! ctx (list 'attack-unit cid tid))
                (when ol-early
                  (order-ledger-record-issued! ol-early cid 'attack-unit 'worker-rush-focus
                                               #:target-id tid
                                               #:target-x (safe-coord (hash-ref non-flee-tgt 'x focus-amove-x) focus-amove-x)
                                               #:target-y (safe-coord (hash-ref non-flee-tgt 'y focus-amove-y) focus-amove-y)
                                               #:frame frame))]
               [else
                (l2-emit! ctx (list 'attack-pos cid pocket-amove-x pocket-amove-y))])]))))

    ;; L48-W2 + L48-W3 (`r14` Ramp-Kite Ling Perimeter Hold & `r16` Solo Zealot Pocket Guard):
    ;; Even when enemy kiting Probes step outside `rush-chase-leash-rad` (`worker-rush-engage-enemies = '()`),
    ;; STILL latch `ling-hold-until` (Zerg `< 6` Lings) and `zealot-pocket-until` (Protoss `< 2` Zealots)
    ;; so neither unit trickles up the ramp into 14-15 stacked kiting Probes!
    (when (and (eq? race 'Zerg)
               (null? worker-rush-engage-enemies)
               pure-worker-rush-now?
               (or worker-rush-active? enemy-kiting-rush-detected?)
               (or (>= (length enemy-rush-workers) 6) enemy-kiting-rush-detected?))
      (define all-ally-lings-outer
        (filter (lambda (cu)
                  (and (hash? cu)
                       (> (hash-ref cu 'id 0) 0)
                       (eq? (fast-canonical-unit-sym (unit-type-sym cu)) 'zergling)))
                (or (l2-ctx-ally-combat-units ctx) '())))
      (when (and (pair? all-ally-lings-outer)
                 (< (length all-ally-lings-outer) 6))
        (hash-set! rush-def-st 'ling-hold-until (+ frame 24))
        (hash-set! rush-def-st 'ling-hold-pt (cons far-px far-py))
        (for ([cu (in-list all-ally-lings-outer)])
          (l2-emit! ctx (list 'move (hash-ref cu 'id 0) far-px far-py)))))
    (when (and (eq? race 'Protoss)
               (null? worker-rush-engage-enemies)
               pure-worker-rush-now?
               (or worker-rush-active? enemy-kiting-rush-detected?)
               (or (>= (length enemy-rush-workers) 6) enemy-kiting-rush-detected?))
      (define all-ally-zealots-outer
        (filter (lambda (cu)
                  (and (hash? cu)
                       (> (hash-ref cu 'id 0) 0)
                       (eq? (fast-canonical-unit-sym (unit-type-sym cu)) 'zealot)))
                (or (l2-ctx-ally-combat-units ctx) '())))
      (when (and (pair? all-ally-zealots-outer)
                 (< (length all-ally-zealots-outer) 2))
        (define-values (zpx zpy)
          (let* ([pdx (- far-px (exact->inexact base-x))]
                 [pdy (- far-py (exact->inexact base-y))]
                 [pd (max 1.0 (sqrt (+ (* pdx pdx) (* pdy pdy))))])
            (values (safe-coord (+ (exact->inexact base-x) (* (min 3.5 pd) (/ pdx pd))) far-px)
                    (safe-coord (+ (exact->inexact base-y) (* (min 3.5 pd) (/ pdy pd))) far-py))))
        (hash-set! rush-def-st 'zealot-pocket-until (+ frame 24))
        (hash-set! rush-def-st 'zealot-pocket-pt (cons zpx zpy))
        (for ([cu (in-list all-ally-zealots-outer)])
          (l2-emit! ctx (list 'move (hash-ref cu 'id 0) zpx zpy)))))

    ;; During the 14-frame hysteresis window, keep previously-pulled defenders (within leash and not disengaging)
    ;; from immediately snapping back to mining if enemy workers momentarily kite outside `rush-chase-leash-rad`.
    (when (and (null? worker-rush-engage-enemies)
               in-engage-hysteresis?)
      (set-l2-ctx-cur-rush-fighting-wids! ctx
            (for/list ([w (in-list non-builder-defense-workers)]
                       #:when (let ([wid (hash-ref w 'id 10)])
                                (and (memv wid prev-rush-fighting-wids)
                                     (not (memv wid (l2-ctx-cur-rush-disengaging-wids ctx)))
                                     (<= (dist-to-owned-townhall
                                          (hash-ref w 'x base-x)
                                          (hash-ref w 'y base-y))
                                         rush-chase-leash-rad))))
              (hash-ref w 'id 10))))

    ;; Snap back to mining any previously-pulled worker (or worker outside `rush-chase-leash-rad`)
    ;; once hysteresis expires or that worker is assigned to keep mining!
    (for ([w (in-list non-builder-defense-workers)])
      (define wid (hash-ref w 'id 10))
      (define wx (hash-ref w 'x base-x))
      (define wy (hash-ref w 'y base-y))
      (define lh-def-wids-2 (hash-ref rush-def-st 'light-harass-def-wids '()))
      (define br-def-wids-2 (hash-ref rush-def-st 'breach-def-wids '()))
      (when (and (not (memv wid (l2-ctx-cur-rush-fighting-wids ctx)))
                 (not (memv wid (l2-ctx-cur-rush-disengaging-wids ctx)))
                 (not (memv wid lh-def-wids-2))
                 (not (memv wid br-def-wids-2))
                 (or (memv wid prev-rush-fighting-wids)
                     (and worker-rush-active?
                          (> (dist-to-owned-townhall wx wy) rush-chase-leash-rad)
                          (> (dist-to-mineral-line wx wy) 2.5)
                          (not (and protected-bldg-under-attack?
                                    (near-protected-rush-bldg? wx wy 5.5))))))
        (if (> far-patch-id 0)
            (l2-emit! ctx (list 'harvest-mineral wid far-patch-id))
            (l2-emit! ctx (list 'mineral-walk wid far-px far-py)))))))

(define (l2-phase3-recall-cancel-scout! ctx)
  (define ally-bldgs (l2-ctx-ally-bldgs ctx))
  (define ally-combat-supply-early (l2-ctx-ally-combat-supply-early ctx))
  (define ally-combat-units (l2-ctx-ally-combat-units ctx))
  (define ally-units (l2-ctx-ally-units ctx))
  (define base-x (l2-ctx-base-x ctx))
  (define base-y (l2-ctx-base-y ctx))
  (define cd-tracker (l2-ctx-cd-tracker ctx))
  (define cheese-dist-thresh (l2-ctx-cheese-dist-thresh ctx))
  (define enemy-bldgs (l2-ctx-enemy-bldgs ctx))
  (define enemy-rush-workers (l2-ctx-enemy-rush-workers ctx))
  (define enemy-units (l2-ctx-enemy-units ctx))
  (define enemy-x (l2-ctx-enemy-x ctx))
  (define enemy-y (l2-ctx-enemy-y ctx))
  (define frame (l2-ctx-frame ctx))
  (define ground-enemy-units-for-cheese (l2-ctx-ground-enemy-units-for-cheese ctx))
  (define in-base-proxy-completed-cannon? (l2-ctx-in-base-proxy-completed-cannon? ctx))
  (define in-base-proxy-completed-cannons (l2-ctx-in-base-proxy-completed-cannons ctx))
  (define in-base-proxy-detected? (l2-ctx-in-base-proxy-detected? ctx))
  (define in-base-proxy-structures (l2-ctx-in-base-proxy-structures ctx))
  (define leases (l2-ctx-leases ctx))
  (define live-obs-harvesters? (l2-ctx-live-obs-harvesters? ctx))
  (define nat-x (l2-ctx-nat-x ctx))
  (define nat-y (l2-ctx-nat-y ctx))
  (define non-builder-defense-workers (l2-ctx-non-builder-defense-workers ctx))
  (define obs (l2-ctx-obs ctx))
  (define oledger-early (l2-ctx-oledger-early ctx))
  (define owned-base-coords (l2-ctx-owned-base-coords ctx))
  (define proxy-or-cheese-enemies (l2-ctx-proxy-or-cheese-enemies ctx))
  (define race (l2-ctx-race ctx))
  (define raw-obs (l2-ctx-raw-obs ctx))
  (define rt (l2-ctx-rt ctx))
  (define rush-def-st (l2-ctx-rush-def-st ctx))
  (define under-early-cheese? (l2-ctx-under-early-cheese? ctx))
  (define worker-rush-active? (l2-ctx-worker-rush-active? ctx))
  (define workers (l2-ctx-workers ctx))
  (when in-base-proxy-detected?
    ;; L47-P0-1b (`#59` Creepy `canon_rush`): Immediately clear any stale light-harass defender list
    ;; so `in-base-proxy-detected?` strictly preempts `light-worker-scout-harass-active?` and NEVER
    ;; overwrites proxy-pylon `pull-workers-attack` with `(harvest-mineral ...)` below!
    (hash-set! rush-def-st 'light-harass-def-wids '()))
  (when (and in-base-proxy-detected?
             (not worker-rush-active?)
             (not (null? non-builder-defense-workers)))
    (define completed-powered-cannons (length in-base-proxy-completed-cannons))
    ;; Disengage critically wounded proxy-fighting workers (<= 12 HP) every step
    (define base-mps
      (filter (lambda (mp)
                (and (hash? mp)
                     (<= (dist2d base-x base-y (hash-ref mp 'x base-x) (hash-ref mp 'y base-y)) 14.0)))
              (let ([mps (hash-ref obs 'mineral-patches '())])
                (if (list? mps) mps '()))))
    (define safe-mp (and (not (null? base-mps)) (car base-mps)))
    (for ([w (in-list non-builder-defense-workers)])
      (define wid (hash-ref w 'id 10))
      (define whp (unit-total-hp-and-shield w))
      (when (and (<= whp SC2-FIGHTING-WORKER-DISENGAGE-HP)
                 (ormap (lambda (e)
                          (<= (dist2d (hash-ref w 'x base-x) (hash-ref w 'y base-y)
                                      (hash-ref e 'x 9999.0) (hash-ref e 'y 9999.0))
                              7.5))
                        (append ground-enemy-units-for-cheese in-base-proxy-structures)))
        (if safe-mp
            (l2-emit! ctx (list 'mineral-walk wid
                         (safe-nonneg-int (hash-ref safe-mp 'id 0) 0)
                         (safe-coord (hash-ref safe-mp 'x base-x) base-x)
                         (safe-coord (hash-ref safe-mp 'y base-y) base-y)))
            (l2-emit! ctx (list 'mineral-walk wid base-x base-y)))))
    ;; L52-2D (`#59 TvP Creepy` walled-in proxy cannon): Never melee-pull workers into ANY
    ;; completed active Photon Cannon (`build-progress >= 1.0`, `powered? != #f`) or any structure
    ;; inside `<= 7.8t` of a completed Cannon! If a warping Cannon is walled in by `>= 2` enemy
    ;; Pylons within `3.5t` (or takes `0` effective damage for `48f` while workers pull on it),
    ;; immediately retarget pulled workers onto the nearest/lowest-HP blocking Pylon!
    (define active-completed-cannons
      (filter (lambda (eb)
                (and (eq? (fast-canonical-structure-sym (unit-type-sym eb)) 'photon-cannon)
                     (or live-obs-harvesters? (l2-raw-eb-explicit-build-progress? ctx eb))
                     (>= (hash-ref eb 'build-progress 1.0) SC2-BUILD-COMPLETE-PROGRESS)
                     (not (eq? (hash-ref eb 'powered? #t) #f))))
              in-base-proxy-structures))
    (define all-completed-cannons
      (if (pair? active-completed-cannons) active-completed-cannons in-base-proxy-completed-cannons))
    (define pullable-proxy-structures
      (filter (lambda (eb)
                (define canon (fast-canonical-structure-sym (unit-type-sym eb)))
                (define prog (hash-ref eb 'build-progress 1.0))
                (define ebx (hash-ref eb 'x 9999.0))
                (define eby (hash-ref eb 'y 9999.0))
                (define is-completed-cannon?
                  (and (eq? canon 'photon-cannon)
                       (or live-obs-harvesters? (l2-raw-eb-explicit-build-progress? ctx eb))
                       (>= prog SC2-BUILD-COMPLETE-PROGRESS)
                       (not (eq? (hash-ref eb 'powered? #t) #f))))
                (and (not is-completed-cannon?)
                     (or (null? all-completed-cannons)
                         (and (or (eq? canon 'pylon)
                                  (and (eq? canon 'photon-cannon)
                                       (< prog SC2-BUILD-COMPLETE-PROGRESS)))
                              (<= (dist2d base-x base-y ebx eby) 22.0)
                              (andmap (lambda (cc)
                                        (> (dist2d ebx eby
                                                   (hash-ref cc 'x 9999.0)
                                                   (hash-ref cc 'y 9999.0))
                                           7.8))
                                      all-completed-cannons)))))
              in-base-proxy-structures))
    ;; If ONLY completed Cannons remain (no pullable proxy structures), return any previously-pulled
    ;; proxy workers safely back to mining / out of Cannon range instead of feeding into active fire!
    (when (null? pullable-proxy-structures)
      (define stale-proxy-wids
        (let ([pw (hash-ref rush-def-st 'proxy-def-wids '())])
          (if (list? pw) pw '())))
      (when (pair? stale-proxy-wids)
        (define safe-mp-id-ret (and safe-mp (safe-nonneg-int (hash-ref safe-mp 'id 0) 0)))
        (for ([w (in-list non-builder-defense-workers)])
          (define wid (hash-ref w 'id 10))
          (when (or (memv wid stale-proxy-wids)
                    (and (= (hash-ref w 'order-ability-id 0) 23)
                         (ormap (lambda (cc)
                                  (<= (dist2d (hash-ref w 'x base-x) (hash-ref w 'y base-y)
                                              (hash-ref cc 'x 9999.0) (hash-ref cc 'y 9999.0))
                                      9.0))
                                all-completed-cannons)))
            (if (and safe-mp-id-ret (> safe-mp-id-ret 0))
                (l2-emit! ctx (list 'harvest-mineral wid safe-mp-id-ret))
                (l2-emit! ctx (list 'mineral-walk wid base-x base-y)))))
        (hash-set! rush-def-st 'proxy-def-wids '())))
    (when (not (null? pullable-proxy-structures))
      (define healthy-proxy-workers
        (filter (lambda (w) (> (unit-total-hp-and-shield w) SC2-FIGHTING-WORKER-DISENGAGE-HP))
                non-builder-defense-workers))
      ;; L51-2C (`#50 TvP Thssprtssbt` Cannon-Rush SCV Over-Pull): Exclude active gas harvesters
      ;; from our mineral-mining floor count and ALWAYS reserve `>= 6` non-gas mineral harvesters
      ;; (recalling excess attackers if mining workers ever dip below `6`), while keeping sticky
      ;; proxy defenders pinned so Barracks never freezes at `5..10M` (`#59` preserved!).
      (define owned-gas-ids
        (for/seteqv ([b (in-list (or (l2-ctx-ally-bldgs ctx) '()))]
                     #:when (and (hash? b)
                                 (memq (fast-canonical-structure-sym (unit-type-sym b))
                                       '(refinery assimilator extractor))))
          (hash-ref b 'id -1)))
      (define (worker-on-gas? w)
        (and (not (set-empty? owned-gas-ids))
             (or (set-member? owned-gas-ids (hash-ref w 'order-target-id -2))
                 (eq? (hash-ref w 'order-ability-sym #f) 'harvest-gather-gas)
                 (eq? (hash-ref w 'carrying-vespene? #f) #t))))
      (define non-gas-healthy-workers
        (if live-obs-harvesters?
            (filter (lambda (w) (not (worker-on-gas? w))) healthy-proxy-workers)
            healthy-proxy-workers))
      (define prev-proxy-wids
        (let ([pw (hash-ref rush-def-st 'proxy-def-wids '())])
          (if (list? pw) pw '())))
      (define in-main-cannon-rush-now?
        (or (ormap (lambda (eb)
                     (and (eq? (fast-canonical-structure-sym (unit-type-sym eb)) 'photon-cannon)
                          (< (hash-ref eb 'build-progress 1.0) SC2-BUILD-COMPLETE-PROGRESS)
                          (<= (dist2d base-x base-y (hash-ref eb 'x 9999.0) (hash-ref eb 'y 9999.0)) 22.0)))
                   pullable-proxy-structures)
            (>= (count (lambda (eb)
                         (and (memq (fast-canonical-structure-sym (unit-type-sym eb)) '(pylon photon-cannon))
                              (<= (dist2d base-x base-y (hash-ref eb 'x 9999.0) (hash-ref eb 'y 9999.0)) 22.0)))
                       pullable-proxy-structures)
                2)))
      ;; Strictly keep `>= 6` mineral workers mining during cannon/proxy defense (`>= 8` on lone
      ;; proxy Pylons when `>= 14` workers), preserving `6` SCVs on warping Cannons + `4` on Pylons!
      (define min-mining-floor
        (cond
          [(and live-obs-harvesters? in-main-cannon-rush-now?) 6]
          [(and live-obs-harvesters? (>= (length non-gas-healthy-workers) 14)) 8]
          [live-obs-harvesters? 6]
          [else 4]))
      (define safe-mp-x (if safe-mp (hash-ref safe-mp 'x base-x) base-x))
      (define safe-mp-y (if safe-mp (hash-ref safe-mp 'y base-y) base-y))
      (define safe-mp-id (and safe-mp (safe-nonneg-int (hash-ref safe-mp 'id 0) 0)))
      (define sorted-for-mining
        (sort non-gas-healthy-workers
              <
              #:key (lambda (w)
                      (define wid (hash-ref w 'id 10))
                      (define attacking?
                        (or (= (hash-ref w 'order-ability-id 0) 23)
                            (and (memv wid prev-proxy-wids) #t)))
                      (+ (if attacking? 100.0 0.0)
                         (dist2d safe-mp-x safe-mp-y (hash-ref w 'x base-x) (hash-ref w 'y base-y))))))
      (define reserve-n (min min-mining-floor (length sorted-for-mining)))
      (define pinned-miners (take sorted-for-mining reserve-n))
      (define pull-candidates (drop sorted-for-mining reserve-n))
      ;; If fewer than `min-mining-floor` non-attacking miners existed, return the reserved attackers
      ;; straight to minerals so active mineral income stays `>= 6` SCVs!
      (when (and live-obs-harvesters? safe-mp-id (> safe-mp-id 0))
        (for ([mw (in-list pinned-miners)])
          (define mwid (hash-ref mw 'id 10))
          (when (or (= (hash-ref mw 'order-ability-id 0) 23)
                    (memv mwid prev-proxy-wids))
            (l2-emit! ctx (list 'harvest-mineral mwid safe-mp-id)))))
      (define surplus-cnt
        (min (if live-obs-harvesters? (if in-main-cannon-rush-now? 10 8) 99)
             (length pull-candidates)))
      (when (= surplus-cnt 0)
        (hash-set! rush-def-st 'proxy-def-wids '()))
      (when (> surplus-cnt 0)
        ;; L52-2D: Track 48-frame zero-damage stall on warping Cannons & detect >= 2-Pylon walls (<= 3.5t).
        (when (<= frame 4)
          (hash-remove! rush-def-st 'warping-cannon-dmg-track))
        (define wc-track
          (hash-ref! rush-def-st 'warping-cannon-dmg-track (lambda () (make-hasheqv))))
        (define (warping-cannon-stalled-48f? eb)
          (define cid (hash-ref eb 'id 0))
          (define prog (exact->inexact (max 0.05 (hash-ref eb 'build-progress 0.5))))
          (define ehp (exact->inexact (unit-total-hp-and-shield eb)))
          (define max-ehp (exact->inexact (+ (hash-ref eb 'max-hp 150.0) (hash-ref eb 'max-shield 150.0))))
          (define expected-full-ehp (fl* prog max-ehp))
          (define prev (hash-ref wc-track cid #f))
          (cond
            [(not (and (vector? prev) (= (vector-length prev) 2)))
             (hash-set! wc-track cid (vector frame ehp))
             #f]
            [else
             (define last-dmg-f (vector-ref prev 0))
             (define prev-ehp (vector-ref prev 1))
             (define took-dmg?
               (or (fl< ehp (fl- prev-ehp 2.0))
                   (fl< ehp (fl- expected-full-ehp 12.0))))
             (define next-dmg-f (if took-dmg? frame last-dmg-f))
             (hash-set! wc-track cid (vector next-dmg-f ehp))
             (>= (- frame next-dmg-f) 48)]))
        (define all-proxy-pylons
          (filter (lambda (eb) (eq? (fast-canonical-structure-sym (unit-type-sym eb)) 'pylon))
                  pullable-proxy-structures))
        (define walled-in-cannon-ids
          (for/seteqv ([eb (in-list pullable-proxy-structures)]
                       #:when (and (eq? (fast-canonical-structure-sym (unit-type-sym eb)) 'photon-cannon)
                                   (< (hash-ref eb 'build-progress 1.0) SC2-BUILD-COMPLETE-PROGRESS)
                                   (let ([cx (hash-ref eb 'x 9999.0)]
                                         [cy (hash-ref eb 'y 9999.0)])
                                     (or (>= (count (lambda (p)
                                                      (<= (dist2d cx cy (hash-ref p 'x 9999.0) (hash-ref p 'y 9999.0)) 3.5))
                                                    all-proxy-pylons)
                                             2)
                                         (warping-cannon-stalled-48f? eb)))))
            (hash-ref eb 'id 0)))
        (define blocking-pylon-ids
          (if (set-empty? walled-in-cannon-ids)
              (seteqv)
              (let ([walled-cannons
                     (filter (lambda (eb) (set-member? walled-in-cannon-ids (hash-ref eb 'id 0)))
                             pullable-proxy-structures)])
                (define tight-ids
                  (for/seteqv ([p (in-list all-proxy-pylons)]
                               #:when (ormap (lambda (wc)
                                               (<= (dist2d (hash-ref p 'x 9999.0) (hash-ref p 'y 9999.0)
                                                           (hash-ref wc 'x 9999.0) (hash-ref wc 'y 9999.0))
                                                   3.5))
                                             walled-cannons))
                    (hash-ref p 'id 0)))
                (if (not (set-empty? tight-ids))
                    tight-ids
                    (for/seteqv ([p (in-list all-proxy-pylons)]
                                 #:when (ormap (lambda (wc)
                                                 (<= (dist2d (hash-ref p 'x 9999.0) (hash-ref p 'y 9999.0)
                                                             (hash-ref wc 'x 9999.0) (hash-ref wc 'y 9999.0))
                                                     6.5))
                                               walled-cannons))
                      (hash-ref p 'id 0))))))
        (define effective-pullable-proxies
          (if (set-empty? blocking-pylon-ids)
              pullable-proxy-structures
              (let ([unwalled
                     (filter (lambda (eb)
                               (not (set-member? walled-in-cannon-ids (hash-ref eb 'id 0))))
                             pullable-proxy-structures)])
                (if (pair? unwalled) unwalled pullable-proxy-structures))))
        (define proxy-pylon-cnt
          (count (lambda (eb)
                   (eq? (fast-canonical-structure-sym (unit-type-sym eb)) 'pylon))
                 effective-pullable-proxies))
        (define has-in-main-warping-cannon?
          (ormap (lambda (eb)
                   (and (eq? (fast-canonical-structure-sym (unit-type-sym eb)) 'photon-cannon)
                        (< (hash-ref eb 'build-progress 1.0) SC2-BUILD-COMPLETE-PROGRESS)
                        (<= (dist2d base-x base-y (hash-ref eb 'x 9999.0) (hash-ref eb 'y 9999.0)) 22.0)))
                 effective-pullable-proxies))
        (define sorted-proxies
          (sort effective-pullable-proxies
                <
                #:key (lambda (eb)
                        (define ebid (hash-ref eb 'id 0))
                        (define canon (fast-canonical-structure-sym (unit-type-sym eb)))
                        (define prog (hash-ref eb 'build-progress 1.0))
                        (define blocking-pylon? (set-member? blocking-pylon-ids ebid))
                        ;; L50-W1 + L52-2D (`#59`): Focus-fire blocking corner Pylons FIRST when a
                        ;; warping Cannon is walled in; otherwise crush exposed in-main warping Cannons FIRST!
                        (define prio-rank
                          (cond
                            [blocking-pylon? -10.0]
                            [(and (memq canon '(photon-cannon bunker spine-crawler))
                                  (< prog SC2-BUILD-COMPLETE-PROGRESS)
                                  (or (>= proxy-pylon-cnt 2)
                                      (<= (dist2d base-x base-y (hash-ref eb 'x 9999.0) (hash-ref eb 'y 9999.0)) 22.0)))
                             0.0]
                            [(eq? canon 'pylon)
                             (if (or (>= proxy-pylon-cnt 2) has-in-main-warping-cannon?) 50.0 0.0)]
                            [(and (memq canon '(photon-cannon bunker spine-crawler))
                                  (< prog SC2-BUILD-COMPLETE-PROGRESS))
                             100.0]
                            [(memq canon '(forge barracks gateway shield-battery)) 200.0]
                            [else 300.0]))
                        (+ prio-rank
                           (* (if blocking-pylon? 0.25 0.1) (unit-total-hp-and-shield eb))
                           (dist2d base-x base-y
                                   (hash-ref eb 'x base-x)
                                   (hash-ref eb 'y base-y))))))
        ;; Pick workers closest to the primary proxy structure (preferring sticky already-fighting
        ;; proxy defenders first to eliminate cross-tick miner churn!)
        (define p0 (car sorted-proxies))
        (define p0x (hash-ref p0 'x base-x))
        (define p0y (hash-ref p0 'y base-y))
        (define pull-pool
          (take (sort pull-candidates
                      <
                      #:key (lambda (w)
                              (define wid (hash-ref w 'id 10))
                              (define base-d (dist2d p0x p0y (hash-ref w 'x base-x) (hash-ref w 'y base-y)))
                              (if (memv wid prev-proxy-wids) (- base-d 100.0) base-d)))
                surplus-cnt))
        (hash-set! rush-def-st 'proxy-def-wids (map (lambda (w) (hash-ref w 'id 10)) pull-pool))
        (let assign-loop ([rem-workers pull-pool]
                          [rem-proxies sorted-proxies])
          (cond
            [(or (null? rem-workers) (null? rem-proxies))
             ;; Any leftover surplus worker chases visible enemy proxy builder Probe/SCV
             (define proxy-builder
               (findf (lambda (e)
                        (and (memq (unit-type-sym e) '(probe scv drone))
                             (or (<= (dist2d base-x base-y (hash-ref e 'x 9999.0) (hash-ref e 'y 9999.0))
                                     SC2-IN-BASE-PROXY-DETECT-RADIUS)
                                 (<= (dist2d nat-x nat-y (hash-ref e 'x 9999.0) (hash-ref e 'y 9999.0))
                                     SC2-IN-BASE-PROXY-DETECT-RADIUS))))
                      ground-enemy-units-for-cheese))
             (when (and proxy-builder (not (null? rem-workers)))
               (define hunter-wids
                 (map (lambda (w) (hash-ref w 'id 10))
                      (take rem-workers (min 2 (length rem-workers)))))
               (set-l2-ctx-worker-pull-emitted-1ab?! ctx #t)
               (set-l2-ctx-cur-rush-fighting-wids!
                ctx
                (append hunter-wids (or (l2-ctx-cur-rush-fighting-wids ctx) '())))
               (l2-emit! ctx (list 'pull-workers-attack
                            hunter-wids
                            (hash-ref proxy-builder 'id 0)
                            (safe-coord (hash-ref proxy-builder 'x p0x) base-x)
                            (safe-coord (hash-ref proxy-builder 'y p0y) base-y))))]
            [else
             (define eb (car rem-proxies))
             (define eb-high-prio?
               (or (set-member? blocking-pylon-ids (hash-ref eb 'id 0))
                   (and (eq? (fast-canonical-structure-sym (unit-type-sym eb)) 'photon-cannon)
                        (< (hash-ref eb 'build-progress 1.0) SC2-BUILD-COMPLETE-PROGRESS))))
             (define take-n (min (if eb-high-prio? 6 4) (length rem-workers)))
             (define assigned (take rem-workers take-n))
             (define assigned-ids (map (lambda (w) (hash-ref w 'id 10)) assigned))
             (set-l2-ctx-worker-pull-emitted-1ab?! ctx #t)
             (set-l2-ctx-cur-rush-fighting-wids!
              ctx
              (append assigned-ids (or (l2-ctx-cur-rush-fighting-wids ctx) '())))
             (l2-emit! ctx (list 'pull-workers-attack
                          assigned-ids
                          (hash-ref eb 'id 0)
                          (safe-coord (hash-ref eb 'x base-x) base-x)
                          (safe-coord (hash-ref eb 'y base-y) base-y)))
             (assign-loop (drop rem-workers take-n) (cdr rem-proxies))])))))
  ;; W5-EARLY-1 / W18-P0-1-rt (`#8/#34/#35/#36` <3:30 12-Pool Zergling rushes):
  ;; Pull closest healthy workers proportionally when >= 4 enemy melee rushers (Zerglings/Zealots)
  ;; breach ANY owned ready TownHall (main or natural, <= 14.5t, or <= 16.5t of main base) before
  ;; 4:00 (`< 5400f`) while outnumbered, with crisp 12f re-focus cadence + combat co-focus (`0%` OBRet)!
  (define ready-th-coords-eb
    (let ([pts (for/list ([b (in-list ally-bldgs)]
                          #:when (and (hash? b)
                                      (>= (hash-ref b 'build-progress 1.0) SC2-BUILD-COMPLETE-PROGRESS)
                                      (memq (fast-canonical-structure-sym (unit-type-sym b))
                                            '(hatchery lair hive nexus
                                              command-center orbital-command planetary-fortress))))
                 (cons (exact->inexact (hash-ref b 'x base-x))
                       (exact->inexact (hash-ref b 'y base-y))))])
      (if (null? pts)
          (list (cons (exact->inexact base-x) (exact->inexact base-y)))
          pts)))
  (define early-ling-breach-enemies
    (if (and live-obs-harvesters?
             (< frame 5400)
             (not worker-rush-active?)
             (not in-base-proxy-detected?)
             (< (length ally-combat-units) 8))
        (filter (lambda (e)
                  (and (hash? e)
                       (memq (fast-canonical-unit-sym (unit-type-sym e)) '(zergling zealot))
                       (let ([ex (exact->inexact (hash-ref e 'x 9999.0))]
                             [ey (exact->inexact (hash-ref e 'y 9999.0))])
                         (or (<= (dist2d base-x base-y ex ey) 19.0)
                             (for/or ([th (in-list ready-th-coords-eb)])
                               (<= (dist2d (car th) (cdr th) ex ey) 14.5))))))
                enemy-units)
        '()))
  ;; L22-P0-3 (`#34` Visual-QA): When <3:30 (`< 4704f`) melee rushers attack inside main base
  ;; and our early defenders are outnumbered `>= 1.3x` (e.g. `4v6` Lings), pull `3–5` nearby
  ;; healthy workers (`HP+Shield >= 18`) to tip close fights cleanly into wins!
  (define early-ling-outnumbered-assist?
    (and (< frame 4704)
         (>= (length early-ling-breach-enemies) 3)
         (>= (exact->inexact (length early-ling-breach-enemies))
             (fl* 1.3 (exact->inexact (max 1 (length ally-combat-units)))))))
  ;; L26-P0-3 / L27-P0-3 + L41-P0-1d (`#34/#36` + `z12/p12` + `e04` Speedling Runby):
  ;; Any-Base Mineral-Line Worker Self-Defense Counter-Surround.
  ;; Widen TH approach detection to `17.5t` so mineral-line workers start moving BEFORE a lone
  ;; Zealot gets 360-surrounded, and LATCH `'ling-breach-latched?` once >= 4 rushers breach so
  ;; defense stays active down to the LAST remaining rusher (`>= 1`) instead of shutting off at `3 < 4`!
  (define prev-ling-breach-latched?
    (eq? (hash-ref rush-def-st 'ling-breach-latched? #f) #t))
  (define-values (main-ling-slaughter-enemies main-ling-local-ally-sup main-ling-min-ally-ehp)
    (if (and live-obs-harvesters?
             (< frame 5400)
             (not (null? workers)))
        (let* ([cand-enemies
                (filter (lambda (e)
                          (and (hash? e)
                               (memq (fast-canonical-unit-sym (unit-type-sym e))
                                     '(zergling zealot baneling adept reaper hellion))
                               (let ([ex (exact->inexact (hash-ref e 'x 9999.0))]
                                     [ey (exact->inexact (hash-ref e 'y 9999.0))])
                                 (or (<= (dist2d base-x base-y ex ey) 17.5)
                                     (for/or ([th (in-list ready-th-coords-eb)])
                                       (<= (dist2d (car th) (cdr th) ex ey) 17.5))
                                     (>= (for/sum ([w (in-list workers)]
                                                   #:when (<= (dist2d (exact->inexact (hash-ref w 'x 9999.0))
                                                                      (exact->inexact (hash-ref w 'y 9999.0))
                                                                      ex ey)
                                                              12.0))
                                           1)
                                         4)))))
                        enemy-units)]
               [cand-cnt (length cand-enemies)]
               [breach-triggered?
                (or (>= cand-cnt 4)
                    (and prev-ling-breach-latched? (>= cand-cnt 1)))])
          (if (not breach-triggered?)
              (begin
                (hash-set! rush-def-st 'ling-breach-latched? #f)
                (values '() 0.0 999.0))
              (let* ([en-n (exact->inexact cand-cnt)]
                     [ecx (/ (for/sum ([e (in-list cand-enemies)]) (exact->inexact (hash-ref e 'x base-x))) en-n)]
                     [ecy (/ (for/sum ([e (in-list cand-enemies)]) (exact->inexact (hash-ref e 'y base-y))) en-n)]
                     [enemy-near-sup
                      (for/sum ([e (in-list cand-enemies)])
                        (let ([cs (fast-canonical-unit-sym (unit-type-sym e))])
                          (if (eq? cs 'zergling)
                              0.5
                              (max 0.5 (exact->inexact (sc2-supply-cost cs))))))]
                     [local-allies
                      (filter (lambda (u)
                                (<= (dist2d (exact->inexact (hash-ref u 'x 9999.0))
                                            (exact->inexact (hash-ref u 'y 9999.0))
                                            ecx ecy)
                                    16.0))
                              ally-combat-units)]
                     [local-ally-sup
                      (for/sum ([u (in-list local-allies)])
                        (let ([cs (fast-canonical-unit-sym (unit-type-sym u))])
                          (if (eq? cs 'zergling)
                              0.5
                              (max 0.5 (exact->inexact (sc2-supply-cost cs))))))]
                     [min-ally-ehp
                      (if (null? local-allies)
                          0.0
                          (for/fold ([m +inf.0]) ([u (in-list local-allies)])
                            (min m (unit-total-hp-and-shield u))))]
                     [outnumbered?
                      (and (< local-ally-sup 12.0)
                           (or (< local-ally-sup (* 1.15 enemy-near-sup))
                               (and prev-ling-breach-latched?
                                    (or (and (< local-ally-sup 1.5) (>= cand-cnt 1))
                                        (and (<= local-ally-sup 2.5) (>= cand-cnt 3))))))])
                (hash-set! rush-def-st 'ling-breach-latched? outnumbered?)
                (if outnumbered?
                    (values cand-enemies local-ally-sup min-ally-ehp)
                    (values '() 0.0 999.0)))))
        (begin
          (hash-set! rush-def-st 'ling-breach-latched? #f)
          (values '() 0.0 999.0))))
  (define main-ling-slaughter-active?
    (pair? main-ling-slaughter-enemies))
  (define early-ling-breach?
    (or main-ling-slaughter-active?
        (>= (length early-ling-breach-enemies) 4)
        early-ling-outnumbered-assist?))
  ;; L46-P0-1b (`#72` 12-Pool Survival Cancel): When an early `>= 6`-Zergling flood invades
  ;; before `150s` (`<= 3360f`) while we still hold our main Nexus (`>= 2` total Nexuses) and
  ;; our exposed natural `Nexus #2` is incomplete (`build-progress < 0.85`) with insufficient
  ;; defending combat supply (`< 6.0`), immediately cancel `Nexus #2` (`cancel-building`, `314`)
  ;; for an instant `+300M` Zealot / Shield Battery / wall refund!
  (when (and live-obs-harvesters?
             (<= frame 3360)
             (pair? ally-bldgs)
             (pair? enemy-units))
    (define all-ally-nexuses
      (for/list ([b (in-list ally-bldgs)]
                 #:when (and (hash? b)
                             (eq? (fast-canonical-structure-sym (unit-type-sym b)) 'nexus)))
        b))
    (when (>= (length all-ally-nexuses) 2)
      (define incomp-nexuses
        (for/list ([nb (in-list all-ally-nexuses)]
                   #:when (let ([nid (hash-ref nb 'id 0)]
                                [bp (exact->inexact (hash-ref nb 'build-progress 1.0))])
                            (and (exact-integer? nid) (> nid 0) (< bp 0.85))))
          nb))
      (when (pair? incomp-nexuses)
        (define invading-lings-cnt
          (for/sum ([e (in-list enemy-units)]
                    #:when (and (hash? e)
                                (not (eq? (hash-ref e 'snapshot? #f) #t))
                                (eq? (fast-canonical-unit-sym (unit-type-sym e)) 'zergling)
                                (real? (hash-ref e 'x #f))
                                (real? (hash-ref e 'y #f))
                                (let ([ex (exact->inexact (hash-ref e 'x 9999.0))]
                                      [ey (exact->inexact (hash-ref e 'y 9999.0))])
                                  (or (<= (dist2d base-x base-y ex ey) 28.0)
                                      (for/or ([nb (in-list incomp-nexuses)])
                                        (<= (dist2d (exact->inexact (hash-ref nb 'x base-x))
                                                    (exact->inexact (hash-ref nb 'y base-y))
                                                    ex ey)
                                            24.0))))))
            1))
        (define local-def-sup
          (for/sum ([u (in-list ally-combat-units)]
                    #:when (and (hash? u)
                                (real? (hash-ref u 'x #f)) (real? (hash-ref u 'y #f))
                                (let ([ux (exact->inexact (hash-ref u 'x 9999.0))]
                                      [uy (exact->inexact (hash-ref u 'y 9999.0))])
                                  (or (<= (dist2d base-x base-y ux uy) 28.0)
                                      (for/or ([nb (in-list incomp-nexuses)])
                                        (<= (dist2d (exact->inexact (hash-ref nb 'x base-x))
                                                    (exact->inexact (hash-ref nb 'y base-y))
                                                    ux uy)
                                            22.0))))))
            (max 0.5 (exact->inexact (sc2-supply-cost (fast-canonical-unit-sym (unit-type-sym u)) 1)))))
        (when (and (>= invading-lings-cnt 6) (< local-def-sup 6.0))
          (for ([nb (in-list incomp-nexuses)])
            (define nid (hash-ref nb 'id 0))
            (when (refractory-allow-action?! cd-tracker (list 'l46-cancel-12pool-nexus nid) frame 32)
              (l2-emit! ctx (list 'cancel-building nid))))))))
  ;; L38-P0-1c (`e01` / `e03` Econ-Harass Mineral Defense Efficiency):
  ;; 1. Minimal `1-2` healthy-worker pull vs `<= 2` enemy worker harass scouts (`probe`/`scv`/`drone`)
  ;;    poking a mineral line, rotating wounded workers (`<= 18` EHP) straight back to minerals and
  ;;    keeping `10+` workers continuously mining with a crisp `10.5t` leash!
  ;; 2. Proportional `4`-worker surround vs `<= 3` enemy Adepts diving into our mineral line when
  ;;    outnumbered (`e03` 3 Adepts vs 2 Marines + 16 SCVs), keeping `>= 10` workers mining!
  (define light-worker-scout-harass-enemies
    (if (and live-obs-harvesters?
             (not worker-rush-active?)
             (not in-base-proxy-detected?)
             (null? in-base-proxy-structures)
             (not early-ling-breach?)
             (not (null? non-builder-defense-workers)))
        (let* ([near-combat?
                (ormap (lambda (e)
                         (and (hash? e)
                              (not (memq (unit-type-sym e) '(probe scv drone)))
                              (combat-unit-record? e)
                              (let ([ex (exact->inexact (hash-ref e 'x 9999.0))]
                                    [ey (exact->inexact (hash-ref e 'y 9999.0))])
                                (or (<= (dist2d base-x base-y ex ey) 14.0)
                                    (for/or ([th (in-list ready-th-coords-eb)])
                                      (<= (dist2d (car th) (cdr th) ex ey) 14.0))))))
                       ground-enemy-units-for-cheese)]
               [scouts
                (if near-combat?
                    '()
                    (filter (lambda (e)
                              (and (hash? e)
                                   (memq (unit-type-sym e) '(probe scv drone))
                                   (let ([ex (exact->inexact (hash-ref e 'x 9999.0))]
                                         [ey (exact->inexact (hash-ref e 'y 9999.0))])
                                     (or (<= (dist2d base-x base-y ex ey) 9.5)
                                         (for/or ([th (in-list ready-th-coords-eb)])
                                           (<= (dist2d (car th) (cdr th) ex ey) 9.5))
                                         (ormap (lambda (w)
                                                  (<= (dist2d (exact->inexact (hash-ref w 'x 9999.0))
                                                              (exact->inexact (hash-ref w 'y 9999.0))
                                                              ex ey)
                                                      5.5))
                                                non-builder-defense-workers)))))
                            ground-enemy-units-for-cheese))])
          (if (and (>= (length scouts) 1) (<= (length scouts) 2))
              scouts
              '()))
        '()))
  (define light-worker-scout-harass-active?
    (pair? light-worker-scout-harass-enemies))
  ;; L39-P0-1f (`e03` 3 Adepts vs 16 SCVs + 2 Marines): NEVER melee-pull workers into Adepts!
  ;; Adepts deal 22 vs Light (2-shotting 45-HP SCVs / 40-EHP Probes) with 140 EHP — pulling 4
  ;; SCVs every 4s caused `wlost=17` KO! Handle Adept mineral dives strictly via crisp distributed
  ;; mineral-walk evacuation (`<= 24` EHP / `<= 4.8t` range) below while Marines kite/fire!
  (define adept-mineral-dive-enemies '())
  (define adept-mineral-dive-active? #f)
  ;; L39-P0-1f (`e04` 6 Speedlings + 1 Zealot vs 14 Probes): Before pulling healthy workers into a
  ;; Speedling/melee mineral breach, immediately mineral-walk any wounded worker (`<= 22` EHP within
  ;; `<= 6.5t` of breaching enemies) to a distributed far safe mineral patch so wounded Probes slide
  ;; out through collision (zero clumping!), recharge shields, and resume mining instead of dying!
  (when (and live-obs-harvesters?
             (or main-ling-slaughter-active? early-ling-breach?)
             (not worker-rush-active?)
             (not in-base-proxy-detected?)
             (not (null? non-builder-defense-workers)))
    (define breach-threats
      (if main-ling-slaughter-active? main-ling-slaughter-enemies early-ling-breach-enemies))
    (when (pair? breach-threats)
      (define br-mps
        (filter (lambda (mp)
                  (and (hash? mp)
                       (> (hash-ref mp 'id 0) 0)
                       (for/or ([th (in-list ready-th-coords-eb)])
                         (<= (dist2d (car th) (cdr th)
                                     (exact->inexact (hash-ref mp 'x 9999.0))
                                     (exact->inexact (hash-ref mp 'y 9999.0)))
                             14.5))))
                (let ([mps (hash-ref obs 'mineral-patches '())]) (if (list? mps) mps '()))))
      (define br-far-mps
        (if (pair? br-mps)
            (let* ([scored
                    (sort (map (lambda (mp)
                                 (define mpx (exact->inexact (hash-ref mp 'x base-x)))
                                 (define mpy (exact->inexact (hash-ref mp 'y base-y)))
                                 (define md
                                   (for/fold ([m +inf.0]) ([e (in-list breach-threats)])
                                     (min m (dist2d mpx mpy
                                                    (exact->inexact (hash-ref e 'x 9999.0))
                                                    (exact->inexact (hash-ref e 'y 9999.0))))))
                                 (cons md mp))
                               br-mps)
                          >
                          #:key car)]
                   [safe-far (filter (lambda (p) (>= (car p) 4.0)) scored)]
                   [pool (if (pair? safe-far) safe-far scored)])
              (map cdr (take pool (min 3 (length pool)))))
            '()))
      (define n-far (length br-far-mps))
      (for ([w (in-list non-builder-defense-workers)])
        (define wid (hash-ref w 'id 0))
        (when (and (> wid 0)
                   (not (memv wid (or (l2-ctx-cur-rush-disengaging-wids ctx) '())))
                   (not (worker-has-engine-build-order? w))
                   (not (order-ledger-unit-has-active-build? oledger-early wid w)))
          (define w-ehp (unit-total-hp-and-shield w))
          (define wx (exact->inexact (hash-ref w 'x base-x)))
          (define wy (exact->inexact (hash-ref w 'y base-y)))
          (define near-breach-d
            (for/fold ([m +inf.0]) ([e (in-list breach-threats)])
              (min m (dist2d wx wy
                             (exact->inexact (hash-ref e 'x 9999.0))
                             (exact->inexact (hash-ref e 'y 9999.0))))))
          (when (and (<= w-ehp 18.0) (<= near-breach-d 6.5))
            (set-l2-ctx-cur-rush-disengaging-wids!
             ctx
             (cons wid (or (l2-ctx-cur-rush-disengaging-wids ctx) '())))
            (when (refractory-allow-action?! cd-tracker (list 'breach-wounded-evac wid) frame 8)
              (cond
                [(> n-far 0)
                 (define mp (list-ref br-far-mps (modulo wid n-far)))
                 (l2-emit! ctx (list 'mineral-walk wid
                                     (safe-nonneg-int (hash-ref mp 'id 0) 0)
                                     (safe-coord (hash-ref mp 'x base-x) base-x)
                                     (safe-coord (hash-ref mp 'y base-y) base-y)))]
                [else
                 (l2-emit! ctx (list 'mineral-walk wid base-x base-y))])))))))
  ;; Return any wounded or finished light-harass worker defenders immediately back to safe minerals!
  ;; L46-P0-1b + L48-P0-1b (`e01` Sticky Defenders `> 20.0` EHP + One-Shot Rotate-Out `harvest-mineral`):
  ;; Stay in combat down to `> 20.0` EHP (avoiding premature 24-EHP churn) AND emit `(harvest-mineral ...)`
  ;; strictly ONCE per rotate-out (`20f` refractory, skipping workers already harvesting/returning cargo!)
  ;; so `3666` drops `56 -> <= 30` and mineral carry trips are NEVER interrupted (`430M+` `2/2` PASS)!
  (define active-sticky-lh-wids '())
  (let ([prev-lh-wids (hash-ref rush-def-st 'light-harass-def-wids '())])
    (when (and live-obs-harvesters? (pair? prev-lh-wids) (not in-base-proxy-detected?))
      (define lh-mps
        (filter (lambda (mp)
                  (and (hash? mp)
                       (> (hash-ref mp 'id 0) 0)
                       (for/or ([th (in-list ready-th-coords-eb)])
                         (<= (dist2d (car th) (cdr th)
                                     (exact->inexact (hash-ref mp 'x 9999.0))
                                     (exact->inexact (hash-ref mp 'y 9999.0)))
                             14.0))))
                (let ([mps (hash-ref obs 'mineral-patches '())]) (if (list? mps) mps '()))))
      (define lh-safe-mp-id
        (if (pair? lh-mps)
            (hash-ref (argmax (lambda (mp)
                                (if (null? light-worker-scout-harass-enemies)
                                    (hash-ref mp 'mineral-contents 1000)
                                    (for/fold ([m +inf.0]) ([e (in-list light-worker-scout-harass-enemies)])
                                      (min m (dist2d (exact->inexact (hash-ref mp 'x base-x))
                                                     (exact->inexact (hash-ref mp 'y base-y))
                                                     (exact->inexact (hash-ref e 'x 9999.0))
                                                     (exact->inexact (hash-ref e 'y 9999.0)))))))
                              lh-mps)
                      'id 0)
            (hash-ref obs 'mineral-patch-id 0)))
      (define still-valid-lh-wids '())
      (for ([w (in-list non-builder-defense-workers)])
        (define wid (hash-ref w 'id 0))
        (when (memv wid prev-lh-wids)
          (define whp (unit-total-hp-and-shield w))
          (define wx (exact->inexact (hash-ref w 'x base-x)))
          (define wy (exact->inexact (hash-ref w 'y base-y)))
          (define within-leash?
            (for/or ([th (in-list ready-th-coords-eb)])
              (<= (dist2d (car th) (cdr th) wx wy) 11.0)))
          (define already-harvesting-or-carrying?
            (or (eq? (hash-ref w 'carrying-minerals? #f) #t)
                (let ([ords (hash-ref w 'orders '())])
                  (and (list? ords)
                       (pair? ords)
                       (let* ([o0 (car ords)]
                              [ab (and (hash? o0) (hash-ref o0 'ability-id (hash-ref o0 'ability_id 0)))])
                         (memv ab '(295 298 299 3666 3667)))))))
          (cond
            [(and light-worker-scout-harass-active? (> whp 20.0) within-leash?)
             (set! still-valid-lh-wids (cons wid still-valid-lh-wids))]
            [(or already-harvesting-or-carrying?
                 (not (refractory-allow-action?! cd-tracker (list 'lh-rotate-return wid) frame 20)))
             (void)]
            [(> lh-safe-mp-id 0)
             (l2-emit! ctx (list 'harvest-mineral wid lh-safe-mp-id))]
            [else
             (l2-emit! ctx (list 'mineral-walk wid base-x base-y))])))
      (set! active-sticky-lh-wids still-valid-lh-wids)
      (hash-set! rush-def-st 'light-harass-def-wids still-valid-lh-wids)
      ;; L40-P0-1f (`e01` `3666:194` ping-pong fix): Lock active healthy light-harass defenders in
      ;; `cur-rush-fighting-wids` on intermediate refractory ticks so L2 mineral saturation NEVER
      ;; yanks them back onto minerals every alternate tick!
      (when (pair? still-valid-lh-wids)
        (set-l2-ctx-cur-rush-fighting-wids!
         ctx
         (append still-valid-lh-wids (or (l2-ctx-cur-rush-fighting-wids ctx) '()))))))
  ;; L47-P0-1b (`#72` 12PoolBot Emergency Builder Probe Reserve): When Protoss faces an early
  ;; Zergling/cheese breach with `>= 150M` and needs an emergency `cybernetics-core` (Gateway exists,
  ;; 0 CyberCore) or defensive `gateway` (`pylon` exists, `< 3` Gateways), reserve `1` safe non-fighting
  ;; Probe near our main Nexus (excluded from `pull-workers-attack` & `cur-rush-fighting-wids`) so
  ;; emergency tech/production warps cleanly on the very first tick instead of starving for a builder!
  (define reserved-protoss-emergency-bldg-wid
    (and live-obs-harvesters?
         (eq? race 'Protoss)
         (or main-ling-slaughter-active? early-ling-breach? under-early-cheese?)
         (not in-base-proxy-completed-cannon?)
         (>= (l2-ctx-minerals ctx) 150)
         (>= (length non-builder-defense-workers) 4)
         (not (ormap (lambda (w)
                       (or (worker-has-engine-build-order? w)
                           (order-ledger-unit-has-active-build? oledger-early (hash-ref w 'id 0) w)))
                     workers))
         (let* ([has-gw? (or (l2-building-present-or-pending? ctx 'gateway)
                             (l2-building-present-or-pending? ctx 'warp-gate))]
                [has-pylon? (l2-building-present-or-pending? ctx 'pylon)]
                [need-cyber? (and has-gw?
                                  (not (l2-building-present-or-pending? ctx 'cybernetics-core)))]
                [gw-total (+ (l2-cur-ally-canon-bldg-count ctx 'gateway)
                             (l2-cur-ally-canon-bldg-count ctx 'warp-gate)
                             (order-ledger-pending-count-for-type oledger-early 'gateway frame))]
                [need-gw? (and has-pylon? (< gw-total 3))])
           (and (or need-cyber? need-gw?)
                (let* ([br-threats (if main-ling-slaughter-active?
                                       main-ling-slaughter-enemies
                                       early-ling-breach-enemies)]
                       [prev-br (hash-ref rush-def-st 'breach-def-wids '())]
                       [dis-now-p (or (l2-ctx-cur-rush-disengaging-wids ctx) '())]
                       [cands (filter (lambda (w)
                                        (define wid (hash-ref w 'id 0))
                                        (and (> wid 0)
                                             (not (memv wid dis-now-p))
                                             (>= (unit-total-hp-and-shield w) 24.0)))
                                      non-builder-defense-workers)]
                       [pool (if (pair? cands) cands non-builder-defense-workers)])
                  (and (pair? pool)
                       (hash-ref
                        (argmin (lambda (w)
                                  (define wid (hash-ref w 'id 0))
                                  (define wx (exact->inexact (hash-ref w 'x base-x)))
                                  (define wy (exact->inexact (hash-ref w 'y base-y)))
                                  (define d-base (dist2d wx wy base-x base-y))
                                  (define d-enemy
                                    (if (null? br-threats)
                                        15.0
                                        (for/fold ([m +inf.0]) ([e (in-list br-threats)])
                                          (min m (dist2d wx wy
                                                         (exact->inexact (hash-ref e 'x 9999.0))
                                                         (exact->inexact (hash-ref e 'y 9999.0)))))))
                                  (+ d-base
                                     (if (memv wid prev-br) 12.0 0.0)
                                     (- (* 1.5 (min 15.0 d-enemy)))))
                                pool)
                        'id #f)))))))
  (when (and (exact-integer? reserved-protoss-emergency-bldg-wid)
             (> reserved-protoss-emergency-bldg-wid 0)
             (not (l2-ctx-rush-pool-builder-wid ctx)))
    (set-l2-ctx-rush-pool-builder-wid! ctx reserved-protoss-emergency-bldg-wid))
  ;; L40-P0-1f (`e04` `3666:92` ping-pong fix): Persist active healthy breach defenders in
  ;; `cur-rush-fighting-wids` across refractory ticks so 5 defending Probes stay glued to the
  ;; 6 Speedlings until cleared, then immediately resume mining!
  (let ([prev-br-wids (hash-ref rush-def-st 'breach-def-wids '())])
    (when (and live-obs-harvesters? (pair? prev-br-wids))
      (define dis-now (or (l2-ctx-cur-rush-disengaging-wids ctx) '()))
      (define still-br-wids '())
      (define br-ret-mp-id
        (let* ([mps (hash-ref obs 'mineral-patches '())]
               [near-mps (if (list? mps)
                             (filter (lambda (mp)
                                       (and (hash? mp) (> (hash-ref mp 'id 0) 0)
                                            (for/or ([th (in-list ready-th-coords-eb)])
                                              (<= (dist2d (car th) (cdr th)
                                                          (exact->inexact (hash-ref mp 'x 9999.0))
                                                          (exact->inexact (hash-ref mp 'y 9999.0)))
                                                  14.0))))
                                     mps)
                             '())])
          (if (pair? near-mps)
              (hash-ref (argmax (lambda (mp) (hash-ref mp 'mineral-contents 1000)) near-mps) 'id 0)
              (hash-ref obs 'mineral-patch-id 0))))
      (for ([w (in-list non-builder-defense-workers)])
        (define wid (hash-ref w 'id 0))
        (when (and (memv wid prev-br-wids)
                   (not (memv wid dis-now))
                   (not (equal? wid reserved-protoss-emergency-bldg-wid)))
          (cond
            [(and (or main-ling-slaughter-active? early-ling-breach?)
                  (> (unit-total-hp-and-shield w) 20.0))
             (set! still-br-wids (cons wid still-br-wids))]
            [(> br-ret-mp-id 0)
             (l2-emit! ctx (list 'harvest-mineral wid br-ret-mp-id))]
            [else
             (l2-emit! ctx (list 'mineral-walk wid base-x base-y))])))
      (hash-set! rush-def-st 'breach-def-wids still-br-wids)
      (when (pair? still-br-wids)
        (set-l2-ctx-cur-rush-fighting-wids!
         ctx
         (append still-br-wids (or (l2-ctx-cur-rush-fighting-wids ctx) '()))))))
  (when (and (or under-early-cheese?
                 early-ling-breach?
                 (and light-worker-scout-harass-active? (not in-base-proxy-detected?))
                 adept-mineral-dive-active?)
             (not in-base-proxy-completed-cannon?)
             (not (null? workers))
             (or (not live-obs-harvesters?)
                 (and main-ling-slaughter-active?
                      (refractory-allow-action?! cd-tracker 'early-ling-breach-worker-pull frame 4))
                 (and early-ling-breach?
                      (refractory-allow-action?! cd-tracker 'early-ling-breach-worker-pull frame 12))
                 (and light-worker-scout-harass-active?
                      (not in-base-proxy-detected?)
                      (or (< (length active-sticky-lh-wids)
                             (min 2 (length light-worker-scout-harass-enemies)))
                          (refractory-allow-action?! cd-tracker 'light-scout-harass-worker-pull frame 16)))
                 (and adept-mineral-dive-active?
                      (refractory-allow-action?! cd-tracker 'adept-dive-worker-pull frame 8))
                 (and (not worker-rush-active?)
                      (not in-base-proxy-detected?)
                      (< frame 2500)
                      (null? ally-combat-units)
                      (refractory-allow-action?! cd-tracker 'early-cheese-worker-pull frame 112))))
    (define reserved-pool-wid (l2-ctx-rush-pool-builder-wid ctx))
    (define pull-min-hp
      (cond
        [(and main-ling-slaughter-active?
              (<= (length main-ling-slaughter-enemies) 6)
              (>= main-ling-local-ally-sup 1.5))
         26.0]
        [adept-mineral-dive-active? 24.0]
        [light-worker-scout-harass-active? 24.0]
        [else SC2-HEALTHY-WORKER-PULL-MIN-HP]))
    (define disengaging-now-early (or (l2-ctx-cur-rush-disengaging-wids ctx) '()))
    (define healthy-workers
      (filter (lambda (w)
                (define wid (hash-ref w 'id 0))
                (and (or (not reserved-pool-wid) (not (equal? wid reserved-pool-wid)))
                     (or (not reserved-protoss-emergency-bldg-wid)
                         (not (equal? wid reserved-protoss-emergency-bldg-wid)))
                     (not (memv wid disengaging-now-early))
                     (or (not live-obs-harvesters?)
                         (and (not (worker-has-engine-build-order? w))
                              (not (order-ledger-unit-has-active-build? oledger-early wid w))))
                     (or (>= (unit-total-hp-and-shield w) pull-min-hp)
                         (and light-worker-scout-harass-active?
                              (memv wid active-sticky-lh-wids)))))
              workers))
    (define fallback-threats
      (cond
        [main-ling-slaughter-active? main-ling-slaughter-enemies]
        [(not (null? early-ling-breach-enemies)) early-ling-breach-enemies]
        [light-worker-scout-harass-active? light-worker-scout-harass-enemies]
        [adept-mineral-dive-active? adept-mineral-dive-enemies]
        [(not (null? proxy-or-cheese-enemies)) proxy-or-cheese-enemies]
        [(not (null? enemy-rush-workers)) enemy-rush-workers]
        [else in-base-proxy-structures]))
    (when (not (null? fallback-threats))
      (define fallback-worker-threats
        (filter (lambda (e) (memq (unit-type-sym e) '(probe scv drone))) fallback-threats))
      (define threat
        (cond
          [main-ling-slaughter-active?
           (argmin (lambda (e)
                     (+ (* 4.0 (unit-total-hp-and-shield e))
                        (dist2d base-x base-y
                                (exact->inexact (hash-ref e 'x base-x))
                                (exact->inexact (hash-ref e 'y base-y)))))
                   main-ling-slaughter-enemies)]
          [early-ling-breach?
           (argmin (lambda (e)
                     (+ (* 4.0 (unit-total-hp-and-shield e))
                        (dist2d base-x base-y
                                (exact->inexact (hash-ref e 'x base-x))
                                (exact->inexact (hash-ref e 'y base-y)))))
                   early-ling-breach-enemies)]
          [light-worker-scout-harass-active?
           (argmin (lambda (e)
                     (+ (* 4.0 (unit-total-hp-and-shield e))
                        (dist2d base-x base-y
                                (exact->inexact (hash-ref e 'x base-x))
                                (exact->inexact (hash-ref e 'y base-y)))))
                   light-worker-scout-harass-enemies)]
          [adept-mineral-dive-active?
           (argmin (lambda (e)
                     (+ (* 4.0 (unit-total-hp-and-shield e))
                        (dist2d base-x base-y
                                (exact->inexact (hash-ref e 'x base-x))
                                (exact->inexact (hash-ref e 'y base-y)))))
                   adept-mineral-dive-enemies)]
          [(not (null? fallback-worker-threats))
           (car fallback-worker-threats)]
          [else (car fallback-threats)]))
      (define threat-is-combat-unit?
        (and (combat-unit-record? threat)
             (not (memq (unit-type-sym threat) '(probe scv drone)))))
      (define-values (tx ty)
        (if main-ling-slaughter-active?
            (let* ([n (exact->inexact (length main-ling-slaughter-enemies))]
                   [cx (/ (for/sum ([e (in-list main-ling-slaughter-enemies)])
                            (exact->inexact (hash-ref e 'x base-x)))
                          n)]
                   [cy (/ (for/sum ([e (in-list main-ling-slaughter-enemies)])
                            (exact->inexact (hash-ref e 'y base-y)))
                          n)])
              (values (safe-coord cx base-x) (safe-coord cy base-y)))
            (values (hash-ref threat 'x (safe-coord (+ base-x 5.0)))
                    (hash-ref threat 'y (safe-coord (+ base-y 5.0))))))
      (define ordered-healthy-workers
        (if (or early-ling-breach? light-worker-scout-harass-active? adept-mineral-dive-active?)
            (let ([local-hw
                   (if (or main-ling-slaughter-active? light-worker-scout-harass-active? adept-mineral-dive-active?)
                       (filter (lambda (w)
                                 (<= (dist2d (exact->inexact (hash-ref w 'x base-x))
                                             (exact->inexact (hash-ref w 'y base-y))
                                             (exact->inexact tx)
                                             (exact->inexact ty))
                                     (if main-ling-slaughter-active? 22.0 16.0)))
                               healthy-workers)
                       healthy-workers)])
              (sort local-hw
                    <
                    #:key (lambda (w)
                            (define wid (hash-ref w 'id 0))
                            (define base-d
                              (dist2d (exact->inexact (hash-ref w 'x base-x))
                                      (exact->inexact (hash-ref w 'y base-y))
                                      (exact->inexact tx)
                                      (exact->inexact ty)))
                            ;; L46-P0-1b (`e01` Sticky Defenders): Keep existing healthy light-harass
                            ;; defenders pinned FIRST (`-100.0` bonus) so we never churn fresh miners
                            ;; off mineral patches as enemy scouts move!
                            (if (and light-worker-scout-harass-active?
                                     (memv wid active-sticky-lh-wids))
                                (- base-d 100.0)
                                base-d))))
            healthy-workers))
      (define pull-cap
        (cond
          [main-ling-slaughter-active?
           (define avail-hw (length ordered-healthy-workers))
           (define th-at-site?
             (for/or ([th (in-list ready-th-coords-eb)])
               (<= (dist2d (car th) (cdr th) (exact->inexact tx) (exact->inexact ty)) 16.0)))
           ;; L38-P0-1c + L40-P0-1f + L41-P0-1d (`e04` 6 Speedlings + 1 Zealot vs 14 Probes):
           ;; Pull 5 closest healthy Probes immediately when sole Zealot is full HP (keeping 9 mining!),
           ;; and escalate to 6 Probes once Zealot drops < 100 EHP so 6-Probe+Zealot surround crushes
           ;; Speedlings before the Zealot falls (or 10-12 Probes if Zealot dies!).
           (cond
             [(and (<= (length main-ling-slaughter-enemies) 6)
                   (>= main-ling-local-ally-sup 1.5))
              ;; L43-P0-1d (`e04` 6-Probe Surround): Escalate to 6 Probes the instant the Zealot
              ;; takes its first hit (`< 145` EHP), preserving 5-Probe pre-contact pull!
              (define zealot-wounded? (< main-ling-min-ally-ehp 145.0))
              (define want-prop
                (if zealot-wounded?
                    (min 6 (max 5 (length main-ling-slaughter-enemies)))
                    (min 5 (max 4 (- (length main-ling-slaughter-enemies)
                                     (if (>= main-ling-local-ally-sup 3.0) 2 1))))))
              (define keep-m-prop
                (if zealot-wounded?
                    (if (>= avail-hw 12) 8 (if (>= avail-hw 8) 4 2))
                    (if (>= avail-hw 12) 9 (if (>= avail-hw 8) 5 2))))
              (min want-prop (max 0 (- avail-hw keep-m-prop)))]
             [else
              (define keep-m
                (if th-at-site?
                    (if (>= avail-hw 12) 2 (if (>= avail-hw 8) 1 0))
                    0))
              (min 12 (max 0 (- avail-hw keep-m)))])]
          [light-worker-scout-harass-active?
           ;; Strictly `1` healthy worker per enemy scout (`<= 2` max), keeping `10+` workers mining!
           (define avail-hw (length ordered-healthy-workers))
           (define want-lh (min 2 (length light-worker-scout-harass-enemies)))
           (min want-lh (max 0 (- avail-hw (if (>= avail-hw 12) 10 (max 0 (- avail-hw want-lh))))))]
          [adept-mineral-dive-active?
           ;; Proportional `4` healthy SCVs/workers alongside Marines vs `<= 3` Adepts, keeping `10+` mining!
           (define avail-hw (length ordered-healthy-workers))
           (min 4 (max 0 (- avail-hw (if (>= avail-hw 14) 10 (if (>= avail-hw 10) 6 2)))))]
          [(and live-obs-harvesters? early-ling-breach?)
           (define ling-cnt (length early-ling-breach-enemies))
           (define avail-hw (length ordered-healthy-workers))
           (define ally-def-cnt (length ally-combat-units))
           (define keep-miners
             (cond
               [early-ling-outnumbered-assist?
                (if (<= avail-hw 6) 1 2)]
               [(>= ling-cnt 8) 2]
               [else 4]))
           (define want-cnt
             (if (and early-ling-outnumbered-assist? (> ally-def-cnt 0) (<= ling-cnt 8))
                 (min 5 (max 3 (+ (- ling-cnt ally-def-cnt) 2)))
                 (max 6 (min 14 (+ ling-cnt 2)))))
           (min want-cnt
                (max 0 (- avail-hw keep-miners)))]
          [live-obs-harvesters?
           (min 4 (max 0 (- (length ordered-healthy-workers) 8)))]
          [else
           (min SC2-MAX-WORKER-PULL-COUNT (length ordered-healthy-workers))]))
      (define pull-workers
        (take ordered-healthy-workers pull-cap))
      (define pull-ids
        (map (lambda (w) (hash-ref w 'id 10)) pull-workers))
      (define skip-suicidal-combat-pull?
        (and (not early-ling-breach?)
             (not light-worker-scout-harass-active?)
             (not adept-mineral-dive-active?)
             (or (and live-obs-harvesters?
                      (> (dist2d base-x base-y tx ty) 15.0))
                 (and threat-is-combat-unit?
                      (or (not (null? ally-combat-units))
                          (and live-obs-harvesters?
                               (memq (fast-canonical-unit-sym (unit-type-sym threat))
                                     '(zealot stalker adept marine marauder reaper hellion roach))))))))
      (define drill-patch-id (hash-ref obs 'mineral-patch-id SC2-SYNTHETIC-MINERAL-PATCH-ID))
      (define drill-wids
        (if live-obs-harvesters?
            (for/list ([w (in-list pull-workers)]
                       #:when (<= (dist2d (hash-ref w 'x base-x) (hash-ref w 'y base-y) tx ty) 2.0))
              (hash-ref w 'id 10))
            pull-ids))
      (unless (or (null? pull-ids) skip-suicidal-combat-pull?)
        ;; L27-P0-3 (`p12` 75x / `z12` 12x harvest-reissue fix): Lock ALL defending workers into
        ;; `cur-rush-fighting-wids` so L2 `return-workers-to-gather` / idle harvest never pulls
        ;; active mineral-line defenders back onto minerals mid-fight!
        (set-l2-ctx-cur-rush-fighting-wids!
         ctx
         (append pull-ids (or (l2-ctx-cur-rush-fighting-wids ctx) '())))
        (when light-worker-scout-harass-active?
          (hash-set! rush-def-st 'light-harass-def-wids pull-ids))
        (when (or main-ling-slaughter-active? early-ling-breach?)
          (hash-set! rush-def-st 'breach-def-wids pull-ids))
        (unless (l2-ctx-worker-pull-emitted-1ab? ctx)
          (cond
            [(and main-ling-slaughter-active?
                  (<= (length main-ling-slaughter-enemies) 6)
                  (>= main-ling-local-ally-sup 1.5)
                  (> (hash-ref threat 'id 0) 0))
             ;; L40-P0-1f (`e04` 5-Probe + Zealot surround): Synchronized `attack-unit` focus-fire
             ;; on lowest-EHP Speedling alongside the Zealot so Lings drop immediately!
             (l2-emit! ctx (list 'pull-workers-attack pull-ids (hash-ref threat 'id 0) tx ty))]
            [main-ling-slaughter-active?
             ;; Pure ATTACK_MOVE (`attack-pos`) onto breaching enemies' centroid so workers surround ALL rushers!
             (l2-emit! ctx (list 'pull-workers-attack pull-ids tx ty))]
            [live-obs-harvesters?
             (l2-emit! ctx (list 'pull-workers-attack pull-ids (hash-ref threat 'id 0) tx ty))]
            [else
             (l2-emit! ctx (list 'pull-workers-attack pull-ids tx ty))]))
        ;; W18-P0-1-rt / L38-P0-1c + L41-P0-1d: Have nearby early combat units co-focus the breaching
        ;; Ling/Adept — and if a lone melee defender (`zealot`) is > 4.2t out in open space while
        ;; breaching Lings are > 2.2t away and pulled Probes are > 4.0t behind, hug back to the
        ;; Nexus/mineral-line choke so the Zealot fights WITH the Probes instead of getting 360-surrounded!
        (when (and (or early-ling-breach? adept-mineral-dive-active?) (> (hash-ref threat 'id 0) 0))
          (define tid (hash-ref threat 'id 0))
          (define lone-melee-hug-ok?
            (and main-ling-slaughter-active?
                 (<= main-ling-local-ally-sup 2.5)
                 (pair? pull-workers)))
          (for ([cu (in-list ally-combat-units)])
            (define cid (hash-ref cu 'id 0))
            (define cx (exact->inexact (hash-ref cu 'x base-x)))
            (define cy (exact->inexact (hash-ref cu 'y base-y)))
            (define csym (fast-canonical-unit-sym (unit-type-sym cu)))
            (when (and (> cid 0)
                       (memq csym '(zergling zealot marine reaper adept stalker queen))
                       (<= (dist2d cx cy (exact->inexact tx) (exact->inexact ty)) 18.0))
              (define nearest-th-pt
                (argmin (lambda (th) (dist2d cx cy (car th) (cdr th))) ready-th-coords-eb))
              (define d-cu-th (dist2d cx cy (car nearest-th-pt) (cdr nearest-th-pt)))
              (define d-cu-ling
                (for/fold ([m +inf.0]) ([e (in-list main-ling-slaughter-enemies)])
                  (min m (dist2d cx cy (exact->inexact (hash-ref e 'x 9999.0))
                                 (exact->inexact (hash-ref e 'y 9999.0))))))
              (define d-cu-probe
                (if (pair? pull-workers)
                    (for/fold ([m +inf.0]) ([w (in-list pull-workers)])
                      (min m (dist2d cx cy (exact->inexact (hash-ref w 'x 9999.0))
                                     (exact->inexact (hash-ref w 'y 9999.0)))))
                    0.0))
              (if (and lone-melee-hug-ok?
                       (eq? csym 'zealot)
                       (> d-cu-th 4.2)
                       (> d-cu-ling 2.2)
                       (> d-cu-probe 4.0))
                  (l2-emit! ctx (list 'move cid
                                      (safe-coord (car nearest-th-pt) base-x)
                                      (safe-coord (cdr nearest-th-pt) base-y)))
                  (begin
                    (l2-emit! ctx (list 'attack-unit cid tid))
                    (when oledger-early
                      (order-ledger-record-issued! oledger-early cid 'attack-unit 'early-ling-breach-focus
                                                   #:target-id tid #:target-x tx #:target-y ty #:frame frame)))))))
        (when (and (not light-worker-scout-harass-active?)
                   (not (and main-ling-slaughter-active?
                             (<= (length main-ling-slaughter-enemies) 6)
                             (>= main-ling-local-ally-sup 1.5)))
                   (not (null? drill-wids)))
          (l2-emit! ctx (list 'worker-drill-stack-attack
                       drill-wids
                       drill-patch-id
                       (hash-ref threat 'id 0)
                       (exact-round tx)
                       (exact-round ty)))))
      ;; Harass enemy proxy builder if present (skip when light-worker-scout-harass already pulled minimal defenders!)
      (define enemy-builder
        (and (not light-worker-scout-harass-active?)
             (findf (lambda (e)
                      (and (memq (unit-type-sym e) '(probe scv drone))
                           (<= (dist2d base-x base-y (hash-ref e 'x 9999) (hash-ref e 'y 9999)) cheese-dist-thresh)))
                    ground-enemy-units-for-cheese)))
      (when (and enemy-builder (not (null? healthy-workers)))
        (l2-emit! ctx (list 'worker-harass
                     (hash-ref (car healthy-workers) 'id 10)
                     (hash-ref enemy-builder 'x tx)
                     (hash-ref enemy-builder 'y ty))))))
  (define stasis-threats
    (let ()
      (define (near-worker-or-base? e)
        (and (memq (unit-type-sym e) '(oracle-stasis-trap stasis-ward))
             (let ([ex (hash-ref e 'x 9999)]
                   [ey (hash-ref e 'y 9999)])
               (or (<= (dist2d base-x base-y ex ey) 7.5)
                   (ormap (lambda (w)
                            (<= (dist2d (hash-ref w 'x base-x) (hash-ref w 'y base-y) ex ey) 7.5))
                          workers)))))
      (define acc-units
        (for/fold ([acc '()]) ([e (in-list enemy-units)])
          (if (near-worker-or-base? e) (cons e acc) acc)))
      (define acc-all
        (for/fold ([acc acc-units]) ([e (in-list enemy-bldgs)])
          (if (near-worker-or-base? e) (cons e acc) acc)))
      (if (null? acc-all) '() (reverse acc-all))))
  (when (and (not (null? stasis-threats)) (not (null? workers)))
    (define st (car stasis-threats))
    (define stx (hash-ref st 'x base-x))
    (define sty (hash-ref st 'y base-y))
    (define evac-workers
      (filter (lambda (w)
                (<= (dist2d stx sty (hash-ref w 'x base-x) (hash-ref w 'y base-y)) 6.5))
              workers))
    (when (not (null? evac-workers))
      (define ref-x (if (> (dist2d stx sty base-x base-y) 1.0) base-x nat-x))
      (define ref-y (if (> (dist2d stx sty base-x base-y) 1.0) base-y nat-y))
      (define dx (- ref-x stx))
      (define dy (- ref-y sty))
