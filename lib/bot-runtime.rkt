  (define brain-sched-gate-high-bank?
    (and brain-sched-gate-now? (>= gw-ref-minerals 300)))
  (when (and (or (not protoss-saving-for-expand?)
                 protoss-early-rush-2nd-gate?
                 brain-sched-gate-cleared-nexus?)
