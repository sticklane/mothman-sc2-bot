                      (< frame SC2-DOOR-GUARD-MAX-FRAME)
                      (not (null? enemy-units)))))
        (define dg (car door-guards))
        (define dg-id (hash-ref dg 'id 703))
        (acquire-unit-lease! leases dg-id 'door-guard frame 16 #:x nat-x #:y nat-y)
        (l2-emit! ctx (list 'hold-position dg-id nat-x nat-y))
        (l2-emit! ctx (list 'control-group-steal 2 (list dg-id)))
        (cortex-steal-control-group! cortex 2 (list dg-id))]
       [(and live-game?
             (pair? wall-door-pt)
             (not worker-rush-active?)
             (not in-base-proxy-detected?)
             ;; Loop 65H (`#1947`/`#1949`, Protoss-only via `protoss-matchup-wall`):
             ;; Release Natural wall door-guard under base attack (preserving PvZ doorway seal
             ;; ONLY when all enemies are Zerglings outside the wall gap), when any non-flying
             ;; enemy is `<= 22.0t` of Main (widened from `12.0t`), OR in PvT whenever any
             ;; enemy Reaper/Marauder is present so Zealots defend Main Probes!
             (not (and under-base-attack?
                       (not (and (eq? (l2-ctx-effective-enemy-race ctx) 'Zerg)
                                 (pair? enemy-units)
                                 (andmap (lambda (e)
                                           (and (hash? e)
                                                (eq? (fast-canonical-unit-sym (unit-type-sym e)) 'zergling)
                                                (<= (dist2d (car wall-door-pt) (cdr wall-door-pt)
                                                            (hash-ref e 'x 9999.0)
                                                            (hash-ref e 'y 9999.0))
                                                    10.0)))
                                         enemy-units)))))
             (not (and (eq? (l2-ctx-effective-enemy-race ctx) 'Terran)
                       (ormap (lambda (e)
                                (and (hash? e)
                                     (memq (fast-canonical-unit-sym (unit-type-sym e))
                                           '(reaper marauder))))
                              enemy-units)))
             (not (ormap (lambda (e)
                           (and (not (or (eq? (hash-ref e 'is-flying #f) #t)
                                         (eq? (hash-ref e 'flying? #f) #t)))
                                (<= (dist2d base-x base-y
                                            (hash-ref e 'x 9999.0)
                                            (hash-ref e 'y 9999.0))
                                    22.0)
                                (> (dist2d (car wall-door-pt) (cdr wall-door-pt)
                                           (hash-ref e 'x 9999.0)
                                           (hash-ref e 'y 9999.0))
                                   3.5)))
                         enemy-units))
             (not (null? door-guards))
             (or (memq 'gateway (l2-ctx-bldg-types ctx)) (memq 'warp-gate (l2-ctx-bldg-types ctx))))
        (define door-x (safe-coord (car wall-door-pt) nat-x))
        (define door-y (safe-coord (cdr wall-door-pt) nat-y))
        (define park-x (if (pair? wall-park-pt) (safe-coord (car wall-park-pt) base-x) (safe-coord (+ door-x (* 2.5 (/ (- base-x door-x) (max 1.0 (dist2d base-x base-y door-x door-y))))) base-x)))
        (define park-y (if (pair? wall-park-pt) (safe-coord (cdr wall-park-pt) base-y) (safe-coord (+ door-y (* 2.5 (/ (- base-y door-y) (max 1.0 (dist2d base-x base-y door-x door-y))))) base-y)))
        (define door-st (rt-door-state rt))
        (define prev-gid (hash-ref door-st 'guard-id #f))
        (define near-guards
          (filter (lambda (u)
                    (<= (dist2d door-x door-y (hash-ref u 'x base-x) (hash-ref u 'y base-y)) 22.0))
                  door-guards))
        (define chosen-guard
          (or (and prev-gid
                   (findf (lambda (u) (equal? (hash-ref u 'id -1) prev-gid)) near-guards))
              (and (pair? near-guards)
                   (argmin (lambda (u)
                             (+ (if (eq? (unit-type-sym u) 'zealot) 0.0 3.0)
                                (dist2d door-x door-y (hash-ref u 'x door-x) (hash-ref u 'y door-y))))
                           near-guards))))
        (when chosen-guard
          (define gid (hash-ref chosen-guard 'id 703))
          (define gx (hash-ref chosen-guard 'x door-x))
          (define gy (hash-ref chosen-guard 'y door-y))
          (hash-set! door-st 'guard-id gid)
          (acquire-unit-lease! leases gid 'door-guard frame 16 #:x door-x #:y door-y)
          (define nearest-enemy-to-door
            (if (null? enemy-units)
                +inf.0
                (apply min
                       (map (lambda (e)
                              (dist2d door-x door-y (hash-ref e 'x 9999.0) (hash-ref e 'y 9999.0)))
                            enemy-units))))
          (define townhall-pts
            (if (null? nexuses)
                (list (cons base-x base-y))
                (map (lambda (b)
                       (cons (hash-ref b 'x base-x) (hash-ref b 'y base-y)))
                     nexuses)))
          (define (dist-to-nearest-th wx wy)
            (apply min
                   (map (lambda (pt) (dist2d wx wy (car pt) (cdr pt)))
                        townhall-pts)))
          (define active-scout-id (hash-ref (rt-scout-state rt) 'scout-id #f))
          (define (worker-scout-leased? wid)
            (let ([l (and (hash? leases) (hash-ref leases wid #f))])
              (and (unit-role-lease? l)
                   (> (unit-role-lease-expires-frame l) frame)
                   (eq? (unit-role-lease-role l) 'scout))))
          (define worker-transiting-door?
            (ormap (lambda (w)
                     (define wid (hash-ref w 'id 0))
                     (define wx (hash-ref w 'x base-x))
                     (define wy (hash-ref w 'y base-y))
                     (define dw (dist2d door-x door-y wx wy))
                     (define oc (hash-ref w 'order-count 0))
                     (define oab (hash-ref w 'order-ability-id 0))
                     (and (<= dw 4.0)
                          (or (eq? (hash-ref w 'has-build-order? #f) #t)
                              (order-ledger-unit-has-active-build? oledger wid w)
                              (worker-has-engine-build-order? w)
                              (and active-scout-id (equal? wid active-scout-id))
                              (worker-scout-leased? wid)
                              (and (= oc 0) (<= dw 2.8))
                              (and (> oc 0)
                                   (not (= oab 18))
                                   (<= dw 3.5)
                                   (> (dist-to-nearest-th wx wy) 4.5)))))
                   workers))
          (define base-door-dx (- base-x door-x))
          (define base-door-dy (- base-y door-y))
          (define out-norm (max 1.0 (dist2d base-x base-y door-x door-y)))
          (define out-ux (/ (- door-x base-x) out-norm))
          (define out-uy (/ (- door-y base-y) out-norm))
          (define trapped-idle-army-units
            (filter (lambda (u)
                      (define uid (hash-ref u 'id 0))
                      (define ux (hash-ref u 'x base-x))
                      (define uy (hash-ref u 'y base-y))
                      (define on-main-side?
                        (>= (+ (* (- ux door-x) base-door-dx)
                               (* (- uy door-y) base-door-dy))
                            0.0))
                      (and (not (equal? uid gid))
                           (combat-unit-record? u)
                           (not (or (eq? (hash-ref u 'is-flying #f) #t)
                                    (eq? (hash-ref u 'flying? #f) #t)))
                           (= (hash-ref u 'order-count 0) 0)
                           (<= (dist2d door-x door-y ux uy) 3.2)
                           on-main-side?))
                    ally-units))
          (define transiting-army-near-door
            (count (lambda (u)
                     (define uid (hash-ref u 'id 0))
                     (define ux (hash-ref u 'x base-x))
                     (define uy (hash-ref u 'y base-y))
                     (define on-main-side?
                       (>= (+ (* (- ux door-x) base-door-dx)
                              (* (- uy door-y) base-door-dy))
                           0.0))
                     (and (not (equal? uid gid))
                          (combat-unit-record? u)
                          (not (or (eq? (hash-ref u 'is-flying #f) #t)
                                   (eq? (hash-ref u 'flying? #f) #t)))
                          (<= (dist2d door-x door-y ux uy) 4.0)
                          (or (and (> (hash-ref u 'order-count 0) 0)
                                   (not (= (hash-ref u 'order-ability-id 0) 18)))
                              (and (= (hash-ref u 'order-count 0) 0)
                                   (<= (dist2d door-x door-y ux uy) 3.2)
                                   on-main-side?))))
                   ally-units))
          (define transit-needed?
            (and (or worker-transiting-door? (>= transiting-army-near-door 1))
                 (> nearest-enemy-to-door 6.5)))
          (cond
            [transit-needed?
             (hash-set! door-st 'state 'open)
             (hash-set! door-st 'open-until-frame (+ frame 24))
             (when (or (> (dist2d gx gy park-x park-y) 1.0)
                       (= (hash-ref chosen-guard 'order-ability-id 0) 18))
               (l2-emit! ctx (list 'move gid park-x park-y))
               (order-ledger-record-issued! oledger gid 'move 'door-park park-x park-y frame))
             (define nudge-x (safe-coord (+ door-x (* 4.5 out-ux)) nat-x))
             (define nudge-y (safe-coord (+ door-y (* 4.5 out-uy)) nat-y))
             (for ([tu (in-list trapped-idle-army-units)])
               (define tid (hash-ref tu 'id 0))
               (l2-emit! ctx (list 'move tid nudge-x nudge-y))
               (order-ledger-record-issued! oledger tid 'move 'door-unstick nudge-x nudge-y frame))]
            [else
             (hash-set! door-st 'open-until-frame 0)
             (hash-set! door-st 'state 'closed)
             (when (or (> (dist2d gx gy door-x door-y) 0.85)
                       (not (= (hash-ref chosen-guard 'order-ability-id 0) 18)))
               (l2-emit! ctx (list 'hold-position gid door-x door-y))
               (order-ledger-record-issued! oledger gid 'hold-position 'door-seal door-x door-y frame))]))])
  (define protoss-exp-x #f)
