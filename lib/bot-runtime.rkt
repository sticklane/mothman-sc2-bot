                              [t-fly? (or (eq? (hash-ref target-enemy 'flying #f) #t)
                                          (eq? (hash-ref target-enemy 'flying? #f) #t)
                                          (eq? (hash-ref target-enemy 'is-flying #f) #t)
                                          (fast-unit-is-flying-sym? etype))]
                              [gr (if has-weap?
                                      (exact->inexact (or (hash-ref u 'ground-range #f)
                                                          (hash-ref stats 'ground-range 0.0)))
                                      0.0)]
                              [ar (if has-weap? (exact->inexact (hash-ref stats 'air-range 0.0)) 0.0)]
                              [r0 (if t-fly? ar gr)]
                              [eff-r (if has-weap? (if (fl> r0 0.0) r0 (flmax gr ar)) 0.0)]
                              [raw-cd (hash-ref u 'weapon-cooldown (hash-ref u 'weapon_cooldown 0.0))]
                              [fw-cd (if (real? raw-cd) (exact->inexact raw-cd) 0.0)]
                              [w-period (flmax 0.16 (exact->inexact (if (hash? stats) (hash-ref stats 'weapon-period 1.0) 1.0)))]
                              [kite-cd-min (flmax 0.22 (fl* 0.38 w-period))]
                              [fed2 (if (flonum? edist2) edist2 (exact->inexact edist2))]
                              [non-free? (not (free-summon-unit-sym? etype))]
                              ;; L27-P0-3 (`t11`/`p11`/`t02` Self-Play Gap 4): Compute enemy weapon range
                              ;; against our unit, plus slow air/siege & friendly Sieged Tank screen guard!
                              [u-fly? (or (eq? (hash-ref u 'flying #f) #t)
                                          (eq? (hash-ref u 'is-flying #f) #t)
                                          (fast-unit-is-flying-sym? ut))]
                              [estats (fast-unit-combat-stats etype)]
                              [egr (if (hash? estats) (exact->inexact (hash-ref estats 'ground-range 0.0)) 0.0)]
                              [ear (if (hash? estats) (exact->inexact (hash-ref estats 'air-range 0.0)) 0.0)]
                              [enemy-eff-r (if u-fly? (if (fl> ear 0.0) ear egr) (if (fl> egr 0.0) egr ear))]
                              [outranged-forbid-kite?
                               (and has-weap? can-hit-target? non-free?
                                    (fl> eff-r 1.5)
                                    (or (fl> enemy-eff-r eff-r)
                                        (and (>= (length combat-units) 4)
                                             (fl<= fed2 90.25)
                                             (fl> enemy-eff-r 1.5)
                                             (fl>= enemy-eff-r eff-r))))]
                              [slow-air-forbid-kite?
                               (and has-weap? can-hit-target? non-free?
                                    (or (memq ut '(brood-lord broodlord))
                                        (and (eq? ut 'corruptor) t-fly?)))]
                              [bio-tank-screen-forbid-kite?
                               (and has-weap? can-hit-target? non-free?
                                    (memq ut '(marine marauder hellbat))
                                    (let ([fux (exact->inexact ux)] [fuy (exact->inexact uy)])
                                      (for/or ([au (in-list combat-units)])
                                        (and (memq (fast-canonical-unit-sym (unit-type-sym au)) '(siege-tank siege-tank-sieged))
                                             (let ([ax (hash-ref au 'x #f)] [ay (hash-ref au 'y #f)])
                                               (and (real? ax) (real? ay)
                                                    (let ([dx (fl- fux (exact->inexact ax))]
                                                          [dy (fl- fuy (exact->inexact ay))])
                                                      (fl<= (fl+ (fl* dx dx) (fl* dy dy)) 49.0))))))))]
                              [forbid-kite?
                               (or (l34-ctx-enemy-within-14-of-th? ctx)
                                   outranged-forbid-kite?
                                   slow-air-forbid-kite?
                                   bio-tank-screen-forbid-kite?
                                   (and (l34-ctx-live-obs? ctx)
                                        has-weap? can-hit-target? non-free?
                                        (l34-point-in-owned-territory? ctx ux uy))
                                   (and has-weap? can-hit-target? non-free?
                                        (if (fl<= eff-r 1.5)
                                            (fl<= fed2 72.25)
                                            (and (fl<= fed2 (fl* (fl+ eff-r 2.5) (fl+ eff-r 2.5)))
                                                 (fl< fw-cd kite-cd-min)))))])
                         (let* ([ma-k (if forbid-kite?
                                          (filter (lambda (ma) (not (and (pair? ma) (eq? (car ma) 'kite)))) raw-ma)
                                          raw-ma)]
                                [cliff-lim2 (fl* (fl+ ar 1.0) (fl+ ar 1.0))])
                           ;; L55-T1 (`#75`): Filter unreachable cliff-decoy flyer `attack-unit`
                           ;; from `tbrain` for ground AA units (Hydralisk/Queen/Thor/Cyclone)
                           ;; so fallback uses the reachable `target-enemy`!
                           (if (and (not u-fly?) eng-enemy-by-id (pair? ma-k))
                               (filter
                                (lambda (ma)
                                  (not (and (pair? ma)
                                            (eq? (car ma) 'attack-unit)
                                            (>= (length ma) 3)
                                            (let ([te (hash-ref eng-enemy-by-id (caddr ma) #f)])
                                              (and (hash? te)
                                                   (eq? (hash-ref te 'over-unpathable-airspace? #f) #t)
                                                   (or (eq? (hash-ref te 'flying #f) #t)
                                                       (eq? (hash-ref te 'is-flying #f) #t)
                                                       (fast-unit-is-flying-sym? (unit-type-sym te)))
                                                   (fl> (l34-safe-coord-dist2 ux uy
                                                                              (hash-ref te 'x nat-x)
                                                                              (hash-ref te 'y nat-y))
                                                        cliff-lim2))))))
                                ma-k)
                               ma-k)))))
                 '()))
           (unless else-pos-handled?
             (if (not (null? mirrored-acts))
                 (for ([ma (in-list mirrored-acts)])
                   (if (and (l34-ctx-enemy-within-14-of-th? ctx)
                            (pair? ma)
                            (memq (car ma) '(attack-unit attack-pos)))
                       (l34-emit-preserved! ctx ma)
                       (l34-emit! ctx ma)))
                 (l34-emit-engage-or-rally! ctx uid ux uy ex ey eid nearest-enemy-tank zergling-hold-off-pf-siege? tank-supporting-vs-static? unit-should-engage-target? u ut can-hit-target? edist2 target-enemy)))])]))])))))

