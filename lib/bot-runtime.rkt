                  p5-has-owned-home-th?
                  (< total-ally-zealots-l34 2)
                  (not z-pocket-latched?)
                  (let-values ([(ew-cnt ec-cnt)
                                (for/fold ([wc 0] [cc 0]) ([e (in-list enemy-units)])
                                  (if (and (hash? e)
