  (define enemy-units (l34-ctx-enemy-units ctx))
  (define enemy-x (l34-ctx-enemy-x ctx))
  (define enemy-y (l34-ctx-enemy-y ctx))
  (define frame (l34-ctx-frame ctx))
  (define has-ally-changeling-or-overseer? (l34-ctx-has-ally-changeling-or-overseer? ctx))
  (define has-ally-dropperlord? (l34-ctx-has-ally-dropperlord? ctx))
  (define has-ally-harass-sym? (l34-ctx-has-ally-harass-sym? ctx))
  (define has-ally-map-elem-or-recall? (l34-ctx-has-ally-map-elem-or-recall? ctx))
  (define has-ally-queen-or-tumor? (l34-ctx-has-ally-queen-or-tumor? ctx))
  (define has-ally-queen? (l34-ctx-has-ally-queen? ctx))
  (define has-ally-static-def-or-nydus? (l34-ctx-has-ally-static-def-or-nydus? ctx))
  (define has-ally-swarm-host-or-locust? (l34-ctx-has-ally-swarm-host-or-locust? ctx))
  (define has-ally-unwalled-punish-unit? (l34-ctx-has-ally-unwalled-punish-unit? ctx))
  (define has-ally-wall-block-bldg? (l34-ctx-has-ally-wall-block-bldg? ctx))
  (define has-ally-zergling? (l34-ctx-has-ally-zergling? ctx))
  (define has-enemy-burrow-or-sh-counter? (l34-ctx-has-enemy-burrow-or-sh-counter? ctx))
  (define has-enemy-changeling? (l34-ctx-has-enemy-changeling? ctx))
  (define has-enemy-creep-tumor? (l34-ctx-has-enemy-creep-tumor? ctx))
  (define has-enemy-dropperlord? (l34-ctx-has-enemy-dropperlord? ctx))
  (define has-enemy-harass-sym? (l34-ctx-has-enemy-harass-sym? ctx))
  (define has-enemy-map-elem-or-recall? (l34-ctx-has-enemy-map-elem-or-recall? ctx))
  (define has-enemy-overseer? (l34-ctx-has-enemy-overseer? ctx))
  (define has-enemy-static-def-or-nydus? (l34-ctx-has-enemy-static-def-or-nydus? ctx))
  (define has-enemy-static-det? (l34-ctx-has-enemy-static-det? ctx))
  (define has-enemy-swarm-host-or-locust? (l34-ctx-has-enemy-swarm-host-or-locust? ctx))
  (define l34-sc (l34-ctx-l34-sc ctx))
  (define leases (l34-ctx-leases ctx))
  (define nat-x (l34-ctx-nat-x ctx))
  (define nat-y (l34-ctx-nat-y ctx))
  (define obs (l34-ctx-obs ctx))
  (define reserve-count (l34-ctx-reserve-count ctx))
  (define rt (l34-ctx-rt ctx))
  (define splash-evading-tags (l34-ctx-splash-evading-tags ctx))
  (define stasis-frozen-tags (l34-ctx-stasis-frozen-tags ctx))
  (define vanguard-count (l34-ctx-vanguard-count ctx))
  (define wave3-handled-tags (l34-ctx-wave3-handled-tags ctx))
  (define direct-claimed-ht (pooled-hasheqv! l34-sc 'direct-claimed-ht))
  (for ([tid (in-set wave3-handled-tags)])
    (when (and (exact-integer? tid) (> tid 0))
      (hash-set! direct-claimed-ht tid #t)))
  (for ([tid (in-set disruptor-handled-tags)])
    (when (and (exact-integer? tid) (> tid 0))
      (hash-set! direct-claimed-ht tid #t)))
  (for ([tid (in-set splash-evading-tags)])
    (when (and (exact-integer? tid) (> tid 0))
      (hash-set! direct-claimed-ht tid #t)))
  (for ([tid (in-list stasis-frozen-tags)])
    (hash-set! direct-claimed-ht tid #t))
  (when (hash? leases)
    (for ([uid (in-hash-keys leases)])
      (when (unit-leased-above? leases uid 'army frame)
        (hash-set! direct-claimed-ht uid #t))))

  (define direct-prev-tel (live-bot-runtime-last-telemetry rt))
  (define direct-our-race
    (let ([r (live-bot-runtime-actual-race rt)])
      (if (and (symbol? r) (not (eq? r 'Unknown)))
          r
          (hash-ref obs 'race 'Zerg))))
  (define direct-enemy-race
    (if (hash? direct-prev-tel)
        (hash-ref direct-prev-tel 'effective-enemy-race (hash-ref obs 'enemy-race 'Unknown))
        (hash-ref obs 'enemy-race 'Unknown)))
  (define zerg-or-random? (memq direct-our-race '(Zerg Random)))
  (define has-any-enemy? (or (pair? enemy-units) (pair? enemy-bldgs)))
  (define has-ally-overseer? (pair? ally-overseers))
  (define direct-seen-sexps #f)
  (define unclaimed-allies-cache #f)

  (define (emit-direct-batch! raw-acts)
    (when (pair? raw-acts)
      (unless direct-seen-sexps
        (set! direct-seen-sexps (pooled-mutable-set! l34-sc 'direct-seen-sexps)))
      (define newly-claimed '())
      (for ([act (in-list raw-acts)]
            #:when (and (pair? act) (symbol? (car act))))
        (define-values (filtered-act actor-ids)
          (cond
            [(null? (cdr act)) (values act '())]
            [else
             (define head (car act))
             (define arg1 (cadr act))
             (cond
               [(and (eq? head 'bunker-load)
                     (pair? (cddr act))
                     (exact-integer? (caddr act))
                     (> (caddr act) 0))
                (define bio-id (caddr act))
                (if (hash-ref direct-claimed-ht bio-id #f)
                    (values #f '())
                    (values act (list bio-id)))]
               [(and (eq? head 'transport-juggle)
                     (exact-integer? arg1)
                     (> arg1 0)
                     (pair? (cddr act))
                     (list? (caddr act)))
                (if (hash-ref direct-claimed-ht arg1 #f)
                    (values #f '())
                    (let ([unclaimed-pax
                           (for/list ([p (in-list (caddr act))]
                                      #:when (and (exact-integer? p)
                                                  (> p 0)
                                                  (not (hash-ref direct-claimed-ht p #f))))
                             p)])
                      (if (null? unclaimed-pax)
                          (values #f '())
                          (values (list* head arg1 unclaimed-pax (cdddr act))
                                  (cons arg1 unclaimed-pax)))))]
               [(and (pair? arg1) (exact-integer? (car arg1)))
                (define free-ids
                  (for/list ([uid (in-list arg1)]
                             #:when (and (exact-integer? uid)
                                         (> uid 0)
                                         (not (hash-ref direct-claimed-ht uid #f))))
                    uid))
                (if (null? free-ids)
                    (values #f '())
                    (values (cons head (cons free-ids (cddr act))) free-ids))]
               [(and (exact-integer? arg1) (> arg1 0))
                (if (hash-ref direct-claimed-ht arg1 #f)
                    (values #f '())
                    (values act (list arg1)))]
               [else (values act '())])]))
        (when (and filtered-act (not (set-member? direct-seen-sexps filtered-act)))
          ;; Strict Layering Invariant (#5131238, #5130439): in live games (`live-obs?`),
          ;; Layer 3/4 tactical planners must NEVER emit unbudgeted macro build/train/expand/research commands
          ;; using stale start-of-frame resources (which built 50 ShieldBatteries & 27 MissileTurrets!).
          ;; Only Layer 2 (`step-layer2-economy!`) owns macro resource spending!
          (define skip-layer34-macro-leak?
            (and (l34-ctx-live-obs? ctx)
                 (pair? filtered-act)
                 (memq (car filtered-act) '(build expand train train-unit research))))
          (define skip-worker-proxy-pull?
            (and (list? filtered-act)
                 (eq? (car filtered-act) 'pull-workers-attack)
                 (let ([tid (and (>= (length filtered-act) 5) (third filtered-act))])
                   (not (and (exact-integer? tid)
                             (for/or ([eb (in-list enemy-bldgs)])
                               (and (= (hash-ref eb 'id -1) tid)
                                    (memq (fast-canonical-structure-sym (unit-type-sym eb))
                                          '(nydus-canal nydus-worm)))))))))
          (define skip-dummy?
            (and (list? filtered-act)
                 (eq? (car filtered-act) 'cast-spell)
                 (or (and (>= (length filtered-act) 5)
                          (real? (fourth filtered-act))
                          (real? (fifth filtered-act))
                          (let ([tx (fourth filtered-act)] [ty (fifth filtered-act)])
                            (and (or (and (= tx 46.0) (= ty 46.0))
                                     (and (= tx 88.0) (= ty 88.0))
                                     (and (= tx 152.0) (= ty 152.0)))
                                 (not (for/or ([eu (in-list enemy-units)])
                                        (let ([ex (hash-ref eu 'x -999.0)]
                                              [ey (hash-ref eu 'y -999.0)])
                                          (and (real? ex) (real? ey) (= (- ex ex) 0) (= (- ey ey) 0)
                                               (let ([dx (- (exact->inexact tx) (exact->inexact ex))]
                                                     [dy (- (exact->inexact ty) (exact->inexact ey))])
                                                 (<= (+ (* dx dx) (* dy dy)) 64.0)))))))))
                     (and (= (length filtered-act) 4)
                          (equal? (fourth filtered-act) 1)
                          (not (for/or ([eu (in-list enemy-units)]) (= (hash-ref eu 'id -1) 1)))))))
          (unless (or skip-layer34-macro-leak? skip-worker-proxy-pull? skip-dummy?)
            (set-add! direct-seen-sexps filtered-act)
            (l34-emit! ctx filtered-act)
            (for ([uid (in-list actor-ids)])
              (set! newly-claimed (cons uid newly-claimed))))))
      (when (pair? newly-claimed)
        (set! unclaimed-allies-cache #f)
        (for ([uid (in-list newly-claimed)])
          (hash-set! direct-claimed-ht uid #t)))))

  (define (unclaimed-ally-units-now)
    (or unclaimed-allies-cache
        (let ([res
               (if (zero? (hash-count direct-claimed-ht))
                   ally-units
                   (for/list ([u (in-list ally-units)]
                              #:when (let ([uid (let ([id0 (hash-ref u 'id #f)])
                                                  (if id0 id0 (hash-ref u 'tag -1)))])
                                       (not (and (exact-integer? uid) (> uid 0)
                                                 (hash-ref direct-claimed-ht uid #f)))))
                     u))])
          (set! unclaimed-allies-cache res)
          res)))

  ;; Direct Tactic #1: `zerg-burrow-micro.rkt` + Swarm Host (`static-defense-tactics.rkt`)
  ;; (Roach tunneling + Infestor burrow cast already executed directly at lines ~13101-13110)
  (when (and has-any-enemy? zerg-or-random? ally-zerg-burrow-candidate?)
    (emit-direct-batch!
     (execute-zerg-reactive-burrow-dodge-micro obs #:tracker (rt-burrow-tracker rt))))
  (when (and zerg-or-random? has-enemy-static-det?)
    ;; Pre-filter completed static detectors and only ring-raiders within 36.5 Chebyshev
    ;; of a completed static detector (`zerg-burrow-micro.rkt` skips all other units/bldgs).
    (define ambush-static-dets
      (append
       (for/list ([b (in-list enemy-bldgs)]
                  #:when (and (hash? b)
                              (memq (unit-type-sym b) SC2-STATIC-DETECTOR-SYMS)
                              (>= (fast-finite-real (hash-ref b 'build-progress 1.0) 1.0)
                                  SC2-BUILD-COMPLETE-PROGRESS)))
         b)
       (for/list ([e (in-list enemy-units)]
                  #:when (and (hash? e)
                              (memq (unit-type-sym e) SC2-STATIC-DETECTOR-SYMS)
                              (>= (fast-finite-real (hash-ref e 'build-progress 1.0) 1.0)
                                  SC2-BUILD-COMPLETE-PROGRESS)))
         e)))
    (when (pair? ambush-static-dets)
      (define det-coords
        (for/list ([d (in-list ambush-static-dets)])
          (cons (fast-finite-real (hash-ref d 'x 160.0) 160.0)
                (fast-finite-real (hash-ref d 'y 160.0) 160.0))))
      (define ambush-raiders
        (for/list ([u (in-list ally-units)]
                   #:when (and (hash? u)
                               (memq (unit-type-sym u)
                                     '(zergling roach hydralisk baneling ravager lurker lurker-mp infestor
                                       zergling-burrowed roach-burrowed hydralisk-burrowed baneling-burrowed
                                       ravager-burrowed lurker-burrowed lurker-mp-burrowed infestor-burrowed))
                               (let ([ux (fast-finite-real (hash-ref u 'x 32.0) 32.0)]
                                     [uy (fast-finite-real (hash-ref u 'y 32.0) 32.0)])
                                 (for/or ([dc (in-list det-coords)])
                                   (and (<= (abs (- ux (car dc))) 36.5)
                                        (<= (abs (- uy (cdr dc))) 36.5))))))
          u))
      (when (pair? ambush-raiders)
        (define ambush-e-bldgs
          (for/list ([b (in-list enemy-bldgs)]
                     #:when (and (hash? b)
                                 (let ([bt (unit-type-sym b)])
                                   (or (memq bt SC2-STATIC-DETECTOR-SYMS)
                                       (memq bt '(hatchery lair hive nexus command-center orbital-command planetary-fortress))))))
            b))
        (define ambush-e-units
          (for/list ([e (in-list enemy-units)]
                     #:when (and (hash? e)
                                 (let ([et (unit-type-sym e)])
                                   (or (memq et SC2-STATIC-DETECTOR-SYMS)
                                       (memq et SC2-MOBILE-DETECTOR-SYMS)
                                       (and (not (memq et '(probe scv drone drone-burrowed larva egg mule)))
                                            (let ([ex (fast-finite-real (hash-ref e 'x 9999.0) 9999.0)]
                                                  [ey (fast-finite-real (hash-ref e 'y 9999.0) 9999.0)])
                                              (for/or ([dc (in-list det-coords)])
                                                (and (<= (abs (- ex (car dc))) 60.5)
                                                     (<= (abs (- ey (cdr dc))) 60.5)))))))))
            e))
        (define ambush-obs
          (hash-set* obs
                     'ally-units ambush-raiders
                     'enemy-units ambush-e-units
                     'enemy-buildings ambush-e-bldgs))
        (emit-direct-batch! (execute-stationary-detection-ring-ambush-micro ambush-obs)))))
  (when has-ally-swarm-host-or-locust?
    (emit-direct-batch! (plan-spread-burrowed-swarm-host-harass obs)))
  (when has-enemy-swarm-host-or-locust?
    (emit-direct-batch! (plan-counter-spread-swarm-host-harass obs)))
  (when (or has-enemy-burrow-or-sh-counter?
            (let ([rb (hash-ref obs 'remembered-burrows '())])
              (and (list? rb) (pair? rb))))
    ;; `plan-counter-burrow-response` never reads non-detector workers/eggs/larva or non-detector non-OC buildings.
    (define cb-ally-units
      (for/list ([u (in-list ally-units)]
                 #:when (and (hash? u)
                             (not (memq (unit-type-sym u) '(scv probe drone overlord larva egg mule)))))
        u))
    (define cb-ally-bldgs
      (for/list ([b (in-list ally-bldgs)]
                 #:when (and (hash? b)
                             (memq (unit-type-sym b) '(missile-turret spore-crawler photon-cannon orbital-command))))
        b))
    (define cb-obs
      (hash-set* obs 'ally-units cb-ally-units 'ally-buildings cb-ally-bldgs))
    (emit-direct-batch!
     (CounterBurrowPlan-commands (plan-counter-burrow-response cb-obs #:tracker (rt-burrow-tracker rt)))))
  (when (and has-ally-zergling?
             (or (let ([v (hash-ref obs 'expansion-pads '())]) (and (list? v) (pair? v)))
                 (let ([v (hash-ref obs 'pending-expansion-targets '())]) (and (list? v) (pair? v)))
                 (hash-ref obs 'pending-expansion-target #f)))
    (emit-direct-batch!
     (plan-burrowed-zergling-expansion-blocks obs #:tracker (rt-burrow-tracker rt))))

  ;; Direct Tactic #2: `multitask-harass-and-proxy.rkt`
  (when (and has-any-enemy?
             (or has-ally-harass-sym?
                 has-enemy-harass-sym?
                 (and (<= frame 4500) enemy-near-home?)))
    (define free-allies (unclaimed-ally-units-now))
    (when (pair? free-allies)
      (define keep-all-workers? (or enemy-near-home? (<= 1792 frame 3024)))
      (define ebbox-ready? #f)
      (define eminx +inf.0)
      (define emaxx -inf.0)
      (define eminy +inf.0)
      (define emaxy -inf.0)
      (define (worker-near-any-enemy? w)
        (unless ebbox-ready?
          (set! ebbox-ready? #t)
          (for ([e (in-list enemy-units)] #:when (hash? e))
            (define ex (hash-ref e 'x RUNTIME-MISSING))
            (define ey (hash-ref e 'y RUNTIME-MISSING))
            (when (and (real? ex) (real? ey))
              (define fx (exact->inexact ex))
              (define fy (exact->inexact ey))
              (when (< fx eminx) (set! eminx fx))
              (when (> fx emaxx) (set! emaxx fx))
              (when (< fy eminy) (set! eminy fy))
              (when (> fy emaxy) (set! emaxy fy)))))
        (or (> eminx emaxx)
            (let ([wx (hash-ref w 'x RUNTIME-MISSING)]
                  [wy (hash-ref w 'y RUNTIME-MISSING)])
              (or (not (real? wx))
                  (not (real? wy))
                  (and (>= wx (- eminx 24.0)) (<= wx (+ emaxx 24.0))
                       (>= wy (- eminy 24.0)) (<= wy (+ emaxy 24.0)))))))
      (define has-active-harass-actor? #f)
      (define filtered-allies
        (for/list ([u (in-list free-allies)]
                   #:when (let ([ut (unit-type-sym u)])
                            (cond
                              [(hash-ref RUNTIME-NON-COMBAT-HARASS-SKIP-SET ut #f)
                               (and (hash-ref RUNTIME-WORKER-SET ut #f)
                                    (or keep-all-workers? (worker-near-any-enemy? u)))]
                              [else
                               (set! has-active-harass-actor? #t)
                               #t])))
          u))
      (when (and (pair? filtered-allies)
                 (or enemy-near-home? has-active-harass-actor?))
        (emit-direct-batch!
         (step-multitask-harass-and-proxy
          direct-our-race
          direct-enemy-race
          filtered-allies
          enemy-units
          #:current-frame frame
          #:home-x base-x
          #:home-y base-y
          #:enemy-main-x enemy-x
          #:enemy-main-y enemy-y)))))

  ;; Direct Tactic #3: `creep-and-changeling-tactics.rkt`
  (define creep-tr (rt-creep-tracker rt))
  (define direct-th-coords
    (let ([ths (for/list ([b (in-list ally-bldgs)]
                          #:when (and (hash? b)
                                      (memq (fast-canonical-structure-sym (unit-type-sym b))
                                            '(hatchery lair hive nexus command-center orbital-command planetary-fortress))))
                 (cons (exact->inexact (hash-ref b 'x base-x))
                       (exact->inexact (hash-ref b 'y base-y))))])
      (if (pair? ths) ths (list (cons (exact->inexact base-x) (exact->inexact base-y))))))
  (define direct-queen-reserve-cap
    (+ (* 2 (max 1 (length direct-th-coords))) 2))
  (define (direct-dist-to-nearest-th px py)
    (for/fold ([best-d2 +inf.0] #:result (sqrt (if (< best-d2 +inf.0) best-d2 0.0)))
              ([tc (in-list direct-th-coords)])
      (define dx (fl- (exact->inexact px) (car tc)))
      (define dy (fl- (exact->inexact py) (cdr tc)))
      (flmin best-d2 (fl+ (fl* dx dx) (fl* dy dy)))))
  (define direct-reserved-queen-ids
    (if has-ally-queen?
        (let* ([qs (for/list ([u (in-list ally-units)]
                              #:when (and (hash? u)
                                          (eq? (fast-canonical-unit-sym (unit-type-sym u)) 'queen)
                                          (exact-integer? (hash-ref u 'id #f))))
                     u)]
               [cap (min (length qs) direct-queen-reserve-cap)]
               [ranked (sort qs <
                             #:key (lambda (q) (direct-dist-to-nearest-th (hash-ref q 'x base-x) (hash-ref q 'y base-y)))
                             #:cache-keys? #t)])
          (for/seteqv ([q (in-list (take ranked cap))])
            (hash-ref q 'id)))
        (seteqv)))
  (when has-ally-queen-or-tumor?
    (define creep-obs
      (hash-set (hash-set obs 'ally-units (reverse creep-ally-slice-rev))
                'enemy-units
                (reverse creep-enemy-slice-rev)))
    (define raw-creep-acts (plan-multi-highway-creep-spread creep-obs #:tracker creep-tr))
    (emit-direct-batch!
     (if (set-empty? direct-reserved-queen-ids)
         raw-creep-acts
         (filter (lambda (a)
                   (match a
                     [(list (or 'move 'attack-pos) uid tx ty)
                      #:when (and (exact-integer? uid)
                                  (set-member? direct-reserved-queen-ids uid)
                                  (real? tx) (real? ty))
                      (<= (direct-dist-to-nearest-th tx ty) 22.0)]
                     [(list (or 'cast 'cast-spell) uid (or 'spawn-creep-tumor 'spread-creep-tumor) tx ty)
                      #:when (and (exact-integer? uid)
                                  (set-member? direct-reserved-queen-ids uid)
                                  (real? tx) (real? ty))
                      (<= (direct-dist-to-nearest-th tx ty) 22.0)]
                     [_ #t]))
                 raw-creep-acts))))
  (when (or has-enemy-creep-tumor?
            (let ([et (hash-ref obs 'enemy-tumors '())]) (and (list? et) (pair? et))))
    (emit-direct-batch! (plan-counter-creep-clearing obs)))
  (when has-ally-changeling-or-overseer?
    (emit-direct-batch! (plan-changeling-free-unit-tactics obs)))
  (when has-enemy-changeling?
    (emit-direct-batch! (plan-counter-changeling-defense obs)))
  (when (or (and has-ally-dropperlord? has-ally-queen?) has-enemy-dropperlord?)
    (define exp-obs
      (if (set-empty? direct-reserved-queen-ids)
          obs
          (hash-set obs 'ally-units
                    (filter (lambda (u)
                              (not (and (hash? u)
                                        (set-member? direct-reserved-queen-ids (hash-ref u 'id -1)))))
                            ally-units))))
    (emit-direct-batch! (plan-dropperlord-queen-creep-expedition exp-obs #:tracker creep-tr)))
  (when (or (and has-ally-overseer? (pair? enemy-bldgs)) has-enemy-overseer?)
    (emit-direct-batch! (plan-overseer-contaminate-disruption obs)))

  ;; Direct Tactic #4: `wall-and-block-tactics.rkt`
  (when enemy-near-home?
    (emit-direct-batch! (plan-own-wall-integrity-defense obs)))
  (when (and has-ally-unwalled-punish-unit?
             (or (pair? enemy-bldgs)
                 (hash-ref obs 'scouted-enemy-choke? #f)
                 (hash-ref obs 'scouted-enemy-main? #f)))
    (define p-ex (exact->inexact (fast-finite-real (hash-ref obs 'enemy-x 160.0) 160.0)))
    (define p-ey (exact->inexact (fast-finite-real (hash-ref obs 'enemy-y 160.0) 160.0)))
    (define p-enx (exact->inexact (fast-finite-real (hash-ref obs 'enemy-natural-x (- p-ex 16.0)) (- p-ex 16.0))))
    (define p-eny (exact->inexact (fast-finite-real (hash-ref obs 'enemy-natural-y (- p-ey 16.0)) (- p-ey 16.0))))
    (define p-rx (hash-ref obs 'enemy-ramp-x #f))
    (define p-ry (hash-ref obs 'enemy-ramp-y #f))
    (define p-cx (hash-ref obs 'enemy-natural-choke-x #f))
    (define p-cy (hash-ref obs 'enemy-natural-choke-y #f))
    (define p-has-ramp? (and (real? p-rx) (real? p-ry)))
    (define p-has-choke? (and (real? p-cx) (real? p-cy)))
    (define p-rx-f (if p-has-ramp? (exact->inexact p-rx) 0.0))
    (define p-ry-f (if p-has-ramp? (exact->inexact p-ry) 0.0))
    (define p-cx-f (if p-has-choke? (exact->inexact p-cx) 0.0))
    (define p-cy-f (if p-has-choke? (exact->inexact p-cy) 0.0))
    (define (near-punish-zone? px py)
      (or (and (<= (abs (- px p-ex)) 24.0) (<= (abs (- py p-ey)) 24.0))
          (and (<= (abs (- px p-enx)) 24.0) (<= (abs (- py p-eny)) 24.0))
          (and p-has-ramp? (<= (abs (- px p-rx-f)) 14.0) (<= (abs (- py p-ry-f)) 14.0))
          (and p-has-choke? (<= (abs (- px p-cx-f)) 14.0) (<= (abs (- py p-cy-f)) 14.0))))
    (define p-ally-units
      (for/list ([u (in-list ally-units)]
                 #:when (and (hash? u)
                             (memq (unit-type-sym u) '(zergling adept hellion hellion-tank reaper))))
        u))
    (define p-enemy-bldgs
      (for/list ([b (in-list enemy-bldgs)]
                 #:when (and (hash? b)
                             (near-punish-zone? (exact->inexact (fast-finite-real (hash-ref b 'x 9999.0) 9999.0))
                                                (exact->inexact (fast-finite-real (hash-ref b 'y 9999.0) 9999.0)))))
        b))
    (define p-enemy-units
      (for/list ([e (in-list enemy-units)]
                 #:when (and (hash? e)
                             (not (hash-ref e 'flying #f))
                             (near-punish-zone? (exact->inexact (fast-finite-real (hash-ref e 'x 9999.0) 9999.0))
                                                (exact->inexact (fast-finite-real (hash-ref e 'y 9999.0) 9999.0)))))
        e))
    (define punish-obs
      (hash-set* obs
                 'ally-units p-ally-units
                 'enemy-buildings p-enemy-bldgs
                 'enemy-units p-enemy-units
                 'scouted-enemy-main? (or (pair? enemy-bldgs) (hash-ref obs 'scouted-enemy-main? #f))))
    (emit-direct-batch! (UnwalledPunishPlan-commands (plan-unwalled-opponent-punish punish-obs))))
  (when (or (<= frame 2800) has-ally-wall-block-bldg?)
    (define raw-block-acts (plan-expansion-and-gas-blocks obs))
    (define live-block-obs? (hash-has-key? obs 'mineral-harvesters))
    (define eff-block-acts
      (if (not live-block-obs?)
          raw-block-acts
          (let ([active-bases-now
                 (count (lambda (b)
                          (and (hash? b)
                               (memq (fast-canonical-structure-sym (unit-type-sym b))
                                     '(hatchery lair hive nexus command-center orbital-command planetary-fortress))))
                        ally-bldgs)]
                [mins-now (exact->inexact (fast-finite-real (hash-ref obs 'minerals 0.0) 0.0))])
            (if (and (>= active-bases-now 2) (>= mins-now 450.0) (>= frame 3360))
                raw-block-acts
                (filter (lambda (a)
                          (not (and (pair? a) (eq? (car a) 'build))))
                        raw-block-acts)))))
    (emit-direct-batch! eff-block-acts))
  (when (or (pair? enemy-bldgs)
            (and (<= frame 3600)
                 (>= (exact->inexact (fast-finite-real (hash-ref obs 'minerals 0.0) 0.0)) 180.0)))
    (define cegb-mins (exact->inexact (fast-finite-real (hash-ref obs 'minerals 0.0) 0.0)))
    (define cegb-bx (exact->inexact (fast-finite-real (hash-ref obs 'base-x 32.0) 32.0)))
    (define cegb-by (exact->inexact (fast-finite-real (hash-ref obs 'base-y 32.0) 32.0)))
    (define cegb-nx (exact->inexact (fast-finite-real (hash-ref obs 'natural-x (+ cegb-bx 16.0)) (+ cegb-bx 16.0))))
    (define cegb-ny (exact->inexact (fast-finite-real (hash-ref obs 'natural-y (+ cegb-by 16.0)) (+ cegb-by 16.0))))
    (define cegb-tx (exact->inexact (fast-finite-real (hash-ref obs 'third-x (+ cegb-bx 32.0)) (+ cegb-bx 32.0))))
    (define cegb-ty (exact->inexact (fast-finite-real (hash-ref obs 'third-y (+ cegb-by 8.0)) (+ cegb-by 8.0))))
    (define has-cegb-blocker?
      (for/or ([b (in-list enemy-bldgs)])
        (and (hash? b)
             (let ([bx (exact->inexact (fast-finite-real (hash-ref b 'x 9999.0) 9999.0))]
                   [by (exact->inexact (fast-finite-real (hash-ref b 'y 9999.0) 9999.0))])
               (or (and (<= (abs (- bx cegb-nx)) 6.5) (<= (abs (- by cegb-ny)) 6.5)
                        (<= (dist2d bx by cegb-nx cegb-ny) 6.5))
                   (and (<= (abs (- bx cegb-tx)) 6.5) (<= (abs (- by cegb-ty)) 6.5)
                        (<= (dist2d bx by cegb-tx cegb-ty) 6.5))
                   (and (memq (unit-type-sym b) '(refinery refinery-rich assimilator assimilator-rich extractor extractor-rich))
                        (or (<= (dist2d bx by cegb-bx cegb-by) 13.0)
                            (<= (dist2d bx by cegb-nx cegb-ny) 13.0))))))))
    (define cegb-own-nat-built?
      (and (not has-cegb-blocker?)
           (>= cegb-mins 180.0)
           (for/or ([b (in-list ally-bldgs)])
             (and (hash? b)
                  (memq (unit-type-sym b) '(hatchery lair hive nexus command-center orbital-command planetary-fortress))
                  (<= (dist2d cegb-nx cegb-ny
                              (exact->inexact (fast-finite-real (hash-ref b 'x -999.0) -999.0))
                              (exact->inexact (fast-finite-real (hash-ref b 'y -999.0) -999.0)))
                      5.5)))))
    (when (or has-cegb-blocker? (and (>= cegb-mins 180.0) (not cegb-own-nat-built?)))
      (define cegb-obs
        (if has-cegb-blocker?
            obs
            (hash-set* obs 'enemy-buildings '() 'ally-buildings '())))
      (emit-direct-batch! (plan-counter-expansion-and-gas-blocks cegb-obs))))

  ;; Direct Tactic #5a: `static-defense-tactics.rkt`
  ;; Direct Tactic #5b: `nydus-tactics.rkt`
  (when (or has-ally-static-def-or-nydus? has-enemy-static-def-or-nydus?)
    (emit-direct-batch! (plan-static-defense-actions obs))
    (emit-direct-batch! (plan-nydus-actions obs)))

  ;; Direct Tactic #6: `map-elements-and-experiments.rkt`
  (let ([neutrals (let ([v (hash-ref obs 'neutral-units '())]) (if (list? v) v '()))])
    (when (or (pair? neutrals)
              has-ally-map-elem-or-recall?
              has-enemy-map-elem-or-recall?)
      (define free-allies (unclaimed-ally-units-now))
      (define min-v (max 0 (let ([m (hash-ref obs 'minerals 400)]) (if (exact-integer? m) m 400))))
      (define gas-v (max 0 (let ([g (hash-ref obs 'gas 200)]) (if (exact-integer? g) g 200))))
      (define sup-v (max 0 (let ([s (hash-ref obs 'supply-left 12)]) (if (exact-integer? s) s 12))))
      (define epads (let ([ep (hash-ref obs 'expansion-pads '())]) (if (list? ep) ep '())))
      (define me-tr (rt-map-elem-tracker rt))
      (define me-acts
        (if (pair? neutrals)
            (let ([res
                   (step-map-elements-tactical-micro!
                    free-allies
                    ally-bldgs
                    enemy-units
                    neutrals
                    #:frame frame
                    #:minerals min-v
                    #:gas gas-v
                    #:supply-left sup-v
                    #:home-x base-x
                    #:home-y base-y
                    #:nat-x nat-x
                    #:nat-y nat-y
                    #:enemy-x enemy-x
                    #:enemy-y enemy-y
                    #:expansion-pads epads
                    #:tracker me-tr
                    #:validated-only? #t)])
              (hash-ref res 'actions '()))
            ;; When `neutrals` is empty, `step-map-elements-tactical-micro!` produces empty mineral-wall,
            ;; rock, and rebalance directives; running rescue + prism/recall planners directly preserves
            ;; exact actions without invoking `plan-nonstandard-base-resource-allocation`.
            (let* ([has-rescue-transport?
                    (for/or ([u (in-list free-allies)])
                      (and (hash? u)
                           (memq (unit-type-sym u) '(medivac warp-prism warp-prism-phasing overlord-transport dropperlord))))]
                   [has-ally-prism-or-nexus?
                    (or (for/or ([u (in-list free-allies)])
                          (and (hash? u) (memq (unit-type-sym u) '(warp-prism warp-prism-phasing mothership))))
                        (for/or ([b (in-list ally-bldgs)])
                          (and (hash? b) (memq (unit-type-sym b) '(nexus warp-gate)))))]
                   [has-enemy-prism-or-recall?
                    (for/or ([e (in-list enemy-units)])
                      (and (hash? e)
                           (or (memq (unit-type-sym e) '(warp-prism warp-prism-phasing mothership unknown))
                               (hash-ref e 'recalling? #f)
                               (hash-ref e 'is-recalling? #f)
                               (pair? (hash-ref e 'buffs '())))))]
                   [rescue-dirs
                    (if has-rescue-transport?
                        (plan-trapped-unit-dropship-rescue
                         free-allies ally-bldgs #:frame frame #:nat-x nat-x #:nat-y nat-y #:tracker me-tr)
                        '())]
                   [prism-recall-dirs
                    (if has-ally-prism-or-nexus?
                        (plan-warp-prism-and-recall-tactics
                         free-allies ally-bldgs enemy-units
                         #:frame frame #:minerals min-v #:gas gas-v #:supply-left sup-v
                         #:home-x base-x #:home-y base-y #:enemy-x enemy-x #:enemy-y enemy-y)
                        '())]
                   [counter-prism-dirs
                    (if has-enemy-prism-or-recall?
                        (plan-counter-warp-prism-and-recall
                         free-allies enemy-units #:frame frame #:home-x base-x #:home-y base-y)
                        '())])
              (if (and (null? rescue-dirs) (null? prism-recall-dirs) (null? counter-prism-dirs))
                  '()
                  (append (map-element-directives->sexps (append prism-recall-dirs counter-prism-dirs)
                                                       #:allow-unvalidated-spells? #f)
                          (dropship-rescues->sexps rescue-dirs #:validated-only? #t))))))
      (when (list? me-acts)
        (emit-direct-batch! me-acts))))

  ;; Direct Tactic #7: `situational-counter-planner.rkt`
  (when (and (or (pair? ally-units) (pair? ally-bldgs))
             (or has-any-enemy?
                 (hash-ref obs 'proxy-detected? #f)
                 (hash-ref obs 'our-army-trapped? #f)))
    (define cached-sit-vec (unbox (rt-sit-plan-cache rt)))
    (define sit-plan
      (if (and (vector? cached-sit-vec) (>= (vector-length cached-sit-vec) 4))
          (vector-ref cached-sit-vec 3)
          (evaluate-situational-counter-plan obs direct-our-race direct-enemy-race frame)))
    (define raw-sit-acts (situational-counter-plan-ability-actions sit-plan))
    (when (pair? raw-sit-acts)
      (define remapped-acts
        (let ([has-id-1? 'unknown]
              [first-eid 'unknown])
          (for/list ([act (in-list raw-sit-acts)]
                     #:when (let ([ok? (cond
                                         [(and (pair? act)
                                               (eq? (car act) 'cast-spell)
                                               (= (length act) 4)
                                               (equal? (cadddr act) 1))
                                          (when (eq? has-id-1? 'unknown)
                                            (set! has-id-1?
                                                  (for/or ([e (in-list enemy-units)])
                                                    (define eid (let ([id0 (hash-ref e 'id #f)]) (if id0 id0 (hash-ref e 'tag -1))))
                                                    (= eid 1)))
                                            (unless has-id-1?
                                              (set! first-eid
                                                    (for/or ([e (in-list enemy-units)])
                                                      (define id (let ([id0 (hash-ref e 'id #f)]) (if id0 id0 (hash-ref e 'tag -1))))
                                                      (and (exact-integer? id) (> id 0) id)))))
                                          (or has-id-1? first-eid)]
                                         [else #t])])
                              ok?))
            (if (and (pair? act)
                     (eq? (car act) 'cast-spell)
                     (= (length act) 4)
                     (equal? (cadddr act) 1)
                     (not has-id-1?))
                (list (car act) (cadr act) (caddr act) first-eid)
                act))))
      (emit-direct-batch! remapped-acts)))

  (define pre-valid-tags (ensure-rt-valid-enemy-tags! rt obs))
  (define sanitized-tactic-actions
    (sanitize-stale-target-actions (reverse (l34-ctx-actions ctx))
                                   obs
                                   #:pos-cache (rt-enemy-pos-cache rt)
                                   #:precomputed-valid-tags pre-valid-tags))
  (values sanitized-tactic-actions vanguard-count reserve-count))

(define (step-layer3-and-4-tactics! rt raw-obs fap-score #:sanitized? [sanitized? #f])
  (define ctx (rt-l34-ctx rt))
  (l34-phase1-setup! ctx rt raw-obs fap-score sanitized?)
  (l34-phase2-tbrain-drops! ctx)
  (l34-phase3-classify! ctx)
  (l34-phase4a-hazards-wm! ctx)
  (l34-phase4b-baneling-oracle! ctx)
  (l34-phase5a-wave-casters! ctx)
  (l34-phase5b-engage! ctx)
  (l34-phase6-raid-concave-reach! ctx)
  (define-values (sanitized-tactic-actions vanguard-count reserve-count)
    (l34-phase7-direct-tactics! ctx))
  (l34-clear-ctx-refs! ctx)
  (values sanitized-tactic-actions vanguard-count reserve-count))


;; =============================================================================
;; Layer 5: Human Cortex Camera Saccades, Ability Throttling & Token Filtering
;; =============================================================================

(define (step-layer5-human-cortex! rt raw-actions raw-obs #:sanitized? [sanitized? #f])
  (define obs (if sanitized? raw-obs (sanitize-obs-hash raw-obs)))
  (define frame (hash-ref obs 'frame 0))
  (define limiter (live-bot-runtime-cast-limiter rt))
  (define cortex (live-bot-runtime-cortex rt))
  (define nat-x (hash-ref obs 'natural-x 45.0))
  (define nat-y (hash-ref obs 'natural-y 45.0))

  ;; 1. Refractory ability cast limiter (cross Typed/Untyped boundary only for cast candidates)
  (define cast-acts
    (for/fold ([acc '()]) ([act (in-list raw-actions)])
      (if (and (pair? act)
               (let ([head (car act)])
                 (or (eq? head 'cast)
                     (eq? head 'cast-spell)
                     (eq? head 'use-ability)
                     (eq? head 'inject-larva))))
          (cons act acc)
          acc)))
  (define-values (unthrottled-actions spell-throttled)
    (if (null? cast-acts)
        (begin
          (throttle-ability-casts! limiter '() frame)
          (values raw-actions 0))
        (let-values ([(kept-casts throttled)
                      (throttle-ability-casts! limiter (reverse cast-acts) frame)])
          (if (= throttled 0)
              (values raw-actions 0)
              (let loop ([rem raw-actions] [krem kept-casts] [acc '()])
                (cond
                  [(null? rem) (values (reverse acc) throttled)]
                  [else
                   (define act (car rem))
                   (define cast?
                     (and (pair? act)
                          (let ([head (car act)])
                            (or (eq? head 'cast)
                                (eq? head 'cast-spell)
                                (eq? head 'use-ability)
                                (eq? head 'inject-larva)))))
                   (if (not cast?)
                       (loop (cdr rem) krem (cons act acc))
                       (if (and (pair? krem) (equal? act (car krem)))
                           (loop (cdr rem) (cdr krem) (cons act acc))
                           (loop (cdr rem) krem acc)))]))))))

  ;; 2. Selection & Control-Group Compiler + Per-Action Camera Framing for Un-Grouped Units
  (define base-x (hash-ref obs 'base-x 32.5))
  (define base-y (hash-ref obs 'base-y 32.5))
  (define ally-units (hash-ref obs 'ally-units '()))
  (define ally-bldgs (hash-ref obs 'ally-buildings '()))
  (define l5-sc (rt-l5-scratch rt))
  (define all-cgroup-member-ids (pooled-hasheqv! l5-sc 'all-cgroup-member-ids))
  (for ([g (in-range 1 7)])
    (for ([uid (in-list (cortex-get-control-group cortex g))])
      (when (exact-integer? uid)
        (hash-set! all-cgroup-member-ids uid #t))))
  (define unit-pos-cache #f)
  (define (get-unit-pos-by-id)
    (or unit-pos-cache
        (let ([ht (make-hasheqv)])
          (for ([r (in-list ally-units)])
            (when (hash? r)
              (define id (hash-ref r 'id #f))
              (define x (hash-ref r 'x #f))
              (define y (hash-ref r 'y #f))
              (when (and (exact-integer? id) (real? x) (real? y))
                (hash-set! ht id (cons (exact->inexact x) (exact->inexact y))))))
          (for ([r (in-list ally-bldgs)])
            (when (hash? r)
              (define id (hash-ref r 'id #f))
              (define x (hash-ref r 'x #f))
              (define y (hash-ref r 'y #f))
              (when (and (exact-integer? id) (real? x) (real? y))
                (hash-set! ht id (cons (exact->inexact x) (exact->inexact y))))))
          (set! unit-pos-cache ht)
          ht)))

  (define selection-compiled-actions
    (if (or (not (eq? (hash-ref raw-obs 'mineral-harvesters RUNTIME-MISSING) RUNTIME-MISSING))
            (hash-ref raw-obs 'compile-human-selections? #f))
        (cortex-collapse-and-compile-selections!
         cortex
         unthrottled-actions
         ally-units
         ally-bldgs)
        unthrottled-actions))

  (define cam-moved? #f)
  (define framed-actions
    (let loop ([rem selection-compiled-actions]
               [cx (human-cortex-cam-x cortex)]
               [cy (human-cortex-cam-y cortex)]
               [acc '()])
      (cond
        [(null? rem) (reverse acc)]
        [else
         (define act (car rem))
         (define-values (next-cx next-cy new-acc)
           (match act
             [(list 'move-camera (? real? mx) (? real? my))
              (set! cam-moved? #t)
              (cortex-move-camera! cortex (exact->inexact mx) (exact->inexact my))
              (values (exact->inexact mx) (exact->inexact my) (cons act acc))]
             [(list 'camera-focus _ (? real? mx) (? real? my))
              (set! cam-moved? #t)
              (cortex-move-camera! cortex (exact->inexact mx) (exact->inexact my))
              (values (exact->inexact mx) (exact->inexact my) (cons act acc))]
             [(list 'camera-focus (? real? mx) (? real? my))
              (set! cam-moved? #t)
              (cortex-move-camera! cortex (exact->inexact mx) (exact->inexact my))
              (values (exact->inexact mx) (exact->inexact my) (cons act acc))]
             [_
              (define focus
                (action-requires-camera-focus act all-cgroup-member-ids get-unit-pos-by-id base-x base-y))
              (if (and (pair? focus)
                       (not (in-camera-viewport? cx cy (car focus) (cdr focus))))
                  (let ([fx (safe-coord (car focus) cx)]
                        [fy (safe-coord (cdr focus) cy)])
                    (set! cam-moved? #t)
                    (cortex-move-camera! cortex fx fy)
                    (values fx fy (cons act (cons (list 'move-camera fx fy) acc))))
                  (values cx cy (cons act acc)))]))
         (loop (cdr rem) next-cx next-cy new-acc)])))

  ;; Fallback enemy focal check only when no per-action camera framing occurred
  (define enemy-units (hash-ref obs 'enemy-units '()))
  (define cam-actions
    (cond
      [cam-moved? '()]
      [(and (not (null? enemy-units))
            (not (in-camera-viewport? (human-cortex-cam-x cortex)
                                      (human-cortex-cam-y cortex)
                                      (hash-ref (car enemy-units) 'x nat-x)
                                      (hash-ref (car enemy-units) 'y nat-y))))
       (define tx (safe-coord (hash-ref (car enemy-units) 'x nat-x) nat-x))
       (define ty (safe-coord (hash-ref (car enemy-units) 'y nat-y) nat-y))
       (cortex-move-camera! cortex tx ty)
       (list (list 'move-camera tx ty))]
      [else
       (cortex-move-camera! cortex
                            (human-cortex-cam-x cortex)
                            (human-cortex-cam-y cortex))
       '()]))

  (define combined (append cam-actions framed-actions))
  (define-values (accepted dropped)
    (cortex-filter-actions! cortex combined))
  (values accepted dropped spell-throttled))

;; =============================================================================
;; Layer 5b: Pro-Human Camera Saccade (60-90 SPM) & APM/EPM Discipline Governor
;; =============================================================================

(define PRO-CAMERA-SACCADE-ZONES
  '(home-macro-base
    natural-expansion
    active-army-front
    harass-or-blocker-zone))

(define (step-pro-human-camera-and-apm-governor! rt [raw-obs (hash)] #:sanitized? [sanitized? #f])
  (define obs (if sanitized? raw-obs (sanitize-obs-hash raw-obs)))
  (define frame (hash-ref obs 'frame 0))
  (define cortex (live-bot-runtime-cortex rt))
  (define bmarks (human-cortex-camera-bookmarks cortex))
  (define base-x (hash-ref obs 'base-x 32.5))
  (define base-y (hash-ref obs 'base-y 32.5))
  (define nat-x (hash-ref obs 'natural-x 45.0))
  (define nat-y (hash-ref obs 'natural-y 45.0))
  (define enemy-x (hash-ref obs 'enemy-x 160.5))
  (define enemy-y (hash-ref obs 'enemy-y 160.5))
  (define enemy-exp-x (hash-ref obs 'enemy-expand-x 148.0))
  (define enemy-exp-y (hash-ref obs 'enemy-expand-y 148.0))
  (define enemy-units (hash-ref obs 'enemy-units '()))
  (define ally-bldgs (hash-ref obs 'ally-buildings '()))
  (define live-cam-obs?
    (not (eq? (hash-ref raw-obs 'mineral-harvesters RUNTIME-MISSING) RUNTIME-MISSING)))

  (define dwell-min
    (if live-cam-obs?
        (max 28 SC2-CAMERA-SACCADE-MIN-DWELL-FRAMES)
        SC2-CAMERA-SACCADE-MIN-DWELL-FRAMES))
  (define last-frame (hash-ref bmarks 'last-saccade-frame #f))
  (define cur-idx (safe-nonneg-int (hash-ref bmarks 'saccade-zone-idx 0) 0))
  ;; Pro humans dwell >= 28 frames (~1.25s) per camera zone in live games unless jumping > 18 tiles for a crisis.
  (define saccade-due?
    (or (not (exact-integer? last-frame))
        (= frame last-frame)
        (>= (abs (- frame last-frame)) dwell-min)))
  (define next-idx
    (cond
      [(not (exact-integer? last-frame)) 0]
      [saccade-due?
       (modulo (add1 cur-idx) (length PRO-CAMERA-SACCADE-ZONES))]
      [else (modulo cur-idx (length PRO-CAMERA-SACCADE-ZONES))]))
  (when saccade-due?
    (hash-set! bmarks 'last-saccade-frame frame)
    (hash-set! bmarks 'saccade-zone-idx next-idx))

  (define active-crisis-now?
    (let ([fbx (if (flonum? base-x) base-x (exact->inexact base-x))]
          [fby (if (flonum? base-y) base-y (exact->inexact base-y))]
          [fnx (if (flonum? nat-x) nat-x (exact->inexact nat-x))]
          [fny (if (flonum? nat-y) nat-y (exact->inexact nat-y))])
      (or (eq? (hash-ref obs 'under-attack #f) #t)
          (eq? (hash-ref obs 'under-cheese-rush #f) #t)
          (for/or ([b (in-list ally-bldgs)])
            (and (hash? b) (eq? (hash-ref b 'under-attack #f) #t)))
          (for/or ([e (in-list enemy-units)])
            (and (hash? e)
                 (let* ([rx (hash-ref e 'x 9999.0)]
                        [ry (hash-ref e 'y 9999.0)]
                        [ex (if (flonum? rx) rx (exact->inexact rx))]
                        [ey (if (flonum? ry) ry (exact->inexact ry))]
                        [dx1 (fl- ex fbx)]
                        [dy1 (fl- ey fby)]
                        [dx2 (fl- ex fnx)]
                        [dy2 (fl- ey fny)])
                   (or (fl<= (fl+ (fl* dx1 dx1) (fl* dy1 dy1)) 784.0)
                       (fl<= (fl+ (fl* dx2 dx2) (fl* dy2 dy2)) 784.0))))))))
  (define zone
    (if (and live-cam-obs? active-crisis-now? (not (null? enemy-units)))
        'active-army-front
        (list-ref PRO-CAMERA-SACCADE-ZONES next-idx)))
  (define-values (zx zy)
    (case zone
      [(home-macro-base)
       (values base-x base-y)]
      [(natural-expansion)
       (values nat-x nat-y)]
      [(active-army-front)
       (if (not (null? enemy-units))
           (values (safe-coord (hash-ref (car enemy-units) 'x nat-x) nat-x)
                   (safe-coord (hash-ref (car enemy-units) 'y nat-y) nat-y))
           (values (safe-coord (* 0.5 (+ nat-x enemy-x)) nat-x)
                   (safe-coord (* 0.5 (+ nat-y enemy-y)) nat-y)))]
      [(harass-or-blocker-zone)
       (values enemy-exp-x enemy-exp-y)]
      [else
       (values base-x base-y)]))

  (define prev-focus-f (hash-ref bmarks 'last-camera-focus-frame #f))
  (define prev-focus-x (safe-finite-real (hash-ref bmarks 'last-camera-focus-x zx) zx))
  (define prev-focus-y (safe-finite-real (hash-ref bmarks 'last-camera-focus-y zy) zy))
  (define crisis-cam-jump?
    (and active-crisis-now?
         (> (dist2d zx zy prev-focus-x prev-focus-y) 18.0)))
  (define emit-camera-focus?
    (or (not live-cam-obs?)
        (not (exact-integer? prev-focus-f))
        (< frame prev-focus-f)
        (>= (- frame prev-focus-f) 28)
        crisis-cam-jump?))
  (when emit-camera-focus?
    (hash-set! bmarks 'last-camera-focus-frame frame)
    (hash-set! bmarks 'last-camera-focus-x zx)
    (hash-set! bmarks 'last-camera-focus-y zy))

  (define prof (get-pro-cortex-profile (human-cortex-profile-name cortex)))
  (define target-apm (min 360 (safe-nonneg-int (hash-ref prof 'mean-epm 350) 350)))
  (if emit-camera-focus?
      (list (list 'camera-focus zone zx zy)
            (list 'human-apm-discipline target-apm 3 #t #t))
      (list (list 'human-apm-discipline target-apm 3 #t #t))))

;; =============================================================================
;; Top-Level 5-Layer Step (`step-live-bot-runtime!`)
;; =============================================================================

(define EXTENDED-STASIS-AND-DRILL-HEADS
  '(worker-drill-stack-attack
    evacuate-workers-from-stasis-ward
    trigger-stasis-ward-single-unit
    counter-enemy-worker-drill
    stasis-worker-stoppage-compensation
    return-workers-to-gather))

(define (step-live-bot-runtime! rt [obs-or-sexp (hash)])
  (define t0-step-ms (current-inexact-monotonic-milliseconds))
  (define raw-obs
    (cond
      [(hash? obs-or-sexp) obs-or-sexp]
      [(pair? obs-or-sexp) (parse-frame-state-sexp obs-or-sexp)]
      [(string? obs-or-sexp)
       (with-handlers ([exn:fail? (lambda (_e) (hash))])
         (parse-frame-state-sexp (read (open-input-string obs-or-sexp))))]
      [else (hash)]))
  (define obs (sanitize-obs-hash raw-obs))

  (set-live-bot-runtime-step-count! rt (add1 (live-bot-runtime-step-count rt)))
  (set-box! (rt-wall-aabbs-box rt) '())
  (vector-set! (rt-valid-tags-cache rt) 0 #f)

  ;; Layer 1
  (step-layer1-perception! rt obs #:sanitized? #t)
  ;; Layer 1b
  (define-values (posture-acts fap-score) (step-layer1b-mastermind! rt obs #:sanitized? #t))
  ;; Layer 1c (Generic k-Level Mirror-Mind Opponent Prediction Layer)
  ;; Cache unchanged midgame predictions up to 16 frames (~0.7s) in live games while running immediately on any change.
  (define step-frame-early (safe-nonneg-int (hash-ref obs 'frame 0) 0))
  (define door-st-cache (rt-door-state rt))
  (define mirror-cache (hash-ref door-st-cache 'mirror-cache #f))
  (define mirror-sig
    (list (length (hash-ref obs 'enemy-units '()))
          (length (hash-ref obs 'enemy-buildings '()))
          (length (hash-ref obs 'ally-buildings '()))
          (not (not (hash-ref obs 'under-attack #f)))))
  (define has-mh?
    (not (eq? (hash-ref raw-obs 'mineral-harvesters RUNTIME-MISSING) RUNTIME-MISSING)))
  (define run-mirror-now?
    (or (not has-mh?)
        (not (vector? mirror-cache))
        (<= step-frame-early 16)
        (< step-frame-early (vector-ref mirror-cache 0))
        (and (>= (- step-frame-early (vector-ref mirror-cache 0)) 16)
             (= (modulo step-frame-early 16) 8))
        (not (equal? mirror-sig (vector-ref mirror-cache 1)))))
  (define mirror-acts
    (cond
      [run-mirror-now?
       (define ma (step-layer1c-mirror-mind! rt obs))
       (hash-set! door-st-cache 'mirror-cache (vector step-frame-early mirror-sig ma))
       ma]
      [else '()]))
  (define mmstate-now (live-bot-runtime-mirror-mind rt))
  (define mmtech-now (and mmstate-now (mirror-mind-state-last-tech-observation mmstate-now)))
  (define obs-with-mirror
    (if mmstate-now
        (let* ([m-strat (mirror-mind-state-strategic-hypothesis mmstate-now)]
               [m-tact (mirror-mind-state-tactical-target mmstate-now)]
               [m-pre (mirror-mind-state-preemptive-counter-unit mmstate-now)]
               [m-pred (mirror-mind-state-predicted-enemy-unit mmstate-now)]
               [m-bases (mirror-mind-state-recommended-min-bases mmstate-now)]
               [m-verd (mirror-mind-state-mirror-macro-verdict mmstate-now)]
               [m-trust (mirror-mind-state-trust-mode mmstate-now)]
               [m-det? (and mmtech-now (enemy-tech-observation-requires-detection? mmtech-now))]
               [m-aa? (and mmtech-now (enemy-tech-observation-requires-anti-air? mmtech-now))]
               [m-upg (if mmtech-now (enemy-tech-observation-enemy-upgrade-advantage mmtech-now) 0)])
          (if (and (eq? (hash-ref obs 'mirror-strategy RUNTIME-MISSING) RUNTIME-MISSING)
                   (eq? (hash-ref obs 'mirror-tactical-target RUNTIME-MISSING) RUNTIME-MISSING)
                   (eq? (hash-ref obs 'mirror-preemptive-unit RUNTIME-MISSING) RUNTIME-MISSING)
                   (eq? (hash-ref obs 'mirror-predicted-enemy-unit RUNTIME-MISSING) RUNTIME-MISSING)
                   (eq? (hash-ref obs 'mirror-recommended-min-bases RUNTIME-MISSING) RUNTIME-MISSING)
                   (eq? (hash-ref obs 'mirror-macro-verdict RUNTIME-MISSING) RUNTIME-MISSING)
                   (eq? (hash-ref obs 'mirror-trust-mode RUNTIME-MISSING) RUNTIME-MISSING)
                   (eq? (hash-ref obs 'mirror-requires-detection? RUNTIME-MISSING) RUNTIME-MISSING)
                   (eq? (hash-ref obs 'mirror-requires-anti-air? RUNTIME-MISSING) RUNTIME-MISSING)
                   (eq? (hash-ref obs 'mirror-enemy-upgrade-advantage RUNTIME-MISSING) RUNTIME-MISSING))
              (hash-set* obs
                         'mirror-strategy m-strat
                         'mirror-tactical-target m-tact
                         'mirror-preemptive-unit m-pre
                         'mirror-predicted-enemy-unit m-pred
                         'mirror-recommended-min-bases m-bases
                         'mirror-macro-verdict m-verd
                         'mirror-trust-mode m-trust
                         'mirror-requires-detection? m-det?
                         'mirror-requires-anti-air? m-aa?
                         'mirror-enemy-upgrade-advantage m-upg)
              (let* ([o1 (if (eq? (hash-ref obs 'mirror-strategy RUNTIME-MISSING) RUNTIME-MISSING) (hash-set obs 'mirror-strategy m-strat) obs)]
                     [o2 (if (eq? (hash-ref o1 'mirror-tactical-target RUNTIME-MISSING) RUNTIME-MISSING) (hash-set o1 'mirror-tactical-target m-tact) o1)]
                     [o3 (if (eq? (hash-ref o2 'mirror-preemptive-unit RUNTIME-MISSING) RUNTIME-MISSING) (hash-set o2 'mirror-preemptive-unit m-pre) o2)]
                     [o4 (if (eq? (hash-ref o3 'mirror-predicted-enemy-unit RUNTIME-MISSING) RUNTIME-MISSING) (hash-set o3 'mirror-predicted-enemy-unit m-pred) o3)]
                     [o5 (if (eq? (hash-ref o4 'mirror-recommended-min-bases RUNTIME-MISSING) RUNTIME-MISSING) (hash-set o4 'mirror-recommended-min-bases m-bases) o4)]
                     [o6 (if (eq? (hash-ref o5 'mirror-macro-verdict RUNTIME-MISSING) RUNTIME-MISSING) (hash-set o5 'mirror-macro-verdict m-verd) o5)]
                     [o7 (if (eq? (hash-ref o6 'mirror-trust-mode RUNTIME-MISSING) RUNTIME-MISSING) (hash-set o6 'mirror-trust-mode m-trust) o6)]
                     [o8 (if (eq? (hash-ref o7 'mirror-requires-detection? RUNTIME-MISSING) RUNTIME-MISSING) (hash-set o7 'mirror-requires-detection? m-det?) o7)]
                     [o9 (if (eq? (hash-ref o8 'mirror-requires-anti-air? RUNTIME-MISSING) RUNTIME-MISSING) (hash-set o8 'mirror-requires-anti-air? m-aa?) o8)]
                     [o10 (if (eq? (hash-ref o9 'mirror-enemy-upgrade-advantage RUNTIME-MISSING) RUNTIME-MISSING) (hash-set o9 'mirror-enemy-upgrade-advantage m-upg) o9)])
                o10)))
        obs))
  ;; Layer 2
  (define econ-acts (step-layer2-economy! rt obs-with-mirror #:raw-obs raw-obs #:sanitized? #t))
  ;; Layer 3 & 4
  (define-values (tactic-acts vanguard-cnt reserve-cnt)
    (step-layer3-and-4-tactics! rt obs-with-mirror fap-score #:sanitized? #t))

  (define has-drill-head-passthrough?
    (and (hash? raw-obs)
         (or has-mh?
             (not (eq? (hash-ref raw-obs 'raw-mineral-harvesters RUNTIME-MISSING) RUNTIME-MISSING))
             (hash-ref raw-obs 'include-extended-drill-actions? #f))))
  (define raw-actions
    (if has-drill-head-passthrough?
        (append posture-acts econ-acts tactic-acts)
        (let ([acc-rev '()])
          (define (keep-non-drill! xs)
            (for ([a (in-list xs)])
              (unless (and (pair? a) (memq (car a) EXTENDED-STASIS-AND-DRILL-HEADS))
                (set! acc-rev (cons a acc-rev)))))
          (keep-non-drill! posture-acts)
          (keep-non-drill! econ-acts)
          (keep-non-drill! tactic-acts)
          (reverse acc-rev))))

  ;; Layer 5
  (define-values (accepted dropped spell-throttled)
    (step-layer5-human-cortex! rt raw-actions obs #:sanitized? #t))
  ;; Layer 5b: Pro-Human Camera Saccade (60-90 SPM) & APM/EPM Discipline Governor
  (define pro-apm-acts
    (step-pro-human-camera-and-apm-governor! rt obs #:sanitized? #t))
  (define cur-msp
    (let ([lt (live-bot-runtime-last-telemetry rt)])
      (and (hash? lt) (hash-ref lt 'max-supply-plan #f))))
  (define msp-set
    (if (and (max-supply-plan? cur-msp) (max-supply-plan-active? cur-msp))
        (max-supply-plan-combined-actions cur-msp)
        '()))
  (define accepted-ht-box #f)
  (define (get-accepted-ht)
    (unless accepted-ht-box
      (define ht (make-hash))
      (for ([a (in-list accepted)]) (hash-set! ht a #t))
      (set! accepted-ht-box ht))
    accepted-ht-box)
  (define msp-action-ht
    (and (pair? msp-set)
         (let ([ht (make-hash)])
           (for ([x (in-list msp-set)]) (hash-set! ht x #t))
           ht)))
  (define preserved-tactical-directives
    (let ([acc-rev '()]
          [splash-st-rt (rt-splash-state rt)])
      (define disruptor-dir-set
        (and (hash? splash-st-rt)
             (equal? (hash-ref splash-st-rt 'disruptor-directive-frame #f) step-frame-early)
             (hash-ref splash-st-rt 'disruptor-directive-set #f)))
      (define wave3-dir-set
        (and (hash? splash-st-rt)
             (equal? (hash-ref splash-st-rt 'wave3-preserved-frame #f) step-frame-early)
             (hash-ref splash-st-rt 'wave3-preserved-set #f)))
      (for ([a (in-list econ-acts)])
        (when (and (pair? a)
                   (let ([h (car a)])
                     (or (hash-ref PRESERVED-ECON-HEAD-SET h #f)
                         (and (or (eq? h 'cast) (eq? h 'cast-spell))
                              (pair? (cdr a))
                              (pair? (cddr a))
                              (hash-ref PRESERVED-ECON-CAST-SET (caddr a) #f))
                         (and msp-action-ht (hash-ref msp-action-ht a #f))))
                   (not (hash-ref (get-accepted-ht) a #f)))
          (set! acc-rev (cons a acc-rev))))
      (for ([a (in-list tactic-acts)])
        (when (and (pair? a)
                   (let ([h (car a)])
                     (or (hash-ref PRESERVED-TACTIC-HEAD-SET h #f)
                         (and (or (eq? h 'cast) (eq? h 'cast-spell))
                              (pair? (cdr a))
                              (pair? (cddr a))
                              (hash-ref PRESERVED-TACTIC-CAST-SET (caddr a) #f))
                         (and disruptor-dir-set (set-member? disruptor-dir-set a))
                         (and wave3-dir-set (set-member? wave3-dir-set a))))
                   (not (hash-ref (get-accepted-ht) a #f)))
          (set! acc-rev (cons a acc-rev))))
      (reverse acc-rev)))

  (define cortex (live-bot-runtime-cortex rt))
  (define mstate (live-bot-runtime-mastermind rt))
  (define mmstate (live-bot-runtime-mirror-mind rt))
  (define tbrain (live-bot-runtime-tactical-brain rt))
  (define oledger (live-bot-runtime-order-ledger rt))
  (define mmledger (mirror-mind-state-last-shadow-ledger mmstate))
  (define mmalloc (mirror-mind-state-toolbox-allocation mmstate))
  (define mmtech (mirror-mind-state-last-tech-observation mmstate))
  (define mmzs (mirror-mind-state-last-zero-sum-reading mmstate))
  (define scouted-sec-cnt
    (max 1 (length (hash-ref obs 'visible-sectors '(0 1 2 3)))))
  (define hist (live-bot-runtime-posture-history rt))
  (define recent-switches
    (max 1 (min 7 (sub1 (max 1 (length hist))))))
  (define pda
    (make-pda-trace #:scouted-sectors scouted-sec-cnt
                    #:posture-switches recent-switches
                    #:actions-emitted (+ (length accepted) dropped spell-throttled)
                    #:actions-dropped (+ dropped spell-throttled)))
  (define rplan
    (evaluate-random-stealth-harass-plan
     (live-bot-runtime-configured-race rt)
     (live-bot-runtime-actual-race rt)
     (hash-ref obs 'frame 0)))

  (define last-tel-ht
    (let ([t (live-bot-runtime-last-telemetry rt)])
      (if (hash? t) t (hash))))
  (define step-wall-aabbs (unbox (rt-wall-aabbs-box rt)))
  (define b-obs-frame (safe-nonneg-int (hash-ref obs 'frame 0) 0))
  (define b-enemy-race (hash-ref last-tel-ht 'effective-enemy-race (hash-ref obs 'enemy-race 'Unknown)))
  (define b-base-x (hash-ref obs 'base-x SC2-DEFAULT-HOME-BASE-X))
  (define b-base-y (hash-ref obs 'base-y SC2-DEFAULT-HOME-BASE-Y))
  (define b-enemy-x (hash-ref obs 'enemy-x SC2-DEFAULT-ENEMY-BASE-X))
  (define b-enemy-y (hash-ref obs 'enemy-y SC2-DEFAULT-ENEMY-BASE-Y))
  (define b-enemy-nat-x (hash-ref obs 'enemy-natural-x (hash-ref obs 'enemy-expand-x SC2-DEFAULT-ENEMY-EXPAND-X)))
  (define b-enemy-nat-y (hash-ref obs 'enemy-natural-y (hash-ref obs 'enemy-expand-y SC2-DEFAULT-ENEMY-EXPAND-Y)))
  (define b-base-fx (if (flonum? b-base-x) b-base-x (exact->inexact b-base-x)))
  (define b-base-fy (if (flonum? b-base-y) b-base-y (exact->inexact b-base-y)))
  (define b-enemy-fx (if (flonum? b-enemy-x) b-enemy-x (exact->inexact b-enemy-x)))
  (define b-enemy-fy (if (flonum? b-enemy-y) b-enemy-y (exact->inexact b-enemy-y)))
  (define b-enemy-nat-fx (if (flonum? b-enemy-nat-x) b-enemy-nat-x (exact->inexact b-enemy-nat-x)))
  (define b-enemy-nat-fy (if (flonum? b-enemy-nat-y) b-enemy-nat-y (exact->inexact b-enemy-nat-y)))
  (define b-wall-cnt 0)
  (define b-lowered-cnt 0)
  (define b-static-def-cnt 0)
  (define b-home-prod-cnt 0)
  (define b-gas-cnt 0)
  (define b-nat-taken? #f)
  (define b-proxy? #f)
  (for ([eb (in-list (hash-ref obs 'enemy-buildings '()))]
        #:when (hash? eb))
    (define bt (unit-type-sym eb))
    (define bf (fast-bayes-eb-flags bt))
    (unless (zero? bf)
      (when (not (zero? (bitwise-and bf 15)))
        (define need-wall? (bitwise-bit-set? bf 0))
        (define need-prod? (bitwise-bit-set? bf 1))
        (define need-th? (and (not b-nat-taken?) (bitwise-bit-set? bf 2)))
        (define need-proxy? (and (not b-proxy?) (> b-obs-frame 0) (bitwise-bit-set? bf 3)))
        (when (or need-wall? need-prod? need-th? need-proxy?)
          (define ex-raw (hash-ref eb 'x b-enemy-fx))
          (define ey-raw (hash-ref eb 'y b-enemy-fy))
          (define ex (if (flonum? ex-raw) ex-raw (exact->inexact ex-raw)))
          (define ey (if (flonum? ey-raw) ey-raw (exact->inexact ey-raw)))
          (when need-wall?
            (define dx (fl- ex b-enemy-nat-fx))
            (define dy (fl- ey b-enemy-nat-fy))
            (when (fl<= (fl+ (fl* dx dx) (fl* dy dy)) 256.0)
              (set! b-wall-cnt (add1 b-wall-cnt))))
          (when need-prod?
            (define dx (fl- ex b-enemy-fx))
            (define dy (fl- ey b-enemy-fy))
            (when (fl<= (fl+ (fl* dx dx) (fl* dy dy)) 900.0)
              (set! b-home-prod-cnt (add1 b-home-prod-cnt))))
          (when need-th?
            (define dx (fl- ex b-enemy-nat-fx))
            (define dy (fl- ey b-enemy-nat-fy))
            (when (fl<= (fl+ (fl* dx dx) (fl* dy dy)) 100.0)
              (set! b-nat-taken? #t)))
          (when need-proxy?
            (define dx (fl- ex b-base-fx))
            (define dy (fl- ey b-base-fy))
            (when (fl<= (fl+ (fl* dx dx) (fl* dy dy)) 2025.0)
              (set! b-proxy? #t)))))
      (when (bitwise-bit-set? bf 4)
        (set! b-lowered-cnt (add1 b-lowered-cnt)))
      (when (bitwise-bit-set? bf 5)
        (set! b-static-def-cnt (add1 b-static-def-cnt)))
      (when (bitwise-bit-set? bf 6)
        (set! b-gas-cnt (add1 b-gas-cnt)))))
  (define b-combat-cnt 0)
  (define b-air-harass? #f)
  (define b-near-home-cnt 0)
  (define b-min-home-d2 998001.0)
  (for ([eu (in-list (hash-ref obs 'enemy-units '()))]
        #:when (hash? eu))
    (define ut (unit-type-sym eu))
    (define ef (hash-ref BAYES-EU-FLAGS-HT ut 0))
    (when (and (not b-air-harass?) (bitwise-bit-set? ef 0))
      (set! b-air-harass? #t))
    (when (zero? (bitwise-and ef 2))
      (define ex-raw (hash-ref eu 'x b-enemy-fx))
      (define ey-raw (hash-ref eu 'y b-enemy-fy))
      (define ex (if (flonum? ex-raw) ex-raw (exact->inexact ex-raw)))
      (define ey (if (flonum? ey-raw) ey-raw (exact->inexact ey-raw)))
      (define dx (fl- ex b-base-fx))
      (define dy (fl- ey b-base-fy))
      (define d2 (fl+ (fl* dx dx) (fl* dy dy)))
      (set! b-combat-cnt (add1 b-combat-cnt))
      (when (fl<= d2 576.0)
        (set! b-near-home-cnt (add1 b-near-home-cnt)))
      (when (fl< d2 b-min-home-d2)
        (set! b-min-home-d2 d2))))
  (define b-min-home-dist (flsqrt b-min-home-d2))
  (define bc (rt-bayes-cache rt))
  (define u-scouted?
    (and (or (> b-wall-cnt 0)
             (> (hash-ref last-tel-ht 'last-seen-natural-frame 0) 0))
         #t))
  (define u-frame-ge? (>= b-obs-frame 1568))
  (define b-unwalled-post
    (if (and (vector-ref bc 6)
             (= (vector-ref bc 0) b-wall-cnt)
             (= (vector-ref bc 1) b-lowered-cnt)
             (eq? (vector-ref bc 2) u-scouted?)
             (eq? (vector-ref bc 3) b-enemy-race)
             (eq? (vector-ref bc 4) u-frame-ge?)
             (= (vector-ref bc 5) b-static-def-cnt))
        (vector-ref bc 6)
        (let ([res (compute-bayesian-unwalled-opponent-posterior
                    #:prior 0.35
                    #:wall-structure-count b-wall-cnt
                    #:lowered-depot-count b-lowered-cnt
                    #:door-gap-units (if (= b-wall-cnt 0) 2.5 0.0)
                    #:scouted-choke? u-scouted?
                    #:enemy-race b-enemy-race
                    #:frame (if u-frame-ge? 1568 0)
                    #:static-defense-count b-static-def-cnt)])
          (vector-set! bc 0 b-wall-cnt)
          (vector-set! bc 1 b-lowered-cnt)
          (vector-set! bc 2 u-scouted?)
          (vector-set! bc 3 b-enemy-race)
          (vector-set! bc 4 u-frame-ge?)
          (vector-set! bc 5 b-static-def-cnt)
          (vector-set! bc 6 res)
          res)))
  (define p-exp (cond [(< b-obs-frame 1500) 0] [(< b-obs-frame 3000) 1] [else 2]))
  (define p-nat? (and b-nat-taken? #t))
  (define p-main? (and (> (hash-ref last-tel-ht 'last-seen-main-frame 0) 0) #t))
  (define p-fbucket (cond [(< b-obs-frame 1800) 0] [(< b-obs-frame 2000) 1800] [(<= b-obs-frame 3600) 2000] [else 3601]))
  (define p-proxy? (and b-proxy? #t))
  (define p-early-combat (if (< b-obs-frame 3600) b-combat-cnt 0))
  (define b-proxy-post
    (if (and (vector-ref bc 18)
             (= (vector-ref bc 10) b-home-prod-cnt)
             (= (vector-ref bc 11) p-exp)
             (eq? (vector-ref bc 12) p-nat?)
             (eq? (vector-ref bc 13) p-main?)
             (= (vector-ref bc 14) b-gas-cnt)
             (= (vector-ref bc 15) p-fbucket)
             (eq? (vector-ref bc 16) p-proxy?)
             (= (vector-ref bc 17) p-early-combat))
        (vector-ref bc 18)
        (let ([res (compute-bayesian-proxy-all-in-posterior
                    #:prior 0.12
                    #:home-production-count b-home-prod-cnt
                    #:expected-home-production p-exp
                    #:enemy-natural-taken? p-nat?
                    #:scouted-enemy-main? p-main?
                    #:enemy-gas-count b-gas-cnt
                    #:frame p-fbucket
                    #:proxy-bldg-spotted? p-proxy?
                    #:early-enemy-combat-count p-early-combat
                    #:enemy-worker-deficit? #f)])
          (vector-set! bc 10 b-home-prod-cnt)
          (vector-set! bc 11 p-exp)
          (vector-set! bc 12 p-nat?)
          (vector-set! bc 13 p-main?)
          (vector-set! bc 14 b-gas-cnt)
          (vector-set! bc 15 p-fbucket)
          (vector-set! bc 16 p-proxy?)
          (vector-set! bc 17 p-early-combat)
          (vector-set! bc 18 res)
          res)))
  (define m-dist-bucket (cond [(fl>= b-min-home-dist 22.0) 22.0] [(fl< b-min-home-dist 14.0) 0.0] [else 15.0]))
  (define m-unwalled? (fl>= b-unwalled-post 0.55))
  (define m-air? (and b-air-harass? #t))
  (define m-unprot (if (>= b-obs-frame 4000) 1 0))
  (define m-harass-ready? (and (or (pair? tactic-acts) (>= (hash-ref obs 'army-supply 0) 12)) #t))
  (define m-under-atk? (>= b-near-home-cnt 4))
  (define m-attn (if (or b-air-harass? (> b-near-home-cnt 0)) 0.65 0.25))
  (define b-multi-prong-post
    (if (and (vector-ref bc 28)
             (eqv? (vector-ref bc 20) m-dist-bucket)
