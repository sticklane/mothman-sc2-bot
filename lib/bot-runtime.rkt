(define (l34-phase1-setup! ctx rt raw-obs fap-score sanitized?)
  (set-l34-ctx-actions! ctx '())
  (set-l34-ctx-bo-tplan-box! ctx #f)
  (define obs (if sanitized? raw-obs (sanitize-obs-hash raw-obs)))
  (define frame (hash-ref obs 'frame 0))
  (define oledger (live-bot-runtime-order-ledger rt))
  (define tbrain (live-bot-runtime-tactical-brain rt))
  (define ally-units (hash-ref obs 'ally-units '()))
  (define ally-bldgs (hash-ref obs 'ally-buildings '()))
  (define enemy-units (hash-ref obs 'enemy-units '()))
  (define enemy-bldgs (hash-ref obs 'enemy-buildings '()))
  (define effects (hash-ref obs 'effects '()))
  (define live-upgrades-tracked? (hash-has-key? raw-obs 'researched-upgrades))
  (define researched-upgs (hash-ref obs 'researched-upgrades '()))
  (define base-x (hash-ref obs 'base-x SC2-DEFAULT-HOME-BASE-X))
  (define base-y (hash-ref obs 'base-y SC2-DEFAULT-HOME-BASE-Y))
  (define nat-x (hash-ref obs 'natural-x SC2-DEFAULT-NATURAL-X))
  (define nat-y (hash-ref obs 'natural-y SC2-DEFAULT-NATURAL-Y))
  (define third-x (hash-ref obs 'third-x SC2-DEFAULT-THIRD-X))
  (define third-y (hash-ref obs 'third-y SC2-DEFAULT-THIRD-Y))
  (define enemy-x (hash-ref obs 'enemy-x SC2-DEFAULT-ENEMY-BASE-X))
  (define enemy-y (hash-ref obs 'enemy-y SC2-DEFAULT-ENEMY-BASE-Y))
  (define enemy-exp-x (hash-ref obs 'enemy-expand-x SC2-DEFAULT-ENEMY-EXPAND-X))
  (define enemy-exp-y (hash-ref obs 'enemy-expand-y SC2-DEFAULT-ENEMY-EXPAND-Y))
  (define enemy-third-x
    (let ([v (hash-ref raw-obs 'enemy-third-x #f)])
      (if (finite-real? v)
          (safe-coord v 132.0)
          (safe-coord (* 0.72 enemy-x) 132.0))))
  (define enemy-third-y
    (let ([v (hash-ref raw-obs 'enemy-third-y #f)])
      (if (finite-real? v)
          (safe-coord v 132.0)
          (safe-coord (* 0.72 enemy-y) 132.0))))
  (define pending-upgs (hash-ref obs 'pending-upgrades '()))

  (define leases (rt-role-leases rt))
  (define bstates (rt-bistable-states rt))
  (define splash-st (rt-splash-state rt))
  (define spotter-ht (rt-spotter-lings rt))
  (define live-tactics-obs? (hash-has-key? raw-obs 'mineral-harvesters))
  (define wave3-frame-box (rt-wave3-frame-box rt))
  (define splash-wm-disarmed-ht (hash-ref! splash-st 'wm-disarmed-ht make-hasheqv))
  (define splash-mode-dwell-ht (hash-ref! splash-st 'mode-dwell-ht make-hasheqv))
  (define splash-wm-dwell-ht (hash-ref! splash-st 'wm-dwell-ht make-hasheqv))
  (define splash-lib-dwell-ht (hash-ref! splash-st 'lib-dwell-ht make-hasheqv))
  (define splash-vik-dwell-ht (hash-ref! splash-st 'vik-dwell-ht make-hasheqv))
  (define splash-thor-dwell-ht (hash-ref! splash-st 'thor-dwell-ht make-hasheqv))
  (define splash-bc-jump-ht (hash-ref! splash-st 'bc-jump-ready-ht make-hasheqv))
  (define splash-bc-yamato-ht (hash-ref! splash-st 'bc-yamato-ready-ht make-hasheqv))
  (define splash-tank-dwell-ht (hash-ref! splash-st 'tank-dwell-ht make-hasheqv))
  (define prev-wave3-frame (unbox wave3-frame-box))
  (when (and (>= prev-wave3-frame 0) (< frame prev-wave3-frame))
    (reset-wave3-tactical-state! rt))
  (set-box! wave3-frame-box frame)
  (define spell-claims-rt (rt-spell-claims rt))
  (define unit-mode-tr (rt-unit-mode-tracker rt))
  (define transport-tr (rt-transport-tracker rt))
  (define l34-sc (rt-l34-scratch rt))
  (define wave3-handled-tags (pooled-mutable-seteqv! l34-sc 'wave3-handled-tags))
  (define snipe-locked-tags (pooled-mutable-seteqv! l34-sc 'snipe-locked-tags))
  (define wave3-preserved-set (pooled-mutable-set! l34-sc 'wave3-preserved-set))

  ;; ---------------------------------------------------------------------------
  ;; Zerg Zergling Spotter Scouts (Up to 3 Map Watch Posts, 0-APM Hold Until Needed)
  ;; ---------------------------------------------------------------------------
  (define under-tactics-base-attack?
    (let ([bx (if (flonum? base-x) base-x (exact->inexact base-x))]
          [by (if (flonum? base-y) base-y (exact->inexact base-y))]
          [nx (if (flonum? nat-x) nat-x (exact->inexact nat-x))]
          [ny (if (flonum? nat-y) nat-y (exact->inexact nat-y))])
      (for/or ([e (in-list enemy-units)])
        (define rx (hash-ref e 'x 9999.0))
        (define ry (hash-ref e 'y 9999.0))
        (define ex (if (flonum? rx) rx (exact->inexact rx)))
        (define ey (if (flonum? ry) ry (exact->inexact ry)))
        (define dx1 (fl- bx ex))
        (define dy1 (fl- by ey))
        (define dx2 (fl- nx ex))
        (define dy2 (fl- ny ey))
        (or (fl<= (fl+ (fl* dx1 dx1) (fl* dy1 dy1)) 676.0)
            (fl<= (fl+ (fl* dx2 dx2) (fl* dy2 dy2)) 676.0)))))
  (define door-st-tactics (rt-door-state rt))
  (set-l34-ctx-rt! ctx rt)
  (set-l34-ctx-raw-obs! ctx raw-obs)
  (set-l34-ctx-fap-score! ctx fap-score)
  (set-l34-ctx-obs! ctx obs)
  (set-l34-ctx-frame! ctx frame)
  (set-l34-ctx-oledger! ctx oledger)
  (set-l34-ctx-ally-units! ctx ally-units)
  (set-l34-ctx-ally-bldgs! ctx ally-bldgs)
  (set-l34-ctx-enemy-units! ctx enemy-units)
  (set-l34-ctx-enemy-bldgs! ctx enemy-bldgs)
  (set-l34-ctx-effects! ctx effects)
  (set-l34-ctx-live-upgrades-tracked?! ctx live-upgrades-tracked?)
  (set-l34-ctx-researched-upgs! ctx researched-upgs)
  (set-l34-ctx-base-x! ctx base-x)
  (set-l34-ctx-base-y! ctx base-y)
  (set-l34-ctx-nat-x! ctx nat-x)
  (set-l34-ctx-nat-y! ctx nat-y)
  (set-l34-ctx-third-x! ctx third-x)
  (set-l34-ctx-third-y! ctx third-y)
  (set-l34-ctx-enemy-x! ctx enemy-x)
  (set-l34-ctx-enemy-y! ctx enemy-y)
  (set-l34-ctx-enemy-exp-x! ctx enemy-exp-x)
  (set-l34-ctx-enemy-exp-y! ctx enemy-exp-y)
  (set-l34-ctx-enemy-third-x! ctx enemy-third-x)
  (set-l34-ctx-enemy-third-y! ctx enemy-third-y)
  (set-l34-ctx-pending-upgs! ctx pending-upgs)
  (set-l34-ctx-leases! ctx leases)
  (set-l34-ctx-bstates! ctx bstates)
  (set-l34-ctx-splash-st! ctx splash-st)
  (set-l34-ctx-live-tactics-obs?! ctx live-tactics-obs?)
  (set-l34-ctx-splash-wm-disarmed-ht! ctx splash-wm-disarmed-ht)
  (set-l34-ctx-splash-mode-dwell-ht! ctx splash-mode-dwell-ht)
  (set-l34-ctx-splash-wm-dwell-ht! ctx splash-wm-dwell-ht)
  (set-l34-ctx-splash-lib-dwell-ht! ctx splash-lib-dwell-ht)
  (set-l34-ctx-splash-vik-dwell-ht! ctx splash-vik-dwell-ht)
  (set-l34-ctx-splash-thor-dwell-ht! ctx splash-thor-dwell-ht)
  (set-l34-ctx-splash-bc-jump-ht! ctx splash-bc-jump-ht)
  (set-l34-ctx-splash-bc-yamato-ht! ctx splash-bc-yamato-ht)
  (set-l34-ctx-splash-tank-dwell-ht! ctx splash-tank-dwell-ht)
  (set-l34-ctx-spell-claims-rt! ctx spell-claims-rt)
  (set-l34-ctx-unit-mode-tr! ctx unit-mode-tr)
  (set-l34-ctx-transport-tr! ctx transport-tr)
  (set-l34-ctx-l34-sc! ctx l34-sc)
  (set-l34-ctx-wave3-handled-tags! ctx wave3-handled-tags)
  (set-l34-ctx-snipe-locked-tags! ctx snipe-locked-tags)
  (set-l34-ctx-wave3-preserved-set! ctx wave3-preserved-set)
  (set-l34-ctx-under-tactics-base-attack?! ctx under-tactics-base-attack?)
  (set-l34-ctx-door-st-tactics! ctx door-st-tactics)
  (when (and live-tactics-obs?
             (eq? (live-bot-runtime-actual-race rt) 'Zerg)
             (not under-tactics-base-attack?))
    (define map-dx (- enemy-x base-x))
    (define map-dy (- enemy-y base-y))
    (define map-d (max 1.0 (sqrt (+ (* map-dx map-dx) (* map-dy map-dy)))))
    (define map-px (/ (- map-dy) map-d))
    (define map-py (/ map-dx map-d))
    (define spotter-posts
      (list (list 'enemy-front
                  (safe-coord (+ enemy-exp-x (* 0.28 (- nat-x enemy-exp-x))) enemy-exp-x)
                  (safe-coord (+ enemy-exp-y (* 0.28 (- nat-y enemy-exp-y))) enemy-exp-y))
            (list 'enemy-third
                  (safe-coord (+ enemy-exp-x (* 14.0 map-px)) enemy-exp-x)
                  (safe-coord (+ enemy-exp-y (* 14.0 map-py)) enemy-exp-y))
            (list 'enemy-fourth
                  (safe-coord (+ (* 0.5 (+ nat-x enemy-exp-x)) (* -14.0 map-px)) nat-x)
                  (safe-coord (+ (* 0.5 (+ nat-y enemy-exp-y)) (* -14.0 map-py)) nat-y))))
    (define all-live-lings
      (for/list ([u (in-list ally-units)]
                 #:when (and (eq? (unit-type-sym u) 'zergling)
                             (not (or (eq? (hash-ref u 'is-hallucination #f) #t)
                                      (eq? (hash-ref u 'hallucination #f) #t)))))
        u))
    (for ([post (in-list spotter-posts)])
      (define pkey (first post))
      (define px (second post))
      (define py (third post))
      (define prev-entry (hash-ref spotter-ht pkey #f))
      (define prev-tag (and (hash? prev-entry) (hash-ref prev-entry 'tag #f)))
      (define cd-until (if (hash? prev-entry) (hash-ref prev-entry 'cooldown-until 0) 0))
      (define repost-after (if (hash? prev-entry) (hash-ref prev-entry 'repost-after 0) 0))
      (define live-spotter
        (and prev-tag
             (for/first ([u (in-list all-live-lings)]
                         #:when (equal? (hash-ref u 'id -1) prev-tag))
               u)))
      (cond
        [(and prev-tag (not live-spotter))
         (hash-set! spotter-ht pkey
                    (hash 'tag #f
                          'cooldown-until (max cd-until (+ frame 672))
                          'repost-after (+ frame 672)))]
        [(and (not live-spotter)
              (>= frame cd-until)
              (>= (length all-live-lings) 6))
         (define fpx (exact->inexact px))
         (define fpy (exact->inexact py))
         (define chosen #f)
         (define best-d2 +inf.0)
         (for ([u (in-list all-live-lings)])
           (unless (unit-leased-above? leases (hash-ref u 'id 0) 'army frame)
             (define dx (fl- fpx (exact->inexact (hash-ref u 'x px))))
             (define dy (fl- fpy (exact->inexact (hash-ref u 'y py))))
             (define d2 (fl+ (fl* dx dx) (fl* dy dy)))
             (when (fl< d2 best-d2)
               (set! chosen u)
               (set! best-d2 d2))))
         (when chosen
           (define sid (hash-ref chosen 'id 0))
           (acquire-unit-lease! leases sid 'spotter frame 32 #:x px #:y py)
           (hash-set! spotter-ht pkey
                      (hash 'tag sid 'cooldown-until 0 'repost-after 0))
           (when (fl> best-d2 6.25)
             (l34-emit! ctx (list 'move sid px py))))]
        [live-spotter
         (define sid (hash-ref live-spotter 'id 0))
         (define sx (hash-ref live-spotter 'x px))
         (define sy (hash-ref live-spotter 'y py))
         (acquire-unit-lease! leases sid 'spotter frame 32 #:x px #:y py)
         (define fsx (if (flonum? sx) sx (exact->inexact sx)))
         (define fsy (if (flonum? sy) sy (exact->inexact sy)))
         (define threat-near
           (for/first ([e (in-list enemy-units)]
                       #:when (let* ([rx (hash-ref e 'x 9999.0)]
                                     [ry (hash-ref e 'y 9999.0)]
                                     [dx (fl- fsx (if (flonum? rx) rx (exact->inexact rx)))]
                                     [dy (fl- fsy (if (flonum? ry) ry (exact->inexact ry)))])
                                (fl<= (fl+ (fl* dx dx) (fl* dy dy)) 81.0)))
             e))
         (cond
           [threat-near
            (define-values (rx ry)
              (compute-kite-vector sx sy
                                   (hash-ref threat-near 'x sx)
                                   (hash-ref threat-near 'y sy)
                                   6.0))
            (hash-set! spotter-ht pkey
                       (hash 'tag sid 'cooldown-until cd-until 'repost-after (+ frame 180)))
            (when (refractory-allow-action?! (live-bot-runtime-cooldown-tracker rt)
                                             (list 'spotter-evade sid)
                                             frame
                                             16)
              (l34-emit! ctx (list 'move sid (safe-coord rx nat-x) (safe-coord ry nat-y))))]
           [(< frame repost-after)
            (void)]
           [(<= (dist2d sx sy px py) 2.0)
            (void)]
           [(and (> (dist2d sx sy px py) 2.5)
                 (refractory-allow-action?! (live-bot-runtime-cooldown-tracker rt)
                                            (list 'spotter-move sid)
                                            frame
                                            28))
            (l34-emit! ctx (list 'move sid px py))])])))

  (define-values (combat-units ground-combat-units live-overseers stasis-frozen-tags
                  cu-cnt cu-sum-x cu-sum-y gcu-cnt gcu-sum-x gcu-sum-y)
    (let loop ([rem ally-units]
               [cu-rev '()] [gcu-rev '()] [ov-rev '()] [sf-ids '()]
               [cc 0] [cx 0.0] [cy 0.0]
               [gc 0] [gx 0.0] [gy 0.0])
      (if (null? rem)
          (values (reverse cu-rev) (reverse gcu-rev) (reverse ov-rev) sf-ids cc cx cy gc gx gy)
          (let* ([u (car rem)]
                 [ut (unit-type-sym u)]
                 [n-ov-rev
                  (if (and (or (eq? ut 'overseer) (eq? ut 'overseer-siege-mode))
                           (not (eq? (hash-ref u 'is-hallucination #f) #t))
                           (not (eq? (hash-ref u 'hallucination #f) #t)))
                      (cons u ov-rev)
                      ov-rev)]
                 [stasis-frozen?
                  (let ([b (hash-ref u 'buffs #f)])
                    (and (list? b)
                         (or (memq 'oracle-stasis-trap-target b)
                             (memq 'stasis-ward-target b))))]
                 [n-sf-ids
                  (if stasis-frozen?
                      (let ([sid (hash-ref u 'id (hash-ref u 'tag -1))])
                        (if (and (exact-integer? sid) (> sid 0))
                            (cons sid sf-ids)
                            sf-ids))
                      sf-ids)]
                 [combat?
                  (and (not stasis-frozen?)
                       (combat-unit-record? u)
                       (not (unit-leased-above? leases (hash-ref u 'id 0) 'army frame)))])
            (if (not combat?)
                (loop (cdr rem) cu-rev gcu-rev n-ov-rev n-sf-ids cc cx cy gc gx gy)
                (let* ([ux-raw (safe-finite-real (hash-ref u 'x nat-x) nat-x)]
                       [uy-raw (safe-finite-real (hash-ref u 'y nat-y) nat-y)]
                       [ux (if (flonum? ux-raw) ux-raw (exact->inexact ux-raw))]
                       [uy (if (flonum? uy-raw) uy-raw (exact->inexact uy-raw))]
                       [ncx (fl+ cx ux)]
                       [ncy (fl+ cy uy)])
                  (if (fast-unit-is-flying-sym? ut)
                      (loop (cdr rem) (cons u cu-rev) gcu-rev n-ov-rev n-sf-ids
                            (add1 cc) ncx ncy gc gx gy)
                      (loop (cdr rem) (cons u cu-rev) (cons u gcu-rev) n-ov-rev n-sf-ids
                            (add1 cc) ncx ncy (add1 gc) (fl+ gx ux) (fl+ gy uy)))))))))
  (define ft (perception-grid-squad-finger-tree (live-bot-runtime-perception rt)))
  (define total-dps (combat-measure-dps (ft-measure ft)))
  (define-values (vanguard-ft reserve-ft)
    (split-by-dps ft (exact-ceiling (* 0.70 total-dps))))
  (define vanguard-count (combat-measure-count (ft-measure vanguard-ft)))
  (define reserve-count (combat-measure-count (ft-measure reserve-ft)))

  ;; Compute primary army centroid early for Overseer escort & siege-line positioning
  (define prelim-army-cx
    (if (= cu-cnt 0)
        nat-x
        (safe-coord (fl/ cu-sum-x (exact->inexact cu-cnt)) nat-x)))
  (define prelim-army-cy
    (if (= cu-cnt 0)
        nat-y
        (safe-coord (fl/ cu-sum-y (exact->inexact cu-cnt)) nat-y)))
  (define ground-army-cx
    (if (= gcu-cnt 0)
        nat-x
        (safe-coord (fl/ gcu-sum-x (exact->inexact gcu-cnt)) nat-x)))
  (define ground-army-cy
    (if (= gcu-cnt 0)
        nat-y
        (safe-coord (fl/ gcu-sum-y (exact->inexact gcu-cnt)) nat-y)))
  (define first-stealth-threat-near-army
    (and (pair? live-overseers)
         (or (for/or ([e (in-list enemy-units)]) (l34-stealth-unit-or-bldg? e))
             (for/or ([e (in-list enemy-bldgs)]) (l34-stealth-unit-or-bldg? e)))
         (let ()
           (define cu-xs
             (for/list ([cu (in-list combat-units)]) (exact->inexact (hash-ref cu 'x base-x))))
           (define cu-ys
             (for/list ([cu (in-list combat-units)]) (exact->inexact (hash-ref cu 'y base-y))))
           (define (near-3-combat? e)
             (and (l34-stealth-unit-or-bldg? e)
                  (let ([ex0 (exact->inexact (hash-ref e 'x 9999.0))]
                        [ey0 (exact->inexact (hash-ref e 'y 9999.0))])
                    (let loop ([xs cu-xs] [ys cu-ys] [hits 0])
                      (cond
                        [(>= hits 3) #t]
                        [(null? xs) #f]
                        [else
                         (define dx (fl- ex0 (car xs)))
                         (define dy (fl- ey0 (car ys)))
                         (loop (cdr xs) (cdr ys)
                               (if (fl<= (fl+ (fl* dx dx) (fl* dy dy)) 196.0)
                                   (add1 hits)
                                   hits))])))))
           (or (for/first ([e (in-list enemy-units)] #:when (near-3-combat? e)) e)
               (for/first ([e (in-list enemy-bldgs)] #:when (near-3-combat? e)) e)))))
  (define reveal-assigned-ov-id
    (and first-stealth-threat-near-army
         (let ([ftx (exact->inexact (hash-ref first-stealth-threat-near-army 'x prelim-army-cx))]
               [fty (exact->inexact (hash-ref first-stealth-threat-near-army 'y prelim-army-cy))]
               [best-ov #f]
               [best-d2 +inf.0])
           (for ([ov (in-list live-overseers)])
             (define dx (fl- ftx (exact->inexact (hash-ref ov 'x base-x))))
             (define dy (fl- fty (exact->inexact (hash-ref ov 'y base-y))))
             (define d2 (fl+ (fl* dx dx) (fl* dy dy)))
             (when (fl< d2 best-d2)
               (set! best-ov ov)
               (set! best-d2 d2)))
           (and best-ov (hash-ref best-ov 'id #f)))))
  (define stealth-threats-near-army
    (if first-stealth-threat-near-army (list first-stealth-threat-near-army) '()))
  (for ([ov (in-list live-overseers)])
    (define ov-id (hash-ref ov 'id 0))
    (define ovx (hash-ref ov 'x base-x))
    (define ovy (hash-ref ov 'y base-y))
    (acquire-unit-lease! leases ov-id 'detector-escort frame 24
                         #:x prelim-army-cx #:y prelim-army-cy)
    (define fovx (if (flonum? ovx) ovx (exact->inexact ovx)))
    (define fovy (if (flonum? ovy) ovy (exact->inexact ovy)))
    (define allies-near-ov
      (let loop ([rem combat-units] [cnt 0])
        (cond
          [(or (>= cnt 3) (null? rem)) cnt]
          [else
           (define cu (car rem))
           (define cux (hash-ref cu 'x base-x))
           (define cuy (hash-ref cu 'y base-y))
           (define dx (fl- fovx (if (flonum? cux) cux (exact->inexact cux))))
           (define dy (fl- fovy (if (flonum? cuy) cuy (exact->inexact cuy))))
           (loop (cdr rem) (if (fl<= (fl+ (fl* dx dx) (fl* dy dy)) 144.0) (add1 cnt) cnt))])))
    (define (aa-near-ov? e)
      (define et (unit-type-sym e))
      (and (fast-can-attack-air? et)
           (let* ([rx (hash-ref e 'x 9999.0)]
                  [ry (hash-ref e 'y 9999.0)]
                  [dx (fl- fovx (if (flonum? rx) rx (exact->inexact rx)))]
                  [dy (fl- fovy (if (flonum? ry) ry (exact->inexact ry)))])
             (fl<= (fl+ (fl* dx dx) (fl* dy dy)) 132.25))))
    (define aa-threat-near-ov
      (and (< allies-near-ov 3)
           (or (for/first ([e (in-list enemy-units)] #:when (aa-near-ov? e)) e)
               (for/first ([e (in-list enemy-bldgs)] #:when (aa-near-ov? e)) e))))
    (cond
      [(and reveal-assigned-ov-id (equal? ov-id reveal-assigned-ov-id))
       (define thr (car stealth-threats-near-army))
       (define tx0 (hash-ref thr 'x prelim-army-cx))
       (define ty0 (hash-ref thr 'y prelim-army-cy))
       (define d-back (max 1.0 (dist2d tx0 ty0 prelim-army-cx prelim-army-cy)))
       (define stand-x (safe-coord (+ tx0 (* 8.5 (/ (- prelim-army-cx tx0) d-back))) prelim-army-cx))
       (define stand-y (safe-coord (+ ty0 (* 8.5 (/ (- prelim-army-cy ty0) d-back))) prelim-army-cy))
       (when (and (> (dist2d ovx ovy stand-x stand-y) 2.0)
                  (refractory-allow-action?! (live-bot-runtime-cooldown-tracker rt)
                                             (list 'ov-reveal ov-id)
                                             frame
                                             16))
         (l34-emit! ctx (list 'move ov-id stand-x stand-y)))]
      [(and (< allies-near-ov 3) aa-threat-near-ov)
       (define d-home (max 1.0 (dist2d ovx ovy base-x base-y)))
       (define rx (safe-coord (+ ovx (* 6.0 (/ (- base-x ovx) d-home))) base-x))
       (define ry (safe-coord (+ ovy (* 6.0 (/ (- base-y ovy) d-home))) base-y))
       (when (refractory-allow-action?! (live-bot-runtime-cooldown-tracker rt)
                                        (list 'ov-retreat ov-id)
                                        frame
                                        16)
         (l34-emit! ctx (list 'move ov-id rx ry)))]
      [(not (null? combat-units))
       (define d-home (max 1.0 (dist2d prelim-army-cx prelim-army-cy base-x base-y)))
       (define leash-x (safe-coord (+ prelim-army-cx (* 2.5 (/ (- base-x prelim-army-cx) d-home))) prelim-army-cx))
       (define leash-y (safe-coord (+ prelim-army-cy (* 2.5 (/ (- base-y prelim-army-cy) d-home))) prelim-army-cy))
       (when (and (> (dist2d ovx ovy leash-x leash-y) 2.2)
                  (refractory-allow-action?! (live-bot-runtime-cooldown-tracker rt)
                                             (list 'ov-escort ov-id)
                                             frame
                                             20))
         (l34-emit! ctx (list 'move ov-id leash-x leash-y)))]))

  (set-l34-ctx-combat-units! ctx combat-units)
  (set-l34-ctx-ft! ctx ft)
  (set-l34-ctx-ground-army-cx! ctx ground-army-cx)
  (set-l34-ctx-ground-army-cy! ctx ground-army-cy)
  (set-l34-ctx-prelim-army-cx! ctx prelim-army-cx)
  (set-l34-ctx-prelim-army-cy! ctx prelim-army-cy)
  (set-l34-ctx-reserve-count! ctx reserve-count)
  (set-l34-ctx-stasis-frozen-tags! ctx stasis-frozen-tags)
  (set-l34-ctx-tbrain! ctx tbrain)
  (set-l34-ctx-vanguard-count! ctx vanguard-count)
)

(define (l34-combat-eval-sig<? e1 e2)
  (define k1 (car e1))
  (define k2 (car e2))
  (define t1 (first k1))
  (define t2 (first k2))
  (cond
    [(symbol<? t1 t2) #t]
    [(not (eq? t1 t2)) #f]
    [else
     (define h1 (or (second k1) -1))
     (define h2 (or (second k2) -1))
     (cond
       [(< h1 h2) #t]
       [(> h1 h2) #f]
       [else
        (define s1 (or (third k1) -1))
        (define s2 (or (third k2) -1))
        (cond
          [(< s1 s2) #t]
          [(> s1 s2) #f]
          [else (< (fourth k1) (fourth k2))])])]))

(define (l34-summarize-for-combat-eval units)
  (if (null? units)
      '()
      (let ([ht (make-hash)])
        (for ([u (in-list units)])
          (define ut (unit-type-sym u))
          (define hp-raw (hash-ref u 'hp #f))
          (define hp-r
            (and (real? hp-raw) (= (- hp-raw hp-raw) 0)
                 (inexact->exact (round hp-raw))))
          (define sh-raw (or (hash-ref u 'shields #f) (hash-ref u 'shield #f)))
          (define sh-r
            (and (real? sh-raw) (= (- sh-raw sh-raw) 0)
                 (inexact->exact (round sh-raw))))
          (define fly?
            (or (eq? (hash-ref u 'flying? #f) #t)
                (eq? (hash-ref u 'is_flying #f) #t)
                (eq? (hash-ref u 'is-flying #f) #t)
                (fast-unit-is-flying-sym? ut)))
          (define buffs (hash-ref u 'buffs #f))
          (define bar?
            (or (eq? (hash-ref u 'barrier-active? #f) #t)
                (eq? (hash-ref u 'barrier? #f) #t)
                (and (list? buffs) (memq 'immortal-overload buffs) #t)))
          (define aam?
            (or (eq? (hash-ref u 'aam-debuff? #f) #t)
                (and (list? buffs) (memq 'anti-armor-missile buffs) #t)))
          (define gs?
            (or (eq? (hash-ref u 'guardian-shield? #f) #t)
                (and (list? buffs) (memq 'guardian-shield buffs) #t)))
          (define mask
            (bitwise-ior (if fly? 1 0)
                         (if bar? 2 0)
                         (if aam? 4 0)
                         (if gs? 8 0)))
          (define k (list ut hp-r sh-r mask))
          (hash-set! ht k (add1 (hash-ref ht k 0))))
        (sort (hash->list ht) l34-combat-eval-sig<?))))

(define (l34-sig->combat-hashes sig)
  (for/list ([entry (in-list sig)])
    (define k (car entry))
    (define cnt (cdr entry))
    (define ut (first k))
    (define hp-r (second k))
    (define sh-r (third k))
    (define mask (fourth k))
    (define fly? (bitwise-bit-set? mask 0))
    (define bar? (bitwise-bit-set? mask 1))
    (define aam? (bitwise-bit-set? mask 2))
    (define gs? (bitwise-bit-set? mask 3))
    (cond
      [(and hp-r sh-r)
       (hash 'type ut 'count cnt 'hp hp-r 'shields sh-r
             'flying? fly? 'barrier-active? bar? 'aam-debuff? aam? 'guardian-shield? gs?)]
      [hp-r
       (hash 'type ut 'count cnt 'hp hp-r
             'flying? fly? 'barrier-active? bar? 'aam-debuff? aam? 'guardian-shield? gs?)]
      [sh-r
       (hash 'type ut 'count cnt 'shields sh-r
             'flying? fly? 'barrier-active? bar? 'aam-debuff? aam? 'guardian-shield? gs?)]
      [else
       (hash 'type ut 'count cnt
             'flying? fly? 'barrier-active? bar? 'aam-debuff? aam? 'guardian-shield? gs?)])))

(define (l34-eval-combat-prediction! ctx)
  (define rt (l34-ctx-rt ctx))
  (define obs (l34-ctx-obs ctx))
  (define frame (l34-ctx-frame ctx))
  (define ally-bldgs (l34-ctx-ally-bldgs ctx))
  (define combat-units (l34-ctx-combat-units ctx))
  (define enemy-units (l34-ctx-enemy-units ctx))
  (define enemy-bldgs (l34-ctx-enemy-bldgs ctx))
  (define researched-upgs (l34-ctx-researched-upgs ctx))
  (define enemy-def-bldgs
    (for/list ([eb (in-list enemy-bldgs)]
               #:when (and (memq (unit-type-sym eb)
                                 '(photon-cannon spine-crawler spore-crawler bunker planetary-fortress missile-turret))
                           (>= (hash-ref eb 'build-progress 1.0) SC2-BUILD-COMPLETE-PROGRESS)))
      eb))
  (define th-coords
    (for/list ([b (in-list ally-bldgs)]
               #:when (bitwise-bit-set? (fast-ally-bldg-flags (unit-type-sym b)) 2))
      (cons (exact->inexact (safe-finite-real (hash-ref b 'x 0.0) 0.0))
            (exact->inexact (safe-finite-real (hash-ref b 'y 0.0) 0.0)))))
  (define (threat-within-14-of-th? e)
    (define ex0 (hash-ref e 'x #f))
    (define ey0 (hash-ref e 'y #f))
    (and (real? ex0) (real? ey0)
         (= (- ex0 ex0) 0) (= (- ey0 ey0) 0)
         (let ([fex (if (flonum? ex0) ex0 (exact->inexact ex0))]
               [fey (if (flonum? ey0) ey0 (exact->inexact ey0))])
           (for/or ([tc (in-list th-coords)])
             (define dx (fl- fex (car tc)))
             (define dy (fl- fey (cdr tc)))
             (fl<= (fl+ (fl* dx dx) (fl* dy dy)) 196.0)))))
  (define enemy-within-14-of-th?
    (and (pair? th-coords)
         (or (for/or ([e (in-list enemy-units)])
               (and (not (memq (unit-type-sym e) '(larva egg overlord observer changeling)))
                    (threat-within-14-of-th? e)))
             (for/or ([eb (in-list enemy-def-bldgs)])
               (threat-within-14-of-th? eb)))))
  (define eval-enemies
    (if (null? enemy-def-bldgs)
        enemy-units
        (append enemy-units enemy-def-bldgs)))
  (cond
    [(or (null? combat-units) (null? eval-enemies))
     (set-l34-ctx-combat-pred-ht! ctx #f)
     (set-l34-ctx-combat-pred-ratio! ctx (if (pair? combat-units) 10.0 #f))
     (set-l34-ctx-combat-should-engage?! ctx #t)
     (set-l34-ctx-enemy-within-14-of-th?! ctx enemy-within-14-of-th?)
     (set-l34-ctx-combat-suppress-attack?! ctx #f)]
    [else
     (define tb-mm (live-bot-runtime-mirror-mind rt))
     (define tb-mmtech (and tb-mm (mirror-mind-state-last-tech-observation tb-mm)))
     (define enemy-upgs
       (or (hash-ref obs 'enemy-upgrades #f)
           (and tb-mmtech (enemy-tech-observation-observed-upgrades tb-mmtech))
           '()))
     (define ally-sig (l34-summarize-for-combat-eval combat-units))
     (define enemy-sig (l34-summarize-for-combat-eval eval-enemies))
     (define pcache (rt-combat-pred-cache rt))
     (define pred-ht
       (if (and (vector-ref pcache 6)
                (eq? enemy-within-14-of-th? (vector-ref pcache 4))
                (equal? ally-sig (vector-ref pcache 0))
                (equal? enemy-sig (vector-ref pcache 1))
                (equal? researched-upgs (vector-ref pcache 2))
                (equal? enemy-upgs (vector-ref pcache 3)))
           (vector-ref pcache 6)
           (let ([res (combat:predict-engagement-outcome
                       (l34-sig->combat-hashes ally-sig)
                       (l34-sig->combat-hashes enemy-sig)
                       #:ally-upgrades researched-upgs
                       #:enemy-upgrades enemy-upgs
                       #:defending-home? enemy-within-14-of-th?)])
             (vector-set! pcache 0 ally-sig)
             (vector-set! pcache 1 enemy-sig)
             (vector-set! pcache 2 researched-upgs)
             (vector-set! pcache 3 enemy-upgs)
             (vector-set! pcache 4 enemy-within-14-of-th?)
             (vector-set! pcache 5 frame)
             (vector-set! pcache 6 res)
             res)))
     (define wstate (rt-wave-loss-state rt))
     (define pullback-active?
       (and (l34-ctx-live-obs? ctx)
            (or (< frame (hash-ref wstate 'pullback-until-frame -1))
                (let ([est-e (hash-ref wstate 'est-enemy-army-supply 0.0)]
                      [our-s (hash-ref wstate 'combat-army-supply (or (l34-ctx-live-combat-supply ctx) 0.0))])
                  (and (> est-e 0.0) (< our-s (* 0.85 est-e)))))))
     (define engage? (and (not pullback-active?) (hash-ref pred-ht 'should-engage? #t) #t))
     (define suppress? (and (or (not engage?) pullback-active?) (not enemy-within-14-of-th?)))
     (set-l34-ctx-combat-pred-ht! ctx pred-ht)
     (set-l34-ctx-combat-pred-ratio! ctx (hash-ref pred-ht 'predicted-lanchester-ratio #f))
     (set-l34-ctx-combat-should-engage?! ctx engage?)
     (set-l34-ctx-enemy-within-14-of-th?! ctx enemy-within-14-of-th?)
     (set-l34-ctx-combat-suppress-attack?! ctx suppress?)
     pred-ht]))

(define (l34-phase2-tbrain-drops! ctx)
  (l34-eval-combat-prediction! ctx)
  (define ally-bldgs (l34-ctx-ally-bldgs ctx))
  (define ally-units (l34-ctx-ally-units ctx))
  (define base-x (l34-ctx-base-x ctx))
  (define base-y (l34-ctx-base-y ctx))
  (define combat-pred-ratio (l34-ctx-combat-pred-ratio ctx))
  (define combat-should-engage? (l34-ctx-combat-should-engage? ctx))
  (define combat-suppress-attack? (l34-ctx-combat-suppress-attack? ctx))
  (define enemy-within-14-of-th? (l34-ctx-enemy-within-14-of-th? ctx))
  (define combat-units (l34-ctx-combat-units ctx))
  (define effects (l34-ctx-effects ctx))
  (define enemy-bldgs (l34-ctx-enemy-bldgs ctx))
  (define enemy-units (l34-ctx-enemy-units ctx))
  (define enemy-x (l34-ctx-enemy-x ctx))
  (define enemy-y (l34-ctx-enemy-y ctx))
  (define frame (l34-ctx-frame ctx))
  (define l34-sc (l34-ctx-l34-sc ctx))
  (define live-tactics-obs? (l34-ctx-live-tactics-obs? ctx))
  (define nat-x (l34-ctx-nat-x ctx))
  (define nat-y (l34-ctx-nat-y ctx))
  (define obs (l34-ctx-obs ctx))
  (define oledger (l34-ctx-oledger ctx))
  (define prelim-army-cx (l34-ctx-prelim-army-cx ctx))
  (define prelim-army-cy (l34-ctx-prelim-army-cy ctx))
  (define rt (l34-ctx-rt ctx))
  (define tbrain (l34-ctx-tbrain ctx))
  (define transport-tr (l34-ctx-transport-tr ctx))
  (define wave3-handled-tags (l34-ctx-wave3-handled-tags ctx))
  ;; ---------------------------------------------------------------------------
  ;; Multi-Depth Mirrored Tactical Micro Brain (0.5s, 2.0s, 5.0s Horizons)
  ;; ---------------------------------------------------------------------------
  (define-values (tbrain-actions tbrain-committed-tags _tbrain-decisions)
    (if (and (not (null? combat-units)) (not (null? enemy-units)))
        (let* ([tb-door (l34-ctx-door-st-tactics ctx)]
               [tb-disp (or (hash-ref obs 'bo-tactical-disposition #f)
                            (hash-ref obs 'tactical-disposition #f)
                            (and (hash? tb-door) (hash-ref tb-door 'bo-tactical-disposition #f)))]
               [tb-mm (live-bot-runtime-mirror-mind rt)]
               [tb-mmtech (and tb-mm (mirror-mind-state-last-tech-observation tb-mm))]
               [tb-eupgs (or (hash-ref obs 'enemy-upgrades #f)
                             (and tb-mmtech (enemy-tech-observation-observed-upgrades tb-mmtech))
                             '())]
               [tb-lr (or (hash-ref obs 'lanchester-ratio #f) combat-pred-ratio)])
          (step-tactical-mirror-brain! tbrain oledger obs
                                       #:record-ledger? #f
                                       #:tactical-disposition tb-disp
                                       #:lanchester-ratio tb-lr
                                       #:enemy-upgrades tb-eupgs
                                       #:combat-should-engage? combat-should-engage?
                                       #:defending-home? enemy-within-14-of-th?))
        (values '() (set) '())))
  (define tbrain-unit-actions (pooled-hasheqv! l34-sc 'tbrain-unit-actions))
  (for ([ta (in-list tbrain-actions)])
    (when (and (pair? ta) (>= (length ta) 2) (exact-integer? (second ta)))
      (define uid (second ta))
      (hash-set! tbrain-unit-actions uid
                 (append (hash-ref tbrain-unit-actions uid '()) (list ta)))))

  ;; ---------------------------------------------------------------------------
  ;; Scenario 9: Nuclear Strike / Nuke Calldown Alert Evasion (10.0 tiles)
  ;; ---------------------------------------------------------------------------
  (define nuke-alert (hash-ref obs 'nuke-alert #f))
  (when nuke-alert
    (define nx (if (pair? nuke-alert) (car nuke-alert) nat-x))
    (define ny (if (pair? nuke-alert) (cdr nuke-alert) nat-y))
    (for ([u (in-list ally-units)])
      (when (<= (dist2d nx ny (hash-ref u 'x nx) (hash-ref u 'y ny)) SC2-NUKE-EVASION-RADIUS)
        (l34-emit! ctx (list 'kite (hash-ref u 'id 101) base-x base-y)))))

  ;; ---------------------------------------------------------------------------
  ;; Scenario 4: Hidden / Corner Flying Building Search when Enemy Base Cleared
  ;; ---------------------------------------------------------------------------
  (when (and (hash-ref obs 'enemy-main-cleared #f)
             (null? enemy-units)
             (null? enemy-bldgs)
             (not (null? combat-units)))
    (define corners '((16.0 . 16.0) (16.0 . 240.0) (240.0 . 16.0) (240.0 . 240.0)))
    (for ([u (in-list combat-units)]
          [idx (in-naturals)])
      (define c (list-ref corners (modulo idx (length corners))))
      (l34-emit! ctx (list 'attack-pos (hash-ref u 'id 101) (car c) (cdr c)))))

  ;; ---------------------------------------------------------------------------
  ;; Pro Mechanic #4: Active Transport Juggling (Load/Unload, 10.0 tiles) & Multi-Prong Drop
  ;; ---------------------------------------------------------------------------
  (define-values (transports has-overlord?)
    (for/fold ([tr-rev '()] [ov? #f] #:result (values (reverse tr-rev) ov?))
              ([u (in-list ally-units)])
      (define ut (unit-type-sym u))
      (values (if (or (eq? ut 'warp-prism)
                      (eq? ut 'warp-prism-phasing)
                      (eq? ut 'medivac)
                      (eq? ut 'overlord-transport))
                  (cons u tr-rev)
                  tr-rev)
              (or ov? (eq? ut 'overlord)))))
  (define dead-tags-rt
    (let ([dt (hash-ref obs 'dead-tags '())])
      (if (null? dt)
          '()
          (for/list ([x (in-list dt)] #:when (exact-integer? x)) x))))
  (cond
    [live-tactics-obs?
     (define lair-or-hive-ok?
       (and has-overlord?
            (for/or ([b (in-list ally-bldgs)])
              (and (hash? b)
                   (let ([bt (unit-type-sym b)])
                     (or (eq? bt 'lair) (eq? bt 'hive)))
                   (>= (hash-ref b 'build-progress 1.0) 1.0)))))
     (define tr-dirs
       (cond
         [(and (null? transports)
               (or (not lair-or-hive-ok?)
                   (and (hash-has-key? obs 'mineral-harvesters)
                        (not (refractory-allow-action?! (live-bot-runtime-cooldown-tracker rt)
                                                        'zerg-ov-morph-check
                                                        frame
                                                        128)))))
          '()]
         [else
          (define check-ovi-morph? (and has-overlord? lair-or-hive-ok?))
          (define transport-combat-supply
            (if check-ovi-morph?
                (for/sum ([u (in-list combat-units)])
                  (unit-supply-cost (unit-type-sym u)))
                0.0))
          (define any-cargo?
            (for/or ([tr (in-list transports)])
              (or (pair? (hash-ref tr 'passengers '()))
                  (> (hash-ref tr 'cargo-space-taken 0) 0))))
          (define tr-pts
            (for/list ([tr (in-list transports)])
              (cons (exact->inexact (hash-ref tr 'x base-x))
                    (exact->inexact (hash-ref tr 'y base-y)))))
          (define-values (tr-min-x tr-max-x tr-min-y tr-max-y)
            (let loop ([pts tr-pts] [mnx +inf.0] [mxx -inf.0] [mny +inf.0] [mxy -inf.0])
              (if (null? pts)
                  (values mnx mxx mny mxy)
                  (let* ([pt (car pts)] [px (car pt)] [py (cdr pt)])
                    (loop (cdr pts)
                          (flmin mnx px) (flmax mxx px)
                          (flmin mny py) (flmax mxy py))))))
          (define effect-pts
            (if (null? effects)
                '()
                (for/list ([ef (in-list effects)]
                           #:when (hash? ef))
                  (cons (exact->inexact (hash-ref ef 'x base-x))
                        (exact->inexact (hash-ref ef 'y base-y))))))
          (define-values (eff-min-x eff-max-x eff-min-y eff-max-y)
            (if (null? effect-pts)
                (values +inf.0 -inf.0 +inf.0 -inf.0)
                (let loop ([pts effect-pts] [mnx +inf.0] [mxx -inf.0] [mny +inf.0] [mxy -inf.0])
                  (if (null? pts)
                      (values mnx mxx mny mxy)
                      (let* ([pt (car pts)] [px (car pt)] [py (cdr pt)])
                        (loop (cdr pts)
                              (flmin mnx px) (flmax mxx px)
                              (flmin mny py) (flmax mxy py)))))))
          (define (near-pts? pts x y r2)
            (let loop ([rem pts])
              (and (pair? rem)
                   (let* ([pt (car rem)]
                          [dx (fl- x (car pt))]
                          [dy (fl- y (cdr pt))])
                     (or (fl<= (fl+ (fl* dx dx) (fl* dy dy)) r2)
                         (loop (cdr rem)))))))
          (define tr-ally-slice
            (if (null? transports)
                (for/list ([u (in-list ally-units)]
                           #:when (eq? (unit-type-sym u) 'overlord))
                  u)
                (let ([passenger-id-ht
                       (and any-cargo?
                            (let ([ht (make-hasheqv)])
                              (for ([tr (in-list transports)])
                                (for ([p (in-list (hash-ref tr 'passengers '()))])
                                  (define pid (if (hash? p) (hash-ref p 'tag (hash-ref p 'id #f)) p))
                                  (when (exact-integer? pid) (hash-set! ht pid #t))))
                              ht))]
                      [tr-rad (if any-cargo? 25.0 12.5)]
                      [tr-r2 (if any-cargo? 625.0 156.25)]
                      [has-effs? (pair? effect-pts)]
                      [nearby-ground '()])
                  (define tr-bminx (fl- tr-min-x tr-rad))
                  (define tr-bmaxx (fl+ tr-max-x tr-rad))
                  (define tr-bminy (fl- tr-min-y tr-rad))
                  (define tr-bmaxy (fl+ tr-max-y tr-rad))
                  (define eff-bminx (fl- eff-min-x 6.0))
                  (define eff-bmaxx (fl+ eff-max-x 6.0))
                  (define eff-bminy (fl- eff-min-y 6.0))
                  (define eff-bmaxy (fl+ eff-max-y 6.0))
                  (define tr-core
                    (for/fold ([acc '()] #:result (reverse acc))
                              ([u (in-list ally-units)])
                      (define ut (unit-type-sym u))
                      (cond
                        [(or (eq? ut 'warp-prism)
                             (eq? ut 'warp-prism-phasing)
                             (eq? ut 'medivac)
                             (eq? ut 'overlord-transport)
                             (and lair-or-hive-ok? (eq? ut 'overlord))
                             (and passenger-id-ht
                                  (hash-ref passenger-id-ht (hash-ref u 'id -1) #f)))
                         (cons u acc)]
                        [(and (not (hash-ref RUNTIME-WORKER-SET ut #f))
                              (not (fast-unit-is-flying-sym? ut))
                              (not (hash-ref RUNTIME-STRUCT-SYM-SET ut #f)))
                         (define raw-x (hash-ref u 'x base-x))
                         (define raw-y (hash-ref u 'y base-y))
                         (define ux (if (flonum? raw-x) raw-x (exact->inexact raw-x)))
                         (define uy (if (flonum? raw-y) raw-y (exact->inexact raw-y)))
                         (define in-eff?
                           (and has-effs?
                                (fl>= ux eff-bminx) (fl<= ux eff-bmaxx)
                                (fl>= uy eff-bminy) (fl<= uy eff-bmaxy)
                                (near-pts? effect-pts ux uy 36.0)))
                         (when (or in-eff?
                                   (and (fl>= ux tr-bminx) (fl<= ux tr-bmaxx)
                                        (fl>= uy tr-bminy) (fl<= uy tr-bmaxy)
                                        (near-pts? tr-pts ux uy tr-r2)))
                           (define hp-pct (/ (exact->inexact (unit-total-hp-and-shield u))
                                             (max 1.0 (exact->inexact (hash-ref u 'max-hp 50)))))
                           (set! nearby-ground (cons (cons (if in-eff? (- hp-pct 2.0) hp-pct) u) nearby-ground)))
                         acc]
                        [else acc])))
                  (if (null? nearby-ground)
                      tr-core
                      (let ([capped-ground
                             (map cdr
                                  (take (sort nearby-ground < #:key car)
                                        (min (if any-cargo? 24 16) (length nearby-ground))))])
                        (append tr-core capped-ground))))))
          (define tr-enemy-slice
            (cond
              [(null? transports)
               (define ovi-pts
                 (for/list ([o (in-list tr-ally-slice)])
                   (cons (exact->inexact (hash-ref o 'x base-x))
                         (exact->inexact (hash-ref o 'y base-y)))))
               (if (null? ovi-pts)
                   '()
                   (for/list ([e (in-list enemy-units)]
                              #:when (near-pts? ovi-pts
                                                (exact->inexact (hash-ref e 'x 9999.0))
                                                (exact->inexact (hash-ref e 'y 9999.0))
                                                625.0))
                     e))]
              [any-cargo?
               (define ex-tgt (exact->inexact enemy-x))
               (define ey-tgt (exact->inexact enemy-y))
               (define scored
                 (for/fold ([acc '()])
                           ([e (in-list enemy-units)])
                   (define ex0 (exact->inexact (hash-ref e 'x 9999.0)))
                   (define ey0 (exact->inexact (hash-ref e 'y 9999.0)))
                   (define dt (for/fold ([m +inf.0]) ([pt (in-list tr-pts)])
                                (define dx (- ex0 (car pt)))
                                (define dy (- ey0 (cdr pt)))
                                (min m (+ (* dx dx) (* dy dy)))))
                   (define dx-e (- ex0 ex-tgt))
                   (define dy-e (- ey0 ey-tgt))
                   (define de (+ (* dx-e dx-e) (* dy-e dy-e)))
                   (define dmin (min dt de))
                   (if (<= dmin 625.0)
                       (cons (cons dmin e) acc)
                       acc)))
               (map cdr (take (sort scored < #:key car) (min 24 (length scored))))]
              [else
               (define e-bminx (fl- tr-min-x 19.0))
               (define e-bmaxx (fl+ tr-max-x 19.0))
               (define e-bminy (fl- tr-min-y 19.0))
               (define e-bmaxy (fl+ tr-max-y 19.0))
               (let loop ([rem enemy-units] [cnt 0] [acc '()])
                 (if (or (null? rem) (= cnt 24))
                     (reverse acc)
                     (let* ([e (car rem)]
                            [rx (hash-ref e 'x 9999.0)]
                            [ry (hash-ref e 'y 9999.0)]
                            [ex (if (flonum? rx) rx (exact->inexact rx))]
                            [ey (if (flonum? ry) ry (exact->inexact ry))])
                       (if (and (fl>= ex e-bminx) (fl<= ex e-bmaxx)
                                (fl>= ey e-bminy) (fl<= ey e-bmaxy)
                                (near-pts? tr-pts ex ey 361.0))
                           (loop (cdr rem) (add1 cnt) (cons e acc))
                           (loop (cdr rem) cnt acc)))))]))
          (sync-transport-tracker! transport-tr transports frame #:dead-tags dead-tags-rt)
          (plan-transport-fleet-micro tr-ally-slice tr-enemy-slice
                                      #:tracker transport-tr
                                      #:current-frame frame
                                      #:home-x (exact->inexact base-x)
                                      #:home-y (exact->inexact base-y)
                                      #:effects effects
                                      #:warp-in-complete? (and (hash-ref obs 'warp-in-complete? #f) #t)
                                      #:warp-in-requested? (if (hash-has-key? obs 'warp-in-requested?)
                                                               (and (hash-ref obs 'warp-in-requested? #f) #t)
                                                               #t)
                                      #:lair-or-hive-ready? lair-or-hive-ok?
                                      #:combat-supply transport-combat-supply)]))
     (define transport-acted-tags (pooled-mutable-seteqv! l34-sc 'transport-acted-tags))
     (for ([td (in-list tr-dirs)])
       (define ttag (transport-directive-transport-tag td))
       (define act-kind (transport-directive-action td))
       (define ab-sym (transport-directive-ability td))
       (define sx (safe-coord (transport-directive-tx td) base-x))
       (define sy (safe-coord (transport-directive-ty td) base-y))
       (define translated
         (cond
           [(eq? act-kind 'transport-drop-moving)
            (list 'transport-juggle ttag (list ttag) sx sy)]
           [(and (eq? act-kind 'cast-spell) (eq? ab-sym 'morph-overlord-transport))
            (list 'morph ttag 'overlord-transport)]
           [(eq? act-kind 'load-unit)
            (define ptags
              (filter (lambda (p) (and (exact-integer? p) (> p 0) (not (= p ttag))))
                      (transport-directive-passenger-tags td)))
            (and (pair? ptags)
                 (list 'transport-juggle ttag ptags sx sy))]
           [(eq? act-kind 'transport-drop-point)
            (list 'transport-juggle ttag sx sy)]
           [(memq act-kind '(approach-save-pickup hold-and-reposition move-to-drop))
            (list 'move ttag sx sy)]
           [(memq act-kind '(medivac-boost morph-warp-prism-phasing morph-warp-prism-transport cast-spell))
            (list 'cast-spell ttag (or ab-sym 'unknown) ttag)]
           [else
            (list 'move ttag sx sy)]))
       (when translated
         (set-add! transport-acted-tags ttag)
         (set-add! wave3-handled-tags ttag)
         (l34-emit-preserved! ctx translated)))
     (for ([tr (in-list transports)]
           #:when (not (set-member? transport-acted-tags (hash-ref tr 'id 706))))
       (define tr-id (hash-ref tr 'id 706))
       (define tx (hash-ref tr 'x base-x))
       (define ty (hash-ref tr 'y base-y))
       (define tr-ut (unit-type-sym tr))
       (define-values (tr-fork-on? tr-fork-x tr-fork-y)
         (if (or (pair? (hash-ref tr 'passengers '()))
                 (> (hash-ref tr 'cargo-space-taken 0) 0)
                 (memq tr-ut '(warp-prism warp-prism-phasing)))
             (l34-bo-fork-coords ctx)
             (values #f enemy-x enemy-y)))
       (cond
         [(and tr-fork-on?
               (> (dist2d tx ty tr-fork-x tr-fork-y) 6.0)
               (refractory-allow-action?! (live-bot-runtime-cooldown-tracker rt)
                                          (list 'transport-escort tr-id)
                                          frame
                                          28))
          (l34-emit! ctx (list 'multi-prong-drop tr-id tr-fork-x tr-fork-y))]
         [(not (null? combat-units))
          (define escort-x prelim-army-cx)
          (define escort-y prelim-army-cy)
          (when (and (> (dist2d tx ty escort-x escort-y) 6.0)
                     (refractory-allow-action?! (live-bot-runtime-cooldown-tracker rt)
                                                (list 'transport-escort tr-id)
                                                frame
                                                20))
            (l34-emit! ctx (list (if combat-suppress-attack? 'move 'attack-pos) tr-id escort-x escort-y)))]
         [(and (> (dist2d tx ty nat-x nat-y) 8.0)
               (refractory-allow-action?! (live-bot-runtime-cooldown-tracker rt)
                                          (list 'transport-escort tr-id)
                                          frame
                                          20))
          (l34-emit! ctx (list (if combat-suppress-attack? 'move 'attack-pos) tr-id nat-x nat-y))]))]
    [else
     (define-values (tr-fork-on? tr-fork-x tr-fork-y)
       (if (pair? transports) (l34-bo-fork-coords ctx) (values #f enemy-x enemy-y)))
     (for ([tr (in-list transports)])
       (define tr-id (hash-ref tr 'id 706))
       (define tx (hash-ref tr 'x base-x))
       (define ty (hash-ref tr 'y base-y))
       (define wounded-passenger
         (findf (lambda (u)
                  (and (combat-unit-record? u)
                       (<= (dist2d tx ty (hash-ref u 'x tx) (hash-ref u 'y ty)) SC2-TRANSPORT-JUGGLE-RADIUS)
                       (or (< (hash-ref u 'hp 100) SC2-WOUNDED-PASSENGER-MIN-HP)
                           (< (/ (exact->inexact (hash-ref u 'hp 100))
                                 (max 1 (hash-ref u 'max-hp 100)))
                              SC2-WOUNDED-PASSENGER-HP-PCT))))
                combat-units))
       (cond
         [wounded-passenger
          (l34-emit! ctx (list 'transport-juggle tr-id (hash-ref wounded-passenger 'id 707) base-x base-y))]
         [else
          (l34-emit! ctx (list 'multi-prong-drop tr-id
                       (if tr-fork-on? tr-fork-x enemy-x)
                       (if tr-fork-on? tr-fork-y enemy-y)))]))])

  (set-l34-ctx-dead-tags-rt! ctx dead-tags-rt)
  (set-l34-ctx-tbrain-committed-tags! ctx tbrain-committed-tags)
  (set-l34-ctx-tbrain-unit-actions! ctx tbrain-unit-actions)
)

(define (l34-phase3-classify! ctx)
  (define ally-bldgs (l34-ctx-ally-bldgs ctx))
  (define ally-units (l34-ctx-ally-units ctx))
  (define base-x (l34-ctx-base-x ctx))
  (define base-y (l34-ctx-base-y ctx))
  (define combat-units (l34-ctx-combat-units ctx))
  (define effects (l34-ctx-effects ctx))
  (define enemy-bldgs (l34-ctx-enemy-bldgs ctx))
  (define enemy-units (l34-ctx-enemy-units ctx))
  (define enemy-x (l34-ctx-enemy-x ctx))
  (define enemy-y (l34-ctx-enemy-y ctx))
  (define l34-sc (l34-ctx-l34-sc ctx))
  (define live-tactics-obs? (l34-ctx-live-tactics-obs? ctx))
  (define nat-x (l34-ctx-nat-x ctx))
  (define nat-y (l34-ctx-nat-y ctx))
  (define obs (l34-ctx-obs ctx))
  (define prelim-army-cx (l34-ctx-prelim-army-cx ctx))
  (define prelim-army-cy (l34-ctx-prelim-army-cy ctx))
  ;; ---------------------------------------------------------------------------
  ;; Adversarial Countermeasure #5: Ramp Force-Field Corrosive-Bile Breaker
  ;; ---------------------------------------------------------------------------
  (define ravager-cast-tags (pooled-mutable-seteqv! l34-sc 'ravager-cast-tags))
  (define force-fields
    (let ([eff-ffs (if (null? effects)
                       '()
                       (for/list ([eff (in-list effects)]
                                  #:when (eq? (hash-ref eff 'type 'none) 'force-field))
                         eff))]
          [unit-ffs (for/list ([e (in-list enemy-units)]
                               #:when (eq? (unit-type-sym e) 'force-field))
                      e)])
      (cond
        [(null? eff-ffs) unit-ffs]
        [(null? unit-ffs) eff-ffs]
        [else (append eff-ffs unit-ffs)])))
  (when (not (null? force-fields))
    (define ff (car force-fields))
    (define ffx (hash-ref ff 'x nat-x))
    (define ffy (hash-ref ff 'y nat-y))
    (define ravagers (for/list ([u (in-list combat-units)] #:when (eq? (unit-type-sym u) 'ravager)) u))
    (for ([rav (in-list (take ravagers (min 2 (length ravagers))))])
      (define rid (hash-ref rav 'id 140))
      (set-add! ravager-cast-tags rid)
      (l34-emit! ctx (list 'cast-spell rid 'corrosive-bile ffx ffy)))
    (for ([u (in-list combat-units)])
      (define ux (hash-ref u 'x base-x))
      (define uy (hash-ref u 'y base-y))
      (when (and (not (eq? (unit-type-sym u) 'ravager))
                 (<= (dist2d ffx ffy ux uy) SC2-FORCE-FIELD-STEPBACK-RADIUS))
        (l34-emit! ctx (list 'kite (hash-ref u 'id 101) base-x base-y)))))

  ;; ---------------------------------------------------------------------------
  ;; Adversarial Countermeasure #5b: Anti-Kite Defensive Leash (16.0 tiles)
  ;; ---------------------------------------------------------------------------
  (define lone-kiter?
    (and (= (length enemy-units) 1)
         (memq (unit-type-sym (car enemy-units))
               '(reaper hellion adept stalker oracle phoenix mutalisk))
         (< (length combat-units) SC2-LONE-KITER-MAX-DEFENDERS)))
  (when lone-kiter?
    (for ([u (in-list combat-units)])
      (when (and (memq (unit-type-sym u) '(zealot zergling roach immortal))
                 (> (dist2d base-x base-y (hash-ref u 'x base-x) (hash-ref u 'y base-y))
                    SC2-ANTI-KITE-LEASH-RADIUS))
        (l34-emit! ctx (list 'kite (hash-ref u 'id 101) nat-x nat-y)))))

  ;; ---------------------------------------------------------------------------
  ;; Pro Splash & Micro Countermeasures:
  ;;   1. Coalesced Hostile Ground Effects (`psi-storm`, `corrosive-bile`, `blinding-cloud`) &
  ;;      Enemy `disruptor-phased` (Purification Nova) Lateral Wing Evasion
  ;;   2. Enemy `widow-mine` / `widow-mine-burrowed` Out-Range Snipe, Lock Pull-Back & Bait
  ;;   3. Enemy `baneling` Light-Unit Radial Pre-Split (2.5x2.5 Bucketed)
  ;;   4. Enemy `hellion` & `lurker-burrowed` Collinear Lateral Scatter (+/- n-hat)
  ;;   5. Enemy `siege-tank-sieged` Line Discipline, Ravager Bile Stagger & 3-Flank Break
  ;; ---------------------------------------------------------------------------
  (define splash-evading-tags (pooled-mutable-seteqv! l34-sc 'splash-evading-tags))
  (define disruptor-handled-tags (pooled-mutable-seteqv! l34-sc 'disruptor-handled-tags))
  (define disruptor-directive-set (pooled-mutable-set! l34-sc 'disruptor-directive-set))
  (define fprelim-cx (exact->inexact prelim-army-cx))
  (define fprelim-cy (exact->inexact prelim-army-cy))
  (define (prelim-dist2-le? obj r2)
    (define ox (hash-ref obj 'x 9999.0))
    (define oy (hash-ref obj 'y 9999.0))
    (if (and (real? ox) (real? oy) (= (- ox ox) 0) (= (- oy oy) 0))
        (let ([dx (- fprelim-cx (exact->inexact ox))]
              [dy (- fprelim-cy (exact->inexact oy))])
          (<= (+ (* dx dx) (* dy dy)) r2))
        (<= (dist2d prelim-army-cx prelim-army-cy ox oy) (sqrt r2))))

  ;; Single-pass classification over ally-units, ally-bldgs, enemy-units, enemy-bldgs, combat-units
  (define ally-disruptor-units-rev '())
  (define ally-sentries-rev '())
  (define ally-overseers-rev '())
  (define ally-infestors-rev '())
  (define mode-candidates-rev '())
  (define ally-zerg-burrow-candidate? #f)
  (define ally-acc-mask 0)
  (define creep-ally-slice-rev '())
  (define creep-queen-xs '())
  (define creep-queen-ys '())
  (for ([u (in-list ally-units)])
    (define ut (unit-type-sym u))
    (define af (fast-ally-sym-flags ut))
    (set! ally-acc-mask (bitwise-ior ally-acc-mask af))
    (unless (zero? (bitwise-and af #x40489E))
      (when (bitwise-bit-set? af 1)
        (set! ally-disruptor-units-rev (cons u ally-disruptor-units-rev)))
      (when (bitwise-bit-set? af 2)
        (set! ally-sentries-rev (cons u ally-sentries-rev)))
      (when (bitwise-bit-set? af 3)
        (set! ally-overseers-rev (cons u ally-overseers-rev)))
      (when (bitwise-bit-set? af 4)
        (set! ally-infestors-rev (cons u ally-infestors-rev)))
      (when (bitwise-bit-set? af 7)
        (set! mode-candidates-rev (cons u mode-candidates-rev)))
      (when (and (not ally-zerg-burrow-candidate?)
                 (bitwise-bit-set? af 11)
                 (hash? u)
                 (or (hash-ref u 'burrowed #f)
                     (hash-ref u 'is-burrowed? #f)
                     (let* ([hp-raw (or (hash-ref u 'hp #f) (hash-ref u 'health #f) 100.0)]
                            [hp (exact->inexact (fast-finite-real hp-raw 100.0))]
                            [mhp-raw (or (hash-ref u 'max-hp #f) (hash-ref u 'health-max #f) hp)]
                            [mhp (max 1.0 (exact->inexact (fast-finite-real mhp-raw hp)))])
                       (<= hp (* 0.999 mhp)))))
        (set! ally-zerg-burrow-candidate? #t))
      (when (bitwise-bit-set? af 14)
        (set! creep-ally-slice-rev (cons u creep-ally-slice-rev))
        (define qx (hash-ref u 'x base-x))
        (define qy (hash-ref u 'y base-y))
        (set! creep-queen-xs (cons (if (flonum? qx) qx (exact->inexact qx)) creep-queen-xs))
        (set! creep-queen-ys (cons (if (flonum? qy) qy (exact->inexact qy)) creep-queen-ys)))
      (when (bitwise-bit-set? af 22)
        (set! creep-ally-slice-rev (cons u creep-ally-slice-rev)))))
  (define ally-unit-det? (bitwise-bit-set? ally-acc-mask 0))
  (define has-non-overlord-spotter? (bitwise-bit-set? ally-acc-mask 5))
  (define any-pro-caster? (bitwise-bit-set? ally-acc-mask 6))
  (define has-ally-roach? (bitwise-bit-set? ally-acc-mask 8))
  (define has-ally-ravager? (bitwise-bit-set? ally-acc-mask 9))
  (when (bitwise-bit-set? ally-acc-mask 10)
    (set! ally-zerg-burrow-candidate? #t))
  (define has-ally-swarm-host-or-locust? (bitwise-bit-set? ally-acc-mask 12))
  (define has-ally-zergling? (bitwise-bit-set? ally-acc-mask 13))
  (define has-ally-queen? (bitwise-bit-set? ally-acc-mask 14))
  (define has-ally-queen-or-tumor? (not (zero? (bitwise-and ally-acc-mask 49152))))
  (define has-ally-changeling-or-overseer? (bitwise-bit-set? ally-acc-mask 16))
  (define has-ally-dropperlord? (bitwise-bit-set? ally-acc-mask 17))
  (define has-ally-unwalled-punish-unit? (bitwise-bit-set? ally-acc-mask 18))
  (define has-ally-harass-sym? (bitwise-bit-set? ally-acc-mask 19))
  (define has-ally-static-def-or-nydus? (bitwise-bit-set? ally-acc-mask 20))
  (define has-ally-map-elem-or-recall? (bitwise-bit-set? ally-acc-mask 21))
  (define has-ally-scv? (bitwise-bit-set? ally-acc-mask 23))
  (define ally-disruptor-units (reverse ally-disruptor-units-rev))
  (define ally-sentries (reverse ally-sentries-rev))
  (define ally-overseers (reverse ally-overseers-rev))
  (define ally-infestors (reverse ally-infestors-rev))
  (define mode-candidates (reverse mode-candidates-rev))

  (define ally-bldg-acc 0)
  (define armory-ready-bldgs? #f)
  (define live-owned-townhalls 0)
  (define has-ally-wall-block-bldg? #f)
  (for ([b (in-list ally-bldgs)])
    (define bt (unit-type-sym b))
    (define bf (fast-ally-bldg-flags bt))
    (set! ally-bldg-acc (bitwise-ior ally-bldg-acc bf))
    (when (bitwise-bit-set? bf 2)
      (set! live-owned-townhalls (add1 live-owned-townhalls)))
    (when (and (not armory-ready-bldgs?)
               (bitwise-bit-set? bf 1)
               (hash? b)
               (>= (hash-ref b 'build-progress 1.0) 1.0))
      (set! armory-ready-bldgs? #t))
    (when (and (not has-ally-wall-block-bldg?)
               (bitwise-bit-set? bf 4)
               (hash? b)
               (< (hash-ref b 'build-progress 1.0) SC2-BUILD-COMPLETE-PROGRESS))
      (set! has-ally-wall-block-bldg? #t)))
  (define ally-bldg-det? (bitwise-bit-set? ally-bldg-acc 0))
  (when (bitwise-bit-set? ally-bldg-acc 3)
    (set! has-ally-queen-or-tumor? #t))
  (define has-ally-lowered-depot? (bitwise-bit-set? ally-bldg-acc 5))
  (when (bitwise-bit-set? ally-bldg-acc 6)
    (set! has-ally-static-def-or-nydus? #t))
  (when (bitwise-bit-set? ally-bldg-acc 7)
    (set! has-ally-map-elem-or-recall? #t))
  (define ally-has-detector? (or ally-unit-det? ally-bldg-det?))

  (define bx-fl (exact->inexact base-x))
  (define by-fl (exact->inexact base-y))
  (define nx-fl (exact->inexact nat-x))
  (define ny-fl (exact->inexact nat-y))
  (define enemy-near-home? #f)
  (define enemy-acc-mask 0)
  (define enemy-disruptor-units-rev '())
  (define enemy-widow-mines-rev '())
  (define enemy-banelings-rev '())
  (define linear-splash-enemies-rev '())
  (define enemy-stasis-eu-rev '())
  (define immobile-bile-eu-rev '())
  (define enemy-sieged-tanks-near-rev '())
  (define tank-lurker-hazards-rev '())
  (define enemy-air-or-colossus-rev '())
  (define enemy-massive-air-or-colossus-rev '())
  (define enemy-mutalisks-rev '())
  (define enemy-changelings-rev '())
  (define creep-enemy-slice-rev '())
  (define has-creep-queens? (pair? creep-queen-xs))
  (define visible-enemy-combat-supply 0.0)
  (define local-enemy-unit-val 0)
  (define enemy-unit-shimmer? #f)
  (define sum-eu-x 0.0)
  (define sum-eu-y 0.0)
  (for ([e (in-list enemy-units)])
    (define et (unit-type-sym e))
    (define einfo (fast-enemy-u-info et))
    (define ef (vector-ref einfo 0))
    (set! enemy-acc-mask (bitwise-ior enemy-acc-mask ef))
    (define ex-raw (hash-ref e 'x #f))
    (define ey-raw (hash-ref e 'y #f))
    (define fex-opt
      (cond
        [(flonum? ex-raw) (and (fl= (fl- ex-raw ex-raw) 0.0) ex-raw)]
        [(exact-integer? ex-raw) (->fl ex-raw)]
        [(and (real? ex-raw) (= (- ex-raw ex-raw) 0)) (exact->inexact ex-raw)]
        [else #f]))
    (define fey-opt
      (cond
        [(flonum? ey-raw) (and (fl= (fl- ey-raw ey-raw) 0.0) ey-raw)]
        [(exact-integer? ey-raw) (->fl ey-raw)]
        [(and (real? ey-raw) (= (- ey-raw ey-raw) 0)) (exact->inexact ey-raw)]
        [else #f]))
    (define coords-ok? (and fex-opt fey-opt))
    (define fex (or fex-opt 9999.0))
    (define fey (or fey-opt 9999.0))
    (define d2
      (if coords-ok?
          (let ([dx (fl- fprelim-cx fex)]
                [dy (fl- fprelim-cy fey)])
            (fl+ (fl* dx dx) (fl* dy dy)))
          (let ([d (dist2d prelim-army-cx prelim-army-cy
                           (or ex-raw 9999.0) (or ey-raw 9999.0))])
            (define fd (if (flonum? d) d (exact->inexact d)))
            (fl* fd fd))))
    (unless enemy-near-home?
      (let ([dx1 (fl- fex bx-fl)] [dy1 (fl- fey by-fl)]
            [dx2 (fl- fex nx-fl)] [dy2 (fl- fey ny-fl)])
        (when (or (fl<= (fl+ (fl* dx1 dx1) (fl* dy1 dy1)) 256.0)
                  (fl<= (fl+ (fl* dx2 dx2) (fl* dy2 dy2)) 256.0))
          (set! enemy-near-home? #t))))
    (define check-burrow? (and (not (zero? (bitwise-and ef #x3FFF)))
                               (not (zero? (bitwise-and ef #x90)))))
    (define e-burrowed?
      (and (or check-burrow? (not enemy-unit-shimmer?))
           (or (hash-ref e 'burrowed #f)
               (hash-ref e 'burrowed? #f)
               (hash-ref e 'is-burrowed? #f))))
    (unless (zero? (bitwise-and ef #x3FFF))
      (when (bitwise-bit-set? ef 0)
        (set! enemy-disruptor-units-rev (cons e enemy-disruptor-units-rev)))
      (when (bitwise-bit-set? ef 1)
        (set! enemy-widow-mines-rev (cons e enemy-widow-mines-rev)))
      (when (bitwise-bit-set? ef 2)
        (set! enemy-banelings-rev (cons e enemy-banelings-rev)))
      (when (or (bitwise-bit-set? ef 3)
                (and (bitwise-bit-set? ef 4) e-burrowed?))
        (set! linear-splash-enemies-rev (cons e linear-splash-enemies-rev)))
      (when (or (bitwise-bit-set? ef 5)
                (and (bitwise-bit-set? ef 6)
                     (or (hash-ref e 'sieged #f) (hash-ref e 'is-sieged? #f)))
                (and (or (bitwise-bit-set? ef 4) (bitwise-bit-set? ef 7))
                     (or e-burrowed?
                         (hash-ref e 'burrow-intent? #f)
                         (hash-ref e 'burrow-intent #f)
                         (hash-ref e 'burrowing? #f)
                         (hash-ref e 'is-burrowing? #f)
                         (hash-ref e 'preparing-burrow? #f))))
        (set! tank-lurker-hazards-rev (cons e tank-lurker-hazards-rev)))
      (when (bitwise-bit-set? ef 8)
        (set! enemy-stasis-eu-rev (cons e enemy-stasis-eu-rev)))
      (when (bitwise-bit-set? ef 9)
        (set! immobile-bile-eu-rev (cons e immobile-bile-eu-rev)))
      (when (and (bitwise-bit-set? ef 10) (fl<= d2 306.25))
        (set! enemy-sieged-tanks-near-rev (cons e enemy-sieged-tanks-near-rev)))
      (when (bitwise-bit-set? ef 11)
        (set! enemy-air-or-colossus-rev (cons e enemy-air-or-colossus-rev)))
      (when (bitwise-bit-set? ef 12)
        (set! enemy-massive-air-or-colossus-rev (cons e enemy-massive-air-or-colossus-rev)))
      (when (bitwise-bit-set? ef 13)
        (set! enemy-mutalisks-rev (cons e enemy-mutalisks-rev))))
    (when (or (bitwise-bit-set? ef 14)
              (eq? (hash-ref e 'changeling? #f) #t))
      (set! enemy-changelings-rev (cons e enemy-changelings-rev)))
    (when (and (bitwise-bit-set? ef 23)
               (not (eq? (hash-ref e 'is-hallucination #f) #t))
               (not (eq? (hash-ref e 'hallucination #f) #t))
               (not (eq? (hash-ref e 'hallucination? #f) #t)))
      (set! visible-enemy-combat-supply (+ visible-enemy-combat-supply (vector-ref einfo 1))))
    (when (fl<= d2 361.0)
      (set! local-enemy-unit-val (+ local-enemy-unit-val (vector-ref einfo 2))))
    (unless enemy-unit-shimmer?
      (when (or e-burrowed?
                (hash-ref e 'is-shimmer? #f)
                (hash-ref e 'cloaked #f)
                (hash-ref e 'is-cloaked? #f)
                (hash-ref e 'burrowed #f)
                (hash-ref e 'is-burrowed? #f)
                (let ([dt (hash-ref e 'display-type 1)])
                  (or (eq? dt 2) (eq? dt 'hidden) (not (exact-integer? dt))))
                (let ([cs (hash-ref e 'cloak-state 0)])
                  (or (eq? cs 2) (memq cs '(cloaked cloaked-detected)) (not (exact-integer? cs))))
                (let ([ck (hash-ref e 'cloak 0)])
                  (or (memq ck '(1 2 cloaked cloaked-detected))))
                (memq (unit-type-sym e)
                      '(lurker-burrowed roach-burrowed infestor-burrowed swarm-host-burrowed
                        widow-mine-burrowed baneling-burrowed ultralisk-burrowed
                        hydralisk-burrowed zergling-burrowed queen-burrowed drone-burrowed)))
        (set! enemy-unit-shimmer? #t)))
    (when (and has-creep-queens? (bitwise-bit-set? ef 25))
      (when (for/or ([qx (in-list creep-queen-xs)]
                     [qy (in-list creep-queen-ys)])
              (define dx (fl- fex qx))
              (define dy (fl- fey qy))
              (fl<= (fl+ (fl* dx dx) (fl* dy dy)) 49.0))
        (set! creep-enemy-slice-rev (cons e creep-enemy-slice-rev))))
    (if coords-ok?
        (begin
          (set! sum-eu-x (fl+ sum-eu-x fex))
          (set! sum-eu-y (fl+ sum-eu-y fey)))
        (begin
          (set! sum-eu-x (fl+ sum-eu-x (exact->inexact (fast-finite-real ex-raw enemy-x))))
          (set! sum-eu-y (fl+ sum-eu-y (exact->inexact (fast-finite-real ey-raw enemy-y)))))))
  (define has-enemy-static-det? (bitwise-bit-set? enemy-acc-mask 15))
  (define has-enemy-swarm-host-or-locust? (bitwise-bit-set? enemy-acc-mask 16))
  (define has-enemy-creep-tumor? (bitwise-bit-set? enemy-acc-mask 17))
  (define has-enemy-dropperlord? (bitwise-bit-set? enemy-acc-mask 18))
  (define has-enemy-overseer? (bitwise-bit-set? enemy-acc-mask 19))
  (define has-enemy-harass-sym? (bitwise-bit-set? enemy-acc-mask 20))
  (define has-enemy-static-def-or-nydus? (bitwise-bit-set? enemy-acc-mask 21))
  (define has-enemy-map-elem-or-recall? (bitwise-bit-set? enemy-acc-mask 22))
  (define has-enemy-burrow-or-sh-counter?
    (or enemy-unit-shimmer? (bitwise-bit-set? enemy-acc-mask 24)))
  (define enemy-disruptor-units (reverse enemy-disruptor-units-rev))
  (define enemy-widow-mines (reverse enemy-widow-mines-rev))
  (define enemy-banelings (reverse enemy-banelings-rev))
  (define linear-splash-enemies (reverse linear-splash-enemies-rev))
  (define enemy-sieged-tanks-near (reverse enemy-sieged-tanks-near-rev))
  (define tank-lurker-hazards (reverse tank-lurker-hazards-rev))
  (define enemy-air-or-colossus (reverse enemy-air-or-colossus-rev))
  (define enemy-massive-air-or-colossus (reverse enemy-massive-air-or-colossus-rev))
  (define enemy-mutalisks (reverse enemy-mutalisks-rev))
  (define enemy-changelings (reverse enemy-changelings-rev))
  (define has-enemy-changeling? (pair? enemy-changelings))

  (define enemy-stasis-eb-rev '())
  (define immobile-bile-eb-rev '())
  (define enemy-pfs-near-rev '())
  (define enemy-pf-list-rev '())
  (define local-enemy-bldg-val 0)
  (define sum-eb-x 0.0)
  (define sum-eb-y 0.0)
  (define enemy-bldg-acc 0)
  (for ([eb (in-list enemy-bldgs)])
    (define bt (unit-type-sym eb))
    (define binfo (fast-enemy-b-info bt))
    (define bf (vector-ref binfo 0))
    (set! enemy-bldg-acc (bitwise-ior enemy-bldg-acc bf))
    (define ex-raw (hash-ref eb 'x #f))
    (define ey-raw (hash-ref eb 'y #f))
    (define fex-opt
      (cond
        [(flonum? ex-raw) (and (fl= (fl- ex-raw ex-raw) 0.0) ex-raw)]
        [(exact-integer? ex-raw) (->fl ex-raw)]
        [(and (real? ex-raw) (= (- ex-raw ex-raw) 0)) (exact->inexact ex-raw)]
        [else #f]))
    (define fey-opt
      (cond
        [(flonum? ey-raw) (and (fl= (fl- ey-raw ey-raw) 0.0) ey-raw)]
        [(exact-integer? ey-raw) (->fl ey-raw)]
        [(and (real? ey-raw) (= (- ey-raw ey-raw) 0)) (exact->inexact ey-raw)]
        [else #f]))
    (define coords-ok? (and fex-opt fey-opt))
    (define fex (or fex-opt 9999.0))
    (define fey (or fey-opt 9999.0))
    (unless enemy-near-home?
      (let ([dx1 (fl- fex bx-fl)] [dy1 (fl- fey by-fl)]
            [dx2 (fl- fex nx-fl)] [dy2 (fl- fey ny-fl)])
        (when (or (fl<= (fl+ (fl* dx1 dx1) (fl* dy1 dy1)) 324.0)
                  (fl<= (fl+ (fl* dx2 dx2) (fl* dy2 dy2)) 324.0))
          (set! enemy-near-home? #t))))
    (unless (zero? (bitwise-and bf 120))
      (when (bitwise-bit-set? bf 3)
        (set! enemy-stasis-eb-rev (cons eb enemy-stasis-eb-rev)))
      (when (bitwise-bit-set? bf 4)
        (set! immobile-bile-eb-rev (cons eb immobile-bile-eb-rev)))
      (when (not (zero? (bitwise-and bf 96)))
        (define d2
          (if coords-ok?
              (let ([dx (fl- fprelim-cx fex)]
                    [dy (fl- fprelim-cy fey)])
                (fl+ (fl* dx dx) (fl* dy dy)))
              (let ([d (dist2d prelim-army-cx prelim-army-cy
                               (or ex-raw 9999.0) (or ey-raw 9999.0))])
                (define fd (if (flonum? d) d (exact->inexact d)))
                (fl* fd fd))))
        (when (bitwise-bit-set? bf 5)
          (set! enemy-pf-list-rev (cons eb enemy-pf-list-rev))
          (when (fl<= d2 306.25)
            (set! enemy-pfs-near-rev (cons eb enemy-pfs-near-rev))))
        (when (and (bitwise-bit-set? bf 6) (fl<= d2 361.0))
          (set! local-enemy-bldg-val (+ local-enemy-bldg-val (vector-ref binfo 1))))))
    (if coords-ok?
        (begin
          (set! sum-eb-x (fl+ sum-eb-x fex))
          (set! sum-eb-y (fl+ sum-eb-y fey)))
        (begin
          (set! sum-eb-x (fl+ sum-eb-x (exact->inexact (fast-finite-real ex-raw enemy-x))))
          (set! sum-eb-y (fl+ sum-eb-y (exact->inexact (fast-finite-real ey-raw enemy-y)))))))
  (when (and (not has-enemy-static-det?) (bitwise-bit-set? enemy-bldg-acc 0))
    (set! has-enemy-static-det? #t))
  (when (and (not has-enemy-creep-tumor?) (bitwise-bit-set? enemy-bldg-acc 1))
    (set! has-enemy-creep-tumor? #t))
  (when (and (not has-enemy-static-def-or-nydus?) (bitwise-bit-set? enemy-bldg-acc 2))
    (set! has-enemy-static-def-or-nydus? #t))
  (define enemy-stasis-traps
    (if (and (null? enemy-stasis-eu-rev) (null? enemy-stasis-eb-rev))
        '()
        (append (reverse enemy-stasis-eu-rev) (reverse enemy-stasis-eb-rev))))
  (define immobile-bile-targets
    (if (and live-tactics-obs?
             has-ally-ravager?
             (or (pair? immobile-bile-eu-rev) (pair? immobile-bile-eb-rev)))
        (append (reverse immobile-bile-eu-rev) (reverse immobile-bile-eb-rev))
        '()))
  (define enemy-pfs-near (reverse enemy-pfs-near-rev))
  (define enemy-pf-list (reverse enemy-pf-list-rev))

  (define have-siege-breaker-unit? #f)
  (define have-heavy-or-siege-breaker-unit? #f)
  (define local-ally-val 0)
  (define live-combat-supply 0.0)
  (define weighted-combat-units 0.0)
  (define ally-siege-tanks-rev '())
  (define ally-siege-supporters-rev '())
  (define ally-has-stealth? #f)
  (define any-ally-baneling? #f)
  (for ([u (in-list combat-units)])
    (define ut (unit-type-sym u))
    (unless have-siege-breaker-unit?
      (when (hash-ref RUNTIME-SIEGE-BREAKER-SET ut #f)
        (set! have-siege-breaker-unit? #t)))
    (unless have-heavy-or-siege-breaker-unit?
      (when (hash-ref RUNTIME-HEAVY-SB-SET ut #f)
        (set! have-heavy-or-siege-breaker-unit? #t)))
    (set! local-ally-val (+ local-ally-val (fast-res-cost-50 ut)))
    (set! live-combat-supply (+ live-combat-supply (unit-supply-cost ut)))
    (set! weighted-combat-units (+ weighted-combat-units (if (eq? ut 'zergling) 0.5 1.0)))
    (when (or (eq? ut 'siege-tank) (eq? ut 'siege-tank-sieged))
      (set! ally-siege-tanks-rev (cons u ally-siege-tanks-rev)))
    (when (hash-ref RUNTIME-SIEGE-SUPP-SET ut #f)
      (set! ally-siege-supporters-rev (cons u ally-siege-supporters-rev)))
    (unless ally-has-stealth?
      (when (or (hash-ref RUNTIME-STEALTH-SET ut #f)
                (hash-ref u 'cloaked #f)
                (hash-ref u 'burrowed #f))
        (set! ally-has-stealth? #t)))
    (unless any-ally-baneling?
      (when (eq? ut 'baneling) (set! any-ally-baneling? #t))))
  (define ally-siege-tanks (reverse ally-siege-tanks-rev))
  (define ally-siege-supporters (reverse ally-siege-supporters-rev))
  (define our-z-early
    (hash-ref obs 'our-terrain-z
              (if (not (null? combat-units)) (hash-ref (car combat-units) 'z 10.0) 10.0)))
  (define enemy-z-early
    (hash-ref obs 'enemy-terrain-z
              (if (not (null? enemy-units)) (hash-ref (car enemy-units) 'z 10.0) 10.0)))
  (define siege-uphill? (>= (- (exact->inexact enemy-z-early) (exact->inexact our-z-early)) 0.75))
  (define have-siege-breaker?
    (or have-siege-breaker-unit?
        (ormap (lambda (eff) (eq? (hash-ref eff 'type 'none) 'blinding-cloud)) effects)))
  (define have-heavy-or-siege-breaker?
    (or have-siege-breaker?
        have-heavy-or-siege-breaker-unit?))
  (define local-enemy-val
    (max 100 (+ local-enemy-unit-val local-enemy-bldg-val)))
  (define local-val-ratio (/ (exact->inexact local-ally-val) (exact->inexact local-enemy-val)))
  (define can-break-siege-line?
    (or (>= local-val-ratio (if siege-uphill? 1.55 1.40))
        (and (>= (hash-ref obs 'supply-used 0) 180)
             (or have-heavy-or-siege-breaker?
                 (>= local-val-ratio 1.25)))
        have-siege-breaker?))
  (define siege-shelling-friendly-structure?
    (and (pair? enemy-sieged-tanks-near)
         (ormap (lambda (st)
                  (define stx (hash-ref st 'x 9999.0))
                  (define sty (hash-ref st 'y 9999.0))
                  (ormap (lambda (b)
                           (<= (dist2d stx sty (hash-ref b 'x base-x) (hash-ref b 'y base-y)) 15.5))
                         ally-bldgs))
                enemy-sieged-tanks-near)))
  (define siege-line-hold?
    (and live-tactics-obs?
         (or (>= (length enemy-sieged-tanks-near) 2)
             (and (>= (length enemy-sieged-tanks-near) 1)
                  (not (null? enemy-pfs-near))))
         (not siege-shelling-friendly-structure?)
         (not can-break-siege-line?)))
