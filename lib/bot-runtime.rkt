      (if (list? s) s '())))
  (set-l2-ctx-prev-rush-fighting-wids! ctx prev-rush-fighting-wids)
  (set-l2-ctx-cur-rush-fighting-wids! ctx '())
  (set-l2-ctx-cur-rush-disengaging-wids! ctx '())
  (set-l2-ctx-rush-pool-builder-wid! ctx #f)
  (set-l2-ctx-worker-pull-emitted-1ab?! ctx #f)
  (define non-builder-defense-workers
    (filter (lambda (w)
              (and (not (worker-has-engine-build-order? w))
                   (not (order-ledger-unit-has-active-build? oledger-early (hash-ref w 'id 0) w))))
            workers))
  (set-l2-ctx-non-builder-defense-workers! ctx non-builder-defense-workers))

(define (l2-phase2-worker-rush! ctx)
  (define ally-bldgs (l2-ctx-ally-bldgs ctx))
  (define ally-combat-units (l2-ctx-ally-combat-units ctx))
  (define base-x (l2-ctx-base-x ctx))
  (define base-y (l2-ctx-base-y ctx))
  (define enemy-rush-workers (l2-ctx-enemy-rush-workers ctx))
  (define enemy-x (l2-ctx-enemy-x ctx))
  (define enemy-y (l2-ctx-enemy-y ctx))
  (define frame (l2-ctx-frame ctx))
  (define ground-enemy-units-for-cheese (l2-ctx-ground-enemy-units-for-cheese ctx))
  (define live-obs-harvesters? (l2-ctx-live-obs-harvesters? ctx))
  (define minerals (l2-ctx-minerals ctx))
  (define non-builder-defense-workers (l2-ctx-non-builder-defense-workers ctx))
  (define obs (l2-ctx-obs ctx))
  (define prev-rush-fighting-wids (l2-ctx-prev-rush-fighting-wids ctx))
  (define race (l2-ctx-race ctx))
  (define rush-def-st (l2-ctx-rush-def-st ctx))
  (define worker-rush-active? (l2-ctx-worker-rush-active? ctx))
  (define workers (l2-ctx-workers ctx))
  (when (and (or worker-rush-active? (not (null? prev-rush-fighting-wids)))
             (not (null? non-builder-defense-workers)))
    (define ready-townhall-coords
      (let ([pts (for/list ([b (in-list ally-bldgs)]
                            #:when (and (hash? b)
                                        (>= (hash-ref b 'build-progress 1.0) SC2-BUILD-COMPLETE-PROGRESS)
                                        (memq (fast-canonical-structure-sym (unit-type-sym b))
                                              '(hatchery lair hive nexus
                                                command-center orbital-command planetary-fortress))))
                   (cons (exact->inexact (hash-ref b 'x base-x))
                         (exact->inexact (hash-ref b 'y base-y))))])
        (if (null? pts)
            (list (cons (exact->inexact base-x) (exact->inexact base-y)))
            pts)))
    (define (dist-to-owned-townhall x y)
      (for/fold ([best +inf.0]) ([bc (in-list ready-townhall-coords)])
        (min best (dist2d x y (car bc) (cdr bc)))))
    (define base-mineral-patches
      (filter (lambda (mp)
                (and (hash? mp)
                     (<= (dist-to-owned-townhall
                          (hash-ref mp 'x base-x)
                          (hash-ref mp 'y base-y))
                         14.0)))
              (let ([mps (hash-ref obs 'mineral-patches '())])
                (if (list? mps) mps '()))))
    (define (dist-to-mineral-line x y)
      (if (null? base-mineral-patches)
          +inf.0
          (for/fold ([best +inf.0]) ([mp (in-list base-mineral-patches)])
            (min best (dist2d x y (hash-ref mp 'x base-x) (hash-ref mp 'y base-y))))))

    (define ew-cnt (max 1 (length enemy-rush-workers)))
    (define ew-cx
      (if (null? enemy-rush-workers)
          (exact->inexact enemy-x)
          (/ (for/sum ([ew (in-list enemy-rush-workers)]) (exact->inexact (hash-ref ew 'x base-x)))
             ew-cnt)))
    (define ew-cy
      (if (null? enemy-rush-workers)
          (exact->inexact enemy-y)
          (/ (for/sum ([ew (in-list enemy-rush-workers)]) (exact->inexact (hash-ref ew 'y base-y)))
             ew-cnt)))
    (define far-mp
      (and (not (null? base-mineral-patches))
           (argmax (lambda (mp)
                     (dist2d ew-cx ew-cy
                             (hash-ref mp 'x base-x)
                             (hash-ref mp 'y base-y)))
                   base-mineral-patches)))
    (define fallback-dx (- base-x ew-cx))
    (define fallback-dy (- base-y ew-cy))
    (define fallback-d (max 1.0 (sqrt (+ (* fallback-dx fallback-dx) (* fallback-dy fallback-dy)))))
    (define far-px
      (if far-mp
          (safe-coord (hash-ref far-mp 'x base-x) base-x)
          (safe-coord (+ base-x (* 4.0 (/ fallback-dx fallback-d))) base-x)))
    (define far-py
      (if far-mp
          (safe-coord (hash-ref far-mp 'y base-y) base-y)
          (safe-coord (+ base-y (* 4.0 (/ fallback-dy fallback-d))) base-y)))
    (define far-patch-id
      (if far-mp
          (safe-nonneg-int (hash-ref far-mp 'id 0) 0)
          (safe-nonneg-int (hash-ref obs 'mineral-patch-id 0) 0)))

    ;; Physical pull trigger: ONLY once rush workers enter <= 9.0 tiles of TownHall (<= 7.0 vs >= 8-worker all-ins
    ;; with 0 combat units so workers NEVER conga-line single-file out to an 8.8-tile ramp Pylon!),
    ;; <= 6.5 tiles of mineral line, or <= 4.5 tiles of an in-main friendly structure.
    (define heavy-worker-allin-no-army?
      (and (>= (length enemy-rush-workers) 8)
           (null? ally-combat-units)))
    (define rush-th-pull-rad (if heavy-worker-allin-no-army? 7.0 9.0))
    (define rush-bldg-th-rad (if heavy-worker-allin-no-army? 6.8 9.5))
    (define rush-chase-leash-rad (if heavy-worker-allin-no-army? 8.5 10.5))
    (define primary-engage-enemies
      (if worker-rush-active?
          (filter (lambda (ew)
                    (define ex (hash-ref ew 'x 9999.0))
                    (define ey (hash-ref ew 'y 9999.0))
                    (and (<= (dist-to-owned-townhall ex ey) rush-chase-leash-rad)
                         (or (<= (dist-to-owned-townhall ex ey) rush-th-pull-rad)
                             (<= (dist-to-mineral-line ex ey) 6.5)
                             (ormap (lambda (b)
                                      (and (hash? b)
                                           (<= (dist-to-owned-townhall
                                                (hash-ref b 'x base-x)
                                                (hash-ref b 'y base-y))
                                               rush-bldg-th-rad)
                                           (<= (dist2d ex ey
                                                       (hash-ref b 'x base-x)
                                                       (hash-ref b 'y base-y))
                                               4.5)))
                                    ally-bldgs))))
                  enemy-rush-workers)
          '()))
    (unless (null? primary-engage-enemies)
      (hash-set! rush-def-st 'last-rush-engage-frame frame))
    (define last-engage-frame (hash-ref rush-def-st 'last-rush-engage-frame -9999))
    ;; 14-frame hysteresis prevents ping-ponging between fighting and mining when enemy workers
    ;; step just outside `rush-th-pull-rad` (7.0 tiles).
    (define in-engage-hysteresis?
      (and worker-rush-active?
           (not (null? prev-rush-fighting-wids))
           (<= (- frame last-engage-frame) 14)))
    (define worker-rush-engage-enemies
      (cond
        [(not (null? primary-engage-enemies)) primary-engage-enemies]
        [in-engage-hysteresis?
         (filter (lambda (ew)
                   (<= (dist-to-owned-townhall
                        (hash-ref ew 'x 9999.0)
                        (hash-ref ew 'y 9999.0))
                       rush-chase-leash-rad))
                 enemy-rush-workers)]
        [else '()]))

    ;; Mixed Probe+Zealot / worker+combat rush detection near main mineral line
    (define enemy-combat-near-main
      (filter (lambda (e)
                (and (not (memq (unit-type-sym e) '(probe scv drone)))
                     (or (combat-unit-record? e)
                         (memq (fast-canonical-unit-sym (unit-type-sym e))
                               '(zealot zergling adept stalker marine reaper hellion hellbat roach marauder)))
                     (let ([ex (hash-ref e 'x 9999.0)]
                           [ey (hash-ref e 'y 9999.0)])
                       (or (<= (dist-to-owned-townhall ex ey) 11.0)
                           (<= (dist-to-mineral-line ex ey) 8.5)))))
              ground-enemy-units-for-cheese))
    (define mixed-worker-combat-rush?
      (and (not (null? enemy-combat-near-main))
           (not (null? enemy-rush-workers))))
    (define safe-evac-mp
      (if (and (not (null? enemy-combat-near-main))
               (not (null? base-mineral-patches)))
          (argmax (lambda (mp)
                    (define mpx (hash-ref mp 'x base-x))
                    (define mpy (hash-ref mp 'y base-y))
                    (for/fold ([best +inf.0]) ([ec (in-list enemy-combat-near-main)])
                      (min best (dist2d mpx mpy (hash-ref ec 'x 9999.0) (hash-ref ec 'y 9999.0)))))
                  base-mineral-patches)
          far-mp))
    (define evac-patch-id
      (if safe-evac-mp
          (safe-nonneg-int (hash-ref safe-evac-mp 'id 0) 0)
          far-patch-id))
    (define evac-px
      (if safe-evac-mp
          (safe-coord (hash-ref safe-evac-mp 'x far-px) far-px)
          far-px))
    (define evac-py
      (if safe-evac-mp
          (safe-coord (hash-ref safe-evac-mp 'y far-py) far-py)
          far-py))

    ;; 1.1s (24-frame) mineral-walk slide + 21-frame post-slide cooldown (`+45` total) for critically low
    ;; defenders (< 14 HP+shields) right after swinging inside <= 2.2t (with <= 10 HP early-warning fallback).
    (define eff-disengage-hp
      (if worker-rush-active?
          13.9
          SC2-FIGHTING-WORKER-DISENGAGE-HP))
    (define eff-reengage-hp
      (if (and worker-rush-active? (>= (length enemy-rush-workers) 8))
          6
          SC2-FIGHTING-WORKER-REENGAGE-HP))
    (define raw-disengage-cands '())
    (for ([w (in-list non-builder-defense-workers)])
      (define wid (hash-ref w 'id 10))
      (define whp (unit-total-hp-and-shield w))
      (define wx (hash-ref w 'x base-x))
      (define wy (hash-ref w 'y base-y))
      (define entry (hash-ref rush-def-st wid #f))
      (define prev-dis-until (cond [(pair? entry) (car entry)] [(exact-integer? entry) entry] [else 0]))
      (define prev-cd-until  (cond [(pair? entry) (cdr entry)] [(exact-integer? entry) entry] [else 0]))
      (define close-thresh
        (if (and worker-rush-active? (not mixed-worker-combat-rush?) (> whp 10))
            2.2
            6.0))
      (define enemy-close?
        (ormap (lambda (e)
                 (<= (dist2d wx wy (hash-ref e 'x 9999.0) (hash-ref e 'y 9999.0)) close-thresh))
               ground-enemy-units-for-cheese))
      (define w-cd (hash-ref w 'weapon-cooldown (hash-ref w 'weapon_cooldown #f)))
      (define just-swung-or-critical?
        (or (<= whp 10)
            (<= whp 5.5)
            (not (real? w-cd))
            (> w-cd 0.0)))
      (define probe-shield-depleted?
        (and worker-rush-active?
             (eq? (unit-type-sym w) 'probe)
             (or (< whp 14.0)
                 (and (<= (hash-ref w 'shield (hash-ref w 'max-shield 20)) 2)
                      (< (hash-ref w 'hp 20) 20)))))
      (define needs-disengage?
        (or (<= whp eff-disengage-hp)
            probe-shield-depleted?))
      (define update-timer?
        (and needs-disengage?
             enemy-close?
             just-swung-or-critical?
             (or (>= frame prev-cd-until)
                 (and (<= whp 10)
                      (>= frame prev-dis-until)))))
      (define new-dis-until (if update-timer? (+ frame 24) prev-dis-until))
      (define new-cd-until  (if update-timer? (+ frame 45) prev-cd-until))
      (define near-enemy-combat?
        (and mixed-worker-combat-rush?
             (ormap (lambda (ec)
                      (<= (dist2d wx wy (hash-ref ec 'x 9999.0) (hash-ref ec 'y 9999.0)) 3.8))
                    enemy-combat-near-main)))
      (define cornered-at-evac?
        (and (<= (dist2d wx wy evac-px evac-py) 2.0)
             (<= (for/fold ([best +inf.0]) ([ec (in-list enemy-combat-near-main)])
                   (min best (dist2d evac-px evac-py (hash-ref ec 'x 9999.0) (hash-ref ec 'y 9999.0))))
                 3.8)))
      (define disengaging-now?
        (or (< frame new-dis-until)
            (and near-enemy-combat? (not cornered-at-evac?))))
      (when disengaging-now?
        (set! raw-disengage-cands
              (cons (list w wid near-enemy-combat? whp update-timer? new-dis-until new-cd-until)
                    raw-disengage-cands))))
    (define max-noncrit-dis
      (if (>= (length enemy-rush-workers) 6)
          (max 1 (min 2 (- (length non-builder-defense-workers) (length enemy-rush-workers) -2)))
          999))
    (define sorted-disengage-cands
      (sort (reverse raw-disengage-cands) < #:key fourth))
    (define-values (kept-disengage-entries capped-stay-fighting-wids)
      (let loop ([rem sorted-disengage-cands] [kept-rev '()] [capped-rev '()] [noncrit-kept 0])
        (cond
          [(null? rem)
           (values (reverse kept-rev) (reverse capped-rev))]
          [else
           (define e (car rem))
           (define wid (second e))
           (define combat-flee? (third e))
           (define whp (fourth e))
           (cond
             [(or combat-flee? (<= whp 10))
              (loop (cdr rem) (cons e kept-rev) capped-rev noncrit-kept)]
             [(< noncrit-kept max-noncrit-dis)
              (loop (cdr rem) (cons e kept-rev) capped-rev (add1 noncrit-kept))]
             [else
              (loop (cdr rem) kept-rev (cons wid capped-rev) noncrit-kept)])])))
    (for ([e (in-list kept-disengage-entries)])
      (when (fifth e)
        (hash-set! rush-def-st (second e) (cons (sixth e) (seventh e)))))
    (define disengage-cands
      (map (lambda (e) (take e 4)) (reverse kept-disengage-entries)))
    (set-l2-ctx-cur-rush-disengaging-wids! ctx (map second kept-disengage-entries))

    ;; Terran SCV mutual & pocket Auto-Repair before emitting mineral-walk (so repair SCVs aren't double-ordered)
    (define repair-busy-ht (make-hasheqv))
    (define scv-defenders
      (if (and worker-rush-active?
               (>= minerals 5)
               (or (eq? race 'Terran)
                   (ormap (lambda (w) (eq? (unit-type-sym w) 'scv)) non-builder-defense-workers)))
          (filter (lambda (w) (and (eq? (unit-type-sym w) 'scv) (> (hash-ref w 'id 0) 0)))
                  non-builder-defense-workers)
          '()))
    (when (not (null? scv-defenders))
      (define (nearest-cheese-dist x y)
        (for/fold ([best +inf.0]) ([e (in-list ground-enemy-units-for-cheese)])
          (min best (dist2d x y (hash-ref e 'x 9999.0) (hash-ref e 'y 9999.0)))))
      (define wounded-scvs
        (sort (filter (lambda (w)
                        (define hp (unit-total-hp-and-shield w))
                        (and (> hp 1.0) (< hp 42.0)))
                      scv-defenders)
              <
              #:key (lambda (w)
                      (define hp (unit-total-hp-and-shield w))
                      (+ hp (if (< hp 36.0) 0.0 20.0)))))
      (when (and (not (null? wounded-scvs))
                 (or (not (null? ground-enemy-units-for-cheese))
                     (< (unit-total-hp-and-shield (car wounded-scvs)) 38.0)))
        (define repair-tgt-counts (make-hasheqv))
        (define max-repairers
          (cond [(< (length scv-defenders) 6) 1]
                [(>= (length enemy-rush-workers) 6) 2]
                [else 1]))
        (define total-repairers 0)
        (define (pick-repair-target rep-id rx ry max-dist)
          (let loop ([rem wounded-scvs] [best #f] [best-score +inf.0])
            (if (null? rem)
                best
                (let* ([t (car rem)]
                       [tid (hash-ref t 'id 0)]
                       [cnt (hash-ref repair-tgt-counts tid 0)])
                  (if (or (= tid rep-id) (>= cnt 2))
                      (loop (cdr rem) best best-score)
                      (let ([d (dist2d rx ry (hash-ref t 'x base-x) (hash-ref t 'y base-y))])
                        (if (and (<= d max-dist) (> (+ (unit-total-hp-and-shield t) (* cnt 12.0)) 0.0))
                            (let ([score (+ (unit-total-hp-and-shield t) (* cnt 16.0) (* 0.5 d))])
                              (if (< score best-score)
                                  (loop (cdr rem) t score)
                                  (loop (cdr rem) best best-score)))
                            (loop (cdr rem) best best-score))))))))
        ;; Pass A: safe disengaging SCVs mutual-repair each other instead of idling at evacuation patch
        (for ([dc (in-list (reverse disengage-cands))]
              #:break (>= total-repairers max-repairers))
          (match-define (list rw rwid near-comb? rwhp) dc)
          (define rx (hash-ref rw 'x base-x))
          (define ry (hash-ref rw 'y base-y))
          (when (and (eq? (unit-type-sym rw) 'scv)
                     (> rwid 0)
                     (not near-comb?)
                     (> rwhp 5.0)
                     (> (nearest-cheese-dist rx ry) 2.2))
            (define tgt (pick-repair-target rwid rx ry 10.0))
            (when tgt
              (define tid (hash-ref tgt 'id 0))
              (hash-set! repair-busy-ht rwid #t)
              (hash-update! repair-tgt-counts tid add1 0)
              (set! total-repairers (add1 total-repairers))
              (l2-emit! ctx (list 'repair rwid tid)))))
        ;; Pass B: healthy pocket SCVs repair badly injured frontline SCVs (< 36 HP) during >= 6-SCV brawl
        (when (and (>= (length scv-defenders) 6)
                   (< total-repairers max-repairers)
                   (< (unit-total-hp-and-shield (car wounded-scvs)) 36.0))
          (define cur-dis (l2-ctx-cur-rush-disengaging-wids ctx))
          (for ([rw (in-list scv-defenders)]
                #:break (>= total-repairers max-repairers))
            (define rwid (hash-ref rw 'id 0))
            (define rwhp (unit-total-hp-and-shield rw))
            (define rx (hash-ref rw 'x base-x))
            (define ry (hash-ref rw 'y base-y))
            (define safe-from-combat?
              (or (not mixed-worker-combat-rush?)
                  (andmap (lambda (ec)
                            (> (dist2d rx ry (hash-ref ec 'x 9999.0) (hash-ref ec 'y 9999.0)) 3.8))
                          enemy-combat-near-main)))
            (when (and (>= rwhp 28.0)
                       safe-from-combat?
                       (not (memv rwid cur-dis))
                       (not (hash-has-key? repair-busy-ht rwid))
                       (> (nearest-cheese-dist rx ry) 1.8))
              (define tgt (pick-repair-target rwid rx ry 6.5))
              (when (and tgt (< (unit-total-hp-and-shield tgt) 36.0))
                (define tid (hash-ref tgt 'id 0))
                (hash-set! repair-busy-ht rwid #t)
                (hash-update! repair-tgt-counts tid add1 0)
                (set! total-repairers (add1 total-repairers))
                (set-l2-ctx-cur-rush-disengaging-wids! ctx (cons rwid (l2-ctx-cur-rush-disengaging-wids ctx)))
                (l2-emit! ctx (list 'repair rwid tid))))))))

    (for ([dc (in-list (reverse disengage-cands))])
      (define wid (second dc))
      (unless (hash-has-key? repair-busy-ht wid)
        (if (> evac-patch-id 0)
            (l2-emit! ctx (list 'mineral-walk wid evac-patch-id evac-px evac-py))
            (l2-emit! ctx (list 'mineral-walk wid evac-px evac-py)))))

    (unless (null? worker-rush-engage-enemies)
      (define (dist-to-nearest-engage-enemy wx wy)
        (for/fold ([best +inf.0]) ([ew (in-list worker-rush-engage-enemies)])
          (min best (dist2d wx wy (hash-ref ew 'x ew-cx) (hash-ref ew 'y ew-cy)))))

      ;; Only workers inside `rush-chase-leash-rad` and not disengaging are eligible to fight
      (define healthy-rush-workers
        (filter (lambda (w)
                  (define wid (hash-ref w 'id 10))
                  (define whp (unit-total-hp-and-shield w))
                  (define wx (hash-ref w 'x base-x))
                  (define wy (hash-ref w 'y base-y))
                  (define entry (hash-ref rush-def-st wid #f))
                  (define in-post-slide-window?
                    (and (pair? entry) (>= frame (car entry)) (< frame (cdr entry))))
                  (and (not (memv wid (l2-ctx-cur-rush-disengaging-wids ctx)))
                       (<= (dist-to-owned-townhall wx wy) rush-chase-leash-rad)
                       (cond
                         [(memv wid capped-stay-fighting-wids) (> whp 5)]
                         [in-post-slide-window? (> whp 5)]
                         [(memv wid prev-rush-fighting-wids) (> whp eff-disengage-hp)]
                         [else (>= whp eff-reengage-hp)])))
                non-builder-defense-workers))

      ;; Sort farthest from engaging enemies first so kept miners are ALWAYS the safest far-patch workers
      (define safest-first
        (sort healthy-rush-workers
              >
              #:key (lambda (w)
                      (dist-to-nearest-engage-enemy
                       (hash-ref w 'x base-x)
                       (hash-ref w 'y base-y)))))

      (define unthreatened-miners-cnt
        (count (lambda (w)
                 (> (dist-to-nearest-engage-enemy
                     (hash-ref w 'x base-x)
                     (hash-ref w 'y base-y))
                    4.5))
               safest-first))
      (define enemies-inside-7.5?
        (ormap (lambda (ew)
                 (define ex (hash-ref ew 'x 9999.0))
                 (define ey (hash-ref ew 'y 9999.0))
                 (or (<= (dist-to-owned-townhall ex ey) 7.5)
                     (<= (dist-to-mineral-line ex ey) 7.5)))
               worker-rush-engage-enemies))

      (define total-w-cnt (length workers))
      (define h-cnt (length safest-first))
      (define e-cnt (length worker-rush-engage-enemies))
      (define eff-e-cnt (max e-cnt (length enemy-rush-workers)))
      (define breached-mineral-cnt
        (count (lambda (ew)
                 (<= (dist-to-mineral-line (hash-ref ew 'x 9999.0)
                                           (hash-ref ew 'y 9999.0))
                     5.5))
               worker-rush-engage-enemies))
      (define th-breach-cnt
        (count (lambda (ew)
                 (<= (dist-to-owned-townhall (hash-ref ew 'x 9999.0)
                                             (hash-ref ew 'y 9999.0))
                     6.0))
               worker-rush-engage-enemies))
      (define th-tight-stack-cnt
        (count (lambda (ew)
                 (<= (dist-to-owned-townhall (hash-ref ew 'x 9999.0)
                                             (hash-ref ew 'y 9999.0))
                     3.0))
               worker-rush-engage-enemies))
      (define th-tight-3.8-cnt
        (count (lambda (ew)
                 (<= (dist-to-owned-townhall (hash-ref ew 'x 9999.0)
                                             (hash-ref ew 'y 9999.0))
                     3.8))
               worker-rush-engage-enemies))
      (define townhall-damaged-by-rush?
        (and (>= th-breach-cnt 3)
             (ormap (lambda (b)
                      (and (hash? b)
                           (memq (fast-canonical-structure-sym (unit-type-sym b))
                                 '(hatchery lair hive nexus
                                   command-center orbital-command planetary-fortress))
                           (<= (dist-to-owned-townhall (hash-ref b 'x base-x)
                                                       (hash-ref b 'y base-y))
                               4.0)
                           (let* ([b-hp (hash-ref b 'hp 1500)]
                                  [b-max-hp (hash-ref b 'max-hp b-hp)]
                                  [b-sh (hash-ref b 'shield 0)]
                                  [b-max-sh (hash-ref b 'max-shield b-sh)]
                                  [tot-max (+ b-max-hp b-max-sh)])
                             (and (> tot-max 0)
                                  (< (+ b-hp b-sh) (* 0.98 tot-max))))))
                    ally-bldgs)))
      ;; #5125725 TownHall-Focus Stack-Breaker: enemy workers tightly stacked on TownHall (< 98% HP or >= 5 within 3.0t or >= 3 within 3.8t)
      (define th-focus-stack-trigger?
        (and (>= eff-e-cnt 6)
             (or (>= th-tight-stack-cnt 5)
                 townhall-damaged-by-rush?
                 (and (>= th-breach-cnt 3) (>= th-tight-3.8-cnt 3)))))
      (define all-hands-mineral-brawl?
        (and (>= eff-e-cnt 6)
             (or th-focus-stack-trigger?
                 (>= eff-e-cnt 11)
                 (>= breached-mineral-cnt 3)
                 (and (>= th-breach-cnt 3) (< unthreatened-miners-cnt 3))
                 (ormap (lambda (b)
                          (and (hash? b)
                               (<= (dist-to-owned-townhall (hash-ref b 'x base-x)
                                                           (hash-ref b 'y base-y))
                                   (if heavy-worker-allin-no-army? 7.5 9.5))
                               (let* ([b-hp (hash-ref b 'hp 1500)]
                                      [b-max-hp (hash-ref b 'max-hp b-hp)]
                                      [b-sh (hash-ref b 'shield 0)]
                                      [b-max-sh (hash-ref b 'max-shield b-sh)]
                                      [tot-max (+ b-max-hp b-max-sh)])
                                 (and (> tot-max 0)
                                      (< (+ b-hp b-sh) (* 0.96 tot-max))))))
                        ally-bldgs))))
      (define surplus-miners (max 0 (- h-cnt (+ eff-e-cnt 2))))
      (define keep-mining-cnt
        (min h-cnt
             (cond
               [all-hands-mineral-brawl?
                (cond
                  [(>= h-cnt (+ eff-e-cnt 4)) (max 4 (- h-cnt (+ eff-e-cnt 2)))]
                  [(> h-cnt (+ eff-e-cnt 2)) (min 4 (- h-cnt (+ eff-e-cnt 1)))]
                  [(> h-cnt 4) 1]
                  [else 0])]
               [(and (>= total-w-cnt 8) (>= unthreatened-miners-cnt 3))
                (max 4 surplus-miners)]
               [(and (>= total-w-cnt 7) (>= unthreatened-miners-cnt 3))
                (max 3 surplus-miners)]
               [(and enemies-inside-7.5? (< h-cnt 8))
                (min 2 (max 0 (sub1 h-cnt)))]
               [(>= total-w-cnt 8)
                (max 4 surplus-miners)]
               [(>= total-w-cnt 7)
                (max 3 surplus-miners)]
               [else
                (min 2 surplus-miners)])))

      (define reserve-pool-w
        (and (eq? race 'Zerg)
             worker-rush-active?
             (>= minerals 180)
             (not (l2-building-present-or-pending? ctx 'spawning-pool))
             (not (null? safest-first))
             (or (findf (lambda (w) (>= (unit-total-hp-and-shield w) 30.0)) safest-first)
                 (car safest-first))))
      (define reserve-pool-wid (and reserve-pool-w (hash-ref reserve-pool-w 'id 0)))
      (when (and (exact-integer? reserve-pool-wid) (> reserve-pool-wid 0))
        (set-l2-ctx-rush-pool-builder-wid! ctx reserve-pool-wid))
      (define raw-pulled-rush-workers
        (drop safest-first keep-mining-cnt))
      (define pulled-rush-workers
        (if (and (exact-integer? reserve-pool-wid) (> reserve-pool-wid 0))
            (filter (lambda (w) (not (equal? (hash-ref w 'id 0) reserve-pool-wid)))
                    raw-pulled-rush-workers)
            raw-pulled-rush-workers))

      (unless (null? pulled-rush-workers)
        (set-l2-ctx-cur-rush-fighting-wids! ctx
              (map (lambda (w) (hash-ref w 'id 10)) pulled-rush-workers))
        ;; Compute clamped enemy cluster centroid inside our mineral line / main (<= rush-chase-leash-rad)
        (define raw-cl-x
          (/ (for/sum ([ew (in-list worker-rush-engage-enemies)])
               (exact->inexact (hash-ref ew 'x base-x)))
             e-cnt))
        (define raw-cl-y
          (/ (for/sum ([ew (in-list worker-rush-engage-enemies)])
               (exact->inexact (hash-ref ew 'y base-y)))
             e-cnt))
        (define cl-dx (- raw-cl-x (exact->inexact base-x)))
        (define cl-dy (- raw-cl-y (exact->inexact base-y)))
        (define cl-d (sqrt (+ (* cl-dx cl-dx) (* cl-dy cl-dy))))
        (define cl-x
          (safe-coord (if (> cl-d rush-chase-leash-rad) (+ base-x (* rush-chase-leash-rad (/ cl-dx cl-d))) raw-cl-x) base-x))
        (define cl-y
          (safe-coord (if (> cl-d rush-chase-leash-rad) (+ base-y (* rush-chase-leash-rad (/ cl-dy cl-d))) raw-cl-y) base-y))
        (define in-pack-engage-enemies
          (let* ([th-stack (if th-focus-stack-trigger?
                               (filter (lambda (ew)
                                         (<= (dist-to-owned-townhall
                                              (hash-ref ew 'x cl-x)
                                              (hash-ref ew 'y cl-y))
                                             4.2))
                                       worker-rush-engage-enemies)
                               '())]
                 [near-pack
                  (if (not (null? th-stack))
                      th-stack
                      (filter (lambda (ew)
                                (<= (dist2d cl-x cl-y
                                            (hash-ref ew 'x cl-x)
                                            (hash-ref ew 'y cl-y))
                                    3.5))
                              worker-rush-engage-enemies))])
            (if (null? near-pack) worker-rush-engage-enemies near-pack)))
        (define lowest-ehp-enemy
          (argmin (lambda (ew)
                    (+ (* 5.0 (unit-total-hp-and-shield ew))
                       (dist-to-owned-townhall (hash-ref ew 'x cl-x) (hash-ref ew 'y cl-y))))
                  in-pack-engage-enemies))
        (define raw-focus-x
          (if lowest-ehp-enemy
              (safe-coord (hash-ref lowest-ehp-enemy 'x cl-x) cl-x)
              cl-x))
        (define raw-focus-y
          (if lowest-ehp-enemy
              (safe-coord (hash-ref lowest-ehp-enemy 'y cl-y) cl-y)
              cl-y))
        (define fa-dx (- (exact->inexact raw-focus-x) (exact->inexact base-x)))
        (define fa-dy (- (exact->inexact raw-focus-y) (exact->inexact base-y)))
        (define fa-d (sqrt (+ (* fa-dx fa-dx) (* fa-dy fa-dy))))
        (define fa-max-rad (if heavy-worker-allin-no-army? 7.5 10.5))
        (define focus-amove-x
          (safe-coord (if (> fa-d fa-max-rad) (+ base-x (* fa-max-rad (/ fa-dx fa-d))) raw-focus-x) cl-x))
        (define focus-amove-y
          (safe-coord (if (> fa-d fa-max-rad) (+ base-y (* fa-max-rad (/ fa-dy fa-d))) raw-focus-y) cl-y))

        ;; Partition defenders per-worker locally: max 3 normally (and always <= 3 for Pass-2 chasers to avoid
        ;; conga-lining in open space), or up to 8 in Pass-1 melee range when >= 6 enemy workers are mineral-walk
        ;; stacked inside our mineral line (<= 5.0 tiles from mineral patches) so 8 * 5 = 40 one-shots a stacked Probe!
        (define primary-focus-id
          (and lowest-ehp-enemy (hash-ref lowest-ehp-enemy 'id -1)))
        (define (mineral-line-stacked-enemy? ew)
          (define ex (hash-ref ew 'x cl-x))
          (define ey (hash-ref ew 'y cl-y))
          (and (>= e-cnt 6)
               (or (and th-focus-stack-trigger?
                        (<= (dist-to-owned-townhall ex ey) 4.2))
                   (and (or (<= (dist-to-mineral-line ex ey) 5.0)
                            (<= (dist-to-owned-townhall ex ey) 6.0))
                        (>= (count (lambda (other)
                                     (<= (dist2d ex ey
                                                 (hash-ref other 'x cl-x)
                                                 (hash-ref other 'y cl-y))
                                         1.75))
                                   worker-rush-engage-enemies)
                            4))
                   (and live-obs-harvesters?
                        primary-focus-id
                        (equal? (hash-ref ew 'id 0) primary-focus-id)
                        (or (<= (dist-to-mineral-line ex ey) 5.5)
                            (<= (dist-to-owned-townhall ex ey) 6.0))))))
        (define (effective-melee-cap ew)
          (define ehp (max 1.0 (exact->inexact (unit-total-hp-and-shield ew))))
          (define swings-needed (inexact->exact (ceiling (/ ehp 5.0))))
          (define cap (if (mineral-line-stacked-enemy? ew) 8 3))
          (min cap (max 2 swings-needed)))
        (define (effective-chaser-cap ew)
          (min (if (and (>= e-cnt 6)
                        primary-focus-id
                        (equal? (hash-ref ew 'id -1) primary-focus-id))
                   6
                   3)
               (effective-melee-cap ew)))
        (define assigned-target-counts (make-hasheqv))
        (define worker-assignments (make-hasheqv))
        (define frontline-first
          (sort pulled-rush-workers
                <
                #:key (lambda (w)
                        (dist-to-nearest-engage-enemy
                         (hash-ref w 'x base-x)
                         (hash-ref w 'y base-y)))))

        (define (enemy-worker-safe-from-combat? ew)
          (or (not mixed-worker-combat-rush?)
              (let ([ex (hash-ref ew 'x cl-x)]
                    [ey (hash-ref ew 'y cl-y)])
                (andmap (lambda (ec)
                          (> (dist2d ex ey (hash-ref ec 'x 9999.0) (hash-ref ec 'y 9999.0)) 2.5))
                        enemy-combat-near-main))))
        (define safe-engage-workers
          (let ([safe (filter enemy-worker-safe-from-combat? worker-rush-engage-enemies)])
            (if (null? safe) worker-rush-engage-enemies safe)))
        (define (non-retreating-engage-worker? ew)
          (define ex (hash-ref ew 'x cl-x))
          (define ey (hash-ref ew 'y cl-y))
          (or (<= (dist-to-owned-townhall ex ey) rush-th-pull-rad)
              (<= (dist-to-mineral-line ex ey) 6.5)
              (ormap (lambda (b)
                       (and (hash? b)
                            (<= (dist-to-owned-townhall
                                 (hash-ref b 'x base-x)
                                 (hash-ref b 'y base-y))
                                rush-bldg-th-rad)
                            (<= (dist2d ex ey
                                        (hash-ref b 'x base-x)
                                        (hash-ref b 'y base-y))
                                4.5)))
                     ally-bldgs)))

        ;; Pass 1: Immediate melee swing (<= 2.5 tiles normally, <= 3.2 tiles on primary mineral-line focus target in live games), lowest (hp + shield)
        (for ([w (in-list frontline-first)])
          (define wid (hash-ref w 'id 10))
          (define wx (hash-ref w 'x base-x))
          (define wy (hash-ref w 'y base-y))
          (define melee-cands
            (filter (lambda (ew)
                      (define eid (hash-ref ew 'id 0))
                      (define reach
                        (if (and (>= e-cnt 6)
                                 primary-focus-id
                                 (equal? eid primary-focus-id)
                                 (or (and th-focus-stack-trigger?
                                          (<= (dist-to-owned-townhall (hash-ref ew 'x cl-x) (hash-ref ew 'y cl-y)) 4.2))
                                     (and live-obs-harvesters?
                                          (<= (dist-to-mineral-line (hash-ref ew 'x cl-x) (hash-ref ew 'y cl-y)) 5.5))))
                            3.2
                            2.5))
                      (and (> eid 0)
                           (< (hash-ref assigned-target-counts eid 0) (effective-melee-cap ew))
                           (<= (dist2d wx wy (hash-ref ew 'x cl-x) (hash-ref ew 'y cl-y)) reach)))
                    safe-engage-workers))
          (unless (null? melee-cands)
            (define chosen
              (argmin (lambda (ew)
                        (+ (* 100.0 (unit-total-hp-and-shield ew))
                           (dist2d wx wy (hash-ref ew 'x cl-x) (hash-ref ew 'y cl-y))))
                      melee-cands))
            (define cid (hash-ref chosen 'id 0))
            (hash-update! assigned-target-counts cid add1 0)
            (hash-set! worker-assignments wid
                       (list cid
                             (safe-coord (hash-ref chosen 'x cl-x) cl-x)
                             (safe-coord (hash-ref chosen 'y cl-y) cl-y)))))

        ;; Pass 2: Targeted focus-fire within 4.5-6.0 tiles (7.0 for < 6 workers) onto the lowest (hp + shield)
        ;; non-retreating enemy worker (capped at `effective-chaser-cap`), avoiding blind Attack-Move spread
        ;; and avoiding pulling Probes into enemy Zealots during mixed rushes.
        (define pass2-reach (if (>= e-cnt 6) 6.0 7.0))
        (for ([w (in-list frontline-first)]
              #:unless (hash-has-key? worker-assignments (hash-ref w 'id 10)))
          (define wid (hash-ref w 'id 10))
          (define wx (hash-ref w 'x base-x))
          (define wy (hash-ref w 'y base-y))
          (define raw-local-cands
            (filter (lambda (ew)
                      (define eid (hash-ref ew 'id 0))
                      (and (> eid 0)
                           (< (hash-ref assigned-target-counts eid 0) (effective-chaser-cap ew))
                           (<= (dist2d wx wy (hash-ref ew 'x cl-x) (hash-ref ew 'y cl-y)) pass2-reach)))
                    safe-engage-workers))
          (define local-cands
            (let ([non-ret (filter non-retreating-engage-worker? raw-local-cands)])
              (if (null? non-ret) raw-local-cands non-ret)))
          (cond
            [(not (null? local-cands))
             (define chosen
               (argmin (lambda (ew)
                         (+ (* 5.0 (unit-total-hp-and-shield ew))
                            (* 2.5 (dist2d wx wy (hash-ref ew 'x cl-x) (hash-ref ew 'y cl-y)))))
                       local-cands))
             (define cid (hash-ref chosen 'id 0))
             (hash-update! assigned-target-counts cid add1 0)
             (hash-set! worker-assignments wid
                        (list cid
                              (safe-coord (hash-ref chosen 'x cl-x) cl-x)
                              (safe-coord (hash-ref chosen 'y cl-y) cl-y)))]
            [mixed-worker-combat-rush?
             (define safe-fallback
               (let ([cand (findf (lambda (ew)
                                    (and (> (hash-ref ew 'id 0) 0)
                                         (enemy-worker-safe-from-combat? ew)))
                                  safe-engage-workers)])
                 cand))
             (when safe-fallback
               (hash-set! worker-assignments wid
                          (list (hash-ref safe-fallback 'id 0)
                                (safe-coord (hash-ref safe-fallback 'x cl-x) cl-x)
                                (safe-coord (hash-ref safe-fallback 'y cl-y) cl-y))))]
            [else
             (hash-set! worker-assignments wid (list 0 focus-amove-x focus-amove-y))]))

        ;; Emit grouped pull-workers-attack commands (unit-targeted groups + Attack-Move group)
        (define target-order '())
        (define target-groups (make-hasheqv))
        (define target-coords (make-hasheqv))
        (for ([w (in-list frontline-first)])
          (define wid (hash-ref w 'id 10))
          (define asgn (hash-ref worker-assignments wid #f))
          (when asgn
            (match-define (list tid tx ty) asgn)
            (unless (hash-has-key? target-groups tid)
              (set! target-order (cons tid target-order))
              (hash-set! target-coords tid (cons tx ty)))
            (hash-set! target-groups tid (cons wid (hash-ref target-groups tid '())))))
        (set-l2-ctx-worker-pull-emitted-1ab?! ctx #t)
        (for ([tid (in-list (reverse target-order))])
          (define wids (reverse (hash-ref target-groups tid '())))
          (define tc (hash-ref target-coords tid (cons focus-amove-x focus-amove-y)))
          (unless (null? wids)
            (l2-emit! ctx (list 'pull-workers-attack wids tid (car tc) (cdr tc)))))
        ;; Cohesive Zergling/Zealot/Marine + Drone focus-fire (#5131248, #5131255):
        ;; When defending a worker rush inside our base, have nearby early combat units focus-fire
        ;; the exact same wounded `primary-focus-id` worker alongside our pulled workers so Probes die instantly!
        (when (and worker-rush-active?
                   (exact-integer? primary-focus-id)
                   (> primary-focus-id 0))
          (define ol-early (l2-ctx-oledger-early ctx))
          (for ([cu (in-list (or (l2-ctx-ally-combat-units ctx) '()))])
            (define cid (hash-ref cu 'id 0))
            (define cx (hash-ref cu 'x base-x))
            (define cy (hash-ref cu 'y base-y))
            (when (and (> cid 0)
                       (memq (fast-canonical-unit-sym (unit-type-sym cu))
                             '(zergling zealot marine reaper adept))
                       (<= (dist2d cx cy base-x base-y) 14.0))
              (l2-emit! ctx (list 'attack-unit cid primary-focus-id))
              (when ol-early
                (order-ledger-record-issued! ol-early cid 'attack-unit 'worker-rush-focus
                                             #:target-id primary-focus-id
                                             #:target-x focus-amove-x #:target-y focus-amove-y
                                             #:frame frame)))))
        (define all-pulled-wids
          (filter positive? (map (lambda (w) (hash-ref w 'id 0)) frontline-first)))
        (define close-drill-wids
          (for/list ([w (in-list frontline-first)]
                     #:when (let ([wid (hash-ref w 'id 0)]
                                  [wx (hash-ref w 'x base-x)]
                                  [wy (hash-ref w 'y base-y)])
                              (and (> wid 0)
                                   (or (<= (dist2d wx wy focus-amove-x focus-amove-y) 2.0)
                                       (<= (dist-to-nearest-engage-enemy wx wy) 2.0)))))
            (hash-ref w 'id 0)))
        (define stacked-enemy-inside-minerals?
          (and (>= e-cnt 6)
               (or th-focus-stack-trigger?
                   (ormap (lambda (ew)
                            (and (mineral-line-stacked-enemy? ew)
                                 (<= (dist-to-mineral-line (hash-ref ew 'x cl-x)
                                                           (hash-ref ew 'y cl-y))
                                     1.5)))
                          worker-rush-engage-enemies))))
        (when (and stacked-enemy-inside-minerals?
                   (not (null? all-pulled-wids))
                   (not (null? close-drill-wids))
                   (not (null? base-mineral-patches)))
          (define th-coord
            (argmin (lambda (bc) (dist2d cl-x cl-y (car bc) (cdr bc)))
                    ready-townhall-coords))
          (define drill-patch
            (placement:select-worker-drill-stack-mineral-patch
             cl-x cl-y (car th-coord) (cdr th-coord) base-mineral-patches))
          (define drill-patch-id
            (and (hash? drill-patch) (safe-nonneg-int (hash-ref drill-patch 'id 0) 0)))
          (when (and (exact-integer? drill-patch-id) (> drill-patch-id 0))
            (l2-emit! ctx (list 'worker-drill-stack-attack
                         close-drill-wids
                         drill-patch-id
                         (if (and (exact-integer? primary-focus-id) (>= primary-focus-id 0))
                             primary-focus-id
                             0)
                         focus-amove-x
                         focus-amove-y))))))

    ;; During the 14-frame hysteresis window, keep previously-pulled defenders (within leash and not disengaging)
    ;; from immediately snapping back to mining if enemy workers momentarily kite outside `rush-chase-leash-rad`.
    (when (and (null? worker-rush-engage-enemies)
               in-engage-hysteresis?)
      (set-l2-ctx-cur-rush-fighting-wids! ctx
            (for/list ([w (in-list non-builder-defense-workers)]
                       #:when (let ([wid (hash-ref w 'id 10)])
                                (and (memv wid prev-rush-fighting-wids)
                                     (not (memv wid (l2-ctx-cur-rush-disengaging-wids ctx)))
                                     (<= (dist-to-owned-townhall
                                          (hash-ref w 'x base-x)
                                          (hash-ref w 'y base-y))
                                         rush-chase-leash-rad))))
              (hash-ref w 'id 10))))

    ;; Snap back to mining any previously-pulled worker (or worker outside `rush-chase-leash-rad`)
    ;; once hysteresis expires or that worker is assigned to keep mining!
    (for ([w (in-list non-builder-defense-workers)])
      (define wid (hash-ref w 'id 10))
      (define wx (hash-ref w 'x base-x))
      (define wy (hash-ref w 'y base-y))
      (when (and (not (memv wid (l2-ctx-cur-rush-fighting-wids ctx)))
                 (not (memv wid (l2-ctx-cur-rush-disengaging-wids ctx)))
                 (or (memv wid prev-rush-fighting-wids)
                     (and worker-rush-active?
                          (> (dist-to-owned-townhall wx wy) rush-chase-leash-rad))))
        (if (> far-patch-id 0)
            (l2-emit! ctx (list 'harvest-mineral wid far-patch-id))
            (l2-emit! ctx (list 'mineral-walk wid far-px far-py)))))))

(define (l2-phase3-recall-cancel-scout! ctx)
  (define ally-bldgs (l2-ctx-ally-bldgs ctx))
  (define ally-combat-supply-early (l2-ctx-ally-combat-supply-early ctx))
  (define ally-combat-units (l2-ctx-ally-combat-units ctx))
  (define ally-units (l2-ctx-ally-units ctx))
  (define base-x (l2-ctx-base-x ctx))
  (define base-y (l2-ctx-base-y ctx))
  (define cd-tracker (l2-ctx-cd-tracker ctx))
  (define cheese-dist-thresh (l2-ctx-cheese-dist-thresh ctx))
  (define enemy-bldgs (l2-ctx-enemy-bldgs ctx))
  (define enemy-rush-workers (l2-ctx-enemy-rush-workers ctx))
  (define enemy-units (l2-ctx-enemy-units ctx))
  (define enemy-x (l2-ctx-enemy-x ctx))
  (define enemy-y (l2-ctx-enemy-y ctx))
  (define frame (l2-ctx-frame ctx))
  (define ground-enemy-units-for-cheese (l2-ctx-ground-enemy-units-for-cheese ctx))
  (define in-base-proxy-completed-cannon? (l2-ctx-in-base-proxy-completed-cannon? ctx))
  (define in-base-proxy-completed-cannons (l2-ctx-in-base-proxy-completed-cannons ctx))
  (define in-base-proxy-detected? (l2-ctx-in-base-proxy-detected? ctx))
  (define in-base-proxy-structures (l2-ctx-in-base-proxy-structures ctx))
  (define leases (l2-ctx-leases ctx))
  (define live-obs-harvesters? (l2-ctx-live-obs-harvesters? ctx))
  (define nat-x (l2-ctx-nat-x ctx))
  (define nat-y (l2-ctx-nat-y ctx))
  (define non-builder-defense-workers (l2-ctx-non-builder-defense-workers ctx))
  (define obs (l2-ctx-obs ctx))
  (define oledger-early (l2-ctx-oledger-early ctx))
  (define owned-base-coords (l2-ctx-owned-base-coords ctx))
  (define proxy-or-cheese-enemies (l2-ctx-proxy-or-cheese-enemies ctx))
  (define race (l2-ctx-race ctx))
  (define raw-obs (l2-ctx-raw-obs ctx))
  (define rt (l2-ctx-rt ctx))
  (define rush-def-st (l2-ctx-rush-def-st ctx))
  (define under-early-cheese? (l2-ctx-under-early-cheese? ctx))
  (define worker-rush-active? (l2-ctx-worker-rush-active? ctx))
  (define workers (l2-ctx-workers ctx))
  (when (and in-base-proxy-detected?
             (not worker-rush-active?)
             (not (null? non-builder-defense-workers)))
    (define completed-powered-cannons (length in-base-proxy-completed-cannons))
    ;; Disengage critically wounded proxy-fighting workers (<= 12 HP) every step
    (define base-mps
      (filter (lambda (mp)
                (and (hash? mp)
                     (<= (dist2d base-x base-y (hash-ref mp 'x base-x) (hash-ref mp 'y base-y)) 14.0)))
              (let ([mps (hash-ref obs 'mineral-patches '())])
                (if (list? mps) mps '()))))
    (define safe-mp (and (not (null? base-mps)) (car base-mps)))
    (for ([w (in-list non-builder-defense-workers)])
      (define wid (hash-ref w 'id 10))
      (define whp (unit-total-hp-and-shield w))
      (when (and (<= whp SC2-FIGHTING-WORKER-DISENGAGE-HP)
                 (ormap (lambda (e)
                          (<= (dist2d (hash-ref w 'x base-x) (hash-ref w 'y base-y)
                                      (hash-ref e 'x 9999.0) (hash-ref e 'y 9999.0))
                              7.5))
                        (append ground-enemy-units-for-cheese in-base-proxy-structures)))
        (if safe-mp
            (l2-emit! ctx (list 'mineral-walk wid
                         (safe-nonneg-int (hash-ref safe-mp 'id 0) 0)
                         (safe-coord (hash-ref safe-mp 'x base-x) base-x)
                         (safe-coord (hash-ref safe-mp 'y base-y) base-y)))
            (l2-emit! ctx (list 'mineral-walk wid base-x base-y)))))
    ;; Once >= 1 completed powered Photon Cannon exists, stop pulling SCVs onto proxy pylons/cannons
    ;; (and never pull into 8.5-tile cannon range); switch to Bunker + Tank breakout instead (`#89` [UNCOVERED-T2]).
    (define pullable-proxy-structures
      (if (> completed-powered-cannons 0)
          '()
          in-base-proxy-structures))
    (when (and (= completed-powered-cannons 0)
               (not (null? pullable-proxy-structures)))
      (define healthy-proxy-workers
        (filter (lambda (w) (> (unit-total-hp-and-shield w) SC2-FIGHTING-WORKER-DISENGAGE-HP))
                non-builder-defense-workers))
      ;; Keep at least 4 workers mining so economy never hits 0 income while clearing proxy!
      (define surplus-cnt (max 0 (- (length healthy-proxy-workers) 4)))
      (when (> surplus-cnt 0)
        (define proxy-pylon-cnt
          (count (lambda (eb)
                   (eq? (fast-canonical-structure-sym (unit-type-sym eb)) 'pylon))
                 pullable-proxy-structures))
        (define sorted-proxies
          (sort pullable-proxy-structures
                <
                #:key (lambda (eb)
                        (define canon (fast-canonical-structure-sym (unit-type-sym eb)))
                        (define prog (hash-ref eb 'build-progress 1.0))
                        ;; Single Artosis Pylon: snipe the Pylon (0.0); >= 2 Pylons (#5129549):
                        ;; kill warping Photon Cannons first (0.0) so backup Pylons can't re-power completed Cannons!
                        (define prio-rank
                          (cond
                            [(and (>= proxy-pylon-cnt 2)
                                  (memq canon '(photon-cannon bunker spine-crawler))
                                  (< prog SC2-BUILD-COMPLETE-PROGRESS))
                             0.0]
                            [(eq? canon 'pylon) (if (>= proxy-pylon-cnt 2) 100.0 0.0)]
                            [(and (memq canon '(photon-cannon bunker spine-crawler))
                                  (< prog SC2-BUILD-COMPLETE-PROGRESS))
                             100.0]
                            [(memq canon '(forge barracks gateway shield-battery)) 200.0]
                            [else 300.0]))
                        (+ prio-rank
                           (* 0.1 (hash-ref eb 'hp 200))
                           (dist2d base-x base-y
                                   (hash-ref eb 'x base-x)
                                   (hash-ref eb 'y base-y))))))
        ;; Pick workers closest to the primary proxy structure
        (define p0 (car sorted-proxies))
        (define p0x (hash-ref p0 'x base-x))
        (define p0y (hash-ref p0 'y base-y))
        (define pull-pool
          (take (sort healthy-proxy-workers
                      <
                      #:key (lambda (w)
                              (dist2d p0x p0y (hash-ref w 'x base-x) (hash-ref w 'y base-y))))
                surplus-cnt))
        (let assign-loop ([rem-workers pull-pool]
                          [rem-proxies sorted-proxies])
          (cond
            [(or (null? rem-workers) (null? rem-proxies))
             ;; Any leftover surplus worker chases visible enemy proxy builder Probe/SCV
             (define proxy-builder
               (findf (lambda (e)
                        (and (memq (unit-type-sym e) '(probe scv drone))
                             (or (<= (dist2d base-x base-y (hash-ref e 'x 9999.0) (hash-ref e 'y 9999.0))
                                     SC2-IN-BASE-PROXY-DETECT-RADIUS)
                                 (<= (dist2d nat-x nat-y (hash-ref e 'x 9999.0) (hash-ref e 'y 9999.0))
                                     SC2-IN-BASE-PROXY-DETECT-RADIUS))))
                      ground-enemy-units-for-cheese))
             (when (and proxy-builder (not (null? rem-workers)))
               (define hunter-wids
                 (map (lambda (w) (hash-ref w 'id 10))
                      (take rem-workers (min 2 (length rem-workers)))))
               (set-l2-ctx-worker-pull-emitted-1ab?! ctx #t)
               (l2-emit! ctx (list 'pull-workers-attack
                            hunter-wids
                            (hash-ref proxy-builder 'id 0)
                            (safe-coord (hash-ref proxy-builder 'x p0x) base-x)
                            (safe-coord (hash-ref proxy-builder 'y p0y) base-y))))]
            [else
             (define eb (car rem-proxies))
             (define take-n (min 4 (length rem-workers)))
             (define assigned (take rem-workers take-n))
             (define assigned-ids (map (lambda (w) (hash-ref w 'id 10)) assigned))
             (set-l2-ctx-worker-pull-emitted-1ab?! ctx #t)
             (l2-emit! ctx (list 'pull-workers-attack
                          assigned-ids
                          (hash-ref eb 'id 0)
                          (safe-coord (hash-ref eb 'x base-x) base-x)
                          (safe-coord (hash-ref eb 'y base-y) base-y)))
             (assign-loop (drop rem-workers take-n) (cdr rem-proxies))])))))
  (when (and under-early-cheese?
             (not in-base-proxy-completed-cannon?)
             (not (null? workers))
             (or (not live-obs-harvesters?)
                 (and (not worker-rush-active?)
                      (not in-base-proxy-detected?)
                      (< frame 2500)
                      (null? ally-combat-units)
                      (refractory-allow-action?! cd-tracker 'early-cheese-worker-pull frame 112))))
    (define reserved-pool-wid (l2-ctx-rush-pool-builder-wid ctx))
    (define healthy-workers
      (filter (lambda (w)
                (define wid (hash-ref w 'id 0))
                (and (or (not reserved-pool-wid) (not (equal? wid reserved-pool-wid)))
