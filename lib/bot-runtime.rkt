  (define under-early-cheese? (l2-ctx-under-early-cheese? ctx))
  (define urgent-combat-or-intel-need? (l2-ctx-urgent-combat-or-intel-need? ctx))
  (define worker-rush-active? (l2-ctx-worker-rush-active? ctx))
  (when (and (memq 'fusion-core ready-bldg-types)
                (not crisis-tech-upgrade-deferral?)
                (not urgent-combat-or-intel-need?))
       (cond
         [(and (>= (l2-unit-count ctx 'battlecruiser) 1)
               (l2-upgrade-needed? ctx 'weapon-refit))
          (l2-emit-research-verified! ctx 'weapon-refit)]
         [(and (>= (l2-unit-count ctx 'liberator) 2)
               (l2-upgrade-needed? ctx 'advanced-ballistics))
          (l2-emit-research-verified! ctx 'advanced-ballistics)]))
  (define has-fac-tl?
       (or (memq 'factory-techlab ready-bldg-types)
           (ormap (lambda (b)
                    (and (hash? b)
                         (eq? (fast-canonical-structure-sym (unit-type-sym b)) 'factory)
                         (>= (hash-ref b 'build-progress 1.0) 1.0)
                         (or (memq (hash-ref b 'addon #f) '(techlab factory-techlab))
                             (memq (hash-ref b 'addon-type #f) '(techlab factory-techlab))
                             (let* ([atag (hash-ref b 'add-on-tag 0)]
                                    [addon-rec (and (> atag 0)
                                                    (findf (lambda (ab)
                                                             (and (hash? ab)
                                                                  (= (hash-ref ab 'id -1) atag)))
                                                           ally-bldgs))])
                               (and (> atag 0)
                                    (if addon-rec
                                        (and (>= (hash-ref addon-rec 'build-progress 1.0) 1.0)
                                             (memq (unit-type-sym addon-rec) '(factory-techlab techlab)))
                                        #t))))))
                  ally-bldgs)
           (not (hash-has-key? raw-obs 'mineral-harvesters))))
  (define terran-scv-priority?
       (and (or (not terran-saving-for-expand?)
                (and (not terran-saving-for-orbital?) (< total-workers 17) (< (l2-ctx-minerals ctx) 200)))
            (not crisis-freeze-workers?)
            (l2-worker-army-curve-satisfied? ctx)
            (not terran-saving-for-orbital?)
            (not urgent-combat-or-intel-need?)
            (or (< total-workers terran-ideal-worker-cap)
                (l2-can-spend-by-priority? ctx 'scv 'worker))
            (< total-workers (min 70 (max target-workers terran-ideal-worker-cap)))
            (or (not live-game?)
                (and (not under-base-attack?) (<= live-enemy-threat-supply 0))
                (< total-workers 20)
                (not (memq 'barracks ready-bldg-types))
                (>= (length ally-combat-units) 3)
                (>= live-army-supply (* 6 (max 1 (length ccs)))))
            (>= (l2-ctx-minerals ctx)
