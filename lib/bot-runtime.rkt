             (>= supply-used supply-cap)
             (and (<= (l2-ctx-supply-left ctx) 1)
                  (<= supply-cap (* 15 (max 1 active-bases)))
                  (or (and (eq? race 'Protoss) (= real-pylon-count 0) (>= supply-used 14))
