                (>= (- (l2-ctx-minerals ctx) (sc2-min-cost 'spine-crawler)) hard-supply-lockout-reserve-min)
                (or (and crisis-tech-upgrade-deferral?
                         (or (<= (hash-ref open-prod-slots 'larva 0) 0)
                             (>= (l2-ctx-minerals ctx) 200))
                         (>= (l2-ctx-minerals ctx) (sc2-min-cost 'spine-crawler)))
                    (and (or early-survival-crisis?
                             forward-proxy-detected?
                             zerg-early-pool-rush?
                             (and under-base-attack? (< live-army-supply 6)))
                         (or (not worker-rush-active?)
                             (>= (l2-ctx-minerals ctx) 200)
                             (>= live-army-supply 4))
                         (>= (l2-ctx-minerals ctx) (sc2-min-cost 'spine-crawler)))
                    (and (not zerg-saving-for-expand?)
                         (>= (l2-ctx-minerals ctx) (+ (sc2-min-cost 'spine-crawler) (sc2-min-cost 'roach-warren)))
                         (l2-non-combat-min-ok? ctx (sc2-min-cost 'spine-crawler) 'spine-crawler)
                         (or under-early-cheese?
                             (and (>= (length hatcheries) 3)
                                  (>= total-workers 44))))))
       (define-values (spine-x spine-y)
         (if (<= (length hatcheries) 1)
             (let* ([sdx (- nat-x base-x)]
                    [sdy (- nat-y base-y)]
                    [sd (max 1.0 (sqrt (+ (* sdx sdx) (* sdy sdy))))])
               (values (safe-coord (+ base-x (* 3.5 (/ sdx sd))) base-x)
                       (safe-coord (+ base-y (* 3.5 (/ sdy sd))) base-y)))
             (l2-offset-defense-anchor ctx nat-x nat-y 5.5)))
       (l2-emit-build-verified! ctx 'spine-crawler spine-x spine-y 2.0))
  (define cur-evo-cnt (l2-building-present-or-pending-count ctx 'evolution-chamber))
  (define desired-evo-cnt
    (if (and live-game?
             (not under-base-attack?)
             (not early-survival-crisis?)
             (>= (length hatcheries) 3)
             (>= total-workers 48)
             (>= eff-phase-supply 56)
             (memq 'evolution-chamber ready-bldg-types)
             (or (l2-plan-wants-now? ctx 'evolution-chamber)
                 (>= (l2-ctx-minerals ctx) 250)
                 (>= (l2-ctx-gas ctx) 150)))
        2
        1))
  (when (and (memq 'spawning-pool ready-bldg-types)
                (not zerg-saving-for-expand?)
                (or (not live-game?)
                    (>= (length hatcheries) 3)
                    (>= total-workers 34))
