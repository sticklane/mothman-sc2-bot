               (or (and (>= (l2-ctx-minerals ctx) (sc2-min-cost 'corruptor))
                        (>= (l2-ctx-gas ctx) (sc2-gas-cost 'corruptor)))
                   (and (>= (l2-ctx-minerals ctx) (sc2-min-cost 'mutalisk))
                        (>= (l2-ctx-gas ctx) (sc2-gas-cost 'mutalisk)))))
          (define zerg-anti-air-now?
            (or zerg-real-anti-air-threat?
                (l2-ctx-zerg-holding-for-aa-corruptor? ctx)))
          (define zerg-spire-corr-cap
            (cond
              [zerg-heavy-cap-air-threat? 16]
              [(or (memq 'greater-spire ready-bldg-types)
                   (l2-building-present-or-pending? ctx 'greater-spire))
               6]
              [else 4]))
          (define hold-mutalisk-for-corruptor?
            (and live-game?
                 zerg-anti-air-now?
                 (< (l2-unit-count ctx 'corruptor) (if zerg-heavy-cap-air-threat? 12 zerg-spire-corr-cap))
                 (or (< (l2-ctx-minerals ctx) 250) (< (l2-ctx-gas ctx) 200))))
          (when (and (>= (l2-ctx-minerals ctx) (sc2-min-cost 'corruptor))
                     (>= (- (l2-ctx-gas ctx) (if (and zerg-anti-air-now? zerg-heavy-cap-air-threat?) 0 zerg-ultra-res-gas))
                         (sc2-gas-cost 'corruptor))
                     (or (not live-game?)
                         (and zerg-anti-air-now? (< (l2-unit-count ctx 'corruptor) zerg-spire-corr-cap))
                         (and (or (memq 'greater-spire ready-bldg-types)
                                  (l2-building-present-or-pending? ctx 'greater-spire))
                              (< (l2-unit-count ctx 'corruptor) 6))))
            (l2-try-train-unit! ctx 'corruptor 'larva 4
                                #:respect-bo-reserve? (not (and zerg-anti-air-now? zerg-heavy-cap-air-threat?))))
          (when (and (not hold-mutalisk-for-corruptor?)
                     (< (l2-unit-count ctx 'mutalisk) 10)
                     (>= (- (l2-ctx-gas ctx) zerg-ultra-res-gas) (sc2-gas-cost 'mutalisk))
                     (l2-can-spend-by-priority? ctx 'mutalisk 'combat-unit))
            (l2-try-train-unit! ctx 'mutalisk 'larva 4 #:respect-bo-reserve? #t))
          (when (and (memq 'hydralisk-den ready-bldg-types)
                     (>= (- (l2-ctx-gas ctx)
                            (+ zerg-ultra-res-gas
                               (if (l2-ctx-zerg-holding-for-aa-corruptor? ctx) zerg-spire-res-gas 0)))
                         (sc2-gas-cost 'hydralisk))
                     (< (l2-unit-count ctx 'hydralisk) zvt-hydra-std-cap)
                     (zvt-hydra-frontline-ok?))
            (l2-try-train-unit! ctx 'hydralisk 'larva 4
                             #:respect-bo-reserve? (or (l2-ctx-zerg-holding-for-aa-corruptor? ctx)
                                                       (and (>= (l2-unit-count ctx 'hydralisk) 6)
                                                            (not zerg-anti-air-now?)))))
          (try-zerg-roach-core!)
          (when (and (memq 'spawning-pool ready-bldg-types)
                     (zergling-under-cap?)
                     (not (zerg-hold-ling-for-gas-core?))
                     (>= (l2-ctx-minerals ctx) 300)
                     (or zerg-mineral-dump? (l2-can-spend-by-priority? ctx 'zergling 'combat-unit)))
            (l2-try-train-unit! ctx 'zergling 'larva (if zerg-mineral-dump? 6 4) #:respect-bo-reserve? (not zerg-mineral-dump?)))]
         [(and (memq 'hydralisk-den ready-bldg-types)
               (>= (- (l2-ctx-minerals ctx) zerg-spire-res-min) (sc2-min-cost 'hydralisk))
               (>= (- (l2-ctx-gas ctx) (+ zerg-ultra-res-gas zerg-spire-res-gas)) (sc2-gas-cost 'hydralisk)))
          (when (and (or (not live-game?)
                         (< (l2-unit-count ctx 'hydralisk) zvt-hydra-std-cap))
                     (zvt-hydra-frontline-ok?))
            (l2-try-train-unit! ctx 'hydralisk 'larva 4
                             #:respect-bo-reserve? (or (l2-ctx-zerg-holding-for-aa-spire? ctx)
                                                       (and (>= (l2-unit-count ctx 'hydralisk) 6)
                                                            (not zerg-real-anti-air-threat?)
                                                            (< (l2-ctx-gas ctx) 100)))))
          (when (and (memq 'roach-warren ready-bldg-types)
                     (not (and zerg-real-anti-air-threat?
                               (not zerg-aa-tech-ready?)
                               (< (l2-ctx-gas ctx) (+ (sc2-gas-cost 'hydralisk-den) (sc2-gas-cost 'hydralisk)))))
                     (or (not live-game?)
                         (and zerg-ground-threats-exist?
                              (or (< (l2-unit-count ctx 'roach) 8)
                                  (>= (l2-ctx-minerals ctx) 200)
                                  (< (l2-ctx-gas ctx) (sc2-gas-cost 'hydralisk)))
                              (< (l2-unit-count ctx 'roach) 20)))
                     (>= (- (l2-ctx-minerals ctx) zerg-spire-res-min) (sc2-min-cost 'roach))
                     (>= (- (l2-ctx-gas ctx) (+ (if (< (l2-unit-count ctx 'roach) 4) 0 zerg-ultra-res-gas) zerg-spire-res-gas)) (sc2-gas-cost 'roach))
                     (or (< (l2-unit-count ctx 'roach) 4)
                         (and live-game? (>= (l2-ctx-gas ctx) 50))
                         (l2-can-spend-by-priority? ctx 'roach 'combat-unit)))
            (l2-try-train-unit! ctx 'roach 'larva 4
                             #:respect-bo-reserve?
                             (or zerg-saving-for-tech-or-aa?
                                 (and (>= (l2-unit-count ctx 'roach) 4)
                                      (not under-base-attack?)
                                      (< (l2-ctx-gas ctx) 100)))))
          (when (and (memq 'spawning-pool ready-bldg-types)
                     (zergling-under-cap?)
                     (not (zerg-hold-ling-for-gas-core?))
                     (>= (l2-ctx-minerals ctx) 300)
                     (or zerg-mineral-dump? (l2-can-spend-by-priority? ctx 'zergling 'combat-unit)))
            (l2-try-train-unit! ctx 'zergling 'larva (if zerg-mineral-dump? 6 4) #:respect-bo-reserve? (not zerg-mineral-dump?)))]
         [(and (memq 'roach-warren ready-bldg-types)
               (not (and zerg-real-anti-air-threat?
                         (not zerg-aa-tech-ready?)
                         (< (l2-ctx-gas ctx) 150)))
               (or (not zerg-early-peaceful-drone-tempo?)
                   (< (l2-unit-count ctx 'roach) 2))
               (>= (- (l2-ctx-minerals ctx) zerg-spire-res-min) (sc2-min-cost 'roach))
               (>= (- (l2-ctx-gas ctx) (+ (if (< (l2-unit-count ctx 'roach) 4) 0 zerg-ultra-res-gas) zerg-spire-res-gas)) (sc2-gas-cost 'roach)))
          (define peaceful-roach-max-batch
            (if zerg-early-peaceful-drone-tempo?
                (max 0 (- 2 (l2-unit-count ctx 'roach)))
                #f))
          (l2-try-train-unit! ctx 'roach 'larva 4
                           #:max-batch peaceful-roach-max-batch
                           #:respect-bo-reserve?
                           (or zerg-early-peaceful-drone-tempo?
                               zerg-saving-for-tech-or-aa?
                               (and (>= (l2-unit-count ctx 'roach) 4)
                                    (not under-base-attack?)
                                    (< (l2-ctx-gas ctx) 100))))
          (when (and (memq 'spawning-pool ready-bldg-types)
                     (zergling-under-cap?)
                     (not (zerg-hold-ling-for-gas-core?))
                     (not zerg-needs-queen-or-warren-minerals?)
                     (or (< (l2-ctx-gas ctx) (sc2-gas-cost 'roach)) (>= (l2-ctx-minerals ctx) 200))
                     (or zerg-mineral-dump? (l2-can-spend-by-priority? ctx 'zergling 'combat-unit)))
            (define peaceful-ling-batch-rw
              (if zerg-early-peaceful-drone-tempo?
                  (min 2 (max 0 (quotient (add1 (max 0 (- zerg-peaceful-safety-ling-cap (l2-unit-count ctx 'zergling)))) 2)))
                  #f))
            (l2-try-train-unit! ctx 'zergling 'larva (if zerg-mineral-dump? 6 4)
                                #:max-batch peaceful-ling-batch-rw
                                #:respect-bo-reserve? (or zerg-early-peaceful-drone-tempo? (not zerg-mineral-dump?))))]
         [(and (memq 'spawning-pool ready-bldg-types)
               (zergling-under-cap?)
               (not (zerg-hold-ling-for-gas-core?))
               ;; L48-W2 + L48-W3b (`r14` First 6 Lings -> Spine #1 reserve): After training
               ;; the first `6` fast Zerglings, reserve `100M` for Spine Crawler #1 (`0` Spines)!
               (not (and (l2-ctx-worker-rush-active? ctx)
                         (>= (l2-unit-count ctx 'zergling) 6)
                         (= (l2-building-present-or-pending-count ctx 'spine-crawler) 0)
                         (>= total-workers 4)
                         (< (l2-ctx-minerals ctx) (+ (sc2-min-cost 'spine-crawler) (sc2-min-cost 'zergling)))))
               (or (not zerg-needs-queen-or-warren-minerals?)
                   (>= (l2-ctx-minerals ctx) (+ (sc2-min-cost 'queen) (sc2-min-cost 'zergling))))
               (or zerg-mineral-dump? (l2-can-spend-by-priority? ctx 'zergling 'combat-unit))
               (>= (l2-ctx-minerals ctx) (sc2-min-cost 'zergling))
               (or under-early-cheese?
                   urgent-combat-or-intel-need?
                   (>= (hash-ref pressure-metrics 'threat-pressure 0.0) 0.35)
                   (>= total-workers (add1 SC2-PRIORITY-WORKERS-PER-BASE))
                   (< (length ally-combat-units) SC2-ATTACK-WAVE-MIN-COMBAT-UNITS)
                   (>= (l2-ctx-minerals ctx) (sc2-min-cost 'queen))))
          (define peaceful-ling-batch-sp
            (if zerg-early-peaceful-drone-tempo?
                (min 2 (max 0 (quotient (add1 (max 0 (- zerg-peaceful-safety-ling-cap (l2-unit-count ctx 'zergling)))) 2)))
                #f))
          (l2-try-train-unit! ctx 'zergling 'larva (if zerg-mineral-dump? 6 4)
                              #:max-batch peaceful-ling-batch-sp
                              #:respect-bo-reserve? (or zerg-early-peaceful-drone-tempo? (not zerg-mineral-dump?)))]))
  (when (and (not zerg-drone-priority?)
                (not zerg-yield-larva-to-combat?)
                (not crisis-freeze-workers?)
                (l2-worker-army-curve-satisfied? ctx)
                (not zerg-saving-for-expand?)
                (l2-can-spend-by-priority? ctx 'drone 'worker)
                (< total-workers
                   (if live-game?
                       (min 70 zerg-eff-worker-ceiling)
                       target-workers))
                (or (member '(train drone) prio-scheduled-actions)
                    (< (hash-ref pressure-metrics 'threat-pressure 0.0) 1.0)))
       (l2-try-train-unit! ctx 'drone 'larva zerg-drone-batch
                        #:respect-bo-reserve? (l2-worker-respect-bo-reserve? ctx))))

;; L25-P0-3 (`#36 PvZ` Early Rush Hold): Detect < 3:00 (`< 4032f`) Zergling rush
;; (`>= 6` visible enemy Zerglings) so Protoss prioritizes Chrono'd Zealot #1/#2
;; from powered Gateway #1 BEFORE Gateway #2 / CyberCore / Natural Nexus!
;; L57-R2 (`#078 VeTerran` 110s CyberCore deadlock & `#36` 12-Pool 2nd-Gate hold):
;; Combat-unit threshold for `< 4:00` non-Reaper CyberCore crisis deferral (`< 1` vs Terran,
;; `< 4` during `< 3:00` 12-Pool Zergling rush only until Gateway #2 is up/pending, `< 2` otherwise).
(define (l2-protoss-cyber-defer-unit-threshold ctx)
  (cond
    [(eq? (l2-ctx-effective-enemy-race ctx) 'Terran) 1]
    [(and (l2-protoss-early-ling-rush? ctx)
          (< (+ (l2-cur-ally-canon-bldg-count ctx 'gateway)
                (l2-cur-ally-canon-bldg-count ctx 'warp-gate)
                (order-ledger-pending-count-for-type (l2-ctx-oledger ctx) 'gateway (l2-ctx-frame ctx)))
             2))
     4]
    [else 2]))

(define (l2-protoss-early-ling-rush? ctx)
  (and (eq? (l2-ctx-race ctx) 'Protoss)
       (l2-ctx-live-obs-harvesters? ctx)
       (< (l2-ctx-frame ctx) 4032)
       (>= (count (lambda (e)
                    (and (hash? e)
                         (eq? (fast-canonical-unit-sym (unit-type-sym e)) 'zergling)))
                  (l2-ctx-enemy-units ctx))
           6)))

;; L26-P0-3 (`#36 PvZ` `clip04` Visual-QA): While < 3:30 under early rush/attack with
;; 0 powered Gateways and 0 Zealots, defer non-Pylon tech warps (`CyberCore` / `ShieldBattery`)
;; so minerals fund an immediate repower Pylon + Zealot #1/#2 first!
(define (l2-protoss-unpowered-no-zealot-rush? ctx)
  (and (eq? (l2-ctx-race ctx) 'Protoss)
       (l2-ctx-live-obs-harvesters? ctx)
       (< (l2-ctx-frame ctx) 4704)
       (or (l2-ctx-early-survival-crisis? ctx)
           (l2-ctx-under-base-attack? ctx)
           (l2-protoss-early-ling-rush? ctx))
       (= (l2-unit-count ctx 'zealot) 0)
       (not (ormap (lambda (b)
                     (and (hash? b)
                          (memq (fast-canonical-structure-sym (unit-type-sym b)) '(gateway warp-gate))
                          (>= (hash-ref b 'build-progress 1.0) SC2-BUILD-COMPLETE-PROGRESS)
                          (not (eq? (hash-ref b 'powered? #t) #f))))
                   (l2-ctx-ally-bldgs ctx)))))

(define (l2-protoss-phase1-chrono-wall! ctx)
  (define allow-exact-wall-slot? (l2-ctx-allow-exact-wall-slot? ctx))
  (define ally-bldgs (l2-ctx-ally-bldgs ctx))
  (define ally-units (l2-ctx-ally-units ctx))
  (define base-x (l2-ctx-base-x ctx))
  (define base-y (l2-ctx-base-y ctx))
  (define blocked-nat-expanded-early? (l2-ctx-blocked-nat-expanded-early? ctx))
  (define cd-tracker (l2-ctx-cd-tracker ctx))
  (define cortex (l2-ctx-cortex ctx))
  (define crisis-freeze-expand-or-gas? (l2-ctx-crisis-freeze-expand-or-gas? ctx))
  (define crisis-tech-upgrade-deferral? (l2-ctx-crisis-tech-upgrade-deferral? ctx))
  (define cur-escrow-age-frames (l2-ctx-cur-escrow-age-frames ctx))
  (define desired-bases (l2-ctx-desired-bases ctx))
  (define early-survival-crisis? (l2-ctx-early-survival-crisis? ctx))
  (define eff-phase-supply (l2-ctx-eff-phase-supply ctx))
  (define endgame-corner-hunt? (l2-ctx-endgame-corner-hunt? ctx))
  (define enemy-units (l2-ctx-enemy-units ctx))
  (define forward-proxy-detected? (l2-ctx-forward-proxy-detected? ctx))
  (define frame (l2-ctx-frame ctx))
  (define hard-supply-lockout-reserve-min (l2-ctx-hard-supply-lockout-reserve-min ctx))
  (define in-base-proxy-detected? (l2-ctx-in-base-proxy-detected? ctx))
  (define leases (l2-ctx-leases ctx))
  (define live-army-supply (l2-ctx-live-army-supply ctx))
  (define live-game-obs? (l2-ctx-live-game-obs? ctx))
  (define live-game? (l2-ctx-live-obs-harvesters? ctx))
  (define macro-plan (l2-ctx-macro-plan ctx))
  (define nat-x (l2-ctx-nat-x ctx))
  (define nat-y (l2-ctx-nat-y ctx))
  (define obs (l2-ctx-obs ctx))
  (define oledger (l2-ctx-oledger ctx))
  (define open-prod-slots (l2-ctx-open-prod-slots ctx))
  (define power-placement-failed? (l2-ctx-power-placement-failed? ctx))
  (define protoss-matchup-wall (l2-ctx-protoss-matchup-wall ctx))
  (define ready-bldg-types (l2-ctx-ready-bldg-types ctx))
  (define ready-bldgs (l2-ctx-ready-bldgs ctx))
  (define rt (l2-ctx-rt ctx))
  (define tech-obs (l2-ctx-tech-obs ctx))
  (define total-workers (l2-ctx-total-workers ctx))
  (define under-base-attack? (l2-ctx-under-base-attack? ctx))
  (define under-early-cheese? (l2-ctx-under-early-cheese? ctx))
  (define worker-rush-active? (l2-ctx-worker-rush-active? ctx))
  (define workers (l2-ctx-workers ctx))
  (define nexuses-rev '())
  (define assimilators-rev '())
  (define active-assimilators-rev '())
  (define gateways-rev '())
  (for ([b (in-list ally-bldgs)])
       (define cs (fast-canonical-structure-sym (unit-type-sym b)))
       (cond
         [(eq? cs 'nexus)
          (set! nexuses-rev (cons b nexuses-rev))]
         [(eq? cs 'assimilator)
          (set! assimilators-rev (cons b assimilators-rev))
          (when (l2-active-gas-bldg? ctx b)
            (set! active-assimilators-rev (cons b active-assimilators-rev)))]
         [(memq cs '(gateway warp-gate))
          (set! gateways-rev (cons b gateways-rev))]))
  (define nexuses (reverse nexuses-rev))
  (set-l2-ctx-nexuses! ctx nexuses)
  (define assimilators (reverse assimilators-rev))
  (define active-assimilators (reverse active-assimilators-rev))
  (set-l2-ctx-active-assimilators! ctx active-assimilators)
  (define gateways (reverse gateways-rev))
  (set-l2-ctx-gateways! ctx gateways)
  (define ready-nexuses
       (let ([rev '()])
         (for ([b (in-list ready-bldgs)])
           (when (eq? (fast-canonical-structure-sym (unit-type-sym b)) 'nexus)
             (set! rev (cons b rev))))
         (reverse rev)))
  (define chrono-claimed-ids (mutable-seteqv))
  (define worker-rush-chrono? (l2-ctx-worker-rush-active? ctx))
  (define (eligible-live-chrono-target? b)
       (define bsym (fast-canonical-structure-sym (unit-type-sym b)))
       (and (or (hash-ref b 'busy? #f)
                (and (memq bsym '(gateway warp-gate))
                     (or (> (hash-ref b 'order-count 0) 0)
                         (pair? (hash-ref b 'orders '())))))
            (not (memq 'chrono-boost (hash-ref b 'buffs '())))
            (not (set-member? chrono-claimed-ids (hash-ref b 'id -1)))))
  (define protoss-early-ling-rush? (l2-protoss-early-ling-rush? ctx))
  (define protoss-early-gate-defenders
    (+ (l2-unit-count ctx 'zealot)
       (l2-unit-count ctx 'adept)
       (l2-unit-count ctx 'stalker)))
  ;; Loop 64 A5/B3 (`#1755`, Graph 20): Delegate Protoss Chrono Boost priority to pure leaf
  ;; `score-protoss-chrono-target-policy` (0-4m Probe focus -> sharp 4:00 Tech/Robo pivot,
  ;; eliminating the 27-42% Gateway Chrono sink while holding Nexus energy for Tech/Recharge).
  ;; Loop 64B Bug #4 (`#1811`): Only treat UNBUFFED eligible Tech/Robo structures as blocking
  ;; Nexus #2/#3 Chrono Boost so already-Chrono'd Forge/Robo never stalls Probes/Gateway!
  (define protoss-has-busy-tech-or-robo?
    (ormap (lambda (b)
             (and (hash? b)
                  (hash-ref b 'busy? #f)
                  (eligible-live-chrono-target? b)
                  (memq (fast-canonical-structure-sym (unit-type-sym b))
                        '(forge twilight-council cybernetics-core robotics-bay
                          templar-archive fleet-beacon dark-shrine
                          robotics-facility stargate))))
           ready-bldgs))
  (define protoss-main-base-breach?
    (and (or under-base-attack? early-survival-crisis?)
         (ormap (lambda (e)
                  (and (hash? e)
                       (real? (hash-ref e 'x #f))
                       (real? (hash-ref e 'y #f))
                       (<= (dist2d base-x base-y
                                   (exact->inexact (hash-ref e 'x 9999.0))
                                   (exact->inexact (hash-ref e 'y 9999.0)))
                           14.0)))
                enemy-units)))
  ;; Loop 62 Phase 2 + Loop 63B Bug #2B (`#1753`): Delegate Protoss Nexus Energy Recharge (`4126`) vs
  ;; ChronoBoost (`3755`) arbitration to pure leaf `evaluate-protoss-nexus-recharge-policy`.
  ;; Wire (`sc2-protobuf-ws.rkt`) owns the authoritative 1344f global cooldown upon actual `4126` emission;
  ;; L2 uses a 24f short dedup so an unemitted candidate never locks out Recharge for 60s!
  (define recharge-claims (rt-spell-claims rt))
  (define recharge-dedup-frames 24)
  (define recharge-cd-ready?
    (and (= (spell-unit-claim-count recharge-claims 'nexus-energy-recharge 1 frame) 0)
         (or (not live-game?)
             (sc2-nexus-recharge-cooldown-ready? frame))))
  (define recharge-nx-infos
    (for/list ([nx (in-list ready-nexuses)]
               #:when (and (hash? nx)
                           (exact-integer? (hash-ref nx 'id -1))
                           (> (hash-ref nx 'id -1) 0)
                           (real? (hash-ref nx 'x #f))
                           (real? (hash-ref nx 'y #f))))
      (macro-nexus-info (hash-ref nx 'id -1)
                        (exact->inexact (hash-ref nx 'x 0.0))
                        (exact->inexact (hash-ref nx 'y 0.0))
                        (exact->inexact (hash-ref nx 'energy 0.0))
                        #f #f)))
  ;; Loop 62C + Loop 63B: Populate `recharge-caster-infos` even when `enemy-units` is empty;
  ;; include `'mothership`, use edge-to-edge center cast-range (+2.5t) & 22.0t approach hold!
  (define recharge-caster-infos
    (if (and recharge-cd-ready? (pair? recharge-nx-infos))
        (for/list ([u (in-list ally-units)]
                   #:when (and (hash? u)
                               (real? (hash-ref u 'x #f))
                               (real? (hash-ref u 'y #f))
                               (memq (fast-canonical-unit-sym (unit-type-sym u))
                                     '(high-templar oracle sentry mothership))))
          (macro-caster-info (hash-ref u 'id -1)
                             (fast-canonical-unit-sym (unit-type-sym u))
                             (exact->inexact (hash-ref u 'x 0.0))
                             (exact->inexact (hash-ref u 'y 0.0))
                             (exact->inexact (hash-ref u 'energy 100.0))
                             (or (eq? (hash-ref u 'is-hallucination #f) #t)
                                 (eq? (hash-ref u 'hallucination #f) #t)
                                 (eq? (hash-ref u 'hallucination? #f) #t))))
        '()))
  (define recharge-cast-range-eff
    (+ (sc2-spell-cast-range 'nexus-energy-recharge 15.0) 2.5))
  (define recharge-dec
    (evaluate-protoss-nexus-recharge-policy
     #:ready-nexuses recharge-nx-infos
     #:ally-casters recharge-caster-infos
     #:enemy-units-present? (pair? enemy-units)
     #:recharge-available? (or (not live-game?) (sc2-ability-live-available? 4126))
     #:recharge-off-cooldown? recharge-cd-ready?
     #:cast-range recharge-cast-range-eff
     #:approach-hold-range 22.0))
  (define recharge-cast-nx-id (protoss-nexus-recharge-decision-cast-nexus-tag recharge-dec))
  (define recharge-cast-tgt-id (protoss-nexus-recharge-decision-cast-target-tag recharge-dec))
  (define recharge-hold-nx-ids (protoss-nexus-recharge-decision-hold-nexus-tags recharge-dec))
  (when (and recharge-cast-nx-id recharge-cast-tgt-id)
    (spell-claim-unit?! recharge-claims 'nexus-energy-recharge 1 frame recharge-dedup-frames #:caster-tag recharge-cast-nx-id)
    (l2-emit! ctx (list 'cast-spell recharge-cast-nx-id 'nexus-energy-recharge recharge-cast-tgt-id)))
  (define chrono-eligible-nexuses
    (if (and (not recharge-cast-nx-id) (set-empty? recharge-hold-nx-ids))
        ready-nexuses
        (filter (lambda (nx)
                  (define nid (hash-ref nx 'id -1))
                  (and (not (equal? nid recharge-cast-nx-id))
                       (not (set-member? recharge-hold-nx-ids nid))))
                ready-nexuses)))
  (define (protoss-dry-caster-near-nx? nx)
    (define nid (hash-ref nx 'id -1))
    (or (set-member? recharge-hold-nx-ids nid)
        (and (pair? recharge-caster-infos)
             (let ([nxx (exact->inexact (hash-ref nx 'x base-x))]
                   [nxy (exact->inexact (hash-ref nx 'y base-y))])
               (ormap (lambda (c)
                        (and (not (macro-caster-info-hallucination? c))
                             (< (exact->inexact (macro-caster-info-energy c)) 100.0)
                             (<= (dist2d nxx nxy (macro-caster-info-x c) (macro-caster-info-y c)) 22.0)))
                      recharge-caster-infos)))))
  (define (chrono-prio-score nx b)
    (define bsym (fast-canonical-structure-sym (unit-type-sym b)))
    (score-protoss-chrono-target-policy
     bsym
     #:loop frame
     #:worker-count total-workers
     #:nexus-energy (exact->inexact (hash-ref nx 'energy SC2-NEXUS-CHRONO-BOOST-ENERGY))
     #:has-busy-tech-or-robo? protoss-has-busy-tech-or-robo?
     #:dry-caster-near? (protoss-dry-caster-near-nx? nx)
     #:early-ling-or-worker-rush? (or protoss-early-ling-rush? worker-rush-chrono?)
     #:early-gate-defenders protoss-early-gate-defenders
     #:under-pressure? (or early-survival-crisis? under-base-attack?)
     #:main-base-breach? protoss-main-base-breach?
     #:army-supply live-army-supply))
  (if live-game?
         (fast-dispatch-macro-energy!
          chrono-eligible-nexuses
          ready-bldgs
          frame
          chrono-claimed-ids
          #:min-energy SC2-NEXUS-CHRONO-BOOST-ENERGY
          #:valid-pair?
          (lambda (nx b)
            (and (eligible-live-chrono-target? b)
                 (> (chrono-prio-score nx b) 0.0)))
          #:score-pair
          (lambda (nx b)
            (chrono-prio-score nx b))
          #:emit-cast!
          (lambda (nx b)
            (define nx-id (hash-ref nx 'id 201))
            (define ct-id (hash-ref b 'id nx-id))
            (l2-emit! ctx (list 'cast-spell nx-id 'chrono-boost ct-id))))
         (for ([nx (in-list chrono-eligible-nexuses)])
           (when (>= (hash-ref nx 'energy SC2-NEXUS-CHRONO-BOOST-ENERGY) SC2-NEXUS-CHRONO-BOOST-ENERGY)
             (define nx-id (hash-ref nx 'id 201))
             (define chrono-target
               (if (and (< total-workers SC2-EARLY-CHRONO-MAX-WORKERS)
                        (< frame SC2-EARLY-CHRONO-NEXUS-MAX-FRAME)
                        (not early-survival-crisis?))
                   nx
                   (or (and early-survival-crisis?
                            (findf (lambda (b)
                                     (memq (fast-canonical-structure-sym (unit-type-sym b))
                                           '(gateway warp-gate)))
                                   ready-bldgs))
                       (for/or ([prio-type (in-list PRO-CHRONO-11-STRUCTURES)]
                                #:when (not (eq? prio-type 'nexus)))
                         (findf (lambda (b)
                                  (eq? (fast-canonical-structure-sym (unit-type-sym b))
                                       (sc2-canonical-structure-sym prio-type)))
                                ready-bldgs))
                       nx)))
             (when chrono-target
               (define ct-id (hash-ref chrono-target 'id nx-id))
               (set-add! chrono-claimed-ids ct-id)
               (l2-emit! ctx (list 'cast-spell nx-id 'chrono-boost ct-id))))))
  (define wall-pylon-slot (and (hash? protoss-matchup-wall) (hash-ref protoss-matchup-wall 'pylon #f)))
  (define wall-slot-1 (and (hash? protoss-matchup-wall) (hash-ref protoss-matchup-wall 'slot-1 #f)))
  (define wall-slot-2 (and (hash? protoss-matchup-wall) (hash-ref protoss-matchup-wall 'slot-2 #f)))
  (define wall-slot-3 (and (hash? protoss-matchup-wall) (hash-ref protoss-matchup-wall 'slot-3 #f)))
  (set-l2-ctx-wall-slot-3! ctx wall-slot-3)
  (define wall-door-pt (and (hash? protoss-matchup-wall) (hash-ref protoss-matchup-wall 'door #f)))
  (define wall-park-pt (and (hash? protoss-matchup-wall) (hash-ref protoss-matchup-wall 'door-park #f)))
  (define door-guards
       (filter (lambda (u)
                 (and (memq (unit-type-sym u) '(zealot adept stalker))
                      (not (or (eq? (hash-ref u 'is-hallucination #f) #t)
                               (eq? (hash-ref u 'hallucination #f) #t)))))
