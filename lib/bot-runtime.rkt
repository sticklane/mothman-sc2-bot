(define (l34-phase5a-wave-casters! ctx)
  (define ally-bldgs (l34-ctx-ally-bldgs ctx))
  (define ally-units (l34-ctx-ally-units ctx))
  (define any-pro-caster? (l34-ctx-any-pro-caster? ctx))
  (define has-ally-queen? (l34-ctx-has-ally-queen? ctx))
  (define armory-ready-bldgs? (l34-ctx-armory-ready-bldgs? ctx))
  (define base-x (l34-ctx-base-x ctx))
  (define base-y (l34-ctx-base-y ctx))
  (define bstates (l34-ctx-bstates ctx))
  (define combat-units (l34-ctx-combat-units ctx))
  (define dead-tags-rt (l34-ctx-dead-tags-rt ctx))
  (define disruptor-handled-tags (l34-ctx-disruptor-handled-tags ctx))
  (define effects (l34-ctx-effects ctx))
  (define enemy-bldgs (l34-ctx-enemy-bldgs ctx))
  (define enemy-exp-x (l34-ctx-enemy-exp-x ctx))
  (define enemy-exp-y (l34-ctx-enemy-exp-y ctx))
  (define enemy-sieged-tanks-near (l34-ctx-enemy-sieged-tanks-near ctx))
  (define enemy-units (l34-ctx-enemy-units ctx))
  (define enemy-x (l34-ctx-enemy-x ctx))
  (define enemy-y (l34-ctx-enemy-y ctx))
  (define frame (l34-ctx-frame ctx))
  (define has-ally-scv? (l34-ctx-has-ally-scv? ctx))
  (define l34-sc (l34-ctx-l34-sc ctx))
  (define leases (l34-ctx-leases ctx))
  (define oledger (l34-ctx-oledger ctx))
  (define live-combat-supply (l34-ctx-live-combat-supply ctx))
  (define live-obs? (l34-ctx-live-obs? ctx))
  (define mode-candidates (l34-ctx-mode-candidates ctx))
  (define nat-x (l34-ctx-nat-x ctx))
  (define nat-y (l34-ctx-nat-y ctx))
  (define obs (l34-ctx-obs ctx))
  (define oracle-cast-tags (l34-ctx-oracle-cast-tags ctx))
  (define queen-cast-tags (l34-ctx-queen-cast-tags ctx))
  (define ravager-cast-tags (l34-ctx-ravager-cast-tags ctx))
  (define researched-upgs (l34-ctx-researched-upgs ctx))
  (define siege-line-hold? (l34-ctx-siege-line-hold? ctx))
  (define snipe-locked-tags (l34-ctx-snipe-locked-tags ctx))
  (define spell-claims-rt (l34-ctx-spell-claims-rt ctx))
  (define splash-evading-tags (l34-ctx-splash-evading-tags ctx))
  (define splash-thor-dwell-ht (l34-ctx-splash-thor-dwell-ht ctx))
  (define splash-vik-dwell-ht (l34-ctx-splash-vik-dwell-ht ctx))
  (define under-tactics-base-attack? (l34-ctx-under-tactics-base-attack? ctx))
  (define unit-mode-tr (l34-ctx-unit-mode-tr ctx))
  (define visible-enemy-combat-supply (l34-ctx-visible-enemy-combat-supply ctx))
  (define wave3-handled-tags (l34-ctx-wave3-handled-tags ctx))
  (define wave3-marauder-target-tags (l34-ctx-wave3-marauder-target-tags ctx))
  (define wave3-thor-morphed-tags (l34-ctx-wave3-thor-morphed-tags ctx))
  (define wave3-viking-morphed-tags (l34-ctx-wave3-viking-morphed-tags ctx))
  (define weighted-combat-units (l34-ctx-weighted-combat-units ctx))
  ;; ---------------------------------------------------------------------------
  ;; Active Combat Spells, Bistable Wave Hysteresis & Mutually Exclusive Micro
  ;; ---------------------------------------------------------------------------
  (define lanchester-force-ratio
    (/ (exact->inexact live-combat-supply)
       (max 8.0 (exact->inexact visible-enemy-combat-supply))))
  (define live-attack-wave-min
    (if live-obs?
        22
        SC2-ATTACK-WAVE-MIN-COMBAT-UNITS))
  (define wstate-wave (rt-wave-loss-state (l34-ctx-rt ctx)))
  (define w-est-enemy-army (exact->inexact (hash-ref wstate-wave 'est-enemy-army-supply 0.0)))
  (define w-pullback? (< frame (hash-ref wstate-wave 'pullback-until-frame -1)))
  (define wave-commit-active?
    (if live-obs?
        (bistable-hysteresis-step
         bstates
         'army-attack-wave
         frame
         #:enter? (and (not w-pullback?)
                       (>= live-combat-supply 28)
                       (>= live-combat-supply (* 1.25 w-est-enemy-army))
                       (or (>= live-combat-supply 42)
                           (>= lanchester-force-ratio 1.35)
                           (>= weighted-combat-units live-attack-wave-min)))
         #:exit? (or w-pullback?
                     (< live-combat-supply 16)
                     (and (> w-est-enemy-army 0.0)
                          (< live-combat-supply (* 0.85 w-est-enemy-army)))
                     (and (< live-combat-supply 20)
                          (< lanchester-force-ratio 0.85)))
         #:min-dwell-loops 112
         #:cooldown-loops 44)
        #t))
  (define bo-tplan (l34-get-bo-tplan ctx))
  (define bo-disp (bo-active-tactical-plan-disposition bo-tplan))
  (define bo-px (safe-coord (bo-active-tactical-plan-primary-target-x bo-tplan) enemy-x))
  (define bo-py (safe-coord (bo-active-tactical-plan-primary-target-y bo-tplan) enemy-y))
  (define bo-sx (safe-coord (bo-active-tactical-plan-secondary-fork-x bo-tplan) enemy-exp-x))
  (define bo-sy (safe-coord (bo-active-tactical-plan-secondary-fork-y bo-tplan) enemy-exp-y))
  (define bo-micro-dirs (bo-active-tactical-plan-micro-directives bo-tplan))
  (define bo-act-tactics (bo-active-tactical-plan-active-tactics bo-tplan))
  (define-values (bo-stage-x bo-stage-y)
    (let* ([sdx (- base-x bo-px)]
           [sdy (- base-y bo-py)]
           [sd (max 1.0 (sqrt (+ (* sdx sdx) (* sdy sdy))))])
      (values (safe-coord (+ bo-px (* 14.0 (/ sdx sd))) nat-x)
              (safe-coord (+ bo-py (* 14.0 (/ sdy sd))) nat-y))))
  (define combat-suppress-attack? (l34-ctx-combat-suppress-attack? ctx))
  (define bo-prepos-active?
    (and (eq? bo-disp 'pre-position-march-out)
         (not combat-suppress-attack?)
         (not under-tactics-base-attack?)))
  (define bo-contain-active?
    (and (eq? bo-disp 'contain-and-deny-third)
         (not combat-suppress-attack?)
         (not under-tactics-base-attack?)))
  (define bo-commit-active?
    (and (memq bo-disp '(execute-timing-attack-commit execute-timing-bypass-harass-fork))
         (not combat-suppress-attack?)
         (not under-tactics-base-attack?)))
  (define bo-fork-active?
    (and bo-commit-active?
         (or (eq? bo-disp 'execute-timing-bypass-harass-fork)
             (> (+ (* (- bo-sx bo-px) (- bo-sx bo-px))
                   (* (- bo-sy bo-py) (- bo-sy bo-py)))
                4.0))))
  (define bo-rally-override?
    (or bo-prepos-active? bo-contain-active? bo-commit-active?))
  (define-values (bo-rally-tx bo-rally-ty)
    (cond
      [bo-prepos-active? (values bo-stage-x bo-stage-y)]
      [(or bo-contain-active? bo-commit-active?) (values bo-px bo-py)]
      [else (values nat-x nat-y)]))
  (define eff-wave-commit?
    (and (not combat-suppress-attack?)
         (or wave-commit-active? bo-commit-active?)))
  (define fbo-px (exact->inexact bo-px))
  (define fbo-py (exact->inexact bo-py))
  (define fbo-rally-tx (exact->inexact bo-rally-tx))
  (define fbo-rally-ty (exact->inexact bo-rally-ty))
  (define engagement-enemies
    (if live-obs?
        (append enemy-units enemy-bldgs)
        enemy-units))
  (define static-defense-syms
    '(spine-crawler photon-cannon bunker planetary-fortress))
  (define short-range-bio-syms
    '(marine marauder zergling roach hydralisk zealot stalker adept))
  (define (l34-friendly-th-coords)
    (define ths
      (for/list ([b (in-list ally-bldgs)]
                 #:when (and (hash? b)
                             (memq (fast-canonical-structure-sym (unit-type-sym b))
                                   '(hatchery lair hive nexus command-center orbital-command planetary-fortress))))
        (cons (exact->inexact (hash-ref b 'x base-x))
              (exact->inexact (hash-ref b 'y base-y)))))
    (if (pair? ths) ths (list (cons (exact->inexact base-x) (exact->inexact base-y)))))
  (define (l34-nearest-th-xy-dist th-coords x y)
    (for/fold ([bx (exact->inexact base-x)] [by (exact->inexact base-y)] [bd2 +inf.0]
               #:result (values bx by (sqrt (if (< bd2 +inf.0) bd2 0.0))))
              ([tc (in-list th-coords)])
      (define dx (fl- (exact->inexact x) (car tc)))
      (define dy (fl- (exact->inexact y) (cdr tc)))
      (define d2 (fl+ (fl* dx dx) (fl* dy dy)))
      (if (fl< d2 bd2) (values (car tc) (cdr tc) d2) (values bx by bd2))))
  (define (l34-home-reserved-queen-id-set th-coords)
    (define qs
      (for/list ([u (in-list ally-units)]
                 #:when (and (hash? u)
                             (eq? (fast-canonical-unit-sym (unit-type-sym u)) 'queen)
                             (exact-integer? (hash-ref u 'id #f))))
        u))
    (define cap (min (length qs) (+ (* 2 (max 1 (length th-coords))) 2)))
    (define ranked
      (sort qs <
            #:key (lambda (q)
                    (define-values (_hx _hy d)
                      (l34-nearest-th-xy-dist th-coords (hash-ref q 'x base-x) (hash-ref q 'y base-y)))
                    d)
            #:cache-keys? #t))
    (for/seteqv ([q (in-list (take ranked cap))])
      (hash-ref q 'id)))

  ;; Wave 3: Pro Spellcaster Micro & Dedicated Terran Unit Mode/Lock-On Micro
  (define scv-repair-claims #f)
  (define cached-scv-units #f)
  (define cached-scv-busy-ht #f)
  (define skipped-wave-mech-repair? #f)
  (when live-obs?
    (define sp-dirs
      (cond
        [(not any-pro-caster?) '()]
        [else
         (define seen (pooled-hasheqv! l34-sc 'spell-excl-seen))
         (define acc-rev '())
         (define (add-tag! id)
           (when (and (exact-integer? id) (not (hash-has-key? seen id)))
             (hash-set! seen id #t)
             (set! acc-rev (cons id acc-rev))))
         (for ([id (in-set splash-evading-tags)]) (add-tag! id))
         (for ([id (in-set disruptor-handled-tags)]) (add-tag! id))
         (for ([id (in-set ravager-cast-tags)]) (add-tag! id))
         (for ([id (in-set wave3-handled-tags)]) (add-tag! id))
         (define has-zerg-caster? #f)
         (define has-terran-nonscv-caster? #f)
         (define has-ally-raven? #f)
         (define has-ally-ghost? #f)
         (define has-ally-medivac? #f)
         (define has-jump-ready-bc? #f)
         (define has-protoss-caster? #f)
         (define has-damaged-bio? #f)
         (define has-damaged-repairable-u? #f)
         (define has-damaged-mech-5? #f)
         (define drminx +inf.0)
         (define drmaxx -inf.0)
         (define drminy +inf.0)
         (define drmaxy -inf.0)
         (define inject-q-rev '())
         (define scv-rev '())
         (define t-casters-rev '())
         (define zcminx +inf.0)
         (define zcmaxx -inf.0)
         (define zcminy +inf.0)
         (define zcmaxy -inf.0)
         (define tcminx +inf.0)
         (define tcmaxx -inf.0)
         (define tcminy +inf.0)
         (define tcmaxy -inf.0)
         (define pcminx +inf.0)
         (define pcmaxx -inf.0)
         (define pcminy +inf.0)
         (define pcmaxy -inf.0)
         (for ([u (in-list ally-units)]
               #:when (hash? u))
           (define ut (unit-type-sym u))
           (define cr (hash-ref PRO-CASTER-RACE-HT ut #f))
           (cond
             [(eq? cr 'zerg)
              (set! has-zerg-caster? #t)
              (define rx (hash-ref u 'x RUNTIME-MISSING))
              (define ry (hash-ref u 'y RUNTIME-MISSING))
              (when (and (real? rx) (real? ry))
                (define fx (exact->inexact rx))
                (define fy (exact->inexact ry))
                (when (< fx zcminx) (set! zcminx fx))
                (when (> fx zcmaxx) (set! zcmaxx fx))
                (when (< fy zcminy) (set! zcminy fy))
                (when (> fy zcmaxy) (set! zcmaxy fy)))
              (when (and has-ally-queen? (eq? ut 'queen))
                (define uid (hash-ref u 'id #f))
                (when (exact-integer? uid)
                  ;; W3-TAC-6: Exempt combat Queens with >= 50 energy within <= 10t of an injured
                  ;; high-value ally (<65% HP) from home-recall & inject-queen reservation so Transfuse fires!
                  (define queen-urgent-transfuse?
                    (and (>= (hash-ref u 'energy 0) 50)
                         (real? rx) (real? ry)
                         (let ([fqx (exact->inexact rx)]
                               [fqy (exact->inexact ry)])
                           (or (for/or ([a (in-list ally-units)] #:when (hash? a))
                                 (and (not (eqv? (hash-ref a 'id -1) uid))
                                      (let* ([hp (hash-ref a 'hp #f)]
                                             [mhp (or (hash-ref a 'max-hp #f) (hash-ref a 'hp-max #f))]
                                             [ax (hash-ref a 'x #f)]
                                             [ay (hash-ref a 'y #f)])
                                        (and (real? hp) (real? mhp) (>= mhp 120.0)
                                             (< hp (* 0.65 mhp))
                                             (>= (- mhp hp) 50.0)
                                             (real? ax) (real? ay)
                                             (let ([dx (fl- fqx (exact->inexact ax))]
                                                   [dy (fl- fqy (exact->inexact ay))])
                                               (fl<= (fl+ (fl* dx dx) (fl* dy dy)) 100.0))))))
                               (for/or ([b (in-list ally-bldgs)] #:when (hash? b))
                                 (and (memq (fast-canonical-structure-sym (unit-type-sym b))
                                            '(hatchery lair hive spine-crawler spore-crawler))
                                      (let* ([hp (hash-ref b 'hp #f)]
                                             [mhp (or (hash-ref b 'max-hp #f) (hash-ref b 'hp-max #f))]
                                             [bx (hash-ref b 'x #f)]
                                             [by (hash-ref b 'y #f)])
                                        (and (real? hp) (real? mhp) (> mhp 0.0)
                                             (< hp (* 0.65 mhp))
                                             (real? bx) (real? by)
                                             (let ([dx (fl- fqx (exact->inexact bx))]
                                                   [dy (fl- fqy (exact->inexact by))])
                                               (fl<= (fl+ (fl* dx dx) (fl* dy dy)) 100.0))))))))))
                  (define thc (or (hash-ref l34-sc 'th-coords-cache #f)
                                  (let ([c (l34-friendly-th-coords)])
                                    (hash-set! l34-sc 'th-coords-cache c)
                                    c)))
                  (define rset (or (hash-ref l34-sc 'reserved-q-set #f)
                                   (let ([s (l34-home-reserved-queen-id-set thc)])
                                     (hash-set! l34-sc 'reserved-q-set s)
                                     s)))
                  (define-values (qth-x qth-y qth-dist)
                    (l34-nearest-th-xy-dist thc (hash-ref u 'x base-x) (hash-ref u 'y base-y)))
                  ;; W5-TAC-2: Never recall frontline Queens home mid-fight when enemy combat is <= 16t
                  ;; or allied combat is engaged <= 12t of the Queen (fixes z04 3/3 frontline Queens recalled 64t home!).
                  (define queen-in-active-combat?
                    (and (real? rx) (real? ry)
                         (let ([fqx (exact->inexact rx)]
                               [fqy (exact->inexact ry)])
                           (or (for/or ([e (in-list enemy-units)] #:when (hash? e))
                                 (and (combat-unit-record? e)
                                      (not (memq (unit-type-sym e)
                                                 '(overlord overlord-cocoon overlord-transport overlord-transport-cocoon
                                                   overseer overseer-siege-mode observer larva egg
                                                   changeling changeling-zealot changeling-zergling
                                                   changeling-zergling-wings changeling-marine changeling-marine-shield
                                                   creep-tumor creep-tumor-burrowed creep-tumor-queen)))
                                      (real? (hash-ref e 'x #f)) (real? (hash-ref e 'y #f))
                                      (let ([dx (fl- fqx (exact->inexact (hash-ref e 'x 9999.0)))]
                                            [dy (fl- fqy (exact->inexact (hash-ref e 'y 9999.0)))])
                                        (fl<= (fl+ (fl* dx dx) (fl* dy dy)) 256.0))))
                               (and (pair? enemy-units)
                                    (for/or ([a (in-list combat-units)] #:when (hash? a))
                                      (and (not (eqv? (hash-ref a 'id -1) uid))
                                           (not (eq? (unit-type-sym a) 'queen))
                                           (real? (hash-ref a 'x #f)) (real? (hash-ref a 'y #f))
                                           (let ([ax (exact->inexact (hash-ref a 'x 9999.0))]
                                                 [ay (exact->inexact (hash-ref a 'y 9999.0))])
                                             (and (let ([dx (fl- fqx ax)] [dy (fl- fqy ay)])
                                                    (fl<= (fl+ (fl* dx dx) (fl* dy dy)) 144.0))
                                                  (for/or ([e (in-list enemy-units)] #:when (hash? e))
                                                    (and (combat-unit-record? e)
                                                         (real? (hash-ref e 'x #f)) (real? (hash-ref e 'y #f))
                                                         (let ([edx (fl- ax (exact->inexact (hash-ref e 'x 9999.0)))]
                                                               [edy (fl- ay (exact->inexact (hash-ref e 'y 9999.0)))])
                                                           (fl<= (fl+ (fl* edx edx) (fl* edy edy)) 256.0)))))))))))))
                  (cond
                    [(or queen-urgent-transfuse? queen-in-active-combat?) (void)]
                    [(and (> qth-dist 35.0)
                          (or (set-member? rset uid)
                              (unit-leased-above? leases uid 'inject-queen frame)
                              (unit-leased-above? leases uid 'creep-queen frame)))
                     (add-tag! uid)
                     (when (refractory-allow-action?! (live-bot-runtime-cooldown-tracker (l34-ctx-rt ctx))
                                                      (list 'queen-home-recall uid)
                                                      frame
                                                      16)
                       (l34-emit! ctx (list 'move uid (safe-coord qth-x base-x) (safe-coord qth-y base-y))))]
                    [(unit-leased-above? leases uid 'creep-queen frame)
                     (add-tag! uid)]
                    [(or (unit-leased-above? leases uid 'inject-queen frame)
                         (set-member? rset uid))
                     (set! inject-q-rev (cons uid inject-q-rev))])))]
             [(eq? cr 'terran)
              (cond
                [(eq? ut 'scv)
                 (when has-ally-scv?
                   (set! scv-rev (cons u scv-rev)))]
                [else
                 (set! has-terran-nonscv-caster? #t)
                 (set! t-casters-rev (cons u t-casters-rev))
                 (cond
                   [(eq? ut 'raven) (set! has-ally-raven? #t)]
                   [(eq? ut 'ghost) (set! has-ally-ghost? #t)]
                   [(eq? ut 'medivac) (set! has-ally-medivac? #t)]
                   [(eq? ut 'battlecruiser)
                    (unless (eq? (hash-ref u 'tactical-jump-ready? #t) #f)
                      (set! has-jump-ready-bc? #t))])
                 (define rx (hash-ref u 'x RUNTIME-MISSING))
                 (define ry (hash-ref u 'y RUNTIME-MISSING))
                 (when (and (real? rx) (real? ry))
                   (define fx (exact->inexact rx))
                   (define fy (exact->inexact ry))
                   (when (< fx tcminx) (set! tcminx fx))
                   (when (> fx tcmaxx) (set! tcmaxx fx))
                   (when (< fy tcminy) (set! tcminy fy))
                   (when (> fy tcmaxy) (set! tcmaxy fy)))])]
             [(eq? cr 'protoss)
              (set! has-protoss-caster? #t)
              (define rx (hash-ref u 'x RUNTIME-MISSING))
              (define ry (hash-ref u 'y RUNTIME-MISSING))
              (when (and (real? rx) (real? ry))
                (define fx (exact->inexact rx))
                (define fy (exact->inexact ry))
                (when (< fx pcminx) (set! pcminx fx))
                (when (> fx pcmaxx) (set! pcmaxx fx))
                (when (< fy pcminy) (set! pcminy fy))
                (when (> fy pcmaxy) (set! pcmaxy fy)))])
           ;; Fast-path check for injured bio (Medivac heal < 0.92) or damaged mechanical (SCV repair < 0.90)
           (when (or (not has-damaged-bio?) has-ally-scv?)
             (define chp (hash-ref u 'hp RUNTIME-MISSING))
             (define mhp (hash-ref u 'max-hp RUNTIME-MISSING))
             (define sh (hash-ref u 'shields 0))
             (define msh (hash-ref u 'max-shields 0))
             (define missing-hp-stats?
               (or (eq? chp RUNTIME-MISSING) (eq? mhp RUNTIME-MISSING)
                   (not (real? chp)) (not (real? mhp)) (<= mhp 0)))
             (when (or missing-hp-stats?
                       (< chp (* 0.92 mhp))
                       (and (real? sh) (real? msh) (> msh 0) (< (+ chp sh) (* 0.92 (+ mhp msh)))))
               (unless (hash-ref u 'hallucination? #f)
                 (define attr-mask (combat:unit-attribute-mask ut))
                 (when (and (not has-damaged-bio?)
                            (not (zero? (bitwise-and attr-mask combat:SC2-UNIT-ATTR-BIOLOGICAL)))
                            (zero? (bitwise-and attr-mask combat:SC2-UNIT-ATTR-STRUCTURE)))
                   (set! has-damaged-bio? #t))
                 (when (and has-ally-scv?
                            (not (zero? (bitwise-and attr-mask combat:SC2-UNIT-ATTR-MECHANICAL)))
                            (or missing-hp-stats?
                                (< chp (* 0.90 mhp))
                                (and (real? sh) (real? msh) (> msh 0) (< (+ chp sh) (* 0.90 (+ mhp msh))))))
                   (when (or missing-hp-stats? (>= (- mhp chp) 5.0))
                     (set! has-damaged-mech-5? #t))
                   (when (or missing-hp-stats? (>= (- mhp chp) 15.0) (> msh 0))
                     (set! has-damaged-repairable-u? #t)
                     (let ([rx (hash-ref u 'x RUNTIME-MISSING)]
                           [ry (hash-ref u 'y RUNTIME-MISSING)])
                       (when (and (real? rx) (real? ry))
                         (define fx (exact->inexact rx))
                         (define fy (exact->inexact ry))
                         (when (< fx drminx) (set! drminx fx))
                         (when (> fx drmaxx) (set! drmaxx fx))
                         (when (< fy drminy) (set! drminy fy))
                         (when (> fy drmaxy) (set! drmaxy fy))))))))))
         (define has-damaged-bldg? #f)
         (when has-ally-scv?
           (for ([b (in-list ally-bldgs)]
                 #:when (hash? b))
             (define chp (hash-ref b 'hp RUNTIME-MISSING))
             (define mhp (hash-ref b 'max-hp RUNTIME-MISSING))
             (define bt-c (fast-canonical-structure-sym (unit-type-sym b)))
             (define fort-bldg? (memq bt-c '(planetary-fortress bunker missile-turret)))
             (define missing-hp-stats?
               (or (eq? chp RUNTIME-MISSING) (eq? mhp RUNTIME-MISSING)
                   (not (real? chp)) (not (real? mhp)) (<= mhp 0)))
             (when (and (or missing-hp-stats?
                            (and (< chp (- mhp 0.5))
                                 (if fort-bldg?
                                     (or (< chp (* 0.98 mhp)) (>= (- mhp chp) 5.0))
                                     (and (< chp (* 0.90 mhp)) (>= (- mhp chp) 15.0)))))
                        (not (hash-ref b 'hallucination? #f))
                        (not (zero? (bitwise-and (combat:unit-attribute-mask (unit-type-sym b))
                                                 combat:SC2-UNIT-ATTR-MECHANICAL))))
               (set! has-damaged-bldg? #t)
               (let ([rx (hash-ref b 'x RUNTIME-MISSING)]
                     [ry (hash-ref b 'y RUNTIME-MISSING)])
                 (when (and (real? rx) (real? ry))
                   (define fx (exact->inexact rx))
                   (define fy (exact->inexact ry))
                   (when (< fx drminx) (set! drminx fx))
                   (when (> fx drmaxx) (set! drmaxx fx))
                   (when (< fy drminy) (set! drminy fy))
                   (when (> fy drmaxy) (set! drmaxy fy)))))))
         (define has-damaged-repairable? (or has-damaged-repairable-u? has-damaged-bldg?))
         (define has-active-scv-caster? #f)
         (set! skipped-wave-mech-repair? (not (or has-damaged-mech-5? has-damaged-bldg?)))
         (when has-ally-scv?
           (set! cached-scv-units (reverse scv-rev))
           (when has-damaged-repairable?
             (define s-busy-ht (pooled-hasheqv! l34-sc 'scv-busy-ht))
             (for ([u (in-list scv-rev)])
               (define uid (hash-ref u 'id #f))
               (when (exact-integer? uid)
                 (define busy? (scv-busy-econ-or-leased? u uid leases oledger frame))
                 (hash-set! s-busy-ht uid (not (not busy?)))
                 (if busy?
                     (add-tag! uid)
                     (let ([sx (hash-ref u 'x RUNTIME-MISSING)]
                           [sy (hash-ref u 'y RUNTIME-MISSING)])
                       (when (or (not (real? sx)) (not (real? sy)) (> drminx drmaxx))
                         (set! has-active-scv-caster? #t))
                       (when (and (real? sx) (real? sy))
                         (define fx (exact->inexact sx))
                         (define fy (exact->inexact sy))
                         (when (or (> drminx drmaxx)
                                   (and (>= fx (- drminx 11.0)) (<= fx (+ drmaxx 11.0))
                                        (>= fy (- drminy 11.0)) (<= fy (+ drmaxy 11.0))))
                           (set! has-active-scv-caster? #t)
                           (when (< fx tcminx) (set! tcminx fx))
                           (when (> fx tcmaxx) (set! tcmaxx fx))
                           (when (< fy tcminy) (set! tcminy fy))
                           (when (> fy tcmaxy) (set! tcmaxy fy))))))))
             (set! cached-scv-busy-ht s-busy-ht)))
         (define has-terran-caster? (or has-terran-nonscv-caster? (and has-ally-scv? has-active-scv-caster?)))
         (define inject-q-tags (if (null? inject-q-rev) '() (reverse inject-q-rev)))
         (define spell-excl-tags (if (null? acc-rev) '() (reverse acc-rev)))
         (prune-spell-claims! spell-claims-rt frame)
         (define hx (exact->inexact base-x))
         (define hy (exact->inexact base-y))
         (define (slice-bbox-units lst mnx mxx mny mxy pad)
           (if (or (null? lst) (> mnx mxx))
               lst
               (let ([emin-x (- mnx pad)]
                     [emax-x (+ mxx pad)]
                     [emin-y (- mny pad)]
                     [emax-y (+ mxy pad)])
                 (for/list ([e (in-list lst)]
                            #:when (or (not (hash? e))
                                       (let ([ex (hash-ref e 'x RUNTIME-MISSING)]
                                             [ey (hash-ref e 'y RUNTIME-MISSING)])
                                         (or (not (real? ex)) (not (real? ey))
                                             (and (>= ex emin-x) (<= ex emax-x)
                                                  (>= ey emin-y) (<= ey emax-y))))))
                   e))))
         (define z-dirs
           (if has-zerg-caster?
               (plan-zerg-spellcaster-micro
                (slice-bbox-units ally-units zcminx zcmaxx zcminy zcmaxy 26.0)
                (slice-bbox-units enemy-units zcminx zcmaxx zcminy zcmaxy 18.0)
                #:claims spell-claims-rt
                #:current-frame frame
                #:ally-buildings (slice-bbox-units ally-bldgs zcminx zcmaxx zcminy zcmaxy 26.0)
                #:enemy-buildings (slice-bbox-units enemy-bldgs zcminx zcmaxx zcminy zcmaxy 28.0)
                #:effects effects
                #:researched-upgrades researched-upgs
                #:neural-parasite-researched? (l34-has-upgrade? ctx 'neural-parasite)
                #:microbial-shroud-ok? (sc2-ability-live-available? 4111)
                #:home-x hx
                #:home-y hy
                #:enemy-base-x (exact->inexact enemy-x)
                #:enemy-base-y (exact->inexact enemy-y)
                #:inject-queen-tags inject-q-tags
                #:exclude-tags spell-excl-tags)
               '()))
         (define t-dirs
           (if has-terran-caster?
               (let* ([use-t-box? (and (not has-jump-ready-bc?) (<= tcminx tcmaxx))]
                      [t-pad (if has-active-scv-caster? 26.0 18.0)]
                      [t-rush-st (rt-rush-defense-state (l34-ctx-rt ctx))]
                      [t-pure-worker-rush-no-bldg-repair?
                       (and (hash? t-rush-st)
                            (or (eq? (hash-ref t-rush-st 'heavy-pure-worker-allin-latched? #f) #t)
                                (< frame (hash-ref t-rush-st 'kiting-rush-until -1))
                                (< frame (hash-ref t-rush-st 'worker-rush-active-until -1)))
                            (not (ormap (lambda (e)
                                          (and (hash? e)
                                               (not (memq (unit-type-sym e) '(probe scv drone)))
                                               (combat-unit-record? e)
                                               (let ([ex (hash-ref e 'x #f)] [ey (hash-ref e 'y #f)])
                                                 (and (real? ex) (real? ey)
                                                      (<= (fast-dist2d hx hy (exact->inexact ex) (exact->inexact ey)) 24.0)))))
                                        enemy-units)))]
                      [t-ally-bldgs
                       (if (and has-active-scv-caster? has-damaged-bldg?)
                           (let ([raw-tb
                                  (if use-t-box?
                                      (slice-bbox-units ally-bldgs tcminx tcmaxx tcminy tcmaxy t-pad)
                                      ally-bldgs)])
                             ;; L48-W2 (`r15` SCV `3685` repair suppression): Under an active pure
                             ;; worker rush (0 enemy combat units), strip non-fortification structures
                             ;; (CC/Barracks/Depot) from SCV repair targets while keeping Bunker/PF/Turret!
                             (if t-pure-worker-rush-no-bldg-repair?
                                 (filter (lambda (b)
                                           (and (hash? b)
                                                (memq (fast-canonical-structure-sym (unit-type-sym b))
                                                      '(bunker planetary-fortress missile-turret auto-turret))))
                                         raw-tb)
                                 raw-tb))
                           '())]
                      [t-has-combat-mech-or-fort-repair-tgt?
                       (or (pair? t-ally-bldgs)
                           (ormap (lambda (u)
                                    (and (hash? u)
                                         (let ([ut (fast-canonical-unit-sym (unit-type-sym u))])
                                           (and (not (eq? ut 'scv))
                                                (not (zero? (bitwise-and (combat:unit-attribute-mask ut)
                                                                         combat:SC2-UNIT-ATTR-MECHANICAL)))))))
                                  ally-units))]
                      [t-ally-units
                       (let ([raw-tu
                              (cond
                                [(or has-ally-raven? has-ally-ghost? has-active-scv-caster? (and has-ally-medivac? has-damaged-bio?))
                                 (if use-t-box?
                                     (slice-bbox-units ally-units tcminx tcmaxx tcminy tcmaxy t-pad)
                                     ally-units)]
                                [else (reverse t-casters-rev)])])
                         (if (and t-pure-worker-rush-no-bldg-repair?
                                  (not t-has-combat-mech-or-fort-repair-tgt?))
                             (filter (lambda (u) (not (and (hash? u) (eq? (unit-type-sym u) 'scv)))) raw-tu)
                             raw-tu))]
                      [t-enemy-units
                       (if use-t-box?
                           (slice-bbox-units enemy-units tcminx tcmaxx tcminy tcmaxy t-pad)
                           enemy-units)]
                      [t-enemy-bldgs
                       (if use-t-box?
                           (slice-bbox-units enemy-bldgs tcminx tcmaxx tcminy tcmaxy t-pad)
                           enemy-bldgs)])
                 (plan-terran-spellcaster-micro
                  t-ally-units
                  t-enemy-units
                  #:claims spell-claims-rt
                  #:current-frame frame
                  #:ally-buildings t-ally-bldgs
                  #:enemy-buildings t-enemy-bldgs
                  #:effects effects
                  #:researched-upgrades researched-upgs
                  ;; L40-P0-1d (`#918/#919`, `t15`): SC2 4.10/5.0 requires Fusion Core `WeaponRefit` (`76`)
                  ;; to unlock Battlecruiser Yamato Cannon (`401`).
                  #:yamato-researched? (or (not (l34-ctx-live-upgrades-tracked? ctx))
                                           (l34-has-upgrade? ctx 'weapon-refit))
                  #:ghost-cloak-researched? (l34-has-upgrade? ctx 'personal-cloaking)
                  #:interference-matrix-researched? (l34-has-upgrade? ctx 'interference-matrix)
                  #:home-x hx
                  #:home-y hy
                  #:exclude-tags spell-excl-tags))
               '()))
         (define p-dirs
           (if has-protoss-caster?
               (plan-protoss-spellcaster-micro
                (slice-bbox-units ally-units pcminx pcmaxx pcminy pcmaxy 18.0)
                (slice-bbox-units enemy-units pcminx pcmaxx pcminy pcmaxy 18.0)
                #:claims spell-claims-rt
                #:current-frame frame
                #:ally-buildings (slice-bbox-units ally-bldgs pcminx pcmaxx pcminy pcmaxy 18.0)
                #:enemy-buildings (slice-bbox-units enemy-bldgs pcminx pcmaxx pcminy pcmaxy 18.0)
                #:effects effects
                #:researched-upgrades researched-upgs
                #:psi-storm-researched? (l34-has-upgrade? ctx 'psi-storm)
                #:home-x hx
                #:home-y hy
                #:natural-x (exact->inexact nat-x)
                #:natural-y (exact->inexact nat-y)
                #:enemy-base-x (exact->inexact enemy-x)
                #:enemy-base-y (exact->inexact enemy-y)
                #:choke-points (list (cons nat-x nat-y) (cons enemy-exp-x enemy-exp-y))
                #:exclude-tags spell-excl-tags)
               '()))
         (cond
           [(and (null? t-dirs) (null? p-dirs)) z-dirs]
           [(and (null? z-dirs) (null? p-dirs)) t-dirs]
           [(and (null? z-dirs) (null? t-dirs)) p-dirs]
           [else (append z-dirs t-dirs p-dirs)])]))
    (define injected-th-ids
      (and (pair? sp-dirs)
           (ormap (lambda (sd) (eq? (spell-directive-ability sd) 'inject-larva)) sp-dirs)
           (for/fold ([ids '()]) ([b (in-list ally-bldgs)] #:when (hash? b))
             (define bs (hash-ref b 'buffs '()))
             (define bid (hash-ref b 'id #f))
             (if (and (exact-integer? bid)
                      (or (> (safe-nonneg-int (hash-ref b 'queen-spawn-larva-timer 0) 0) 0)
                          (and (list? bs)
                               (or (memq 'inject-larva bs)
                                   (memq 'queen-spawn-larva bs)
                                   (memq 'queen-spawn-larva-timer bs)
                                   (memv 11 bs)))))
                 (cons bid ids)
                 ids))))
    ;; L48-P0-1b (`rd01` Queen Widow-Mine Defense): When enemy Widow Mines (`widow-mine` /
    ;; `widow-mine-burrowed`) threaten our mineral line (`<= 16t` of our Queens), suspend Queen
    ;; macro `creep-tumor`/`inject-larva` casts (preserving `transfuse`!) so Queens immediately
    ;; focus-fire detected Widow Mines (or stage within `<= 7.5t` waiting for Overseer reveal)
    ;; instead of planting 13 Creep Tumors behind the Hatchery while 16 Drones die!
    (define queen-near-wm-coords
      (if (and has-ally-queen? (pair? enemy-units))
          (for/list ([e (in-list enemy-units)]
                     #:when (and (hash? e)
                                 (not (eq? (hash-ref e 'snapshot? #f) #t))
                                 (memq (fast-canonical-unit-sym (unit-type-sym e))
                                       '(widow-mine widow-mine-burrowed))
                                 (real? (hash-ref e 'x #f)) (real? (hash-ref e 'y #f))))
            (vector (hash-ref e 'id 0)
                    (exact->inexact (hash-ref e 'x 0.0))
                    (exact->inexact (hash-ref e 'y 0.0))
                    (let ([cv (hash-ref e 'cloak #f)])
                      (or (eqv? cv 1) (eq? cv 'cloaked)))))
          '()))
    (define (queen-id-near-wm? qid)
      (and (pair? queen-near-wm-coords)
           (for/or ([u (in-list ally-units)]
                    #:when (and (hash? u)
                                (eqv? (hash-ref u 'id -1) qid)
                                (real? (hash-ref u 'x #f)) (real? (hash-ref u 'y #f))))
             (define fqx (exact->inexact (hash-ref u 'x 0.0)))
             (define fqy (exact->inexact (hash-ref u 'y 0.0)))
             (for/or ([wv (in-list queen-near-wm-coords)])
               (define dx (fl- fqx (vector-ref wv 1)))
               (define dy (fl- fqy (vector-ref wv 2)))
               (fl<= (fl+ (fl* dx dx) (fl* dy dy)) 256.0)))))
    (for ([sd (in-list sp-dirs)])
      (define ab (spell-directive-ability sd))
      (define cid (spell-directive-caster-tag sd))
      (define tid (spell-directive-target-tag sd))
      (unless (or (and (eq? ab 'inject-larva)
                       (pair? injected-th-ids)
                       (exact-integer? tid)
                       (memv tid injected-th-ids))
                  (and (eq? (spell-directive-caster-type sd) 'queen)
                       (memq ab '(creep-tumor creep-tumor-queen inject-larva))
                       (queen-id-near-wm? cid)))
        (define sexp (spell-directive->sexp sd))
        (set-add! wave3-handled-tags cid)
        (when (and (eq? (spell-directive-target-mode sd) 'pair) (exact-integer? tid) (> tid 0))
          (set-add! wave3-handled-tags tid))
        (when (eq? ab 'corrosive-bile)
          (set-add! ravager-cast-tags cid))
        (when (eq? (spell-directive-caster-type sd) 'queen)
          (set-add! queen-cast-tags cid))
        (when (eq? (spell-directive-caster-type sd) 'oracle)
          (set-add! oracle-cast-tags cid))
        (when (and (eq? ab 'repair) (exact-integer? tid) (> tid 0))
          (unless scv-repair-claims (set! scv-repair-claims (make-hasheqv)))
          (hash-update! scv-repair-claims tid add1 0))
        ;; L40-P0-1d (`t15`) + L58-P1: NEVER emit same-tick `attack-unit` (`P2`) alongside channeled/key
        ;; spells (`yamato-cannon`, `caustic-spray`, `contaminate`, `hallucination-archon`, `nexus-energy-recharge`)!
        (when (memq ab '(yamato-cannon caustic-spray contaminate hallucination-archon nexus-energy-recharge abduct viper-consume))
          (set-add! snipe-locked-tags cid))
        (when (eq? ab 'caustic-spray)
          (define splash-cs (rt-splash-state (l34-ctx-rt ctx)))
          (when (hash? splash-cs)
            (hash-set! (hash-ref! splash-cs 'corruptor-spray-cast-frame make-hasheqv) cid frame)))
        (l34-emit-preserved! ctx sexp)))
    ;; L58-P1 (`sc2-ab-t10`): Preserved Orbital Command Scanner Sweep (`399`) whenever an uncovered
    ;; cloaked/burrowed/shimmer enemy is within `32t` of any friendly unit/building (shares `last-scan-frame`
    ;; dedup with L2 so it never double-scans, and guarantees Tier-P0 delivery even if L2 was throttled!).
    (when (and (pair? ally-bldgs) (pair? enemy-units))
      (define ready-ocs-p5
        (for/list ([b (in-list ally-bldgs)]
                   #:when (and (hash? b)
                               (eq? (fast-canonical-structure-sym (unit-type-sym b)) 'orbital-command)
                               (>= (hash-ref b 'build-progress 1.0) SC2-BUILD-COMPLETE-PROGRESS)
                               (>= (exact->inexact (hash-ref b 'energy 0.0)) 50.0)))
          b))
      (when (pair? ready-ocs-p5)
        (define splash-st-p5 (rt-splash-state (l34-ctx-rt ctx)))
        (define last-sf (hash-ref splash-st-p5 'last-scan-frame -9999))
        (when (or (not live-obs?) (< frame last-sf) (>= (- frame last-sf) 44))
          (define cloak-tgt
            (for/first ([e (in-list enemy-units)]
                        #:when (and (hash? e)
                                    (not (memq (fast-canonical-unit-sym (unit-type-sym e))
                                               '(creep-tumor creep-tumor-burrowed creep-tumor-queen)))
                                    (or (eqv? (hash-ref e 'cloak 0) 1)
                                        (eq? (hash-ref e 'cloak #f) 'cloaked)
                                        (eq? (hash-ref e 'is-shimmer? #f) #t)
                                        (eq? (hash-ref e 'burrowed #f) #t)
                                        (eq? (hash-ref e 'is-burrowed #f) #t))
                                    (real? (hash-ref e 'x #f)) (real? (hash-ref e 'y #f))
                                    (let ([ex0 (exact->inexact (hash-ref e 'x 9999.0))]
                                          [ey0 (exact->inexact (hash-ref e 'y 9999.0))])
                                      (or (for/or ([a (in-list ally-units)])
                                            (and (hash? a)
                                                 (real? (hash-ref a 'x #f)) (real? (hash-ref a 'y #f))
                                                 (<= (fast-dist2d ex0 ey0
                                                                  (exact->inexact (hash-ref a 'x 0.0))
                                                                  (exact->inexact (hash-ref a 'y 0.0)))
                                                     32.0)))
                                          (for/or ([b (in-list ally-bldgs)])
                                            (and (hash? b)
                                                 (real? (hash-ref b 'x #f)) (real? (hash-ref b 'y #f))
                                                 (<= (fast-dist2d ex0 ey0
                                                                  (exact->inexact (hash-ref b 'x 0.0))
                                                                  (exact->inexact (hash-ref b 'y 0.0)))
                                                     32.0)))))))
              e))
          (when cloak-tgt
            (define oc-id (hash-ref (car ready-ocs-p5) 'id -1))
            (when (and (exact-integer? oc-id) (> oc-id 0))
              (define sx (safe-coord (hash-ref cloak-tgt 'x base-x) base-x))
              (define sy (safe-coord (hash-ref cloak-tgt 'y base-y) base-y))
              (hash-set! splash-st-p5 'last-scan-frame frame)
              (l34-emit-preserved! ctx (list 'cast-spell oc-id 'scanner-sweep sx sy)))))))
    ;; Loop 62 Phase 2: Nexus Energy Recharge (`4126`) is owned exclusively by Layer 2
    ;; (`evaluate-protoss-nexus-recharge-policy`) and `plan-protoss-spellcaster-micro` (shared `spell-claims`).
    ;; W5-TAC-2 + L40-P0-1f + L48-P0-1b (`e02` Queen vs 2 Reapers, `rd01` Queen vs Widow Mine Drop):
    ;; Active frontline/defending Queens not casting Transfuse/Inject actively shoot nearby enemy
    ;; combat units (`<= 16t` free Queens, `<= 12t` leased Queens), prioritizing detected Widow Mines
    ;; first (via `l34-emit-preserved!`) and advancing within `<= 7.5t` of undetected burrowed mines!
    (when (and has-ally-queen? (pair? enemy-units))
      (define q-combat-enemies
        (for/list ([e (in-list enemy-units)]
                   #:when (and (hash? e)
                               (combat-unit-record? e)
                               (not (eq? (hash-ref e 'snapshot? #f) #t))
                               (eqv? (hash-ref e 'display-type 1) 1)
                               (let ([cv (hash-ref e 'cloak #f)])
                                 (not (or (eqv? cv 1) (eq? cv 'cloaked))))
                               (not (memq (unit-type-sym e)
                                          '(overlord overlord-cocoon overlord-transport overlord-transport-cocoon
                                            overseer overseer-siege-mode observer larva egg
                                            changeling changeling-zealot changeling-zergling
                                            changeling-zergling-wings changeling-marine changeling-marine-shield
                                            creep-tumor creep-tumor-burrowed creep-tumor-queen)))
                               (exact-integer? (hash-ref e 'id #f))
                               (> (hash-ref e 'id 0) 0)
                               (real? (hash-ref e 'x #f))
                               (real? (hash-ref e 'y #f))))
          (define ecs (fast-canonical-unit-sym (unit-type-sym e)))
          (vector (hash-ref e 'id 0)
                  (exact->inexact (hash-ref e 'x 0.0))
                  (exact->inexact (hash-ref e 'y 0.0))
                  (or (eq? (hash-ref e 'flying #f) #t)
                      (eq? (hash-ref e 'flying? #f) #t)
                      (eq? (hash-ref e 'is-flying #f) #t)
                      (fast-unit-is-flying-sym? (unit-type-sym e)))
                  (and (memq ecs '(widow-mine widow-mine-burrowed)) #t))))
      (when (or (pair? q-combat-enemies) (pair? queen-near-wm-coords))
        (for ([u (in-list ally-units)]
              #:when (and (hash? u)
                          (eq? (unit-type-sym u) 'queen)
                          (let ([qid (hash-ref u 'id -1)])
                            (and (exact-integer? qid) (> qid 0)
                                 (not (set-member? wave3-handled-tags qid))
                                 (not (set-member? queen-cast-tags qid))))
                          (real? (hash-ref u 'x #f))
                          (real? (hash-ref u 'y #f))))
          (define qid (hash-ref u 'id 0))
          (define q-leased?
            (or (unit-leased-above? leases qid 'inject-queen frame)
                (unit-leased-above? leases qid 'creep-queen frame)))
          (define q-max-d2 (if q-leased? 144.0 256.0))
          (define fqx (exact->inexact (hash-ref u 'x 0.0)))
          (define fqy (exact->inexact (hash-ref u 'y 0.0)))
          (define best-eid #f)
          (define best-is-wm? #f)
          (define best-score +inf.0)
          (for ([ev (in-list q-combat-enemies)])
            (define dx (fl- fqx (vector-ref ev 1)))
            (define dy (fl- fqy (vector-ref ev 2)))
            (define d2 (fl+ (fl* dx dx) (fl* dy dy)))
            (define is-wm? (vector-ref ev 4))
            (when (fl<= d2 (if is-wm? 256.0 q-max-d2))
              (define air? (vector-ref ev 3))
              ;; Prioritize detected Widow Mines (`* 0.10`, beating Medivacs!), then air threats <= 12t
              (define sc
                (cond [is-wm? (fl* d2 0.10)]
                      [(and air? (fl<= d2 144.0)) (fl* d2 0.35)]
                      [else d2]))
              (when (fl< sc best-score)
                (set! best-score sc)
                (set! best-eid (vector-ref ev 0))
                (set! best-is-wm? is-wm?))))
          (cond
            [best-eid
             (set-add! wave3-handled-tags qid)
             (if best-is-wm?
                 (l34-emit-preserved! ctx (list 'attack-unit qid best-eid))
                 (l34-emit! ctx (list 'attack-unit qid best-eid)))]
            [(pair? queen-near-wm-coords)
             ;; Undetected burrowed Widow Mine waiting on Overseer reveal -> stage Queen <= 6.5t (<= 7.5t)!
             (define-values (wmx wmy wd2)
               (for/fold ([bx 0.0] [by 0.0] [bd2 256.01]) ([wv (in-list queen-near-wm-coords)])
                 (define dx (fl- fqx (vector-ref wv 1)))
                 (define dy (fl- fqy (vector-ref wv 2)))
                 (define d2 (fl+ (fl* dx dx) (fl* dy dy)))
                 (if (fl< d2 bd2) (values (vector-ref wv 1) (vector-ref wv 2) d2) (values bx by bd2))))
             (when (and (fl< wd2 256.0) (fl> wd2 49.0))
               (define wd (flsqrt wd2))
               (define step (flmax 1.0 (fl- wd 6.2)))
               (define qtx (safe-coord (fl+ fqx (fl* step (fl/ (fl- wmx fqx) wd))) fqx))
               (define qty (safe-coord (fl+ fqy (fl* step (fl/ (fl- wmy fqy) wd))) fqy))
               (set-add! wave3-handled-tags qid)
               (l34-emit-preserved! ctx (list 'move qid qtx qty)))]))))
    ;; W3-TAC-7 + W15c + L50-W1 (`#50` `REG #3` Medivac Solo Over-Fly Guard):
    ;; Keep empty/healing Medivacs tethered `<= 6.0t` behind friendly bio centroid away from
    ;; enemy AA (`photon-cannon`/`missile-turret`/`spore-crawler`/`stalker`/`viking`/etc.),
    ;; and pull lone empty Medivacs away from enemy AA so they NEVER fly solo over Cannons!
    (define medivac-fog-suppress? (l34-ctx-fog-belief-suppress? ctx))
    (define empty-medivacs-p4
      (for/list ([mu (in-list ally-units)]
                 #:when (and (hash? mu)
                             (eq? (unit-type-sym mu) 'medivac)
                             (let ([mid (hash-ref mu 'id -1)])
                               (and (exact-integer? mid) (> mid 0)
                                    (= (safe-nonneg-int (hash-ref mu 'cargo-space-taken 0) 0) 0)
                                    (not (unit-medivac-loaded? mu))
                                    (real? (hash-ref mu 'x #f))
                                    (real? (hash-ref mu 'y #f))
                                    (not (set-member? wave3-handled-tags mid))
                                    (not (set-member? splash-evading-tags mid))))))
        mu))
    (when (and (pair? empty-medivacs-p4)
               (or (pair? enemy-units) (pair? enemy-bldgs) medivac-fog-suppress? (pair? combat-units)))
      (define bio-sum-x 0.0)
      (define bio-sum-y 0.0)
      (define bio-cnt 0)
      (for ([cu (in-list combat-units)])
        (when (memq (unit-type-sym cu) '(marine marauder ghost reaper hellbat))
          (define bx0 (hash-ref cu 'x #f))
          (define by0 (hash-ref cu 'y #f))
          (when (and (real? bx0) (real? by0))
            (set! bio-sum-x (fl+ bio-sum-x (exact->inexact bx0)))
            (set! bio-sum-y (fl+ bio-sum-y (exact->inexact by0)))
            (set! bio-cnt (add1 bio-cnt)))))
      (define aa-threat-pts
        (append
         (for/list ([eu (in-list enemy-units)]
                    #:when (and (hash? eu)
                                (not (eq? (hash-ref eu 'snapshot? #f) #t))
                                (eqv? (hash-ref eu 'display-type 1) 1)
                                (fast-can-attack-air? (unit-type-sym eu))
                                (real? (hash-ref eu 'x #f)) (real? (hash-ref eu 'y #f))))
           (cons (exact->inexact (hash-ref eu 'x 0.0))
                 (exact->inexact (hash-ref eu 'y 0.0))))
         (for/list ([eb (in-list enemy-bldgs)]
                    #:when (and (hash? eb)
                                (not (eq? (hash-ref eb 'snapshot? #f) #t))
                                (memq (fast-canonical-structure-sym (unit-type-sym eb))
                                      '(photon-cannon missile-turret spore-crawler bunker))
                                (>= (hash-ref eb 'build-progress 1.0) 0.85)
                                (real? (hash-ref eb 'x #f)) (real? (hash-ref eb 'y #f))))
           (cons (exact->inexact (hash-ref eb 'x 0.0))
                 (exact->inexact (hash-ref eb 'y 0.0))))))
      (define (nearest-aa-pt px py)
        (for/fold ([bx #f] [by #f] [bd +inf.0]) ([pt (in-list aa-threat-pts)])
          (define d (fast-dist2d px py (car pt) (cdr pt)))
          (if (fl< d bd) (values (car pt) (cdr pt) d) (values bx by bd))))
      (cond
        [(> bio-cnt 0)
         (define bcx (fl/ bio-sum-x (->fl bio-cnt)))
         (define bcy (fl/ bio-sum-y (->fl bio-cnt)))
         (define-values (baa-x baa-y baa-d) (nearest-aa-pt bcx bcy))
         ;; Also compute live enemy combat centroid (even for 0-AA Zergling/Baneling armies!)
         ;; so fast Medivacs NEVER drift ahead of Bio (`TvZ caster_exp 100% -> < 10%`).
         (define-values (med-ecnt med-esx med-esy)
           (for/fold ([c 0] [sx 0.0] [sy 0.0])
                     ([eu (in-list enemy-units)]
                      #:when (and (hash? eu)
                                  (combat-unit-record? eu)
                                  (not (eq? (hash-ref eu 'snapshot? #f) #t))
                                  (eqv? (hash-ref eu 'display-type 1) 1)
                                  (real? (hash-ref eu 'x #f))
                                  (real? (hash-ref eu 'y #f))))
             (values (add1 c)
                     (fl+ sx (exact->inexact (hash-ref eu 'x 0.0)))
                     (fl+ sy (exact->inexact (hash-ref eu 'y 0.0))))))
         (define med-ecx (if (> med-ecnt 0) (fl/ med-esx (->fl med-ecnt)) (exact->inexact (l34-ctx-enemy-x ctx))))
         (define med-ecy (if (> med-ecnt 0) (fl/ med-esy (->fl med-ecnt)) (exact->inexact (l34-ctx-enemy-y ctx))))
         (define e-dx (fl- med-ecx bcx))
         (define e-dy (fl- med-ecy bcy))
         (define e-dn (flmax 1.0 (flsqrt (fl+ (fl* e-dx e-dx) (fl* e-dy e-dy)))))
         (define e-fux (fl/ e-dx e-dn))
         (define e-fuy (fl/ e-dy e-dn))
         (define hdx (fl- (exact->inexact base-x) bcx))
         (define hdy (fl- (exact->inexact base-y) bcy))
         (define hd (flmax 1.0 (flsqrt (fl+ (fl* hdx hdx) (fl* hdy hdy)))))
         (define home-ux (fl/ hdx hd))
         (define home-uy (fl/ hdy hd))
         (for ([mu (in-list empty-medivacs-p4)])
           (define mid (hash-ref mu 'id -1))
           (define mx (exact->inexact (hash-ref mu 'x base-x)))
           (define my (exact->inexact (hash-ref mu 'y base-y)))
           (define d-bio (fast-dist2d mx my bcx bcy))
           (define med-proj (fl+ (fl* (fl- mx bcx) e-fux) (fl* (fl- my bcy) e-fuy)))
           (define med-ahead-of-bio? (and (>= bio-cnt 2) (fl> med-proj -0.8)))
           (define-values (naa-x naa-y naa-d) (nearest-aa-pt mx my))
           (define any-near-enemy?
             (or (fl<= naa-d 18.0)
                 (for/or ([eu (in-list enemy-units)] #:when (hash? eu))
                   (and (combat-unit-record? eu)
                        (real? (hash-ref eu 'x #f)) (real? (hash-ref eu 'y #f))
                        (<= (fast-dist2d mx my
                                         (exact->inexact (hash-ref eu 'x 9999.0))
                                         (exact->inexact (hash-ref eu 'y 9999.0)))
                            18.0)))))
           (when (or medivac-fog-suppress?
                     med-ahead-of-bio?
                     (fl> d-bio 6.0)
                     (fl<= naa-d 12.0)
                     (and baa-x (fl<= baa-d 24.0) (fl< naa-d (fl- baa-d 1.0)))
                     any-near-enemy?)
             (define-values (away-ux away-uy)
               (cond
                 [(and baa-x (fl<= baa-d 22.0))
                  (define dx (fl- bcx baa-x))
                  (define dy (fl- bcy baa-y))
                  (define d (flmax 0.5 (flsqrt (fl+ (fl* dx dx) (fl* dy dy)))))
                  (values (fl/ dx d) (fl/ dy d))]
                 [(and naa-x (fl<= naa-d 22.0))
                  (define dx (fl- bcx naa-x))
                  (define dy (fl- bcy naa-y))
                  (define d (flmax 0.5 (flsqrt (fl+ (fl* dx dx) (fl* dy dy)))))
                  (values (fl/ dx d) (fl/ dy d))]
                 [(or (> med-ecnt 0) med-ahead-of-bio?)
                  (values (fl- e-fux) (fl- e-fuy))]
                 [else (values home-ux home-uy)]))
             (define rear-step (if (or baa-x naa-x) 3.2 2.5))
             (define t1x (safe-coord (fl+ bcx (fl* rear-step away-ux)) bcx))
             (define t1y (safe-coord (fl+ bcy (fl* rear-step away-uy)) bcy))
             (define-values (_tx1 _ty1 t1-aa-d) (nearest-aa-pt t1x t1y))
             (define leash-x
               (if (fl< t1-aa-d 9.5)
                   (safe-coord (fl+ bcx (fl* 5.2 away-ux)) bcx)
                   t1x))
             (define leash-y
               (if (fl< t1-aa-d 9.5)
                   (safe-coord (fl+ bcy (fl* 5.2 away-uy)) bcy)
                   t1y))
             (set-add! wave3-handled-tags mid)
             (l34-emit-preserved! ctx (list 'move mid leash-x leash-y))))]
        [else
         (for ([mu (in-list empty-medivacs-p4)])
           (define mid (hash-ref mu 'id -1))
           (define mx (exact->inexact (hash-ref mu 'x base-x)))
           (define my (exact->inexact (hash-ref mu 'y base-y)))
           (define-values (naa-x naa-y naa-d) (nearest-aa-pt mx my))
           (when (and naa-x (fl<= naa-d 12.0))
             (define adx (fl- mx naa-x))
             (define ady (fl- my naa-y))
             (define ad (flmax 0.5 (flsqrt (fl+ (fl* adx adx) (fl* ady ady)))))
             (define hdx (fl- (exact->inexact base-x) mx))
             (define hdy (fl- (exact->inexact base-y) my))
             (define hd (flmax 1.0 (flsqrt (fl+ (fl* hdx hdx) (fl* hdy hdy)))))
             (define bx (fl+ (fl/ adx ad) (fl/ hdx hd)))
             (define by (fl+ (fl/ ady ad) (fl/ hdy hd)))
             (define bd (flmax 0.5 (flsqrt (fl+ (fl* bx bx) (fl* by by)))))
             (define ret-x (safe-coord (fl+ mx (fl* 7.5 (fl/ bx bd))) (exact->inexact base-x)))
             (define ret-y (safe-coord (fl+ my (fl* 7.5 (fl/ by bd))) (exact->inexact base-y)))
             (set-add! wave3-handled-tags mid)
             (l34-emit-preserved! ctx (list 'move mid ret-x ret-y))))]))
    ;; Lock channeling Ghosts (Snipe `2714` / `34f`) AND channeling Battlecruisers (Yamato `401`
    ;; / Jump `2358` / `52f`) in BOTH `snipe-locked-tags` & `wave3-handled-tags` so `l34-phase5b`
    ;; never overwrites an active channel with `attack-unit` or `move`!
    (for ([u (in-list combat-units)])
      (define ut (unit-type-sym u))
      (when (or (eq? ut 'ghost) (eq? ut 'battlecruiser))
        (define uid (hash-ref u 'id -1))
        (when (and (exact-integer? uid)
                   (> uid 0)
                   (cond
                     [(eq? ut 'ghost)
                      (or (snipe-channel-locked? spell-claims-rt uid frame)
                          (spellcaster-channel-protected? u))]
                     [else
                      (or (bc-yamato-channel-locked? spell-claims-rt u frame)
                          (spellcaster-channel-protected? u))]))
          (set-add! snipe-locked-tags uid)
          (set-add! wave3-handled-tags uid))))

    (when (not (null? mode-candidates))
      (define um-cyclone-seen
        (or (hash-ref l34-sc 'um-cyclone-seen #f)
            (let ([ht (make-hasheqv)])
              (hash-set! l34-sc 'um-cyclone-seen ht)
              ht)))
      (define sync-has-active-lock?
        (and (not (hash-empty? um-cyclone-seen))
             (for/or ([ctag (in-hash-keys um-cyclone-seen)])
               (let-values ([(tgt _age _cd) (unit-mode-tracker-cyclone-lock-state unit-mode-tr ctag frame)])
                 (> tgt 0)))))
      (sync-unit-mode-tracker! unit-mode-tr
                               (if sync-has-active-lock? ally-units mode-candidates)
                               enemy-units
                               frame
                               #:dead-tags dead-tags-rt
                               #:track-air-memory? #t)
      (define armory-ready-rt?
        (or (and (hash-ref obs 'armory-ready? #f) #t)
            armory-ready-bldgs?))
      (define no-excl-tags?
        (and (set-empty? splash-evading-tags)
             (set-empty? disruptor-handled-tags)
             (set-empty? wave3-handled-tags)))
      (define (um-eligible? u)
        (define uid (and (hash? u) (hash-ref u 'id -1)))
        (and (exact-integer? uid)
             (> uid 0)
             (let* ([ab-id (hash-ref u 'order-ability-id 0)]
                    [prot (and (> ab-id 0) (fast-order-protection-class ab-id))])
               (not (memq prot '(morph channel))))
             (or no-excl-tags?
                 (and (not (set-member? splash-evading-tags uid))
                      (not (set-member? disruptor-handled-tags uid))
                      (not (set-member? wave3-handled-tags uid))))))
      (define has-thor? #f)
      (define has-hellion? #f)
      (define has-viking? #f)
      (define viking-needs-eval? #f)
      (define has-cyclone? #f)
      (define eligible-mode-rev '())
      (for ([u (in-list mode-candidates)]
            #:when (um-eligible? u))
        (define ut (unit-type-sym u))
        (cond
          [(or (eq? ut 'thor) (eq? ut 'thor-ap))
           (set! has-thor? #t)
           (set! eligible-mode-rev (cons u eligible-mode-rev))]
          [(or (eq? ut 'hellion) (eq? ut 'hellbat))
           (set! has-hellion? #t)
           (set! eligible-mode-rev (cons u eligible-mode-rev))]
          [(or (eq? ut 'viking) (eq? ut 'viking-fighter) (eq? ut 'viking-assault))
           (set! has-viking? #t)
           (set! eligible-mode-rev (cons u eligible-mode-rev))
           (unless viking-needs-eval?
             (if (eq? ut 'viking-assault)
                 (set! viking-needs-eval? #t)
                 (let ([uid (hash-ref u 'id -1)]
                       [chp (hash-ref u 'hp RUNTIME-MISSING)]
                       [mhp (hash-ref u 'max-hp RUNTIME-MISSING)])
                   (when (and (>= (unit-mode-tracker-viking-dwell-elapsed unit-mode-tr uid frame)
                                  VIKING-GROUND-DWELL-FRAMES)
                              (or (eq? chp RUNTIME-MISSING) (eq? mhp RUNTIME-MISSING)
                                  (not (real? chp)) (not (real? mhp)) (<= mhp 0)
                                  (>= chp (* VIKING-LAND-MIN-HP-RATIO mhp))))
                     (set! viking-needs-eval? #t)))))]
          [(eq? ut 'cyclone)
           (set! has-cyclone? #t)
           (set! eligible-mode-rev (cons u eligible-mode-rev))
           (hash-set! um-cyclone-seen (hash-ref u 'id -1) #t)]))
      (define um-allies
        (cond
          [(or has-hellion? (and has-viking? viking-needs-eval?))
           (for/list ([u (in-list ally-units)] #:when (um-eligible? u)) u)]
          [(or has-thor? has-cyclone?)
           (reverse eligible-mode-rev)]
          [else '()]))
      ;; L50-W3-1 (`d10`): Keep ALL living non-Viking allies (e.g. Cloaked Banshees handled in Wave 3)
      ;; visible to `plan-viking-modes` for `ally-pwr` & `ally-has-stealth?` while still skipping
      ;; ineligible Vikings!
      (define viking-um-allies
        (if (and has-viking? viking-needs-eval?)
            (for/list ([u (in-list ally-units)]
                       #:when (and (hash? u)
                                   (or (not (memq (unit-type-sym u) '(viking viking-fighter viking-assault)))
                                       (um-eligible? u))))
              u)
            '()))
      (when has-thor?
        (for ([td (in-list (plan-thor-modes um-allies enemy-units #:tracker unit-mode-tr #:current-frame frame))])
          (define uid (unit-mode-directive-unit-tag td))
          (hash-set! splash-thor-dwell-ht uid frame)
          (set-add! wave3-thor-morphed-tags uid)
          (set-add! wave3-handled-tags uid)
          (l34-emit-preserved! ctx (unit-mode-directive->sexp td))))
      (when has-hellion?
        (for ([hd (in-list (plan-hellion-modes um-allies enemy-units
                                               #:tracker unit-mode-tr
                                               #:current-frame frame
                                               #:armory-ready? armory-ready-rt?))])
          (set-add! wave3-handled-tags (unit-mode-directive-unit-tag hd))
          (l34-emit-preserved! ctx (unit-mode-directive->sexp hd))))
      (when (and has-viking? viking-needs-eval?)
        (for ([vd (in-list (plan-viking-modes viking-um-allies enemy-units
                                              #:tracker unit-mode-tr
                                              #:current-frame frame
                                              #:home-x (exact->inexact base-x)
                                              #:home-y (exact->inexact base-y)))])
          (define uid (unit-mode-directive-unit-tag vd))
          (hash-set! splash-vik-dwell-ht uid frame)
          (set-add! wave3-viking-morphed-tags uid)
          (set-add! wave3-handled-tags uid)
          (l34-emit-preserved! ctx (unit-mode-directive->sexp vd))))
      (when has-cyclone?
        (define cyc-cd-ht (spell-claims-cyclone-lock-on-ready-frame spell-claims-rt))
        (for ([cd (in-list (plan-cyclone-micro um-allies enemy-units
                                               #:tracker unit-mode-tr
                                               #:current-frame frame
                                               #:home-x (exact->inexact base-x)
                                               #:home-y (exact->inexact base-y)))])
          (define cid (unit-mode-directive-unit-tag cd))
          (define is-lock-on? (eq? (unit-mode-directive-ability cd) 'lock-on))
          (unless (and is-lock-on?
                       (< frame (hash-ref cyc-cd-ht cid -1)))
            (when is-lock-on?
              (hash-set! cyc-cd-ht cid (+ frame 196)))
            (set-add! wave3-handled-tags cid)
            (l34-emit-preserved! ctx (unit-mode-directive->sexp cd))))))
      ;; L59 Tier-1A (`#1499`): Wire `plan-counter-unit-mode-micro` (incl. `break-enemy-cyclone-lock-on`)
      ;; when enemy Cyclone / Hellbat / landed Viking / Thor AP is visible!
      (when (and (pair? enemy-units)
                 (ormap (lambda (e)
                          (and (hash? e)
                               (memq (fast-canonical-unit-sym (unit-type-sym e))
                                     '(cyclone hellbat viking-assault thor-ap))))
                        enemy-units))
        (define cum-allies
          (for/list ([u (in-list ally-units)]
                     #:when (and (hash? u)
                                 (not (set-member? wave3-handled-tags (hash-ref u 'id -1)))))
            u))
        (define cum-burrow-res? (not (not (memq 'burrow researched-upgs))))
        (define cum-blink-res? (stalker-blink-researched? researched-upgs))
        (define cum-blink-ht (spell-claims-stalker-blink-ready-frame spell-claims-rt))
        (define cum-blink-tags
          (if cum-blink-res?
              (for/list ([u (in-list cum-allies)]
                         #:when (and (eq? (unit-type-sym u) 'stalker)
                                     (>= frame (hash-ref cum-blink-ht (hash-ref u 'id -1) -1))))
                (hash-ref u 'id))
              '()))
        (for ([cud (in-list (plan-counter-unit-mode-micro
                             cum-allies enemy-units
                             #:home-x (exact->inexact base-x)
                             #:home-y (exact->inexact base-y)
                             #:burrow-researched? cum-burrow-res?
                             #:blink-ready-tags cum-blink-tags
                             #:tracker unit-mode-tr
                             #:current-frame frame))])
          (define cuid (unit-mode-directive-unit-tag cud))
          (unless (set-member? wave3-handled-tags cuid)
            (when (eq? (unit-mode-directive-ability cud) 'blink)
              (hash-set! cum-blink-ht cuid (+ frame 157)))
            (set-add! wave3-handled-tags cuid)
            (l34-emit-preserved! ctx (unit-mode-directive->sexp cud))))))

  (set-l34-ctx-bo-contain-active?! ctx bo-contain-active?)
  (set-l34-ctx-bo-fork-active?! ctx bo-fork-active?)
  (set-l34-ctx-bo-micro-dirs! ctx bo-micro-dirs)
  (set-l34-ctx-bo-prepos-active?! ctx bo-prepos-active?)
  (set-l34-ctx-bo-rally-override?! ctx bo-rally-override?)
  (set-l34-ctx-bo-rally-tx! ctx bo-rally-tx)
  (set-l34-ctx-bo-rally-ty! ctx bo-rally-ty)
  (set-l34-ctx-bo-sx! ctx bo-sx)
  (set-l34-ctx-bo-sy! ctx bo-sy)
  (set-l34-ctx-eff-wave-commit?! ctx eff-wave-commit?)
  (set-l34-ctx-engagement-enemies! ctx engagement-enemies)
  (set-l34-ctx-fbo-px! ctx fbo-px)
  (set-l34-ctx-fbo-py! ctx fbo-py)
  (set-l34-ctx-fbo-rally-tx! ctx fbo-rally-tx)
  (set-l34-ctx-fbo-rally-ty! ctx fbo-rally-ty)
  (set-l34-ctx-live-attack-wave-min! ctx live-attack-wave-min)
  (when (not (null? engagement-enemies))
    (when (not live-obs?)
      (define transfusion-queens
        (filter (lambda (u)
                  (and (eq? (unit-type-sym u) 'queen)
                       (not (unit-leased-above? leases (hash-ref u 'id 0) 'creep-queen frame))))
                ally-units))
      (define transfusion-targets
        (filter (lambda (u)
                  (define max-hp (hash-ref u 'max-hp 150))
                  (define cur-hp (hash-ref u 'hp max-hp))
                  (define buffs (hash-ref u 'buffs '()))
                  (define ut (unit-type-sym u))
                  (and (not (zero? (bitwise-and (combat:unit-attribute-mask ut)
                                                combat:SC2-UNIT-ATTR-BIOLOGICAL)))
                       (>= max-hp 120)
                       (not (memq ut '(zergling baneling broodling changeling)))
                       (>= (- max-hp cur-hp) 1)
                       (not (and (list? buffs) (memq 'transfusion buffs)))))
                combat-units))
      (fast-dispatch-macro-energy!
       transfusion-queens
       transfusion-targets
       frame
       (mutable-seteqv)
       #:min-energy SC2-QUEEN-TRANSFUSION-ENERGY
       #:valid-pair? (lambda (q tgt) #t)
       #:score-pair (lambda (q tgt)
                      (- (- (hash-ref tgt 'max-hp 150) (hash-ref tgt 'hp 100))
                         (* 2.0 (dist2d (hash-ref q 'x base-x) (hash-ref q 'y base-y)
                                        (hash-ref tgt 'x base-x) (hash-ref tgt 'y base-y)))))
       #:emit-cast! (lambda (q tgt)
                      (define qid (hash-ref q 'id 120))
                      (set-add! queen-cast-tags qid)
                      (l34-emit! ctx (list 'cast-spell qid 'transfusion (hash-ref tgt 'id 141))))))

    (when live-obs?
      (define marauder-bb-min-x +inf.0)
      (define marauder-bb-max-x -inf.0)
      (define marauder-bb-min-y +inf.0)
      (define marauder-bb-max-y -inf.0)
      (define marauder-allies
        (for/fold ([acc-rev '()] #:result (reverse acc-rev))
                  ([u (in-list combat-units)])
          (if (and (eq? (unit-type-sym u) 'marauder)
                   (let ([uid (hash-ref u 'id -1)])
                     (and (exact-integer? uid)
                          (> uid 0)
                          (not (memq (fast-order-protection-class (hash-ref u 'order-ability-id 0))
                                     '(morph channel cast-walk)))
                          (not (set-member? splash-evading-tags uid))
                          (not (set-member? disruptor-handled-tags uid))
                          (not (set-member? wave3-handled-tags uid))
                          (let* ([ux-raw (hash-ref u 'x base-x)]
                                 [uy-raw (hash-ref u 'y base-y)]
                                 [fx (exact->inexact ux-raw)]
                                 [fy (exact->inexact uy-raw)])
                            (and (not (and siege-line-hold?
                                           (ormap (lambda (st)
                                                    (define dx (fl- fx (exact->inexact (hash-ref st 'x 9999.0))))
                                                    (define dy (fl- fy (exact->inexact (hash-ref st 'y 9999.0))))
                                                    (fl<= (fl+ (fl* dx dx) (fl* dy dy)) 240.25))
                                                  enemy-sieged-tanks-near)))
                                 (let* ([mx (let ([rx (hash-ref u 'x SANITIZE-MISSING)])
                                              (if (and (real? rx) (not (nan? rx))) (exact->inexact rx) 32.5))]
                                        [my (let ([ry (hash-ref u 'y SANITIZE-MISSING)])
                                              (if (and (real? ry) (not (nan? ry))) (exact->inexact ry) 32.5))])
                                   (when (fl< mx marauder-bb-min-x) (set! marauder-bb-min-x mx))
                                   (when (fl> mx marauder-bb-max-x) (set! marauder-bb-max-x mx))
                                   (when (fl< my marauder-bb-min-y) (set! marauder-bb-min-y my))
                                   (when (fl> marauder-bb-max-y) (set! marauder-bb-max-y my))
                                   #t))))))
              (let* ([uid (hash-ref u 'id -1)]
                     [mx (let ([rx (hash-ref u 'x SANITIZE-MISSING)])
                           (if (and (real? rx) (not (nan? rx))) (exact->inexact rx) 32.5))]
                     [my (let ([ry (hash-ref u 'y SANITIZE-MISSING)])
                           (if (and (real? ry) (not (nan? ry))) (exact->inexact ry) 32.5))])
                (cons (mode-unit-input uid 'marauder mx my 125.0 125.0 0.0 0.0 #f #f #f) acc-rev))
              acc-rev)))
      (when (not (null? marauder-allies))
        (define bb-pad (fl+ MARAUDER-ACQUIRE-MAX-RANGE 0.5))
        (define bb-lo-x (fl- marauder-bb-min-x bb-pad))
        (define bb-hi-x (fl+ marauder-bb-max-x bb-pad))
        (define bb-lo-y (fl- marauder-bb-min-y bb-pad))
        (define bb-hi-y (fl+ marauder-bb-max-y bb-pad))
        ;; Pre-prune to bounding box and convert clean enemy hashes to typed `mode-unit-input` structs
        ;; to avoid Typed/Untyped hash boundary checks inside `unit-mode-micro.rkt`.
        (define marauder-enemies
          (for/fold ([acc-rev '()] #:result (reverse acc-rev))
                    ([e (in-list enemy-units)])
            (if (not (hash? e))
                (cons e acc-rev)
                (let ([ex-raw (hash-ref e 'x SANITIZE-MISSING)]
                      [ey-raw (hash-ref e 'y SANITIZE-MISSING)])
                  (define fx (if (and (real? ex-raw) (not (nan? ex-raw))) (exact->inexact ex-raw) 32.5))
                  (define fy (if (and (real? ey-raw) (not (nan? ey-raw))) (exact->inexact ey-raw) 32.5))
                  (cond
                    [(or (fl< fx bb-lo-x) (fl> fx bb-hi-x) (fl< fy bb-lo-y) (fl> fy bb-hi-y))
                     acc-rev]
                    [(or (eq? (hash-ref e 'flying #f) #t)
                         (eq? (hash-ref e 'flying? #f) #t)
                         (eq? (hash-ref e 'is-flying #f) #t)
                         (eq? (hash-ref e 'is_flying #f) #t))
                     acc-rev]
                    [else
                     (define eid (hash-ref e 'id SANITIZE-MISSING))
                     (define esym (hash-ref e 'type SANITIZE-MISSING))
                     (define hp-raw (hash-ref e 'hp SANITIZE-MISSING))
                     (define sh-raw (hash-ref e 'shield SANITIZE-MISSING))
                     (cond
                       [(and (exact-integer? eid)
                             (> eid 0)
                             (symbol? esym)
                             (not (eq? esym 'unknown))
                             (real? hp-raw)
                             (not (nan? hp-raw))
                             (or (eq? sh-raw SANITIZE-MISSING) (and (real? sh-raw) (not (nan? sh-raw))))
                             (not (or (hash-has-key? e 'hull-hp)
                                      (hash-has-key? e 'health)
                                      (hash-has-key? e 'shields)
                                      (hash-has-key? e 'alive?)
                                      (hash-has-key? e 'alive)
                                      (hash-has-key? e 'is-alive)
                                      (hash-has-key? e 'is-dead?)
                                      (hash-has-key? e 'dead?)
                                      (hash-has-key? e 'is-building)
                                      (hash-has-key? e 'building?)
                                      (hash-has-key? e 'is-structure))))
                        (cond
                          [(and (not (eq? esym 'viking-assault))
                                (sc2-unit-is-flying-sym? esym))
                           acc-rev]
                          [(memq esym '(larva egg)) acc-rev]
                          [else
                           (define hp-fl (flmax 0.0 (if (flonum? hp-raw) hp-raw (exact->inexact hp-raw))))
                           (define sh-fl
                             (flmax 0.0
                                    (if (eq? sh-raw SANITIZE-MISSING)
                                        (let ([st (sc2-unit-combat-stats esym)])
                                          (exact->inexact (hash-ref st 'max-shield 0.0)))
                                        (if (flonum? sh-raw) sh-raw (exact->inexact sh-raw)))))
                           (if (fl> (fl+ hp-fl sh-fl) 0.0)
                               (cons (mode-unit-input eid esym fx fy hp-fl 100.0 sh-fl 0.0 #f #f #f)
                                     acc-rev)
                               acc-rev)])]
                       [else (cons e acc-rev)])])))))
        (define concussive-ok? (l34-has-upgrade? ctx 'concussive-shells))
        (define marauder-orders
          (plan-marauder-concussive-targets marauder-allies marauder-enemies
                                            #:tracker unit-mode-tr
                                            #:current-frame frame
                                            #:concussive-shells-researched? concussive-ok?))
        (for ([mo (in-list marauder-orders)])
          (set-add! wave3-marauder-target-tags (marauder-target-order-unit-tag mo))
          (l34-emit-preserved! ctx (marauder-order->sexp mo)))))

  )

  ;; Combat SCV 'mechanical wave repair (covers Tank/Thor/Hellion/Cyclone waves even when any-pro-caster? is #f)
  ;; L40-P0-1b (`#5140013` / `r05` 15-Probe all-in `3685` leak fix): Gate SCV-on-SCV repair
  ;; out whenever `>= 6` enemy workers rush our base (and skip the whole loop under a pure
  ;; `>= 10`-worker all-in with 0 enemy combat units!) so all 16 SCVs stay in `23` focus-fire!
  (when (and has-ally-scv?
             (not skipped-wave-mech-repair?)
             (let ([m (hash-ref obs 'minerals 50)])
               (and (real? m) (>= m 5))))
    (define-values (near-enemy-worker-cnt-r near-enemy-nonworker-combat-cnt-r)
      (for/fold ([wcnt 0] [ccnt 0]) ([e (in-list enemy-units)] #:when (hash? e))
        (define ex (hash-ref e 'x #f))
        (define ey (hash-ref e 'y #f))
        (if (and (real? ex) (real? ey)
                 (let ([dx (- (exact->inexact ex) (exact->inexact base-x))]
                       [dy (- (exact->inexact ey) (exact->inexact base-y))])
                   (<= (+ (* dx dx) (* dy dy)) 576.0)))
            (if (memq (unit-type-sym e) '(probe scv drone))
                (values (add1 wcnt) ccnt)
                (if (combat-unit-record? e)
                    (values wcnt (add1 ccnt))
                    (values wcnt ccnt)))
            (values wcnt ccnt))))
    ;; L41-P0-1b + L48-W2 (`r02`/`r05`/`r15` Pure Worker-Rush Latch): Share & maintain the pure
    ;; worker all-in latch with L2 (`>= 10` triggers, stays latched until `< 3` pure enemy workers
    ;; remain or non-worker combat enters) AND widen check radius to `24t` (`576.0`) so kiting Probes
    ;; in `r15` never leak `3685` SCV repair!
    (define rush-def-st-r (rt-rush-defense-state (l34-ctx-rt ctx)))
    (define prev-heavy-allin-r?
      (eq? (hash-ref rush-def-st-r 'heavy-pure-worker-allin-latched? #f) #t))
    (define heavy-pure-worker-allin-l34?
      (and (= near-enemy-nonworker-combat-cnt-r 0)
           (or (>= near-enemy-worker-cnt-r 10)
               (and prev-heavy-allin-r?
                    (>= near-enemy-worker-cnt-r 3)))))
    (define pure-worker-rush-l34?
      (and (= near-enemy-nonworker-combat-cnt-r 0)
           (or heavy-pure-worker-allin-l34?
               (>= near-enemy-worker-cnt-r 6)
               (and (hash? rush-def-st-r)
                    (or (< frame (hash-ref rush-def-st-r 'kiting-rush-until -1))
                        (< frame (hash-ref rush-def-st-r 'worker-rush-active-until -1)))))))
    (when (and (>= near-enemy-worker-cnt-r 10) (= near-enemy-nonworker-combat-cnt-r 0))
      (hash-set! rush-def-st-r 'heavy-pure-worker-allin-latched? #t))
    (when (and prev-heavy-allin-r?
               (or (< near-enemy-worker-cnt-r 3)
                   (> near-enemy-nonworker-combat-cnt-r 0)))
      (hash-set! rush-def-st-r 'heavy-pure-worker-allin-latched? #f))
    (define skip-scv-on-scv-repair-l34?
      (or pure-worker-rush-l34?
          (>= near-enemy-worker-cnt-r 6)
          (and (= near-enemy-nonworker-combat-cnt-r 0)
               (>= near-enemy-worker-cnt-r 3))))
    (define has-damaged-fortification? #f)
    (define damaged-mech
      (if heavy-pure-worker-allin-l34?
          '()
          (let ([rev '()])
            (for ([u (in-list combat-units)]
                  #:when (hash? u))
              (define ut (unit-type-sym u))
              (unless (or (and skip-scv-on-scv-repair-l34? (eq? ut 'scv))
                          (and pure-worker-rush-l34?
                               (memq (fast-canonical-structure-sym ut)
                                     '(command-center orbital-command barracks supply-depot
                                       supply-depot-lowered refinery engineering-bay factory starport)))
                          (zero? (bitwise-and (combat:unit-attribute-mask ut)
                                              combat:SC2-UNIT-ATTR-MECHANICAL)))
                (define uid (hash-ref u 'id -1))
                (when (and (exact-integer? uid)
                           (> uid 0)
                           (not (hash-ref u 'hallucination? #f)))
                  (define max-hp (exact->inexact (fast-finite-real (or (hash-ref u 'max-hp #f) (hash-ref u 'health-max #f) 100.0) 100.0)))
                  (define cur-hp (exact->inexact (fast-finite-real (or (hash-ref u 'hp #f) (hash-ref u 'health #f) max-hp) max-hp)))
                  (when (and (> max-hp 0.0)
                             (< cur-hp (- max-hp 0.5))
                             (< cur-hp (* 0.90 max-hp))
                             (>= (- max-hp cur-hp) 5.0))
                    (define tx (exact->inexact (fast-finite-real (hash-ref u 'x base-x) base-x)))
                    (define ty (exact->inexact (fast-finite-real (hash-ref u 'y base-y) base-y)))
                    (set! rev (cons (vector uid ut (- 1.0 (/ cur-hp max-hp)) tx ty) rev))))))
            ;; L58-P1 (`sc2-ab-t11`, `sc2-ab-t12`): Include actively damaged mechanical fortifications
            ;; (`planetary-fortress`, `bunker`, `missile-turret`) from `ally-bldgs` with strict
            ;; `hp < max-hp - 0.5` & missing `>= 5.0` so SCVs actively repair them instead of abandoning them!
            (for ([b (in-list ally-bldgs)]
                  #:when (hash? b))
              (define bt (fast-canonical-structure-sym (unit-type-sym b)))
              (when (and (memq bt '(planetary-fortress bunker missile-turret))
                         (>= (hash-ref b 'build-progress 1.0) SC2-BUILD-COMPLETE-PROGRESS)
                         (not (hash-ref b 'hallucination? #f)))
                (define bid (hash-ref b 'id -1))
                (when (and (exact-integer? bid) (> bid 0))
                  (define max-hp (exact->inexact (fast-finite-real (or (hash-ref b 'max-hp #f) (hash-ref b 'health-max #f) 400.0) 400.0)))
                  (define cur-hp (exact->inexact (fast-finite-real (or (hash-ref b 'hp #f) (hash-ref b 'health #f) max-hp) max-hp)))
                  (when (and (> max-hp 0.0)
                             (< cur-hp (- max-hp 0.5))
                             (< cur-hp (* 0.98 max-hp))
                             (>= (- max-hp cur-hp) 5.0))
                    (set! has-damaged-fortification? #t)
                    (define tx (exact->inexact (fast-finite-real (hash-ref b 'x base-x) base-x)))
                    (define ty (exact->inexact (fast-finite-real (hash-ref b 'y base-y) base-y)))
                    (set! rev (cons (vector bid bt (- 1.0 (/ cur-hp max-hp)) tx ty) rev))))))
            (reverse rev))))
    (when (pair? damaged-mech)
      (define engaged? (or (not live-obs?) (not (null? engagement-enemies))))
      ;; Single ally-units pass: seed active SCV repair claims and collect candidate wave SCVs only when damaged mech targets exist.
      (define claims scv-repair-claims)
      (define free-scvs
        (let ([rev '()]
              [fbase-x (if (flonum? base-x) base-x (exact->inexact base-x))]
              [fbase-y (if (flonum? base-y) base-y (exact->inexact base-y))])
          (for ([s (in-list (or cached-scv-units ally-units))]
                #:when (and (hash? s) (or cached-scv-units (eq? (unit-type-sym s) 'scv))))
            (define ab (hash-ref s 'order-ability-id 0))
            (define ott (hash-ref s 'order-target-tag 0))
            (define already-repairing?
              (or (eq? (hash-ref s 'repairing? #f) #t)
                  (and (exact-integer? ab) (or (= ab 3685) (= ab 316)))))
            (when (and (exact-integer? ott) (> ott 0) already-repairing?)
              (unless claims (set! claims (make-hasheqv)))
              (hash-update! claims ott add1 0))
            (define sid (hash-ref s 'id -1))
            (define scv-blocked-for-repair?
              (if has-damaged-fortification?
                  ;; When a PF/Bunker/Turret is actively damaged, allow mining/idle/fighting SCVs
                  ;; (excluding only builders, scouts, or SCVs already repairing!) to pull & repair!
                  (or already-repairing?
                      (worker-has-engine-build-order? s)
                      (and oledger (order-ledger-unit-has-active-build? oledger sid s))
                      (eq? (hash-ref s 'constructing? #f) #t)
                      (unit-leased-above? leases sid 'army frame)
                      (eq? (fast-order-protection-class ab) 'build-structure))
                  (if cached-scv-busy-ht
                      (hash-ref cached-scv-busy-ht sid #f)
                      (scv-busy-econ-or-leased? s sid leases oledger frame))))
            (when (and (exact-integer? sid)
                       (> sid 0)
                       (not (set-member? splash-evading-tags sid))
                       (not (set-member? disruptor-handled-tags sid))
                       (not (set-member? wave3-handled-tags sid))
                       (not (set-member? snipe-locked-tags sid))
                       (not scv-blocked-for-repair?))
              (define rx (hash-ref s 'x base-x))
              (define ry (hash-ref s 'y base-y))
              (define sx (exact->inexact (fast-finite-real rx base-x)))
              (define sy (exact->inexact (fast-finite-real ry base-y)))
              (define dx-b (fl- sx fbase-x))
              (define dy-b (fl- sy fbase-y))
              (when (or engaged?
                        has-damaged-fortification?
                        (fl> (fl+ (fl* dx-b dx-b) (fl* dy-b dy-b)) 100.0)
                        (let ([ex (and (hash? leases) (hash-ref leases sid #f))])
                          (and (unit-role-lease? ex)
                               (eq? (unit-role-lease-role ex) 'army)
                               (> (unit-role-lease-expires-frame ex) frame)))
                        (and (exact-integer? ab) (or (= ab 16) (= ab 23) (= ab 17))))
                (set! rev (cons (vector s sid sx sy) rev)))))
          (reverse rev)))
      (when (pair? free-scvs)
        (unless claims (set! claims (make-hasheqv)))
        (for ([svec (in-list free-scvs)])
          (define s (vector-ref svec 0))
          (define sid (vector-ref svec 1))
          (define sx (vector-ref svec 2))
          (define sy (vector-ref svec 3))
          (define-values (best-tid best-sc)
            (for/fold ([bt #f] [bs -1e9])
                      ([tvec (in-list damaged-mech)])
              (define tid (vector-ref tvec 0))
              (define tut (vector-ref tvec 1))
              (define max-scvs
                (case tut
                  [(planetary-fortress) 6]
                  [(bunker) 4]
                  [(missile-turret battlecruiser thor thor-ap siege-tank siege-tank-sieged) 3]
                  [else 2]))
              (define max-r2
                (if (memq tut '(planetary-fortress bunker missile-turret)) 196.0 81.0))
              (if (>= (hash-ref claims tid 0) max-scvs)
                  (values bt bs)
                  (let ([dx (fl- sx (vector-ref tvec 3))]
                        [dy (fl- sy (vector-ref tvec 4))])
                    (define d2 (fl+ (fl* dx dx) (fl* dy dy)))
                    (if (fl<= d2 max-r2)
                        (let ([sc (+ (scv-wave-mech-repair-prio tut)
                                     (* 40.0 (vector-ref tvec 2))
                                     (* -2.0 (flsqrt d2)))])
                          (if (> sc bs)
                              (values tid sc)
                              (values bt bs)))
                        (values bt bs))))))
          (when best-tid
            (set-add! wave3-handled-tags sid)
            (hash-update! claims best-tid add1 0)
            (unless (and oledger (order-ledger-order-equivalent? oledger s 'repair best-tid 0.0 0.0 frame))
              (when oledger
                (order-ledger-record-issued! oledger sid 'repair 'repair #:target-id best-tid #:frame frame))
              (l34-emit-preserved! ctx (list 'repair sid best-tid))))))))
)

;; W6-P0-1a: Persistent endgame building-hunt sweep. Evaluates hunt eligibility on EVERY frame
;; (latching `'endgame-hunt-active?` in `l34-sc` across the entire 44-loop refractory window so
;; Phase 5b regroup/rally, Phase 6 `execute-spatial-maneuver`/harass, and Phase 7 direct tactics
;; never overwrite hunting squads mid-flight), plus Terran Orbital `Scanner Sweep` on oldest
;; unvisited expansion/corner waypoints (64-loop cadence, energy >= 50).
(define (l34-run-endgame-building-hunt! ctx)
  (let* ([sweep-rt (l34-ctx-rt ctx)]
         [sweep-obs (l34-ctx-obs ctx)]
         [sweep-frame (l34-ctx-frame ctx)]
         [sweep-st (rt-endgame-sweep-state sweep-rt)]
         [sweep-posture (live-bot-runtime-posture sweep-rt)]
         [sweep-eb (l34-ctx-enemy-bldgs ctx)]
         [sweep-ex (exact->inexact (l34-ctx-enemy-x ctx))]
         [sweep-ey (exact->inexact (l34-ctx-enemy-y ctx))]
         [sweep-eexp-x (exact->inexact (l34-ctx-enemy-exp-x ctx))]
         [sweep-eexp-y (exact->inexact (l34-ctx-enemy-exp-y ctx))]
         ;; W2-P0-2a: Exclude non-win-condition creep tumors from enemy base presence checks
         [win-condition-enemy-bldg?
          (lambda (eb)
            (and (hash? eb)
                 (not (memq (unit-type-sym eb)
                            '(creep-tumor creep-tumor-burrowed creep-tumor-queen)))))]
         [harmless-sweep-base?
          (lambda (e)
            (and (hash? e)
                 (memq (unit-type-sym e)
                       '(creep-tumor creep-tumor-burrowed creep-tumor-queen
                         overlord overlord-cocoon overlord-transport overlord-transport-cocoon
                         overseer overseer-siege-mode larva egg
                         changeling changeling-zealot changeling-zergling
                         changeling-zergling-wings changeling-marine
                         changeling-marine-shield))))]
         [sweep-raw-worker-cnt
          (count (lambda (e) (and (hash? e) (memq (unit-type-sym e) '(drone probe scv))))
                 (l34-ctx-engagement-enemies ctx))]
         [harmless-sweep-entity?
          (lambda (e)
            (or (harmless-sweep-base? e)
                ;; W12-P0-1-rt (`#04` / `#325`): Undetected `cloak=1` entities (e.g. burrowed
                ;; Creep Tumors or lone undetected cloaked strays) must never cancel endgame
                ;; building sweeps or bait untargetable unit-target attacks.
                (and (hash? e)
                     (or (eqv? (hash-ref e 'cloak 0) 1)
                         (eq? (hash-ref e 'cloak #f) 'cloaked)))
                (and (<= sweep-raw-worker-cnt 3)
                     (hash? e)
                     (memq (unit-type-sym e) '(drone probe scv)))))]
         [bldg-at-enemy-main?
          (ormap (lambda (eb)
                   (and (win-condition-enemy-bldg? eb)
                        (<= (fast-dist2d (exact->inexact (hash-ref eb 'x -9999.0))
                                         (exact->inexact (hash-ref eb 'y -9999.0))
                                         sweep-ex sweep-ey)
                            22.0)))
                 sweep-eb)]
         [ally-at-enemy-main?
          (ormap (lambda (u)
                   (and (hash? u)
                        (<= (fast-dist2d (exact->inexact (hash-ref u 'x -9999.0))
                                         (exact->inexact (hash-ref u 'y -9999.0))
                                         sweep-ex sweep-ey)
                            14.0)))
                 (l34-ctx-ally-units ctx))])
    (when (<= sweep-frame 4)
      (hash-clear! sweep-st))
    (define sweep-supply-used (safe-nonneg-int (hash-ref sweep-obs 'supply-used 0) 0))
    (define sweep-combat-sup
      (max (l34-ctx-live-combat-supply ctx)
           (exact->inexact (safe-nonneg-int (hash-ref sweep-obs 'army-supply (hash-ref sweep-obs 'food-army 0)) 0))))
    (define owm-sweep
      (and sweep-rt
           (or (l34-ctx-live-obs? ctx)
               (eq? (hash-ref sweep-obs 'enable-opponent-world-model #f) #t))
           (opponent-world-model-last-summary (rt-opponent-world-model sweep-rt))))
    (define owm-bel-sup
      (if owm-sweep (opponent-world-summary-believed-total-army-supply owm-sweep) 0))
    (define owm-locust-now?
      (and owm-sweep (opponent-world-summary-locust-wave-active? owm-sweep)))
    (define (sweep-snapshot-entity? e)
      (and (hash? e)
           (or (eq? (hash-ref e 'snapshot? #f) #t)
               (not (eqv? (hash-ref e 'display-type 1) 1)))))
    (define sweep-raw-enemies (l34-ctx-engagement-enemies ctx))
    (define sweep-visible-enemies
      (filter (lambda (e) (not (sweep-snapshot-entity? e))) sweep-raw-enemies))
    (define sweep-active-enemies
      (filter (lambda (e) (and (not (harmless-sweep-entity? e))
                               (not (sweep-snapshot-entity? e))))
              sweep-raw-enemies))
    (define known-win-bldgs
      (filter (lambda (eb)
                (and (win-condition-enemy-bldg? eb)
                     (real? (hash-ref eb 'x #f))
                     (real? (hash-ref eb 'y #f))))
              sweep-eb))
    (define mass-staging-blocked?
      (and (hash? (l34-ctx-l34-sc ctx))
           (hash-ref (l34-ctx-l34-sc ctx) 'l20-mass-staging-active? #f)))
    (define army-dominates-pre?
      (or (>= sweep-supply-used 165)
          (and (>= sweep-combat-sup 40) (<= owm-bel-sup 0))
          (and (>= sweep-combat-sup 60)
               (>= sweep-combat-sup (* 1.35 owm-bel-sup)))
          (and (memq sweep-posture '(SwarmVictory ProtossArmadaVictory MothmanApexVictory))
               (>= sweep-combat-sup 40))
          (and (eq? sweep-posture 'attack)
               (not mass-staging-blocked?)
               (>= sweep-combat-sup 40))
          (and (hash-ref sweep-st 'enemy-main-cleared? #f) (>= sweep-combat-sup 40))))
    (cond
      [bldg-at-enemy-main?
       (hash-set! sweep-st 'enemy-main-cleared? #f)]
      [(or (hash-ref sweep-obs 'enemy-main-cleared #f)
           (and (null? sweep-active-enemies)
                ally-at-enemy-main?))
       (hash-set! sweep-st 'enemy-main-cleared? #t)])
    (define enemy-main-cleared?
      (and (not bldg-at-enemy-main?)
           (not (not (hash-ref sweep-st 'enemy-main-cleared? #f)))))
    (define army-dominates?
      (or army-dominates-pre?
          (and enemy-main-cleared? (>= sweep-combat-sup 40))))
    (define hunt-posture-ok?
      (or (memq sweep-posture '(attack SwarmVictory ProtossArmadaVictory MothmanApexVictory))
          army-dominates?))
    (define hunt-suppress-ok?
      (or army-dominates?
          enemy-main-cleared?
          (not (l34-ctx-combat-suppress-attack? ctx))))
    ;; W5-P0-1c-rt: When our maxed/dominant army (`army-dominates?`) is sweeping the last enemy
    ;; buildings, never let a tiny home harasser (<=6 combat supply) freeze the entire sweep!
    (define home-threat-blocks-hunt?
      (and (l34-ctx-under-tactics-base-attack? ctx)
           (or (not army-dominates?)
               (let ([bx (exact->inexact (l34-ctx-base-x ctx))]
                     [by (exact->inexact (l34-ctx-base-y ctx))]
                     [nx (exact->inexact (l34-ctx-nat-x ctx))]
                     [ny (exact->inexact (l34-ctx-nat-y ctx))])
                 (> (for/fold ([sup 0.0]) ([e (in-list sweep-active-enemies)])
                      (define ex (exact->inexact (safe-finite-real (hash-ref e 'x 9999.0) 9999.0)))
                      (define ey (exact->inexact (safe-finite-real (hash-ref e 'y 9999.0) 9999.0)))
                      (define d1 (fl+ (fl* (fl- bx ex) (fl- bx ex)) (fl* (fl- by ey) (fl- by ey))))
                      (define d2 (fl+ (fl* (fl- nx ex) (fl- nx ex)) (fl* (fl- ny ey) (fl- ny ey))))
                      (if (or (fl<= d1 676.0) (fl<= d2 676.0))
                          (fl+ sup (flmax 0.5 (exact->inexact (sc2-supply-cost (fast-canonical-unit-sym (unit-type-sym e)) 1))))
                          sup))
                    6.0)))))
    ;; W7-P0-2-rt / W12-P0-1-rt (`#02`/`#04`): When `army-dominates?`, do NOT cancel
    ;; `endgame-hunt-active?` for distant (`> 45t`) units OR tiny strays (`<= 6` combat supply
    ;; with no win-condition building within `24t`) — our cohesive `attack-pos` squads clear
    ;; strays en route without ever stalling the sweep!
    (define sweep-near-active-enemies
      (if (not army-dominates?)
          sweep-active-enemies
          (let* ([acx (exact->inexact (l34-ctx-prelim-army-cx ctx))]
                 [acy (exact->inexact (l34-ctx-prelim-army-cy ctx))]
                 [bx (exact->inexact (l34-ctx-base-x ctx))]
                 [by (exact->inexact (l34-ctx-base-y ctx))]
                 [nx (exact->inexact (l34-ctx-nat-x ctx))]
                 [ny (exact->inexact (l34-ctx-nat-y ctx))]
                 [near-es
                  (filter (lambda (e)
                            (define ex (exact->inexact (safe-finite-real (hash-ref e 'x 9999.0) 9999.0)))
                            (define ey (exact->inexact (safe-finite-real (hash-ref e 'y 9999.0) 9999.0)))
                            (or (<= (fast-dist2d acx acy ex ey) 45.0)
                                (<= (fast-dist2d bx by ex ey) 26.0)
                                (<= (fast-dist2d nx ny ex ey) 26.0)))
                          sweep-active-enemies)]
                 [near-win-bldg?
                  (for/or ([eb (in-list known-win-bldgs)])
                    (<= (fast-dist2d acx acy
                                     (exact->inexact (safe-finite-real (hash-ref eb 'x 9999.0) 9999.0))
                                     (exact->inexact (safe-finite-real (hash-ref eb 'y 9999.0) 9999.0)))
                        24.0))]
                 [near-sup
                  (for/fold ([sup 0.0]) ([e (in-list near-es)])
                    (fl+ sup (flmax 0.5 (exact->inexact (sc2-supply-cost (fast-canonical-unit-sym (unit-type-sym e)) 1)))))])
            (if (and (pair? near-es)
                     (not near-win-bldg?)
                     (fl<= near-sup 6.0))
                '()
                near-es))))
    ;; L44-P0-1c + L45-P0-1a (`#53 zig-reapers` Counter-Wave Split vs Terran `TvP`/`#02 TvT` guard):
    ;; ONLY yield `endgame-hunt-active?` and split `30/70` against `<= 6` light mobile home harassers
    ;; when in an explicit offensive/victory posture (`attack` / `*Victory`) AND our combat supply
    ;; decisively dominates known enemy combat supply (`>= 1.65 * (max 20.0 enemy-known-combat-sup)`).
    ;; Parity/outnumbered armies in `'macro`/`'defend`/`'OneRaxFE` NEVER unsiege Tanks or split blindly!
    (define sweep-vis-enemy-combat-sup
      (for/fold ([sup 0.0]) ([e (in-list sweep-active-enemies)])
        (if (and (hash? e)
                 (combat-unit-record? e)
                 (not (eq? (hash-ref e 'hallucination #f) #t))
                 (not (memq (fast-canonical-unit-sym (unit-type-sym e))
                            '(scv probe drone mule overlord overlord-cocoon overlord-transport
                              overseer overseer-siege-mode observer larva egg))))
            (fl+ sup (flmax 0.5 (exact->inexact (sc2-supply-cost (fast-canonical-unit-sym (unit-type-sym e)) 1))))
            sup)))
    (define sweep-enemy-known-combat-sup
      (flmax sweep-vis-enemy-combat-sup (exact->inexact owm-bel-sup)))
    (define light-home-harass-split-yield?
      (and (l34-ctx-live-obs? ctx)
           (memq sweep-posture '(attack SwarmVictory ProtossArmadaVictory MothmanApexVictory))
           (>= sweep-combat-sup 50.0)
           (>= sweep-combat-sup (fl* 1.65 (flmax 20.0 sweep-enemy-known-combat-sup)))
           (>= (length (l34-ctx-combat-units ctx)) 10)
           (not enemy-main-cleared?)
           (let* ([bx0 (exact->inexact (l34-ctx-base-x ctx))]
                  [by0 (exact->inexact (l34-ctx-base-y ctx))]
                  [nx0 (exact->inexact (l34-ctx-nat-x ctx))]
                  [ny0 (exact->inexact (l34-ctx-nat-y ctx))]
                  [home-es
                   (for/list ([e (in-list sweep-active-enemies)]
                              #:when (and (hash? e)
                                          (combat-unit-record? e)
                                          (real? (hash-ref e 'x #f)) (real? (hash-ref e 'y #f))
                                          (let ([ex0 (exact->inexact (hash-ref e 'x 9999.0))]
                                                [ey0 (exact->inexact (hash-ref e 'y 9999.0))])
                                            (or (fl<= (fast-dist2d ex0 ey0 bx0 by0) 28.0)
                                                (fl<= (fast-dist2d ex0 ey0 nx0 ny0) 28.0)))))
                     e)])
             (and (pair? home-es)
                  (<= (length home-es) 6)
                  (andmap (lambda (e)
                            (memq (fast-canonical-unit-sym (unit-type-sym e))
                                  '(reaper zergling adept hellion banshee oracle phoenix mutalisk dark-templar)))
                          home-es)))))
    (define endgame-hunt-active?
      (and hunt-posture-ok?
           (>= sweep-combat-sup 40)
           hunt-suppress-ok?
           (not owm-locust-now?)
           (not home-threat-blocks-hunt?)
           (not light-home-harass-split-yield?)
           (null? (if army-dominates? sweep-near-active-enemies sweep-visible-enemies))
           (pair? (l34-ctx-combat-units ctx))))
    (hash-set! (l34-ctx-l34-sc ctx) 'endgame-hunt-active? endgame-hunt-active?)
    (when endgame-hunt-active?
      ;; W12-P0-1-rt (`#02` T v titania 11.83x): Claim ALL `sweep-units` into `wave3-handled-tags`
      ;; on ALL 44/44 frames while `endgame-hunt-active?` is `#t` (not just the 1 emit frame!) so
      ;; downstream `l34-phase6`/`l34-phase7` can never overwrite sweeping squads back to rally!
      (define w3-tags (l34-ctx-wave3-handled-tags ctx))
      (define sp-tags (l34-ctx-splash-evading-tags ctx))
      (define di-tags (l34-ctx-disruptor-handled-tags ctx))
      (define sweep-units
        (for/list ([u (in-list (l34-ctx-combat-units ctx))]
                   #:when (let ([uid (hash-ref u 'id -1)]
                                [ut (unit-type-sym u)])
                            (and (> uid 0)
                                 (not (memq ut '(overlord overseer observer warp-prism warp-prism-phasing medivac queen scv probe drone)))
                                 (not (set-member? w3-tags uid))
                                 (not (set-member? sp-tags uid))
                                 (not (set-member? di-tags uid)))))
          u))
      (for ([u (in-list sweep-units)])
        (define uid (hash-ref u 'id -1))
        (when (> uid 0)
          (set-add! w3-tags uid)))
      (define emit-hunt-orders?
        (or (not (l34-ctx-live-obs? ctx))
            (refractory-allow-action?! (live-bot-runtime-cooldown-tracker sweep-rt)
                                       '(endgame-building-hunt)
                                       sweep-frame
                                       44)))
      (define want-terran-hunt-scan?
        (and (eq? (live-bot-runtime-actual-race sweep-rt) 'Terran)
             enemy-main-cleared?
             (null? known-win-bldgs)
             (or (not (l34-ctx-live-obs? ctx))
                 (refractory-ready? (live-bot-runtime-cooldown-tracker sweep-rt)
                                    '(endgame-hunt-scan)
                                    sweep-frame
                                    64))))
      (when (or emit-hunt-orders? want-terran-hunt-scan?)
        (define sweep-bx (exact->inexact (l34-ctx-base-x ctx)))
        (define sweep-by (exact->inexact (l34-ctx-base-y ctx)))
        (define map-w (max 64.0 (safe-finite-real (hash-ref sweep-obs 'map-width 200.0) 200.0)))
        (define map-h (max 64.0 (safe-finite-real (hash-ref sweep-obs 'map-height 200.0) 200.0)))
        ;; W16-P1-2-rt (`#5135717` lifted-building / 1-SCV corner stall): Sweep extreme
        ;; map corners (`12.0` rim) AND upgrade fallback grid from `4x4` `[24..w-24]` to
        ;; `6x6` `[12..w-12]` so lifted Terran buildings tucked in corners/edges are always spotted!
        (define c-lo 12.0)
        (define c-hi-x (max 40.0 (- map-w 12.0)))
        (define c-hi-y (max 40.0 (- map-h 12.0)))
        (define corner-wps
          (list (cons c-lo c-lo) (cons c-hi-x c-lo)
                (cons c-lo c-hi-y) (cons c-hi-x c-hi-y)))
        ;; W12-P0-1-rt: Cluster ALL neutral mineral patches & geysers (`12t` dedup) alongside
        ;; `expansion-candidates` so hidden bases like `(84,145)` / `(88,144)` are ALWAYS swept!
        (define mineral-cluster-wps
          (let ([mps (let ([v (hash-ref sweep-obs 'mineral-patches '())]) (if (list? v) v '()))]
                [gys (let ([v (hash-ref sweep-obs 'geysers '())]) (if (list? v) v '()))])
            (let loop ([rem (append mps gys)] [clusters '()])
              (cond
                [(null? rem) clusters]
                [else
                 (define m (car rem))
                 (define mx (and (hash? m) (hash-ref m 'x #f)))
                 (define my (and (hash? m) (hash-ref m 'y #f)))
                 (if (and (real? mx) (real? my))
                     (let ([fmx (exact->inexact mx)] [fmy (exact->inexact my)])
                       (if (ormap (lambda (c) (<= (fast-dist2d fmx fmy (car c) (cdr c)) 12.0)) clusters)
                           (loop (cdr rem) clusters)
                           (loop (cdr rem) (cons (cons fmx fmy) clusters))))
                     (loop (cdr rem) clusters))]))))
        (define raw-exp-wps
          (sort
           (append
            (for/list ([ep (in-list (let ([v (hash-ref sweep-obs 'expansion-candidates '())])
                                      (if (list? v) v '())))]
                       #:when (or (hash? ep) (pair? ep)))
              (cond
                [(hash? ep)
                 (cons (exact->inexact (hash-ref ep 'x sweep-ex))
                       (exact->inexact (hash-ref ep 'y sweep-ey)))]
                [(pair? (cdr ep))
                 (cons (exact->inexact (car ep)) (exact->inexact (cadr ep)))]
                [else
                 (cons (exact->inexact (car ep)) (exact->inexact (cdr ep)))]))
            mineral-cluster-wps)
           (lambda (a b)
             (< (fast-dist2d (car a) (cdr a) sweep-ex sweep-ey)
                (fast-dist2d (car b) (cdr b) sweep-ex sweep-ey)))))
        (define grid-wps
          (for*/list ([gx (in-range 6)] [gy (in-range 6)])
            (cons (+ c-lo (* (/ (+ gx 0.5) 6.0) (- c-hi-x c-lo)))
                  (+ c-lo (* (/ (+ gy 0.5) 6.0) (- c-hi-y c-lo))))))
        (define primary-wps
          (let loop ([rem (append (list (cons sweep-ex sweep-ey)
                                        (cons sweep-eexp-x sweep-eexp-y))
                                  raw-exp-wps
                                  corner-wps)]
                     [acc '()])
            (cond
              [(null? rem) (reverse acc)]
              [else
               (define p (car rem))
               (define px (safe-coord (car p) sweep-ex))
               (define py (safe-coord (cdr p) sweep-ey))
               (define dup?
                 (or (<= (fast-dist2d px py sweep-bx sweep-by) 16.0)
                     (ormap (lambda (q) (<= (fast-dist2d px py (car q) (cdr q)) 12.0)) acc)))
               (loop (cdr rem) (if dup? acc (cons (cons px py) acc)))])))
        (define visited-wps (hash-ref! sweep-st 'visited-wps (lambda () (make-hasheqv))))
        (define scanned-wps (hash-ref! sweep-st 'scanned-wps (lambda () (make-hasheqv))))
        (define all-primary-visited?
          (and (pair? primary-wps)
               (for/and ([wi (in-range (length primary-wps))])
                 (or (> (hash-ref visited-wps wi -99999) -99999)
                     (> (hash-ref scanned-wps wi -99999) -99999)))))
        (define all-wps
          (if (not all-primary-visited?)
              primary-wps
              (let loop ([rem grid-wps] [acc (reverse primary-wps)])
                (cond
                  [(null? rem) (reverse acc)]
                  [else
                   (define p (car rem))
                   (define px (safe-coord (car p) sweep-ex))
                   (define py (safe-coord (cdr p) sweep-ey))
                   (define dup?
                     (or (<= (fast-dist2d px py sweep-bx sweep-by) 16.0)
                         (ormap (lambda (q) (<= (fast-dist2d px py (car q) (cdr q)) 12.0)) acc)))
                   (loop (cdr rem) (if dup? acc (cons (cons px py) acc)))]))))
        (define wps (if (pair? all-wps) all-wps corner-wps))
        (define n-wp (length wps))
        (define uid->xy (make-hasheqv))
        (for ([u (in-list sweep-units)])
          (define uid (hash-ref u 'id -1))
          (define ux (exact->inexact (hash-ref u 'x sweep-bx)))
          (define uy (exact->inexact (hash-ref u 'y sweep-by)))
          (hash-set! uid->xy uid (cons ux uy))
          (for ([wp (in-list wps)] [wi (in-naturals)])
            (when (<= (fast-dist2d ux uy (car wp) (cdr wp)) 8.0)
              (hash-set! visited-wps wi sweep-frame))))
        ;; Terran Orbital Scanner Sweep on oldest unvisited expansion/corner pad during hunt
        (when (and want-terran-hunt-scan? (pair? wps))
          (define scan-oc
            (for/first ([b (in-list (l34-ctx-ally-bldgs ctx))]
                        #:when (and (hash? b)
                                    (eq? (unit-type-sym b) 'orbital-command)
                                    (>= (hash-ref b 'build-progress 1.0) 1.0)
                                    (>= (hash-ref b 'energy 0) 50)))
              b))
          (when scan-oc
            (define-values (best-si best-slast)
              (for/fold ([bi #f] [bl 999999999]) ([wi (in-range n-wp)])
                (define last-seen (max (hash-ref visited-wps wi -99999)
                                       (hash-ref scanned-wps wi -99999)))
                (if (and (>= (- sweep-frame last-seen) 448) (< last-seen bl))
                    (values wi last-seen)
                    (values bi bl))))
            (when (and best-si
                       (or (not (l34-ctx-live-obs? ctx))
                           (refractory-allow-action?! (live-bot-runtime-cooldown-tracker sweep-rt)
                                                      '(endgame-hunt-scan)
                                                      sweep-frame
                                                      64)))
              (define swp (list-ref wps best-si))
              (hash-set! scanned-wps best-si sweep-frame)
              (l34-emit-preserved! ctx (list 'cast-spell (hash-ref scan-oc 'id 301) 'scanner-sweep (car swp) (cdr swp))))))
        (when emit-hunt-orders?
          ;; Group into selection-safe (type, spatial-cluster) squads (>6 tiles apart)
          ;; so cortex `ctrl-click` / `box-select` never drops stacked units.
          (define (build-type-spatial-squads units)
            (define by-type (make-hasheq))
            (for ([u (in-list units)])
              (define ut (unit-type-sym u))
              (hash-set! by-type ut (cons u (hash-ref by-type ut '()))))
            (for/fold ([squads '()] #:result (reverse squads))
                      ([(ut us) (in-hash by-type)])
              (define clusters '())
              (for ([u (in-list (reverse us))])
                (define ux (exact->inexact (hash-ref u 'x sweep-bx)))
                (define uy (exact->inexact (hash-ref u 'y sweep-by)))
                (define matched
                  (for/first ([cl (in-list clusters)]
                              #:when (<= (fast-dist2d ux uy (vector-ref cl 0) (vector-ref cl 1)) 6.0))
                    cl))
                (if matched
                    (vector-set! matched 2 (cons (hash-ref u 'id -1) (vector-ref matched 2)))
                    (set! clusters (cons (vector ux uy (list (hash-ref u 'id -1))) clusters))))
              (for/fold ([acc squads]) ([cl (in-list (reverse clusters))])
                (cons (reverse (vector-ref cl 2)) acc))))
          (define-values (fly-units ground-units)
            (for/fold ([f-acc '()] [g-acc '()])
                      ([u (in-list sweep-units)])
              (if (or (eq? (hash-ref u 'flying #f) #t)
                      (eq? (hash-ref u 'is-flying #f) #t)
                      (memq (unit-type-sym u)
                            '(viking viking-fighter phoenix mutalisk banshee liberator liberator-ag
                              void-ray oracle battlecruiser carrier tempest corruptor brood-lord broodlord)))
                  (values (cons u f-acc) g-acc)
                  (values f-acc (cons u g-acc)))))
          (define fly-squads (build-type-spatial-squads (reverse fly-units)))
          (define ground-squads (build-type-spatial-squads (reverse ground-units)))
          (cond
            [(or (pair? known-win-bldgs) (pair? sweep-active-enemies) (not enemy-main-cleared?))
             ;; Phase 1 (W3-P0-1 + W7-P0-2-rt): Known win-condition buildings OR distant visible
             ;; enemy units exist OR enemy main has NOT been visited/cleared yet — march the
             ;; ENTIRE main force cohesively via `l34-emit-preserved!` `attack-pos` (never dropped
             ;; by `cortex-filter-actions!` behind `econ-acts`!).
             (define-values (p1-tx p1-ty)
               (let* ([acx (exact->inexact (l34-ctx-prelim-army-cx ctx))]
                      [acy (exact->inexact (l34-ctx-prelim-army-cy ctx))]
                      [p1-targets (cond [(pair? known-win-bldgs) known-win-bldgs]
                                        [(pair? sweep-active-enemies) sweep-active-enemies]
                                        [else '()])])
                 (if (pair? p1-targets)
                     (let ([nearest-t
                            (argmin (lambda (eb)
                                      (fast-dist2d acx acy
                                                   (exact->inexact (safe-finite-real (hash-ref eb 'x sweep-ex) sweep-ex))
                                                   (exact->inexact (safe-finite-real (hash-ref eb 'y sweep-ey) sweep-ey))))
                                    p1-targets)])
                       (values (safe-coord (hash-ref nearest-t 'x sweep-ex) sweep-ex)
                               (safe-coord (hash-ref nearest-t 'y sweep-ey) sweep-ey)))
                     (values sweep-ex sweep-ey))))
             (for ([sq (in-list fly-squads)])
               (l34-emit-preserved! ctx (list 'attack-pos (if (null? (cdr sq)) (car sq) sq) p1-tx p1-ty)))
             (for ([sq (in-list ground-squads)])
               (l34-emit-preserved! ctx (list 'attack-pos (if (null? (cdr sq)) (car sq) sq) p1-tx p1-ty)))]
            [else
             ;; Phase 2: Enemy main is cleared — persistent per-squad sweep waypoints!
             ;; Each squad holds its waypoint until arrival (`<= 8` tiles), timeout (`>= 672`f = 30s),
             ;; or another squad clears that waypoint.
             (define prev-unit-wp (hash-ref! sweep-st 'unit-wp (lambda () (make-hasheqv))))
             (define next-unit-wp (make-hasheqv))
             (define claimed-counts (make-vector n-wp 0))
             (define (assign-and-emit-squads! squads reverse-dir?)
               (define step-dir (if reverse-dir? -1 1))
               (for ([sq (in-list squads)])
                 ;; Recover majority persistent `(wpi . assigned-frame)` across squad members
                 (define vote-cnt (make-hasheqv))
                 (define vote-af (make-hasheqv))
                 (for ([uid (in-list sq)])
                   (define rec (hash-ref prev-unit-wp uid #f))
                   (when (and (pair? rec)
                              (exact-integer? (car rec))
                              (>= (car rec) 0)
                              (< (car rec) n-wp)
                              (exact-integer? (cdr rec)))
                     (define wpi (car rec))
                     (define af (cdr rec))
                     (hash-set! vote-cnt wpi (add1 (hash-ref vote-cnt wpi 0)))
                     (hash-set! vote-af wpi (min af (hash-ref vote-af wpi af)))))
                 (define cur-wpi
                   (for/fold ([best-w #f] [best-c -1] [best-af 999999999] #:result best-w)
                             ([(w c) (in-hash vote-cnt)])
                     (define af (hash-ref vote-af w 999999999))
                     (if (or (> c best-c) (and (= c best-c) (< af best-af)))
                         (values w c af)
                         (values best-w best-c best-af))))
                 (define cur-af (and cur-wpi (hash-ref vote-af cur-wpi sweep-frame)))
                 (define cur-timed-out?
                   (and cur-wpi (>= (- sweep-frame cur-af) 672)))
                 ;; W16-P1-2-rt (`#5135717`): Mark timed-out unreachable waypoints as visited
                 ;; so island/cliff-locked pads never block `all-primary-visited?` or stall the
                 ;; `6x6` lifted-building corner sweep!
                 (when cur-timed-out?
                   (hash-set! visited-wps cur-wpi sweep-frame))
                 (define arrived-or-expired?
                   (or (not cur-wpi)
                       cur-timed-out?
                       (> (hash-ref visited-wps cur-wpi -99999) cur-af)
                       (let ([cwp (list-ref wps cur-wpi)])
                         (for/or ([uid (in-list sq)])
                           (define xy (hash-ref uid->xy uid #f))
                           (and xy (<= (fast-dist2d (car xy) (cdr xy) (car cwp) (cdr cwp)) 8.0))))))
                 (define-values (chosen-wpi chosen-af)
                   (if (not arrived-or-expired?)
                       (values cur-wpi cur-af)
                       (let* ([start-k (if cur-wpi
                                           (modulo (+ cur-wpi step-dir) n-wp)
                                           (if reverse-dir? (sub1 n-wp) 0))]
                              [best-k
                               (for/fold ([bk #f] [b-fresh 2] [b-claim 999999] [b-last 999999999] #:result (or bk start-k))
                                         ([s (in-range n-wp)])
                                 (define k (modulo (+ start-k (* s step-dir)) n-wp))
                                 (if (and cur-wpi (> n-wp 1) (= k cur-wpi))
                                     (values bk b-fresh b-claim b-last)
                                     (let* ([lv (hash-ref visited-wps k -99999)]
                                            [fresh (if (>= (- sweep-frame lv) 672) 0 1)]
                                            [cl (vector-ref claimed-counts k)])
                                       (if (or (not bk)
                                               (< fresh b-fresh)
                                               (and (= fresh b-fresh) (< cl b-claim))
                                               (and (= fresh b-fresh) (= cl b-claim) (< lv b-last)))
                                           (values k fresh cl lv)
                                           (values bk b-fresh b-claim b-last)))))])
                         (values best-k sweep-frame))))
                 (vector-set! claimed-counts chosen-wpi (add1 (vector-ref claimed-counts chosen-wpi)))
                 (define rec-pair (cons chosen-wpi chosen-af))
                 (for ([uid (in-list sq)])
                   (hash-set! next-unit-wp uid rec-pair))
                 (define wp (list-ref wps chosen-wpi))
                 (l34-emit-preserved! ctx (list 'attack-pos (if (null? (cdr sq)) (car sq) sq) (car wp) (cdr wp)))))
             (assign-and-emit-squads! fly-squads #t)
             (assign-and-emit-squads! ground-squads #f)
             (hash-set! sweep-st 'unit-wp next-unit-wp)]))))
    endgame-hunt-active?))

(define (l34-phase5b-engage! ctx)
  (define endgame-hunt-active? (l34-run-endgame-building-hunt! ctx))
  ;; L58: Unified Generalized Safe-Rally Control-Group Staging (Live Full-Match Gate Only).
  ;; Runs before Phase 5b engage (even when enemies are in Fog) and marks staging/regrouping
  ;; units in `wave3-handled-tags` so neither Phase 5b nor Phase 6 pulls them off staging.
  (define l58-staging-active?
    (let* ([live-p (l34-ctx-live-obs? ctx)]
           [rt-p (l34-ctx-rt ctx)]
           [cu-p (l34-ctx-combat-units ctx)]
           [sc-p (l34-ctx-l34-sc ctx)]
           [au-chk (or (l34-ctx-ally-units ctx) '())]
           [mp-race-chk (and rt-p (live-bot-runtime-actual-race rt-p))]
           [has-empty-prism-mp?
            (and (eq? mp-race-chk 'Protoss)
                 (ormap (lambda (u)
                          (and (hash? u)
                               (memq (unit-type-sym u) '(warp-prism warp-prism-phasing))
                               (= (safe-nonneg-int (hash-ref u 'cargo-space-taken 0) 0) 0)
                               (null? (hash-ref u 'passengers '()))))
                        au-chk))]
           [th-syms-chk '(hatchery lair hive nexus command-center orbital-command planetary-fortress)]
           [has-enemy-th-mp?
            (ormap (lambda (b)
                     (and (hash? b) (memq (fast-canonical-structure-sym (unit-type-sym b)) th-syms-chk)))
                   (or (l34-ctx-enemy-bldgs ctx) '()))]
           ;; Loop 65E (`#1907`/`#1909`): Keep `step-staging-groups!` gated on `(not endgame-hunt-active?)`,
           ;; but allow Protoss empty-Warp-Prism `step-multiprong-coordinator!` + forward warp-ins
           ;; during `endgame-hunt-active?` whenever live enemy TownHalls exist!
           [mp-endgame-prism-ok?
            (and endgame-hunt-active? has-empty-prism-mp? has-enemy-th-mp?)])
      (cond
        [(and live-p rt-p
              (or (and (not endgame-hunt-active?)
                       (or (pair? cu-p)
                           (and (eq? mp-race-chk 'Protoss)
                                (ormap (lambda (u)
                                         (and (hash? u)
                                              (memq (unit-type-sym u) '(warp-prism warp-prism-phasing))))
                                       au-chk))))
                  mp-endgame-prism-ok?))
         (define obs-p (l34-ctx-obs ctx))
         (define fr-p (l34-ctx-frame ctx))
         (define eu-p (l34-ctx-enemy-units ctx))
         (define au-p (l34-ctx-ally-units ctx))
         (define ab-p (or (l34-ctx-ally-bldgs ctx) '()))
         (define mw-p (exact->inexact (max 64.0 (safe-finite-real (hash-ref obs-p 'map-width 200.0) 200.0))))
         (define mh-p (exact->inexact (max 64.0 (safe-finite-real (hash-ref obs-p 'map-height 200.0) 200.0))))
         (define mps-p (let ([v (hash-ref obs-p 'mineral-patches '())]) (if (list? v) v '())))
         (define mharv-p (safe-nonneg-int (hash-ref obs-p 'mineral-harvesters 0) 0))
         (define vharv-p (safe-nonneg-int (hash-ref obs-p 'vespene-harvesters 0) 0))
         (define sup-used-p (safe-nonneg-int (hash-ref obs-p 'supply-used 0) 0))
         (define combat-sup-p
           (max (exact->inexact (l34-ctx-live-combat-supply ctx))
                (exact->inexact (safe-nonneg-int (hash-ref obs-p 'army-supply (hash-ref obs-p 'food-army 0)) 0))))
         (define owm-p (opponent-world-model-last-summary (rt-opponent-world-model rt-p)))
         (define owm-kc-p (and owm-p (opponent-world-summary-known-unit-counts owm-p)))
         (define owm-bel-p (if owm-p (opponent-world-summary-believed-total-army-supply owm-p) 0))
         (define vis-cap-p
           (for/sum ([e (in-list eu-p)]
                     #:when (and (hash? e)
                                 (not (eq? (hash-ref e 'snapshot? #f) #t))
                                 (eqv? (hash-ref e 'display-type 1) 1)
                                 (memq (fast-canonical-unit-sym (unit-type-sym e))
                                       '(tempest carrier battlecruiser mothership))))
             1))
         (define owm-cap-p
           (if (hash? owm-kc-p)
               (+ (hash-ref owm-kc-p 'tempest 0)
                  (hash-ref owm-kc-p 'carrier 0)
                  (hash-ref owm-kc-p 'battlecruiser 0)
                  (hash-ref owm-kc-p 'mothership 0))
               0))
         (define rt-cap-p
           (let* ([ds (rt-door-state rt-p)]
                  [pf (hash-ref ds 'l33-last-cap-air-frame -99999)]
                  [pc (hash-ref ds 'l33-last-cap-air-cnt 0)])
             (cond
               [(>= vis-cap-p 3)
                (hash-set! ds 'l33-last-cap-air-frame fr-p)
                (hash-set! ds 'l33-last-cap-air-cnt (max vis-cap-p owm-cap-p))
                (max vis-cap-p owm-cap-p)]
               [(and (>= fr-p pf) (<= (- fr-p pf) 1344) (>= pc 3)) pc]
               [else 0])))
         (define eff-cap-p (max vis-cap-p owm-cap-p rt-cap-p))
         (define aa-syms-p
           '(viking viking-fighter corruptor phoenix void-ray voidray mutalisk
             battlecruiser carrier tempest hydralisk thor stalker marine cyclone))
         (define vis-aa-p
           (for/sum ([e (in-list eu-p)]
                     #:when (and (hash? e)
                                 (not (eq? (hash-ref e 'snapshot? #f) #t))
                                 (eqv? (hash-ref e 'display-type 1) 1)
                                 (memq (fast-canonical-unit-sym (unit-type-sym e)) aa-syms-p)))
             1))
         (define owm-aa-p
           (if (hash? owm-kc-p)
               (for/sum ([s (in-list aa-syms-p)]) (hash-ref owm-kc-p s 0))
               0))
         (define eff-aa-p (max vis-aa-p owm-aa-p))
         ;; Build lightweight in-production unit counts from active production building orders & Zerg eggs
         (define in-prod-ht (make-hasheq))
         (for ([b (in-list ab-p)] #:when (hash? b))
           (define abid (hash-ref b 'order-ability-id 0))
           (define psym
             (case abid
               [(560 562) 'marine]
               [(563) 'marauder]
               [(561) 'reaper]
               [(595) 'hellion]
               [(621) 'banshee]
               [(624) 'viking-fighter]
               [(916) 'zealot]
               [(917) 'stalker]
               [(921) 'sentry]
               [(922) 'adept]
               [(919) 'high-templar]
               [(920) 'dark-templar]
               [(946) 'phoenix]
               [(950) 'void-ray]
               [(954) 'oracle]
               [(948) 'carrier]
               [(955) 'tempest]
               ;; Loop 65F (`#1920`/`#1922`): Count Protoss Robotics Facility production using
               ;; exact SC2 5.0.14 ability IDs (`979` Immortal, `978` Colossus, `994` Disruptor)!
               [(979) 'immortal]
               [(978) 'colossus]
               [(994) 'disruptor]
               [else #f]))
           (when psym
             (hash-set! in-prod-ht psym (add1 (hash-ref in-prod-ht psym 0)))))
         (for ([au (in-list au-p)] #:when (and (hash? au) (eq? (unit-type-sym au) 'egg)))
           (define abid (hash-ref au 'order-ability-id 0))
           (define psym
             (case abid
               [(1343) 'zergling]
               [(1351) 'roach]
               [(1345) 'hydralisk]
               [(1346) 'mutalisk]
               [(1353) 'corruptor]
               [else 'combat-egg]))
           (hash-set! in-prod-ht psym (add1 (hash-ref in-prod-ht psym 0))))
         ;; Loop 65H (`#1947`/`#1949`, STRICTLY Protoss-only): Count warping-in Gateway combat units
         ;; (`build-progress < SC2-BUILD-COMPLETE-PROGRESS`) AND ready affordable `warp-gate`s
         ;; (`minerals >= 100` & `supply-left >= 2`) into `in-prod-ht` so Protoss `'main-reinforce`
         ;; waits for imminent Warp-Gate cycles and drops to `0` when broke or supply-blocked!
         (when (eq? (live-bot-runtime-actual-race rt-p) 'Protoss)
           (for ([au (in-list au-p)] #:when (hash? au))
             (define ut (fast-canonical-unit-sym (unit-type-sym au)))
             (when (and (memq ut '(zealot stalker sentry adept high-templar dark-templar))
                        (< (safe-finite-real (hash-ref au 'build-progress 1.0) 1.0)
                           SC2-BUILD-COMPLETE-PROGRESS))
               (hash-set! in-prod-ht ut (add1 (hash-ref in-prod-ht ut 0)))))
           (define p-wg-min
             (inexact->exact (max 0 (floor (safe-finite-real (hash-ref obs-p 'minerals 0) 0)))))
           (define p-wg-sup-left
             (max 0 (- (inexact->exact (floor (safe-finite-real (hash-ref obs-p 'supply-cap 0) 0)))
                       sup-used-p)))
           (when (and (>= p-wg-min 100) (>= p-wg-sup-left 2))
             (define p-ready-wgs
               (count (lambda (b)
                        (and (hash? b)
                             (eq? (fast-canonical-structure-sym (unit-type-sym b)) 'warp-gate)
                             (>= (hash-ref b 'build-progress 1.0) SC2-BUILD-COMPLETE-PROGRESS)
                             (<= (hash-ref b 'order-count 0) 0)
                             (not (eq? (hash-ref b 'warp-ready? #t) #f))
                             (not (memq 'warp-gate-cooldown (hash-ref b 'buffs '())))))
                      ab-p))
             (define p-wg-afford (min p-ready-wgs (quotient p-wg-min 100) (quotient p-wg-sup-left 2)))
             (when (> p-wg-afford 0)
               (hash-set! in-prod-ht 'warp-gate-ready
                          (+ (hash-ref in-prod-ht 'warp-gate-ready 0) p-wg-afford)))))
         (hash-set! (rt-door-state rt-p) 'l65h-last-in-prod-counts in-prod-ht)
         (define skip-p
           (for/fold ([s (seteqv)])
                     ([st (in-list (list (l34-ctx-disruptor-handled-tags ctx)
                                         (l34-ctx-splash-evading-tags ctx)
                                         (l34-ctx-wave3-handled-tags ctx)
                                         (l34-ctx-snipe-locked-tags ctx)
                                         (l34-ctx-queen-cast-tags ctx)
                                         (l34-ctx-ravager-cast-tags ctx)
                                         (l34-ctx-oracle-cast-tags ctx)))])
             (for/fold ([s2 s]) ([id (in-set st)]) (set-add s2 id))))
         (define our-bfs-p (hash-ref obs-p 'our-ground-bfs #f))
         (define bfs-fn-p (and our-bfs-p (lambda (px py) (l34-eval-bfs-dist our-bfs-p px py))))
         (define sweep-st-p (rt-endgame-sweep-state rt-p))
         (define em-cleared-p
           (or (and sweep-st-p (hash-ref sweep-st-p 'enemy-main-cleared? #f))
               (hash-ref obs-p 'enemy-main-cleared #f)))
         (define vic-post-p
           (not (not (memq (live-bot-runtime-posture rt-p)
                           '(attack SwarmVictory ProtossArmadaVictory MothmanApexVictory)))))
         (define enemy-near-main-p
           (and (hash? sc-p) (hash-ref sc-p 'l25-enemy-within-14-of-main? #f)))
         (define stg-res
           (and (not endgame-hunt-active?)
                (step-staging-groups!
                 (rt-staging-groups rt-p)
                 #:frame fr-p
                 #:live-obs? live-p
                 #:ally-units au-p
                 #:combat-units cu-p
                 #:ally-buildings ab-p
                 #:enemy-units eu-p
                 #:mineral-patches mps-p
                 #:mineral-harvesters mharv-p
                 #:vespene-harvesters vharv-p
                 #:base-x (l34-ctx-base-x ctx)
                 #:base-y (l34-ctx-base-y ctx)
                 #:nat-x (l34-ctx-nat-x ctx)
                 #:nat-y (l34-ctx-nat-y ctx)
                 #:third-x (l34-ctx-third-x ctx)
                 #:third-y (l34-ctx-third-y ctx)
                 #:enemy-anchor-x (l34-ctx-enemy-x ctx)
                 #:enemy-anchor-y (l34-ctx-enemy-y ctx)
                 #:map-width mw-p
                 #:map-height mh-p
                 #:bfs-dist-fn bfs-fn-p
                 #:role-leases (rt-role-leases rt-p)
                 #:skip-tags skip-p
                 #:enemy-cap-air-cnt eff-cap-p
                 #:enemy-contested-aa-cnt eff-aa-p
                 #:combat-suppress-attack? (l34-ctx-combat-suppress-attack? ctx)
                 #:under-home-attack? (or (l34-ctx-under-tactics-base-attack? ctx)
                                          (l34-ctx-enemy-within-14-of-th? ctx))
                 #:enemy-near-main? enemy-near-main-p
                 #:endgame-hunt-active? endgame-hunt-active?
                 #:enemy-main-cleared? em-cleared-p
                 #:decisive-victory-posture? vic-post-p
                 #:supply-used sup-used-p
                 #:ally-combat-supply (inexact->exact (round combat-sup-p))
                 #:enemy-believed-supply owm-bel-p
                 #:in-production-counts in-prod-ht
                 #:defensive-muster-active? (and (hash? sc-p) (hash-ref sc-p 'l64-defensive-muster-active? #f)))))
         (define w3-ht (l34-ctx-wave3-handled-tags ctx))
         (when stg-res
           (for ([pa (in-list (staging-step-result-preserved-actions stg-res))])
             (l34-emit-preserved! ctx pa))
           (for ([a (in-list (staging-step-result-actions stg-res))])
             (l34-emit! ctx a))
           (for ([uid (in-set (staging-step-result-handled-tags stg-res))])
             (set-add! w3-ht uid)))
         (when (hash? sc-p)
           (hash-set! sc-p 'l58-staging-active? (and stg-res (staging-step-result-active? stg-res) #t)))
         ;; Loop 65 + Phase B + Loop 65B + Loop 65E (`#1828`/`#1846`/`#1863`/`#1909`): Thin operational
         ;; multiprong/rotate/backstab/defensive-split + Protoss empty-Prism Chargelot warp-in hook!
         (let* ([th-syms '(hatchery lair hive nexus command-center orbital-command planetary-fortress)]
                [ally-ths-mp
                 (for/list ([b (in-list ab-p)]
                            #:when (and (hash? b) (memq (fast-canonical-structure-sym (unit-type-sym b)) th-syms)))
                   b)]
                [eb-mp (or (l34-ctx-enemy-bldgs ctx) '())]
                [enemy-ths-mp
                 (for/list ([b (in-list eb-mp)]
                            #:when (and (hash? b) (memq (fast-canonical-structure-sym (unit-type-sym b)) th-syms)))
                   b)]
                ;; Allow Prism backstab & multiprong even after enemy main dies (`em-cleared-p`)
                ;; while surviving enemy TownHalls still exist (`pair? enemy-ths-mp`)!
                [mp-main-cleared? (and em-cleared-p (null? enemy-ths-mp))]
                [mp-race (live-bot-runtime-actual-race rt-p)])
           (when (and live-p (>= fr-p 5376)
                      (or (not endgame-hunt-active?)
                          (and (eq? mp-race 'Protoss) (pair? enemy-ths-mp) has-empty-prism-mp?))
                      (not mp-main-cleared?)
                      (>= (length ally-ths-mp) 2))
             (define ready-wgs-mp
               (if (eq? mp-race 'Protoss)
                   (for/list ([b (in-list ab-p)]
                              #:when (and (hash? b)
                                          (eq? (fast-canonical-structure-sym (unit-type-sym b)) 'warp-gate)
                                          (exact-integer? (hash-ref b 'id -1))
                                          (> (hash-ref b 'id -1) 0)
                                          (>= (hash-ref b 'build-progress 1.0) SC2-BUILD-COMPLETE-PROGRESS)
                                          (<= (hash-ref b 'order-count 0) 0)
                                          (not (eq? (hash-ref b 'warp-ready? #t) #f))
                                          (not (memq 'warp-gate-cooldown (hash-ref b 'buffs '())))))
                     b)
                   '()))
             (define mp-minerals
               (inexact->exact (max 0 (floor (safe-finite-real (hash-ref obs-p 'minerals 0) 0)))))
             (define mp-sup-left
               (max 0 (- (inexact->exact (floor (safe-finite-real (hash-ref obs-p 'supply-cap 0) 0)))
                         sup-used-p)))
             (define mp-charge-ok? (and (eq? mp-race 'Protoss) (l34-has-upgrade? ctx 'charge)))
             (define mp-claimed
               (if stg-res
                   (for/fold ([s skip-p]) ([id (in-set (staging-step-result-handled-tags stg-res))])
                     (set-add s id))
                   skip-p))
             (define mp-suppress? (l34-ctx-combat-suppress-attack? ctx))
             (define mp-res
               (step-multiprong-coordinator!
                (rt-multiprong-state rt-p)
                #:frame fr-p #:live-obs? live-p #:race mp-race
                #:ally-units au-p #:combat-units cu-p #:ally-townhalls ally-ths-mp
                #:enemy-units eu-p #:enemy-townhalls enemy-ths-mp
                #:base-x (l34-ctx-base-x ctx) #:base-y (l34-ctx-base-y ctx)
                #:enemy-x (l34-ctx-enemy-x ctx) #:enemy-y (l34-ctx-enemy-y ctx)
                #:map-width mw-p #:map-height mh-p
                #:claimed-tags mp-claimed
                #:arbiter-ledger (rt-arbiter-ledger rt-p)
                #:role-leases (rt-role-leases rt-p)
                #:defensive-muster-active? (and (hash? sc-p) (hash-ref sc-p 'l64-defensive-muster-active? #f))
                #:combat-suppress-attack? mp-suppress?
                #:endgame-hunt-active? endgame-hunt-active?
                #:enemy-main-cleared? mp-main-cleared?
                #:enemy-buildings eb-mp
                #:bfs-dist-fn bfs-fn-p
                #:ready-warp-gates (length ready-wgs-mp)
                #:minerals mp-minerals
                #:supply-left mp-sup-left
                #:charge-researched? mp-charge-ok?))
             (define mp-mode (multiprong-result-mode mp-res))
             (define mp-defensive-mode?
               (and (memq mp-mode '(defensive-split defensive-full-rotate)) #t))
             (define mp-preserve?
               (and (memq mp-mode '(defensive-split defensive-full-rotate prism-warp-backstab)) #t))
             (for ([raw-a (in-list (multiprong-result-actions mp-res))])
               (define a
                 (cond
                   [(and (pair? raw-a) (eq? (car raw-a) 'warp-prism-phasing) (pair? (cdr raw-a)))
                    (list 'cast-spell (second raw-a) 'morph-warp-prism-phasing (second raw-a))]
                   [(and (pair? raw-a) (eq? (car raw-a) 'warp-prism-transport) (pair? (cdr raw-a)))
                    (list 'cast-spell (second raw-a) 'morph-warp-prism-transport (second raw-a))]
                   [else raw-a]))
               (if mp-preserve? (l34-emit-preserved! ctx a) (l34-emit! ctx a)))
             ;; Loop 65B/65C (`#1861`/`#1874`/`#1876`): Defensive split responders acquire
             ;; `20f` `'strike-group` (`55`, staying in `combat-units` on frame N+1 while `w3-ht`
             ;; protects active-frame orders), and offensive multiprong uses short `16f` `'strike-group`
             ;; skipped during `combat-suppress-attack?` so Phase 6 raids & retreat stay free!
             (define mp-leases (rt-role-leases rt-p))
             (for ([uid (in-set (multiprong-result-handled-tags mp-res))])
               (set-add! w3-ht uid)
               (cond
                 [mp-defensive-mode?
                  (acquire-unit-lease! mp-leases uid 'strike-group fr-p 20)]
                 [(not mp-suppress?)
                  (acquire-unit-lease! mp-leases uid 'strike-group fr-p 16)]))
             (when (hash? sc-p)
               (hash-set! sc-p 'l65-multiprong-mode mp-mode))
             ;; Loop 65 Addendum (`#1845`/`#1846`): Forward Phased Warp Prism Chargelot Warp-In!
             (when (and (eq? mp-race 'Protoss)
                        (pair? ready-wgs-mp)
                        (>= mp-minerals 100)
                        (>= mp-sup-left 2)
                        (not (l34-ctx-under-tactics-base-attack? ctx))
                        (not enemy-near-main-p))
               (define mp-prong-pt (multiprong-result-active-prong-target mp-res))
               (define fbx-wp (exact->inexact (l34-ctx-base-x ctx)))
               (define fby-wp (exact->inexact (l34-ctx-base-y ctx)))
               (define fex-wp (exact->inexact (l34-ctx-enemy-x ctx)))
               (define fey-wp (exact->inexact (l34-ctx-enemy-y ctx)))
               (define phased-prisms
                 (for/list ([u (in-list au-p)]
                            #:when (and (hash? u)
                                        (eq? (unit-type-sym u) 'warp-prism-phasing)
                                        (real? (hash-ref u 'x #f)) (real? (hash-ref u 'y #f))))
                   u))
               (define warp-target-pt
                 (cond
                   [(and (eq? mp-mode 'prism-warp-backstab)
                         (pair? mp-prong-pt)
                         (real? (car mp-prong-pt)) (real? (cdr mp-prong-pt))
                         (ormap (lambda (pr)
                                  (fl<= (fast-dist2d (exact->inexact (hash-ref pr 'x 0.0))
                                                     (exact->inexact (hash-ref pr 'y 0.0))
                                                     (exact->inexact (car mp-prong-pt))
                                                     (exact->inexact (cdr mp-prong-pt)))
                                        6.0))
                                phased-prisms))
                    mp-prong-pt]
                   [else
                    (for/first ([pr (in-list phased-prisms)]
                                #:when (let* ([px (exact->inexact (hash-ref pr 'x 0.0))]
                                              [py (exact->inexact (hash-ref pr 'y 0.0))]
                                              [d-home (fast-dist2d px py fbx-wp fby-wp)]
                                              [d-en (fast-dist2d px py fex-wp fey-wp)]
                                              [near-enemy-base?
                                               (or (fl<= d-en 16.0)
                                                   (for/or ([eb (in-list eb-mp)])
                                                     (and (hash? eb) (real? (hash-ref eb 'x #f)) (real? (hash-ref eb 'y #f))
                                                          (fl<= (fast-dist2d px py
                                                                             (exact->inexact (hash-ref eb 'x 9999.0))
                                                                             (exact->inexact (hash-ref eb 'y 9999.0)))
                                                                16.0))))])
                                         (and (or (fl< d-en d-home) (fl> d-home 28.0))
                                              near-enemy-base?)))
                      (cons (exact->inexact (hash-ref pr 'x fex-wp))
                            (exact->inexact (hash-ref pr 'y fey-wp))))]))
               (when (pair? warp-target-pt)
                 (define wx (safe-coord (car warp-target-pt) fex-wp))
                 (define wy (safe-coord (cdr warp-target-pt) fey-wp))
                 (define max-wave (if mp-charge-ok? 6 4))
                 (define wave-n (min max-wave (length ready-wgs-mp) (quotient mp-minerals 100) (quotient mp-sup-left 2)))
                 (define cd-mp (live-bot-runtime-cooldown-tracker rt-p))
                 (for ([wg (in-list (take ready-wgs-mp wave-n))])
                   (define wgid (hash-ref wg 'id -1))
                   (when (and (> wgid 0)
                              (refractory-allow-action?! cd-mp (list 'l65-prism-backstab-warp wgid) fr-p 48))
                     (l34-emit-preserved! ctx (list 'warp-in wgid 'zealot wx wy))))))))
         (and stg-res (staging-step-result-active? stg-res) #t)]
        [else
         (when (hash? sc-p)
           (hash-set! sc-p 'l58-staging-active? #f))
         #f])))
  ;; L59C (`#1566` Fix #4): Disabled `l59-p7-reserved-harass-tags` — NEVER pull live midgame
  ;; army units out of Phase 5b into Phase 7 (prevented `ATK_PT 8+` army fragmentation!).
  (let ([sc-r (l34-ctx-l34-sc ctx)])
    (when (hash? sc-r)
      (hash-set! sc-r 'l59-p7-reserved-harass-tags (mutable-seteqv))))
  ;; L59-P3 + L59C (`#1566` Fix #1) + L60 (`sc2-nc-09` restore): Pre-Phase-5b Destructible Rock
  ;; Breach (`nc-09`), Collapsible Rockslide Seal (`nc-10`), & Post-Clear Follow-Through (`nc-07`/`nc-08`).
  ;; Strictly gated to `(not has-th-rk?)` where `has-th-rk?` means a LIVE-ECONOMY base (`>= 2` ally
  ;; buildings OR `>= 2` townhalls OR `>= 3` workers within `16.0t` of our townhall — true from frame `0`
  ;; in live full matches with 12 starting workers, while `#f` in 0-TH unit tests AND isolated Arena
  ;; drills that keep 1 hidden starting TownHall far away at spawn with `0..1` nearby workers!).
  (let* ([obs-rk (l34-ctx-obs ctx)]
         [neutrals-rk (let ([v (and (hash? obs-rk) (hash-ref obs-rk 'neutral-units '()))])
                        (if (list? v) v '()))]
         [rt-rk (l34-ctx-rt ctx)]
         [dst-rk (and rt-rk (rt-door-state rt-rk))]
         [fr-rk (l34-ctx-frame ctx)]
         [ab-rk (or (l34-ctx-ally-bldgs ctx) '())]
         [th-list-rk
          (for/list ([b (in-list ab-rk)]
                     #:when (and (hash? b)
                                 (memq (fast-canonical-structure-sym (unit-type-sym b))
                                       '(hatchery lair hive nexus command-center orbital-command planetary-fortress))))
            b)]
         [has-th-rk?
          (and (pair? th-list-rk)
               (or (> (length ab-rk) 1)
                   (> (length th-list-rk) 1)
                   (for/or ([b (in-list th-list-rk)])
                     (memq (fast-canonical-structure-sym (unit-type-sym b))
                           '(orbital-command planetary-fortress lair hive)))
                   (let ([mh (if (hash? obs-rk) (safe-finite-real (hash-ref obs-rk 'mineral-harvesters 0) 0) 0)]
                         [gh (if (hash? obs-rk)
                                 (safe-finite-real (hash-ref obs-rk 'vespene-harvesters
                                                             (hash-ref obs-rk 'gas-harvesters 0))
                                                   0)
                                 0)])
                     (>= (+ mh gh) 3))
                   (let* ([th0 (car th-list-rk)]
                          [tx (exact->inexact (hash-ref th0 'x 0.0))]
                          [ty (exact->inexact (hash-ref th0 'y 0.0))]
                          [near-w
                           (count (lambda (u)
                                    (and (hash? u)
                                         (memq (unit-type-sym u) '(probe scv drone))
                                         (real? (hash-ref u 'x #f)) (real? (hash-ref u 'y #f))
                                         (fl<= (fast-dist2d tx ty
                                                            (exact->inexact (hash-ref u 'x 9999.0))
                                                            (exact->inexact (hash-ref u 'y 9999.0)))
                                               16.0)))
                                  (or (l34-ctx-ally-units ctx) '()))])
                     (>= near-w 3))))])
    (when (and (hash? dst-rk) (< fr-rk (hash-ref dst-rk 'l59-prev-barrier-frame -1)))
      (hash-set! dst-rk 'l59-prev-barrier-cnt 0)
      (hash-set! dst-rk 'l59-barrier-cleared-until -1)
      (hash-remove! dst-rk 'l59-barrier-goal-pt))
    (when (and (l34-ctx-live-obs? ctx)
               (not has-th-rk?)
               (or (pair? neutrals-rk)
                   (and (hash? dst-rk)
                        (or (> (hash-ref dst-rk 'l59-prev-barrier-cnt 0) 0)
                            (<= fr-rk (hash-ref dst-rk 'l59-barrier-cleared-until -1))))))
      (define w3-rk (l34-ctx-wave3-handled-tags ctx))
      (define se-rk (l34-ctx-splash-evading-tags ctx))
      (define cu-rk (or (l34-ctx-combat-units ctx) '()))
      (define au-rk (or (l34-ctx-ally-units ctx) '()))
      (define eu-rk (or (l34-ctx-enemy-units ctx) '()))
      (define eb-rk (or (l34-ctx-enemy-bldgs ctx) '()))
      (define th-pts-rk
        (for/list ([b (in-list (append ab-rk eb-rk))]
                   #:when (and (hash? b)
                               (real? (hash-ref b 'x #f))
                               (real? (hash-ref b 'y #f))
                               (memq (fast-canonical-structure-sym (unit-type-sym b))
                                     '(hatchery lair hive nexus command-center orbital-command planetary-fortress))))
          (cons (exact->inexact (hash-ref b 'x 0.0))
                (exact->inexact (hash-ref b 'y 0.0)))))
      (define (rk-collapsible-tower? n)
        (and (hash? n)
             (let ([nid (hash-ref n 'id (hash-ref n 'tag 0))]
                   [nhp (exact->inexact (safe-finite-real (hash-ref n 'hp 0.0) 0.0))]
                   [utid (hash-ref n 'unit-type-id 0)]
                   [nsym (unit-type-sym n)])
               (and (exact-integer? nid) (> nid 0) (fl> nhp 0.0)
                    (real? (hash-ref n 'x #f)) (real? (hash-ref n 'y #f))
                    (or (memv utid '(480 482 588 589 590 591 594 595 596 597 598 599 600 601 602
                                     609 610 663 664 882 2003 2004))
                        (and (symbol? nsym)
                             (regexp-match? #rx"(?i:collapsible)" (symbol->string nsym))))))))
      (define (rk-destructible-rock? n)
        (and (hash? n)
             (not (rk-collapsible-tower? n))
             (let ([nid (hash-ref n 'id (hash-ref n 'tag 0))]
                   [nhp (exact->inexact (safe-finite-real (hash-ref n 'hp 0.0) 0.0))]
                   [nmhp (exact->inexact (safe-finite-real (hash-ref n 'max-hp 0.0) 0.0))]
                   [utid (hash-ref n 'unit-type-id 0)]
                   [mc (safe-finite-real (hash-ref n 'mineral-contents 0) 0)]
                   [vc (safe-finite-real (hash-ref n 'vespene-contents 0) 0)]
                   [nsym (unit-type-sym n)])
               (and (exact-integer? nid) (> nid 0) (fl> nhp 0.0)
                    (real? (hash-ref n 'x #f)) (real? (hash-ref n 'y #f))
                    (<= mc 0) (<= vc 0)
                    ;; L59-P3b Fix #2B (`#1552`): Exclude Xel'Naga watchtower (149) AND ALL flat
                    ;; unbuildable ground plates/bricks/rocks (472/473/474 + `#rx"unbuildable|plate|brick"`)!
                    (not (memv utid '(149 472 473 474)))
                    (not (and (symbol? nsym)
                              (regexp-match? #rx"(?i:unbuildable|plate|brick)" (symbol->string nsym))))
                    (or (memv utid '(367 369 370 372 373 375 376
                                     624 625 626 627 628 629 630 631 638
                                     639 640 641 642 643 644 645 646 647 648 649 650 651 652 653 658 836))
                        (and (symbol? nsym)
                             (regexp-match? #rx"(?i:destructible|rock|debris)" (symbol->string nsym)))
                        (and (not has-th-rk?) (fl>= nmhp 400.0)))))))
      (define (rk-thin-mineral-wall? n)
        (and (hash? n)
             (let ([mc (safe-finite-real (hash-ref n 'mineral-contents 0) 0)]
                   [nx (hash-ref n 'x #f)]
                   [ny (hash-ref n 'y #f)])
               (and (> mc 0) (<= mc 150)
                    (real? nx) (real? ny)
                    (or (not has-th-rk?)
                        (let ([fx (exact->inexact nx)] [fy (exact->inexact ny)])
                          (not (for/or ([tp (in-list th-pts-rk)])
                                 (fl<= (fast-dist2d fx fy (car tp) (cdr tp)) 10.5)))))))))
      (define (rk-ground-shooter? u)
        (and (hash? u)
             (let ([uid (hash-ref u 'id -1)]
                   [ut (unit-type-sym u)])
               (and (exact-integer? uid) (> uid 0)
                    (not (set-member? w3-rk uid))
                    (not (set-member? se-rk uid))
                    (not (hash-ref u 'burrowed? #f))
                    (not (hash-ref u 'is-burrowed? #f))
                    (real? (hash-ref u 'x #f)) (real? (hash-ref u 'y #f))
                    (let ([st (fast-unit-combat-stats ut)])
                      (and (hash? st) (fl> (exact->inexact (hash-ref st 'ground-dps 0.0)) 0.0)))))))
      (define live-enemy-combat-rk
        (for/list ([e (in-list eu-rk)]
                   #:when (and (hash? e)
                               (combat-unit-record? e)
                               (not (hash-ref e 'snapshot? #f))
                               (real? (hash-ref e 'x #f))
                               (real? (hash-ref e 'y #f))))
          e))
      ;; Track nearby thin mineral walls & destructible rocks for post-clear follow-through
      ;; Check cheap neutral type/mineral-contents filter FIRST (`O(|neutrals|)`) before scanning
      ;; `au-rk` so 16-base maps with 250+ normal minerals/geysers stay < 0.01 ms/step!
      (define (rk-near-any-ally? fx fy)
        (for/or ([u (in-list au-rk)])
          (and (hash? u) (real? (hash-ref u 'x #f)) (real? (hash-ref u 'y #f))
               (fl<= (fast-dist2d fx fy
                                  (exact->inexact (hash-ref u 'x 9999.0))
                                  (exact->inexact (hash-ref u 'y 9999.0)))
                     18.0))))
      (define-values (near-towers near-rocks near-thin-walls)
        (for/fold ([ts '()] [rs '()] [ws '()]) ([n (in-list neutrals-rk)] #:when (hash? n))
          (cond
            [(rk-thin-mineral-wall? n)
             (if (rk-near-any-ally? (exact->inexact (hash-ref n 'x 9999.0))
                                    (exact->inexact (hash-ref n 'y 9999.0)))
                 (values ts rs (cons n ws))
                 (values ts rs ws))]
            [(rk-collapsible-tower? n)
             (if (rk-near-any-ally? (exact->inexact (hash-ref n 'x 9999.0))
                                    (exact->inexact (hash-ref n 'y 9999.0)))
                 (values (cons n ts) rs ws)
                 (values ts rs ws))]
            [(rk-destructible-rock? n)
             (if (rk-near-any-ally? (exact->inexact (hash-ref n 'x 9999.0))
                                    (exact->inexact (hash-ref n 'y 9999.0)))
                 (values ts (cons n rs) ws)
                 (values ts rs ws))]
            [else (values ts rs ws)])))
      (when (hash? dst-rk)
        (define cur-bar-cnt (+ (length near-rocks) (length near-thin-walls)))
        (define prev-bar-cnt (hash-ref dst-rk 'l59-prev-barrier-cnt 0))
        (hash-set! dst-rk 'l59-prev-barrier-frame fr-rk)
        (when (> cur-bar-cnt 0)
          (hash-set! dst-rk 'l59-prev-barrier-cnt (max prev-bar-cnt cur-bar-cnt))
          (define far-tgt
            (for/fold ([best #f] [bd 32.01] #:result best) ([t (in-list (append eb-rk eu-rk))])
              (if (and (hash? t) (real? (hash-ref t 'x #f)) (real? (hash-ref t 'y #f)))
                  (let* ([tx (exact->inexact (hash-ref t 'x 9999.0))]
                         [ty (exact->inexact (hash-ref t 'y 9999.0))]
                         [d (for/fold ([md 999.0]) ([u (in-list au-rk)])
                              (if (and (hash? u) (real? (hash-ref u 'x #f)) (real? (hash-ref u 'y #f)))
                                  (flmin md (fast-dist2d tx ty
                                                         (exact->inexact (hash-ref u 'x 9999.0))
                                                         (exact->inexact (hash-ref u 'y 9999.0))))
                                  md))])
                    (if (fl< d bd) (values (cons tx ty) d) (values best bd)))
                  (values best bd))))
          (when far-tgt
            (hash-set! dst-rk 'l59-barrier-goal-pt far-tgt)))
        (when (and (> prev-bar-cnt 0) (< cur-bar-cnt prev-bar-cnt))
          (hash-set! dst-rk 'l59-barrier-cleared-until (+ fr-rk 336))
          (hash-set! dst-rk 'l59-prev-barrier-cnt cur-bar-cnt)))
      ;; 1. Collapsible Rockslide Choke Seal (`nc-10` & live choke traps)
      (when (and (pair? near-towers) (pair? cu-rk))
        (for ([tw (in-list near-towers)])
          (define tid (hash-ref tw 'id (hash-ref tw 'tag 0)))
          (define tx (exact->inexact (hash-ref tw 'x 0.0)))
          (define ty (exact->inexact (hash-ref tw 'y 0.0)))
          (define e-approach
            (count (lambda (e)
                     (and (not (fast-unit-is-flying-sym? (unit-type-sym e)))
                          (fl<= (fast-dist2d (exact->inexact (hash-ref e 'x 9999.0))
                                             (exact->inexact (hash-ref e 'y 9999.0))
                                             tx ty)
                                18.5)))
                   live-enemy-combat-rk))
          (define a-in-drop
            (count (lambda (u)
                     (and (hash? u)
                          (not (fast-unit-is-flying-sym? (unit-type-sym u)))
                          (real? (hash-ref u 'x #f)) (real? (hash-ref u 'y #f))
                          (fl<= (fast-dist2d (exact->inexact (hash-ref u 'x 9999.0))
                                             (exact->inexact (hash-ref u 'y 9999.0))
                                             tx ty)
                                3.5)))
                   cu-rk))
          (when (and (>= e-approach 3) (= a-in-drop 0))
            (define tw-shooters
              (for/list ([u (in-list cu-rk)]
                         #:when (and (rk-ground-shooter? u)
                                     (let ([ux (exact->inexact (hash-ref u 'x 9999.0))]
                                           [uy (exact->inexact (hash-ref u 'y 9999.0))])
                                       (and (fl<= (fast-dist2d ux uy tx ty) 14.0)
                                            (not (for/or ([e (in-list live-enemy-combat-rk)])
                                                   (fl<= (fast-dist2d ux uy
                                                                      (exact->inexact (hash-ref e 'x 9999.0))
                                                                      (exact->inexact (hash-ref e 'y 9999.0)))
                                                         4.5)))))))
                u))
            (for ([u (in-list tw-shooters)])
              (define uid (hash-ref u 'id))
              (set-add! w3-rk uid)
              (unless (or (eqv? (hash-ref u 'order-target-tag 0) tid)
                          (eqv? (hash-ref u 'engaged-target-tag 0) tid))
                (l34-emit-preserved! ctx (list 'attack-unit uid tid)))))))
      ;; 2. Blocking Destructible Rock Breach (`nc-09` & strictly peaceful live path-blocker)
      ;; L59-P3b Fix #2B (`#1552`): Never steal Phase 5b army in live matches (`has-th-rk?`) when
      ;; any enemy combat/unit is visible; restrict live clear to directly adjacent (`<= 6.0t`)
      ;; true blocking rocks with `null? live-enemy-combat-rk` & `null? eu-rk` (full `18.0t` on 0-TH Arena `nc-09`).
      (when (and (pair? near-rocks)
                 (pair? cu-rk)
                 (or (not has-th-rk?)
                     (and (null? live-enemy-combat-rk)
                          (null? eu-rk)
                          (not (l34-ctx-under-tactics-base-attack? ctx))
                          (not (l34-ctx-enemy-within-14-of-th? ctx)))))
        (define rk-max-r (if has-th-rk? 6.0 18.0))
        (define best-rk
          (for/fold ([best #f] [bd 999.0] #:result best) ([rk (in-list near-rocks)])
            (define rx (exact->inexact (hash-ref rk 'x 0.0)))
            (define ry (exact->inexact (hash-ref rk 'y 0.0)))
            (define d (for/fold ([md 999.0]) ([u (in-list cu-rk)] #:when (rk-ground-shooter? u))
                        (flmin md (fast-dist2d rx ry
                                               (exact->inexact (hash-ref u 'x 9999.0))
                                               (exact->inexact (hash-ref u 'y 9999.0))))))
            (if (fl< d bd) (values rk d) (values best bd))))
        (when best-rk
          (define rid (hash-ref best-rk 'id (hash-ref best-rk 'tag 0)))
          (define rx (exact->inexact (hash-ref best-rk 'x 0.0)))
          (define ry (exact->inexact (hash-ref best-rk 'y 0.0)))
          (define enemy-combat-near-rk?
            (for/or ([e (in-list live-enemy-combat-rk)])
              (fl<= (fast-dist2d rx ry
                                 (exact->inexact (hash-ref e 'x 9999.0))
                                 (exact->inexact (hash-ref e 'y 9999.0)))
                    14.0)))
          (unless enemy-combat-near-rk?
            (define rk-clearers
              (for/list ([u (in-list cu-rk)]
                         #:when (and (rk-ground-shooter? u)
                                     (not (fast-unit-is-flying-sym? (unit-type-sym u)))
                                     (let ([ux (exact->inexact (hash-ref u 'x 9999.0))]
                                           [uy (exact->inexact (hash-ref u 'y 9999.0))])
                                       (and (fl<= (fast-dist2d ux uy rx ry) rk-max-r)
                                            (not (for/or ([e (in-list live-enemy-combat-rk)])
                                                   (fl<= (fast-dist2d ux uy
                                                                      (exact->inexact (hash-ref e 'x 9999.0))
                                                                      (exact->inexact (hash-ref e 'y 9999.0)))
                                                         14.0)))
                                            (not (for/or ([eb (in-list eb-rk)])
                                                   (and (hash? eb) (real? (hash-ref eb 'x #f)) (real? (hash-ref eb 'y #f))
                                                        (fl<= (fast-dist2d ux uy
                                                                           (exact->inexact (hash-ref eb 'x 9999.0))
                                                                           (exact->inexact (hash-ref eb 'y 9999.0)))
                                                              6.5))))))))
                u))
            (for ([u (in-list (take rk-clearers (min 12 (length rk-clearers))))])
              (define uid (hash-ref u 'id))
              (define ut (unit-type-sym u))
              (set-add! w3-rk uid)
              ;; L60 (`sc2-nc-09`): Pop Stimpack on healthy unstimmed Bio rock-clearers in isolated
              ;; Arena breach drills when Stim is researched, accelerating clear time under 20s!
              (when (and (not has-th-rk?)
                         (memq ut '(marine marauder))
                         (l34-has-upgrade? ctx 'stimpack)
                         (fl>= (exact->inexact (hash-ref u 'hp 0.0))
                               (exact->inexact SC2-MARINE-STIM-MIN-HP)))
                (let ([ub (hash-ref u 'buffs '())])
                  (when (and (not (memq 'stimpack ub))
                             (not (memq 'stimpack-marauder ub))
                             (not (memv 24 ub))
                             (not (memv 27 ub)))
                    (l34-emit-preserved! ctx (list 'cast-spell uid 'stimpack)))))
              (unless (or (eqv? (hash-ref u 'order-target-tag 0) rid)
                          (eqv? (hash-ref u 'engaged-target-tag 0) rid))
                (l34-emit-preserved! ctx (list 'attack-unit uid rid)))))))
      ;; 3. Post-Barrier-Clear Follow-Through (`nc-07`/`nc-08`/`nc-09` cleared gap crossing)
      (when (and (hash? dst-rk)
                 (null? eu-rk)
                 (null? eb-rk)
                 (<= fr-rk (hash-ref dst-rk 'l59-barrier-cleared-until -1)))
        (define gpt (hash-ref dst-rk 'l59-barrier-goal-pt #f))
        (when (and (pair? gpt) (real? (car gpt)) (real? (cdr gpt)))
          (define gx (exact->inexact (car gpt)))
          (define gy (exact->inexact (cdr gpt)))
          (define march-pool (if has-th-rk? cu-rk au-rk))
          (for ([u (in-list march-pool)]
                #:when (and (hash? u)
                            (real? (hash-ref u 'x #f))
                            (real? (hash-ref u 'y #f))))
            (define uid (hash-ref u 'id -1))
            (define ux (exact->inexact (hash-ref u 'x 9999.0)))
            (define uy (exact->inexact (hash-ref u 'y 9999.0)))
            (define d (fast-dist2d ux uy gx gy))
            (when (and (exact-integer? uid) (> uid 0)
                       (not (set-member? w3-rk uid))
                       (not (set-member? se-rk uid))
                       (fl> d 2.5)
                       (fl<= d 36.0))
              (set-add! w3-rk uid)
              (when (or (not rt-rk)
                        (refractory-allow-action?! (live-bot-runtime-cooldown-tracker rt-rk)
                                                   (list 'l59-barrier-cross uid)
                                                   fr-rk
                                                   16))
                (l34-emit-preserved! ctx (list 'attack-pos uid gx gy)))))))))
  ;; Loop 65 Gap C4 (`#1829`): Wire `compute-blind-uphill-retreat-pt` & `plan-high-ground-vision-actions`
  ;; cleanly into live combat positioning (runs even when high-ground attackers are hidden in Fog!).
  (when (and (l34-ctx-live-obs? ctx)
             (not endgame-hunt-active?)
             (pair? (l34-ctx-combat-units ctx))
             (l34-ctx-rt ctx))
    (define rt-uh (l34-ctx-rt ctx))
    (define fr-uh (l34-ctx-frame ctx))
    (define obs-uh (l34-ctx-obs ctx))
    (define sc-uh (l34-ctx-l34-sc ctx))
    (define ehp-ht (rt-prev-unit-ehp rt-uh))
    (define last-ehp-f (hash-ref ehp-ht -1 -1))
    (when (or (< fr-uh last-ehp-f) (> (- fr-uh last-ehp-f) 1200))
      (hash-clear! ehp-ht))
    (define prev-ehp-snap
      (for/hasheqv ([(k v) (in-hash ehp-ht)] #:when (> k 0))
        (values k v)))
    (define cu-uh (l34-ctx-combat-units ctx))
    (define au-uh (or (l34-ctx-ally-units ctx) '()))
    (define ab-uh (or (l34-ctx-ally-bldgs ctx) '()))
    (define eu-uh (or (l34-ctx-enemy-units ctx) '()))
    (define w3-uh (l34-ctx-wave3-handled-tags ctx))
    (define mw-uh (exact->inexact (max 64.0 (safe-finite-real (hash-ref obs-uh 'map-width 200.0) 200.0))))
    (define mh-uh (exact->inexact (max 64.0 (safe-finite-real (hash-ref obs-uh 'map-height 200.0) 200.0))))
    (define fbx-uh (exact->inexact (l34-ctx-base-x ctx)))
    (define fby-uh (exact->inexact (l34-ctx-base-y ctx)))
    (define fex-uh (exact->inexact (l34-ctx-enemy-x ctx)))
    (define fey-uh (exact->inexact (l34-ctx-enemy-y ctx)))
    (define uh-home-def? (l34-ctx-enemy-within-14-of-th? ctx))
    (define uh-muster? (and (hash? sc-uh) (hash-ref sc-uh 'l64-defensive-muster-active? #f)))
    ;; Detect visible uphill siege (`Sieged Tank`/`Burrowed Lurker` on higher z) OR blind ground damage
    (define our-z-uh (exact->inexact (l34-ctx-our-z-early ctx)))
    (define enemy-z-uh (exact->inexact (l34-ctx-enemy-z-early ctx)))
    (define vis-uh-sieges
      (for/list ([e (in-list eu-uh)]
                 #:when (and (hash? e)
                             (not (eq? (hash-ref e 'snapshot? #f) #t))
                             (eqv? (hash-ref e 'display-type 1) 1)
                             (real? (hash-ref e 'x #f)) (real? (hash-ref e 'y #f))
                             (let ([ez (hash-ref e 'z (hash-ref e 'pos-z #f))]
                                   [et (unit-type-sym e)])
                               (and (real? ez)
                                    (fl>= (fl- (exact->inexact ez) our-z-uh) 1.5)
                                    (memq et '(siege-tank-sieged lurker-burrowed lurker-mp-burrowed))))))
        e))
    (define vis-uh-siege (and (pair? vis-uh-sieges) (car vis-uh-sieges)))
    ;; Loop 65C/65D (`#1876`/`#1892` Gap C4): Gate strictly on actual elevation gap, require
    ;; `vis-uh-siege` within `<= 16.0t` of `u` (never match a Tank/Lurker across the map!),
    ;; AND skip retreat whenever ANY visible non-snapshot enemy combat unit is within `<= 18.0t` of `u`!
    (define explicit-uh-blind?
      (and (eq? (hash-ref obs-uh 'uphill-blind-fire? #f) #t)
           (fl>= (fl- enemy-z-uh our-z-uh) 1.5)))
    (define actual-uh-gap?
      (or (and vis-uh-siege #t)
          explicit-uh-blind?))
    (define blind-damaged-u
      (if (or uh-home-def? uh-muster? (not actual-uh-gap?))
          #f
          (for/fold ([first-dmg #f]) ([u (in-list cu-uh)])
            (define uid (and (hash? u) (hash-ref u 'id -1)))
            (if (and (exact-integer? uid) (> uid 0)
                     (not (set-member? w3-uh uid))
                     (not (memq 'stimpack (hash-ref u 'buffs '())))
                     (real? (hash-ref u 'x #f)) (real? (hash-ref u 'y #f))
                     (not (or (eq? (hash-ref u 'flying? #f) #t)
                              (eq? (hash-ref u 'flying #f) #t)
                              (eq? (hash-ref u 'is-flying #f) #t)
                              (fast-unit-is-flying-sym? (fast-canonical-unit-sym (unit-type-sym u))))))
                (let* ([cur-ehp (fl+ (exact->inexact (hash-ref u 'hp (hash-ref u 'health 0.0)))
                                     (exact->inexact (hash-ref u 'shields (hash-ref u 'shield 0.0))))]
                       [prev-ehp (hash-ref prev-ehp-snap uid #f)]
                       [took-dmg? (or (and (real? prev-ehp) (fl< cur-ehp (fl- (exact->inexact prev-ehp) 0.5)))
                                      (eq? (hash-ref obs-uh 'uphill-blind-fire? #f) #t))])
                  (if took-dmg?
                      (let* ([ux (exact->inexact (hash-ref u 'x fbx-uh))]
                             [uy (exact->inexact (hash-ref u 'y fby-uh))]
                             [near-uh-siege
                              (for/first ([e (in-list vis-uh-sieges)]
                                          #:when (fl<= (fast-dist2d ux uy
                                                                    (exact->inexact (hash-ref e 'x 9999.0))
                                                                    (exact->inexact (hash-ref e 'y 9999.0)))
                                                       16.0))
                                e)]
                             [vis-enemy-combat-near?
                              (for/or ([e (in-list eu-uh)])
                                (and (hash? e)
                                     (not (eq? (hash-ref e 'snapshot? #f) #t))
                                     (eqv? (hash-ref e 'display-type 1) 1)
                                     (combat-unit-record? e)
                                     (real? (hash-ref e 'x #f)) (real? (hash-ref e 'y #f))
                                     (fl<= (fast-dist2d ux uy
                                                        (exact->inexact (hash-ref e 'x 9999.0))
                                                        (exact->inexact (hash-ref e 'y 9999.0)))
                                           18.0)))])
                        (if (or vis-enemy-combat-near?
                                (and (not near-uh-siege) (not explicit-uh-blind?)))
                            first-dmg
                            (let* ([st (fast-unit-combat-stats (unit-type-sym u))]
                                   [wr (if (hash? st)
                                           (flmax (exact->inexact (or (hash-ref u 'ground-range #f)
                                                                      (hash-ref st 'ground-range 5.5)))
                                                  (exact->inexact (hash-ref st 'air-range 0.0)))
                                           5.5)]
                                   [proj-dx (fl- fex-uh ux)]
                                   [proj-dy (fl- fey-uh uy)]
                                   [proj-dn (flmax 1.0 (flsqrt (fl+ (fl* proj-dx proj-dx) (fl* proj-dy proj-dy))))]
                                   [tx-hint (if near-uh-siege
                                                (exact->inexact (hash-ref near-uh-siege 'x fex-uh))
                                                (fl+ ux (fl* 6.0 (fl/ proj-dx proj-dn))))]
                                   [ty-hint (if near-uh-siege
                                                (exact->inexact (hash-ref near-uh-siege 'y fey-uh))
                                                (fl+ uy (fl* 6.0 (fl/ proj-dy proj-dn))))]
                                   [uz-hint (if near-uh-siege
                                                (exact->inexact (hash-ref near-uh-siege 'z (hash-ref near-uh-siege 'pos-z enemy-z-uh)))
                                                (and (fl>= (fl- enemy-z-uh our-z-uh) 1.5) enemy-z-uh))])
                              (define-values (rx ry)
                                (compute-blind-uphill-retreat-pt
                                 #f u
                                 #:prev-hp prev-ehp
                                 #:under-fire? took-dmg?
                                 #:enemy-units eu-uh
                                 #:uphill-target-x tx-hint
                                 #:uphill-target-y ty-hint
                                 #:uphill-z uz-hint
                                 #:weapon-range wr
                                 #:map-width mw-uh
                                 #:map-height mh-uh))
                              (if (and rx ry)
                                  (begin
                                    (set-add! w3-uh uid)
                                    (l34-emit-preserved! ctx (list 'move uid (safe-coord rx ux) (safe-coord ry uy)))
                                    (or first-dmg u))
                                  first-dmg))))
                      first-dmg))
                first-dmg))))
    (define uh-pt-v
      (cond
        [vis-uh-siege
         (vector (exact->inexact (hash-ref vis-uh-siege 'x fex-uh))
                 (exact->inexact (hash-ref vis-uh-siege 'y fey-uh))
                 (exact->inexact (hash-ref vis-uh-siege 'z (hash-ref vis-uh-siege 'pos-z enemy-z-uh))))]
        [(and (eq? (hash-ref obs-uh 'uphill-blind-fire? #f) #t)
              (fl>= (fl- enemy-z-uh our-z-uh) 1.5)
              blind-damaged-u)
         (define bux (exact->inexact (hash-ref blind-damaged-u 'x fbx-uh)))
         (define buy (exact->inexact (hash-ref blind-damaged-u 'y fby-uh)))
         (define bdx (fl- fex-uh bux))
         (define bdy (fl- fey-uh buy))
