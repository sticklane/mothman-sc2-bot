       (or (l2-saving-for-expansion-now? ctx (length ccs))
           (and (> reserved-expansion-minerals 0) (< (l2-ctx-minerals ctx) reserved-expansion-minerals))
           terran-saving-for-orbital?))
  (set-l2-ctx-terran-saving-for-expand?! ctx terran-saving-for-expand?)
  (define cur-bunker-cnt
       (+ (count (lambda (b) (eq? (fast-canonical-structure-sym (unit-type-sym b)) 'bunker)) ally-bldgs)
          (order-ledger-pending-count-for-type oledger 'bunker frame)))
  (define unfinished-bunker-cnt
       (+ (count (lambda (b)
                   (and (hash? b)
                        (eq? (fast-canonical-structure-sym (unit-type-sym b)) 'bunker)
                        (< (hash-ref b 'build-progress 1.0) SC2-BUILD-COMPLETE-PROGRESS)))
                 ally-bldgs)
          (order-ledger-pending-count-for-type oledger 'bunker frame)))
  (define desired-bunker-cnt
       (if (and crisis-tech-upgrade-deferral?
                (or (>= live-army-supply 4)
                    (>= (l2-ctx-minerals ctx) 200)))
           2
           1))
  (when (and (or early-survival-crisis?
                    under-early-cheese?
                    under-base-attack?
                    forward-proxy-detected?
                    (>= live-enemy-threat-supply 6))
                (memq 'barracks (l2-ctx-bldg-types ctx))
                (< cur-bunker-cnt desired-bunker-cnt)
                (< unfinished-bunker-cnt 2)
                (= (order-ledger-pending-count-for-type oledger 'bunker frame) 0)
                (l2-save-cancel-rebuild-ready? ctx 'bunker 60)
                (>= (l2-ctx-minerals ctx) (sc2-min-cost 'bunker)))
       (define-values (bk-x bk-y)
         (cond
           [(<= (length ccs) 1)
            (values (safe-coord (+ base-x (* 0.25 (- nat-x base-x)) (if (> cur-bunker-cnt 0) 2.5 0.0)) base-x)
                    (safe-coord (+ base-y (* 0.25 (- nat-y base-y)) (if (> cur-bunker-cnt 0) -2.5 0.0)) base-y))]
           [(> cur-bunker-cnt 0)
            (l2-offset-defense-anchor ctx (safe-coord (+ nat-x 3.0) nat-x) (safe-coord (- nat-y 3.0) nat-y) 5.5)]
           [else
            (l2-offset-defense-anchor ctx nat-x nat-y 5.5)]))
       (l2-emit-build-verified! ctx 'bunker bk-x bk-y))
  (when (and (null? barracks-list)
                (or (not live-game-obs?) (memq 'supply-depot ready-bldg-types))
                (not (l2-building-present-or-pending? ctx 'barracks))
                (l2-save-cancel-rebuild-ready? ctx 'barracks 60)
                (>= (l2-ctx-minerals ctx) (sc2-min-cost 'barracks))
                (>= (- (l2-ctx-minerals ctx) (sc2-min-cost 'barracks)) hard-supply-lockout-reserve-min))
       (define wall-rax
         (and allow-exact-wall-slot?
              (not bypass-wall-depot1?)
              (<= (length ccs) 2)
              (hash-ref terran-ramp-wall 'barracks #f)))
       (define rx0 (if (pair? wall-rax) (safe-coord (car wall-rax) (+ base-x 4.0)) (safe-coord (+ base-x 4.0))))
       (define ry0 (if (pair? wall-rax) (safe-coord (cdr wall-rax) (+ base-y 4.0)) (safe-coord (+ base-y 4.0))))
       (l2-emit-build-verified! ctx 'barracks rx0 ry0 SC2-BUILD-SITE-MIN-CLEARANCE
                             #:exact-wall-slot? (and allow-exact-wall-slot? (not bypass-wall-depot1?) (<= (length ccs) 2) (pair? wall-rax))))
  (define terran-cannon-breakout-mode?
       (and live-game?
            in-base-proxy-completed-cannon?
            (< (l2-unit-count ctx 'siege-tank) 2)))
  (set-l2-ctx-terran-cannon-breakout-mode?! ctx terran-cannon-breakout-mode?)
  (define desired-refineries
       (if (and early-survival-crisis?
                (not terran-cannon-breakout-mode?)
                (null? active-refineries))
           0
           (min (* SC2-GEYSERS-PER-BASE (length ccs))
                (if live-game?
                    (cond
                      [(and (>= (length ccs) 4) (>= total-workers 62) (< (l2-ctx-gas ctx) 600)) 8]
                      [(and (>= (length ccs) 3) (>= total-workers 50) (< (l2-ctx-gas ctx) 450)) 6]
                      [(and (>= eff-phase-supply 56) (>= total-workers 42) (< (l2-ctx-gas ctx) 350)) 4]
                      [(and (>= eff-phase-supply 44) (>= total-workers 34) (< (l2-ctx-gas ctx) 300)) 3]
                      [(and (or (memq 'factory (l2-ctx-bldg-types ctx)) (>= eff-phase-supply 22))
                            (>= total-workers 21)
                            (< (l2-ctx-gas ctx) 250))
                       2]
                      [else 1])
                    (cond
                      [(>= supply-used 56) 4]
                      [(>= supply-used 44) 3]
                      [(or (memq 'factory (l2-ctx-bldg-types ctx)) (>= supply-used 22)) 2]
                      [else 1])))))
  (when (and (memq 'barracks (l2-ctx-bldg-types ctx))
                (or terran-cannon-breakout-mode? (not crisis-freeze-expand-or-gas?))
                (l2-save-cancel-rebuild-ready? ctx 'refinery 60)
                (or (null? active-refineries) (not terran-saving-for-expand?) terran-cannon-breakout-mode?)
                (< (+ (length active-refineries) (order-ledger-pending-count-for-type oledger 'refinery frame))
                   desired-refineries)
                (or (< (length active-refineries) 2)
                    (l2-starport-escrow-ok? ctx (sc2-min-cost 'refinery) 0))
                (or (not live-game?)
                    (< (length active-refineries) 2)
                    (< (l2-ctx-gas ctx) 150)
                    (>= (- (l2-ctx-minerals ctx) (sc2-min-cost 'refinery)) (l2-ctx-bo-reserved-min ctx)))
                (>= (l2-ctx-minerals ctx) (sc2-min-cost 'refinery))
                (or terran-cannon-breakout-mode? (l2-non-combat-min-ok? ctx (sc2-min-cost 'refinery))))
       (l2-emit-gas-build-verified! ctx 'refinery (safe-coord (+ base-x 3.0)) (safe-coord (+ base-y 5.0)))))

(define (l2-terran-phase2-tech-starport! ctx)
  (define active-refineries (l2-ctx-active-refineries ctx))
  (define ally-bldgs (l2-ctx-ally-bldgs ctx))
  (define ally-combat-units (l2-ctx-ally-combat-units ctx))
  (define barracks-list (l2-ctx-barracks-list ctx))
  (define base-x (l2-ctx-base-x ctx))
  (define base-y (l2-ctx-base-y ctx))
  (define ccs (l2-ctx-ccs ctx))
  (define cd-tracker (l2-ctx-cd-tracker ctx))
  (define claimed-addon-fac-ids (l2-ctx-claimed-addon-fac-ids ctx))
  (define crisis-tech-upgrade-deferral? (l2-ctx-crisis-tech-upgrade-deferral? ctx))
  (define early-survival-crisis? (l2-ctx-early-survival-crisis? ctx))
  (define eff-phase-supply (l2-ctx-eff-phase-supply ctx))
  (define effective-enemy-race (l2-ctx-effective-enemy-race ctx))
  (define endgame-corner-hunt? (l2-ctx-endgame-corner-hunt? ctx))
  (define enemy-units (l2-ctx-enemy-units ctx))
  (define factories-list (l2-ctx-factories-list ctx))
  (define frame (l2-ctx-frame ctx))
  (define live-army-supply (l2-ctx-live-army-supply ctx))
  (define live-enemy-threat-supply (l2-ctx-live-enemy-threat-supply ctx))
  (define live-game? (l2-ctx-live-obs-harvesters? ctx))
  (define nat-x (l2-ctx-nat-x ctx))
  (define nat-y (l2-ctx-nat-y ctx))
  (define oledger (l2-ctx-oledger ctx))
  (define open-prod-slots (l2-ctx-open-prod-slots ctx))
  (define pending-cc-count (l2-ctx-pending-cc-count ctx))
  (define ready-bldg-types (l2-ctx-ready-bldg-types ctx))
  (define reserved-expansion-minerals (l2-ctx-reserved-expansion-minerals ctx))
  (define rt (l2-ctx-rt ctx))
  (define tech-obs (l2-ctx-tech-obs ctx))
  (define terran-cannon-breakout-mode? (l2-ctx-terran-cannon-breakout-mode? ctx))
  (define terran-saving-for-expand? (l2-ctx-terran-saving-for-expand? ctx))
  (define terran-saving-for-orbital? (l2-ctx-terran-saving-for-orbital? ctx))
  (define total-bldg-counts (l2-ctx-total-bldg-counts ctx))
  (define total-workers (l2-ctx-total-workers ctx))
  (define under-base-attack? (l2-ctx-under-base-attack? ctx))
  (define under-early-cheese? (l2-ctx-under-early-cheese? ctx))
  (define urgent-combat-or-intel-need? (l2-ctx-urgent-combat-or-intel-need? ctx))
  (define known-heavy-race? (and (memq effective-enemy-race '(Protoss Zerg Terran)) #t))
  (define-values (enemy-capital-air? enemy-queen-count-t enemy-caster-nonqueen? enemy-heavy-mech-or-bio? addon-threat-enemies-rev)
    (for/fold ([cap-air? #f] [qcnt 0] [caster? #f] [heavy? #f] [threats-rev '()])
              ([e (in-list enemy-units)])
      (define ut (unit-type-sym e))
      (define cut (fast-canonical-unit-sym ut))
      (values
       (or cap-air? (and (memq cut THOR-CAPITAL-AIR-SYMS) #t))
       (if (eq? cut 'queen) (add1 qcnt) qcnt)
       (or caster?
           (and (memq cut '(infestor infestor-burrowed viper high-templar archon
                                     lurker lurker-burrowed brood-lord))
                #t))
       (or heavy?
           (and live-game?
                (not known-heavy-race?)
                (memq ut '(stalker immortal marauder roach ravager siege-tank siege-tank-sieged thor colossus ultralisk))
                #t))
       (if (and live-game? (combat-unit-record? e))
           (cons e threats-rev)
           threats-rev))))
  (set-l2-ctx-enemy-capital-air?! ctx enemy-capital-air?)
  (define enemy-caster-or-queen-swarm?
       (or (>= enemy-queen-count-t 4) enemy-caster-nonqueen?))
  (define cur-rax-techlab-cnt
       (+ (count (lambda (t) (memq t '(barracks-techlab tech-lab))) (l2-ctx-bldg-types ctx))
          (order-ledger-pending-count-for-type oledger 'barracks-techlab frame)))
  (define desired-rax-techlabs
       (if (and live-game?
                (or known-heavy-race? enemy-heavy-mech-or-bio?))
           (cond
             [(>= (length barracks-list) 5) 3]
             [(>= (length barracks-list) 3) 2]
             [else 1])
           1))
  (define has-rax-techlab?
       (or (>= cur-rax-techlab-cnt desired-rax-techlabs)
           (and (= desired-rax-techlabs 1)
                (l2-building-present-or-pending? ctx 'barracks-techlab #t))))
  (define addon-threat-enemies (reverse addon-threat-enemies-rev))
  (define (facility-safe-for-addon? fac)
       (or (not live-game?)
           (let ([fx (exact->inexact (hash-ref fac 'x base-x))]
                 [fy (exact->inexact (hash-ref fac 'y base-y))])
             (and (not (eq? (hash-ref fac 'under-attack #f) #t))
                  (not (for/or ([e (in-list addon-threat-enemies)])
                         (define dx (- fx (exact->inexact (hash-ref e 'x 9999.0))))
                         (define dy (- fy (exact->inexact (hash-ref e 'y 9999.0))))
                         (<= (+ (* dx dx) (* dy dy)) 100.0)))))))
  (define bare-rax-for-tl (l2-grounded-bare-facility ctx 'barracks))
  (define rax-tl-claimed? #f)
  (when (and bare-rax-for-tl
                (not terran-saving-for-expand?)
                (not has-rax-techlab?)
                (or (= cur-rax-techlab-cnt 0)
                    (l2-starport-escrow-ok? ctx (sc2-min-cost 'barracks-techlab) (sc2-gas-cost 'barracks-techlab)))
                (or (not live-game?)
                    (and (> (hash-ref open-prod-slots 'barracks 0) 0)
                         (or (not urgent-combat-or-intel-need?)
                             (not (null? ally-combat-units))
                             (> (hash-ref open-prod-slots 'barracks 0) 1))))
                (>= (l2-ctx-minerals ctx) (sc2-min-cost 'barracks-techlab))
                (>= (l2-ctx-gas ctx) (sc2-gas-cost 'barracks-techlab))
                (l2-non-combat-min-ok? ctx (sc2-min-cost 'barracks-techlab) 'barracks-techlab)
                (l2-non-combat-gas-ok? ctx (sc2-gas-cost 'barracks-techlab) 'barracks-techlab)
                (facility-safe-for-addon? bare-rax-for-tl)
                (or (not live-game?)
                    (refractory-allow-action?! (live-bot-runtime-cooldown-tracker rt)
                                               (list 'terran-addon-emit (hash-ref bare-rax-for-tl 'id 303) 'barracks-techlab)
                                               frame
                                               36)))
       (set! rax-tl-claimed? #t)
       (define rbx (safe-coord (+ (hash-ref bare-rax-for-tl 'x (+ base-x 4.0)) SC2-TERRAN-ADDON-OFFSET-X) (+ base-x 6.5)))
       (define rby (safe-coord (+ (hash-ref bare-rax-for-tl 'y (+ base-y 4.0)) SC2-TERRAN-ADDON-OFFSET-Y) (+ base-y 3.5)))
       (l2-recall-building-group! ctx 5)
       (l2-emit! ctx (list 'build 'barracks-techlab rbx rby))
       (set-add! claimed-addon-fac-ids (hash-ref bare-rax-for-tl 'id 303))
       (order-ledger-record-issued! oledger (hash-ref bare-rax-for-tl 'id 303) 'build 'barracks-techlab rbx rby frame)
       (set-l2-ctx-bldg-types! ctx (cons 'barracks-techlab (l2-ctx-bldg-types ctx)))
       (set! cur-rax-techlab-cnt (add1 cur-rax-techlab-cnt))
       (set! has-rax-techlab? (>= cur-rax-techlab-cnt desired-rax-techlabs))
       (when live-game?
         (hash-set! open-prod-slots 'barracks (max 0 (sub1 (hash-ref open-prod-slots 'barracks 0)))))
       (l2-spend-resources-and-supply! ctx (sc2-min-cost 'barracks-techlab) (sc2-gas-cost 'barracks-techlab) 0))
  (when (and (memq 'barracks-techlab ready-bldg-types)
                (not urgent-combat-or-intel-need?))
       (cond
         [(l2-upgrade-needed? ctx 'stimpack)
          (when (and (>= (l2-ctx-minerals ctx) (sc2-min-cost 'stimpack))
                     (>= (l2-ctx-gas ctx) (sc2-gas-cost 'stimpack)))
            (l2-emit-research-verified! ctx 'stimpack))]
         [(l2-upgrade-needed? ctx 'combat-shield)
          (when (and (l2-starport-escrow-ok? ctx (sc2-min-cost 'combat-shield) (sc2-gas-cost 'combat-shield))
                     (>= (l2-ctx-minerals ctx) (sc2-min-cost 'combat-shield))
                     (>= (l2-ctx-gas ctx) (sc2-gas-cost 'combat-shield)))
            (l2-emit-research-verified! ctx 'combat-shield))]
         [(and (l2-upgrade-needed? ctx 'concussive-shells)
               (l2-starport-escrow-ok? ctx (sc2-min-cost 'concussive-shells) (sc2-gas-cost 'concussive-shells))
               (or (not live-game?)
                   (and (>= (- (l2-ctx-minerals ctx) (sc2-min-cost 'concussive-shells)) (l2-ctx-bo-reserved-min ctx))
                        (l2-non-combat-min-ok? ctx (sc2-min-cost 'concussive-shells) 'concussive-shells)
                        (l2-non-combat-gas-ok? ctx (sc2-gas-cost 'concussive-shells) 'concussive-shells)))
               (>= (l2-ctx-minerals ctx) (sc2-min-cost 'concussive-shells))
               (>= (l2-ctx-gas ctx) (sc2-gas-cost 'concussive-shells)))
          (l2-emit-research-verified! ctx 'concussive-shells)]))
  (define desired-factories
       (cond
         [(not live-game?) 1]
         [(and (memq effective-enemy-race '(Terran Protoss))
               (>= (length ccs) 2)
               (>= eff-phase-supply 68)
               (>= (l2-ctx-gas ctx) 100))
          2]
         [(and (>= (length ccs) 3) (>= eff-phase-supply 106) (>= (l2-ctx-gas ctx) 200))
          2]
         [else 1]))
  (define rush-factory-vs-proxy-cannon?
       (and terran-cannon-breakout-mode?
            (null? factories-list)))
  (when (and (memq 'barracks ready-bldg-types)
                (or (not terran-saving-for-expand?) rush-factory-vs-proxy-cannon?)
                (l2-save-cancel-rebuild-ready? ctx 'factory 60)
                (< (+ (length factories-list) (order-ledger-pending-count-for-type oledger 'factory frame))
                   desired-factories)
                (or (null? factories-list)
                    (l2-can-spend-by-priority? ctx 'factory 'production-scaling)
                    (and (memq effective-enemy-race '(Terran Protoss))
                         (>= (length ccs) 2)
                         (>= eff-phase-supply 68)
                         (>= (l2-ctx-minerals ctx) (sc2-min-cost 'factory))
                         (>= (l2-ctx-gas ctx) (sc2-gas-cost 'factory)))
                    (>= (l2-ctx-minerals ctx) 400))
                (or rush-factory-vs-proxy-cannon?
                    (>= (- (l2-ctx-minerals ctx) reserved-expansion-minerals) (sc2-min-cost 'factory)))
                (>= (l2-ctx-minerals ctx) (sc2-min-cost 'factory))
                (>= (l2-ctx-gas ctx) (sc2-gas-cost 'factory))
                (or rush-factory-vs-proxy-cannon?
                    (and (l2-non-combat-min-ok? ctx (sc2-min-cost 'factory) 'factory)
                         (l2-non-combat-gas-ok? ctx (sc2-gas-cost 'factory) 'factory))))
       (define fac-idx (length factories-list))
       (l2-emit-build-verified! ctx 'factory
                             (safe-coord (+ base-x (* (add1 fac-idx) SC2-TERRAN-FACILITY-STEP-X)))
                             (safe-coord (+ base-y SC2-TERRAN-FACILITY-STEP-Y))))
  (define starports-list
       (filter (lambda (b)
                 (and (hash? b)
                      (eq? (fast-canonical-structure-sym (unit-type-sym b)) 'starport)))
               ally-bldgs))
  (define cur-sp-total
       (+ (length starports-list) (order-ledger-pending-count-for-type oledger 'starport frame)))
  (define desired-starports
       (cond
         [enemy-capital-air? (min 4 (max 2 (length ccs)))]
         [(and live-game? (>= (length ccs) 3) (>= (l2-ctx-minerals ctx) 600)) 2]
         [else 1]))
  (when (and (or (not terran-saving-for-expand?) endgame-corner-hunt? enemy-capital-air?)
                (memq 'factory ready-bldg-types)
                (< cur-sp-total desired-starports)
                (= (order-ledger-pending-count-for-type oledger 'starport frame) 0)
                (l2-save-cancel-rebuild-ready? ctx 'starport 60)
                (>= (l2-ctx-minerals ctx) (sc2-min-cost 'starport))
                (>= (l2-ctx-gas ctx) (sc2-gas-cost 'starport))
                (or endgame-corner-hunt?
                    enemy-capital-air?
                    (and (l2-non-combat-min-ok? ctx (sc2-min-cost 'starport) 'starport)
                         (l2-non-combat-gas-ok? ctx (sc2-gas-cost 'starport) 'starport))))
       (define sp-idx (length starports-list))
       (l2-emit-build-verified! ctx 'starport
                             (safe-coord (+ base-x (* (add1 (modulo sp-idx 2)) SC2-TERRAN-FACILITY-STEP-X)))
                             (safe-coord (+ base-y (* (+ 2.0 (quotient sp-idx 2)) SC2-TERRAN-FACILITY-STEP-Y)))))
  (define terran-ideal-worker-cap
       (l2-compute-race-ideal-worker-cap ctx ccs))
  (set-l2-ctx-terran-ideal-worker-cap! ctx terran-ideal-worker-cap)
  (define terran-worker-min-floor
       (if (and live-game?
                (>= (length ccs) 2)
                (< total-workers (* 18 (length ccs)))
                (< (l2-ctx-gas ctx) 200)
                (> (hash-ref open-prod-slots 'townhall 0) 0)
                (not under-base-attack?)
                (<= live-enemy-threat-supply 0)
                (not under-early-cheese?)
                (not terran-saving-for-orbital?))
           (sc2-min-cost 'scv)
           0))
  (define raw-desired-barracks
       (min SC2-MAX-PRODUCTION-FACILITIES
            (max 1 (if (>= (+ (length ccs) pending-cc-count) SC2-MIN-DESIRED-BASES)
                       (* SC2-TERRAN-FACILITIES-PER-BASE (max (length ccs) (+ (length ccs) pending-cc-count)))
                       (if (and (memq 'factory (l2-ctx-bldg-types ctx))
                                (or (not live-game?)
                                    (<= reserved-expansion-minerals 0)
                                    (>= (- (l2-ctx-minerals ctx) reserved-expansion-minerals) (sc2-min-cost 'barracks))))
                           2
                           1)))))
  (define desired-barracks
       (cond
         [(not live-game?) raw-desired-barracks]
         [(and (not (memq 'factory (l2-ctx-bldg-types ctx)))
               (not (and (< (length active-refineries) 1) (>= (l2-ctx-minerals ctx) 450))))
          (min 2 raw-desired-barracks)]
         [(and (not (memq 'starport (l2-ctx-bldg-types ctx)))
               (< (l2-ctx-minerals ctx) 500))
          (min 2 raw-desired-barracks)]
         [(< (l2-ctx-minerals ctx) 1000)
          (min 8 raw-desired-barracks)]
         [else raw-desired-barracks]))
  (define cur-rax-total
       (+ (length barracks-list) (order-ledger-pending-count-for-type oledger 'barracks frame)))
  (when (and (not terran-saving-for-expand?)
                (l2-save-cancel-rebuild-ready? ctx 'barracks 60)
                (l2-can-spend-by-priority? ctx 'barracks 'production-scaling)
                (>= (length barracks-list) 1)
                (or (< cur-rax-total 2)
                    (l2-starport-escrow-ok? ctx (sc2-min-cost 'barracks) 0))
                (or (not live-game?)
                    (< (length barracks-list) 2)
                    (< (hash-ref open-prod-slots 'barracks 0) 2)
                    (>= (l2-ctx-minerals ctx) 350))
                (< cur-rax-total desired-barracks)
                (or (memq 'factory (l2-ctx-bldg-types ctx))
                    (< (l2-ctx-gas ctx) (sc2-gas-cost 'factory))
                    (>= (l2-ctx-minerals ctx) SC2-SURPLUS-MINERAL-BANK-THRESHOLD))
                (>= (- (l2-ctx-minerals ctx) (+ reserved-expansion-minerals terran-worker-min-floor)) (sc2-min-cost 'barracks))
                (l2-non-combat-min-ok? ctx (sc2-min-cost 'barracks) 'barracks))
       (define rax-idx (length barracks-list))
       (l2-emit-build-verified! ctx 'barracks
                             (safe-coord (+ base-x 4.0 (* SC2-TERRAN-FACILITY-STEP-X (modulo rax-idx 2))))
                             (safe-coord (+ base-y 4.0 (* SC2-TERRAN-FACILITY-STEP-Y (quotient rax-idx 2))))))
  (define bare-rax-for-rx (if rax-tl-claimed? (l2-grounded-bare-facility ctx 'barracks) bare-rax-for-tl))
  (define cur-rax-reactor-cnt
       (+ (count (lambda (t) (memq t '(barracks-reactor reactor))) (l2-ctx-bldg-types ctx))
          (order-ledger-pending-count-for-type oledger 'barracks-reactor frame)))
  (when (and (not terran-saving-for-expand?)
                (>= (length barracks-list) 2)
                bare-rax-for-rx
                (l2-starport-escrow-ok? ctx (sc2-min-cost 'barracks-reactor) (sc2-gas-cost 'barracks-reactor))
                (if (and live-game? (memq 'factory (l2-ctx-bldg-types ctx)) (>= (length barracks-list) 3))
