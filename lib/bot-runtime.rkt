                      (l2-plan-wants-now? ctx 'zergling-attackspeed)
                      (>= (l2-unit-count ctx 'zergling) 6))
                  (l2-upgrade-needed? ctx 'zergling-attackspeed))
         (l2-emit-research-verified! ctx 'zergling-attackspeed))
       (when (memq 'ultralisk-cavern ready-bldg-types)
