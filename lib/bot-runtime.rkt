  (define sum-eu-x (l34-ctx-sum-eu-x ctx))
  (define sum-eu-y (l34-ctx-sum-eu-y ctx))
  (define tbrain-committed-tags (l34-ctx-tbrain-committed-tags ctx))
  (define third-x (l34-ctx-third-x ctx))
  (define third-y (l34-ctx-third-y ctx))
  (define wave3-handled-tags (l34-ctx-wave3-handled-tags ctx))
  (define wave3-preserved-set (l34-ctx-wave3-preserved-set ctx))
  ;; ---------------------------------------------------------------------------
  ;; Pro Mechanic #8: Burrowed Zergling Base-Blocker, Cheap Patrol Expansion
  ;;                  Blocker, Peripheral Economic Harassment Raider Squad, &
  ;;                  Probing-Attack Recon Vanguard (PV9)
  ;; ---------------------------------------------------------------------------
  (define cur-tel-ht
    (let ([t (live-bot-runtime-last-telemetry rt)])
      (if (hash? t) t (hash))))
  (define cur-intel-staleness
    (hash-ref cur-tel-ht 'intel-staleness-frames
              (if (and (null? enemy-units) (null? enemy-bldgs)) frame 0)))
  (define mm-verdict
    (mirror-mind-state-mirror-macro-verdict (live-bot-runtime-mirror-mind rt)))
  (define maybe-harass-raid?
    (if live-obs?
        (or (hash-ref obs 'enable-economic-disruption #f)
            (and bo-fork-active?
                 (refractory-ready? (live-bot-runtime-cooldown-tracker rt)
                                    '(live-harass-raid)
                                    frame
                                    336))
            (and (>= live-combat-supply 1)
                 (refractory-ready? (live-bot-runtime-cooldown-tracker rt)
                                    '(live-harass-raid-dedicated)
                                    frame
                                    196))
            (and (>= live-combat-supply 18)
                 (refractory-ready? (live-bot-runtime-cooldown-tracker rt)
                                    '(live-harass-raid)
                                    frame
                                    280)))
        (or (hash-ref obs 'enable-economic-disruption #f)
            bo-fork-active?
            (and (>= cur-intel-staleness 224)
                 (>= (length combat-units) 4))
            (and (eq? mm-verdict 'punish-And-Deny-Greedy-Expand)
                 (>= (length combat-units) (min 6 live-attack-wave-min)))
            (and (null? enemy-units)
                 (>= (length combat-units) (min 6 live-attack-wave-min))))))
  (define cheap-blockers
    (if maybe-harass-raid?
        (filter (lambda (u)
                  (and (memq (unit-type-sym u) '(zergling marine zealot reaper adept hellion oracle phoenix mutalisk banshee))
                       (not (set-member? tbrain-committed-tags (hash-ref u 'id -1)))
                       (not (set-member? wave3-handled-tags (hash-ref u 'id -1)))))
                combat-units)
        '()))
  (define dedicated-harass-units
    (if maybe-harass-raid?
        (filter (lambda (u)
                  (and (memq (unit-type-sym u) '(reaper oracle banshee adept hellion phoenix mutalisk))
                       (not (set-member? wave3-handled-tags (hash-ref u 'id -1)))))
                combat-units)
        '()))
  (define allow-harass-raid?
    (and maybe-harass-raid?
         (not (l34-ctx-under-tactics-base-attack? ctx))
         (if live-obs?
             (or (and (not combat-suppress-attack?)
                      (hash-ref obs 'enable-economic-disruption #f))
                 (and (not combat-suppress-attack?)
                      bo-fork-active?
                      (>= (length cheap-blockers) 2)
                      (refractory-allow-action?! (live-bot-runtime-cooldown-tracker rt)
                                                 '(live-harass-raid)
                                                 frame
                                                 336))
                 (and (pair? dedicated-harass-units)
                      (refractory-allow-action?! (live-bot-runtime-cooldown-tracker rt)
                                                 '(live-harass-raid-dedicated)
                                                 frame
                                                 196))
                 (and (not combat-suppress-attack?)
                      (>= live-combat-supply 18)
                      (>= (length cheap-blockers) 3)
                      (refractory-allow-action?! (live-bot-runtime-cooldown-tracker rt)
                                                 '(live-harass-raid)
                                                 frame
                                                 280)))
             (and (not combat-suppress-attack?)
                  (or (hash-ref obs 'enable-economic-disruption #f)
                      (and bo-fork-active? (>= (length cheap-blockers) 2))
                      (>= cur-intel-staleness 224)
                      (eq? mm-verdict 'punish-And-Deny-Greedy-Expand)
                      (>= (length cheap-blockers) 3))))))
  (when (and allow-harass-raid?
             (or (pair? cheap-blockers)
                 (and live-obs? (pair? dedicated-harass-units))))
    (define hx (if bo-fork-active? bo-sx enemy-x))
    (define hy (if bo-fork-active? bo-sy enemy-y))
    (cond
      [(and live-obs? (pair? dedicated-harass-units))
       (define ded-ids
         (map (lambda (u) (hash-ref u 'id 111))
              (take dedicated-harass-units (min 3 (length dedicated-harass-units)))))
       (l34-emit! ctx (list 'harass-workers ded-ids hx hy))]
      [else
       (define blocker (car cheap-blockers))
       (define bid (hash-ref blocker 'id 110))
       (if (eq? (unit-type-sym blocker) 'zergling)
           (l34-emit! ctx (list 'burrow-block bid enemy-exp-x enemy-exp-y))
           (l34-emit! ctx (list 'patrol-block-expansion bid enemy-exp-x enemy-exp-y)))
       (when (>= (length cheap-blockers) 2)
         (define raider-ids
           (map (lambda (u) (hash-ref u 'id 111))
                (take (cdr cheap-blockers) (min 3 (length (cdr cheap-blockers))))))
         (l34-emit! ctx (list 'harass-workers raider-ids hx hy)))]))

  (when (and bo-rally-override?
             (null? enemy-units)
             (or (not live-obs?) (null? enemy-bldgs))
             (pair? combat-units)
             (or (not live-obs?)
                 (refractory-allow-action?! (live-bot-runtime-cooldown-tracker rt)
                                            '(bo-timing-rally)
                                            frame
                                            28)))
    (define bo-march-units
      (for/list ([u (in-list combat-units)]
                 #:when (let* ([uid (hash-ref u 'id -1)]
                               [ut (unit-type-sym u)]
                               [ux (exact->inexact (hash-ref u 'x base-x))]
                               [uy (exact->inexact (hash-ref u 'y base-y))]
                               [dx (- ux fbo-rally-tx)]
                               [dy (- uy fbo-rally-ty)])
                          (and (not (set-member? wave3-handled-tags uid))
                               (not (set-member? splash-evading-tags uid))
                               (not (set-member? disruptor-handled-tags uid))
                               (not (set-member? tbrain-committed-tags uid))
                               (not (memq ut '(overlord overseer observer warp-prism warp-prism-phasing medivac queen)))
                               (> (+ (* dx dx) (* dy dy)) 36.0))))
        u))
    (when (pair? bo-march-units)
      (if (<= (length bo-march-units) 8)
          (for ([u (in-list bo-march-units)])
            (l34-emit! ctx (list 'attack-pos (hash-ref u 'id 110) bo-rally-tx bo-rally-ty)))
          (l34-emit! ctx (list 'attack-pos
                       (map (lambda (u) (hash-ref u 'id 110)) bo-march-units)
                       bo-rally-tx
                       bo-rally-ty)))))

  (when (and (null? enemy-units)
             (not bo-rally-override?)
             (not combat-suppress-attack?)
             (or (not live-obs?)
                 (and (null? enemy-bldgs)
                      (< (length combat-units) live-attack-wave-min)
                      (refractory-ready? (live-bot-runtime-cooldown-tracker rt)
                                         '(idle-nat-rally)
                                         frame
                                         44))))
    (define idle-rally-candidates
      (filter (lambda (u) (not (set-member? wave3-handled-tags (hash-ref u 'id -1))))
              combat-units))
    (when (and (>= (length idle-rally-candidates) 2)
               (or (not live-obs?)
                   (refractory-allow-action?! (live-bot-runtime-cooldown-tracker rt)
                                              '(idle-nat-rally)
                                              frame
                                              44)))
      (for ([u (in-list (take idle-rally-candidates 2))])
        (l34-emit! ctx (list 'attack-pos (hash-ref u 'id 110) nat-x nat-y)))))

  ;; ---------------------------------------------------------------------------
  ;; Pro Mechanic #9: Enemy Changeling Sniping & Active Deception/Scout Spells
  ;; ---------------------------------------------------------------------------
  (for ([ec (in-list enemy-changelings)])
    (l34-emit! ctx (list 'snipe-enemy-changeling (hash-ref ec 'id 9099))))

  (when has-ally-roach?
    (for ([ba (in-list (execute-roach-tunneling-burrow-micro obs))])
      (l34-emit! ctx ba)))
  (when (not (null? ally-infestors))
    (for ([ia (in-list (execute-infestor-burrow-cast-micro obs))])
      (unless (and live-obs?
                   (pair? ia)
                   (>= (length ia) 2)
                   (set-member? wave3-handled-tags (second ia)))
        (l34-emit! ctx ia))))
  (define has-ripple-or-shimmer?
    (or enemy-unit-shimmer?
        (let ([rs (hash-ref obs 'shimmer-and-burrow-ripples #f)])
          (and (list? rs) (pair? rs)))))
  (when has-ripple-or-shimmer?
    (define shimmer-acts (execute-shimmer-and-burrow-ripple-response obs))
    (define resolved-shimmer-acts
      (if (pair? shimmer-acts)
          shimmer-acts
          (let ([synth-ripples
                 (for/list ([e (in-list enemy-units)]
                            #:when (and (hash? e)
                                        (or (hash-ref e 'is-shimmer? #f)
                                            (hash-ref e 'cloaked #f)
                                            (hash-ref e 'is-cloaked? #f)
                                            (hash-ref e 'burrowed #f)
                                            (hash-ref e 'is-burrowed? #f)
                                            (memq (hash-ref e 'display-type 1) '(2 hidden))
                                            (memq (hash-ref e 'cloak-state 0) '(2 cloaked cloaked-detected))
                                            (memq (hash-ref e 'cloak 0) '(1 2 cloaked cloaked-detected))
                                            (memq (unit-type-sym e)
                                                  '(lurker-burrowed roach-burrowed infestor-burrowed swarm-host-burrowed
                                                    widow-mine-burrowed baneling-burrowed ultralisk-burrowed
                                                    hydralisk-burrowed zergling-burrowed queen-burrowed drone-burrowed)))))
                   (hash 'x (safe-coord (hash-ref e 'x enemy-x) enemy-x)
                         'y (safe-coord (hash-ref e 'y enemy-y) enemy-y)
                         'indicator-kind (if (or (hash-ref e 'burrowed #f) (hash-ref e 'is-burrowed? #f))
                                             'burrow-ripple
                                             'cloaked-shimmer)))])
            (if (pair? synth-ripples)
                (execute-shimmer-and-burrow-ripple-response
                 (hash-set obs 'shimmer-and-burrow-ripples synth-ripples))
                '()))))
    (for ([sa (in-list resolved-shimmer-acts)])
      (l34-emit! ctx sa)))

  (when (and (or (hash-ref obs 'enable-deception-and-buffs #f)
                 (not (null? ally-sentries))
                 (not (null? ally-overseers)))
             (or (not live-obs?)
                 (refractory-allow-action?! (live-bot-runtime-cooldown-tracker rt)
                                            '(deception-scout-spells)
                                            frame
                                            336)))
    (l34-emit! ctx '(cast-deception-and-scout-spells
             sentry-hallucination-phoenix-scout
             sentry-hallucination-archon-tank
             overseer-spawn-changeling)))

  ;; ---------------------------------------------------------------------------
  ;; Pro Mechanic #10: Protective Buff Aura, Throttled Pre-Split 3-Wing Squads,
  ;;                   Throttled Concave Arc, & High-Ground Mastery
  ;; ---------------------------------------------------------------------------
  (define army-cx prelim-army-cx)
  (define army-cy prelim-army-cy)
  (define use-eb-for-target? (and live-obs? (null? enemy-units)))
  (define visible-enemies-for-target
    (if use-eb-for-target? enemy-bldgs enemy-units))
  (define target-ex
    (if (null? visible-enemies-for-target)
        (if bo-rally-override? bo-rally-tx enemy-x)
        (safe-coord (/ (if use-eb-for-target? sum-eb-x sum-eu-x)
                       (max 1 (length visible-enemies-for-target)))
                    enemy-x)))
  (define target-ey
    (if (null? visible-enemies-for-target)
        (if bo-rally-override? bo-rally-ty enemy-y)
        (safe-coord (/ (if use-eb-for-target? sum-eb-y sum-eu-y)
                       (max 1 (length visible-enemies-for-target)))
                    enemy-y)))

  (when (and (or (hash-ref obs 'enable-deception-and-buffs #f)
                 (not (null? ally-sentries))
                 (not (null? ally-infestors))
                 (and (not (null? enemy-units)) (not (null? combat-units))))
             (or (not live-obs?)
                 (refractory-allow-action?! (live-bot-runtime-cooldown-tracker rt)
                                            '(buff-aura-position)
                                            frame
                                            44)))
    (define use-shroud?
      (or (not (null? ally-infestors))
          (eq? (live-bot-runtime-actual-race rt) 'Zerg)))
    (define aura-type (if use-shroud? 'microbial-shroud 'guardian-shield))
    (define aura-radius (if use-shroud? 3.5 4.5))
    (l34-emit! ctx (list 'cast-protective-buff-aura aura-type army-cx army-cy aura-radius))
    (l34-emit! ctx (list 'position-in-buff-aura-with-splash-spread
                 aura-type army-cx army-cy aura-radius 1.6 #t)))

  ;; Pre-Split 3-Wing Formation & Concave Arc Formation (throttled in live games to stay well below 400 APM)
  (when (and (or (not (null? enemy-units))
                 (and bo-rally-override?
                      (pair? combat-units)
                      (memq 'pre-split-vs-emp bo-micro-dirs))
                 (hash-ref obs 'pre-split-engage #f)
                 (hash-ref obs 'form-concave #f))
             (or (not live-obs?)
                 (refractory-allow-action?! (live-bot-runtime-cooldown-tracker rt)
                                            '(formation-arc-split)
                                            frame
                                            28)))
    (define dx (- target-ex army-cx))
    (define dy (- target-ey army-cy))
    (define d (max 1.0 (sqrt (+ (* dx dx) (* dy dy)))))
    (define nx (/ (- dy) d))
    (define ny (/ dx d))
    (define wing-spread 6.0)
    (define mid-x (safe-coord (+ army-cx (* 0.5 dx)) army-cx))
    (define mid-y (safe-coord (+ army-cy (* 0.5 dy)) army-cy))
    (define left-x (safe-coord (+ mid-x (* wing-spread nx)) mid-x))
    (define left-y (safe-coord (+ mid-y (* wing-spread ny)) mid-y))
    (define right-x (safe-coord (- mid-x (* wing-spread nx)) mid-x))
    (define right-y (safe-coord (- mid-y (* wing-spread ny)) mid-y))
    (l34-emit! ctx (list 'pre-split-wings left-x left-y mid-x mid-y right-x right-y))
    (l34-emit! ctx (list 'form-concave-arc target-ex target-ey 10 120)))

  ;; High-Ground Terrain & Vision Mastery
  (define our-z our-z-early)
  (define enemy-z enemy-z-early)
  (when (and (or (not (= our-z enemy-z))
                 (not (null? enemy-units))
                 (hash-ref obs 'high-ground-check #f))
             (or (not live-obs?)
                 (refractory-allow-action?! (live-bot-runtime-cooldown-tracker rt)
                                            '(high-ground-posture)
                                            frame
                                            28)))
    (define has-spotter? (or (not live-obs?) has-non-overlord-spotter?))
    (cond
      [(> our-z enemy-z)
       (l34-emit! ctx (list 'high-ground-tactics 'hold-high-ground-ramp-arc nat-x nat-y #f))]
      [(> enemy-z our-z)
       (l34-emit! ctx (list 'high-ground-tactics 'uphill-vision-spotter-and-concave target-ex target-ey has-spotter?))]
      [else
       (l34-emit! ctx (list 'high-ground-tactics 'contest-high-ground-control nat-x nat-y #f))]))

  ;; Spatio-Temporal Enemy Army Reachability & Counter-Positioning / Backstab / Surround Maneuver
  (define mm-rt (live-bot-runtime-mirror-mind rt))
  (define mm-tech (mirror-mind-state-last-tech-observation mm-rt))
  (define mm-shadow (mirror-mind-state-last-shadow-ledger mm-rt))
  (define door-st-reach (rt-door-state rt))
  (define reach-cache (hash-ref door-st-reach 'reach-m-cache #f))
  (define n-ally-reach (length ally-units))
  (define n-enemy-reach (length enemy-units))
  (define reach-heavy-ttl? (and live-obs? (> frame 120) (>= (+ n-ally-reach n-enemy-reach) 30)))
  (define reach-ttl (if (= (modulo frame 16) 8) 15 11))
  (define reach-m
    (if (and reach-cache
             (= base-x (vector-ref reach-cache 4))
             (= base-y (vector-ref reach-cache 5))
             (= nat-x (vector-ref reach-cache 6))
             (= nat-y (vector-ref reach-cache 7))
             (= enemy-exp-x (vector-ref reach-cache 8))
             (= enemy-exp-y (vector-ref reach-cache 9))
             (if reach-heavy-ttl?
                 (and (>= frame (vector-ref reach-cache 11))
                      (< (- frame (vector-ref reach-cache 11)) reach-ttl)
                      (= n-ally-reach (vector-ref reach-cache 12))
                      (= n-enemy-reach (vector-ref reach-cache 13)))
                 (and (eq? ally-units (vector-ref reach-cache 0))
                      (eq? enemy-units (vector-ref reach-cache 1))
                      (eq? mm-tech (vector-ref reach-cache 2))
                      (eq? mm-shadow (vector-ref reach-cache 3)))))
        (vector-ref reach-cache 10)
        (let ([m (evaluate-enemy-army-spatio-temporal-reachability
                  frame
                  ally-units
                  enemy-units
                  mm-tech
                  mm-shadow
                  #:our-base-x base-x #:our-base-y base-y
                  #:our-nat-x nat-x #:our-nat-y nat-y
                  #:enemy-exp-x enemy-exp-x
                  #:enemy-exp-y enemy-exp-y)])
          (hash-set! door-st-reach 'reach-m-cache
                     (vector ally-units enemy-units mm-tech mm-shadow
                             base-x base-y nat-x nat-y enemy-exp-x enemy-exp-y m
                             frame n-ally-reach n-enemy-reach))
          m)))
  (set-mirror-mind-state-last-reachability-model! mm-rt reach-m)
  (define raw-sp-maneuver
    (enemy-army-reachability-model-recommended-spatial-maneuver reach-m))
  (define enemy-main-cleared-or-empty?
    (and (null? enemy-units)
         (or (null? enemy-bldgs)
             (not (ormap (lambda (eb)
                           (<= (dist2d (safe-finite-real (hash-ref eb 'x enemy-x) enemy-x)
                                       (safe-finite-real (hash-ref eb 'y enemy-y) enemy-y)
                                       enemy-x enemy-y)
                               16.0))
                         enemy-bldgs)))))
  (define sp-maneuver
    (if (and (eq? raw-sp-maneuver 'pre-rotate-intercept-incoming-threat)
             enemy-main-cleared-or-empty?
             (<= (hash-ref obs 'enemy-threat-supply 0) 0))
        'multiprong-rotate-and-pin
        raw-sp-maneuver))
  (define-values (sp-tx sp-ty)
    (if (and live-obs?
             (or eff-wave-commit?
                 bo-rally-override?
                 (>= (length combat-units) live-attack-wave-min)
                 (and (>= frame 6000) enemy-main-cleared-or-empty? (>= (length combat-units) 4))))
        (case sp-maneuver
          [(pre-rotate-intercept-incoming-threat)
           (values nat-x nat-y)]
          [(backstab-undefended-enemy-expansion)
           (cond
             [bo-fork-active? (values bo-sx bo-sy)]
             [bo-rally-override? (values bo-rally-tx bo-rally-ty)]
             [(null? visible-enemies-for-target) (values enemy-exp-x enemy-exp-y)]
             [else (values target-ex target-ey)])]
          [else
           (if bo-rally-override?
               (values bo-rally-tx bo-rally-ty)
               (values target-ex target-ey))])
        (case sp-maneuver
          [(backstab-undefended-enemy-expansion)
           (cond
             [bo-fork-active? (values bo-sx bo-sy)]
             [bo-rally-override? (values bo-rally-tx bo-rally-ty)]
             [else (values enemy-exp-x enemy-exp-y)])]
          [(surround-and-crush-isolated-enemy-cluster)
           (if bo-rally-override?
               (values bo-rally-tx bo-rally-ty)
               (values target-ex target-ey))]
          [(pre-rotate-intercept-incoming-threat)
           (values nat-x nat-y)]
          [(safe-to-expand-enemy-pinned-far)
           (values third-x third-y)]
          [else
           (if bo-rally-override?
               (values bo-rally-tx bo-rally-ty)
               (values target-ex target-ey))])))
  (when (or (not live-obs?)
            (refractory-allow-action?! (live-bot-runtime-cooldown-tracker rt)
                                       '(spatial-maneuver)
                                       frame
                                       28))
    (l34-emit! ctx (list 'execute-spatial-maneuver sp-maneuver sp-tx sp-ty)))

  (hash-set! splash-st 'wave3-preserved-frame frame)
  (hash-set! splash-st 'wave3-preserved-set wave3-preserved-set)

)

