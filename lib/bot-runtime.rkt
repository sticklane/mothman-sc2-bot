(define (fast-structure-equivalent-syms bldg-sym [include-free-addons? #f])
  (define tbl (if include-free-addons? EQUIV-SYMS-ADDONS-CACHE EQUIV-SYMS-NO-ADDONS-CACHE))
  (or (hash-ref tbl bldg-sym #f)
      (let ([v (remove-duplicates (sc2-structure-equivalent-syms bldg-sym include-free-addons?) eq?)])
        (hash-set! tbl bldg-sym v)
        v)))

