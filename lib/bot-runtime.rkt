  (define ally-bldg-acc 0)
  (define armory-ready-bldgs? #f)
  (define live-owned-townhalls 0)
  (define has-ally-wall-block-bldg? #f)
  (for ([b (in-list ally-bldgs)])
    (define bt (unit-type-sym b))
    (define bf (fast-ally-bldg-flags bt))
    (set! ally-bldg-acc (bitwise-ior ally-bldg-acc bf))
    (when (bitwise-bit-set? bf 2)
      (set! live-owned-townhalls (add1 live-owned-townhalls)))
    (when (and (not armory-ready-bldgs?)
               (bitwise-bit-set? bf 1)
               (hash? b)
               (>= (hash-ref b 'build-progress 1.0) 1.0))
      (set! armory-ready-bldgs? #t))
    (when (and (not has-ally-wall-block-bldg?)
               (bitwise-bit-set? bf 4)
               (hash? b)
               (< (hash-ref b 'build-progress 1.0) SC2-BUILD-COMPLETE-PROGRESS))
      (set! has-ally-wall-block-bldg? #t)))
  (define ally-bldg-det? (bitwise-bit-set? ally-bldg-acc 0))
  (when (bitwise-bit-set? ally-bldg-acc 3)
    (set! has-ally-queen-or-tumor? #t))
  (define has-ally-lowered-depot? (bitwise-bit-set? ally-bldg-acc 5))
  (when (bitwise-bit-set? ally-bldg-acc 6)
    (set! has-ally-static-def-or-nydus? #t))
  (when (bitwise-bit-set? ally-bldg-acc 7)
    (set! has-ally-map-elem-or-recall? #t))
  (define ally-has-detector? (or ally-unit-det? ally-bldg-det?))

  (define bx-fl (exact->inexact base-x))
  (define by-fl (exact->inexact base-y))
  (define nx-fl (exact->inexact nat-x))
  (define ny-fl (exact->inexact nat-y))
  (define enemy-near-home? #f)
  (define enemy-acc-mask 0)
  (define enemy-disruptor-units-rev '())
  (define enemy-widow-mines-rev '())
  (define enemy-banelings-rev '())
  (define linear-splash-enemies-rev '())
  (define enemy-stasis-eu-rev '())
  (define immobile-bile-eu-rev '())
  (define enemy-sieged-tanks-near-rev '())
  (define tank-lurker-hazards-rev '())
  (define enemy-air-or-colossus-rev '())
  (define enemy-massive-air-or-colossus-rev '())
  (define enemy-mutalisks-rev '())
  (define enemy-changelings-rev '())
  (define creep-enemy-slice-rev '())
  (define has-creep-queens? (pair? creep-queen-xs))
  (define visible-enemy-combat-supply 0.0)
  (define local-enemy-unit-val 0)
  (define enemy-unit-shimmer? #f)
  (define sum-eu-x 0.0)
  (define sum-eu-y 0.0)
  (for ([e (in-list enemy-units)])
    (define et (unit-type-sym e))
    (define einfo (fast-enemy-u-info et))
    (define ef (vector-ref einfo 0))
    (set! enemy-acc-mask (bitwise-ior enemy-acc-mask ef))
    (define ex-raw (hash-ref e 'x #f))
    (define ey-raw (hash-ref e 'y #f))
    (define fex-opt
      (cond
        [(flonum? ex-raw) (and (fl= (fl- ex-raw ex-raw) 0.0) ex-raw)]
        [(exact-integer? ex-raw) (->fl ex-raw)]
        [(and (real? ex-raw) (= (- ex-raw ex-raw) 0)) (exact->inexact ex-raw)]
        [else #f]))
    (define fey-opt
      (cond
        [(flonum? ey-raw) (and (fl= (fl- ey-raw ey-raw) 0.0) ey-raw)]
        [(exact-integer? ey-raw) (->fl ey-raw)]
        [(and (real? ey-raw) (= (- ey-raw ey-raw) 0)) (exact->inexact ey-raw)]
        [else #f]))
    (define coords-ok? (and fex-opt fey-opt))
    (define fex (or fex-opt 9999.0))
    (define fey (or fey-opt 9999.0))
    (define d2
      (if coords-ok?
          (let ([dx (fl- fprelim-cx fex)]
                [dy (fl- fprelim-cy fey)])
            (fl+ (fl* dx dx) (fl* dy dy)))
          (let ([d (dist2d prelim-army-cx prelim-army-cy
                           (or ex-raw 9999.0) (or ey-raw 9999.0))])
            (define fd (if (flonum? d) d (exact->inexact d)))
            (fl* fd fd))))
    (unless enemy-near-home?
      (let ([dx1 (fl- fex bx-fl)] [dy1 (fl- fey by-fl)]
            [dx2 (fl- fex nx-fl)] [dy2 (fl- fey ny-fl)])
        (when (or (fl<= (fl+ (fl* dx1 dx1) (fl* dy1 dy1)) 256.0)
                  (fl<= (fl+ (fl* dx2 dx2) (fl* dy2 dy2)) 256.0))
          (set! enemy-near-home? #t))))
    (define check-burrow? (and (not (zero? (bitwise-and ef #x3FFF)))
                               (not (zero? (bitwise-and ef #x90)))))
    (define e-burrowed?
      (and (or check-burrow? (not enemy-unit-shimmer?))
           (or (hash-ref e 'burrowed #f)
               (hash-ref e 'burrowed? #f)
               (hash-ref e 'is-burrowed? #f))))
    (unless (zero? (bitwise-and ef #x3FFF))
      (when (bitwise-bit-set? ef 0)
        (set! enemy-disruptor-units-rev (cons e enemy-disruptor-units-rev)))
      (when (bitwise-bit-set? ef 1)
        (set! enemy-widow-mines-rev (cons e enemy-widow-mines-rev)))
      (when (bitwise-bit-set? ef 2)
        (set! enemy-banelings-rev (cons e enemy-banelings-rev)))
      (when (or (bitwise-bit-set? ef 3)
                (and (bitwise-bit-set? ef 4) e-burrowed?))
        (set! linear-splash-enemies-rev (cons e linear-splash-enemies-rev)))
      (when (or (bitwise-bit-set? ef 5)
                (and (bitwise-bit-set? ef 6)
                     (or (hash-ref e 'sieged #f) (hash-ref e 'is-sieged? #f)))
                (and (or (bitwise-bit-set? ef 4) (bitwise-bit-set? ef 7))
                     (or e-burrowed?
                         (hash-ref e 'burrow-intent? #f)
                         (hash-ref e 'burrow-intent #f)
                         (hash-ref e 'burrowing? #f)
                         (hash-ref e 'is-burrowing? #f)
                         (hash-ref e 'preparing-burrow? #f))))
        (set! tank-lurker-hazards-rev (cons e tank-lurker-hazards-rev)))
      (when (bitwise-bit-set? ef 8)
        (set! enemy-stasis-eu-rev (cons e enemy-stasis-eu-rev)))
      (when (bitwise-bit-set? ef 9)
        (set! immobile-bile-eu-rev (cons e immobile-bile-eu-rev)))
      (when (and (bitwise-bit-set? ef 10) (fl<= d2 306.25))
        (set! enemy-sieged-tanks-near-rev (cons e enemy-sieged-tanks-near-rev)))
      (when (bitwise-bit-set? ef 11)
        (set! enemy-air-or-colossus-rev (cons e enemy-air-or-colossus-rev)))
      (when (bitwise-bit-set? ef 12)
        (set! enemy-massive-air-or-colossus-rev (cons e enemy-massive-air-or-colossus-rev)))
      (when (bitwise-bit-set? ef 13)
        (set! enemy-mutalisks-rev (cons e enemy-mutalisks-rev))))
    (when (or (bitwise-bit-set? ef 14)
              (eq? (hash-ref e 'changeling? #f) #t))
      (set! enemy-changelings-rev (cons e enemy-changelings-rev)))
    (when (and (bitwise-bit-set? ef 23)
               (not (eq? (hash-ref e 'is-hallucination #f) #t))
               (not (eq? (hash-ref e 'hallucination #f) #t))
               (not (eq? (hash-ref e 'hallucination? #f) #t)))
      (set! visible-enemy-combat-supply (+ visible-enemy-combat-supply (vector-ref einfo 1))))
    (when (fl<= d2 361.0)
      (set! local-enemy-unit-val (+ local-enemy-unit-val (vector-ref einfo 2))))
    (unless enemy-unit-shimmer?
      (when (or e-burrowed?
                (hash-ref e 'is-shimmer? #f)
                (hash-ref e 'cloaked #f)
                (hash-ref e 'is-cloaked? #f)
                (hash-ref e 'burrowed #f)
                (hash-ref e 'is-burrowed? #f)
                (let ([dt (hash-ref e 'display-type 1)])
                  (or (eq? dt 2) (eq? dt 'hidden) (not (exact-integer? dt))))
                (let ([cs (hash-ref e 'cloak-state 0)])
                  (or (eq? cs 2) (memq cs '(cloaked cloaked-detected)) (not (exact-integer? cs))))
                (let ([ck (hash-ref e 'cloak 0)])
                  (or (memq ck '(1 2 cloaked cloaked-detected))))
                (memq (unit-type-sym e)
                      '(lurker-burrowed roach-burrowed infestor-burrowed swarm-host-burrowed
                        widow-mine-burrowed baneling-burrowed ultralisk-burrowed
                        hydralisk-burrowed zergling-burrowed queen-burrowed drone-burrowed)))
        (set! enemy-unit-shimmer? #t)))
    (when (and has-creep-queens? (bitwise-bit-set? ef 25))
      (when (for/or ([qx (in-list creep-queen-xs)]
                     [qy (in-list creep-queen-ys)])
              (define dx (fl- fex qx))
              (define dy (fl- fey qy))
              (fl<= (fl+ (fl* dx dx) (fl* dy dy)) 49.0))
        (set! creep-enemy-slice-rev (cons e creep-enemy-slice-rev))))
    (if coords-ok?
        (begin
          (set! sum-eu-x (fl+ sum-eu-x fex))
          (set! sum-eu-y (fl+ sum-eu-y fey)))
        (begin
          (set! sum-eu-x (fl+ sum-eu-x (exact->inexact (fast-finite-real ex-raw enemy-x))))
          (set! sum-eu-y (fl+ sum-eu-y (exact->inexact (fast-finite-real ey-raw enemy-y)))))))
  (define has-enemy-static-det? (bitwise-bit-set? enemy-acc-mask 15))
  (define has-enemy-swarm-host-or-locust? (bitwise-bit-set? enemy-acc-mask 16))
  (define has-enemy-creep-tumor?
    (or (bitwise-bit-set? enemy-acc-mask 17)
        (pair? (hash-ref l34-sc 'stripped-enemy-tumors '()))))
  (define has-enemy-dropperlord? (bitwise-bit-set? enemy-acc-mask 18))
  (define has-enemy-overseer? (bitwise-bit-set? enemy-acc-mask 19))
  (define has-enemy-harass-sym? (bitwise-bit-set? enemy-acc-mask 20))
  (define has-enemy-static-def-or-nydus? (bitwise-bit-set? enemy-acc-mask 21))
  (define has-enemy-map-elem-or-recall? (bitwise-bit-set? enemy-acc-mask 22))
  (define has-enemy-burrow-or-sh-counter?
    (or enemy-unit-shimmer? (bitwise-bit-set? enemy-acc-mask 24)))
  (define enemy-disruptor-units (reverse enemy-disruptor-units-rev))
  (define enemy-widow-mines (reverse enemy-widow-mines-rev))
  (define enemy-banelings (reverse enemy-banelings-rev))
  (define linear-splash-enemies (reverse linear-splash-enemies-rev))
  (define enemy-sieged-tanks-near (reverse enemy-sieged-tanks-near-rev))
  (define tank-lurker-hazards (reverse tank-lurker-hazards-rev))
  (define enemy-air-or-colossus (reverse enemy-air-or-colossus-rev))
  (define enemy-massive-air-or-colossus (reverse enemy-massive-air-or-colossus-rev))
  (define enemy-mutalisks (reverse enemy-mutalisks-rev))
  (define enemy-changelings (reverse enemy-changelings-rev))
  (define has-enemy-changeling? (pair? enemy-changelings))

  (define enemy-stasis-eb-rev '())
  (define immobile-bile-eb-rev '())
  (define enemy-pfs-near-rev '())
  (define enemy-pf-list-rev '())
  (define local-enemy-bldg-val 0)
  (define sum-eb-x 0.0)
  (define sum-eb-y 0.0)
  (define enemy-bldg-acc 0)
  (for ([eb (in-list enemy-bldgs)])
    (define bt (unit-type-sym eb))
    (define binfo (fast-enemy-b-info bt))
    (define bf (vector-ref binfo 0))
    (set! enemy-bldg-acc (bitwise-ior enemy-bldg-acc bf))
    (define ex-raw (hash-ref eb 'x #f))
    (define ey-raw (hash-ref eb 'y #f))
    (define fex-opt
      (cond
        [(flonum? ex-raw) (and (fl= (fl- ex-raw ex-raw) 0.0) ex-raw)]
        [(exact-integer? ex-raw) (->fl ex-raw)]
        [(and (real? ex-raw) (= (- ex-raw ex-raw) 0)) (exact->inexact ex-raw)]
        [else #f]))
    (define fey-opt
      (cond
        [(flonum? ey-raw) (and (fl= (fl- ey-raw ey-raw) 0.0) ey-raw)]
        [(exact-integer? ey-raw) (->fl ey-raw)]
        [(and (real? ey-raw) (= (- ey-raw ey-raw) 0)) (exact->inexact ey-raw)]
        [else #f]))
    (define coords-ok? (and fex-opt fey-opt))
    (define fex (or fex-opt 9999.0))
    (define fey (or fey-opt 9999.0))
    (unless enemy-near-home?
      (let ([dx1 (fl- fex bx-fl)] [dy1 (fl- fey by-fl)]
            [dx2 (fl- fex nx-fl)] [dy2 (fl- fey ny-fl)])
        (when (or (fl<= (fl+ (fl* dx1 dx1) (fl* dy1 dy1)) 324.0)
                  (fl<= (fl+ (fl* dx2 dx2) (fl* dy2 dy2)) 324.0))
          (set! enemy-near-home? #t))))
    (unless (zero? (bitwise-and bf 120))
      (when (bitwise-bit-set? bf 3)
        (set! enemy-stasis-eb-rev (cons eb enemy-stasis-eb-rev)))
      (when (bitwise-bit-set? bf 4)
        (set! immobile-bile-eb-rev (cons eb immobile-bile-eb-rev)))
      (when (not (zero? (bitwise-and bf 96)))
        (define d2
          (if coords-ok?
              (let ([dx (fl- fprelim-cx fex)]
                    [dy (fl- fprelim-cy fey)])
                (fl+ (fl* dx dx) (fl* dy dy)))
              (let ([d (dist2d prelim-army-cx prelim-army-cy
                               (or ex-raw 9999.0) (or ey-raw 9999.0))])
                (define fd (if (flonum? d) d (exact->inexact d)))
                (fl* fd fd))))
        (when (bitwise-bit-set? bf 5)
          (set! enemy-pf-list-rev (cons eb enemy-pf-list-rev))
          (when (fl<= d2 306.25)
            (set! enemy-pfs-near-rev (cons eb enemy-pfs-near-rev))))
        (when (and (bitwise-bit-set? bf 6) (fl<= d2 361.0))
          (set! local-enemy-bldg-val (+ local-enemy-bldg-val (vector-ref binfo 1))))))
    (if coords-ok?
        (begin
          (set! sum-eb-x (fl+ sum-eb-x fex))
          (set! sum-eb-y (fl+ sum-eb-y fey)))
        (begin
          (set! sum-eb-x (fl+ sum-eb-x (exact->inexact (fast-finite-real ex-raw enemy-x))))
          (set! sum-eb-y (fl+ sum-eb-y (exact->inexact (fast-finite-real ey-raw enemy-y)))))))
  (when (and (not has-enemy-static-det?) (bitwise-bit-set? enemy-bldg-acc 0))
    (set! has-enemy-static-det? #t))
  (when (and (not has-enemy-creep-tumor?) (bitwise-bit-set? enemy-bldg-acc 1))
    (set! has-enemy-creep-tumor? #t))
  (when (and (not has-enemy-static-def-or-nydus?) (bitwise-bit-set? enemy-bldg-acc 2))
    (set! has-enemy-static-def-or-nydus? #t))
  (define enemy-stasis-traps
    (if (and (null? enemy-stasis-eu-rev) (null? enemy-stasis-eb-rev))
        '()
        (append (reverse enemy-stasis-eu-rev) (reverse enemy-stasis-eb-rev))))
  (define immobile-bile-targets
    (if (and live-tactics-obs?
             has-ally-ravager?
             (or (pair? immobile-bile-eu-rev) (pair? immobile-bile-eb-rev)))
        (append (reverse immobile-bile-eu-rev) (reverse immobile-bile-eb-rev))
        '()))
  (define enemy-pfs-near (reverse enemy-pfs-near-rev))
  (define enemy-pf-list (reverse enemy-pf-list-rev))

  (define have-siege-breaker-unit? #f)
  (define have-heavy-or-siege-breaker-unit? #f)
  (define local-ally-val 0)
  (define live-combat-supply 0.0)
  (define weighted-combat-units 0.0)
  (define ally-siege-tanks-rev '())
  (define ally-siege-supporters-rev '())
  (define ally-has-stealth? #f)
  (define any-ally-baneling? #f)
  (for ([u (in-list combat-units)])
    (define ut (unit-type-sym u))
    (unless have-siege-breaker-unit?
      (when (hash-ref RUNTIME-SIEGE-BREAKER-SET ut #f)
        (set! have-siege-breaker-unit? #t)))
    (unless have-heavy-or-siege-breaker-unit?
      (when (hash-ref RUNTIME-HEAVY-SB-SET ut #f)
        (set! have-heavy-or-siege-breaker-unit? #t)))
    (set! local-ally-val (+ local-ally-val (fast-res-cost-50 ut)))
    (set! live-combat-supply (+ live-combat-supply (unit-supply-cost ut)))
    (set! weighted-combat-units (+ weighted-combat-units (if (eq? ut 'zergling) 0.5 1.0)))
    (when (or (eq? ut 'siege-tank) (eq? ut 'siege-tank-sieged))
      (set! ally-siege-tanks-rev (cons u ally-siege-tanks-rev)))
    (when (hash-ref RUNTIME-SIEGE-SUPP-SET ut #f)
      (set! ally-siege-supporters-rev (cons u ally-siege-supporters-rev)))
    (unless ally-has-stealth?
      (when (let ([clk (hash-ref u 'cloak #f)])
              (or (hash-ref RUNTIME-STEALTH-SET ut #f)
                  (memq ut '(dark-templar lurker-burrowed lurker-mp-burrowed roach-burrowed
                             widow-mine-burrowed baneling-burrowed infestor-burrowed zergling-burrowed))
                  (eq? (hash-ref u 'cloaked #f) #t)
                  (eq? (hash-ref u 'burrowed #f) #t)
                  (eq? (hash-ref u 'is-burrowed #f) #t)
                  (eq? (hash-ref u 'burrowed? #f) #t)
                  ;; L49-W1: Recognize Tunneling-Claws Roaches & Cloak Banshees from tick 0 so
                  ;; Corruptors/Hydralisks/Vikings snipe Observers/Overseers BEFORE burrow/cloak!
                  (and (eq? ut 'roach)
                       (l34-has-upgrade? ctx 'burrow)
                       (l34-has-upgrade? ctx 'tunneling-claws))
                  (and (eq? ut 'banshee)
                       (l34-has-upgrade? ctx 'banshee-cloak))
                  (and (memq ut '(banshee ghost lurker lurker-mp roach widow-mine))
                       (or (eqv? clk 1) (eqv? clk 2) (eqv? clk 4)
                           (eq? clk 'cloaked) (eq? clk 'cloaked-detected) (eq? clk 'cloaked-allied)))))
        (set! ally-has-stealth? #t)))
    (unless any-ally-baneling?
      (when (eq? ut 'baneling) (set! any-ally-baneling? #t))))
  (define ally-siege-tanks (reverse ally-siege-tanks-rev))
  (define ally-siege-supporters (reverse ally-siege-supporters-rev))
  (define our-z-early
    (hash-ref obs 'our-terrain-z
              (if (not (null? combat-units)) (hash-ref (car combat-units) 'z 10.0) 10.0)))
  (define enemy-z-early
    (hash-ref obs 'enemy-terrain-z
              (if (not (null? enemy-units)) (hash-ref (car enemy-units) 'z 10.0) 10.0)))
  (define siege-uphill? (>= (- (exact->inexact enemy-z-early) (exact->inexact our-z-early)) 0.75))
  (define have-siege-breaker?
    (or have-siege-breaker-unit?
        (ormap (lambda (eff) (eq? (hash-ref eff 'type 'none) 'blinding-cloud)) effects)))
  (define have-heavy-or-siege-breaker?
    (or have-siege-breaker?
        have-heavy-or-siege-breaker-unit?))
  (define local-enemy-val
    (max 100 (+ local-enemy-unit-val local-enemy-bldg-val)))
  (define local-val-ratio (/ (exact->inexact local-ally-val) (exact->inexact local-enemy-val)))
  (define can-break-siege-line?
    (or (>= local-val-ratio (if siege-uphill? 1.55 1.40))
        (and (>= (hash-ref obs 'supply-used 0) 180)
             (or have-heavy-or-siege-breaker?
                 (>= local-val-ratio 1.25)))
        have-siege-breaker?))
  ;; W16-P0-1-rt: Unify `siege-shelling-friendly-structure?` with `enemy-within-14-of-th?`
  ;; (<= 30.0t of any live TH / own-Voronoi territory, <= 16.0t of any friendly building) so
  ;; `siege-line-hold?` / `nearest-enemy-tank` NEVER overrides home defense for Tanks sieged
  ;; 15.6-30.0t from our bases (`#16`, `#17`, `#13`, 42.9% of live AI Arena losses)!
  (define siege-shelling-friendly-structure?
    (and (pair? enemy-sieged-tanks-near)
         (or (l34-ctx-enemy-within-14-of-th? ctx)
             (ormap (lambda (st)
                      (define stx (hash-ref st 'x 9999.0))
                      (define sty (hash-ref st 'y 9999.0))
                      (or (l34-fast-enemy-near-territory? ctx st stx sty)
                          (ormap (lambda (b)
                                   (define bx (hash-ref b 'x base-x))
                                   (define by (hash-ref b 'y base-y))
                                   (define th? (memq (fast-canonical-structure-sym (unit-type-sym b))
                                                     '(hatchery lair hive nexus command-center orbital-command planetary-fortress)))
                                   (<= (dist2d stx sty bx by) (if th? 30.0 16.0)))
                                 ally-bldgs)))
                    enemy-sieged-tanks-near))))
  (define siege-line-hold?
    (and live-tactics-obs?
         (or (>= (length enemy-sieged-tanks-near) 2)
             (and (>= (length enemy-sieged-tanks-near) 1)
                  (not (null? enemy-pfs-near))))
         (not siege-shelling-friendly-structure?)
         (not can-break-siege-line?)))
  (set-l34-ctx-ally-disruptor-units! ctx ally-disruptor-units)
