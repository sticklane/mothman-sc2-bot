                race effective-enemy-race initial-enemy-race)]
              [pkey (list base-x base-y nat-x nat-y effective-enemy-race
                          initial-enemy-race force-main-ramp?
                          enemy-x enemy-y (eq-hash-code map-grids))]
              [cached (hash-ref wall-st 'cached-protoss-wall #f)])
         (if (and (pair? cached) (equal? (car cached) pkey))
             (cdr cached)
             (let ([res (solve-protoss-matchup-wall base-x base-y nat-x nat-y effective-enemy-race
                                                    #:map-grids map-grids
                                                    #:enemy-x enemy-x
                                                    #:enemy-y enemy-y
                                                    #:initial-enemy-race initial-enemy-race
                                                    #:force-main-ramp? force-main-ramp?)])
               (hash-set! wall-st 'cached-protoss-wall (cons pkey res))
               res)))]))
  (set-l2-ctx-protoss-matchup-wall! ctx protoss-matchup-wall)
  (define wall-supply-attempts (hash-ref wall-st 'wall-supply-attempts 0))
  (set-l2-ctx-wall-supply-attempts! ctx wall-supply-attempts)
  (define wall-supply-failures (hash-ref wall-st 'wall-supply-failures 0))
  (define wall-supply-first-f (hash-ref wall-st 'wall-supply-first-frame #f))
  (define bypass-wall-pylon?
    (and (eq? race 'Protoss)
         (or protoss-crisis-inmain-pylon-needed?
             (and (or worker-rush-active? in-base-proxy-detected?)
                  (= safe-inmain-pylon-count 0))
             (and (= real-pylon-count 0)
                  (or (> wall-supply-failures 0)
                      (and (>= wall-supply-attempts 1)
                           (exact-integer? wall-supply-first-f)
                           (>= (- frame wall-supply-first-f) 24))
                      (and (> frame 650) (or (> wall-supply-attempts 0) live-game-obs?))
                      (and live-game-obs? (<= (l2-ctx-supply-left ctx) 0)))))))
  (set-l2-ctx-bypass-wall-pylon?! ctx bypass-wall-pylon?)
  (define bypass-wall-depot1?
    (and (eq? race 'Terran)
         (= real-depot-count 0)
         (or worker-rush-active?
             in-base-proxy-detected?
             (> wall-supply-failures 0)
             (and (>= wall-supply-attempts 1)
                  (exact-integer? wall-supply-first-f)
                  (>= (- frame wall-supply-first-f) 24))
             (and (> frame 650) (or (> wall-supply-attempts 0) live-game-obs?))
             (and live-game-obs? (<= (l2-ctx-supply-left ctx) 0)))))
  (set-l2-ctx-bypass-wall-depot1?! ctx bypass-wall-depot1?))

(define (l2-phase7-wall-counts! ctx)
  (define active-bases (l2-ctx-active-bases ctx))
  (define ally-bldgs (l2-ctx-ally-bldgs ctx))
  (define ally-units (l2-ctx-ally-units ctx))
  (define base-x (l2-ctx-base-x ctx))
  (define base-y (l2-ctx-base-y ctx))
  (define bypass-wall-depot1? (l2-ctx-bypass-wall-depot1? ctx))
  (define bypass-wall-pylon? (l2-ctx-bypass-wall-pylon? ctx))
  (define cg4-cap (l2-ctx-cg4-cap ctx))
  (define cg5-cap (l2-ctx-cg5-cap ctx))
  (define cg6-cap (l2-ctx-cg6-cap ctx))
  (define cg7-cap (l2-ctx-cg7-cap ctx))
  (define eff-pending-supply (l2-ctx-eff-pending-supply ctx))
  (define effective-enemy-race (l2-ctx-effective-enemy-race ctx))
  (define expansion-pads (l2-ctx-expansion-pads ctx))
  (define frame (l2-ctx-frame ctx))
  (define has-unpowered-bldg? (l2-ctx-has-unpowered-bldg? ctx))
  (define live-game-obs? (l2-ctx-live-game-obs? ctx))
  (define nat-x (l2-ctx-nat-x ctx))
  (define nat-y (l2-ctx-nat-y ctx))
  (define need-supply? (l2-ctx-need-supply? ctx))
  (define obs (l2-ctx-obs ctx))
  (define oledger (l2-ctx-oledger ctx))
  (define power-placement-failed? (l2-ctx-power-placement-failed? ctx))
  (define prod-facilities (l2-ctx-prod-facilities ctx))
  (define protoss-emergency-pylon? (l2-ctx-protoss-emergency-pylon? ctx))
  (define protoss-matchup-wall (l2-ctx-protoss-matchup-wall ctx))
  (define protoss-pylon-count (l2-ctx-protoss-pylon-count ctx))
  (define race (l2-ctx-race ctx))
  (define ready-bldg-types (l2-ctx-ready-bldg-types ctx))
  (define ready-bldgs (l2-ctx-ready-bldgs ctx))
  (define real-depot-count (l2-ctx-real-depot-count ctx))
  (define real-pylon-count (l2-ctx-real-pylon-count ctx))
  (define rt (l2-ctx-rt ctx))
  (define supply-at-risk? (l2-ctx-supply-at-risk? ctx))
  (define supply-cap (l2-ctx-supply-cap ctx))
  (define supply-provider-sym (l2-ctx-supply-provider-sym ctx))
  (define supply-threshold (l2-ctx-supply-threshold ctx))
  (define supply-used (l2-ctx-supply-used ctx))
  (define target-workers (l2-ctx-target-workers ctx))
  (define terran-emergency-depot? (l2-ctx-terran-emergency-depot? ctx))
  (define terran-ramp-wall (l2-ctx-terran-ramp-wall ctx))
  (define third-x (l2-ctx-third-x ctx))
  (define third-y (l2-ctx-third-y ctx))
  (define total-workers (l2-ctx-total-workers ctx))
  (define unit-types (l2-ctx-unit-types ctx))
  (define unpowered-protoss-bldg (l2-ctx-unpowered-protoss-bldg ctx))
  (define wall-st (l2-ctx-wall-st ctx))
  (define wall-supply-attempts (l2-ctx-wall-supply-attempts ctx))
  (define worker-rush-active? (l2-ctx-worker-rush-active? ctx))
  (define step-wall-aabbs
    (cond
      [(eq? race 'Terran)
       (filter values
               (list (let ([p (and (not bypass-wall-depot1?) (hash-ref terran-ramp-wall 'depot-1 #f))])
                       (and (pair? p) (reserved-aabb (car p) (cdr p) 1.0 1.0 'wall-slot 0 0)))
                     (let ([p (and (not bypass-wall-depot1?) (hash-ref terran-ramp-wall 'barracks #f))])
                       (and (pair? p) (reserved-aabb (car p) (cdr p) 1.5 1.5 'wall-slot 0 0)))
                     (let ([p (hash-ref terran-ramp-wall 'depot-2 #f)])
                       (and (pair? p) (reserved-aabb (car p) (cdr p) 1.0 1.0 'wall-slot 0 0)))
                     (let ([p (hash-ref terran-ramp-wall 'barracks-addon #f)])
                       (and (pair? p) (reserved-aabb (car p) (cdr p) 1.0 1.0 'terran-addon-pad 0 0)))))]
      [(eq? race 'Protoss)
       (filter values
               (list (let ([p (and (not bypass-wall-pylon?) (hash-ref protoss-matchup-wall 'pylon #f))])
                       (and (pair? p) (reserved-aabb (car p) (cdr p) 1.0 1.0 'wall-slot 0 0)))
                     (let ([p (and (not bypass-wall-pylon?) (hash-ref protoss-matchup-wall 'slot-1 #f))])
                       (and (pair? p) (reserved-aabb (car p) (cdr p) 1.5 1.5 'wall-slot 0 0)))
                     (let ([p (and (not bypass-wall-pylon?) (hash-ref protoss-matchup-wall 'slot-2 #f))])
                       (and (pair? p) (reserved-aabb (car p) (cdr p) 1.5 1.5 'wall-slot 0 0)))
                     (let ([p (and (not bypass-wall-pylon?) (hash-ref protoss-matchup-wall 'slot-3 #f))])
                       (and (pair? p) (reserved-aabb (car p) (cdr p) 1.5 1.5 'wall-slot 0 0)))
                     (let ([p (and (not bypass-wall-pylon?) (hash-ref protoss-matchup-wall 'door #f))])
                       (and (pair? p) (reserved-aabb (car p) (cdr p) 1.2 1.2 'doorway-corridor 0 0)))
                     (let ([p (and (not bypass-wall-pylon?) (hash-ref protoss-matchup-wall 'door-park #f))])
                       (and (pair? p) (reserved-aabb (car p) (cdr p) 1.2 1.2 'doorway-corridor 0 0)))))]
      [else '()]))
  (set-l2-ctx-step-wall-aabbs! ctx step-wall-aabbs)
  (set-box! (rt-wall-aabbs-box rt) step-wall-aabbs)
  (define allow-exact-wall-slot?
    (and (< frame 4000) (<= active-bases 2)))
  (set-l2-ctx-allow-exact-wall-slot?! ctx allow-exact-wall-slot?)
  (define early-larvae-consumed 0)
  (define unfinished-wire-pylon-cnt-p
    (if (eq? race 'Protoss)
        (+ (count (lambda (b)
                    (and (hash? b)
                         (eq? (fast-canonical-structure-sym (unit-type-sym b)) 'pylon)
                         (< (hash-ref b 'build-progress 1.0) SC2-BUILD-COMPLETE-PROGRESS)))
                  ally-bldgs)
           (order-ledger-pending-count-for-type oledger 'pylon frame))
        0))
  ;; 1-Base Natural Expansion Priority over Non-Urgent Supply Buffer:
  ;; When still on 1 base with >= 5 free supply (or >= 3 for Terran CC #2 climb at cap 23..30)
  ;; and saving/ready for the 2nd townhall, do not let a proactive buffer supply provider dip
  ;; minerals below the 2nd townhall cost.
  (define hold-proactive-supply-for-2nd-base?
    (and live-game-obs?
         (= active-bases 1)
         (not protoss-emergency-pylon?)
         (not terran-emergency-depot?)
         (not worker-rush-active?)
         (not (l2-ctx-in-base-proxy-detected? ctx))
         (or (and (eq? race 'Terran)
                  (>= frame 1200)
                  (>= total-workers 16)
                  (memq 'barracks (l2-ctx-bldg-types ctx))
                  (= (order-ledger-pending-count-for-type oledger 'command-center frame) 0)
                  (< (- (l2-ctx-minerals ctx) (sc2-min-cost 'supply-depot)) (sc2-min-cost 'command-center))
                  (or (and (< supply-cap 31)
                           (>= (l2-ctx-supply-left ctx) 3)
                           (>= (l2-ctx-minerals ctx) 250))
                      ;; L30-P0-3 / L31-P0-3 (`#32`/`#08` Natural CC Escrow Guard): Also hold non-urgent proactive
                      ;; Supply Depots (`supply-left >= 4`) past 31 cap while Brain/BO targets CC #2!
                      (and (>= frame 1800)
                           (>= (l2-ctx-supply-left ctx) 4)
                           (l2-terran-1base-cc-intent? ctx)
                           (>= (l2-ctx-minerals ctx) 200))))
             ;; W5-P0-2-rt: When on 1 base with >=400M and a supply provider is ALREADY in progress
             ;; (e.g., 27/31 with Pylon #3 building -> +8 supply), don't spend 100M on a 2nd overlapping
             ;; proactive Pylon before 2nd Townhall expansion runs (#30 PvP f=3584 fix!).
             (and (or (>= (l2-ctx-supply-left ctx) 5)
                      (and (>= (l2-ctx-supply-left ctx) 2)
                           (or (>= eff-pending-supply 1)
                               (>= unfinished-wire-pylon-cnt-p 1))))
                  (>= frame 1800)
                  (>= total-workers 16)
                  (ormap (lambda (s) (memq s (l2-ctx-bldg-types ctx)))
                         '(barracks gateway warp-gate spawning-pool))
                  (let* ([th-sym (case race [(Zerg) 'hatchery] [(Protoss) 'nexus] [else 'command-center])]
                         [th-cost (sc2-min-cost th-sym)]
                         [sup-cost (sc2-min-cost supply-provider-sym)]
                         [cur-m (l2-ctx-minerals ctx)])
                    (and (= (order-ledger-pending-count-for-type oledger th-sym frame) 0)
                         (>= cur-m th-cost)
                         (< (- cur-m sup-cost) th-cost)))))))
  ;; L20-P0-3 (`#36 PvZ` early Ling breach): When Protoss is actively breached with `< 3`
  ;; combat units, `>= 2` free supply, and an idle ready powered Gateway, defer proactive
  ;; buffer Pylons (`< 200M`) so Gateway #1 trains a defending Zealot FIRST!
  (define hold-proactive-pylon-for-breach-zealot?
    (and live-game-obs?
         (eq? race 'Protoss)
         (not protoss-emergency-pylon?)
         (>= (l2-ctx-supply-left ctx) 2)
         (or (l2-ctx-under-base-attack? ctx)
             (l2-ctx-early-survival-crisis? ctx)
             (l2-ctx-under-early-cheese? ctx))
         (< (length (l2-ctx-ally-combat-units ctx)) 3)
         (< (l2-ctx-minerals ctx) (+ (sc2-min-cost 'pylon) (sc2-min-cost 'zealot)))
         (ormap (lambda (b)
                  (and (hash? b)
                       (memq (fast-canonical-structure-sym (unit-type-sym b)) '(gateway warp-gate))
                       (>= (hash-ref b 'build-progress 1.0) SC2-BUILD-COMPLETE-PROGRESS)
                       (not (eq? (hash-ref b 'powered? #t) #f))
                       (not (eq? (hash-ref b 'busy? #f) #t))
                       (= (hash-ref b 'order-count 0) 0)))
                ally-bldgs)))
  (when (and (or (and need-supply?
                      (not hold-proactive-supply-for-2nd-base?)
                      (not hold-proactive-pylon-for-breach-zealot?))
                 protoss-emergency-pylon?
                 terran-emergency-depot?)
             (or (not (eq? race 'Protoss)) (< unfinished-wire-pylon-cnt-p 2))
             (>= (l2-ctx-minerals ctx) (sc2-min-cost supply-provider-sym)))
    (case race
      [(Zerg)
       (define-values (explicit-larvae-early live-larva-tracking-early?)
         (if live-game-obs?
             (let loop ([rem ally-units] [lc 0] [track? #f])
               (if (null? rem)
                   (values lc track?)
                   (let ([ut (unit-type-sym (car rem))])
                     (cond
                       [(eq? ut 'larva) (loop (cdr rem) (add1 lc) #t)]
                       [(or track? (eq? ut 'egg) (eq? ut 'baneling-cocoon) (eq? ut 'ravager-cocoon))
                        (loop (cdr rem) lc #t)]
                       [else (loop (cdr rem) lc #f)]))))
             (values 0 #f)))
       ;; L59-P2 (`#5143226 VoidCrushAgain`): Under heavy enemy air (`>= 3` Void Rays or `>= 4` enemy air),
       ;; cap concurrent Overlord queue at `<= 2` in flight so Overlord-snipe spirals never starve Queens/AA!
       (define l2-zerg-heavy-air-ov-cap?
         (let* ([rt-ov (l2-ctx-rt ctx)]
                [owm-ov (and rt-ov (opponent-world-model-last-summary (rt-opponent-world-model rt-ov)))]
                [kc-ov (and owm-ov (opponent-world-summary-known-unit-counts owm-ov))]
                [vr-cnt (max (count (lambda (e) (and (hash? e) (memq (unit-type-sym e) '(void-ray voidray))))
                                    (l2-ctx-enemy-units ctx))
                             (if (hash? kc-ov) (+ (hash-ref kc-ov 'void-ray 0) (hash-ref kc-ov 'voidray 0)) 0))]
                [air-cnt (max (count (lambda (e) (and (hash? e) (memq (unit-type-sym e) '(void-ray voidray phoenix oracle carrier tempest battlecruiser banshee mutalisk))))
                                     (l2-ctx-enemy-units ctx))
                              (if (hash? kc-ov)
                                  (+ (hash-ref kc-ov 'void-ray 0) (hash-ref kc-ov 'voidray 0)
                                     (hash-ref kc-ov 'phoenix 0) (hash-ref kc-ov 'oracle 0)
                                     (hash-ref kc-ov 'carrier 0) (hash-ref kc-ov 'tempest 0)
                                     (hash-ref kc-ov 'battlecruiser 0) (hash-ref kc-ov 'banshee 0)
                                     (hash-ref kc-ov 'mutalisk 0))
                                  0))])
           (and (or (>= vr-cnt 3) (>= air-cnt 4))
                (>= eff-pending-supply 2))))
       (when (and (not l2-zerg-heavy-air-ov-cap?)
                  (or (not live-larva-tracking-early?) (> explicit-larvae-early 0)))
         (l2-recall-building-group! ctx 4)
         (l2-emit! ctx '(train overlord))
         (order-ledger-record-issued! oledger (+ 800000 (modulo frame 10000)) 'train 'overlord base-x base-y frame)
         (set! early-larvae-consumed (add1 early-larvae-consumed))
         (set-l2-ctx-minerals! ctx (- (l2-ctx-minerals ctx) (sc2-min-cost 'overlord)))
         (set-l2-ctx-pending-supply! ctx (add1 (l2-ctx-pending-supply ctx)))
         (set! eff-pending-supply (add1 eff-pending-supply))
         (set-l2-ctx-eff-pending-supply! ctx eff-pending-supply))]
      [(Protoss)
       ;; L37-P0-2 (`#846`): Route non-wall Protoss Pylon #2+ through spawn-symmetric
       ;; `solve-protoss-pro-simcity` / mineral-away `l2-emergency-inmain-supply-anchor`
       ;; (zero hardcoded `+X,+Y` NE drift!).
       (define wall-pylon-pt
         (and allow-exact-wall-slot?
              (not bypass-wall-pylon?)
              (= protoss-pylon-count 0)
              (not has-unpowered-bldg?)
              (hash-ref protoss-matchup-wall 'pylon #f)))
       (define use-exact-pylon? (pair? wall-pylon-pt))
       (define inmain-retry-idx (hash-ref wall-st 'inmain-supply-attempts 0))
       (define-values (em-px em-py)
         (l2-emergency-inmain-supply-anchor ctx
          (+ inmain-retry-idx
             (if power-placement-failed?
                 (+ protoss-pylon-count 1)
                 protoss-pylon-count))))
       (define use-nat-pylon-anchor?
         (and live-game-obs?
              (>= active-bases 2)
              (>= protoss-pylon-count 2)
              (if power-placement-failed?
                  (even? inmain-retry-idx)
                  (= (modulo protoss-pylon-count 3) 2))))
       (define-values (raw-px raw-py)
         (cond
           [use-exact-pylon?
            (values (safe-coord (car wall-pylon-pt) em-px)
                    (safe-coord (cdr wall-pylon-pt) em-py))]
           [has-unpowered-bldg?
            (define ux0 (exact->inexact (hash-ref unpowered-protoss-bldg 'x em-px)))
            (define uy0 (exact->inexact (hash-ref unpowered-protoss-bldg 'y em-py)))
            (define dx (- (exact->inexact base-x) ux0))
            (define dy (- (exact->inexact base-y) uy0))
            (define d (sqrt (+ (* dx dx) (* dy dy))))
            (if (> d 0.5)
                (values (safe-coord (+ ux0 (* 2.5 (/ dx d))) em-px)
                        (safe-coord (+ uy0 (* 2.5 (/ dy d))) em-py))
                (l2-interior-offset ctx 2.5 0.0 ux0 uy0))]
           [(or bypass-wall-pylon? power-placement-failed?)
            (values em-px em-py)]
           [use-nat-pylon-anchor?
            (define ndx (- (exact->inexact base-x) (exact->inexact nat-x)))
            (define ndy (- (exact->inexact base-y) (exact->inexact nat-y)))
            (define nd (max 1.0 (sqrt (+ (* ndx ndx) (* ndy ndy)))))
            (define nux (/ ndx nd))
            (define nuy (/ ndy nd))
            (define npx (- nuy))
            (define npy nux)
            (define lat-step (list-ref '(0.0 2.5 -2.5 5.0 -5.0) (modulo (quotient protoss-pylon-count 3) 5)))
            (define back-step (+ 3.5 (* 1.5 (modulo (quotient protoss-pylon-count 6) 2))))
            (values (safe-coord (+ nat-x (* back-step nux) (* lat-step npx)) em-px)
                    (safe-coord (+ nat-y (* back-step nuy) (* lat-step npy)) em-py))]
           [else
            (l2-simcity-supply-anchor ctx 'pylon em-px em-py)]))
       (define-values (px py)
         (order-ledger-resolve-build-coords!
          oledger 'pylon raw-px raw-py ally-bldgs frame 2.5
          #:expansion-pads expansion-pads
          #:exact-wall-slot? use-exact-pylon?
          #:reserved-aabbs (l2-wall-aabbs-for-build ctx use-exact-pylon?)))
       (define sx (safe-coord px raw-px))
       (define sy (safe-coord py raw-py))
       (when (= real-pylon-count 0)
         (hash-set! wall-st 'supply-last-issue-frame frame)
         (when use-exact-pylon?
           (unless (hash-has-key? wall-st 'wall-supply-first-frame)
             (hash-set! wall-st 'wall-supply-first-frame frame))
           (hash-set! wall-st 'wall-supply-attempts (add1 wall-supply-attempts))))
       (when (and (not use-exact-pylon?)
                  (or (= real-pylon-count 0) power-placement-failed?))
         (hash-set! wall-st 'inmain-supply-attempts (add1 inmain-retry-idx)))
       (l2-emit! ctx (list 'build 'pylon sx sy))
       (order-ledger-record-issued! oledger (+ 800000 (modulo frame 10000)) 'build 'pylon sx sy frame)
       (set-l2-ctx-bldg-types! ctx (cons 'pylon (l2-ctx-bldg-types ctx)))
       (set-l2-ctx-minerals! ctx (- (l2-ctx-minerals ctx) (sc2-min-cost 'pylon)))
       (set-l2-ctx-pending-supply! ctx (add1 (l2-ctx-pending-supply ctx)))
       (set! eff-pending-supply (add1 eff-pending-supply))
       (set-l2-ctx-eff-pending-supply! ctx eff-pending-supply)]
      [(Terran)
       ;; L37-P0-2 (`#846` + `#855` `#47 NW` Depot Box): Route non-wall Terran SupplyDepot #3+
       ;; through spawn-symmetric `solve-terran-pro-simcity` / mineral-away
       ;; `l2-emergency-inmain-supply-anchor` (zero hardcoded `+X,-Y` SE depot box!).
       (define depot-count
         (count (lambda (t) (memq t '(supply-depot supply-depot-lowered))) (l2-ctx-bldg-types ctx)))
       (define wall-depot-entry
         (and allow-exact-wall-slot?
              (cond
                [(and (= depot-count 0) (not bypass-wall-depot1?))
                 (hash-ref terran-ramp-wall 'depot-1 #f)]
                [(= depot-count 1)
                 (hash-ref terran-ramp-wall 'depot-2 #f)]
                [else #f])))
       (define use-exact-depot? (pair? wall-depot-entry))
       (define inmain-retry-idx (hash-ref wall-st 'inmain-supply-attempts 0))
       (define-values (em-dx em-dy)
         (l2-emergency-inmain-supply-anchor ctx (+ inmain-retry-idx depot-count)))
       (define-values (raw-dx raw-dy)
         (cond
           [use-exact-depot?
            (values (safe-coord (car wall-depot-entry) em-dx)
                    (safe-coord (cdr wall-depot-entry) em-dy))]
           [(and (= depot-count 0) bypass-wall-depot1?)
            (values em-dx em-dy)]
           [else
            (l2-simcity-supply-anchor ctx 'supply-depot em-dx em-dy)]))
       (define-values (dx dy)
         (order-ledger-resolve-build-coords!
          oledger 'supply-depot raw-dx raw-dy ally-bldgs frame 2.0
          #:expansion-pads expansion-pads
          #:exact-wall-slot? use-exact-depot?
          #:reserved-aabbs (l2-wall-aabbs-for-build ctx use-exact-depot?)))
       (define sx (safe-coord dx raw-dx))
       (define sy (safe-coord dy raw-dy))
       (when (= real-depot-count 0)
         (hash-set! wall-st 'supply-last-issue-frame frame)
         (cond
           [use-exact-depot?
            (unless (hash-has-key? wall-st 'wall-supply-first-frame)
              (hash-set! wall-st 'wall-supply-first-frame frame))
            (hash-set! wall-st 'wall-supply-attempts (add1 wall-supply-attempts))]
           [else
            (hash-set! wall-st 'inmain-supply-attempts (add1 inmain-retry-idx))]))
       (l2-emit! ctx (list 'build 'supply-depot sx sy))
       (order-ledger-record-issued! oledger (+ 800000 (modulo frame 10000)) 'build 'supply-depot sx sy frame)
       (set-l2-ctx-bldg-types! ctx (cons 'supply-depot (l2-ctx-bldg-types ctx)))
       (set-l2-ctx-minerals! ctx (- (l2-ctx-minerals ctx) (sc2-min-cost 'supply-depot)))
       (set-l2-ctx-pending-supply! ctx (add1 (l2-ctx-pending-supply ctx)))
       (set! eff-pending-supply (add1 eff-pending-supply))
