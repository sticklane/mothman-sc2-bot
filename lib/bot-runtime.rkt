(define (l2-protoss-colossus-escrow-ok? ctx m-cost g-cost #:for-etl? [for-etl? #f])
       (and (or (not (l2-protoss-holding-colossus-now? ctx))
                (and (>= (- (l2-ctx-minerals ctx) m-cost) (sc2-min-cost 'colossus))
                     (or (<= g-cost 0)
                         (>= (- (l2-ctx-gas ctx) g-cost) (sc2-gas-cost 'colossus)))))
            (or for-etl?
                (not (l2-protoss-holding-etl-now? ctx))
                (and (>= (- (l2-ctx-minerals ctx) m-cost) (sc2-min-cost 'extended-thermal-lance))
                     (or (<= g-cost 0)
                         (>= (- (l2-ctx-gas ctx) g-cost) (sc2-gas-cost 'extended-thermal-lance)))))))

(define (l2-terran-facility-has-addon? ctx b)
  (define terran-addon-ox (l2-ctx-terran-addon-ox ctx))
  (define terran-addon-oy (l2-ctx-terran-addon-oy ctx))
  (define terran-addon-xs (l2-ctx-terran-addon-xs ctx))
  (define terran-addon-ys (l2-ctx-terran-addon-ys ctx))
       (or (eq? (hash-ref b 'has-addon? #f) #t)
           (not (not (hash-ref b 'addon #f)))
           (> (hash-ref b 'add-on-tag 0) 0)
           (and (pair? terran-addon-xs)
                (let ([tx (fl+ (exact->inexact (hash-ref b 'x -999.0)) terran-addon-ox)]
                      [ty (fl+ (exact->inexact (hash-ref b 'y -999.0)) terran-addon-oy)])
                  (for/or ([ax (in-list terran-addon-xs)]
                           [ay (in-list terran-addon-ys)])
                    (define dx (fl- tx ax))
                    (define dy (fl- ty ay))
                    (fl<= (fl+ (fl* dx dx) (fl* dy dy)) 3.0625))))))

(define (l2-facility-being-swapped? ctx b)
  (define addon-swap-acts (l2-ctx-addon-swap-acts ctx))
       (define bid (hash-ref b 'id -1))
       (for/or ([a (in-list addon-swap-acts)])
         (and (pair? a)
              (eq? (car a) 'terran-addon-swap)
              (>= (length a) 3)
              (or (equal? (second a) bid)
                  (equal? (third a) bid)))))

;; W16-P0-2-rt (`#17` 147s Terran freeze / `#5134986` / `#5136226`): Detect blocked 2x2 Terran
;; addon pads `(fx + 2.5, fy - 0.5)` and exponentially back off failing `(fac-id . addon-sym)`
;; retries (`36f -> 160f -> 448f -> 1344f`) so blocked Barracks/Factory/Starport facilities
;; NEVER steal `open-prod-slots` to 0 or phantom-drain minerals ahead of SCV/Marine/Tank training!
(define (l2-addon-pad-blocked? ctx fac)
  (define live-game? (l2-ctx-live-obs-harvesters? ctx))
  (define obs (l2-ctx-obs ctx))
  (define fid (hash-ref fac 'id -1))
  (and live-game?
       (or (and (hash? obs)
                (exact-integer? fid) (> fid 0)
                (for/or ([k (in-list '(addon-blocked-facility-ids addon-blocked-tags failed-addon-tags addon-cooldown-tags))])
                  (define v (hash-ref obs k #f))
                  (cond
                    [(set? v) (set-member? v fid)]
                    [(list? v) (and (memv fid v) #t)]
                    [(hash? v) (hash-has-key? v fid)]
                    [else #f])))
           (let ([fx0 (hash-ref fac 'x #f)]
                 [fy0 (hash-ref fac 'y #f)])
             (and (real? fx0) (real? fy0)
                  (let ([ax (+ (exact->inexact fx0) SC2-TERRAN-ADDON-OFFSET-X)]
                        [ay (+ (exact->inexact fy0) SC2-TERRAN-ADDON-OFFSET-Y)])
                    (or (for/or ([b (in-list (or (l2-ctx-ally-bldgs ctx) '()))])
                          (and (hash? b)
                               (not (= (hash-ref b 'id -2) fid))
                               (not (eq? (hash-ref b 'flying #f) #t))
                               (not (eq? (hash-ref b 'is-flying #f) #t))
                               (let ([bx0 (hash-ref b 'x #f)] [by0 (hash-ref b 'y #f)])
                                 (and (real? bx0) (real? by0)
                                      (< (abs (- (exact->inexact bx0) ax)) 1.85)
                                      (< (abs (- (exact->inexact by0) ay)) 1.85)))))
                        (for/or ([m (in-list (or (l2-ctx-step-mineral-patches ctx) '()))])
                          (and (hash? m)
                               (let ([mx0 (hash-ref m 'x #f)] [my0 (hash-ref m 'y #f)])
                                 (and (real? mx0) (real? my0)
                                      (< (abs (- (exact->inexact mx0) ax)) 1.65)
                                      (< (abs (- (exact->inexact my0) ay)) 1.65)))))
                        (for/or ([g (in-list (or (l2-ctx-step-geysers ctx) '()))])
                          (and (hash? g)
                               (let ([gx0 (hash-ref g 'x #f)] [gy0 (hash-ref g 'y #f)])
                                 (and (real? gx0) (real? gy0)
                                      (< (abs (- (exact->inexact gx0) ax)) 2.10)
                                      (< (abs (- (exact->inexact gy0) ay)) 2.10))))))))))))

(define (l2-addon-retry-ready? ctx fac addon-sym)
  (define live-game? (l2-ctx-live-obs-harvesters? ctx))
  (cond
    [(not live-game?) #t]
    [(l2-addon-pad-blocked? ctx fac) #f]
    [else
     (define rt (l2-ctx-rt ctx))
     (define frame (l2-ctx-frame ctx))
     (define st (and rt (rt-l2-addon-fail-state rt)))
     (when (and st (<= frame 4))
       (hash-clear! st))
     (define fid (hash-ref fac 'id -1))
     (define rec (and st (exact-integer? fid) (> fid 0)
                      (hash-ref st (cons fid addon-sym) #f)))
     (if (not (vector? rec))
         #t
         (let* ([last-f (vector-ref rec 0)]
                [fails (vector-ref rec 1)]
                [dt (- frame last-f)]
                [req-cd (cond
                          [(>= fails 3) 1344]
                          [(= fails 2) 448]
                          [(= fails 1) 160]
                          [else 36])])
           (or (< dt 0) (>= dt req-cd))))]))

(define (l2-addon-record-emit! ctx fac addon-sym)
  (define live-game? (l2-ctx-live-obs-harvesters? ctx))
  (when live-game?
    (define rt (l2-ctx-rt ctx))
    (define frame (l2-ctx-frame ctx))
    (define st (and rt (rt-l2-addon-fail-state rt)))
    (define fid (hash-ref fac 'id -1))
    (when (and st (exact-integer? fid) (> fid 0))
      (define key (cons fid addon-sym))
      (define prev (hash-ref st key #f))
      (define next-fails
        (if (and (vector? prev)
                 (>= (- frame (vector-ref prev 0)) 0)
                 (< (- frame (vector-ref prev 0)) 2000))
            (min 4 (add1 (vector-ref prev 1)))
            0))
      (hash-set! st key (vector frame next-fails)))))

(define (l2-grounded-bare-facility ctx sym [addon-sym #f])
  (define ally-bldgs (l2-ctx-ally-bldgs ctx))
  (define claimed-addon-fac-ids (l2-ctx-claimed-addon-fac-ids ctx))
  (define frame (l2-ctx-frame ctx))
  (define live-game? (l2-ctx-live-obs-harvesters? ctx))
  (define oledger (l2-ctx-oledger ctx))
       (for/first ([b (in-list ally-bldgs)]
                   #:when (and (eq? (unit-type-sym b) sym)
                               (l2-building-grounded-and-powered? ctx b)
                               (>= (hash-ref b 'build-progress 1.0) SC2-BUILD-COMPLETE-PROGRESS)
                               (or (not live-game?) (= (hash-ref b 'order-count 0) 0))
                               (not (l2-terran-facility-has-addon? ctx b))
                               (not (l2-facility-being-swapped? ctx b))
                               (not (set-member? claimed-addon-fac-ids (hash-ref b 'id -1)))
                               (or (not live-game?)
                                   (not (order-ledger-facility-busy? oledger b frame)))
                               (or (not addon-sym)
                                   (l2-addon-retry-ready? ctx b addon-sym))))
         b))

;; Estimate 3-second mineral and gas income so priority escrows pause idle production only when < 3s away.
(define (l2-income-3s-minerals-gas ctx)
  (define obs (l2-ctx-obs ctx))
  (define total-w (l2-ctx-total-workers ctx))
  (define ready-bldgs (l2-ctx-ready-bldg-types ctx))
  (define min-w
    (max 1 (hash-ref obs 'mineral-harvesters
                     (max 1 (- total-w (* 3 (length (l2-ctx-active-refineries ctx))))))))
  (define gas-w
    (max 0 (hash-ref obs 'gas-harvesters (* 3 (length (l2-ctx-active-refineries ctx))))))
  (define mule-bonus (if (memq 'orbital-command ready-bldgs) 8.0 0.0))
  (values (+ 10.0 (* 2.8 min-w) mule-bonus)
          (+ 3.0 (* 3.75 gas-w))))

(define (l2-imminent-escrow-needed? ctx target-min [target-gas 0])
  (define-values (m3 g3) (l2-income-3s-minerals-gas ctx))
  (define missing-m (max 0 (- target-min (l2-ctx-minerals ctx))))
  (define missing-g (max 0 (- target-gas (l2-ctx-gas ctx))))
  (and (<= missing-m m3)
       (<= missing-g g3)))

(define (l2-holding-for-first-starport? ctx)
  (define cur-escrow-age-frames (l2-ctx-cur-escrow-age-frames ctx))
  (define early-survival-crisis? (l2-ctx-early-survival-crisis? ctx))
  (define escrow-suppressed-active? (l2-ctx-escrow-suppressed-active? ctx))
  (define live-game? (l2-ctx-live-obs-harvesters? ctx))
  (define max-escrow-timeout-frames (l2-ctx-max-escrow-timeout-frames ctx))
  (define ready-bldg-types (l2-ctx-ready-bldg-types ctx))
  (define terran-cannon-breakout-mode? (l2-ctx-terran-cannon-breakout-mode? ctx))
  (define terran-saving-for-expand? (l2-ctx-terran-saving-for-expand? ctx))
  (define under-base-attack? (l2-ctx-under-base-attack? ctx))
       (and live-game?
            (memq 'factory ready-bldg-types)
            (not terran-cannon-breakout-mode?)
            (not terran-saving-for-expand?)
            (not early-survival-crisis?)
            (not under-base-attack?)
            (not escrow-suppressed-active?)
            (< cur-escrow-age-frames max-escrow-timeout-frames)
            (not (l2-building-present-or-pending? ctx 'starport))
            (not (l2-build-issue-blocked? ctx 'starport))
            (or (eq? (l2-ctx-active-escrow-sym ctx) 'starport)
                (l2-imminent-escrow-needed? ctx (sc2-min-cost 'starport) (sc2-gas-cost 'starport)))))

(define (l2-starport-escrow-ok? ctx m-cost g-cost)
       (or (not (l2-holding-for-first-starport? ctx))
           (and (>= (- (l2-ctx-minerals ctx) m-cost) (sc2-min-cost 'starport))
                (or (<= g-cost 0)
                    (>= (- (l2-ctx-gas ctx) g-cost) (sc2-gas-cost 'starport))))))

(define (l2-phase1-setup! ctx rt raw-obs orig-raw-obs sanitized?)
  (set-l2-ctx-rt! ctx rt)
  (set-l2-ctx-raw-obs! ctx raw-obs)
  (set-l2-ctx-orig-raw-obs! ctx orig-raw-obs)
  (define obs (if sanitized? raw-obs (sanitize-obs-hash raw-obs)))
  (set-l2-ctx-obs! ctx obs)
  (define raw-rt-race (live-bot-runtime-actual-race rt))
  (define race
    (if (eq? raw-rt-race 'Random)
        (detect-actual-race-from-obs obs 'Zerg)
        raw-rt-race))
  (set-l2-ctx-race! ctx race)
  (define frame (hash-ref obs 'frame 0))
  (set-l2-ctx-frame! ctx frame)
  (set-l2-ctx-minerals! ctx (hash-ref obs 'minerals 200))
  (set-l2-ctx-gas! ctx (hash-ref obs 'gas SC2-STARTING-GAS))
  (define supply-used (hash-ref obs 'supply-used SC2-STARTING-WORKERS))
  (set-l2-ctx-supply-used! ctx supply-used)
  (define supply-cap (hash-ref obs 'supply-cap SC2-TOWN-HALL-SUPPLY-PROVIDED))
  (set-l2-ctx-supply-cap! ctx supply-cap)
  (set-l2-ctx-pending-supply! ctx (hash-ref obs 'pending-supply 0))
  (set-l2-ctx-supply-left! ctx (hash-ref obs 'supply-left (- supply-cap supply-used)))
  (define ally-units (hash-ref obs 'ally-units '()))
  (set-l2-ctx-ally-units! ctx ally-units)
  (define ally-bldgs (hash-ref obs 'ally-buildings '()))
  (set-l2-ctx-ally-bldgs! ctx ally-bldgs)
  (define enemy-units (hash-ref obs 'enemy-units '()))
  (set-l2-ctx-enemy-units! ctx enemy-units)
  (define enemy-bldgs (hash-ref obs 'enemy-buildings '()))
  (set-l2-ctx-enemy-bldgs! ctx enemy-bldgs)
  (define base-x (hash-ref obs 'base-x SC2-DEFAULT-HOME-BASE-X))
  (set-l2-ctx-base-x! ctx base-x)
  (define base-y (hash-ref obs 'base-y SC2-DEFAULT-HOME-BASE-Y))
  (set-l2-ctx-base-y! ctx base-y)
  (define nat-x (hash-ref obs 'natural-x SC2-DEFAULT-NATURAL-X))
  (set-l2-ctx-nat-x! ctx nat-x)
  (define nat-y (hash-ref obs 'natural-y SC2-DEFAULT-NATURAL-Y))
  (set-l2-ctx-nat-y! ctx nat-y)
  (define third-x (hash-ref obs 'third-x SC2-DEFAULT-THIRD-X))
  (set-l2-ctx-third-x! ctx third-x)
  (define third-y (hash-ref obs 'third-y SC2-DEFAULT-THIRD-Y))
  (set-l2-ctx-third-y! ctx third-y)
  (define enemy-x (hash-ref obs 'enemy-x SC2-DEFAULT-ENEMY-BASE-X))
  (set-l2-ctx-enemy-x! ctx enemy-x)
  (define enemy-y (hash-ref obs 'enemy-y SC2-DEFAULT-ENEMY-BASE-Y))
  (set-l2-ctx-enemy-y! ctx enemy-y)
  (set-l2-ctx-actions! ctx '())
  (define protoss-powered-structure-syms
    SC2-PROTOSS-PYLON-POWERED-STRUCTURE-SYMS)
  (set-l2-ctx-bldg-types! ctx
    (for/list ([b (in-list ally-bldgs)])
      (fast-canonical-structure-sym (unit-type-sym b))))
  (define-values (unit-types raw-workers workers obs-frozen-workers)
    (for/fold ([ut-rev '()] [rw-rev '()] [w-rev '()] [frozen-cnt 0]
               #:result (values (reverse ut-rev)
                                (reverse rw-rev)
                                (reverse w-rev)
                                frozen-cnt))
              ([u (in-list ally-units)])
      (define ut (unit-type-sym u))
      (define ut-rev2 (cons ut ut-rev))
      (if (memq ut '(drone probe scv))
          (if (l2-unit-stasis-frozen? ctx u)
              (values ut-rev2 (cons u rw-rev) w-rev (+ frozen-cnt 1))
              (values ut-rev2 (cons u rw-rev) (cons u w-rev) frozen-cnt))
          (values ut-rev2 rw-rev w-rev frozen-cnt))))
  (set-l2-ctx-unit-types! ctx unit-types)
  (set-l2-ctx-workers! ctx workers)
  (define frozen-worker-count
    (max obs-frozen-workers
         (safe-nonneg-int (hash-ref obs 'stasis-frozen-worker-count 0) 0)))
  (define active-worker-count
    (if (<= (length raw-workers) 2)
        (let ([harv-active (+ (safe-nonneg-int (hash-ref obs 'mineral-harvesters 0) 0)
                              (safe-nonneg-int
                               (hash-ref obs 'vespene-harvesters
                                         (lambda () (hash-ref obs 'gas-harvesters 0)))
                               0))]
              [unit-or-food (max (length raw-workers)
                                 (safe-nonneg-int (hash-ref obs 'food-workers 0) 0))])
          (max 0 (max harv-active (- unit-or-food frozen-worker-count))))
        (max 0 (- (length raw-workers) frozen-worker-count))))
  (set-l2-ctx-active-worker-count! ctx active-worker-count)
  (define pending-workers (hash-ref obs 'pending-workers 0))
  (set-l2-ctx-pending-workers! ctx pending-workers)
  (define total-workers (+ active-worker-count pending-workers))
  (set-l2-ctx-total-workers! ctx total-workers)
  (when (> frozen-worker-count 0)
    (l2-emit! ctx (list 'stasis-worker-stoppage-compensation frozen-worker-count)))
  (define cd-tracker (live-bot-runtime-cooldown-tracker rt))
  (set-l2-ctx-cd-tracker! ctx cd-tracker)
  (define leases (rt-role-leases rt))
  (set-l2-ctx-leases! ctx leases)
  (define oledger-early (live-bot-runtime-order-ledger rt))
  (set-l2-ctx-oledger-early! ctx oledger-early)
  (define map-grids (hash-ref obs 'map-grids #f))
  (set-l2-ctx-map-grids! ctx map-grids)
  (define step-mineral-patches
    (let ([raw (hash-ref obs 'mineral-patches '())])
      (cond
        [(or (not (list? raw)) (null? raw)) '()]
        [(for/and ([m (in-list raw)])
           (and (hash? m) (or (hash-has-key? m 'type) (hash-has-key? m 'unit-type-id))))
         raw]
        [else
         (for/list ([m (in-list raw)] #:when (hash? m))
           (if (or (hash-has-key? m 'type) (hash-has-key? m 'unit-type-id))
               m
               (hash-set m 'type 'mineral-field)))])))
  (set-l2-ctx-step-mineral-patches! ctx step-mineral-patches)
  (define step-geysers
    (let ([raw (hash-ref obs 'geysers '())])
      (cond
        [(or (not (list? raw)) (null? raw)) '()]
        [(for/and ([g (in-list raw)]) (hash? g)) raw]
        [else (for/list ([g (in-list raw)] #:when (hash? g)) g)])))
  (set-l2-ctx-step-geysers! ctx step-geysers)
  (define step-neutral-units
    (let ([raw (hash-ref obs 'neutral-units '())])
      (cond
        [(and (list? raw) (pair? raw))
         (if (for/and ([u (in-list raw)]) (hash? u))
             raw
             (for/list ([u (in-list raw)] #:when (hash? u)) u))]
        [(null? step-geysers) step-mineral-patches]
        [(null? step-mineral-patches) step-geysers]
        [else (append step-mineral-patches step-geysers)])))
  (set-l2-ctx-step-neutral-units! ctx step-neutral-units)
  (define expansion-pads
    (let ([raw-pads (hash-ref obs 'expansion-candidates #f)])
      (if (and (list? raw-pads) (pair? raw-pads))
          raw-pads
          (list (cons nat-x nat-y) (cons third-x third-y)))))
  (set-l2-ctx-expansion-pads! ctx expansion-pads)
  (for ([w (in-list workers)])
    (define wid (hash-ref w 'id 0))
    (when (and (> wid 0)
               (or (worker-has-engine-build-order? w)
                   (order-ledger-unit-has-active-build? oledger-early wid w)))
      (acquire-unit-lease! leases wid 'builder frame 24
                           #:x (hash-ref w 'x base-x)
                           #:y (hash-ref w 'y base-y))))
  (when (<= frame 4)
    (set-box! (rt-enemy-race-box rt) 'Unknown)
    (set-box! (rt-initial-enemy-race-box rt) #f)
    (set-box! (rt-experiment-box rt) #f)
    (hash-clear! (rt-simcity-cache rt))
    (set-box! (rt-sit-plan-cache rt) #f))
  (define raw-req-race
    (let ([req (hash-ref obs 'opponent-requested-race
                         (hash-ref obs 'enemy-race 'Random))])
      (case req
        [(Zerg zerg "Zerg" "zerg") 'Zerg]
        [(Protoss protoss "Protoss" "protoss") 'Protoss]
        [(Terran terran "Terran" "terran") 'Terran]
        [else 'Random])))
  (when (and (not (unbox (rt-initial-enemy-race-box rt)))
             (or (not (eq? (hash-ref raw-obs 'mineral-harvesters RUNTIME-MISSING) RUNTIME-MISSING))
                 (not (eq? (hash-ref obs 'opponent-requested-race RUNTIME-MISSING) RUNTIME-MISSING))
                 (not (eq? (hash-ref obs 'enemy-race RUNTIME-MISSING) RUNTIME-MISSING))))
    (set-box! (rt-initial-enemy-race-box rt) raw-req-race))
  (define initial-enemy-race
    (or (unbox (rt-initial-enemy-race-box rt)) raw-req-race))
  (set-l2-ctx-initial-enemy-race! ctx initial-enemy-race)
  (define scouted-enemy-race
    (let ([seen-z #f] [seen-t #f] [seen-p #f])
      (define (scan-list! lst)
        (for ([e (in-list lst)] #:break seen-z)
          (when (and (hash? e)
                     (not (eq? (hash-ref e 'is-hallucination #f) #t))
                     (not (eq? (hash-ref e 'hallucination #f) #t))
                     (not (eq? (hash-ref e 'hallucination? #f) #t))
                     (not (eq? (hash-ref e 'changeling? #f) #t)))
            (define r (hash-ref ENEMY-RACE-BY-CANON-HT (fast-canonical-unit-sym (unit-type-sym e)) #f))
            (case r
              [(Zerg) (set! seen-z #t)]
              [(Terran) (unless seen-t (set! seen-t #t))]
              [(Protoss) (unless seen-p (set! seen-p #t))]))))
      (scan-list! enemy-units)
      (unless seen-z (scan-list! enemy-bldgs))
      (cond [seen-z 'Zerg]
            [seen-t 'Terran]
            [seen-p 'Protoss]
            [else 'Unknown])))
  (when (memq scouted-enemy-race '(Zerg Terran Protoss))
    (set-box! (rt-enemy-race-box rt) scouted-enemy-race))
  (define effective-enemy-race
    (let ([known (if (memq scouted-enemy-race '(Zerg Terran Protoss))
                     scouted-enemy-race
                     (unbox (rt-enemy-race-box rt)))])
      (if (memq known '(Zerg Terran Protoss))
          known
          raw-req-race)))
  (set-l2-ctx-effective-enemy-race! ctx effective-enemy-race)
  (define townhall-bldg-cnt
    (for/sum ([ab (in-list ally-bldgs)])
      (if (memq (fast-canonical-structure-sym (unit-type-sym ab))
                '(command-center orbital-command planetary-fortress nexus hatchery lair hive))
          1
          0)))
  (define raw-obs-live-harvesters? (hash-has-key? raw-obs 'mineral-harvesters))
  (define self-canceled-bldg-ids (make-hasheqv))
  (define early-ally-zealot-cnt
    (if (and raw-obs-live-harvesters? (< frame 3600))
        (count (lambda (u) (and (hash? u) (eq? (unit-type-sym u) 'zealot))) ally-units)
        0))
  (define early-ally-marine-cnt
    (if (and raw-obs-live-harvesters? (< frame 3600))
        (count (lambda (u) (and (hash? u) (eq? (unit-type-sym u) 'marine))) ally-units)
        0))
  (for ([b (in-list ally-bldgs)])
    (define-values (prog vitality-pct expected-vitality-pct)
      (l2-bldg-shield-inclusive-vitality-pct b))
    (define bx (hash-ref b 'x base-x))
    (define by (hash-ref b 'y base-y))
    (define canon-bt (fast-canonical-structure-sym (unit-type-sym b)))
    (define main-townhall?
      (and (memq canon-bt
                 '(command-center orbital-command planetary-fortress nexus hatchery lair hive))
           (or (<= (fast-dist2d bx by base-x base-y) 8.0)
               (and raw-obs-live-harvesters? (<= townhall-bldg-cnt 1)))))
    ;; W5-EARLY-1: Cancel exposed in-progress Natural Nexus/CC (<65% progress, >10t from main)
    ;; if >=6 enemy Zerglings swarm it before 2:40 with insufficient defenders (saves 300M!).
    (define early-nat-ling-flood-cancel?
      (and raw-obs-live-harvesters?
           (< frame 3600)
           (< prog 0.65)
           (> prog 0.01)
           (not main-townhall?)
           (> (fast-dist2d bx by base-x base-y) 10.0)
           (or (and (eq? canon-bt 'nexus) (< early-ally-zealot-cnt 2))
               (and (eq? canon-bt 'command-center) (< early-ally-marine-cnt 4)))
           (>= (count (lambda (e)
                        (and (hash? e)
                             (eq? (unit-type-sym e) 'zergling)
                             (<= (fast-dist2d bx by (hash-ref e 'x 9999.0) (hash-ref e 'y 9999.0)) 9.5)))
                      enemy-units)
               6)))
    (when (or early-nat-ling-flood-cancel?
              (and (< prog SC2-BUILD-COMPLETE-PROGRESS)
                   (> prog 0.20)
                   (< vitality-pct (* 0.30 expected-vitality-pct))
                   (< vitality-pct 0.12)))
      (define under-fire?
        (or early-nat-ling-flood-cancel?
            (and (not raw-obs-live-harvesters?)
                 (eq? (hash-ref b 'under-attack #f) #t))
            (l2-enemy-weapon-attacker-within? bx by 8.5 enemy-units)))
      (when (and under-fire?
                 (not (and main-townhall?
                           (or (>= vitality-pct 0.05) (> prog 0.25))))
                 ;; L55-T5 (`#25 onlyfans`): Never self-cancel half-built static detectors
                 ;; (`spore-crawler`, `missile-turret`, `photon-cannon`) at `>= 45%` progress
                 ;; and `>= 6%` vitality under harass (cancelling leaves the base blind!).
                 (not (and (memq canon-bt '(spore-crawler missile-turret photon-cannon))
                           (>= prog 0.45)
                           (>= vitality-pct 0.06))))
        (define cancel-cd-key (fast-save-cancel-rebuild-key canon-bt))
        (refractory-allow-action?! cd-tracker cancel-cd-key frame 96)
        (when (and (refractory-cooldown-tracker? cd-tracker)
                   (hash? (refractory-cooldown-tracker-table cd-tracker)))
          (hash-set! (refractory-cooldown-tracker-table cd-tracker) cancel-cd-key frame))
        (l2-record-contested-site! ctx canon-bt bx by)
        (define bid (hash-ref b 'id 701))
        (when (and (exact-integer? bid) (> bid 0))
          (hash-set! self-canceled-bldg-ids bid #t))
        (l2-emit! ctx (list 'cancel bid)))))
  ;; Track destroyed buildings under active enemy fire as contested sites (`#5134177`)
  (when (and rt raw-obs-live-harvesters?)
    (define prev-bldgs (rt-prev-ally-bldgs rt))
    (when (<= frame 4) (hash-clear! prev-bldgs))
    (define cur-bldg-ids (make-hasheqv))
    (for ([b (in-list ally-bldgs)] #:when (hash? b))
      (define bid (hash-ref b 'id -1))
      (when (and (exact-integer? bid) (> bid 0))
        (hash-set! cur-bldg-ids bid #t)))
    (define dead-tags-l2
      (let ([dt (or (let ([v (hash-ref obs 'dead-unit-tags #f)]) (and (pair? v) v))
                    (hash-ref obs 'dead-tags '()))])
        (for/seteqv ([x (in-list dt)] #:when (exact-integer? x)) x)))
    (for ([(old-id old-vec) (in-hash prev-bldgs)])
      (when (and (not (hash-has-key? cur-bldg-ids old-id))
                 (vector? old-vec))
        (define old-cs (vector-ref old-vec 0))
        (define old-x (vector-ref old-vec 1))
        (define old-y (vector-ref old-vec 2))
        (when (and (or (set-member? dead-tags-l2 old-id)
                       (l2-active-enemy-combat-within? enemy-units old-x old-y 12.0))
                   (l2-active-enemy-combat-within? enemy-units old-x old-y 14.0))
          (l2-record-contested-site! ctx old-cs old-x old-y)
          (when (and (refractory-cooldown-tracker? cd-tracker)
                     (hash? (refractory-cooldown-tracker-table cd-tracker)))
            (define tbl (refractory-cooldown-tracker-table cd-tracker))
            (define rkey (fast-save-cancel-rebuild-key old-cs))
            (define prev-cf (hash-ref tbl rkey #f))
            (unless (and (exact-integer? prev-cf) (<= 0 (- frame prev-cf)) (< (- frame prev-cf) 16))
              (hash-set! tbl rkey frame))))))
    (hash-clear! prev-bldgs)
    (for ([b (in-list ally-bldgs)] #:when (hash? b))
      (define bid (hash-ref b 'id -1))
      (when (and (exact-integer? bid)
                 (> bid 0)
                 (not (hash-has-key? self-canceled-bldg-ids bid)))
        (hash-set! prev-bldgs bid
                   (vector (fast-canonical-structure-sym (unit-type-sym b))
                           (exact->inexact (hash-ref b 'x base-x))
                           (exact->inexact (hash-ref b 'y base-y)))))))
  (set-l2-ctx-uncontested-zerg-hatch-cache! ctx 'uninit)
  (define enemy-gas-steals
    (filter (lambda (eb)
              (and (memq (unit-type-sym eb) '(assimilator extractor refinery))
                   (<= (dist2d base-x base-y (hash-ref eb 'x 9999) (hash-ref eb 'y 9999))
                       SC2-GAS-STEAL-RADIUS)))
            enemy-bldgs))
  (for ([eg (in-list enemy-gas-steals)])
    (l2-emit! ctx (list 'clear-gas-steal
                 (hash-ref eg 'id 901)
                 (hash-ref eg 'x (safe-coord (+ base-x 3.0)))
                 (hash-ref eg 'y (safe-coord (+ base-y 3.0))))))
  (define live-obs-harvesters? (hash-has-key? raw-obs 'mineral-harvesters))
  (set-l2-ctx-live-obs-harvesters?! ctx live-obs-harvesters?)
  (define prev-tel-early
    (let ([t (live-bot-runtime-last-telemetry rt)])
      (if (hash? t) t (hash))))
  (set-l2-ctx-prev-tel-early! ctx prev-tel-early)
  (define townhalls
    (for/list ([b (in-list ally-bldgs)]
               #:when (memq (fast-canonical-structure-sym (unit-type-sym b))
                            '(hatchery lair hive nexus command-center orbital-command planetary-fortress)))
      b))
  (set-l2-ctx-townhalls! ctx townhalls)
  (define active-bases (max 1 (length townhalls)))
  (set-l2-ctx-active-bases! ctx active-bases)
  (define early-race-th-sym
    (case race
      [(Zerg) 'hatchery]
      [(Protoss) 'nexus]
      [else 'command-center]))
  (set-l2-ctx-early-race-th-sym! ctx early-race-th-sym)
  (define th-coords
    (let loop ([rem (if (list? townhalls) townhalls '())] [acc '()])
      (if (null? rem)
          (reverse acc)
          (let* ([b (car rem)]
                 [bx (and (hash? b) (hash-ref b 'x #f))]
                 [by (and bx (hash-ref b 'y #f))])
            (loop (cdr rem)
                  (if (and bx by)
                      (cons (cons bx by) acc)
                      (if (and (hash? b) (hash-has-key? b 'x) (hash-has-key? b 'y))
                          (cons (cons (hash-ref b 'x base-x) (hash-ref b 'y base-y)) acc)
                          acc)))))))
  (define owned-base-coords
    (cons (cons base-x base-y)
          (if (>= active-bases 2)
              (cons (cons nat-x nat-y)
                    (if (>= active-bases 3)
                        (cons (cons third-x third-y) th-coords)
                        th-coords))
              (if (>= active-bases 3)
                  (cons (cons third-x third-y) th-coords)
                  th-coords))))
  (set-l2-ctx-owned-base-coords! ctx owned-base-coords)
  (define ally-combat-units
    (for/list ([u (in-list ally-units)]
               #:when (combat-unit-record? u))
      u))
  (set-l2-ctx-ally-combat-units! ctx ally-combat-units)
