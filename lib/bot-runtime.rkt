         (not enemy-within-14-of-main?)
         (not enemy-main-cleared-eval?)
         (not decisive-victory-posture?)
         (not owm-sh-cooldown?)
         (not army-in-direct-visible-contact?)
         (< supply-used-eval 165)
         (< our-combat-sup-eval 65.0)
