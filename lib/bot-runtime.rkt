                              hydralisk-den lurker-den spire infestation-pit ultralisk-cavern
                              nydus-network engineering-bay armory ghost-academy fusion-core))
              (record-bs! cbt))))
        (let ([ords (hash-ref w 'orders '())])
          (when (list? ords)
            (for ([o (in-list ords)])
              (cond
