        (and (>= (length nexuses) 2)
             (>= live-army-supply 16)
             (>= (length gateways) (if (>= (length nexuses) 3) 6 4))
             (or (>= frame 4480)
                 (and (>= frame 3360)
                      (>= eff-phase-supply 46))))))
  (define protoss-holding-forge-min?
       (and protoss-forge-timing-ok?
            (memq 'cybernetics-core ready-bldg-types)
