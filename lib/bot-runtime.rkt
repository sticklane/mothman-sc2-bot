          (+ v (fast-res-cost-50 et)))))
  (define l65f-eff-enemy-val (max l65f-vis-enemy-val owm-believed-val))
  (define l65f-strength-ratio
    (if (> l65f-eff-enemy-val 0)
        (fl/ (exact->inexact our-combat-val) (exact->inexact l65f-eff-enemy-val))
        1.0))
  (when (hash? (l34-ctx-l34-sc ctx))
    (hash-set! (l34-ctx-l34-sc ctx) 'l20-mass-staging-active? mass-parity-before-attack-suppress?)
    (hash-set! (l34-ctx-l34-sc ctx) 'l25-counter-volley-staging? l25-counter-volley-staging?)
    (hash-set! (l34-ctx-l34-sc ctx) 'l25-enemy-within-14-of-main? enemy-within-14-of-main?)
    (hash-set! (l34-ctx-l34-sc ctx) 'l35-siege-tempest-mass-hold? l35-siege-tempest-mass-hold?)
    (hash-set! (l34-ctx-l34-sc ctx) 'l35-siege-breakout-sup-req l35-siege-breakout-sup-req)
    (hash-set! (l34-ctx-l34-sc ctx) 'l36-prod-parity-mass-hold? l36-prod-parity-mass-hold?)
    (hash-set! (l34-ctx-l34-sc ctx) 'l42-pvt-awaiting-colossus-hold? l42-pvt-awaiting-colossus-hold?)
    (hash-set! (l34-ctx-l34-sc ctx) 'l43-tvt-tank-viking-parity-hold? l43-tvt-tank-viking-parity-hold?)
    (hash-set! (l34-ctx-l34-sc ctx) 'l64-fallback-x l64-fb-x)
    (hash-set! (l34-ctx-l34-sc ctx) 'l64-fallback-y l64-fb-y)
    (hash-set! (l34-ctx-l34-sc ctx) 'l64-defensive-muster-active? l64-defensive-muster-active?)
    (hash-set! (l34-ctx-l34-sc ctx) 'l64-local-push-val l64-local-push-val)
    (hash-set! (l34-ctx-l34-sc ctx) 'l65f-strength-ratio l65f-strength-ratio)
    (hash-set! (l34-ctx-l34-sc ctx) 'l64-direct-core-threat? l64-direct-core-threat?))
  (when rt
    (hash-set! (rt-door-state rt) 'l35-siege-tempest-mass-hold? l35-siege-tempest-mass-hold?)
    (hash-set! (rt-door-state rt) 'l35-siege-breakout-sup-req l35-siege-breakout-sup-req)
    (hash-set! (rt-door-state rt) 'l36-prod-parity-mass-hold? l36-prod-parity-mass-hold?)
    (hash-set! (rt-door-state rt) 'l42-pvt-awaiting-colossus-hold? l42-pvt-awaiting-colossus-hold?)
    (hash-set! (rt-door-state rt) 'l43-tvt-tank-viking-parity-hold? l43-tvt-tank-viking-parity-hold?)
    (hash-set! (rt-door-state rt) 'l64-fallback-prev-pt l64-fb-pt)
    (hash-set! (rt-door-state rt) 'l64-fallback-last-frame frame)
    (hash-set! (rt-door-state rt) 'l64-def-muster-active? l64-defensive-muster-active?)
    (when (and l64-defensive-muster-active? (not l64-prev-muster-active?))
      (hash-set! (rt-door-state rt) 'l64-def-muster-start-frame frame))
    (when (and l64-muster-timeout? (not l64-defensive-muster-active?))
      (hash-set! (rt-door-state rt) 'l64-def-muster-cd-until (+ frame 168)))
    ;; Loop 65F (`#1920`/`#1922`/`#1930`): Record last frame of GENUINE active combat contact
    ;; (`<= 9.0t` close combat OR firing `weapon-cooldown > 0` within `<= 12.0t` of live combat
    ;; enemy), NOT passive `12.8t-16t` proximity, so post-skirmish squads don't die to passive `MOVE`.
    (when (and (l34-ctx-live-obs? ctx)
               (pair? combat-units)
               (pair? enemy-units)
               (let ([ec-pts
                      (for/list ([e (in-list enemy-units)]
                                 #:when (and (hash? e)
                                             (combat-unit-record? e)
                                             (not (eq? (hash-ref e 'snapshot? #f) #t))
                                             (eqv? (hash-ref e 'display-type 1) 1)
                                             (real? (hash-ref e 'x #f)) (real? (hash-ref e 'y #f))))
                        (cons (exact->inexact (hash-ref e 'x 0.0))
                              (exact->inexact (hash-ref e 'y 0.0))))])
                 (and (pair? ec-pts)
                      (for/or ([u (in-list combat-units)])
                        (and (hash? u) (real? (hash-ref u 'x #f)) (real? (hash-ref u 'y #f))
                             (let* ([ux0 (exact->inexact (hash-ref u 'x 0.0))]
                                    [uy0 (exact->inexact (hash-ref u 'y 0.0))]
                                    [raw-wcd (hash-ref u 'weapon-cooldown (hash-ref u 'weapon_cooldown 0.0))]
                                    [firing-now? (and (real? raw-wcd) (fl> (exact->inexact raw-wcd) 0.0))]
                                    [lim2 (if firing-now? 144.0 81.0)])
                               (for/or ([ep (in-list ec-pts)])
                                 (define dx (fl- ux0 (car ep)))
                                 (define dy (fl- uy0 (cdr ep)))
                                 (fl<= (fl+ (fl* dx dx) (fl* dy dy)) lim2))))))))
      (hash-set! (rt-door-state rt) 'l65f-last-contact-frame frame)))
  ;; L27-P0-3 / L30-P0-3 (`#14/#23` `OBRet -> 0`): Treat army OR active visible threat within `32.0t`
  ;; (`1024.0`) of ANY friendly TownHall (incl. lifted CCs/OCs) / base / natural OR `24.0t` (`576.0`)
  ;; of ANY friendly production/tech/home building as owned territory so home fights never log `'retreat`!
  (define within-28-of-any-ally-th?
    (let ([acx (exact->inexact (l34-ctx-prelim-army-cx ctx))]
          [acy (exact->inexact (l34-ctx-prelim-army-cy ctx))])
      (and (or (pair? home-anchor-ths) (pair? home-bldg-coords))
           (or (for/or ([tc (in-list home-anchor-ths)])
                 (define dx (fl- acx (car tc)))
                 (define dy (fl- acy (cdr tc)))
                 (fl<= (fl+ (fl* dx dx) (fl* dy dy)) 1024.0))
               (for/or ([bc (in-list home-bldg-coords)])
                 (define dx (fl- acx (car bc)))
                 (define dy (fl- acy (cdr bc)))
                 (fl<= (fl+ (fl* dx dx) (fl* dy dy)) 576.0))
               (for/or ([e (in-list enemy-units)])
                 (and (hash? e)
                      (combat-unit-record? e)
                      (not (eq? (hash-ref e 'snapshot? #f) #t))
                      (eqv? (hash-ref e 'display-type 1) 1)
                      (real? (hash-ref e 'x #f))
                      (real? (hash-ref e 'y #f))
                      (let ([ex (exact->inexact (hash-ref e 'x 9999.0))]
                            [ey (exact->inexact (hash-ref e 'y 9999.0))])
                        (or (for/or ([tc (in-list home-anchor-ths)])
                              (define dx (fl- ex (car tc)))
                              (define dy (fl- ey (cdr tc)))
                              (fl<= (fl+ (fl* dx dx) (fl* dy dy)) 1024.0))
                            (for/or ([bc (in-list home-bldg-coords)])
                              (define dx (fl- ex (car bc)))
                              (define dy (fl- ey (cdr bc)))
                              (fl<= (fl+ (fl* dx dx) (fl* dy dy)) 576.0))))))))))
  (define army-at-home-eval?
    (or enemy-within-14-of-th?
        within-28-of-any-ally-th?
        (null? combat-units)
        (l34-point-in-owned-territory? ctx
                                       (l34-ctx-prelim-army-cx ctx)
                                       (l34-ctx-prelim-army-cy ctx))))
  (define fog-belief-suppress?
    (and owm-tactics
         (not enemy-within-14-of-th?)
         (not owm-sh-cooldown?)
         (not enemy-main-cleared-eval?)
         (not decisive-victory-posture?)
         (not all-mobile-retreatable?)
         (not forward-timing-window?)
         (< our-combat-sup-eval 55.0)
         (< supply-used-eval 155)
         (> owm-believed-val 550)
         (< (exact->inexact our-combat-val)
            (fl* commitment-risk-ratio-req (exact->inexact owm-believed-val)))))
  (cond
    [(or (null? combat-units) (null? eval-enemies))
     (define fog-only-suppress?
       (and (null? eval-enemies) (or fog-belief-suppress? mass-parity-before-attack-suppress?)))
     (define fog-suppress-now? (or locust-kite-retreat? fog-only-suppress?))
     (set-l34-ctx-combat-pred-ht! ctx #f)
     (set-l34-ctx-combat-pred-ratio! ctx (if (pair? combat-units) (if fog-suppress-now? 0.65 10.0) #f))
     (set-l34-ctx-combat-should-engage?! ctx (not fog-suppress-now?))
     (set-l34-ctx-enemy-within-14-of-th?! ctx enemy-within-14-of-th?)
     (set-l34-ctx-fog-belief-suppress?! ctx (and fog-only-suppress? (not locust-kite-retreat?)))
     (set-l34-ctx-combat-suppress-attack?! ctx fog-suppress-now?)
     (when rt
       (hash-set! (rt-door-state rt) 'l34-defending-home? enemy-within-14-of-th?)
       (hash-set! (rt-door-state rt) 'l34-army-at-home? army-at-home-eval?)
       (hash-set! (rt-door-state rt) 'l34-mass-staging? (and (null? eval-enemies) mass-parity-before-attack-suppress?)))]
    [else
     (define tb-mm (live-bot-runtime-mirror-mind rt))
     (define tb-mmtech (and tb-mm (mirror-mind-state-last-tech-observation tb-mm)))
     (define enemy-upgs
       (or (hash-ref obs 'enemy-upgrades #f)
           (and tb-mmtech (enemy-tech-observation-observed-upgrades tb-mmtech))
           '()))
     (define ally-sig (l34-summarize-for-combat-eval combat-units))
     (define enemy-sig (l34-summarize-for-combat-eval eval-enemies))
     (define pcache (rt-combat-pred-cache rt))
     (define pred-ht
       (if (and (vector-ref pcache 6)
                (eq? enemy-within-14-of-th? (vector-ref pcache 4))
                (equal? ally-sig (vector-ref pcache 0))
                (equal? enemy-sig (vector-ref pcache 1))
                (equal? researched-upgs (vector-ref pcache 2))
                (equal? enemy-upgs (vector-ref pcache 3)))
           (vector-ref pcache 6)
           (let ([res (combat:predict-engagement-outcome
                       (l34-sig->combat-hashes ally-sig)
                       (l34-sig->combat-hashes enemy-sig)
                       #:ally-upgrades researched-upgs
                       #:enemy-upgrades enemy-upgs
                       #:defending-home? enemy-within-14-of-th?)])
             (vector-set! pcache 0 ally-sig)
             (vector-set! pcache 1 enemy-sig)
             (vector-set! pcache 2 researched-upgs)
             (vector-set! pcache 3 enemy-upgs)
             (vector-set! pcache 4 enemy-within-14-of-th?)
             (vector-set! pcache 5 frame)
             (vector-set! pcache 6 res)
             res)))
     (define wstate (rt-wave-loss-state rt))
     (define pred-ratio-val (or (hash-ref pred-ht 'predicted-lanchester-ratio #f) 0.0))
     (define locally-winning-fight?
       (and (hash-ref pred-ht 'should-engage? #f)
            (real? pred-ratio-val)
            (>= pred-ratio-val 1.15)))
     (define pullback-active?
       (and (l34-ctx-live-obs? ctx)
            (not enemy-within-14-of-th?)
            (not locally-winning-fight?)
            (or (< frame (hash-ref wstate 'pullback-until-frame -1))
                (let ([est-e (hash-ref wstate 'est-enemy-army-supply 0.0)]
                      [our-s (hash-ref wstate 'combat-army-supply (or (l34-ctx-live-combat-supply ctx) 0.0))])
                  (and (> est-e 0.0) (< our-s (* 0.85 est-e)))))))
     (define engage?
       (and (not pullback-active?)
            (not locust-kite-retreat?)
            (or enemy-within-14-of-th?
                (hash-ref pred-ht 'should-engage? #t))
            #t))
     (define hard-suppress?
       (and (or (not engage?) pullback-active? locust-kite-retreat?)
            (not enemy-within-14-of-th?)))
     ;; L21-P0-3 / L25-P0-3 / L35-P0-3: Bypass cross-map mass-parity & counter-volley staging
     ;; whenever `locally-winning-fight?` is `#t`, EXCEPT under `l35-siege-tempest-mass-hold?`
     ;; (already gated on `not enemy-within-14-of-th?`, `not enemy-within-14-of-main?`, and
     ;; `not army-in-direct-visible-contact?`) so a lone forward scout never tricks a small wave
     ;; into marching across the map into 10..26 remembered Sieged Tanks or 13 Tempests!
     (define eff-mass-parity-suppress?
       (or l35-siege-tempest-mass-hold?
           l36-prod-parity-mass-hold?
           l42-pvt-awaiting-colossus-hold?
           l43-tvt-tank-viking-parity-hold?
           (and mass-parity-before-attack-suppress?
                (not locally-winning-fight?))))
     (define eff-l25-counter-volley-staging?
       (and l25-counter-volley-staging?
            (not locally-winning-fight?)))
     (when (hash? (l34-ctx-l34-sc ctx))
       (hash-set! (l34-ctx-l34-sc ctx) 'l20-mass-staging-active? eff-mass-parity-suppress?)
       (hash-set! (l34-ctx-l34-sc ctx) 'l25-counter-volley-staging? eff-l25-counter-volley-staging?))
     (define suppress?
       (or hard-suppress? eff-mass-parity-suppress?))
     (set-l34-ctx-combat-pred-ht! ctx pred-ht)
     (set-l34-ctx-combat-pred-ratio! ctx (hash-ref pred-ht 'predicted-lanchester-ratio #f))
     ;; L21-P0-3: NEVER clear `combat-should-engage?!` when visible enemies are within `22t` of ANY
     ;; friendly combat unit — cross-map staging must only hold distant marches, never tell units
     ;; standing next to enemies to hold fire!
     (set-l34-ctx-combat-should-engage?!
      ctx
      (and engage? (or enemy-within-22-of-any-combat? (not eff-mass-parity-suppress?))))
     (set-l34-ctx-enemy-within-14-of-th?! ctx enemy-within-14-of-th?)
     ;; When suppressed solely by cross-map mass-parity staging (not local retreat), mark
     ;; `fog-belief-suppress?` so local defense / in-contact micro stays crisp while distant
     ;; cross-map suicide runs stage and mass at natural/3rd!
     (set-l34-ctx-fog-belief-suppress?! ctx (and eff-mass-parity-suppress? (not hard-suppress?)))
     (set-l34-ctx-combat-suppress-attack?! ctx suppress?)
     (when rt
       (hash-set! (rt-door-state rt) 'l34-defending-home? enemy-within-14-of-th?)
       (hash-set! (rt-door-state rt) 'l34-army-at-home? army-at-home-eval?)
       (hash-set! (rt-door-state rt) 'l34-mass-staging? eff-mass-parity-suppress?))
     pred-ht]))

(define (l34-phase2-tbrain-drops! ctx)
  (l34-eval-combat-prediction! ctx)
  (define ally-bldgs (l34-ctx-ally-bldgs ctx))
  (define ally-units (l34-ctx-ally-units ctx))
  (define base-x (l34-ctx-base-x ctx))
  (define base-y (l34-ctx-base-y ctx))
  (define combat-pred-ratio (l34-ctx-combat-pred-ratio ctx))
  (define combat-should-engage? (l34-ctx-combat-should-engage? ctx))
  (define combat-suppress-attack? (l34-ctx-combat-suppress-attack? ctx))
  (define enemy-within-14-of-th? (l34-ctx-enemy-within-14-of-th? ctx))
  (define combat-units (l34-ctx-combat-units ctx))
  (define effects (l34-ctx-effects ctx))
  (define enemy-bldgs (l34-ctx-enemy-bldgs ctx))
  (define enemy-units (l34-ctx-enemy-units ctx))
  (define enemy-x (l34-ctx-enemy-x ctx))
  (define enemy-y (l34-ctx-enemy-y ctx))
  (define frame (l34-ctx-frame ctx))
  (define l34-sc (l34-ctx-l34-sc ctx))
  (define live-tactics-obs? (l34-ctx-live-tactics-obs? ctx))
  (define nat-x (l34-ctx-nat-x ctx))
  (define nat-y (l34-ctx-nat-y ctx))
  (define obs (l34-ctx-obs ctx))
  (define oledger (l34-ctx-oledger ctx))
  (define prelim-army-cx (l34-ctx-prelim-army-cx ctx))
  (define prelim-army-cy (l34-ctx-prelim-army-cy ctx))
  (define rt (l34-ctx-rt ctx))
  (define tbrain (l34-ctx-tbrain ctx))
  (define transport-tr (l34-ctx-transport-tr ctx))
  (define wave3-handled-tags (l34-ctx-wave3-handled-tags ctx))
  ;; Loop 63 (Anti-SwarmHost No-Locust-Chase): Kite out of free temporary Swarm Host Locust waves
  ;; whether OWM latched or visible Locusts are on screen right now — never chase timed-life Locusts
  ;; away from bases into traps when no Swarm Host is exposed (`<= 22t`)!
  (define owm-p2
    (and (or (l34-ctx-live-obs? ctx) (eq? (hash-ref obs 'enable-opponent-world-model #f) #t))
         rt
         (opponent-world-model-last-summary (rt-opponent-world-model rt))))
  (define p2-locust-units
    (if (and (pair? combat-units) (pair? enemy-units))
        (filter (lambda (e)
                  (and (hash? e)
                       (not (eq? (hash-ref e 'snapshot? #f) #t))
                       (hash-has-key? RUNTIME-LOCUST-SET (unit-type-sym e))))
                enemy-units)
        '()))
  (when (and (pair? combat-units)
             (pair? p2-locust-units)
             (or (and owm-p2 (opponent-world-summary-locust-wave-active? owm-p2))
                 (l34-ctx-live-obs? ctx)))
    (define p2-th-pts
      (for/list ([b (in-list ally-bldgs)]
                 #:when (and (hash? b)
                             (real? (hash-ref b 'x #f)) (real? (hash-ref b 'y #f))
                             (memq (fast-canonical-structure-sym (unit-type-sym b))
                                   '(hatchery lair hive nexus command-center orbital-command planetary-fortress))))
        (cons (exact->inexact (hash-ref b 'x base-x))
              (exact->inexact (hash-ref b 'y base-y)))))
    (define p2-perm-near-th?
      (and enemy-within-14-of-th?
           (for/or ([e (in-list enemy-units)])
             (and (hash? e)
                  (combat-unit-record? e)
                  (not (eq? (hash-ref e 'snapshot? #f) #t))
                  (not (hash-has-key? RUNTIME-LOCUST-SET (unit-type-sym e)))
                  (real? (hash-ref e 'x #f)) (real? (hash-ref e 'y #f))
                  (let ([ex0 (exact->inexact (hash-ref e 'x 9999.0))]
                        [ey0 (exact->inexact (hash-ref e 'y 9999.0))])
                    (for/or ([tp (in-list p2-th-pts)])
                      (fl<= (fast-dist2d ex0 ey0 (car tp) (cdr tp)) 14.0)))))))
    (define exposed-sh?
      (for/or ([e (in-list enemy-units)])
        (and (hash? e)
             (not (eq? (hash-ref e 'snapshot? #f) #t))
             (hash-has-key? RUNTIME-SWARM-HOST-SET (unit-type-sym e))
             (let ([ex0 (exact->inexact (hash-ref e 'x 9999.0))]
                   [ey0 (exact->inexact (hash-ref e 'y 9999.0))])
               (or (<= (dist2d prelim-army-cx prelim-army-cy ex0 ey0) 22.0)
                   (for/or ([u (in-list combat-units)])
                     (and (hash? u)
                          (real? (hash-ref u 'x #f)) (real? (hash-ref u 'y #f))
                          (<= (dist2d (exact->inexact (hash-ref u 'x 9999.0))
                                      (exact->inexact (hash-ref u 'y 9999.0))
                                      ex0 ey0)
                              18.0))))))))
    (when (and (not p2-perm-near-th?) (not exposed-sh?))
      (define kite-ids
        (for/list ([u (in-list combat-units)]
                   #:when (let ([uid (hash-ref u 'id -1)]
                                [ux (hash-ref u 'x base-x)]
                                [uy (hash-ref u 'y base-y)])
                            (and (exact-integer? uid)
                                 (> uid 0)
                                 (not (set-member? wave3-handled-tags uid))
                                 (> (dist2d ux uy nat-x nat-y) 8.0)
                                 (not (for/or ([tp (in-list p2-th-pts)])
                                        (<= (dist2d ux uy (car tp) (cdr tp)) 8.0)))
                                 (ormap (lambda (loc)
                                          (<= (dist2d ux uy (hash-ref loc 'x 9999.0) (hash-ref loc 'y 9999.0))
                                              16.0))
                                        p2-locust-units))))
          (define uid (hash-ref u 'id -1))
          (set-add! wave3-handled-tags uid)
          uid))
      (when (pair? kite-ids)
        (l34-emit-preserved! ctx (list 'move kite-ids nat-x nat-y)))))
  ;; ---------------------------------------------------------------------------
  ;; Multi-Depth Mirrored Tactical Micro Brain (0.5s, 2.0s, 5.0s Horizons)
  ;; ---------------------------------------------------------------------------
  (define-values (tbrain-actions tbrain-committed-tags _tbrain-decisions)
    (if (and (not (null? combat-units)) (not (null? enemy-units)))
        (let* ([tb-door (l34-ctx-door-st-tactics ctx)]
               [tb-disp (or (hash-ref obs 'bo-tactical-disposition #f)
                            (hash-ref obs 'tactical-disposition #f)
                            (and (hash? tb-door) (hash-ref tb-door 'bo-tactical-disposition #f)))]
               [tb-mm (live-bot-runtime-mirror-mind rt)]
               [tb-mmtech (and tb-mm (mirror-mind-state-last-tech-observation tb-mm))]
               [tb-eupgs (or (hash-ref obs 'enemy-upgrades #f)
                             (and tb-mmtech (enemy-tech-observation-observed-upgrades tb-mmtech))
                             '())]
               [tb-lr (or (hash-ref obs 'lanchester-ratio #f) combat-pred-ratio)])
          (step-tactical-mirror-brain! tbrain oledger obs
                                       #:record-ledger? #f
                                       #:tactical-disposition tb-disp
                                       #:lanchester-ratio tb-lr
                                       #:enemy-upgrades tb-eupgs
                                       #:combat-should-engage? combat-should-engage?
                                       #:defending-home? enemy-within-14-of-th?))
        (values '() (set) '())))
  (define tbrain-unit-actions (pooled-hasheqv! l34-sc 'tbrain-unit-actions))
  (for ([ta (in-list tbrain-actions)])
    (when (and (pair? ta) (>= (length ta) 2) (exact-integer? (second ta)))
      (define uid (second ta))
      (hash-set! tbrain-unit-actions uid
                 (append (hash-ref tbrain-unit-actions uid '()) (list ta)))))

  ;; ---------------------------------------------------------------------------
  ;; Scenario 9 + L59-P2 (`#5143533 Aether2040` 17 Nukes -> 103 Probes):
  ;; Multi-Nuke Radial Evacuation (`'nuke-points` + `'nuke-alert` + EffectId=7)!
  ;; Evacuates ALL workers & army within `<= 10.5t` radially outward to `>= 12.0t`
  ;; away from every active nuke center, marking `wave3-handled-tags` + `'survival`
  ;; lease so harvest & Phase 5 never pull evacuating units back into the blast!
  ;; ---------------------------------------------------------------------------
  (define active-nuke-pts
    (let ([nps (hash-ref obs 'nuke-points '())]
          [na (hash-ref obs 'nuke-alert #f)])
      (cond
        [(and (list? nps) (pair? nps)) nps]
        [(and (pair? na) (real? (car na)) (real? (cdr na))) (list na)]
        [na (list (cons (exact->inexact nat-x) (exact->inexact nat-y)))]
        [else '()])))
  (when (pair? active-nuke-pts)
    (define mw-nk (exact->inexact (max 64.0 (safe-finite-real (hash-ref obs 'map-width 200.0) 200.0))))
    (define mh-nk (exact->inexact (max 64.0 (safe-finite-real (hash-ref obs 'map-height 200.0) 200.0))))
    (define leases-nk (l34-ctx-leases ctx))
    (define (clamp-map-x x) (max 4.0 (min (- mw-nk 4.0) x)))
    (define (clamp-map-y y) (max 4.0 (min (- mh-nk 4.0) y)))
    (define (compute-nuke-escape-pt ux uy nx ny)
      (define dx (- ux nx))
      (define dy (- uy ny))
      (define d (sqrt (+ (* dx dx) (* dy dy))))
      ;; When unit sits right on the nuke dot (`d < 0.5`), step away toward whichever map interior anchor is farthest
      (define-values (ux-dir uy-dir)
        (if (>= d 0.5)
            (values (/ dx d) (/ dy d))
            (let* ([cx (* 0.5 mw-nk)] [cy (* 0.5 mh-nk)]
                   [cdx (- cx nx)] [cdy (- cy ny)]
                   [cd (max 1.0 (sqrt (+ (* cdx cdx) (* cdy cdy))))])
              (values (/ cdx cd) (/ cdy cd)))))
      (define cand-x (clamp-map-x (+ nx (* 12.5 ux-dir))))
      (define cand-y (clamp-map-y (+ ny (* 12.5 uy-dir))))
      ;; If clamped corner stays inside blast (`< 10.5t`), rotate 90 deg toward map center!
      (if (< (dist2d cand-x cand-y nx ny) 10.5)
          (let* ([p1x (clamp-map-x (+ nx (* 12.5 (- uy-dir))))]
                 [p1y (clamp-map-y (+ ny (* 12.5 ux-dir)))]
                 [p2x (clamp-map-x (+ nx (* 12.5 uy-dir)))]
                 [p2y (clamp-map-y (+ ny (* 12.5 (- ux-dir))))])
            (if (>= (dist2d p1x p1y nx ny) (dist2d p2x p2y nx ny))
                (values p1x p1y)
                (values p2x p2y)))
          (values cand-x cand-y)))
    (for ([u (in-list ally-units)]
          #:when (and (hash? u) (real? (hash-ref u 'x #f)) (real? (hash-ref u 'y #f))))
      (define uid (hash-ref u 'id 101))
      (define ux (exact->inexact (hash-ref u 'x base-x)))
      (define uy (exact->inexact (hash-ref u 'y base-y)))
      (define nearest-np
        (for/fold ([best #f] [bd 10.51] #:result best) ([np (in-list active-nuke-pts)])
          (define d (dist2d ux uy (car np) (cdr np)))
          (if (< d bd) (values np d) (values best bd))))
      (when nearest-np
        (define-values (esc-x esc-y) (compute-nuke-escape-pt ux uy (car nearest-np) (cdr nearest-np)))
        (define sx (safe-coord esc-x base-x))
        (define sy (safe-coord esc-y base-y))
        (if live-tactics-obs?
            (begin
              (set-add! wave3-handled-tags uid)
              (when (hash? leases-nk)
                (acquire-unit-lease! leases-nk uid 'survival frame 32 #:x sx #:y sy))
              (l34-emit-preserved! ctx (list 'move uid sx sy)))
            (l34-emit! ctx (list 'kite uid sx sy))))))

  ;; ---------------------------------------------------------------------------
  ;; Scenario 4: Hidden / Corner Flying Building Search when Enemy Base Cleared
  ;; ---------------------------------------------------------------------------
  (when (and (hash-ref obs 'enemy-main-cleared #f)
             (null? enemy-units)
             (null? enemy-bldgs)
             (not (null? combat-units)))
    (define corners '((16.0 . 16.0) (16.0 . 240.0) (240.0 . 16.0) (240.0 . 240.0)))
    (for ([u (in-list combat-units)]
          [idx (in-naturals)])
      (define c (list-ref corners (modulo idx (length corners))))
      (l34-emit! ctx (list 'attack-pos (hash-ref u 'id 101) (car c) (cdr c)))))

  ;; ---------------------------------------------------------------------------
  ;; Pro Mechanic #4: Active Transport Juggling (Load/Unload, 10.0 tiles) & Multi-Prong Drop
  ;; ---------------------------------------------------------------------------
  (define-values (transports has-overlord?)
    (for/fold ([tr-rev '()] [ov? #f] #:result (values (reverse tr-rev) ov?))
              ([u (in-list ally-units)])
      (define ut (unit-type-sym u))
      (values (if (or (eq? ut 'warp-prism)
                      (eq? ut 'warp-prism-phasing)
                      (eq? ut 'medivac)
                      (eq? ut 'overlord-transport))
                  (cons u tr-rev)
                  tr-rev)
              (or ov? (eq? ut 'overlord)))))
  (define dead-tags-rt
    (let ([dt (or (let ([v (hash-ref obs 'dead-unit-tags #f)])
                    (and (pair? v) v))
                  (hash-ref obs 'dead-tags '()))])
      (if (null? dt)
          '()
          (for/list ([x (in-list dt)] #:when (exact-integer? x)) x))))
  (cond
    [live-tactics-obs?
     (define transport-acted-tags (pooled-mutable-seteqv! l34-sc 'transport-acted-tags))
     ;; L44-P0-1b (`ro01` Widow Mine Medivac, `n05` Warp Prism + Archons, `ro26` Baneling Drop):
     ;; Clean loaded-transport fly-over drop before escort/juggle logic steals loaded transports!
     ;; Flies directly over the densest mineral-line worker cluster (`<= 2.5t`) for worker-harass
     ;; drops (Widow Mines / Banelings / Bio) or `<= 4.5t` of enemy combat army (Archons / Immortals)
     ;; and emits preserved `(unload-all-at tr-id x y)` (`396`/`913`/`1408`)!
     ;; Preserves emergency AoE offset drops (`w10-tac-3`), wounded-unit rescues, and `novel-34`!
     (when (pair? transports)
       (define drop-enemy-workers
         (for/list ([e (in-list enemy-units)]
                    #:when (and (hash? e)
                                (not (eq? (hash-ref e 'snapshot? #f) #t))
                                (eqv? (hash-ref e 'display-type 1) 1)
                                (memq (unit-type-sym e) '(scv probe drone mule))
                                (real? (hash-ref e 'x #f))
                                (real? (hash-ref e 'y #f))))
           e))
       (define drop-enemy-combat
         (for/list ([e (in-list enemy-units)]
                    #:when (and (hash? e)
                                (not (eq? (hash-ref e 'snapshot? #f) #t))
                                (eqv? (hash-ref e 'display-type 1) 1)
                                (or (combat-unit-record? e)
                                    (eq? (unit-type-sym e) 'queen))
                                (not (hash-ref e 'structure? #f))
                                (not (memq (unit-type-sym e)
                                           '(scv probe drone mule overlord overlord-cocoon
                                             overseer overseer-siege-mode observer larva egg
                                             changeling changeling-zealot changeling-zergling
                                             changeling-marine)))
                                (real? (hash-ref e 'x #f))
                                (real? (hash-ref e 'y #f))))
           e))
       (for ([tr (in-list transports)])
         (define tr-id (hash-ref tr 'id -1))
         (define tr-pax (let ([ps (hash-ref tr 'passengers '())]) (if (list? ps) ps '())))
         (define tr-cargo (safe-nonneg-int (hash-ref tr 'cargo-space-taken 0) 0))
         (when (and (exact-integer? tr-id) (> tr-id 0)
                    (or (> tr-cargo 0) (pair? tr-pax)))
           (define tr-ut (unit-type-sym tr))
           (define tx (exact->inexact (hash-ref tr 'x base-x)))
           (define ty (exact->inexact (hash-ref tr 'y base-y)))
           (define tr-hp (exact->inexact (unit-total-hp-and-shield tr)))
           (define tr-mhp (max 1.0 (exact->inexact (hash-ref tr 'max-hp (if (eq? tr-ut 'overlord-transport) 200 150)))))
           (define in-aoe-hazard?
             (for/or ([ef (in-list effects)])
               (and (hash? ef)
                    (real? (hash-ref ef 'x #f))
                    (real? (hash-ref ef 'y #f))
                    (<= (fast-dist2d tx ty
                                     (exact->inexact (hash-ref ef 'x 9999.0))
                                     (exact->inexact (hash-ref ef 'y 9999.0)))
                        4.5))))
           (define wounded-rescue-cargo?
             (and (pair? tr-pax)
                  (let-values ([(hp-sum mhp-sum cnt)
                                (for/fold ([hs 0.0] [ms 0.0] [c 0]) ([p (in-list tr-pax)] #:when (hash? p))
                                  (define php (exact->inexact (hash-ref p 'hp 50)))
                                  (define psh (exact->inexact (hash-ref p 'shield (hash-ref p 'shields 0))))
                                  (define pmhp (exact->inexact (hash-ref p 'max-hp 50)))
                                  (define pmsh (exact->inexact (hash-ref p 'max-shield (hash-ref p 'max-shields 0))))
                                  (values (+ hs php psh)
                                          (+ ms (max 1.0 (+ pmhp pmsh)))
                                          (add1 c)))])
                    (and (> cnt 0)
                         (< (/ hp-sum (max 1.0 mhp-sum))
                            ;; L58-P2 (`sc2-trn-n05`): During an active worker-line raid (`>= 6` enemy workers),
                            ;; keep re-dropping Archons/raiders down to `30%` total HP+shield instead of aborting home!
                            (if (and (memq tr-ut '(warp-prism warp-prism-phasing))
                                     (>= (length drop-enemy-workers) 6))
                                0.30
                                0.45))))))
           (define tr-vx (let ([v (hash-ref tr 'vx 0.0)]) (if (real? v) (exact->inexact v) 0.0)))
           (define tr-vy (let ([v (hash-ref tr 'vy 0.0)]) (if (real? v) (exact->inexact v) 0.0)))
           ;; L45-P0-1b (`ro01` Widow Mine Medivac Drop): Keep synthetic moving self-drop velocity
           ;; skip ONLY when `tr-cargo == 0` (preserving Suite 45 synthetic tests!) so live SC2
           ;; moving loaded transports (`tr-cargo > 0`) are NEVER skipped or bounced home by
           ;; `plan-transport-fleet-micro`!
           (define tr-moving-self-drop-vel?
             (and (= tr-cargo 0)
                  (> (+ (* tr-vx tr-vx) (* tr-vy tr-vy)) 0.25)))
           (unless (or in-aoe-hazard? (< (/ tr-hp tr-mhp) 0.35) wounded-rescue-cargo? tr-moving-self-drop-vel?)
             (define pax-types
               (for/list ([p (in-list tr-pax)] #:when (hash? p))
                 (fast-canonical-unit-sym (unit-type-sym p))))
             (define heavy-combat-cargo?
               (or (ormap (lambda (pt) (memq pt '(archon immortal colossus siege-tank thor lurker))) pax-types)
                   (and (null? pax-types)
                        (memq tr-ut '(warp-prism warp-prism-phasing))
                        (pair? drop-enemy-combat))))
             (define close-drop-cargo?
               (or (ormap (lambda (pt) (memq pt '(widow-mine baneling zealot zergling dark-templar hellion hellbat))) pax-types)
                   (memq tr-ut '(medivac overlord-transport))))
             (define raid-drop-cargo?
               (ormap (lambda (pt) (memq pt '(widow-mine baneling hellion dark-templar))) pax-types))
             (define tr-solo-drop-raid?
               (and close-drop-cargo?
                    (not heavy-combat-cargo?)
                    (not (ormap (lambda (u)
                                  (and (hash? u)
                                       (not (eqv? (hash-ref u 'id -1) tr-id))
                                       (not (memq (unit-type-sym u)
                                                  '(medivac warp-prism warp-prism-phasing overlord-transport)))
                                       (real? (hash-ref u 'x #f))
                                       (real? (hash-ref u 'y #f))
                                       (<= (fast-dist2d tx ty
                                                        (exact->inexact (hash-ref u 'x 9999.0))
                                                        (exact->inexact (hash-ref u 'y 9999.0)))
                                           12.0)))
                                combat-units))))
             (define enemy-th-near
               (and tr-solo-drop-raid?
                    (for/first ([eb (in-list enemy-bldgs)]
                                #:when (and (hash? eb)
                                            (memq (fast-canonical-structure-sym (unit-type-sym eb))
                                                  '(hatchery lair hive nexus command-center orbital-command planetary-fortress))
                                            (real? (hash-ref eb 'x #f))
                                            (real? (hash-ref eb 'y #f))
                                            (<= (fast-dist2d tx ty
                                                             (exact->inexact (hash-ref eb 'x 9999.0))
                                                             (exact->inexact (hash-ref eb 'y 9999.0)))
                                                40.0)))
                      eb)))
             (define fog-target-x
               (if enemy-th-near
                   (exact->inexact (hash-ref enemy-th-near 'x enemy-x))
                   (exact->inexact enemy-x)))
             (define fog-target-y
               (if enemy-th-near
                   (exact->inexact (hash-ref enemy-th-near 'y enemy-y))
                   (exact->inexact enemy-y)))
             (define fog-target-dist (fast-dist2d tx ty fog-target-x fog-target-y))
             (define fog-mineral-approach?
               (and (> tr-cargo 0)
                    tr-solo-drop-raid?
                    (null? drop-enemy-workers)
                    (<= fog-target-dist 45.0)
                    (<= (length drop-enemy-combat) 2)
                    (or enemy-th-near
                        raid-drop-cargo?
                        (pair? drop-enemy-combat))))
             (define solo-transport-near-workers?
               (and (>= (length drop-enemy-workers) 6)
                    (<= (count (lambda (u)
                                 (and (hash? u)
                                      (not (eqv? (hash-ref u 'id -1) tr-id))
                                      (not (memq (unit-type-sym u)
                                                 '(medivac warp-prism warp-prism-phasing overlord-transport)))
                                      (real? (hash-ref u 'x #f))
                                      (real? (hash-ref u 'y #f))
                                      (<= (fast-dist2d tx ty
                                                       (exact->inexact (hash-ref u 'x 9999.0))
                                                       (exact->inexact (hash-ref u 'y 9999.0)))
                                          12.0)))
                               combat-units)
                        2)))
             (define-values (drop-x drop-y drop-r)
               (cond
                 ;; L58-P1 (`sc2-trn-n05`): A solo loaded raid transport (including Warp Prism + Archons!)
                 ;; attacking an active mineral line (`>= 6` enemy workers) flies past frontline defenders
                 ;; and drops directly into the worker cluster!
                 [(or (and (not heavy-combat-cargo?)
                           (>= (length drop-enemy-workers) 3))
                      solo-transport-near-workers?)
                  (define best-w
                    (argmax (lambda (ew)
                              (define wx (exact->inexact (hash-ref ew 'x tx)))
                              (define wy (exact->inexact (hash-ref ew 'y ty)))
                              (define n-cl
                                (for/sum ([ow (in-list drop-enemy-workers)]
                                          #:when (<= (fast-dist2d wx wy
                                                                  (exact->inexact (hash-ref ow 'x wx))
                                                                  (exact->inexact (hash-ref ow 'y wy)))
                                                     3.5))
                                  1))
                              (- (* 10.0 n-cl) (* 0.15 (fast-dist2d tx ty wx wy))))
                            drop-enemy-workers))
                  (values (exact->inexact (hash-ref best-w 'x tx))
                          (exact->inexact (hash-ref best-w 'y ty))
                          2.5)]
                 ;; L45-P0-1b (`ro01` Fog Mineral-Line Approach): When a solo loaded raid transport
                 ;; (e.g. Medivac + 2 Widow Mines) approaches an enemy mineral line whose workers are
                 ;; still in Fog (`< 3` workers visible, `<= 2` front defenders like 1 Queen), fly
                 ;; straight into `(fog-target-x, fog-target-y)` with `drop-r = -1.0` (never blind-drop
                 ;; into Fog or let `plan-transport-fleet-micro` drag it home!) until workers light up!
                 [fog-mineral-approach?
                  (values fog-target-x fog-target-y -1.0)]
                 [(and (pair? drop-enemy-combat)
                       (or heavy-combat-cargo?
                           (ormap (lambda (pt) (memq pt '(widow-mine baneling))) pax-types)
                           (and (>= (length tr-pax) 2)
                                (for/or ([ec (in-list drop-enemy-combat)])
                                  (<= (fast-dist2d tx ty
                                                   (exact->inexact (hash-ref ec 'x 9999.0))
                                                   (exact->inexact (hash-ref ec 'y 9999.0)))
                                      24.0)))))
                  (define best-c
                    (argmax (lambda (ec)
                              (define cx (exact->inexact (hash-ref ec 'x tx)))
                              (define cy (exact->inexact (hash-ref ec 'y ty)))
                              (define n-cl
                                (for/sum ([oc (in-list drop-enemy-combat)]
                                          #:when (<= (fast-dist2d cx cy
                                                                  (exact->inexact (hash-ref oc 'x cx))
                                                                  (exact->inexact (hash-ref oc 'y cy)))
                                                     4.5))
                                  1))
                              (- (* 4.0 n-cl) (* 0.5 (fast-dist2d tx ty cx cy))))
                            drop-enemy-combat))
                  (values (exact->inexact (hash-ref best-c 'x tx))
                          (exact->inexact (hash-ref best-c 'y ty))
                          (if (and close-drop-cargo? (not heavy-combat-cargo?)) 2.8 4.5))]
                 [else (values #f #f 0.0)]))
             (when (and drop-x drop-y)
               (define d-drop (fast-dist2d tx ty drop-x drop-y))
               (set-add! transport-acted-tags tr-id)
               (set-add! wave3-handled-tags tr-id)
               ;; Off-GCD Medivac Ignite Afterburners (`2116`) fires ONLY once live enemies are visible
               ;; (never wasted into empty Fog!), and pairs with same-tick `move`/`unload-all-at`!
               (when (and (eq? tr-ut 'medivac)
                          (or (pair? drop-enemy-workers) (pair? drop-enemy-combat))
                          (> d-drop 4.5)
                          (<= d-drop 30.0)
                          (refractory-allow-action?! (live-bot-runtime-cooldown-tracker rt)
                                                     (list 'l44-medivac-boost tr-id)
                                                     frame
                                                     320))
                 (l34-emit-preserved! ctx (list 'cast-spell tr-id 'medivac-boost tr-id)))
               (cond
                 [(and (>= drop-r 0.0) (<= d-drop drop-r))
                  (l34-emit-preserved!
                   ctx
                   (list 'unload-all-at tr-id
                         (safe-coord drop-x tx)
                         (safe-coord drop-y ty)))]
                 [(> d-drop 2.0)
                  (l34-emit-preserved!
                   ctx
                   (list 'move tr-id
                         (safe-coord drop-x tx)
                         (safe-coord drop-y ty)))]))))))
     (define lair-or-hive-ok?
       (and has-overlord?
            (for/or ([b (in-list ally-bldgs)])
              (and (hash? b)
                   (let ([bt (unit-type-sym b)])
                     (or (eq? bt 'lair) (eq? bt 'hive)))
                   (>= (hash-ref b 'build-progress 1.0) 1.0)))))
     (define tr-dirs
       (cond
         [(and (null? transports)
               (or (not lair-or-hive-ok?)
                   (and (hash-has-key? obs 'mineral-harvesters)
                        (not (refractory-allow-action?! (live-bot-runtime-cooldown-tracker rt)
                                                        'zerg-ov-morph-check
                                                        frame
                                                        128)))))
          '()]
         [else
          (define check-ovi-morph? (and has-overlord? lair-or-hive-ok?))
          (define transport-combat-supply
            (if check-ovi-morph?
                (for/sum ([u (in-list combat-units)])
                  (unit-supply-cost (unit-type-sym u)))
                0.0))
          (define any-cargo?
            (for/or ([tr (in-list transports)])
              (or (pair? (hash-ref tr 'passengers '()))
                  (> (hash-ref tr 'cargo-space-taken 0) 0))))
          (define tr-pts
            (for/list ([tr (in-list transports)])
              (cons (exact->inexact (hash-ref tr 'x base-x))
                    (exact->inexact (hash-ref tr 'y base-y)))))
          (define-values (tr-min-x tr-max-x tr-min-y tr-max-y)
            (let loop ([pts tr-pts] [mnx +inf.0] [mxx -inf.0] [mny +inf.0] [mxy -inf.0])
              (if (null? pts)
                  (values mnx mxx mny mxy)
                  (let* ([pt (car pts)] [px (car pt)] [py (cdr pt)])
                    (loop (cdr pts)
                          (flmin mnx px) (flmax mxx px)
                          (flmin mny py) (flmax mxy py))))))
          (define effect-pts
            (if (null? effects)
                '()
                (for/list ([ef (in-list effects)]
                           #:when (hash? ef))
                  (cons (exact->inexact (hash-ref ef 'x base-x))
                        (exact->inexact (hash-ref ef 'y base-y))))))
          (define-values (eff-min-x eff-max-x eff-min-y eff-max-y)
            (if (null? effect-pts)
                (values +inf.0 -inf.0 +inf.0 -inf.0)
                (let loop ([pts effect-pts] [mnx +inf.0] [mxx -inf.0] [mny +inf.0] [mxy -inf.0])
                  (if (null? pts)
                      (values mnx mxx mny mxy)
                      (let* ([pt (car pts)] [px (car pt)] [py (cdr pt)])
                        (loop (cdr pts)
                              (flmin mnx px) (flmax mxx px)
                              (flmin mny py) (flmax mxy py)))))))
          (define (near-pts? pts x y r2)
            (let loop ([rem pts])
              (and (pair? rem)
                   (let* ([pt (car rem)]
                          [dx (fl- x (car pt))]
                          [dy (fl- y (cdr pt))])
                     (or (fl<= (fl+ (fl* dx dx) (fl* dy dy)) r2)
                         (loop (cdr rem)))))))
          (define tr-ally-slice
            (if (null? transports)
                (for/list ([u (in-list ally-units)]
                           #:when (eq? (unit-type-sym u) 'overlord))
                  u)
                (let ([passenger-id-ht
                       (and any-cargo?
                            (let ([ht (make-hasheqv)])
                              (for ([tr (in-list transports)])
                                (for ([p (in-list (hash-ref tr 'passengers '()))])
                                  (define pid (if (hash? p) (hash-ref p 'tag (hash-ref p 'id #f)) p))
                                  (when (exact-integer? pid) (hash-set! ht pid #t))))
                              ht))]
                      [tr-rad (if any-cargo? 25.0 12.5)]
                      [tr-r2 (if any-cargo? 625.0 156.25)]
                      [has-effs? (pair? effect-pts)]
                      [nearby-ground '()])
                  (define tr-bminx (fl- tr-min-x tr-rad))
                  (define tr-bmaxx (fl+ tr-max-x tr-rad))
                  (define tr-bminy (fl- tr-min-y tr-rad))
                  (define tr-bmaxy (fl+ tr-max-y tr-rad))
                  (define eff-bminx (fl- eff-min-x 6.0))
                  (define eff-bmaxx (fl+ eff-max-x 6.0))
                  (define eff-bminy (fl- eff-min-y 6.0))
                  (define eff-bmaxy (fl+ eff-max-y 6.0))
                  (define tr-core
                    (for/fold ([acc '()] #:result (reverse acc))
                              ([u (in-list ally-units)])
                      (define ut (unit-type-sym u))
                      (cond
                        [(or (eq? ut 'warp-prism)
                             (eq? ut 'warp-prism-phasing)
                             (eq? ut 'medivac)
                             (eq? ut 'overlord-transport)
                             (and lair-or-hive-ok? (eq? ut 'overlord))
                             (and passenger-id-ht
                                  (hash-ref passenger-id-ht (hash-ref u 'id -1) #f)))
                         (cons u acc)]
                        [(and (not (hash-ref RUNTIME-WORKER-SET ut #f))
                              (not (fast-unit-is-flying-sym? ut))
                              (not (hash-ref RUNTIME-STRUCT-SYM-SET ut #f)))
                         (define raw-x (hash-ref u 'x base-x))
                         (define raw-y (hash-ref u 'y base-y))
                         (define ux (if (flonum? raw-x) raw-x (exact->inexact raw-x)))
                         (define uy (if (flonum? raw-y) raw-y (exact->inexact raw-y)))
                         (define in-eff?
                           (and has-effs?
                                (fl>= ux eff-bminx) (fl<= ux eff-bmaxx)
                                (fl>= uy eff-bminy) (fl<= uy eff-bmaxy)
                                (near-pts? effect-pts ux uy 36.0)))
                         (when (or in-eff?
                                   (and (fl>= ux tr-bminx) (fl<= ux tr-bmaxx)
                                        (fl>= uy tr-bminy) (fl<= uy tr-bmaxy)
                                        (near-pts? tr-pts ux uy tr-r2)))
                           (define hp-pct (/ (exact->inexact (unit-total-hp-and-shield u))
                                             (max 1.0 (exact->inexact (hash-ref u 'max-hp 50)))))
                           (set! nearby-ground (cons (cons (if in-eff? (- hp-pct 2.0) hp-pct) u) nearby-ground)))
                         acc]
                        [else acc])))
                  (if (null? nearby-ground)
                      tr-core
                      (let ([capped-ground
                             (map cdr
                                  (take (sort nearby-ground < #:key car)
                                        (min (if any-cargo? 24 16) (length nearby-ground))))])
                        (append tr-core capped-ground))))))
          (define tr-enemy-slice
            (cond
              [(null? transports)
               (define ovi-pts
                 (for/list ([o (in-list tr-ally-slice)])
                   (cons (exact->inexact (hash-ref o 'x base-x))
                         (exact->inexact (hash-ref o 'y base-y)))))
               (if (null? ovi-pts)
                   '()
                   (for/list ([e (in-list enemy-units)]
                              #:when (near-pts? ovi-pts
                                                (exact->inexact (hash-ref e 'x 9999.0))
                                                (exact->inexact (hash-ref e 'y 9999.0))
                                                625.0))
                     e))]
              [any-cargo?
               (define ex-tgt (exact->inexact enemy-x))
               (define ey-tgt (exact->inexact enemy-y))
               (define scored
                 (for/fold ([acc '()])
                           ([e (in-list enemy-units)])
                   (define ex0 (exact->inexact (hash-ref e 'x 9999.0)))
                   (define ey0 (exact->inexact (hash-ref e 'y 9999.0)))
                   (define dt (for/fold ([m +inf.0]) ([pt (in-list tr-pts)])
                                (define dx (- ex0 (car pt)))
                                (define dy (- ey0 (cdr pt)))
                                (min m (+ (* dx dx) (* dy dy)))))
                   (define dx-e (- ex0 ex-tgt))
                   (define dy-e (- ey0 ey-tgt))
                   (define de (+ (* dx-e dx-e) (* dy-e dy-e)))
                   (define dmin (min dt de))
                   (if (<= dmin 625.0)
                       (cons (cons dmin e) acc)
                       acc)))
               (map cdr (take (sort scored < #:key car) (min 24 (length scored))))]
              [else
               (define e-bminx (fl- tr-min-x 19.0))
               (define e-bmaxx (fl+ tr-max-x 19.0))
               (define e-bminy (fl- tr-min-y 19.0))
               (define e-bmaxy (fl+ tr-max-y 19.0))
               (let loop ([rem enemy-units] [cnt 0] [acc '()])
                 (if (or (null? rem) (= cnt 24))
                     (reverse acc)
                     (let* ([e (car rem)]
                            [rx (hash-ref e 'x 9999.0)]
                            [ry (hash-ref e 'y 9999.0)]
                            [ex (if (flonum? rx) rx (exact->inexact rx))]
                            [ey (if (flonum? ry) ry (exact->inexact ry))])
                       (if (and (fl>= ex e-bminx) (fl<= ex e-bmaxx)
                                (fl>= ey e-bminy) (fl<= ey e-bmaxy)
                                (near-pts? tr-pts ex ey 361.0))
                           (loop (cdr rem) (add1 cnt) (cons e acc))
                           (loop (cdr rem) cnt acc)))))]))
          (sync-transport-tracker! transport-tr transports frame #:dead-tags dead-tags-rt)
          (plan-transport-fleet-micro tr-ally-slice tr-enemy-slice
                                      #:tracker transport-tr
                                      #:current-frame frame
                                      #:home-x (exact->inexact base-x)
                                      #:home-y (exact->inexact base-y)
                                      #:effects effects
                                      #:warp-in-complete? (and (hash-ref obs 'warp-in-complete? #f) #t)
                                      #:warp-in-requested? (if (hash-has-key? obs 'warp-in-requested?)
                                                               (and (hash-ref obs 'warp-in-requested? #f) #t)
                                                               (not (l34-ctx-live-obs? ctx)))
                                      #:lair-or-hive-ready? lair-or-hive-ok?
                                      #:combat-supply transport-combat-supply)]))
     ;; Loop 65D (`#1891`/`#1892`): Unconditional single-authority ownership of empty healthy
     ;; Warp Prisms in live 2+ base mid/late-game Protoss (even during base attacks!) — suppress
     ;; BOTH morphs AND `'move` in Phase 3 so only `step-multiprong-coordinator!` drives empty Prisms!
     (define mp-prism-single-auth?
       (and (l34-ctx-live-obs? ctx)
            (eq? (live-bot-runtime-actual-race rt) 'Protoss)
            (>= frame 5376)
            (not (hash-has-key? obs 'warp-in-requested?))
            (>= (count (lambda (b)
                         (and (hash? b) (eq? (fast-canonical-structure-sym (unit-type-sym b)) 'nexus)))
                       ally-bldgs)
                2)))
     (for ([td (in-list tr-dirs)])
       (define ttag (transport-directive-transport-tag td))
       (unless (set-member? transport-acted-tags ttag)
       (define act-kind (transport-directive-action td))
       (define ab-sym (transport-directive-ability td))
       (define sx (safe-coord (transport-directive-tx td) base-x))
       (define sy (safe-coord (transport-directive-ty td) base-y))
       (define td-empty-healthy-prism?
         (and mp-prism-single-auth?
              (let ([tr-u (findf (lambda (u) (eqv? (hash-ref u 'id -1) ttag)) transports)])
                (and tr-u
                     (memq (unit-type-sym tr-u) '(warp-prism warp-prism-phasing))
                     (= (safe-nonneg-int (hash-ref tr-u 'cargo-space-taken 0) 0) 0)
                     (null? (hash-ref tr-u 'passengers '()))
                     (let* ([hp (exact->inexact (hash-ref tr-u 'hp (hash-ref tr-u 'health 80.0)))]
                            [sh (exact->inexact (hash-ref tr-u 'shields (hash-ref tr-u 'shield 100.0)))]
                            [mhp (exact->inexact (hash-ref tr-u 'max-hp (hash-ref tr-u 'health-max 80.0)))]
                            [msh (exact->inexact (hash-ref tr-u 'max-shields (hash-ref tr-u 'shield-max 100.0)))])
                       (fl>= (fl/ (fl+ hp sh) (flmax 1.0 (fl+ mhp msh))) 0.35))))))
       (define translated
         (cond
           [(and td-empty-healthy-prism?
                 (or (memq act-kind '(morph-warp-prism-phasing morph-warp-prism-transport
                                      move approach-save-pickup hold-and-reposition move-to-drop))
                     (memq ab-sym '(morph-warp-prism-phasing morph-warp-prism-transport move))))
            #f]
           [(eq? act-kind 'transport-drop-moving)
            (list 'transport-juggle ttag (list ttag) sx sy)]
           [(and (eq? act-kind 'cast-spell) (eq? ab-sym 'morph-overlord-transport))
            ;; L50-W1 (`#49 ZvP` 5x `TransportOverlordCocoon` leak): Strictly gate `OverlordTransport`
            ;; morphs on an active drop plan (`l34-bo-fork-coords`, `'active-drop-plan?`, or an
            ;; actively loaded DropperLord in flight), zero pending/morphing cocoons, capped total
            ;; DropperLords (`< 1`, or `< 2` with an active loaded drop), `>= 20` combat supply,
            ;; and no enemy combat attacking home (`<= 28t`)!
            (define-values (dl-fork-on? _dfx _dfy) (l34-bo-fork-coords ctx))
            (define has-loaded-dropperlord?
              (ormap (lambda (u)
                       (and (hash? u)
                            (eq? (unit-type-sym u) 'overlord-transport)
                            (or (> (safe-nonneg-int (hash-ref u 'cargo-space-taken 0) 0) 0)
                                (pair? (hash-ref u 'passengers '())))))
                     ally-units))
            (define dl-combat-sup
              (for/sum ([u (in-list combat-units)]) (unit-supply-cost (unit-type-sym u))))
            (define dl-ling-bane-cnt
              (count (lambda (u)
                       (and (hash? u) (memq (unit-type-sym u) '(zergling baneling))))
                     ally-units))
            ;; L59 Tier-1B (`#1499` L29327): Wire live midgame Zerg drop intent cleanly instead of
            ;; waiting on an unemitted `'active-drop-plan?` key (while keeping the strict 1-Dropperlord
            ;; cocoon/count/home-threat cap so we never leak 5x cocoons like `#49`!).
            (define dl-drop-active?
              (or dl-fork-on?
                  (eq? (hash-ref obs 'active-drop-plan? #f) #t)
                  has-loaded-dropperlord?
                  (and lair-or-hive-ok?
                       (not combat-suppress-attack?)
                       (>= dl-combat-sup 28.0)
                       (>= dl-ling-bane-cnt 8))))
            (define dl-cocoon-pending-cnt
              (+ (count (lambda (u)
                          (and (hash? u) (eq? (unit-type-sym u) 'transport-overlord-cocoon)))
                        ally-units)
                 (order-ledger-pending-count-for-type (live-bot-runtime-order-ledger rt) 'overlord-transport frame)))
            (define existing-dl-cnt
              (+ dl-cocoon-pending-cnt
                 (count (lambda (u)
                          (and (hash? u) (eq? (unit-type-sym u) 'overlord-transport)))
                        ally-units)))
            (define dl-home-threat?
              (ormap (lambda (e)
                       (and (hash? e)
                            (combat-unit-record? e)
                            (real? (hash-ref e 'x #f)) (real? (hash-ref e 'y #f))
                            (<= (fast-dist2d (exact->inexact base-x) (exact->inexact base-y)
                                             (exact->inexact (hash-ref e 'x 9999.0))
                                             (exact->inexact (hash-ref e 'y 9999.0)))
                                28.0)))
                     enemy-units))
            (and dl-drop-active?
                 (= dl-cocoon-pending-cnt 0)
                 (< existing-dl-cnt (if has-loaded-dropperlord? 2 1))
                 (not dl-home-threat?)
                 (>= dl-combat-sup 20.0)
                 (begin
                   (order-ledger-record-issued! (live-bot-runtime-order-ledger rt)
                                                ttag 'morph 'overlord-transport base-x base-y frame)
                   (list 'morph ttag 'overlord-transport)))]
           [(eq? act-kind 'load-unit)
            (define ptags
              (filter (lambda (p) (and (exact-integer? p) (> p 0) (not (= p ttag))))
                      (transport-directive-passenger-tags td)))
            (and (pair? ptags)
                 (list 'transport-juggle ttag ptags sx sy))]
           [(eq? act-kind 'transport-drop-point)
            (list 'transport-juggle ttag sx sy)]
           [(memq act-kind '(approach-save-pickup hold-and-reposition move-to-drop))
            (list 'move ttag sx sy)]
           [(memq act-kind '(medivac-boost morph-warp-prism-phasing morph-warp-prism-transport cast-spell))
            (list 'cast-spell ttag (or ab-sym 'unknown) ttag)]
           [else
            (list 'move ttag sx sy)]))
       (when translated
         (set-add! transport-acted-tags ttag)
         (set-add! wave3-handled-tags ttag)
         (l34-emit-preserved! ctx translated))))
     ;; L59 Tier-1A (`#1499`): Wire `plan-multi-angle-mini-overlord-drops` for peripheral
     ;; Baneling/Speedling Dropperlord drops (strictly capped at 1 Dropperlord, non-suppressed).
     (when (and (eq? (live-bot-runtime-actual-race rt) 'Zerg)
                lair-or-hive-ok?
                (not combat-suppress-attack?)
                (not (l34-ctx-under-tactics-base-attack? ctx))
                (>= (for/sum ([u (in-list combat-units)]) (unit-supply-cost (unit-type-sym u))) 24.0)
                (ormap (lambda (u)
                         (and (hash? u)
                              (eq? (unit-type-sym u) 'overlord-transport)
                              (not (set-member? transport-acted-tags (hash-ref u 'id -1)))))
                       ally-units))
       (define mini-dl-dirs
         (plan-multi-angle-mini-overlord-drops
          ally-units enemy-units
          #:tracker transport-tr
          #:current-frame frame
          #:home-x (exact->inexact base-x)
          #:home-y (exact->inexact base-y)
          #:enemy-main-x (exact->inexact enemy-x)
          #:enemy-main-y (exact->inexact enemy-y)
          #:max-drops 1
          #:lair-or-hive-ready? lair-or-hive-ok?))
       (for ([md (in-list mini-dl-dirs)])
         (define mtag (transport-directive-transport-tag md))
         (unless (or (set-member? transport-acted-tags mtag)
                     (and (eq? (transport-directive-action md) 'cast-spell)
                          (eq? (transport-directive-ability md) 'morph-overlord-transport)))
           (define mkind (transport-directive-action md))
           (define msx (safe-coord (transport-directive-tx md) base-x))
           (define msy (safe-coord (transport-directive-ty md) base-y))
           (define mact
             (cond
               [(eq? mkind 'transport-drop-moving) (list 'transport-juggle mtag (list mtag) msx msy)]
               [(eq? mkind 'transport-drop-point) (list 'transport-juggle mtag msx msy)]
               [(eq? mkind 'load-unit)
                (define mptags (filter (lambda (p) (and (exact-integer? p) (> p 0) (not (= p mtag))))
                                       (transport-directive-passenger-tags md)))
                (and (pair? mptags) (list 'transport-juggle mtag mptags msx msy))]
               [else (list 'move mtag msx msy)]))
           (when mact
             (set-add! transport-acted-tags mtag)
             (set-add! wave3-handled-tags mtag)
             (l34-emit-preserved! ctx mact)))))
     (for ([tr (in-list transports)]
           #:when (and (not (set-member? transport-acted-tags (hash-ref tr 'id 706)))
                       ;; L50-W1 (`#50` Medivac Solo Over-Fly Guard): Empty Medivacs are handled
                       ;; by the bio-rear AA-aware safe tether in Phase 4 — never issue raw
                       ;; `attack-pos` toward `prelim-army-cx` (Tanks/Vikings) here!
                       (not (and (eq? (unit-type-sym tr) 'medivac)
                                 (= (safe-nonneg-int (hash-ref tr 'cargo-space-taken 0) 0) 0)
                                 (not (unit-medivac-loaded? tr))))
                       ;; Loop 65C (`#1874`/`#1876`): Leave empty Warp Prisms unclaimed for
                       ;; Phase 5b `step-multiprong-coordinator!` single-authority control!
                       (not (and mp-prism-single-auth?
                                 (memq (unit-type-sym tr) '(warp-prism warp-prism-phasing))
                                 (= (safe-nonneg-int (hash-ref tr 'cargo-space-taken 0) 0) 0)
                                 (null? (hash-ref tr 'passengers '()))))))
       (define tr-id (hash-ref tr 'id 706))
       (define tx (hash-ref tr 'x base-x))
       (define ty (hash-ref tr 'y base-y))
       (define tr-ut (unit-type-sym tr))
       (define-values (tr-fork-on? tr-fork-x tr-fork-y)
         (if (or (pair? (hash-ref tr 'passengers '()))
                 (> (hash-ref tr 'cargo-space-taken 0) 0)
                 (memq tr-ut '(warp-prism warp-prism-phasing)))
             (l34-bo-fork-coords ctx)
             (values #f enemy-x enemy-y)))
       (cond
         [(and tr-fork-on?
               (> (dist2d tx ty tr-fork-x tr-fork-y) 6.0)
               (refractory-allow-action?! (live-bot-runtime-cooldown-tracker rt)
                                          (list 'transport-escort tr-id)
                                          frame
                                          28))
          (l34-emit! ctx (list 'multi-prong-drop tr-id tr-fork-x tr-fork-y))]
         [(not (null? combat-units))
          (define escort-x prelim-army-cx)
          (define escort-y prelim-army-cy)
          (when (and (> (dist2d tx ty escort-x escort-y) 6.0)
                     (refractory-allow-action?! (live-bot-runtime-cooldown-tracker rt)
                                                (list 'transport-escort tr-id)
                                                frame
                                                20))
            (l34-emit! ctx (list (if combat-suppress-attack? 'move 'attack-pos) tr-id escort-x escort-y)))]
         [(and (> (dist2d tx ty nat-x nat-y) 8.0)
               (refractory-allow-action?! (live-bot-runtime-cooldown-tracker rt)
                                          (list 'transport-escort tr-id)
                                          frame
                                          20))
          (l34-emit! ctx (list (if combat-suppress-attack? 'move 'attack-pos) tr-id nat-x nat-y))]))]
    [else
     (define-values (tr-fork-on? tr-fork-x tr-fork-y)
       (if (pair? transports) (l34-bo-fork-coords ctx) (values #f enemy-x enemy-y)))
     (for ([tr (in-list transports)])
       (define tr-id (hash-ref tr 'id 706))
       (define tx (hash-ref tr 'x base-x))
       (define ty (hash-ref tr 'y base-y))
       (define wounded-passenger
         (findf (lambda (u)
                  (and (combat-unit-record? u)
                       (<= (dist2d tx ty (hash-ref u 'x tx) (hash-ref u 'y ty)) SC2-TRANSPORT-JUGGLE-RADIUS)
                       (or (< (hash-ref u 'hp 100) SC2-WOUNDED-PASSENGER-MIN-HP)
                           (< (/ (exact->inexact (hash-ref u 'hp 100))
                                 (max 1 (hash-ref u 'max-hp 100)))
                              SC2-WOUNDED-PASSENGER-HP-PCT))))
                combat-units))
       (cond
         [wounded-passenger
          (l34-emit! ctx (list 'transport-juggle tr-id (hash-ref wounded-passenger 'id 707) base-x base-y))]
         [else
          (l34-emit! ctx (list 'multi-prong-drop tr-id
                       (if tr-fork-on? tr-fork-x enemy-x)
                       (if tr-fork-on? tr-fork-y enemy-y)))]))])
  ;; L59 Tier-1A (`#1499`) + L59C (`#1566` Fix #4): Wire `plan-counter-drop-defense` strictly
  ;; in live full matches (`>= 1` owned townhall) ONLY when an enemy transport is actually
  ;; over/near our mineral line (`<= 16.0t` from an owned townhall, NOT passing mid-map!),
  ;; AND ONLY assign nearby home defenders (`<= 28.0t` from a threatened owned base — NEVER
  ;; yanking a frontline pushing army `>= 40t` away like `#012` `620–643s`!).
  (when (and live-tactics-obs?
             (>= (length combat-units) 4))
    (define cd-base-pts
      (for/list ([b (in-list ally-bldgs)]
                 #:when (and (hash? b)
                             (memq (fast-canonical-structure-sym (unit-type-sym b))
                                   '(hatchery lair hive nexus command-center orbital-command planetary-fortress))
                             (real? (hash-ref b 'x #f)) (real? (hash-ref b 'y #f))))
        (cons (exact->inexact (hash-ref b 'x base-x))
              (exact->inexact (hash-ref b 'y base-y)))))
    (define cd-threatened-base-pts
      (if (pair? cd-base-pts)
          (filter (lambda (bp)
                    (ormap (lambda (e)
                             (and (hash? e)
                                  (memq (fast-canonical-unit-sym (unit-type-sym e))
                                        '(medivac warp-prism warp-prism-phasing overlord-transport))
                                  (real? (hash-ref e 'x #f)) (real? (hash-ref e 'y #f))
                                  (<= (fast-dist2d (exact->inexact (hash-ref e 'x 9999.0))
                                                   (exact->inexact (hash-ref e 'y 9999.0))
                                                   (car bp) (cdr bp))
                                      16.0)))
                           enemy-units))
                  cd-base-pts)
          '()))
    (when (pair? cd-threatened-base-pts)
      (define cd-free-allies
        (for/list ([u (in-list ally-units)]
                   #:when (and (hash? u)
                               (not (set-member? wave3-handled-tags (hash-ref u 'id -1)))
                               (real? (hash-ref u 'x #f)) (real? (hash-ref u 'y #f))
                               (let ([ux (exact->inexact (hash-ref u 'x 9999.0))]
                                     [uy (exact->inexact (hash-ref u 'y 9999.0))])
                                 (for/or ([bp (in-list cd-threatened-base-pts)])
                                   (<= (fast-dist2d ux uy (car bp) (cdr bp)) 28.0)))))
          u))
      (when (pair? cd-free-allies)
        (define cd-plan
          (plan-counter-drop-defense
           cd-free-allies enemy-units
           #:home-x (caar cd-threatened-base-pts)
           #:home-y (cdar cd-threatened-base-pts)
           #:base-points cd-threatened-base-pts))
        (when (> (counter-drop-plan-enemy-drops-detected cd-plan) 0)
          (for ([sa (in-list (counter-drop-plan->sexps cd-plan))])
            (when (and (pair? sa) (pair? (cdr sa)) (exact-integer? (cadr sa)))
              (set-add! wave3-handled-tags (cadr sa))
              (l34-emit-preserved! ctx sa)))))))

  (set-l34-ctx-dead-tags-rt! ctx dead-tags-rt)
  (set-l34-ctx-tbrain-committed-tags! ctx tbrain-committed-tags)
  (set-l34-ctx-tbrain-unit-actions! ctx tbrain-unit-actions)
)

(define (l34-phase3-classify! ctx)
  (define ally-bldgs (l34-ctx-ally-bldgs ctx))
  (define ally-units (l34-ctx-ally-units ctx))
  (define base-x (l34-ctx-base-x ctx))
  (define base-y (l34-ctx-base-y ctx))
  (define combat-units (l34-ctx-combat-units ctx))
  (define effects (l34-ctx-effects ctx))
  (define enemy-bldgs (l34-ctx-enemy-bldgs ctx))
  (define enemy-units (l34-ctx-enemy-units ctx))
  (define enemy-x (l34-ctx-enemy-x ctx))
  (define enemy-y (l34-ctx-enemy-y ctx))
  (define l34-sc (l34-ctx-l34-sc ctx))
  (define live-tactics-obs? (l34-ctx-live-tactics-obs? ctx))
  (define nat-x (l34-ctx-nat-x ctx))
  (define nat-y (l34-ctx-nat-y ctx))
  (define obs (l34-ctx-obs ctx))
  (define prelim-army-cx (l34-ctx-prelim-army-cx ctx))
  (define prelim-army-cy (l34-ctx-prelim-army-cy ctx))
  ;; ---------------------------------------------------------------------------
  ;; Adversarial Countermeasure #5: Ramp Force-Field Corrosive-Bile Breaker
  ;; ---------------------------------------------------------------------------
  (define ravager-cast-tags (pooled-mutable-seteqv! l34-sc 'ravager-cast-tags))
  (define force-fields
    (let ([eff-ffs (if (null? effects)
                       '()
                       (for/list ([eff (in-list effects)]
                                  #:when (eq? (hash-ref eff 'type 'none) 'force-field))
                         eff))]
          [unit-ffs (for/list ([e (in-list enemy-units)]
                               #:when (eq? (unit-type-sym e) 'force-field))
                      e)])
      (cond
        [(null? eff-ffs) unit-ffs]
        [(null? unit-ffs) eff-ffs]
        [else (append eff-ffs unit-ffs)])))
  (when (not (null? force-fields))
    (define ff (car force-fields))
    (define ffx (hash-ref ff 'x nat-x))
    (define ffy (hash-ref ff 'y nat-y))
    (define ravagers (for/list ([u (in-list combat-units)] #:when (eq? (unit-type-sym u) 'ravager)) u))
    (for ([rav (in-list (take ravagers (min 2 (length ravagers))))])
      (define rid (hash-ref rav 'id 140))
      (set-add! ravager-cast-tags rid)
      (l34-emit! ctx (list 'cast-spell rid 'corrosive-bile ffx ffy)))
    (for ([u (in-list combat-units)])
      (define ux (hash-ref u 'x base-x))
      (define uy (hash-ref u 'y base-y))
      (when (and (not (eq? (unit-type-sym u) 'ravager))
                 (<= (dist2d ffx ffy ux uy) SC2-FORCE-FIELD-STEPBACK-RADIUS))
        (l34-emit! ctx (list 'kite (hash-ref u 'id 101) base-x base-y)))))

  ;; ---------------------------------------------------------------------------
  ;; Adversarial Countermeasure #5b: Anti-Kite Defensive Leash (16.0 tiles)
  ;; ---------------------------------------------------------------------------
  (define lone-kiter?
    (and (= (length enemy-units) 1)
         (memq (unit-type-sym (car enemy-units))
               '(reaper hellion adept stalker oracle phoenix mutalisk))
         (< (length combat-units) SC2-LONE-KITER-MAX-DEFENDERS)))
  (when lone-kiter?
    (for ([u (in-list combat-units)])
      (when (and (memq (unit-type-sym u) '(zealot zergling roach immortal))
                 (> (dist2d base-x base-y (hash-ref u 'x base-x) (hash-ref u 'y base-y))
                    SC2-ANTI-KITE-LEASH-RADIUS))
        (l34-emit! ctx (list 'kite (hash-ref u 'id 101) nat-x nat-y)))))

  ;; ---------------------------------------------------------------------------
  ;; Pro Splash & Micro Countermeasures:
  ;;   1. Coalesced Hostile Ground Effects (`psi-storm`, `corrosive-bile`, `blinding-cloud`) &
  ;;      Enemy `disruptor-phased` (Purification Nova) Lateral Wing Evasion
  ;;   2. Enemy `widow-mine` / `widow-mine-burrowed` Out-Range Snipe, Lock Pull-Back & Bait
  ;;   3. Enemy `baneling` Light-Unit Radial Pre-Split (2.5x2.5 Bucketed)
  ;;   4. Enemy `hellion` & `lurker-burrowed` Collinear Lateral Scatter (+/- n-hat)
  ;;   5. Enemy `siege-tank-sieged` Line Discipline, Ravager Bile Stagger & 3-Flank Break
  ;; ---------------------------------------------------------------------------
  (define splash-evading-tags (pooled-mutable-seteqv! l34-sc 'splash-evading-tags))
  ;; L45-P0-1b (`ro01`): Propagate Phase-2 active drop transport claims into `splash-evading-tags`
  ;; so Phase 3/4a/4b/5a/5b/7 hazard/kite/spellcaster logic NEVER overwrites a loaded drop ship!
  (when live-tactics-obs?
    (define p2-tr-tags (hash-ref l34-sc 'transport-acted-tags #f))
    (when (set? p2-tr-tags)
      (for ([tid (in-set p2-tr-tags)])
        (set-add! splash-evading-tags tid))))
  (define disruptor-handled-tags (pooled-mutable-seteqv! l34-sc 'disruptor-handled-tags))
  (define disruptor-directive-set (pooled-mutable-set! l34-sc 'disruptor-directive-set))
  (define fprelim-cx (exact->inexact prelim-army-cx))
  (define fprelim-cy (exact->inexact prelim-army-cy))
  (define (prelim-dist2-le? obj r2)
    (define ox (hash-ref obj 'x 9999.0))
    (define oy (hash-ref obj 'y 9999.0))
    (if (and (real? ox) (real? oy) (= (- ox ox) 0) (= (- oy oy) 0))
        (let ([dx (- fprelim-cx (exact->inexact ox))]
              [dy (- fprelim-cy (exact->inexact oy))])
          (<= (+ (* dx dx) (* dy dy)) r2))
        (<= (dist2d prelim-army-cx prelim-army-cy ox oy) (sqrt r2))))

  ;; Single-pass classification over ally-units, ally-bldgs, enemy-units, enemy-bldgs, combat-units
  (define ally-disruptor-units-rev '())
  (define ally-sentries-rev '())
  (define ally-overseers-rev '())
  (define ally-infestors-rev '())
  (define mode-candidates-rev '())
  (define ally-zerg-burrow-candidate? #f)
  (define ally-acc-mask 0)
  (define creep-ally-slice-rev '())
  (define creep-queen-xs '())
  (define creep-queen-ys '())
  (for ([u (in-list ally-units)])
    (define ut (unit-type-sym u))
    (define af (fast-ally-sym-flags ut))
    (set! ally-acc-mask (bitwise-ior ally-acc-mask af))
    (unless (zero? (bitwise-and af #x40489E))
      (when (bitwise-bit-set? af 1)
        (set! ally-disruptor-units-rev (cons u ally-disruptor-units-rev)))
      (when (bitwise-bit-set? af 2)
        (set! ally-sentries-rev (cons u ally-sentries-rev)))
      (when (bitwise-bit-set? af 3)
        (set! ally-overseers-rev (cons u ally-overseers-rev)))
      (when (bitwise-bit-set? af 4)
        (set! ally-infestors-rev (cons u ally-infestors-rev)))
      (when (bitwise-bit-set? af 7)
        (set! mode-candidates-rev (cons u mode-candidates-rev)))
      (when (and (not ally-zerg-burrow-candidate?)
                 (bitwise-bit-set? af 11)
                 (hash? u)
                 (or (hash-ref u 'burrowed #f)
                     (hash-ref u 'is-burrowed? #f)
                     (let* ([hp-raw (or (hash-ref u 'hp #f) (hash-ref u 'health #f) 100.0)]
                            [hp (exact->inexact (fast-finite-real hp-raw 100.0))]
                            [mhp-raw (or (hash-ref u 'max-hp #f) (hash-ref u 'health-max #f) hp)]
                            [mhp (max 1.0 (exact->inexact (fast-finite-real mhp-raw hp)))])
                       (<= hp (* 0.999 mhp)))))
        (set! ally-zerg-burrow-candidate? #t))
      (when (bitwise-bit-set? af 14)
        (set! creep-ally-slice-rev (cons u creep-ally-slice-rev))
        (define qx (hash-ref u 'x base-x))
        (define qy (hash-ref u 'y base-y))
        (set! creep-queen-xs (cons (if (flonum? qx) qx (exact->inexact qx)) creep-queen-xs))
        (set! creep-queen-ys (cons (if (flonum? qy) qy (exact->inexact qy)) creep-queen-ys)))
      (when (bitwise-bit-set? af 22)
        (set! creep-ally-slice-rev (cons u creep-ally-slice-rev)))))
  (define ally-unit-det? (bitwise-bit-set? ally-acc-mask 0))
  (define has-non-overlord-spotter? (bitwise-bit-set? ally-acc-mask 5))
  (define any-pro-caster? (bitwise-bit-set? ally-acc-mask 6))
  (define has-ally-roach? (bitwise-bit-set? ally-acc-mask 8))
  (define has-ally-ravager? (bitwise-bit-set? ally-acc-mask 9))
  (when (bitwise-bit-set? ally-acc-mask 10)
    (set! ally-zerg-burrow-candidate? #t))
  (define has-ally-swarm-host-or-locust? (bitwise-bit-set? ally-acc-mask 12))
  (define has-ally-zergling? (bitwise-bit-set? ally-acc-mask 13))
  (define has-ally-queen? (bitwise-bit-set? ally-acc-mask 14))
  (define has-ally-queen-or-tumor? (not (zero? (bitwise-and ally-acc-mask 49152))))
  (define has-ally-changeling-or-overseer? (bitwise-bit-set? ally-acc-mask 16))
