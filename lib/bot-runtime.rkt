(define (reset-wave3-tactical-state! rt)
  (reset-rt-disruptor-tracker! rt)
  (reset-rt-spell-claims! rt)
  (reset-rt-unit-mode-tracker! rt)
  (reset-rt-transport-tracker! rt)
  (set-box! (rt-wave3-frame-box rt) -1)
  (set-box! (rt-macro-bundle-cache rt) #f)
  (set-box! (rt-l1b-cache rt) #f)
  (let ([s (rt-l2-scratch rt)]) (when (hash? s) (hash-clear! s)))
  (let ([s (rt-l34-scratch rt)]) (when (hash? s) (hash-clear! s)))
  (let ([s (rt-l5-scratch rt)]) (when (hash? s) (hash-clear! s)))
  (let ([st (rt-splash-state rt)])
    (when (hash? st)
      (for ([k (in-list (hash-keys st))])
        (when (or (pair? k)
                  (memq k '(disruptor-directive-frame
                            disruptor-directive-set
                            wave3-preserved-frame
                            wave3-preserved-set
                            wm-disarmed-ht
                            mode-dwell-ht
                            wm-dwell-ht
                            lib-dwell-ht
                            vik-dwell-ht
                            thor-dwell-ht
                            bc-jump-ready-ht
                            bc-yamato-ready-ht
                            tank-dwell-ht)))
          (hash-remove! st k)))))
  (void))

