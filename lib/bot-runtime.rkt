  (define terran-addon-oy (exact->inexact SC2-TERRAN-ADDON-OFFSET-Y))
  (set-l2-ctx-terran-addon-oy! ctx terran-addon-oy)
  (when (not live-game?)
       (define rax-with-reactor
         (for/first ([b (in-list ally-bldgs)]
                     #:when (let ([bt (unit-type-sym b)])
                              (or (eq? bt 'barracks-reactor)
                                  (and (eq? bt 'barracks)
