  (define live-enemy-threat-supply (l2-ctx-live-enemy-threat-supply ctx))
  (define live-game? (l2-ctx-live-obs-harvesters? ctx))
  (define nat-x (l2-ctx-nat-x ctx))
  (define nat-y (l2-ctx-nat-y ctx))
  (define nexuses (l2-ctx-nexuses ctx))
  (define oledger (l2-ctx-oledger ctx))
  (define open-prod-slots (l2-ctx-open-prod-slots ctx))
  (define pressure-metrics (l2-ctx-pressure-metrics ctx))
  (define prio-saving-for-sym (l2-ctx-prio-saving-for-sym ctx))
  (define prio-scheduled-actions (l2-ctx-prio-scheduled-actions ctx))
  (define protoss-aa-needed? (l2-ctx-protoss-aa-needed? ctx))
  (define protoss-pending-robo-gas-reserve (l2-ctx-protoss-pending-robo-gas-reserve ctx))
  (define protoss-saving-for-expand? (l2-ctx-protoss-saving-for-expand? ctx))
  (define raw-obs (l2-ctx-raw-obs ctx))
  (define ready-bldg-types (l2-ctx-ready-bldg-types ctx))
  (define researched-upgs (l2-ctx-researched-upgs ctx))
  (define target-workers (l2-ctx-target-workers ctx))
  (define tech-obs (l2-ctx-tech-obs ctx))
  (define total-workers (l2-ctx-total-workers ctx))
  (define under-base-attack? (l2-ctx-under-base-attack? ctx))
  (define under-early-cheese? (l2-ctx-under-early-cheese? ctx))
  (define urgent-combat-or-intel-need? (l2-ctx-urgent-combat-or-intel-need? ctx))
  (define worker-rush-active? (l2-ctx-worker-rush-active? ctx))
  ;; Loop 64 B2 (Graph 14 Protoss 1-Forge +1 Weapons First):
  ;; Symmetric `p-upg-ok?` across all Forge upgrades + require `+1 Weapons` researched/pending
  ;; ahead of `+1 Armor`/`+1 Shields` on `< 2` ready Forges so 1-Forge NEVER jumps to +1 Armor first!
  (when (and (memq 'forge ready-bldg-types)
                (not urgent-combat-or-intel-need?))
       (define tc-ready? (memq 'twilight-council ready-bldg-types))
       (define ready-forge-cnt
         (count (lambda (b)
                  (and (hash? b)
                       (eq? (fast-canonical-structure-sym (unit-type-sym b)) 'forge)))
                (l2-ctx-ready-bldgs ctx)))
       (define wpn1-started-or-done?
         (not (l2-upgrade-needed? ctx 'protoss-ground-weapons-1)))
       (define allow-armor1-now?
         (or (>= ready-forge-cnt 2) wpn1-started-or-done?))
       (define (p-upg-ok? upg)
         (l2-protoss-colossus-escrow-ok? ctx (sc2-min-cost upg) (sc2-gas-cost upg)))
       (l2-emit-upgrade-queue!
        ctx
        'forge
        (list
         (list 'protoss-ground-weapons-1 #f (p-upg-ok? 'protoss-ground-weapons-1))
         (list 'protoss-ground-weapons-2 'protoss-ground-weapons-1 (and tc-ready? (p-upg-ok? 'protoss-ground-weapons-2)))
         (list 'protoss-ground-armor-1 #f (and allow-armor1-now? (p-upg-ok? 'protoss-ground-armor-1)))
         (list 'protoss-ground-weapons-3 'protoss-ground-weapons-2 (and tc-ready? (p-upg-ok? 'protoss-ground-weapons-3)))
         (list 'protoss-ground-armor-2 'protoss-ground-armor-1 (and tc-ready? (p-upg-ok? 'protoss-ground-armor-2)))
         (list 'protoss-ground-armor-3 'protoss-ground-armor-2 (and tc-ready? (p-upg-ok? 'protoss-ground-armor-3)))
         (list 'protoss-shields-1 #f (and allow-armor1-now? (p-upg-ok? 'protoss-shields-1)))
         (list 'protoss-shields-2 'protoss-shields-1 (and tc-ready? (p-upg-ok? 'protoss-shields-2)))
         (list 'protoss-shields-3 'protoss-shields-2 (and tc-ready? (p-upg-ok? 'protoss-shields-3))))))
  (when (and (memq 'twilight-council ready-bldg-types)
                (or (not protoss-saving-for-expand?)
                    (and live-game?
                         (eq? effective-enemy-race 'Zerg)
                         (>= (length nexuses) 2)
                         (>= eff-phase-supply 68)
                         (or (l2-plan-wants-now? ctx 'templar-archive)
                             (>= (l2-ctx-minerals ctx) (+ (sc2-min-cost 'templar-archive) 100)))))
                (l2-save-cancel-rebuild-ready? ctx 'templar-archive 60)
                (l2-protoss-colossus-escrow-ok? ctx (sc2-min-cost 'templar-archive) (sc2-gas-cost 'templar-archive))
                (or (and (not live-game?)
                         (or (l2-plan-wants-now? ctx 'templar-archive)
                             (l2-can-spend-by-priority? ctx 'templar-archive 'tech-upgrade)))
                    (and live-game?
                         (or (eq? bo-goal-sym 'templar-archive)
                             (>= enemy-muta-cnt-p 3)
                             (and (>= (length nexuses) 3) (>= eff-phase-supply 80))
                             ;; Loop 64 B2 (Graph 18 PvZ Archon/Storm): Unlock Templar Archive on
                             ;; >= 2 bases at >= 68 supply in PvZ so PvZ transitions into Archon/Storm!
                             (and (eq? effective-enemy-race 'Zerg)
                                  (>= (length nexuses) 2)
                                  (>= eff-phase-supply 68)))
                         (or (l2-plan-wants-now? ctx 'templar-archive)
                             (l2-can-spend-by-priority? ctx 'templar-archive 'tech-upgrade)
                             (and (eq? effective-enemy-race 'Zerg)
                                  (>= (length nexuses) 2)
                                  (>= eff-phase-supply 68)
                                  (not under-base-attack?)
                                  (not (l2-ctx-early-survival-crisis? ctx)))
                             (>= eff-phase-supply 92))))
                (not (l2-building-present-or-pending? ctx 'templar-archive))
                (>= (length nexuses) SC2-MIN-DESIRED-BASES)
                (>= (l2-ctx-gas ctx) (sc2-gas-cost 'templar-archive))
                (>= (l2-ctx-minerals ctx) (sc2-min-cost 'templar-archive))
                (l2-non-combat-min-ok? ctx (sc2-min-cost 'templar-archive) 'templar-archive))
       (let-values ([(tax tay) (l2-interior-offset ctx 6.5 -5.0)])
         (l2-emit-build-verified! ctx 'templar-archive tax tay)))
  (when (and (memq 'twilight-council ready-bldg-types)
                (not protoss-saving-for-expand?)
                (l2-save-cancel-rebuild-ready? ctx 'dark-shrine 60)
                (l2-protoss-colossus-escrow-ok? ctx (sc2-min-cost 'dark-shrine) (sc2-gas-cost 'dark-shrine))
                (not (l2-building-present-or-pending? ctx 'dark-shrine))
                (l2-plan-wants-now? ctx 'dark-shrine)
                (>= (l2-ctx-minerals ctx) (sc2-min-cost 'dark-shrine))
                (>= (l2-ctx-gas ctx) (sc2-gas-cost 'dark-shrine))
                (l2-non-combat-min-ok? ctx (sc2-min-cost 'dark-shrine) 'dark-shrine)
                (l2-non-combat-gas-ok? ctx (sc2-gas-cost 'dark-shrine) 'dark-shrine))
       (let-values ([(dsx dsy) (l2-interior-offset ctx 6.0 5.0)])
         (l2-emit-build-verified! ctx 'dark-shrine dsx dsy)))
  (when (and (memq 'templar-archive ready-bldg-types)
                (not urgent-combat-or-intel-need?)
                (l2-protoss-colossus-escrow-ok? ctx (sc2-min-cost 'psi-storm) (sc2-gas-cost 'psi-storm))
                (l2-upgrade-needed? ctx 'psi-storm))
       (l2-emit-research-verified! ctx 'psi-storm))
  ;; L48-W2 (`H2H #04 PvT` Robotics Bay Unblock): Honor `(l2-plan-wants-now? ctx 'robotics-bay)`
  ;; to bypass non-raider `protoss-aa-needed?` (e.g. routine Terran Medivac+Viking, while STILL
  ;; deferring to real capital air / Mutalisks / air raiders) AND bypass the `immortal>=1 / sup>=76`
  ;; legacy gate so Brain-scheduled `robotics-bay@960.0` always builds Colossi on time!
  (define brain-wants-robobay-now? (l2-plan-wants-now? ctx 'robotics-bay))
  (define p3-enemy-air-raiders? (l2-ctx-enemy-air-raiders? ctx))
  (define p3-enemy-capital-air?
    (ormap (lambda (e)
             (let ([cs (fast-canonical-unit-sym (unit-type-sym e))])
               (or (memq cs THOR-CAPITAL-AIR-SYMS)
                   (eq? cs 'mothership))))
           enemy-units))
  (when (and (memq 'robotics-facility ready-bldg-types)
                (l2-can-spend-by-priority? ctx 'robotics-bay 'tech-upgrade)
                (not (l2-building-present-or-pending? ctx 'robotics-bay))
                (l2-save-cancel-rebuild-ready? ctx 'robotics-bay 60)
                (or (not live-game?)
                    (not (or protoss-aa-needed? (> enemy-muta-cnt-p 0)))
                    (and brain-wants-robobay-now?
                         (not p3-enemy-capital-air?)
                         (= enemy-muta-cnt-p 0)
                         (not p3-enemy-air-raiders?))
                    (>= (l2-unit-count ctx 'phoenix) 4)
                    (>= (l2-unit-count ctx 'stalker) 10))
                ;; L36-P0-3 (`H2H #04`): Gate Robotics Bay on safe defense (`army-supply >= 14`
                ;; or surplus `minerals >= 400`) so PvT never starves on a bare 5:30 Robotics Bay!
                (or (not live-game?)
                    (>= live-army-supply 14.0)
                    (>= (l2-ctx-minerals ctx) 400))
                (or (not (hash-has-key? raw-obs 'mineral-harvesters))
                    (eq? bo-goal-sym 'robotics-bay)
                    brain-wants-robobay-now?
                    (and (eq? effective-enemy-race 'Terran)
                         (>= eff-phase-supply 52)
                         (>= (l2-unit-count ctx 'immortal) 1))
                    (and (>= eff-phase-supply 62)
                         (or (>= (l2-unit-count ctx 'immortal) 2)
                             (>= eff-phase-supply 76))))
                (>= (l2-ctx-minerals ctx) (sc2-min-cost 'robotics-bay))
                (>= (l2-ctx-gas ctx) (sc2-gas-cost 'robotics-bay))
                (l2-non-combat-min-ok? ctx (sc2-min-cost 'robotics-bay) 'robotics-bay)
                (l2-non-combat-gas-ok? ctx (sc2-gas-cost 'robotics-bay) 'robotics-bay))
       (let-values ([(rbyx rbyy) (l2-interior-offset ctx 7.0 4.0)])
         (l2-emit-build-verified! ctx 'robotics-bay rbyx rbyy))
       (when (or (not live-game?) (memq 'forge ready-bldg-types))
         (l2-emit-research-verified! ctx 'protoss-ground-weapons-1))
       (when (and (or (not live-game?)
                      (and (memq 'forge ready-bldg-types)
                           (>= (l2-ctx-minerals ctx) (sc2-min-cost 'photon-cannon))))
                  (refractory-allow-action?! cd-tracker
                                             (list 'static-detector 'photon-cannon)
                                             frame
                                             SC2-STATIC-DETECTOR-COOLDOWN-FRAMES))
         (if live-game?
             (let-values ([(pcx pcy) (l2-offset-defense-anchor ctx nat-x nat-y 5.5)])
               (l2-emit-build-verified! ctx 'photon-cannon pcx pcy 2.0))
             (l2-emit! ctx (list 'build 'photon-cannon nat-x nat-y)))))
  (when (and (memq 'robotics-bay ready-bldg-types)
                (not urgent-combat-or-intel-need?))
       (cond
         [(and (or (not live-game?)
                   (>= (l2-unit-count ctx 'colossus) 1))
               (l2-protoss-colossus-escrow-ok? ctx (sc2-min-cost 'extended-thermal-lance) (sc2-gas-cost 'extended-thermal-lance) #:for-etl? #t)
               (l2-upgrade-needed? ctx 'extended-thermal-lance))
          (l2-emit-research-verified! ctx 'extended-thermal-lance)]
         [(and (or (not live-game?)
                   (l2-plan-wants-now? ctx 'gravitic-booster)
                   (>= (l2-unit-count ctx 'observer) 1))
               (l2-protoss-colossus-escrow-ok? ctx (sc2-min-cost 'gravitic-booster) (sc2-gas-cost 'gravitic-booster))
               (l2-upgrade-needed? ctx 'gravitic-booster))
          (l2-emit-research-verified! ctx 'gravitic-booster)]))
  ;; W4-TAC-2-rt: Never merge HTs with energy >= 50 OR when enemy combat units are within 8.5t!
  (define ht-merge-enemy-coords
       (if live-game?
           (for/list ([e (in-list enemy-units)]
                      #:when (and (hash? e)
                                  (combat-unit-record? e)
                                  (real? (hash-ref e 'x #f))
                                  (real? (hash-ref e 'y #f))))
             (cons (exact->inexact (hash-ref e 'x 0.0))
                   (exact->inexact (hash-ref e 'y 0.0))))
           '()))
  (define (ht-safe-for-archon-merge? u)
       (and (< (hash-ref u 'energy 0) 50)
            (or (null? ht-merge-enemy-coords)
                (let ([ux (hash-ref u 'x #f)]
                      [uy (hash-ref u 'y #f)])
                  (or (not (real? ux)) (not (real? uy))
                      (let ([fux (exact->inexact ux)]
                            [fuy (exact->inexact uy)])
                        (not (for/or ([ec (in-list ht-merge-enemy-coords)])
                               (define dx (fl- fux (car ec)))
                               (define dy (fl- fuy (cdr ec)))
                               (fl<= (fl+ (fl* dx dx) (fl* dy dy)) 72.25)))))))))
  (define safe-dry-ht-count
       (if live-game?
           (count (lambda (u)
                    (and (hash? u)
                         (eq? (unit-type-sym u) 'high-templar)
                         (ht-safe-for-archon-merge? u)))
                  ally-units)
           0))
  (define avail-ht-slots
       (if live-game?
           (min (hash-ref open-prod-slots 'high-templar 0) safe-dry-ht-count)
           (hash-ref open-prod-slots 'high-templar 0)))
  ;; L44-P0-1b (`p15` Permanent-Cloak KO WIN): NEVER merge living cloaked Dark Templars into
  ;; visible Archons (`1766`) when the enemy has `0` live detectors (`missile-turret`,
  ;; `photon-cannon`, `spore-crawler`, `observer`, `raven`, `overseer`)! Keep DTs permanently
  ;; cloaked to sweep blind enemy armies/bases cleanly!
  (define dt-enemy-bldgs
    (let ([eb (and (hash? raw-obs) (hash-ref raw-obs 'enemy-buildings '()))])
      (if (list? eb) eb '())))
  (define dt-live-det-cnt
    (let ([det-entity?
           (lambda (e)
             (and (hash? e)
                  (not (eq? (hash-ref e 'snapshot? #f) #t))
                  (eqv? (hash-ref e 'display-type 1) 1)
                  (> (exact->inexact (hash-ref e 'hp 1.0)) 0.0)
                  (memq (fast-canonical-unit-sym (unit-type-sym e))
                        '(missile-turret photon-cannon spore-crawler
                          observer observer-siege-mode raven
                          overseer overseer-siege-mode))))])
      (+ (count det-entity? enemy-units)
         (count det-entity? dt-enemy-bldgs))))
  (define enemy-has-live-detector? (> dt-live-det-cnt 0))
  (define dt-ranged-anti-det-allies?
    (for/or ([u (in-list ally-units)])
      (and (hash? u)
           (memq (fast-canonical-unit-sym (unit-type-sym u))
                 '(stalker phoenix immortal tempest void-ray colossus adept)))))
  (define dt-active-skirmish-hold?
    (and live-game?
         (or (pair? enemy-units) (pair? dt-enemy-bldgs))
         (or (not enemy-has-live-detector?)
             (and (<= dt-live-det-cnt 3)
                  dt-ranged-anti-det-allies?))))
  (define wounded-dt-merge-cnt
    (if dt-active-skirmish-hold?
        (count (lambda (u)
                 (and (hash? u)
                      (eq? (fast-canonical-unit-sym (unit-type-sym u)) 'dark-templar)
                      (let* ([cur (exact->inexact (unit-total-hp-and-shield u))]
                             [mhp (exact->inexact (+ (hash-ref u 'max-hp 40.0)
                                                     (hash-ref u 'max-shield 80.0)))])
                        (< (/ cur (max 1.0 mhp)) 0.45))))
               ally-units)
        (hash-ref open-prod-slots 'dark-templar 0)))
  (define avail-dt-slots
    (cond
      [(not dt-active-skirmish-hold?) (hash-ref open-prod-slots 'dark-templar 0)]
      [(not enemy-has-live-detector?) 0]
      [else (min (hash-ref open-prod-slots 'dark-templar 0) wounded-dt-merge-cnt)]))
  (when (if live-game?
               (>= (+ avail-ht-slots avail-dt-slots) 2)
               (>= (count (lambda (u) (memq (unit-type-sym u) '(high-templar dark-templar))) ally-units) 2))
       (define consume-ht (min 2 avail-ht-slots))
       (define consume-dt (min (- 2 consume-ht) avail-dt-slots))
       (when (> consume-ht 0)
         (hash-set! open-prod-slots 'high-templar
                    (max 0 (- (hash-ref open-prod-slots 'high-templar 0) consume-ht))))
       (when (> consume-dt 0)
         (hash-set! open-prod-slots 'dark-templar (- avail-dt-slots consume-dt)))
       (l2-emit! ctx '(morph archon))
       (order-ledger-record-issued! oledger (+ 865500 (modulo frame 10000) (length (l2-ctx-actions ctx)))
                                    'morph 'archon base-x base-y frame))
  (define-values (p3-urgent-stalker? p3-urgent-reap-cnt p3-urgent-air-cnt p3-urgent-stlk-tgt p3-cloak-det-gas-need)
    (l2-protoss-urgent-aa-reaper-stalker-status ctx))
  ;; L52-2C (`#54 zig-reapers`): When >= 2 enemy Reapers are present (visible or OWM) and
  ;; CyberneticsCore is ready, hard-defer Zealots & Adepts until `stalker >= 4`!
  (define p3-eff-reaper-cnt (max p3-urgent-reap-cnt (l2-protoss-enemy-reaper-count ctx)))
  (define p3-anti-reaper-stalker-only?
    (and live-game?
         (>= p3-eff-reaper-cnt 2)
         (memq 'cybernetics-core ready-bldg-types)
         (< (l2-unit-count ctx 'stalker) 4)))
  (define p3-pvz-early-stalker-floor?
    (and live-game?
         (eq? effective-enemy-race 'Zerg)
         (< frame 6720)
         (memq 'cybernetics-core ready-bldg-types)
         (> (hash-ref open-prod-slots 'gateway 0) 0)
         (< (l2-unit-count ctx 'stalker) 2)
         (>= (l2-ctx-gas ctx) (sc2-gas-cost 'stalker))
         (l2-can-spend-supply? ctx (sc2-supply-cost 'stalker))))
  (define protoss-ideal-worker-cap
       (l2-compute-race-ideal-worker-cap ctx nexuses))
  (define protoss-probe-priority?
       (and (or (not protoss-saving-for-expand?)
                (and (not (not (member '(train probe) prio-scheduled-actions)))
                     (or (>= (length nexuses) 2)
                         (< (l2-ctx-minerals ctx) 240)))
                (and (< total-workers 17) (< (l2-ctx-minerals ctx) 240)))
            (or (not p3-urgent-stalker?)
                (< total-workers 18)
                (>= (- (l2-ctx-minerals ctx) (sc2-min-cost 'probe)) (sc2-min-cost 'stalker)))
            (or (not p3-pvz-early-stalker-floor?)
                (< total-workers 24)
                (>= (- (l2-ctx-minerals ctx) (sc2-min-cost 'probe)) (sc2-min-cost 'stalker)))
            (not crisis-freeze-workers?)
            (l2-worker-army-curve-satisfied? ctx)
            (or (not urgent-combat-or-intel-need?)
                (not (l2-ctx-can-train-basic-combat-now? ctx))
                (and (< frame 3360) (< total-workers 18) (<= live-enemy-threat-supply 0) (not under-base-attack?))
                (and (not under-base-attack?)
                     (< live-enemy-threat-supply 6)
                     (>= (l2-ctx-minerals ctx) (+ (sc2-min-cost 'probe) (l2-ctx-basic-combat-min-floor ctx)))))
            (or (< total-workers protoss-ideal-worker-cap)
                (l2-can-spend-by-priority? ctx 'probe 'worker))
            (< total-workers (min 70 (max target-workers protoss-ideal-worker-cap)))
            (or (not live-game?)
                (not under-base-attack?)
                (< total-workers 20)
                (not (or (memq 'gateway ready-bldg-types) (memq 'warp-gate ready-bldg-types)))
                (>= live-army-supply (max 4.0 (* 1.15 live-enemy-threat-supply))))
            (>= (l2-ctx-minerals ctx)
                (+ (sc2-min-cost 'probe)
                   (if (and live-game?
                            (>= total-workers 18)
                            (or under-base-attack?
                                (> live-enemy-threat-supply live-army-supply)))
                       (let-values ([(cm _cg) (l2-scheduled-combat-reserve ctx 'probe)]) cm)
                       0)))
            (l2-can-spend-supply? ctx (sc2-supply-cost 'probe))
            (not under-early-cheese?)))
  (when protoss-probe-priority?
       (l2-try-train-unit! ctx 'probe 'townhall 4
                        #:respect-bo-reserve? (l2-worker-respect-bo-reserve? ctx)))
  (set-l2-ctx-brain-scheduled-workers-rem! ctx 0)
  (define (gateway-unit-colossus-ok? u-sym)
       (or crisis-tech-upgrade-deferral?
           (and (or (<= (sc2-gas-cost u-sym) 0)
                    (>= (- (l2-ctx-gas ctx) (sc2-gas-cost u-sym)) protoss-pending-robo-gas-reserve))
                (or urgent-combat-or-intel-need?
                    under-base-attack?
                    (and (eq? u-sym 'zealot) (>= (l2-ctx-minerals ctx) 400))
                    (l2-protoss-colossus-escrow-ok? ctx (sc2-min-cost u-sym) (sc2-gas-cost u-sym))))))
  (define protoss-brain-saving-1base-nat?
    (and live-game?
         (= (length nexuses) 1)
         protoss-saving-for-expand?
         (eq? (l2-ctx-prio-saving-for-sym ctx) 'nexus)
         (>= (l2-ctx-minerals ctx) 250)
         (not (l2-ctx-worker-rush-active? ctx))
         (not under-early-cheese?)
         (not (l2-ctx-early-survival-crisis? ctx))
         (not (l2-ctx-bldg-actively-damaged? ctx))
         (<= (l2-ctx-live-enemy-threat-supply ctx) (l2-ctx-live-army-supply ctx))))
  (define-values (protoss-p3-air-dom-closure? _p3-live-air-cnt)
    (l2-protoss-air-dom-closure-status ctx))
  (when (and (or (and crisis-tech-upgrade-deferral?
                      (not protoss-brain-saving-1base-nat?))
                     (l2-ctx-early-survival-crisis? ctx)
                     (l2-enemy-early-pool-detected? ctx)
                     protoss-p3-air-dom-closure?
                     p3-urgent-stalker?
                     (not protoss-saving-for-expand?))
                (l2-can-spend-supply? ctx (sc2-supply-cost 'zealot)))
       ;; L35-P0-3 (`#75` CloakLoss -> 0, `#54` Reapers): Train urgent anti-air / anti-Reaper
       ;; Stalkers FIRST (respecting Observer #1 / Robo #1 gas reserve `p3-cloak-det-gas-need`)
       ;; ahead of Sentry / Adept / Zealot / expand escrow!
       (when (and p3-urgent-stalker?
                  (memq 'cybernetics-core ready-bldg-types)
                  (>= (l2-ctx-minerals ctx) (sc2-min-cost 'stalker))
                  (>= (- (l2-ctx-gas ctx) p3-cloak-det-gas-need) (sc2-gas-cost 'stalker)))
         (let ([max-stlk (max 0 (- p3-urgent-stlk-tgt (l2-unit-count ctx 'stalker)))])
           (for ([_i (in-range (min max-stlk (max 1 (hash-ref open-prod-slots 'gateway 0))))]
                 #:break (or (< (l2-ctx-minerals ctx) (sc2-min-cost 'stalker))
                             (< (- (l2-ctx-gas ctx) p3-cloak-det-gas-need) (sc2-gas-cost 'stalker))
                             (<= (hash-ref open-prod-slots 'gateway 0) 0)
                             (not (l2-can-spend-supply? ctx (sc2-supply-cost 'stalker)))))
             (l2-try-train-unit! ctx 'stalker 'gateway 5 #:respect-bo-reserve? #f))))
       (define p3-defer-zealot-for-aa-reaper-stalker?
         (or p3-anti-reaper-stalker-only?
             (and p3-urgent-stalker?
                  (or (>= p3-urgent-reap-cnt 2) (>= p3-urgent-air-cnt 1))
                  (< (l2-unit-count ctx 'stalker) p3-urgent-stlk-tgt)
                  (>= (- (l2-ctx-gas ctx) p3-cloak-det-gas-need) (sc2-gas-cost 'stalker))
                  (< (- (l2-ctx-minerals ctx) (sc2-min-cost 'zealot)) (sc2-min-cost 'stalker)))))
       ;; W12-P0-3-rt (`#36 P v 12PoolBot` / `#15 P v oberon` / Suite 32.4): Under active
       ;; pre-3:45 early rush, immediately spend Gateway slots without BO/expand escrow blocking
       ;; — preferring Adept/Zealot against pure Light Zergling floods (`>= 6` Lings, `0` armored/
       ;; air/Reaper) and Stalker/Zealot against mixed/armored/Reaper/Marauder pushes!
       (when (and live-game? (l2-ctx-early-survival-crisis? ctx))
         (define-values (er-ling-cnt er-non-ling-cnt)
           (for/fold ([lc 0] [nlc 0]) ([e (in-list enemy-units)])
             (define eut (unit-type-sym e))
             (cond
               [(memq eut '(zergling baneling)) (values (add1 lc) nlc)]
               [(memq eut '(reaper marauder roach ravager stalker immortal siege-tank siege-tank-sieged
                                   thor ultralisk colossus mutalisk void-ray phoenix banshee viking
                                   medivac liberator oracle))
                (values lc (add1 nlc))]
               [else (values lc nlc)])))
         (define er-pure-ling-flood? (and (>= er-ling-cnt 6) (= er-non-ling-cnt 0)))
         (cond
           [er-pure-ling-flood?
            (when (and (memq 'cybernetics-core ready-bldg-types)
                       (< (l2-unit-count ctx 'adept) 6)
                       (>= (l2-ctx-gas ctx) (sc2-gas-cost 'adept))
                       (>= (l2-ctx-minerals ctx) (sc2-min-cost 'adept)))
              (l2-try-train-unit! ctx 'adept 'gateway 5 #:respect-bo-reserve? #f))
            (when (>= (l2-ctx-minerals ctx) (sc2-min-cost 'zealot))
              (l2-try-train-unit! ctx 'zealot 'gateway 5 #:respect-bo-reserve? #f))
            (when (and (memq 'cybernetics-core ready-bldg-types)
                       (< (l2-unit-count ctx 'stalker) 2)
                       (>= (l2-ctx-gas ctx) (sc2-gas-cost 'stalker))
                       (>= (l2-ctx-minerals ctx) (sc2-min-cost 'stalker)))
              (l2-try-train-unit! ctx 'stalker 'gateway 5 #:respect-bo-reserve? #f))]
           [else
            (when (and (memq 'cybernetics-core ready-bldg-types)
                       (>= (- (l2-ctx-gas ctx) p3-cloak-det-gas-need) (sc2-gas-cost 'stalker))
                       (>= (l2-ctx-minerals ctx) (sc2-min-cost 'stalker)))
              (l2-try-train-unit! ctx 'stalker 'gateway 5 #:respect-bo-reserve? #f))
            (when (and (not p3-defer-zealot-for-aa-reaper-stalker?)
                       (>= (l2-ctx-minerals ctx) (sc2-min-cost 'zealot)))
              (l2-try-train-unit! ctx 'zealot 'gateway 5 #:respect-bo-reserve? #f))]))
       (cond
         [(memq 'cybernetics-core ready-bldg-types)
          ;; Dark Templar when Dark Shrine is ready
          (when (and (not crisis-tech-upgrade-deferral?)
                     (memq 'dark-shrine ready-bldg-types)
                     (gateway-unit-colossus-ok? 'dark-templar)
                     (or (l2-plan-wants-now? ctx 'dark-templar)
                         (< (l2-unit-count ctx 'dark-templar) 3))
                     (>= (l2-ctx-gas ctx) (sc2-gas-cost 'dark-templar))
                     (l2-can-spend-by-priority? ctx 'dark-templar 'combat-unit))
            (l2-try-train-unit! ctx 'dark-templar 'gateway 5 #:respect-bo-reserve? #t))
          ;; High Templar -> Psi Storm & Archon when Templar Archives ready
          (when (and (not crisis-tech-upgrade-deferral?)
                     (memq 'templar-archive ready-bldg-types)
                     (gateway-unit-colossus-ok? 'high-templar)
                     (< (l2-unit-count ctx 'high-templar) 6)
                     (>= (l2-ctx-gas ctx) (sc2-gas-cost 'high-templar)))
            (l2-try-train-unit! ctx 'high-templar 'gateway 5 #:respect-bo-reserve? #t))
          ;; Guardian Shield aura + gas sink: maintain 1 Sentry (respecting exact 100G cost & bo=sentry goal!)
          (when (and (not crisis-tech-upgrade-deferral?)
                     (>= (l2-ctx-gas ctx) (sc2-gas-cost 'sentry))
                     (gateway-unit-colossus-ok? 'sentry)
                     (or (eq? bo-goal-sym 'sentry)
                         (l2-plan-wants-now? ctx 'sentry)
                         (>= (length ally-combat-units) 2))
                     (if live-game?
                         (and (< (l2-unit-count ctx 'sentry) 1)
                              (or (eq? bo-goal-sym 'sentry)
                                  (eq? prio-saving-for-sym 'sentry)
                                  (l2-plan-wants-now? ctx 'sentry)
                                  (>= (l2-unit-count ctx 'stalker) 4)
                                  (and (>= (l2-ctx-gas ctx) 120) (>= (length ally-combat-units) 2))))
                         (< (l2-unit-count ctx 'sentry) 2)))
            (l2-try-train-unit! ctx 'sentry 'gateway 5 #:respect-bo-reserve? #t))
          ;; Counter-composition sensors: Zergling/Baneling floods (#5122350) vs Reaper/proxy Terran (#5122354)
          (define-values (enemy-reaper-cnt enemy-light-swarm-cnt enemy-armored-or-air-cnt pvz-unit? pvz-air?)
            (for/fold ([reap 0] [light 0] [arm-air 0] [pvz? #f] [pvz-air? #f])
                      ([e (in-list enemy-units)])
              (define ut (unit-type-sym e))
              (values
               (if (eq? ut 'reaper) (add1 reap) reap)
               ;; L54-W2-P1: Only Zerglings/Banelings count toward `pvz-ling-swarm-mode?`,
               ;; never Terran Marines (which previously triggered 6-Adept/2-Stalker caps in PvT!).
               (if (memq ut '(zergling baneling)) (add1 light) light)
               (if (memq ut '(roach ravager marauder stalker immortal siege-tank siege-tank-sieged
                                    thor ultralisk colossus mutalisk void-ray phoenix banshee viking medivac liberator))
                   (add1 arm-air)
                   arm-air)
               (or pvz?
                   (and (memq ut '(zergling baneling roach ravager hydralisk lurker
                                            lurker-burrowed lurker-mp-burrowed mutalisk corruptor
                                            ultralisk brood-lord broodlord drone queen overlord))
                        #t))
               (or pvz-air?
                   (and (memq ut '(mutalisk corruptor brood-lord broodlord))
                        #t)))))
          (define pvz-matchup?
            (and live-game?
                 (or (eq? effective-enemy-race 'Zerg)
                     pvz-unit?)))
          (define pvz-air-threat?
            (and pvz-matchup? pvz-air?))
          (define pvz-ling-swarm-mode?
            (and pvz-matchup?
                 (>= enemy-light-swarm-cnt 6)
                 (> enemy-light-swarm-cnt (* 2 (max 1 enemy-armored-or-air-cnt)))))
          (define pvz-anti-ground-mode?
            (and pvz-matchup?
                 (not pvz-air-threat?)
                 (or (> enemy-light-swarm-cnt 0)
                     (> enemy-armored-or-air-cnt 0)
                     (< (l2-unit-count ctx 'zealot) (max 4 (* 2 (l2-unit-count ctx 'stalker)))))))
          ;; W12-P0-2 (`#12/#15/#24`): Narrow Zealot gas-core suppression strictly to >= 3 ready
          ;; Gateways & gas >= 100 & minerals < 150 (outside early-rush / Ling swarm) so 1-2 Gate
          ;; Protoss never starves early Zealots or Gateway scaling.
          (define ready-gw-cnt-p
            (count (lambda (b)
                     (and (hash? b)
                          (memq (fast-canonical-structure-sym (unit-type-sym b)) '(gateway warp-gate))
                          (>= (hash-ref b 'build-progress 1.0) SC2-BUILD-COMPLETE-PROGRESS)))
                   (l2-ctx-ally-bldgs ctx)))
          (define protoss-suppress-zealot-for-gas-core?
            (and live-game?
                 (not (l2-ctx-early-survival-crisis? ctx))
                 (>= ready-gw-cnt-p 3)
                 (memq 'cybernetics-core ready-bldg-types)
                 (>= (l2-ctx-gas ctx) 100)
                 (< (l2-ctx-minerals ctx) 150)
                 (not pvz-ling-swarm-mode?)
                 (not (l2-enemy-early-pool-detected? ctx))))
          (define anti-reaper-or-proxy-terran?
            (and live-game?
                 (or (>= enemy-reaper-cnt 1)
                     (and forward-proxy-detected? (eq? effective-enemy-race 'Terran)))))
          (cond
            [pvz-ling-swarm-mode?
             ;; Counter Zergling/Baneling floods (#5122350) with tanky Zealots + Adepts
             ;; instead of overbuilding Stalkers that get surrounded and shredded!
             (when (and (< (l2-unit-count ctx 'adept) 6)
                        (gateway-unit-colossus-ok? 'adept)
                        (or (l2-can-spend-by-priority? ctx 'adept 'combat-unit)
                            (l2-can-spend-by-priority? ctx 'stalker 'combat-unit)))
               (l2-try-train-unit! ctx 'adept 'gateway 5 #:respect-bo-reserve? #t))
             (when (and (gateway-unit-colossus-ok? 'zealot)
                        (or (l2-can-spend-by-priority? ctx 'zealot 'combat-unit)
                            (l2-can-spend-by-priority? ctx 'stalker 'combat-unit)))
               (l2-try-train-unit! ctx 'zealot 'gateway 5 #:respect-bo-reserve? #t))
             (when (and (gateway-unit-colossus-ok? 'stalker)
                        (or pvz-air-threat?
                            (and (not pvz-matchup?) (enemy-tech-observation-requires-anti-air? tech-obs))
                            (< (l2-unit-count ctx 'stalker)
                               (if (>= (l2-ctx-gas ctx) 225) 8 2)))
                        (l2-can-spend-by-priority? ctx 'stalker 'combat-unit))
               (l2-try-train-unit! ctx 'stalker 'gateway 5 #:respect-bo-reserve? #t))]
            [pvz-anti-ground-mode?
             ;; In PvZ vs Roach/Ravager/Zergling (`P0-2b`, `#5138232`), ensure a baseline ranged
             ;; Stalker core (`>= 4` before 5:00 / `>= 2` later at `>= 50G`) so Protoss never hits
             ;; 5:13 with 0 Stalkers, while conserving extra gas for Immortals/Archons/Colossi!
             (when (and (gateway-unit-colossus-ok? 'stalker)
                        (or (and (< frame 6720)
                                 (< (l2-unit-count ctx 'stalker) 4)
                                 (>= (l2-ctx-gas ctx) (sc2-gas-cost 'stalker)))
                            (and (>= (l2-ctx-gas ctx) 150)
                                 (< (l2-unit-count ctx 'stalker) (if (>= (l2-ctx-gas ctx) 300) 10 5))))
                        (not (and (memq 'robotics-facility ready-bldg-types)
                                  (> (hash-ref open-prod-slots 'robotics-facility 0) 0)
                                  (or (eq? bo-goal-sym 'immortal)
                                      (eq? prio-saving-for-sym 'immortal))
                                  (< (l2-ctx-minerals ctx) (+ (sc2-min-cost 'immortal) (sc2-min-cost 'stalker)))))
                        (l2-can-spend-by-priority? ctx 'stalker 'combat-unit))
               (l2-try-train-unit! ctx 'stalker 'gateway 5 #:respect-bo-reserve? #t))
             (when (and (not protoss-suppress-zealot-for-gas-core?)
                        (gateway-unit-colossus-ok? 'zealot)
                        (l2-can-spend-by-priority? ctx 'zealot 'combat-unit))
               (l2-try-train-unit! ctx 'zealot 'gateway 5 #:respect-bo-reserve? #t))
             (when (and (< (l2-unit-count ctx 'adept) 3)
                        (< frame 4000)
                        (gateway-unit-colossus-ok? 'adept)
                        (l2-can-spend-by-priority? ctx 'adept 'combat-unit))
               (l2-try-train-unit! ctx 'adept 'gateway 5 #:respect-bo-reserve? #t))
             (when (and (gateway-unit-colossus-ok? 'stalker)
                        (< (l2-unit-count ctx 'stalker) (if (>= (l2-ctx-gas ctx) 225) 5 3))
                        (l2-can-spend-by-priority? ctx 'stalker 'combat-unit))
               (l2-try-train-unit! ctx 'stalker 'gateway 5 #:respect-bo-reserve? #t))]
            [anti-reaper-or-proxy-terran?
             ;; Counter proxy Reapers / proxy Barracks (#5122354, #5131254, #54 zig-reapers) with ranged Stalkers first;
             ;; vs >= 2 Reapers, hard-defer slow un-Charged Zealots & Adepts until `stalker >= 4`!
             (when (and (gateway-unit-colossus-ok? 'stalker)
                        (or p3-anti-reaper-stalker-only?
                            (l2-can-spend-by-priority? ctx 'stalker 'combat-unit)))
               (l2-try-train-unit! ctx 'stalker 'gateway 5
                                   #:respect-bo-reserve? (not p3-anti-reaper-stalker-only?)))
             (when (and (not p3-anti-reaper-stalker-only?)
                        (< enemy-reaper-cnt 2)
                        (< (l2-unit-count ctx 'adept) 3)
                        (gateway-unit-colossus-ok? 'adept)
                        (or (l2-can-spend-by-priority? ctx 'adept 'combat-unit)
                            (l2-can-spend-by-priority? ctx 'stalker 'combat-unit)))
               (l2-try-train-unit! ctx 'adept 'gateway 5 #:respect-bo-reserve? #t))
             (when (and (not protoss-suppress-zealot-for-gas-core?)
                        (not p3-defer-zealot-for-aa-reaper-stalker?)
                        (not p3-anti-reaper-stalker-only?)
                        (gateway-unit-colossus-ok? 'zealot)
                        (l2-can-spend-by-priority? ctx 'zealot 'combat-unit)
                        (or (memq 'charge researched-upgs)
                            (>= (l2-ctx-minerals ctx) 300)
                            (and (< enemy-reaper-cnt 2)
                                 (or (< (l2-ctx-gas ctx) (sc2-gas-cost 'adept))
                                     (>= (l2-ctx-minerals ctx) 225)))))
               (l2-try-train-unit! ctx 'zealot 'gateway 5 #:respect-bo-reserve? #t))]
            [else
             ;; L54-W2-P1: Train Stalker BEFORE proactive Adept whenever Brain/BO schedules
             ;; `stalker` (or `adept >= 2`), and cap proactive Adepts at `< 2` so Adepts never
             ;; steal 6–13 Gateway slots from Stalkers in PvP/PvT!
             (define brain-wants-stalker-first?
               (or (and (member '(train stalker) prio-scheduled-actions) #t)
                   (and (macro-brain-decision? (l2-ctx-macro-decision ctx))
                        (memq 'stalker (macro-brain-decision-scheduled-ids (l2-ctx-macro-decision ctx)))
                        #t)
                   (eq? bo-goal-sym 'stalker)
                   (eq? prio-saving-for-sym 'stalker)
                   (>= (l2-unit-count ctx 'adept) 2)))
             (define (try-protoss-else-stalker!)
               (when (and (or protoss-p3-air-dom-closure?
                              (gateway-unit-colossus-ok? 'stalker))
                          (or crisis-tech-upgrade-deferral?
                              protoss-p3-air-dom-closure?
                              (l2-can-spend-by-priority? ctx 'stalker 'combat-unit)))
                 (l2-try-train-unit! ctx 'stalker 'gateway 5
                                     #:respect-bo-reserve? (not (or crisis-tech-upgrade-deferral?
                                                                    protoss-p3-air-dom-closure?)))))
             (define (try-protoss-else-adept!)
               (when (and (not crisis-tech-upgrade-deferral?)
                          (< (l2-unit-count ctx 'adept) 2)
                          ;; L55-T8 (`#003 PvP`): Stop warping replacement Adepts in midgame PvP (`>= 3:30`)!
                          (or (not (eq? effective-enemy-race 'Protoss))
                              (< frame 4704))
                          (gateway-unit-colossus-ok? 'adept)
                          (or (l2-plan-wants-now? ctx 'adept)
                              (and live-game? (< frame 3000) (< (l2-unit-count ctx 'adept) 1) (= (l2-unit-count ctx 'stalker) 0)))
                          (l2-can-spend-by-priority? ctx 'adept 'combat-unit))
                 (l2-try-train-unit! ctx 'adept 'gateway 5 #:respect-bo-reserve? #t)))
             (if brain-wants-stalker-first?
                 (begin
                   (try-protoss-else-stalker!)
                   (try-protoss-else-adept!))
                 (begin
                   (try-protoss-else-adept!)
                   (try-protoss-else-stalker!)))
             ;; L57-R1 (`#063 SmoothBrain`, `+40` Zealot leak): Inside the ready-CyberCore `[else]`
             ;; branch (outside `pvz-ling-swarm-mode?` / `pvz-anti-ground-mode?` / early-pool), when
             ;; `gas >= 50` (net of pending Robo reserve) and `minerals < 225` (without Charge),
             ;; hold `100..224M` (~1.5s) for a `125M/50G` Stalker instead of dumping `100M` into Zealot!
             (define p3-hold-zealot-for-stalker?
               (and live-game?
                    (not protoss-p3-air-dom-closure?)
                    (not (l2-enemy-early-pool-detected? ctx))
                    (not (memq 'charge researched-upgs))
                    (>= (- (l2-ctx-gas ctx) protoss-pending-robo-gas-reserve) (sc2-gas-cost 'stalker))
                    (< (l2-ctx-minerals ctx) 225)))
             (when (and (not protoss-suppress-zealot-for-gas-core?)
                        (not p3-defer-zealot-for-aa-reaper-stalker?)
                        (not p3-hold-zealot-for-stalker?)
                        (or protoss-p3-air-dom-closure?
                            (gateway-unit-colossus-ok? 'zealot))
                        (or crisis-tech-upgrade-deferral?
                            protoss-p3-air-dom-closure?
                            (and (l2-can-spend-by-priority? ctx 'zealot 'combat-unit)
                                 (or (< (l2-ctx-gas ctx) (sc2-gas-cost 'stalker))
                                     (and (> protoss-pending-robo-gas-reserve 0)
                                          (< (- (l2-ctx-gas ctx) protoss-pending-robo-gas-reserve) (sc2-gas-cost 'stalker)))
                                     (>= (l2-ctx-minerals ctx) 225)
                                     (and urgent-combat-or-intel-need? (< (l2-ctx-minerals ctx) (sc2-min-cost 'stalker)))
                                     (and (memq 'charge researched-upgs)
                                          (< (l2-ctx-gas ctx) 200)
                                          (<= (l2-unit-count ctx 'zealot) (l2-unit-count ctx 'stalker)))))))
               (l2-try-train-unit! ctx 'zealot 'gateway 5
                                   #:respect-bo-reserve? (not (or crisis-tech-upgrade-deferral?
                                                                  protoss-p3-air-dom-closure?))))])]
         [(and (or (memq 'gateway ready-bldg-types) (memq 'warp-gate ready-bldg-types))
               (gateway-unit-colossus-ok? 'zealot)
               (or crisis-tech-upgrade-deferral?
                   (l2-enemy-early-pool-detected? ctx)
                   (l2-can-spend-by-priority? ctx 'zealot 'combat-unit))
               (let ([need-core-first?
                      (and (= (l2-cur-ally-canon-bldg-count ctx 'cybernetics-core) 0)
                           (= (order-ledger-pending-count-for-type oledger 'cybernetics-core frame) 0)
                           (or (ormap (lambda (e) (eq? (fast-canonical-unit-sym (unit-type-sym e)) 'reaper))
                                      enemy-units)
                               (and (l2-enemy-early-pool-detected? ctx)
                                    (not (and live-game?
                                              (< frame 5400)
                                              (< (length ally-combat-units) 4)
                                              (or under-base-attack?
                                                  (l2-ctx-early-survival-crisis? ctx)))))
                               (and (eq? effective-enemy-race 'Terran)
                                    (>= (l2-unit-count ctx 'zealot) 1))))])
                 (or (not need-core-first?)
                     (>= (- (l2-ctx-minerals ctx) (sc2-min-cost 'zealot))
                         (sc2-min-cost 'cybernetics-core)))))
          (l2-try-train-unit! ctx 'zealot 'gateway 5
                              #:respect-bo-reserve? (and (not crisis-tech-upgrade-deferral?)
                                                         (not (l2-enemy-early-pool-detected? ctx))))]))
  (when (and (not protoss-probe-priority?)
                (not crisis-freeze-workers?)
                (or (not p3-urgent-stalker?)
                    (< total-workers 18)
                    (>= (- (l2-ctx-minerals ctx) (sc2-min-cost 'probe)) (sc2-min-cost 'stalker)))
                (l2-worker-army-curve-satisfied? ctx)
                (not protoss-saving-for-expand?)
                (l2-can-spend-by-priority? ctx 'probe 'worker)
                (< total-workers
                   (if live-game?
                       (min 70 (max target-workers protoss-ideal-worker-cap))
                       target-workers))
                (or (member '(train probe) prio-scheduled-actions)
                    worker-rush-active?
                    (< total-workers 14)
                    (< (hash-ref pressure-metrics 'threat-pressure 0.0) 1.0)))
       (l2-try-train-unit! ctx 'probe 'townhall 4
                        #:respect-bo-reserve? (l2-worker-respect-bo-reserve? ctx))))

;; L35-P0-3 (`#41` Zerglings, `#53` Reapers): Pre-5:00 (`frame < 6720`) early-rush Hellion/Marine
;; defense override. When facing `>= 3` Reapers or `>= 12` Zerglings (or active base attack /
;; early survival crisis with `< 12` army supply) until home defense reaches `>= 4` Hellions or
;; `>= 10` Marines, immediately emit Hellions from bare/Reactor Factories + Marines from Barracks
;; without waiting on FactoryTechLab, Starport, SiegeTank, or OrbitalCommand escrow!
(define (l2-terran-early-fast-rush-status ctx)
  (define live-game? (l2-ctx-live-obs-harvesters? ctx))
  (define frame (l2-ctx-frame ctx))
  (cond
    [(or (not live-game?) (>= frame 6720))
     (values #f #f 0 0)]
    [else
     (define enemy-units (or (l2-ctx-enemy-units ctx) '()))
     (define-values (vis-reap vis-ling)
       (for/fold ([rc 0] [lc 0]) ([e (in-list enemy-units)] #:when (hash? e))
         (define cu (fast-canonical-unit-sym (unit-type-sym e)))
         (values (if (eq? cu 'reaper) (add1 rc) rc)
                 (if (eq? cu 'zergling) (add1 lc) lc))))
     (define rt (l2-ctx-rt ctx))
     (define owm-sum (and rt (opponent-world-model-last-summary (rt-opponent-world-model rt))))
     (define kc (and owm-sum (opponent-world-summary-known-unit-counts owm-sum)))
     (define eff-reap (max vis-reap (if (hash? kc) (hash-ref kc 'reaper 0) 0)))
     (define eff-ling (max vis-ling (if (hash? kc) (hash-ref kc 'zergling 0) 0)))
     (define cur-hellions (+ (l2-unit-count ctx 'hellion) (l2-unit-count ctx 'hellbat)))
     (define cur-marines (l2-unit-count ctx 'marine))
     (define defense-below-floor? (and (< cur-hellions 4) (< cur-marines 10)))
     (define reaper-or-ling-swarm? (or (>= eff-reap 3) (>= eff-ling 12)))
     (define early-crisis-low-army?
       (and (or (l2-ctx-under-base-attack? ctx)
                (l2-ctx-early-survival-crisis? ctx))
            (< (l2-ctx-live-army-supply ctx) 12.0)))
     (values (and defense-below-floor? (or reaper-or-ling-swarm? early-crisis-low-army?))
             (and defense-below-floor? reaper-or-ling-swarm?)
             eff-reap
             eff-ling)]))

(define (l2-terran-early-fast-rush-min-reserve ctx)
  (define ready-bldg-types (l2-ctx-ready-bldg-types ctx))
  (define open-prod-slots (l2-ctx-open-prod-slots ctx))
  (+ (if (and (memq 'factory ready-bldg-types)
              (> (hash-ref open-prod-slots 'factory 0) 0)
              (< (+ (l2-unit-count ctx 'hellion) (l2-unit-count ctx 'hellbat)) 4))
         (sc2-min-cost 'hellion)
         0)
     (if (and (memq 'barracks ready-bldg-types)
              (> (hash-ref open-prod-slots 'barracks 0) 0)
              (< (l2-unit-count ctx 'marine) 10))
         (sc2-min-cost 'marine)
         0)))

(define (l2-terran-phase1-orbital-addon-expand! ctx)
  (define allow-exact-wall-slot? (l2-ctx-allow-exact-wall-slot? ctx))
  (define ally-bldgs (l2-ctx-ally-bldgs ctx))
  (define base-x (l2-ctx-base-x ctx))
  (define base-y (l2-ctx-base-y ctx))
  (define blocked-nat-expanded-early? (l2-ctx-blocked-nat-expanded-early? ctx))
  (define bypass-wall-depot1? (l2-ctx-bypass-wall-depot1? ctx))
  (define cd-tracker (l2-ctx-cd-tracker ctx))
  (define crisis-freeze-expand-or-gas? (l2-ctx-crisis-freeze-expand-or-gas? ctx))
  (define crisis-tech-upgrade-deferral? (l2-ctx-crisis-tech-upgrade-deferral? ctx))
  (define cur-escrow-age-frames (l2-ctx-cur-escrow-age-frames ctx))
  (define desired-bases (l2-ctx-desired-bases ctx))
  (define early-survival-crisis? (l2-ctx-early-survival-crisis? ctx))
  (define eff-phase-supply (l2-ctx-eff-phase-supply ctx))
  (define endgame-corner-hunt? (l2-ctx-endgame-corner-hunt? ctx))
  (define enemy-units (l2-ctx-enemy-units ctx))
  (define escrow-suppressed-active? (l2-ctx-escrow-suppressed-active? ctx))
  (define forward-proxy-detected? (l2-ctx-forward-proxy-detected? ctx))
  (define frame (l2-ctx-frame ctx))
  (define hard-supply-lockout-reserve-min (l2-ctx-hard-supply-lockout-reserve-min ctx))
  (define in-base-proxy-completed-cannon? (l2-ctx-in-base-proxy-completed-cannon? ctx))
  (define intel-confidence (l2-ctx-intel-confidence ctx))
  (define live-army-supply (l2-ctx-live-army-supply ctx))
  (define live-enemy-threat-supply (l2-ctx-live-enemy-threat-supply ctx))
  (define live-game-obs? (l2-ctx-live-game-obs? ctx))
  (define live-game? (l2-ctx-live-obs-harvesters? ctx))
  (define macro-plan (l2-ctx-macro-plan ctx))
  (define max-escrow-timeout-frames (l2-ctx-max-escrow-timeout-frames ctx))
  (define nat-x (l2-ctx-nat-x ctx))
  (define nat-y (l2-ctx-nat-y ctx))
  (define natural-blocked? (l2-ctx-natural-blocked? ctx))
  (define obs (l2-ctx-obs ctx))
  (define oledger (l2-ctx-oledger ctx))
  (define open-prod-slots (l2-ctx-open-prod-slots ctx))
  (define orphaned-prereqs (l2-ctx-orphaned-prereqs ctx))
  (define ready-bldg-types (l2-ctx-ready-bldg-types ctx))
  (define rt (l2-ctx-rt ctx))
  (define supply-used (l2-ctx-supply-used ctx))
  (define tech-obs (l2-ctx-tech-obs ctx))
  (define terran-ramp-wall (l2-ctx-terran-ramp-wall ctx))
  (define total-workers (l2-ctx-total-workers ctx))
  (define under-base-attack? (l2-ctx-under-base-attack? ctx))
  (define under-early-cheese? (l2-ctx-under-early-cheese? ctx))
  (define urgent-combat-or-intel-need? (l2-ctx-urgent-combat-or-intel-need? ctx))
  (define ccs-rev '())
  (define refineries-rev '())
  (define active-refineries-rev '())
  (define barracks-rev '())
  (define factories-rev '())
  (for ([b (in-list ally-bldgs)])
       (define cs (fast-canonical-structure-sym (unit-type-sym b)))
       (cond
         [(memq cs '(command-center orbital-command planetary-fortress))
          (set! ccs-rev (cons b ccs-rev))]
         [(eq? cs 'refinery)
          (set! refineries-rev (cons b refineries-rev))
          (when (l2-active-gas-bldg? ctx b)
            (set! active-refineries-rev (cons b active-refineries-rev)))]
         [(eq? cs 'barracks)
          (set! barracks-rev (cons b barracks-rev))]
         [(eq? cs 'factory)
          (set! factories-rev (cons b factories-rev))]))
  (define ccs (reverse ccs-rev))
  (set-l2-ctx-ccs! ctx ccs)
  (define refineries (reverse refineries-rev))
  (define active-refineries (reverse active-refineries-rev))
  (set-l2-ctx-active-refineries! ctx active-refineries)
  (define barracks-list (reverse barracks-rev))
  (set-l2-ctx-barracks-list! ctx barracks-list)
  (define factories-list (reverse factories-rev))
  (set-l2-ctx-factories-list! ctx factories-list)
  (define mule-patch-id (hash-ref obs 'mineral-patch-id SC2-SYNTHETIC-MINERAL-PATCH-ID))
  (define raw-mineral-patches
       (let ([mps (hash-ref obs 'mineral-patches '())])
         (if (list? mps) (filter hash? mps) '())))
  (define splash-st (rt-splash-state rt))
  (define scanned-pts '())
  (define claimed-mule-patches (mutable-seteqv))
  (define scan-candidates-box RUNTIME-MISSING)
  (define enemy-bldgs (or (l2-ctx-enemy-bldgs ctx) '()))
  (define (get-scan-candidates)
    (when (eq? scan-candidates-box RUNTIME-MISSING)
      (define raw-ripples (l2-shimmer-ripples ctx))
      (define ally-det-pts
        (append
         (for/list ([u (in-list (or (l2-ctx-ally-units ctx) '()))]
                    #:when (and (hash? u)
                                (eq? (fast-canonical-unit-sym (unit-type-sym u)) 'raven)
                                (real? (hash-ref u 'x #f)) (real? (hash-ref u 'y #f))))
           (cons (exact->inexact (hash-ref u 'x base-x))
                 (exact->inexact (hash-ref u 'y base-y))))
         (for/list ([b (in-list ally-bldgs)]
                    #:when (and (hash? b)
                                (eq? (fast-canonical-structure-sym (unit-type-sym b)) 'missile-turret)
                                (>= (hash-ref b 'build-progress 1.0) SC2-BUILD-COMPLETE-PROGRESS)
                                (real? (hash-ref b 'x #f)) (real? (hash-ref b 'y #f))))
           (cons (exact->inexact (hash-ref b 'x base-x))
                 (exact->inexact (hash-ref b 'y base-y))))))
      (define (covered-by-det? ex0 ey0)
        (for/or ([dp (in-list ally-det-pts)])
          (define dx (fl- ex0 (car dp)))
          (define dy (fl- ey0 (cdr dp)))
          (fl<= (fl+ (fl* dx dx) (fl* dy dy)) 100.0)))
      (define raw-cands
        (append
         (for/list ([e (in-list enemy-units)]
                    #:when (and (hash? e)
                                (not (memq (fast-canonical-unit-sym (unit-type-sym e))
                                           '(creep-tumor creep-tumor-burrowed creep-tumor-queen)))
                                (or (eq? (hash-ref e 'cloaked #f) #t)
                                    (memq (hash-ref e 'cloak 0) '(1 2 cloaked cloaked-detected))
                                    (= (hash-ref e 'display-type 1) 3)
                                    (eq? (hash-ref e 'burrowed #f) #t)
                                    (eq? (hash-ref e 'is-burrowed #f) #t)
                                    (memq (fast-canonical-unit-sym (unit-type-sym e))
                                          '(lurker lurker-mp lurker-burrowed lurker-mp-burrowed
                                            dark-templar banshee ghost widow-mine widow-mine-burrowed)))))
           e)
         raw-ripples))
      ;; L29-P0-3 (`#52/#54` CloakLoss): Prioritize UNDETECTED (`cloak=1` / shimmer / burrowed) threats
      ;; NOT already covered by a Raven or Missile Turret, closest to our base/natural!
      (define (cand-priority-score e)
        (define ex0 (exact->inexact (hash-ref e 'x nat-x)))
        (define ey0 (exact->inexact (hash-ref e 'y nat-y)))
        (define clk (hash-ref e 'cloak 0))
        (define undet?
          (or (eqv? clk 1)
              (eq? clk 'cloaked)
              (= (hash-ref e 'display-type 1) 3)
              (eq? (hash-ref e 'burrowed #f) #t)
              (eq? (hash-ref e 'is-burrowed #f) #t)
              (not (hash-has-key? e 'type))))
        (define det-pen (if (covered-by-det? ex0 ey0) 500.0 0.0))
        (define undet-pen (if undet? 0.0 100.0))
        (+ det-pen undet-pen
           (min (dist2d base-x base-y ex0 ey0)
                (dist2d nat-x nat-y ex0 ey0))))
      (set! scan-candidates-box
            (sort raw-cands < #:key cand-priority-score)))
    scan-candidates-box)
  (define ally-combat-units (l2-ctx-ally-combat-units ctx))
  ;; Loop 62 Phase 2: Delegate Terran OC MULE-vs-Scan energy floors, 32t uncovered cloak hard-block,
  ;; and safe mineral patch selection to pure leaf `lib/plan/macro-ability-policy.rkt` (exact parity
  ;; with `sc2-protobuf-ws.rkt`, zero duplicated scan/MULE policy tables!).
  (define mule-policy-latch (rt-macro-policy-latch rt))
  (define scan-cands-now (get-scan-candidates))
  (define owm-cloak-threat-known?
    (let* ([owm-s (and rt (opponent-world-model-last-summary (rt-opponent-world-model rt)))]
           [kc (and owm-s (opponent-world-summary-known-unit-counts owm-s))]
           [bc (and owm-s (opponent-world-summary-known-bldg-counts owm-s))])
      (and live-game?
           (or (and (hash? kc)
                    (> (+ (hash-ref kc 'dark-templar 0)
                          (hash-ref kc 'banshee 0)
                          (hash-ref kc 'lurker 0)
                          (hash-ref kc 'lurker-burrowed 0)
                          (hash-ref kc 'lurker-mp-burrowed 0)
                          (hash-ref kc 'ghost 0))
                       0))
               (and (hash? bc)
                    (> (+ (hash-ref bc 'dark-shrine 0)
                          (hash-ref bc 'lurker-den 0)
                          (hash-ref bc 'lurker-den-mp 0))
                       0))))))
  (when (and live-game?
             (or (pair? scan-cands-now)
                 owm-cloak-threat-known?
                 (and tech-obs (enemy-tech-observation-requires-detection? tech-obs))))
    (set-macro-policy-latch-seen-enemy-cloak?! mule-policy-latch #t))
  (define (hash->macro-enemy-info e #:force-cloak1? [force-cloak1? #f])
    (define sym (fast-canonical-unit-sym (unit-type-sym e)))
    (define cv (hash-ref e 'cloak 0))
    (define cloak-i
      (cond
        [(or force-cloak1? (eqv? cv 1) (eq? cv 'cloaked)
             (eq? (hash-ref e 'cloaked #f) #t) (= (hash-ref e 'display-type 1) 3))
         1]
        [(or (eqv? cv 2) (eq? cv 'cloaked-detected)) 2]
        [else 0]))
    (macro-enemy-info sym
                      (hash-ref e 'unit-type-id 0)
                      (exact->inexact (hash-ref e 'x nat-x))
                      (exact->inexact (hash-ref e 'y nat-y))
                      (exact->inexact (hash-ref e 'z 0.0))
                      cloak-i
                      (or (eq? (hash-ref e 'burrowed #f) #t)
                          (eq? (hash-ref e 'is-burrowed #f) #t))
                      (or (eq? (hash-ref e 'flying #f) #t)
                          (eq? (hash-ref e 'is-flying #f) #t)
                          (fast-unit-is-flying-sym? sym))))
  (define l2-mule-ready-oc-infos
    (for/list ([cc (in-list ccs)]
               #:when (and (eq? (unit-type-sym cc) 'orbital-command)
                           (l2-building-grounded-and-powered? ctx cc)
                           (>= (hash-ref cc 'build-progress 1.0) SC2-BUILD-COMPLETE-PROGRESS)))
      (macro-oc-info (hash-ref cc 'id 301)
                     (exact->inexact (hash-ref cc 'x base-x))
                     (exact->inexact (hash-ref cc 'y base-y))
                     (exact->inexact (hash-ref cc 'energy SC2-ORBITAL-MULE-ENERGY)))))
  (define l2-mule-th-infos
    (for/list ([cc (in-list ccs)] #:when (hash? cc))
      (define raw-cs (unit-type-sym cc))
      (macro-th-info (hash-ref cc 'id 301)
                     raw-cs
                     (exact->inexact (hash-ref cc 'x base-x))
                     (exact->inexact (hash-ref cc 'y base-y))
                     (>= (hash-ref cc 'build-progress 1.0) SC2-BUILD-COMPLETE-PROGRESS)
                     (or (not (l2-building-grounded-and-powered? ctx cc))
                         (eq? (hash-ref cc 'flying #f) #t)
                         (eq? (hash-ref cc 'is-flying #f) #t)))))
  (define l2-mule-self-infos
    (append
     (for/list ([u (in-list (or (l2-ctx-ally-units ctx) '()))] #:when (hash? u))
       (define sym (fast-canonical-unit-sym (unit-type-sym u)))
       (macro-self-unit-info sym
                             (hash-ref u 'unit-type-id 0)
                             (exact->inexact (hash-ref u 'x base-x))
                             (exact->inexact (hash-ref u 'y base-y))
                             (exact->inexact (hash-ref u 'z 0.0))
                             #f
                             (memq sym '(scv probe drone))
                             #t))
     (for/list ([b (in-list ally-bldgs)] #:when (hash? b))
       (define sym (fast-canonical-structure-sym (unit-type-sym b)))
       (macro-self-unit-info sym
                             (hash-ref b 'unit-type-id 0)
                             (exact->inexact (hash-ref b 'x base-x))
                             (exact->inexact (hash-ref b 'y base-y))
                             (exact->inexact (hash-ref b 'z 0.0))
                             #t
                             #f
                             (>= (hash-ref b 'build-progress 1.0) SC2-BUILD-COMPLETE-PROGRESS)))))
  (define l2-mule-enemy-infos
    (append
     (for/list ([e (in-list enemy-units)] #:when (hash? e))
       (hash->macro-enemy-info e))
     (for/list ([eb (in-list enemy-bldgs)] #:when (hash? eb))
       (hash->macro-enemy-info eb))
     (for/list ([sh (in-list scan-cands-now)]
                #:when (and (hash? sh) (not (hash-has-key? sh 'type))))
       (hash->macro-enemy-info sh #:force-cloak1? #t))))
  (define l2-mule-mineral-infos
    (for/list ([mp (in-list raw-mineral-patches)]
               #:when (and (hash? mp)
                           (> (hash-ref mp 'id 0) 0)
                           (> (hash-ref mp 'mineral-contents 1000) 0)))
      (macro-mineral-info (hash-ref mp 'id 0)
                          (exact->inexact (hash-ref mp 'x base-x))
                          (exact->inexact (hash-ref mp 'y base-y))
                          (hash-ref mp 'mineral-contents 1500)
                          (not (eqv? (hash-ref mp 'display-type 1) 2)))))
  (define l2-terran-oc-under-pressure?
    (and live-game?
         (or under-base-attack?
             urgent-combat-or-intel-need?
             (> live-enemy-threat-supply 0))))
  (define l2-terran-active-bases
    (max 1 (count (lambda (th)
                    (and (macro-th-info? th)
                         (macro-th-info-completed? th)
                         (not (macro-th-info-flying? th))))
                  l2-mule-th-infos)))
  (define l2-mule-policy
    (if (pair? l2-mule-ready-oc-infos)
        (evaluate-terran-mule-policy
         #:latch mule-policy-latch
         #:loop (if live-game? frame 0)
         #:ready-ocs l2-mule-ready-oc-infos
         #:self-units l2-mule-self-infos
         #:enemy-units l2-mule-enemy-infos
         #:townhalls l2-mule-th-infos
         #:worker-count total-workers
         #:known-enemy-race (let ([er (l2-ctx-effective-enemy-race ctx)])
                              (and (memq er '(Zerg Terran Protoss Random)) er))
         #:under-pressure? l2-terran-oc-under-pressure?
         #:cloak-threat-known? (or owm-cloak-threat-known?
                                   (and tech-obs (enemy-tech-observation-requires-detection? tech-obs)))
         #:active-bases l2-terran-active-bases)
        #f))
  (define enemy-cloaked-or-burrowed-active?
    (or (pair? scan-cands-now)
        (and l2-mule-policy (terran-mule-policy-result-hard-blocked? l2-mule-policy))
        (and (= (l2-unit-count ctx 'raven) 0)
             (or (macro-policy-latch-seen-enemy-cloak? mule-policy-latch)
                 (macro-policy-latch-seen-protoss-dt-prism? mule-policy-latch)
                 (macro-policy-latch-seen-terran-cloak-tech? mule-policy-latch)
                 owm-cloak-threat-known?
                 (and tech-obs (enemy-tech-observation-requires-detection? tech-obs))))))
  ;; Loop 64 A5/B3 (`#1755`, Graph 20, `#1788` SC2 `255` EFFECT_SUPPLYDROP):
  ;; Calldown: Extra Supplies on a completed non-upgraded Supply Depot during 4:00-12:00
  ;; combat supply blocks (< 192 cap) while preserving Scan reserves.
  (define l2-supply-drop-depot-infos
    (if (and live-game? (pair? l2-mule-ready-oc-infos))
        (for/list ([b (in-list ally-bldgs)]
                   #:when (and (hash? b)
                               (memq (fast-canonical-structure-sym (unit-type-sym b))
                                     '(supply-depot supply-depot-lowered))))
          (define bsym (fast-canonical-structure-sym (unit-type-sym b)))
          (define tid (hash-ref b 'id 0))
          (define max-hp (exact->inexact (hash-ref b 'max-hp (hash-ref b 'health-max 400.0))))
          (define already-upg?
            (or (> max-hp 450.0)
                (eq? (hash-ref b 'extra-supplies? #f) #t)
                (memq 'supply-drop (hash-ref b 'buffs '()))
                (memq 'calldown-extra-supplies (hash-ref b 'buffs '()))
                (and (exact-integer? tid) (> tid 0)
                     (not (refractory-ready? (live-bot-runtime-cooldown-tracker rt)
                                             (list 'oc-supply-drop-depot tid)
                                             frame
                                             672)))))
          (macro-depot-info tid
                            bsym
                            (exact->inexact (hash-ref b 'x base-x))
                            (exact->inexact (hash-ref b 'y base-y))
                            (>= (hash-ref b 'build-progress 1.0) SC2-BUILD-COMPLETE-PROGRESS)
                            already-upg?))
        '()))
  (define l2-supply-drop-dec
    (if (and live-game? (pair? l2-mule-ready-oc-infos) (pair? l2-supply-drop-depot-infos))
        (evaluate-terran-supply-drop-policy
         #:loop frame
         #:supply-used supply-used
         #:supply-cap (l2-ctx-supply-cap ctx)
         #:ready-ocs l2-mule-ready-oc-infos
         #:depots l2-supply-drop-depot-infos
         #:under-pressure? l2-terran-oc-under-pressure?
         #:cloak-seen? enemy-cloaked-or-burrowed-active?
         #:mule-policy l2-mule-policy)
        #f))
  (define l2-supply-drop-oc-id
    (and l2-supply-drop-dec (terran-supply-drop-decision-oc-tag l2-supply-drop-dec)))
  (define l2-supply-drop-depot-id
    (and l2-supply-drop-dec (terran-supply-drop-decision-depot-tag l2-supply-drop-dec)))
  (define-values (p1-fast-rush-override? p1-reaper-or-ling-swarm-override? _p1-reap _p1-ling)
    (l2-terran-early-fast-rush-status ctx))
  (for ([cc (in-list ccs)])
       (define raw-ctype (unit-type-sym cc))
       (define cid (hash-ref cc 'id 301))
