            (< (l2-ctx-minerals ctx) (sc2-min-cost 'orbital-command))))
  (set-l2-ctx-terran-saving-for-orbital?! ctx terran-saving-for-orbital?)
  (define terran-addon-xs-ys
       (for/fold ([xs '()] [ys '()] #:result (cons xs ys))
                 ([ab (in-list ally-bldgs)]
                  #:when (hash-has-key? TERRAN-ADDON-BLDG-SET (unit-type-sym ab)))
         (values (cons (exact->inexact (hash-ref ab 'x -9999.0)) xs)
                 (cons (exact->inexact (hash-ref ab 'y -9999.0)) ys))))
  (define terran-addon-xs (car terran-addon-xs-ys))
  (set-l2-ctx-terran-addon-xs! ctx terran-addon-xs)
  (define terran-addon-ys (cdr terran-addon-xs-ys))
  (set-l2-ctx-terran-addon-ys! ctx terran-addon-ys)
  (define terran-addon-ox (exact->inexact SC2-TERRAN-ADDON-OFFSET-X))
