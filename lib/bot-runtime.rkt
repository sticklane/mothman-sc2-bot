         (when (and (>= cur-overseer-total 1) (hash? zerg-ov-scout-st))
           (hash-set! zerg-ov-scout-st 'last-overseer2-morph-frame frame))
         (when (and (not zerg-p2-cloak-or-burrow-active?) (hash? zerg-ov-scout-st))
