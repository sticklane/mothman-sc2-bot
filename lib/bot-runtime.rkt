  ;; L27-P0-3 / L31-P0-3 (`z10`/`p11` High-Ground Ramp & Cloak Detection):
  ;; 1) Whenever undetected `cloak=1` enemies exist within `<= 28t` of our live mobile detectors
  ;;    AND we have live combat units, advance mobile detectors directly to `5.5t` standoff of the
  ;;    undetected cloaked cluster (well inside `11.0t` reveal radius!) so Stalkers/army never stall!
  ;; 2) Also run `plan-counter-burrow-response` for burrowed/high-ground ramp lead-detector escort.
  ;; L48-P0-1b (`rd01` Overseer + Queen Mineral-Line Widow Mine Escort):
  ;; Queens are in `WORKER-AND-NONCOMBAT-SYMS`, so include `has-ally-queen-l31?` alongside
  ;; `combat-units` AND include `widow-mine`/`widow-mine-burrowed` so friendly Overseers ALWAYS
  ;; advance within `<= 7.5t` (`6.8t`, strictly outside `5.0t` mine range and inside `11.0t` reveal!)
  ;; to illuminate mineral-line Widow Mines for defending Queens!
  (define has-ally-queen-l31?
    (for/or ([u (in-list ally-units)])
      (and (hash? u) (eq? (unit-type-sym u) 'queen))))
  (define l31-undetected-cloak-enemies
    (if (and (pair? enemy-units)
             (or (pair? (l34-ctx-combat-units ctx)) has-ally-queen-l31?))
        (for/list ([e (in-list enemy-units)]
                   #:when (and (hash? e)
                               (real? (hash-ref e 'x #f))
                               (real? (hash-ref e 'y #f))
                               (let ([cv (hash-ref e 'cloak #f)]
                                     [cs (fast-canonical-unit-sym (unit-type-sym e))])
                                 (or (eqv? cv 1) (eqv? cv 2)
                                     (eq? cv 'cloaked) (eq? cv 'cloaked-detected)
                                     (memq cs '(widow-mine widow-mine-burrowed))))))
          e)
        '()))
  (define l32-cloak-det-ids '())
  (define l38-enemy-aa-pts
    (if (pair? l31-undetected-cloak-enemies)
        (append
         (for/list ([e (in-list enemy-units)]
                    #:when (and (hash? e)
                                (combat-unit-record? e)
                                (real? (hash-ref e 'x #f))
                                (real? (hash-ref e 'y #f))
                                (sc2-unit-can-attack-air? (fast-canonical-unit-sym (unit-type-sym e)))))
           (list (exact->inexact (hash-ref e 'x 9999.0))
                 (exact->inexact (hash-ref e 'y 9999.0))
                 (and (memq (fast-canonical-unit-sym (unit-type-sym e)) '(widow-mine widow-mine-burrowed)) #t)))
         (for/list ([eb (in-list enemy-bldgs)]
                    #:when (and (hash? eb)
                                (real? (hash-ref eb 'x #f))
                                (real? (hash-ref eb 'y #f))
                                (memq (fast-canonical-structure-sym (unit-type-sym eb))
                                      '(missile-turret photon-cannon spore-crawler bunker))))
           (list (exact->inexact (hash-ref eb 'x 9999.0))
                 (exact->inexact (hash-ref eb 'y 9999.0))
                 #f)))
        '()))
  ;; L55-T2 (`#16 RustyNikolaj` + `#75 PvT who`): Track owned spread bases (`>= 2` townhalls
  ;; `> 14t` apart) and live Observers so `>= 2` Observers never stack onto a single cloaked
  ;; cluster when a second base is exposed or under simultaneous attack!
  (define l55-owned-th-coords-det
    (for/list ([b (in-list ally-bldgs)]
               #:when (and (hash? b)
                           (real? (hash-ref b 'x #f))
                           (real? (hash-ref b 'y #f))
                           (memq (fast-canonical-structure-sym (unit-type-sym b))
                                 '(nexus hatchery lair hive command-center orbital-command planetary-fortress))))
      (cons (exact->inexact (hash-ref b 'x base-x))
            (exact->inexact (hash-ref b 'y base-y)))))
  (define l55-spread-multi-base?
    (and (>= (length l55-owned-th-coords-det) 2)
         (for/or ([a (in-list l55-owned-th-coords-det)])
           (for/or ([b (in-list l55-owned-th-coords-det)])
             (fl> (fast-dist2d (car a) (cdr a) (car b) (cdr b)) 14.0)))))
  (when (pair? l31-undetected-cloak-enemies)
    ;; L55-T11 (`#005 PvT who`) + R1 (`#10 puck`): Partition true UNDETECTED (`cloak = 1`) enemies
    ;; from already-revealed (`cloak = 2`) / Widow Mine entries so detectors ALWAYS fly to
    ;; undetected threats first: permanently-cloaked Observers dispatch across `60t` (`3600.0`)
    ;; for `cloak = 1` (`28t` fallback), whereas uncloaked Overseers/Ravens are capped strictly at
    ;; `<= 24t` (`576.0`) so Overseers never fly cross-map into enemy Stalkers! Also compute nearby
    ;; enemy detectors (`<= 14t`) so cloaked Observers hold `5.5t` vs detectionless Marines while
    ;; uncloaked Overseers/Ravens keep `9.5t` standoff (`#16`)!
    (define (l55-cloak1-undetected? ce)
      (let ([cv (hash-ref ce 'cloak #f)])
        (or (eqv? cv 1) (eq? cv 'cloaked))))
    (define l55-true-undet-cloaks (filter l55-cloak1-undetected? l31-undetected-cloak-enemies))
    (define l55-other-cloaks (filter (lambda (ce) (not (l55-cloak1-undetected? ce))) l31-undetected-cloak-enemies))
    (define l55-enemy-det-pts
      (append
       (for/list ([eb (in-list enemy-bldgs)]
                  #:when (and (hash? eb)
                              (real? (hash-ref eb 'x #f))
                              (real? (hash-ref eb 'y #f))
                              (memq (fast-canonical-structure-sym (unit-type-sym eb))
                                    '(missile-turret photon-cannon spore-crawler))))
         (cons (exact->inexact (hash-ref eb 'x 9999.0))
               (exact->inexact (hash-ref eb 'y 9999.0))))
       (for/list ([e (in-list enemy-units)]
                  #:when (and (hash? e)
                              (real? (hash-ref e 'x #f))
                              (real? (hash-ref e 'y #f))
                              (memq (fast-canonical-unit-sym (unit-type-sym e))
                                    '(observer observer-siege-mode overseer overseer-siege-mode raven))))
         (cons (exact->inexact (hash-ref e 'x 9999.0))
               (exact->inexact (hash-ref e 'y 9999.0))))))
    (define det-candidates-raw
      (for/list ([u (in-list ally-units)]
                 #:when (and (hash? u)
                             (memq (unit-type-sym u) '(observer observer-siege-mode overseer overseer-siege-mode raven))
                             (real? (hash-ref u 'x #f))
                             (real? (hash-ref u 'y #f))))
        u))
    (define l55-obs-split-active?
      (and l55-spread-multi-base?
           (>= (count (lambda (u) (memq (unit-type-sym u) '(observer observer-siege-mode)))
                      det-candidates-raw)
               2)))
    (define det-sort-targets
      (if (pair? l55-true-undet-cloaks) l55-true-undet-cloaks l31-undetected-cloak-enemies))
    (define det-candidates
      (if l55-obs-split-active?
          (sort det-candidates-raw <
                #:key (lambda (u)
                        (define ux0 (exact->inexact (hash-ref u 'x base-x)))
                        (define uy0 (exact->inexact (hash-ref u 'y base-y)))
                        (for/fold ([m +inf.0]) ([ce (in-list det-sort-targets)])
                          (flmin m (fast-dist2d ux0 uy0
                                                (exact->inexact (hash-ref ce 'x 9999.0))
                                                (exact->inexact (hash-ref ce 'y 9999.0)))))))
          det-candidates-raw))
    (define-values (det-cloak-cmds claimed-det-ids _obs-pts)
      (for/fold ([acc '()] [cids '()] [obs-pts '()])
                ([u (in-list det-candidates)])
        (define did (hash-ref u 'id -1))
        (define dx0 (exact->inexact (hash-ref u 'x base-x)))
        (define dy0 (exact->inexact (hash-ref u 'y base-y)))
        (define is-obs-u? (and (memq (unit-type-sym u) '(observer observer-siege-mode)) #t))
        (define (scan-cloak-pool pool max-d2)
          (for/fold ([bx 0.0] [by 0.0] [bd2 max-d2] [twm? #f] [found? #f])
                    ([ce (in-list pool)])
            (define ex0 (exact->inexact (hash-ref ce 'x 9999.0)))
            (define ey0 (exact->inexact (hash-ref ce 'y 9999.0)))
            (define covered-by-other-obs?
              (and l55-obs-split-active?
                   is-obs-u?
                   (pair? obs-pts)
                   (for/or ([pt (in-list obs-pts)])
                     (fl<= (fast-dist2d ex0 ey0 (car pt) (cdr pt)) 12.0))))
            (if covered-by-other-obs?
                (values bx by bd2 twm? found?)
                (let* ([ddx (fl- ex0 dx0)]
                       [ddy (fl- ey0 dy0)]
                       [d2 (fl+ (fl* ddx ddx) (fl* ddy ddy))]
                       [is-wm? (and (memq (fast-canonical-unit-sym (unit-type-sym ce)) '(widow-mine widow-mine-burrowed)) #t)])
                  (if (fl< d2 bd2) (values ex0 ey0 d2 is-wm? #t) (values bx by bd2 twm? found?))))))
        (define-values (cx cy bd2 target-is-wm? found-cloak?)
          (let ([undet-max-d2 (if is-obs-u? 3600.0 576.0)]
                [other-max-d2 (if is-obs-u? 784.0 576.0)])
            (let-values ([(ux1 uy1 ud2 uwm? ufound?) (scan-cloak-pool l55-true-undet-cloaks undet-max-d2)])
              (if ufound?
                  (values ux1 uy1 ud2 uwm? #t)
                  (scan-cloak-pool l55-other-cloaks other-max-d2)))))
        (if (and (exact-integer? did) (> did 0) found-cloak?)
            (let* ([non-wm-aa-near?
                    (and (pair? l38-enemy-aa-pts)
                         (for/or ([ap (in-list l38-enemy-aa-pts)])
                           (and (not (third ap))
                                (let ([adx (fl- cx (first ap))]
                                      [ady (fl- cy (second ap))])
                                  (fl<= (fl+ (fl* adx adx) (fl* ady ady)) 110.25)))))]
                   [aa-near-cloak?
                    (and (pair? l38-enemy-aa-pts)
                         (for/or ([ap (in-list l38-enemy-aa-pts)])
                           (define adx (fl- cx (first ap)))
                           (define ady (fl- cy (second ap)))
                           (fl<= (fl+ (fl* adx adx) (fl* ady ady)) 110.25)))]
                   [obs-enemy-det-near?
                    (and is-obs-u?
                         (pair? l55-enemy-det-pts)
                         (for/or ([dp (in-list l55-enemy-det-pts)])
                           (define ddx (fl- cx (car dp)))
                           (define ddy (fl- cy (cdr dp)))
                           (define ddx0 (fl- dx0 (car dp)))
                           (define ddy0 (fl- dy0 (cdr dp)))
                           (or (fl<= (fl+ (fl* ddx ddx) (fl* ddy ddy)) 196.0)
                               (fl<= (fl+ (fl* ddx0 ddx0) (fl* ddy0 ddy0)) 196.0))))]
                   [det-needs-aa-standoff? (or (not is-obs-u?) obs-enemy-det-near?)]
                   [eff-non-wm-aa-near? (and det-needs-aa-standoff? non-wm-aa-near?)]
                   [eff-aa-near-cloak? (and det-needs-aa-standoff? aa-near-cloak?)]
                   ;; L38-P0-1b (`p13`) + L48-P0-1b (`rd01`) + L55-T2 (`#16`) + L55-T11 (`#005`):
                   ;; Uncloaked Overseer/Raven (or detected Observer within 14t of enemy detector)
                   ;; holds `9.5t` (`standoff-r2=96.04`, `lim2=67.24`) vs non-WM AA; permanently-
                   ;; cloaked Observer without enemy detectors holds `5.5t` (or `6.8t` vs Mines).
                   [wm-only-drop? (and target-is-wm? (not eff-non-wm-aa-near?))]
                   [standoff-r (cond [eff-non-wm-aa-near? 9.5] [wm-only-drop? 6.8] [eff-aa-near-cloak? 9.5] [else 5.5])]
                   [standoff-r2 (cond [eff-non-wm-aa-near? 96.04] [wm-only-drop? 56.25] [eff-aa-near-cloak? 96.04] [else 36.0])]
                   [closest-violating-aa
                    (and eff-aa-near-cloak?
                         (let ([lim2 (if wm-only-drop? 33.64 67.24)])
                           (for/fold ([best #f] [best-d2 +inf.0] #:result best)
                                     ([ap (in-list l38-enemy-aa-pts)])
                             (define adx (fl- dx0 (first ap)))
                             (define ady (fl- dy0 (second ap)))
                             (define ad2 (fl+ (fl* adx adx) (fl* ady ady)))
                             (if (and (fl<= ad2 lim2) (fl< ad2 best-d2))
                                 (values ap ad2)
                                 (values best best-d2)))))]
                   [too-close-aa? (and closest-violating-aa #t)]
                   [next-obs-pts (if is-obs-u? (cons (cons cx cy) obs-pts) obs-pts)]
                   ;; L43-P0-1d (`r01` Observer `+1.5t` behind Stalkers): When ALL cloaked threats
                   ;; are already revealed (`0` undetected `cloak=1`) and friendly AA defenders
                   ;; (`stalker`/`phoenix`/`archon`/`void-ray`) sit within `<= 9.0t` of `(cx, cy)`,
                   ;; shelter an Observer that wandered ahead of our Stalkers back to `+1.5t` behind
                   ;; the Stalker centroid (still strictly inside `11.0t` detection radius!).
                   [r01-behind-aa-pt
                    (and (not eff-aa-near-cloak?)
                         is-obs-u?
                         (not (for/or ([ce (in-list l31-undetected-cloak-enemies)])
                                (let ([cv (hash-ref ce 'cloak #f)])
                                  (or (eqv? cv 1) (eq? cv 'cloaked)))))
                         (let ([aa-def
                                (filter (lambda (au)
                                          (and (hash? au)
                                               (real? (hash-ref au 'x #f))
                                               (real? (hash-ref au 'y #f))
                                               (memq (fast-canonical-unit-sym (unit-type-sym au))
                                                     '(stalker phoenix archon void-ray))))
                                        (l34-ctx-combat-units ctx))])
                           (and (pair? aa-def)
                                (let* ([n (exact->inexact (length aa-def))]
                                       [acx (/ (for/sum ([au (in-list aa-def)]) (exact->inexact (hash-ref au 'x base-x))) n)]
                                       [acy (/ (for/sum ([au (in-list aa-def)]) (exact->inexact (hash-ref au 'y base-y))) n)]
                                       [d-aa-e (fast-dist2d acx acy cx cy)]
                                       [d-obs-e (flsqrt bd2)])
                                  (and (fl<= d-aa-e 9.0)
                                       (fl< d-obs-e (fl- d-aa-e 0.5))
                                       (let* ([vx (fl- acx cx)]
                                              [vy (fl- acy cy)]
                                              [vd (flmax 0.1 d-aa-e)])
                                         (cons (safe-coord (fl+ acx (fl* 1.5 (fl/ vx vd))) acx)
                                               (safe-coord (fl+ acy (fl* 1.5 (fl/ vy vd))) acy))))))))])
              (cond
                [too-close-aa?
                 (define rx (first closest-violating-aa))
                 (define ry (second closest-violating-aa))
                 (define rdx (fl- dx0 rx))
                 (define rdy (fl- dy0 ry))
                 (define rd (flmax 0.5 (flsqrt (fl+ (fl* rdx rdx) (fl* rdy rdy)))))
                 (define back-step (flmin 2.5 (flmax 0.8 (fl- (if wm-only-drop? 7.5 10.0) rd))))
                 (define tx (safe-coord (fl+ dx0 (fl* back-step (fl/ rdx rd))) dx0))
                 (define ty (safe-coord (fl+ dy0 (fl* back-step (fl/ rdy rd))) dy0))
                 (values (cons (list 'move did tx ty) acc) (cons did cids) next-obs-pts)]
                [r01-behind-aa-pt
                 (values (cons (list 'move did (car r01-behind-aa-pt) (cdr r01-behind-aa-pt)) acc)
                         (cons did cids)
                         next-obs-pts)]
                [(fl> bd2 standoff-r2)
                 (let* ([d (flsqrt bd2)]
                        [step (flmax 1.0 (fl- d standoff-r))]
                        [tx (safe-coord (fl+ dx0 (fl* step (fl/ (fl- cx dx0) d))) dx0)]
                        [ty (safe-coord (fl+ dy0 (fl* step (fl/ (fl- cy dy0) d))) dy0)])
                   (values (cons (list 'move did tx ty) acc) (cons did cids) next-obs-pts))]
                [else
                 (values acc (cons did cids) next-obs-pts)]))
            (values acc cids obs-pts))))
    (set! l32-cloak-det-ids claimed-det-ids)
    (when (pair? det-cloak-cmds)
      (emit-direct-batch! det-cloak-cmds))
    ;; L32-P0-3 (`p11` Observer overwrite fix): Also claim stationary illuminating detectors (`<= 6t`)
    ;; in `direct-claimed-ht` so neither `plan-counter-burrow-response` nor later direct tactics
    ;; yank them back over the Stalker centroid!
    (when (pair? claimed-det-ids)
      (set! unclaimed-allies-cache #f)
      (for ([did (in-list claimed-det-ids)])
        (hash-set! direct-claimed-ht did #t))))
  ;; L38-P0-1c + L41-P0-1c (`#5138254` & `#75 PvP who` Sole `CloakLoss 1->0/84`):
  ;; Immediately pull/leash Observer #1 (closest to the threatened Nexus/home threat, from ANY map
  ;; distance — NO 28t cap!) directly over any threatened Nexus/mineral line whenever enemy DTs,
  ;; Banshees, Warp Prisms, burrowed/cloaked threats, shimmer ripples, or Dark Shrine threaten home
  ;; (and keep 1 of >= 2 Observers over home in PvP past 3:07!), instead of chasing mid-map army!
  (let* ([ally-obs-list
          (for/list ([u (in-list ally-units)]
                     #:when (and (hash? u)
                                 (memq (unit-type-sym u) '(observer observer-siege-mode))
                                 (real? (hash-ref u 'x #f))
                                 (real? (hash-ref u 'y #f))))
            u)]
         [rt-mm (live-bot-runtime-mirror-mind rt)]
         [rt-tech-obs (and rt-mm (mirror-mind-state-last-tech-observation rt-mm))]
         [obs-enemy-race (hash-ref obs 'enemy-race 'Unknown)]
         [owned-th-coords-obs
          (for/list ([b (in-list ally-bldgs)]
                     #:when (and (hash? b)
                                 (real? (hash-ref b 'x #f))
                                 (real? (hash-ref b 'y #f))
                                 (memq (fast-canonical-structure-sym (unit-type-sym b))
                                       '(nexus hatchery lair hive command-center orbital-command planetary-fortress))))
            (cons (exact->inexact (hash-ref b 'x base-x))
                  (exact->inexact (hash-ref b 'y base-y))))]
         [eff-th-coords-obs
          (if (pair? owned-th-coords-obs)
              owned-th-coords-obs
              (list (cons (exact->inexact base-x) (exact->inexact base-y))))]
         [home-cloak-or-drop-enemies
          (if (null? ally-obs-list)
              '()
              (for/list ([e (in-list enemy-units)]
                         #:when (and (hash? e)
                                     (real? (hash-ref e 'x #f))
                                     (real? (hash-ref e 'y #f))
                                     (let ([esym (fast-canonical-unit-sym (unit-type-sym e))]
                                           [cv (hash-ref e 'cloak #f)])
                                       (or (memq esym '(banshee dark-templar ghost lurker-burrowed lurker-mp-burrowed
                                                        warp-prism warp-prism-phasing))
                                           (eq? (hash-ref e 'cloaked #f) #t)
                                           (eqv? cv 1) (eqv? cv 2)
                                           (eq? cv 'cloaked) (eq? cv 'cloaked-detected)
                                           (= (hash-ref e 'display-type 1) 3)))
                                     (let ([ex (exact->inexact (hash-ref e 'x 9999.0))]
                                           [ey (exact->inexact (hash-ref e 'y 9999.0))])
                                       (for/or ([th (in-list eff-th-coords-obs)])
                                         (<= (fast-dist2d ex ey (car th) (cdr th)) 24.0)))))
                e))]
         [obs-shimmer-ripples
          ;; L59 Tier-1B (`#1499` L39285): Read live `'shimmer-and-burrow-ripples` (with legacy fallback).
          (let ([sr (hash-ref obs 'shimmer-and-burrow-ripples (hash-ref obs 'shimmer-ripples '()))])
            (if (list? sr)
                (filter (lambda (r) (and (hash? r) (real? (hash-ref r 'x #f)) (real? (hash-ref r 'y #f)))) sr)
                '()))]
         [enemy-warp-prism-any?
          (for/or ([e (in-list enemy-units)])
            (and (hash? e)
                 (memq (fast-canonical-unit-sym (unit-type-sym e))
                       '(warp-prism warp-prism-phasing))))]
         [proactive-pvp-home-obs?
          (and (>= (length ally-obs-list) 2)
               (pair? owned-th-coords-obs)
               (eq? obs-enemy-race 'Protoss)
               (>= frame 4200))]
         [confirmed-cloak-threat?
          (and (pair? ally-obs-list)
               (or (pair? home-cloak-or-drop-enemies)
                   (pair? obs-shimmer-ripples)
                   enemy-warp-prism-any?
                   proactive-pvp-home-obs?
                   (and rt-tech-obs (enemy-tech-observation-requires-detection? rt-tech-obs))
                   (pair? l31-undetected-cloak-enemies)
                   (for/or ([e (in-list enemy-units)])
                     (and (hash? e)
                          (memq (fast-canonical-unit-sym (unit-type-sym e))
                                '(banshee dark-templar ghost lurker-burrowed lurker-mp-burrowed))))
                   (for/or ([eb (in-list enemy-bldgs)])
                     (and (hash? eb)
                          (memq (fast-canonical-structure-sym (unit-type-sym eb))
                                '(dark-shrine lurker-den lurker-den-mp))))))])
    (when confirmed-cloak-threat?
      ;; Determine the highest-priority home anchor BEFORE picking Observer #1 so we pull the
      ;; closest Observer straight onto the actual threatened Nexus / home DT / home Warp Prism!
      (define def-aa-units
        (for/list ([u (in-list (l34-ctx-combat-units ctx))]
                   #:when (and (hash? u)
                               (real? (hash-ref u 'x #f))
                               (real? (hash-ref u 'y #f))
                               (memq (fast-canonical-unit-sym (unit-type-sym u))
                                     '(stalker phoenix archon high-templar void-ray sentry))))
          u))
      (define home-def-aa-units
        (filter (lambda (u)
                  (define ux (exact->inexact (hash-ref u 'x base-x)))
                  (define uy (exact->inexact (hash-ref u 'y base-y)))
                  (for/or ([th (in-list eff-th-coords-obs)])
                    (<= (fast-dist2d ux uy (car th) (cdr th)) 26.0)))
                def-aa-units))
      (define primary-home-threat
        (and (pair? home-cloak-or-drop-enemies)
             (argmin (lambda (e)
                       (define ex (exact->inexact (hash-ref e 'x base-x)))
                       (define ey (exact->inexact (hash-ref e 'y base-y)))
                       (define esym (fast-canonical-unit-sym (unit-type-sym e)))
                       (define prio-bias (if (memq esym '(dark-templar banshee)) -8.0 0.0))
                       (+ prio-bias
                          (for/fold ([m +inf.0]) ([th (in-list eff-th-coords-obs)])
                            (min m (fast-dist2d ex ey (car th) (cdr th))))))
                     home-cloak-or-drop-enemies)))
      (define-values (ax ay leash-dist)
        (cond
          [primary-home-threat
           (define ptx (exact->inexact (hash-ref primary-home-threat 'x base-x)))
           (define pty (exact->inexact (hash-ref primary-home-threat 'y base-y)))
           ;; L43-P0-1d (`r01` Observer `+1.5t` behind Stalkers): When friendly AA defenders
           ;; (`home-def-aa-units`, e.g. Stalkers vs cloaked Banshees!) are already within `<= 9.5t`
           ;; of `primary-home-threat` (with 0 undetected `cloak=1` threats beyond `9.5t`), anchor
           ;; Observer `+1.5t` behind our Stalker centroid (away from threat, well inside `11.0t`
           ;; detection radius!) instead of flying out ahead of our Stalkers!
           (define aa-cx
             (and (pair? home-def-aa-units)
                  (/ (for/sum ([u (in-list home-def-aa-units)]) (exact->inexact (hash-ref u 'x base-x)))
                     (exact->inexact (length home-def-aa-units)))))
           (define aa-cy
             (and (pair? home-def-aa-units)
                  (/ (for/sum ([u (in-list home-def-aa-units)]) (exact->inexact (hash-ref u 'y base-y)))
                     (exact->inexact (length home-def-aa-units)))))
           (define all-cloak-within-aa?
             (and aa-cx aa-cy
                  (<= (fast-dist2d aa-cx aa-cy ptx pty) 9.5)
                  (for/and ([ce (in-list l31-undetected-cloak-enemies)])
                    (<= (fast-dist2d aa-cx aa-cy
                                     (exact->inexact (hash-ref ce 'x ptx))
                                     (exact->inexact (hash-ref ce 'y pty)))
                        9.5))))
           (if all-cloak-within-aa?
               (let* ([dx (- aa-cx ptx)]
                      [dy (- aa-cy pty)]
                      [d (max 0.1 (sqrt (+ (* dx dx) (* dy dy))))])
                 (values (safe-coord (+ aa-cx (* 1.5 (/ dx d))) aa-cx)
                         (safe-coord (+ aa-cy (* 1.5 (/ dy d))) aa-cy)
                         2.5))
               (values ptx pty 4.0))]
          [(pair? obs-shimmer-ripples)
           (define sr0
             (argmin (lambda (r)
                       (for/fold ([m +inf.0]) ([th (in-list eff-th-coords-obs)])
                         (min m (fast-dist2d (exact->inexact (hash-ref r 'x base-x))
                                             (exact->inexact (hash-ref r 'y base-y))
                                             (car th) (cdr th)))))
                     obs-shimmer-ripples))
           (values (exact->inexact (hash-ref sr0 'x base-x))
                   (exact->inexact (hash-ref sr0 'y base-y))
                   4.0)]
          [(pair? home-def-aa-units)
           (define n (exact->inexact (length home-def-aa-units)))
           (values (/ (for/sum ([u (in-list home-def-aa-units)]) (exact->inexact (hash-ref u 'x base-x))) n)
                   (/ (for/sum ([u (in-list home-def-aa-units)]) (exact->inexact (hash-ref u 'y base-y))) n)
                   5.5)]
          [(and (<= (length ally-obs-list) 1)
                (not enemy-warp-prism-any?)
                (or (pair? l31-undetected-cloak-enemies)
                    (for/or ([e (in-list enemy-units)])
                      (and (hash? e)
                           (memq (fast-canonical-unit-sym (unit-type-sym e))
                                 '(banshee dark-templar ghost lurker-burrowed lurker-mp-burrowed))))))
           ;; Sole Observer with 0 home threats / 0 home defenders and an active mid-map stealth
           ;; enemy (`novel-100`): do NOT yank back to an empty safe Nexus — let counter-burrow fly
           ;; straight onto the mid-map stealth unit!
           (values #f #f 0.0)]
          [(pair? owned-th-coords-obs)
           ;; When live Nexuses exist (and >=2 Observers, Warp Prism threat, or proactive home guard),
           ;; anchor Observer #1 over our exposed frontmost/natural Nexus!
           (define front-th
             (argmax (lambda (th) (fast-dist2d (car th) (cdr th) (exact->inexact base-x) (exact->inexact base-y)))
                     owned-th-coords-obs))
           (values (car front-th) (cdr front-th) 5.5)]
          [(pair? def-aa-units)
           (define n (exact->inexact (length def-aa-units)))
           (values (/ (for/sum ([u (in-list def-aa-units)]) (exact->inexact (hash-ref u 'x base-x))) n)
                   (/ (for/sum ([u (in-list def-aa-units)]) (exact->inexact (hash-ref u 'y base-y))) n)
                   5.5)]
          [else
           (values (exact->inexact base-x) (exact->inexact base-y) 5.5)]))
      (when (and ax ay)
        (define home-obs
          (argmin (lambda (o)
                    (fast-dist2d (exact->inexact (hash-ref o 'x base-x))
                                 (exact->inexact (hash-ref o 'y base-y))
                                 ax ay))
                  ally-obs-list))
        (define hoid (hash-ref home-obs 'id -1))
        (when (and (exact-integer? hoid)
                   (> hoid 0)
                   (not (memv hoid l32-cloak-det-ids)))
          (define ox (exact->inexact (hash-ref home-obs 'x base-x)))
          (define oy (exact->inexact (hash-ref home-obs 'y base-y)))
          (when (> (fast-dist2d ox oy ax ay) leash-dist)
            (emit-direct-batch! (list (list 'move hoid (safe-coord ax ox) (safe-coord ay oy)))))
          (set! l32-cloak-det-ids (cons hoid l32-cloak-det-ids))
          (set! unclaimed-allies-cache #f)
          (hash-set! direct-claimed-ht hoid #t))
        ;; L55-T2 (`#75 PvT who` Multi-Base Observer Split): When `>= 2` live Observers and
        ;; `>= 2` owned bases exist under `confirmed-cloak-threat?`, anchor Observer #2 over the
        ;; second threatened/unattended Nexus (`> 14t` from `(ax, ay)`) so Main & Natural stay
        ;; detected simultaneously instead of both Observers drifting to a single base!
        (when (and (>= (length ally-obs-list) 2)
                   (>= (length owned-th-coords-obs) 2))
          (define free-obs-2
            (filter (lambda (o)
                      (define oid (hash-ref o 'id -1))
                      (and (exact-integer? oid)
                           (> oid 0)
                           (not (eqv? oid hoid))
                           (not (memv oid l32-cloak-det-ids))))
                    ally-obs-list))
          (when (pair? free-obs-2)
            (define sec-threats
              (filter (lambda (e)
                        (> (fast-dist2d (exact->inexact (hash-ref e 'x ax))
                                        (exact->inexact (hash-ref e 'y ay))
                                        ax ay)
                           14.0))
                      home-cloak-or-drop-enemies))
            (define sec-shimmers
              (filter (lambda (r)
                        (> (fast-dist2d (exact->inexact (hash-ref r 'x ax))
                                        (exact->inexact (hash-ref r 'y ay))
                                        ax ay)
                           14.0))
                      obs-shimmer-ripples))
            (define sec-bases
              (filter (lambda (th)
                        (> (fast-dist2d (car th) (cdr th) ax ay) 14.0))
                      owned-th-coords-obs))
            (define-values (ax2 ay2 leash2)
              (cond
                [(pair? sec-threats)
                 (define st0
                   (argmin (lambda (e)
                             (define ex (exact->inexact (hash-ref e 'x ax)))
                             (define ey (exact->inexact (hash-ref e 'y ay)))
                             (for/fold ([m +inf.0]) ([th (in-list owned-th-coords-obs)])
                               (min m (fast-dist2d ex ey (car th) (cdr th)))))
                           sec-threats))
                 (values (exact->inexact (hash-ref st0 'x ax))
                         (exact->inexact (hash-ref st0 'y ay))
                         4.0)]
                [(pair? sec-shimmers)
                 (define sr2 (car sec-shimmers))
                 (values (exact->inexact (hash-ref sr2 'x ax))
                         (exact->inexact (hash-ref sr2 'y ay))
                         4.0)]
                [(pair? sec-bases)
                 (define b2
                   (argmax (lambda (th) (fast-dist2d (car th) (cdr th) ax ay))
                           sec-bases))
                 (values (car b2) (cdr b2) 5.5)]
                [else (values #f #f 0.0)]))
            (when (and ax2 ay2)
              (define home-obs-2
                (argmin (lambda (o)
                          (fast-dist2d (exact->inexact (hash-ref o 'x base-x))
                                       (exact->inexact (hash-ref o 'y base-y))
                                       ax2 ay2))
                        free-obs-2))
              (define hoid2 (hash-ref home-obs-2 'id -1))
              (when (and (exact-integer? hoid2) (> hoid2 0))
                (define o2x (exact->inexact (hash-ref home-obs-2 'x base-x)))
                (define o2y (exact->inexact (hash-ref home-obs-2 'y base-y)))
                (when (> (fast-dist2d o2x o2y ax2 ay2) leash2)
                  (emit-direct-batch! (list (list 'move hoid2 (safe-coord ax2 o2x) (safe-coord ay2 o2y)))))
                (set! l32-cloak-det-ids (cons hoid2 l32-cloak-det-ids))
                (set! unclaimed-allies-cache #f)
                (hash-set! direct-claimed-ht hoid2 #t))))))))
  (when (or has-enemy-burrow-or-sh-counter?
            (and (pair? enemy-units)
                 (ormap (lambda (u)
                          (and (hash? u)
                               (memq (unit-type-sym u) '(observer overseer raven))
                               (not (memv (hash-ref u 'id -1) l32-cloak-det-ids))))
                        ally-units))
            (let ([rb (hash-ref obs 'remembered-burrows '())])
              (and (list? rb) (pair? rb))))
    ;; `plan-counter-burrow-response` never reads non-detector workers/eggs/larva or non-detector non-OC buildings.
    ;; L32-P0-3 (`p11`): Strictly exclude mobile detectors claimed by `det-cloak-cmds` so
    ;; `plan-counter-burrow-response` never snaps them back over Stalkers away from cloaked Banshees!
    (define cb-ally-units
      (for/list ([u (in-list ally-units)]
                 #:when (and (hash? u)
                             (not (memq (unit-type-sym u) '(scv probe drone overlord larva egg mule)))
                             (not (memv (hash-ref u 'id -1) l32-cloak-det-ids))))
        u))
    (define cb-ally-bldgs
      (for/list ([b (in-list ally-bldgs)]
                 #:when (and (hash? b)
                             (memq (unit-type-sym b) '(missile-turret spore-crawler photon-cannon orbital-command))))
        b))
    (define cb-obs
      (hash-set* obs 'ally-units cb-ally-units 'ally-buildings cb-ally-bldgs))
    (emit-direct-batch!
     (CounterBurrowPlan-commands (plan-counter-burrow-response cb-obs #:tracker (rt-burrow-tracker rt)))))
  ;; L59 Tier-1B (`#1499` L39537): Fall back to live `'expansion-candidates` when `'expansion-pads`
  ;; is absent so `plan-burrowed-zergling-expansion-blocks` executes in live Zerg games!
  (define p7-exp-pads
    (let ([ep (hash-ref obs 'expansion-pads '())]
          [ec (hash-ref obs 'expansion-candidates '())])
      (cond
        [(and (list? ep) (pair? ep)) ep]
        [(and (list? ec) (pair? ec)) ec]
        [else '()])))
  (when (and has-ally-zergling?
             (or (pair? p7-exp-pads)
                 (let ([v (hash-ref obs 'pending-expansion-targets '())]) (and (list? v) (pair? v)))
                 (hash-ref obs 'pending-expansion-target #f)))
    (define eb-obs
      (if (and (pair? p7-exp-pads)
               (let ([ep (hash-ref obs 'expansion-pads '())]) (not (and (list? ep) (pair? ep)))))
          (hash-set obs 'expansion-pads p7-exp-pads)
          obs))
    (emit-direct-batch!
     (plan-burrowed-zergling-expansion-blocks eb-obs #:tracker (rt-burrow-tracker rt))))

  (define direct-enemy-combat-coords
    (append
     (for/list ([e (in-list enemy-units)]
                #:when (and (hash? e)
                            (combat-unit-record? e)
                            (let ([ex0 (hash-ref e 'x RUNTIME-MISSING)]
                                  [ey0 (hash-ref e 'y RUNTIME-MISSING)])
                              (and (real? ex0) (real? ey0)))))
       (cons (exact->inexact (hash-ref e 'x 0.0))
             (exact->inexact (hash-ref e 'y 0.0))))
     (for/list ([eb (in-list enemy-bldgs)]
                #:when (and (hash? eb)
                            (memq (unit-type-sym eb)
                                  '(planetary-fortress bunker photon-cannon spine-crawler))
                            (let ([ex0 (hash-ref eb 'x RUNTIME-MISSING)]
                                  [ey0 (hash-ref eb 'y RUNTIME-MISSING)])
                              (and (real? ex0) (real? ey0)))))
       (cons (exact->inexact (hash-ref eb 'x 0.0))
             (exact->inexact (hash-ref eb 'y 0.0))))))
  (define (frontline-combat-engaged? u)
    (and (pair? direct-enemy-combat-coords)
         (let ([ux0 (hash-ref u 'x RUNTIME-MISSING)]
               [uy0 (hash-ref u 'y RUNTIME-MISSING)])
           (and (real? ux0) (real? uy0)
                (let ([fux (exact->inexact ux0)]
                      [fuy (exact->inexact uy0)])
                  (for/or ([ec (in-list direct-enemy-combat-coords)])
                    (define dx (fl- fux (car ec)))
                    (define dy (fl- fuy (cdr ec)))
                    (fl<= (fl+ (fl* dx dx) (fl* dy dy)) 144.0)))))))

  ;; Direct Tactic #2: `multitask-harass-and-proxy.rkt`
  ;; L59 Tier-1B (`#1499` L39496/39589): Release dedicated runby/drop squad tags reserved before
  ;; Phase 5b/6 so `multitask-harass-and-proxy` receives them unclaimed!
  (define p7-reserved-harass-set
    (let ([s (and (hash? l34-sc) (hash-ref l34-sc 'l59-p7-reserved-harass-tags #f))])
      (if (set? s) s (seteqv))))
  (when (not (set-empty? p7-reserved-harass-set))
    (for ([rid (in-set p7-reserved-harass-set)])
      (hash-remove! direct-claimed-ht rid))
    (set! unclaimed-allies-cache #f))
  (define p7-endgame-hunt-active?
    (and (l34-ctx-live-obs? ctx)
         (eq? (hash-ref l34-sc 'endgame-hunt-active? #f) #t)))
  (when (and (not p7-endgame-hunt-active?)
             has-any-enemy?
             (or (not (set-empty? p7-reserved-harass-set))
                 has-ally-harass-sym?
                 has-enemy-harass-sym?
                 (and (<= frame 4500) enemy-near-home?)))
    (define free-allies (unclaimed-ally-units-now))
    (when (pair? free-allies)
      ;; W8-TAC-5(b): Only pull workers into `step-multitask-harass-and-proxy` when enemy is
      ;; near home (not unconditionally during 1792..3024f for proxy-search!), and strip any
      ;; cross-map (> 40t) worker/home-defender `move` from `plan-counter-proxy-all-in` when
      ;; under home attack, enemy main is unscouted, or enemy main production was already seen.
      (define keep-all-workers? enemy-near-home?)
      (define ebbox-ready? #f)
      (define eminx +inf.0)
      (define emaxx -inf.0)
      (define eminy +inf.0)
      (define emaxy -inf.0)
      (define (worker-near-any-enemy? w)
        (unless ebbox-ready?
          (set! ebbox-ready? #t)
          (for ([e (in-list enemy-units)] #:when (hash? e))
            (define ex (hash-ref e 'x RUNTIME-MISSING))
            (define ey (hash-ref e 'y RUNTIME-MISSING))
            (when (and (real? ex) (real? ey))
              (define fx (exact->inexact ex))
              (define fy (exact->inexact ey))
              (when (< fx eminx) (set! eminx fx))
              (when (> fx emaxx) (set! emaxx fx))
              (when (< fy eminy) (set! eminy fy))
              (when (> fy emaxy) (set! emaxy fy)))))
        (or (> eminx emaxx)
            (let ([wx (hash-ref w 'x RUNTIME-MISSING)]
                  [wy (hash-ref w 'y RUNTIME-MISSING)])
              (or (not (real? wx))
                  (not (real? wy))
                  (and (>= wx (- eminx 24.0)) (<= wx (+ emaxx 24.0))
                       (>= wy (- eminy 24.0)) (<= wy (+ emaxy 24.0)))))))
      (define has-active-harass-actor? #f)
      (define p7-fog-suppress? (l34-ctx-fog-belief-suppress? ctx))
      (define p7-combat-units (or (l34-ctx-combat-units ctx) '()))
      (define p7-has-bio?
        (ormap (lambda (cu)
                 (and (hash? cu)
                      (memq (unit-type-sym cu) '(marine marauder ghost reaper hellbat))))
               p7-combat-units))
      (define p7-has-widow-mine?
        (ormap (lambda (cu)
                 (and (hash? cu)
                      (eq? (unit-type-sym cu) 'widow-mine)))
               p7-combat-units))
      ;; L58-P3 (`sc2-ab-t01`): Keep `plan-viking-modes` (`unit-mode-micro.rkt`) as the SINGLE live
      ;; owner of combat Viking landing/liftoff (`403`/`405`) — never hand Vikings to
      ;; `step-multitask-harass-and-proxy` when enemy air/Colossus exist OR no enemy mineral line
      ;; (`< 4` enemy workers) exists (fixes `13x 403 / 13x 405` oscillation before Colossus dies!).
      (define p7-enemy-air-or-colossus?
        (for/or ([e (in-list enemy-units)])
          (and (hash? e)
               (not (hash-ref e 'snapshot? #f))
               (let ([es (fast-canonical-unit-sym (unit-type-sym e))])
                 (or (eq? es 'colossus)
                     (and (fast-unit-is-flying-sym? es)
                          (not (memq es '(overlord observer observer-siege-mode)))))))))
      (define p7-enemy-worker-cnt
        (count (lambda (e)
                 (and (hash? e)
                      (not (hash-ref e 'snapshot? #f))
                      (memq (fast-canonical-unit-sym (unit-type-sym e))
                            '(scv probe drone mule))))
               enemy-units))
      (define p7-block-harass-vikings?
        (or p7-enemy-air-or-colossus? (< p7-enemy-worker-cnt 4)))
      ;; Loop 65F (`#1920`/`#1922`): Keep home-defending Widow Mines home during early Reaper /
      ;; base attacks instead of walking across the map in Phase 7 harass!
      (define p7-hold-home-widow-mine?
        (or enemy-near-home?
            (l34-ctx-under-tactics-base-attack? ctx)
            (l34-ctx-enemy-within-14-of-th? ctx)))
      (define filtered-allies
        (for/list ([u (in-list free-allies)]
                   #:when (let ([ut (unit-type-sym u)])
                            (cond
                              [(hash-ref RUNTIME-NON-COMBAT-HARASS-SKIP-SET ut #f)
                               (and (hash-ref RUNTIME-WORKER-SET ut #f)
                                    (or keep-all-workers? (worker-near-any-enemy? u)))]
                              [(and p7-block-harass-vikings?
                                    (memq ut '(viking viking-fighter viking-assault)))
                               #f]
                              [(and p7-hold-home-widow-mine?
                                    (memq ut '(widow-mine widow-mine-burrowed)))
                               #f]
                              ;; W3-TAC-7 + W15c + L50-W1 (`#50` Medivac Over-Fly Guard) + L59 Tier-1B (`#1499` L39576):
                              ;; Unblock empty Medivacs from `plan-widow-mine-drop-and-runby` whenever Widow Mines
                              ;; actually exist (even when Bio also exists!), while still blocking empty Bio-only
                              ;; Medivacs (`not p7-has-widow-mine?`) from flying solo across enemy cannons/AA!
                              [(and (eq? ut 'medivac)
                                    (not (unit-medivac-loaded? u))
                                    (or p7-fog-suppress?
                                        (l34-ctx-combat-suppress-attack? ctx)
                                        (frontline-combat-engaged? u)
                                        (not p7-has-widow-mine?)))
                               #f]
                              [(and p7-fog-suppress?
                                    (not enemy-near-home?)
                                    (not (l34-solo-harass-exempt-unit? ctx u)))
                               #f]
                              ;; L59 Tier-1B (`#1499` L39589): Exempt reserved runby/drop squads & Banelings
                              ;; from the `frontline-combat-engaged?` drop so `plan-baneling-move-past-and-light-clump-detonate`,
                              ;; `plan-coordinated-runby-tactics`, and `plan-multi-base-adept-harass` execute!
                              [(and (not (memq ut '(medivac warp-prism warp-prism-phasing overlord-transport baneling)))
                                    (not (set-member? p7-reserved-harass-set (hash-ref u 'id -1)))
                                    (frontline-combat-engaged? u))
                               #f]
                              [else
                               (set! has-active-harass-actor? #t)
                               #t])))
          u))
      (when (and (pair? filtered-allies)
                 (or enemy-near-home? has-active-harass-actor?))
        (define mh-worker-tags
          (for/seteqv ([u (in-list filtered-allies)]
                       #:when (and (hash? u)
                                   (hash-ref RUNTIME-WORKER-SET (unit-type-sym u) #f)
                                   (exact-integer? (hash-ref u 'id #f))))
            (hash-ref u 'id)))
        (define mh-home-defender-tags
          (if (and enemy-near-home? (<= 1792 frame 3024))
              (for/seteqv ([u (in-list filtered-allies)]
                           #:when (and (hash? u)
                                       (memq (unit-type-sym u) '(zergling marine stalker adept zealot))
                                       (exact-integer? (hash-ref u 'id #f))
                                       (let ([ux (hash-ref u 'x #f)] [uy (hash-ref u 'y #f)])
                                         (and (real? ux) (real? uy)
                                              (<= (+ (sqr (- (exact->inexact ux) (exact->inexact base-x)))
                                                     (sqr (- (exact->inexact uy) (exact->inexact base-y))))
                                                  784.0)))))
                (hash-ref u 'id))
              (seteqv)))
        (define mh-enemy-main-has-prod?
          (for/or ([eb (in-list enemy-bldgs)] #:when (hash? eb))
            (let ([ebx (hash-ref eb 'x #f)] [eby (hash-ref eb 'y #f)])
              (and (real? ebx) (real? eby)
                   (<= (+ (sqr (- (exact->inexact ebx) (exact->inexact enemy-x)))
                          (sqr (- (exact->inexact eby) (exact->inexact enemy-y))))
                       576.0)
                   (memq (fast-canonical-structure-sym (unit-type-sym eb))
                         '(barracks factory starport gateway robotics-facility stargate
                           spawning-pool roach-warren hatchery lair hive))))))
        (define mh-suppress-worker-proxy-scout?
          (or enemy-near-home?
              (not (eq? (hash-ref (rt-scout-state rt) 'visited-nat? #f) #t))
              mh-enemy-main-has-prod?))
        (define raw-mh-acts
          (step-multitask-harass-and-proxy
           direct-our-race
           direct-enemy-race
           filtered-allies
           enemy-units
           #:current-frame frame
           #:home-x base-x
           #:home-y base-y
           #:enemy-main-x enemy-x
           #:enemy-main-y enemy-y))
        (define clean-mh-acts
          (if (and (pair? raw-mh-acts)
                   (or p7-block-harass-vikings?
                       mh-suppress-worker-proxy-scout?
                       (not (set-empty? mh-home-defender-tags))))
              (for/list ([act (in-list raw-mh-acts)]
                         #:unless (or (and p7-block-harass-vikings?
                                           (list? act)
                                           (memq (car act) '(cast cast-spell))
                                           (>= (length act) 3)
                                           (memq (third act) '(morph-viking-assault morph-viking-fighter)))
                                      (and (pair? act)
                                           (eq? (car act) 'move)
                                           (>= (length act) 4)
                                           (exact-integer? (cadr act))
                                           (or (and mh-suppress-worker-proxy-scout?
                                                    (set-member? mh-worker-tags (cadr act)))
                                               (set-member? mh-home-defender-tags (cadr act)))
                                           (real? (caddr act))
                                           (real? (cadddr act))
                                           (> (+ (sqr (- (exact->inexact (caddr act)) (exact->inexact base-x)))
                                                 (sqr (- (exact->inexact (cadddr act)) (exact->inexact base-y))))
                                              1600.0))))
                act)
              raw-mh-acts))
        (emit-direct-batch! clean-mh-acts)))
    ;; Safety fallback: ensure no unit reserved for Phase 7 harass sits idle if planner declined.
    (when (not (set-empty? p7-reserved-harass-set))
      (define fallback-harass-acts
        (for/list ([rid (in-set p7-reserved-harass-set)]
                   #:when (not (hash-ref direct-claimed-ht rid #f)))
          (define ru (findf (lambda (u) (and (hash? u) (equal? (hash-ref u 'id #f) rid))) ally-units))
          (if (and ru (eq? (fast-canonical-unit-sym (unit-type-sym ru)) 'medivac))
              (list 'move rid base-x base-y)
              (list 'attack-pos rid enemy-x enemy-y))))
      (when (pair? fallback-harass-acts)
        (emit-direct-batch! fallback-harass-acts))))

  ;; Direct Tactic #3: `creep-and-changeling-tactics.rkt`
  (define creep-tr (rt-creep-tracker rt))
  (define direct-th-coords
    (let ([ths (for/list ([b (in-list ally-bldgs)]
                          #:when (and (hash? b)
                                      (memq (fast-canonical-structure-sym (unit-type-sym b))
                                            '(hatchery lair hive nexus command-center orbital-command planetary-fortress))))
                 (cons (exact->inexact (hash-ref b 'x base-x))
                       (exact->inexact (hash-ref b 'y base-y))))])
      (if (pair? ths) ths (list (cons (exact->inexact base-x) (exact->inexact base-y))))))
  (define direct-queen-reserve-cap
