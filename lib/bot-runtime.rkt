         (l2-emit-research-verified! ctx 'seismic-spines)))
  (define zerg-shimmer-ripples-present?
    (pair? (l2-shimmer-ripples ctx)))
  ;; L34-P0-3 (`#73` ZvP 4:20 DT Rush -> `CloakLoss = 0`): Honor Brain-scheduled proactive
  ;; `spore-crawler` AND proactively emit `1` Spore Crawler per base (max `2`) in ZvP starting
  ;; at `3:39` (`frame >= 4900`) while Lair/Hive is not yet ready and `overseers == 0`, so static
  ;; detection finishes by `~4:05` BEFORE `4:20` DTs arrive!
  (define brain-sched-spore-now?
    (and live-game?
         (or (eq? (l2-ctx-prio-saving-for-sym ctx) 'spore-crawler)
             (and (macro-brain-decision? (l2-ctx-macro-decision ctx))
                  (memq 'spore-crawler (macro-brain-decision-scheduled-ids (l2-ctx-macro-decision ctx)))))))
  (define zerg-proactive-zvp-spore-now?
    (and live-game?
         ;; L57-R3 (`#073 who` Random/Protoss): Broaden proactive 2-base Spores to `'(Protoss Random)`
         ;; starting at `3:25` (`4592f`) so unscouted Random->Protoss DT drops never hit unprotected bases!
         (memq (l2-ctx-effective-enemy-race ctx) '(Protoss Random))
         (>= frame 4592)
         (memq 'spawning-pool ready-bldg-types)
         (not (memq 'lair ready-bldg-types))
         (not (memq 'hive ready-bldg-types))
         (= (+ (l2-unit-count ctx 'overseer)
               (order-ledger-pending-count-for-type (l2-ctx-oledger ctx) 'overseer frame))
            0)
         (or (>= (length hatcheries) 2) (not zerg-saving-for-expand?))
         (or brain-sched-spore-now?
             (and (not (and early-survival-crisis? (< live-army-supply 4)))
                  ;; L55-T3 (`#73 ZvP who`): Build up to 1 Spore per base (max 2),
                  ;; not just 1 total, so BOTH Natural and Main stay protected vs 4:20 DTs!
                  (< (+ (l2-cur-ally-canon-bldg-count ctx 'spore-crawler)
                        (order-ledger-pending-count-for-type (l2-ctx-oledger ctx) 'spore-crawler frame))
                     (min 2 (max 1 (length hatcheries))))))))
  (when (or enemy-cloaked-or-air?
               zerg-shimmer-ripples-present?
               brain-sched-spore-now?
               zerg-proactive-zvp-spore-now?
               (enemy-tech-observation-requires-detection? tech-obs)
               (and (not live-game?) (memq 'spire (l2-ctx-bldg-types ctx))))
       ;; L29-P0-3 (`CloakLoss -> 0`): Allow up to 1 Spore Crawler per base (capped at 3) and
       ;; waive `zerg-spire-res-min` when active cloaked/detection threat exists so mineral lines
       ;; get immediate static detection even while saving for Spire!
       (define zerg-cloak-det-urgent?
         (or zerg-shimmer-ripples-present?
             (ormap (lambda (eb)
                      (and (hash? eb)
                           (memq (fast-canonical-structure-sym (unit-type-sym eb))
                                 '(dark-shrine lurker-den lurker-den-mp))))
                    (or (l2-ctx-enemy-bldgs ctx) '()))
             (ormap (lambda (e)
                      (and (hash? e)
                           (not (memq (fast-canonical-unit-sym (unit-type-sym e))
                                      '(creep-tumor creep-tumor-burrowed creep-tumor-queen)))
                           (or (eq? (hash-ref e 'cloaked #f) #t)
                               (memq (hash-ref e 'cloak 0) '(1 2 cloaked cloaked-detected))
                               (= (hash-ref e 'display-type 1) 3)
                               (eq? (hash-ref e 'burrowed #f) #t)
                               (eq? (hash-ref e 'is-burrowed #f) #t)
                               (memq (fast-canonical-unit-sym (unit-type-sym e))
                                     '(dark-templar banshee ghost lurker-burrowed lurker-mp-burrowed
                                       widow-mine-burrowed)))))
                    enemy-units)))
       (define cur-spore-cnt
         (+ (l2-cur-ally-canon-bldg-count ctx 'spore-crawler)
            (order-ledger-pending-count-for-type (l2-ctx-oledger ctx) 'spore-crawler frame)))
       (define desired-spore-cnt
         (cond
           [zerg-cloak-det-urgent? (min 3 (max 1 (length hatcheries)))]
           [(or zerg-proactive-zvp-spore-now? brain-sched-spore-now?)
            (min 2 (max 1 (length hatcheries)))]
           [else 1]))
       (define zerg-spore-priority-now?
         (or zerg-cloak-det-urgent? zerg-proactive-zvp-spore-now? brain-sched-spore-now?))
       (when (and (or (not live-game?)
                      (and (memq 'spawning-pool ready-bldg-types)
                           (< cur-spore-cnt desired-spore-cnt)
                           (l2-save-cancel-rebuild-ready? ctx 'spore-crawler 60)
                           (>= (- (l2-ctx-minerals ctx) (if zerg-spore-priority-now? 0 zerg-spire-res-min))
                               (sc2-min-cost 'spore-crawler))))
                  (refractory-allow-action?! cd-tracker
                                             (list 'static-detector 'spore-crawler)
                                             frame
                                             ;; L57-R3 (`#073 who`): Use fast `44f` (~2s) spacing between
                                             ;; Spore #1 (Natural) and Spore #2 (Main) while `< desired` so
                                             ;; BOTH bases finish static detection BEFORE `4:15` DT drops!
                                             (if (and zerg-spore-priority-now?
                                                      (< cur-spore-cnt desired-spore-cnt))
                                                 44
                                                 SC2-STATIC-DETECTOR-COOLDOWN-FRAMES)))
         (if live-game?
             (let-values ([(spc-def-x spc-def-y)
                           (if (and zerg-spore-priority-now? (pair? hatcheries))
                               (let* ([sp-pts
                                       (for/list ([b (in-list (or (l2-ctx-ally-bldgs ctx) '()))]
                                                  #:when (and (hash? b)
                                                              (eq? (fast-canonical-structure-sym (unit-type-sym b)) 'spore-crawler)
                                                              (real? (hash-ref b 'x #f)) (real? (hash-ref b 'y #f))))
                                         (cons (exact->inexact (hash-ref b 'x base-x))
                                               (exact->inexact (hash-ref b 'y base-y))))]
                                      [undef-hs
                                       (filter (lambda (h)
                                                 (and (hash? h)
                                                      (real? (hash-ref h 'x #f)) (real? (hash-ref h 'y #f))
                                                      (not (for/or ([sp (in-list sp-pts)])
                                                             (<= (dist2d (exact->inexact (hash-ref h 'x base-x))
                                                                         (exact->inexact (hash-ref h 'y base-y))
                                                                         (car sp) (cdr sp))
                                                                 12.0)))))
                                               hatcheries)]
                                      [undef-hs-sorted
                                       ;; L55-T3 (`#73 ZvP who`): Sort undefended bases farthest-from-Main
                                       ;; first so the exposed Natural gets Spore #1 before Main!
                                       (sort undef-hs >
                                             #:key (lambda (h)
                                                     (dist2d (exact->inexact (hash-ref h 'x base-x))
                                                             (exact->inexact (hash-ref h 'y base-y))
                                                             (exact->inexact base-x)
                                                             (exact->inexact base-y))))]
                                      [picked (and (pair? undef-hs-sorted) (car undef-hs-sorted))])
                                 (if picked
                                     (l2-mineral-line-offset ctx
                                                             (exact->inexact (hash-ref picked 'x base-x))
                                                             (exact->inexact (hash-ref picked 'y base-y))
                                                             3.0)
                                     (l2-mineral-line-offset ctx base-x base-y 3.0)))
                               (l2-mineral-line-offset ctx base-x base-y 3.0))])
               ;; L55-T3 (`#73 ZvP who`): Preserve the picked undefended-base mineral-line
               ;; coordinate `(spc-def-x, spc-def-y)` directly (Natural FIRST!), instead of letting
               ;; `l2-safe-zerg-build-anchor` snap every Spore Crawler back to Main Hatchery!
               (let-values ([(spc-ax spc-ay)
                             (if (and zerg-spore-priority-now? (pair? hatcheries))
                                 (values spc-def-x spc-def-y)
                                 (l2-safe-zerg-build-anchor ctx spc-def-x spc-def-y))])
                 (l2-emit-build-verified! ctx 'spore-crawler spc-ax spc-ay
                                          #:waive-worker-reserve? zerg-spore-priority-now?)))
             (let-values ([(spc-x spc-y) (l2-mineral-line-offset ctx base-x base-y 3.0)])
               (l2-emit! ctx (list 'build 'spore-crawler spc-x spc-y)))))
       (if live-game?
           (let* ([p3-ov-scout-st (and (l2-ctx-rt ctx) (rt-scout-state (l2-ctx-rt ctx)))]
                  [p3-routine-ov (if (hash? p3-ov-scout-st)
                                     (hash-ref p3-ov-scout-st 'routine-overseer-morphs 0)
                                     0)]
                  [p3-cur-ov-total
                   (+ (l2-unit-count ctx 'overseer)
                      (order-ledger-pending-count-for-type (l2-ctx-oledger ctx) 'overseer frame))])
             (define p3-last-ov2-morph-f
               (if (hash? p3-ov-scout-st)
                   (hash-ref p3-ov-scout-st 'last-overseer2-morph-frame -99999)
                   -99999))
             (define p3-last-ov-loss-f
               (if (hash? p3-ov-scout-st)
                   (hash-ref p3-ov-scout-st 'last-overseer-loss-frame -99999)
                   -99999))
             (define p3-ov2-remorph-cd-ok?
               (or (= p3-cur-ov-total 0)
                   (and (or (< frame p3-last-ov2-morph-f) (>= (- frame p3-last-ov2-morph-f) 448))
                        (or (< frame p3-last-ov-loss-f) (>= (- frame p3-last-ov-loss-f) 448)))))
             (when (and (or (memq 'lair ready-bldg-types) (memq 'hive ready-bldg-types))
                        p3-ov2-remorph-cd-ok?
                        (or zerg-cloak-det-urgent?
                            (and (< p3-routine-ov 3)
                                 (or (= p3-routine-ov 0)
                                     (refractory-allow-action?! cd-tracker 'zerg-routine-overseer-replace frame 448))))
                        (or (and (not zerg-holding-for-aa-spire?)
                                 (not zerg-holding-for-aa-corruptor?))
                            zerg-cloak-det-urgent?
                            enemy-cloaked-or-air?)
                        ;; L55-T4 (`#25 onlyfans` & `L37-T4c`): Once Overseer #1 is already live (`>= 1`),
                        ;; let Hydralisk/Corruptor #1..#4 spend gas (`< 150G`) BEFORE Overseer #2+!
                        (or (= p3-cur-ov-total 0)
                            (not (and zerg-real-anti-air-threat?
                                      (< (l2-ctx-gas ctx) 150)
                                      (or (and (memq 'hydralisk-den ready-bldg-types)
                                               (< (l2-unit-count ctx 'hydralisk) 4))
                                          (and (or (memq 'spire ready-bldg-types)
                                                   (memq 'greater-spire ready-bldg-types))
                                               (< (l2-unit-count ctx 'corruptor) 4))))))
                        ;; R1 (`#10 puck`): Keep live Overseer cap strictly `<= 2` (never `3`).
                        (< p3-cur-ov-total (if zerg-cloak-det-urgent? 2 1)))
               (when (l2-emit-unit-morph-verified! ctx 'overseer 'overlord 0)
                 (when (and (>= p3-cur-ov-total 1) (hash? p3-ov-scout-st))
                   (hash-set! p3-ov-scout-st 'last-overseer2-morph-frame frame))
                 (when (and (not zerg-cloak-det-urgent?) (hash? p3-ov-scout-st))
                   (hash-set! p3-ov-scout-st 'routine-overseer-morphs (add1 p3-routine-ov))))))
           (when (not (memq 'overseer unit-types))
             (l2-emit! ctx '(morph overseer)))))
  (define-values (overseers active-changelings)
       (let ([ov-rev '()] [ch-cnt 0])
         (for ([u (in-list ally-units)])
           (define ut (unit-type-sym u))
           (cond
             [(eq? (fast-canonical-unit-sym ut) 'overseer)
              (set! ov-rev (cons u ov-rev))]
             [(and live-game?
                   (memq ut '(changeling changeling-zealot changeling-marine
                              changeling-marine-shield changeling-zergling
                              changeling-zergling-wings)))
              (set! ch-cnt (add1 ch-cnt))]))
         (values (reverse ov-rev) ch-cnt)))
  (define enemy-bldgs-ov (or (l2-ctx-enemy-bldgs ctx) '()))
  (for ([ov (in-list overseers)])
       (define ov-en (hash-ref ov 'energy SC2-OVERSEER-CHANGELING-ENERGY))
       (define ov-id (hash-ref ov 'id 190))
       (define save-for-contaminate?
         (and live-game?
              (>= ov-en 100)
              (real? (hash-ref ov 'x #f)) (real? (hash-ref ov 'y #f))
              (let ([ox (exact->inexact (hash-ref ov 'x 0.0))]
                    [oy (exact->inexact (hash-ref ov 'y 0.0))])
                (or (ormap (lambda (eb)
                             (and (hash? eb)
                                  (real? (hash-ref eb 'x #f)) (real? (hash-ref eb 'y #f))
                                  (<= (fast-dist2d ox oy
                                                   (exact->inexact (hash-ref eb 'x 9999.0))
                                                   (exact->inexact (hash-ref eb 'y 9999.0)))
                                      28.0)))
                           enemy-bldgs-ov)
                    (ormap (lambda (e)
                             (and (hash? e) (combat-unit-record? e)
                                  (real? (hash-ref e 'x #f)) (real? (hash-ref e 'y #f))
                                  (<= (fast-dist2d ox oy
                                                   (exact->inexact (hash-ref e 'x 9999.0))
                                                   (exact->inexact (hash-ref e 'y 9999.0)))
                                      16.0)))
                           enemy-units)))))
       (when (and (>= ov-en SC2-OVERSEER-CHANGELING-ENERGY)
                  (not save-for-contaminate?)
                  (or (not live-game?)
                      (and (< active-changelings 2)
                           (refractory-allow-action?! cd-tracker 'overseer-changeling frame 336)
                           (refractory-allow-action?! cd-tracker (list 'overseer-changeling ov-id) frame 336))))
         (l2-emit! ctx (list 'cast ov-id 'spawn-changeling enemy-x enemy-y))))
  (cond
       [(memq 'lurker-den ready-bldg-types)
        (when (or (not live-game?)
                  (and (not zerg-saving-for-expand?)
                       (< (l2-unit-count ctx 'lurker) 8)
                       (l2-can-spend-by-priority? ctx 'lurker 'combat-unit)))
          (l2-emit-unit-morph-verified! ctx 'lurker 'hydralisk 1))]
       [(and (not live-game?)
             (memq 'spire ready-bldg-types)
             (memq 'hydralisk-den ready-bldg-types))
        (l2-emit! ctx '(morph lurker))])
  (when (and (not live-game?)
                (memq 'spire ready-bldg-types)
                (memq 'hydralisk-den ready-bldg-types)
                (not (l2-building-present-or-pending? ctx 'hive)))
       (l2-emit! ctx '(morph hive)))
  (when (memq 'greater-spire ready-bldg-types)
       (l2-emit-unit-morph-verified! ctx 'brood-lord 'corruptor 2))
  ;; L26-P0-3 (`#25` 56 Drones on 2 Hatcheries): Sync L2 Zerg 2-base Drone cap (`<= 40`)
  ;; with Brain's L25 cap whenever `<= 2` real Hatcheries (completed or under-construction
  ;; in `ally-bldgs`) exist on the map so unconfirmed walking-Drone intents never bypass
  ;; the cap and `target-workers = 66` never overrides it!
  (define zerg-2base-hard-cap
    (and live-game?
         (<= (length hatcheries) 2)
         40))
  (define zerg-ideal-worker-cap
    (let ([raw-cap (l2-compute-race-ideal-worker-cap ctx hatcheries)])
      (if zerg-2base-hard-cap (min zerg-2base-hard-cap raw-cap) raw-cap)))
  (define zerg-eff-worker-ceiling
    (if zerg-2base-hard-cap
        zerg-2base-hard-cap
        (min 76 (max target-workers zerg-ideal-worker-cap))))
  (define zerg-3base-interleave-drone-ok?
       (and (not under-base-attack?)
            (>= (length hatcheries) 3)
            (< total-workers 55)
            (or (< total-workers 38)
                zerg-larva-mineral-surplus-ok?
                (>= live-army-supply (max 4.0 zerg-vs-tp-or-fog-floor)))
            (>= live-army-supply 4.0)))
  (define zerg-p3-owm-sum
    (let ([rt3 (l2-ctx-rt ctx)])
      (and rt3 (opponent-world-model-last-summary (rt-opponent-world-model rt3)))))
  (define zerg-p3-owm-kc (and zerg-p3-owm-sum (opponent-world-summary-known-unit-counts zerg-p3-owm-sum)))
  ;; Loop 63 + 63B Bug #3B (Peaceful Zerg 2:30-4:30 Drone-vs-Ling/Roach Larva Tempo):
  ;; Scope to HOME threat (no visible enemy combat unit <= 40t of Main/Nat, 0 threat supply,
  ;; no base-attack/cheese/proxy/worker-rush) so distant scouted armies never flip peaceful
  ;; opening macro off; keep Drone batch at 4, bypass non-essential BO reserves < 4:00 (< 34w),
  ;; cap safety Lings at 4 (6 ZvZ) batch 2, and cap peaceful Roaches at <= 2!
  (define zerg-p3-nat-x (l2-ctx-nat-x ctx))
  (define zerg-p3-nat-y (l2-ctx-nat-y ctx))
  (define zerg-enemy-combat-near-home?
    (ormap (lambda (e)
             (and (hash? e) (combat-unit-record? e)
                  (not (eq? (hash-ref e 'snapshot? #f) #t))
                  (real? (hash-ref e 'x #f)) (real? (hash-ref e 'y #f))
                  (let ([ex (exact->inexact (hash-ref e 'x 9999.0))]
                        [ey (exact->inexact (hash-ref e 'y 9999.0))])
                    (or (<= (fast-dist2d base-x base-y ex ey) 40.0)
                        (<= (fast-dist2d zerg-p3-nat-x zerg-p3-nat-y ex ey) 40.0)))))
           enemy-units))
  (define zerg-early-peaceful-drone-tempo?
    (and live-game?
         (< frame 6048)
         (< total-workers 38)
         (< total-workers zerg-eff-worker-ceiling)
         (not under-base-attack?)
         (not under-early-cheese?)
         (not early-survival-crisis?)
         (not (l2-ctx-worker-rush-active? ctx))
         (not (l2-ctx-forward-proxy-detected? ctx))
         (not (l2-ctx-in-base-proxy-detected? ctx))
         (<= live-enemy-threat-supply 0)
         (< (hash-ref pressure-metrics 'threat-pressure 0.0) 0.35)
         (not zerg-enemy-combat-near-home?)))
  (define zerg-peaceful-safety-ling-cap
    (if (eq? effective-enemy-race 'Zerg) 6 4))
  (define zerg-drone-batch
       (cond
         [(and (> live-enemy-threat-supply 0) (>= total-workers 24)) 1]
         [(and zerg-early-peaceful-drone-tempo? (not zerg-saving-for-expand?)) 4]
         ;; L48-W2 (`H2H #01 ZvZ` Drone-vs-Combat Larva Guard): Cap Drone batch `<= 2` when
         ;; `live-army-supply < 40` so Zerg never dumps 6 Larvae at once into Drones ahead of army!
         [(and live-game? (>= total-workers 24) (< live-army-supply 40.0)) 2]
         [live-game? 6]
         [else 4]))
  (define zerg-hold-for-16hatch?
       (and live-game?
            (not (l2-ctx-worker-rush-active? ctx))
            (not under-early-cheese?)
            (not early-survival-crisis?)
            (not blocked-nat-expanded-early?)
            (not (l2-ctx-natural-blocked? ctx))
            (not (l2-ctx-forward-proxy-detected? ctx))
            (not (l2-ctx-escrow-suppressed-active? ctx))
            (<= (length hatcheries) 1)
            (= (order-ledger-pending-count-for-type (l2-ctx-oledger ctx) 'hatchery frame) 0)
            (< frame 2400)
            (>= total-workers 16)
            (or (>= (l2-ctx-minerals ctx) 190)
                (not (member '(train drone) prio-scheduled-actions)))
            (< (l2-ctx-minerals ctx) (+ (sc2-min-cost 'hatchery) (sc2-min-cost 'drone)))))
  (define zerg-hold-for-17pool?
       (and live-game?
            (not (l2-ctx-worker-rush-active? ctx))
            (not (l2-building-present-or-pending? ctx 'spawning-pool))
            (< frame 2400)
            (>= total-workers 16)
            (< (l2-ctx-minerals ctx) (+ (sc2-min-cost 'spawning-pool) (sc2-min-cost 'drone)))))
  ;; L37-P0-2 (`#34` ZvT Bio -> 0 Banelings): Compute heavy-bio Baneling demand BEFORE Drone
  ;; training so urgent Banelings (`25M/25G`, 0 Larva) morph immediately vs >= 10 visible / >= 18 OWM Marines!
  (define zerg-vis-marine-cnt
    (count (lambda (e)
             (and (hash? e)
                  (memq (fast-canonical-unit-sym (unit-type-sym e)) '(marine zealot))))
           enemy-units))
  (define zerg-owm-marine-cnt
    (if (hash? zerg-p3-owm-kc)
        (+ (hash-ref zerg-p3-owm-kc 'marine 0)
           (hash-ref zerg-p3-owm-kc 'zealot 0))
        0))
  ;; L50-W1 (`#1192`/`#1201`) + L53-W2-3 (`#001 ZvZ` Stale Early-Ling OWM Guard):
  ;; Gate Baneling morphs on enemy Light ground presence (`>= 4` Marines/Zealots/Zerglings/
  ;; Hydralisks/Adepts), AND in ZvZ suppress stale lifetime OWM `zergling` counts once
  ;; opponent has transitioned to Roach/Ravager (`>= 8`) and visible Zerglings `< 12`!
  (define zerg-vis-zergling-cnt
    (count (lambda (e)
             (and (hash? e)
                  (eq? (fast-canonical-unit-sym (unit-type-sym e)) 'zergling)))
           enemy-units))
  (define zerg-enemy-roach-ravager-cnt
    (max (count (lambda (e)
                  (and (hash? e)
                       (memq (fast-canonical-unit-sym (unit-type-sym e))
                             '(roach roach-burrowed ravager))))
                enemy-units)
         (if (hash? zerg-p3-owm-kc)
             (+ (hash-ref zerg-p3-owm-kc 'roach 0)
                (hash-ref zerg-p3-owm-kc 'roach-burrowed 0)
                (hash-ref zerg-p3-owm-kc 'ravager 0))
             0)))
  (define zerg-zvz-stale-owm-ling-suppress?
    (and (eq? effective-enemy-race 'Zerg)
         (>= zerg-enemy-roach-ravager-cnt 8)
         (< zerg-vis-zergling-cnt 12)))
  (define zerg-vis-light-gnd-cnt
    (count (lambda (e)
             (and (hash? e)
                  (memq (fast-canonical-unit-sym (unit-type-sym e))
                        '(marine zealot zergling hydralisk adept))))
           enemy-units))
  (define zerg-owm-light-gnd-cnt
    (if (hash? zerg-p3-owm-kc)
        (+ (hash-ref zerg-p3-owm-kc 'marine 0)
           (hash-ref zerg-p3-owm-kc 'zealot 0)
           (if zerg-zvz-stale-owm-ling-suppress?
               0
               (hash-ref zerg-p3-owm-kc 'zergling 0))
           (hash-ref zerg-p3-owm-kc 'hydralisk 0)
           (hash-ref zerg-p3-owm-kc 'adept 0))
        0))
  (define zerg-enemy-light-ground-present?
    (or (>= zerg-vis-light-gnd-cnt 4)
        (>= zerg-owm-light-gnd-cnt 4)))
  (define brain-sched-baneling-p3?
    (or (eq? (l2-ctx-prio-saving-for-sym ctx) 'baneling)
        (and (member '(morph baneling) prio-scheduled-actions) #t)
        (and (macro-brain-decision? (l2-ctx-macro-decision ctx))
             (not (not (memq 'baneling (macro-brain-decision-scheduled-ids (l2-ctx-macro-decision ctx))))))))
  (define zerg-vs-heavy-bio?
    (and live-game?
         (not zerg-holding-for-aa-spire?)
         (not (and zerg-holding-for-aa-corruptor? zerg-heavy-cap-air-threat?))
         (or (>= zerg-vis-marine-cnt 10)
             (>= zerg-owm-marine-cnt 18)
             (>= zerg-vis-light-gnd-cnt 12)
             (>= zerg-owm-light-gnd-cnt 18)
             (and brain-sched-baneling-p3?
                  zerg-enemy-light-ground-present?))))
  (when (and zerg-vs-heavy-bio?
             (memq 'baneling-nest ready-bldg-types))
    (define desired-banes-urgent
