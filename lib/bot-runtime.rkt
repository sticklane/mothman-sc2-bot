                                             #:map-width p5-corr-map-w
                                             #:map-height p5-corr-map-h
                                             #:enemy-fallback-x p5-ex0
                                             #:enemy-fallback-y p5-ey0)))
    (when (hash? l34-sc)
      (hash-set! l34-sc 'l58-pos-ctx p5-pos-ctx))
    (define-values (p5-corr-best-cnt p5-corr-best-x p5-corr-best-y p5-corr-stage-x p5-corr-stage-y)
      (if p5-corruptor-volley-mode?
          (let* ([cap-pt
                  (cond
                    [(pair? p5-enemy-cap-air-pts)
                     (define cap-n (exact->inexact (length p5-enemy-cap-air-pts)))
                     (define pt
                       (cons (fl/ (for/fold ([s 0.0]) ([p (in-list p5-enemy-cap-air-pts)]) (fl+ s (car p))) cap-n)
                             (fl/ (for/fold ([s 0.0]) ([p (in-list p5-enemy-cap-air-pts)]) (fl+ s (cdr p))) cap-n)))
                     (when rt (hash-set! (rt-door-state rt) 'l33-last-cap-air-pos pt))
                     pt]
                    [(and rt (pair? (hash-ref (rt-door-state rt) 'l33-last-cap-air-pos #f)))
                     (hash-ref (rt-door-state rt) 'l33-last-cap-air-pos)]
                    [else (cons p5-ex0 p5-ey0)])]
                 [cap-cx (car cap-pt)]
                 [cap-cy (cdr cap-pt)]
                 ;; Pick safest rear Hatchery/Lair/Hive (farthest from enemy capital air),
                 ;; then step 17.0 tiles behind it (outside 14-range Tempest fire!).
                 [safe-anchor
                  (for/fold ([best-pt (cons fbase-x fbase-y)]
                             [best-d (fast-dist2d fbase-x fbase-y cap-cx cap-cy)]
                             #:result best-pt)
                            ([b (in-list (let ([v (hash-ref p5-obs 'ally-buildings '())]) (if (list? v) v '())))])
                    (if (and (hash? b)
                             (memq (fast-canonical-structure-sym (unit-type-sym b))
                                   '(hatchery lair hive))
                             (real? (hash-ref b 'x #f))
                             (real? (hash-ref b 'y #f)))
                        (let* ([bx0 (exact->inexact (hash-ref b 'x fbase-x))]
                               [by0 (exact->inexact (hash-ref b 'y fbase-y))]
                               [bd (fast-dist2d bx0 by0 cap-cx cap-cy)])
                          (if (fl> bd best-d)
                              (values (cons bx0 by0) bd)
                              (values best-pt best-d)))
                        (values best-pt best-d)))]
                 [ax0 (car safe-anchor)]
                 [ay0 (cdr safe-anchor)]
                 [dx-away (fl- ax0 cap-cx)]
                 [dy-away (fl- ay0 cap-cy)]
                 [d-away (flmax 1.0 (flsqrt (fl+ (fl* dx-away dx-away) (fl* dy-away dy-away))))]
                 [sx (flmax 6.0 (flmin (fl- p5-corr-map-w 6.0) (fl+ ax0 (fl* 17.0 (fl/ dx-away d-away)))))]
                 [sy (flmax 6.0 (flmin (fl- p5-corr-map-h 6.0) (fl+ ay0 (fl* 17.0 (fl/ dy-away d-away)))))])
            (let-values ([(bc bx by)
                          (for/fold ([best-c 0] [best-x fbase-x] [best-y fbase-y])
                                    ([cp (in-list p5-ally-corruptor-pts)])
                            (define cx0 (car cp))
                            (define cy0 (cdr cp))
                            (define-values (cnt sumx sumy)
                              (for/fold ([k 0] [ax 0.0] [ay 0.0])
                                        ([op (in-list p5-ally-corruptor-pts)])
                                (if (fl<= (fast-dist2d cx0 cy0 (car op) (cdr op)) 12.0)
                                    (values (add1 k) (fl+ ax (car op)) (fl+ ay (cdr op)))
                                    (values k ax ay))))
                            (if (> cnt best-c)
                                (values cnt (fl/ sumx (exact->inexact cnt)) (fl/ sumy (exact->inexact cnt)))
                                (values best-c best-x best-y)))])
              (values bc bx by (safe-coord sx fbase-x) (safe-coord sy fbase-y))))
          (values 0 fbase-x fbase-y fbase-x fbase-y)))
    ;; L33-P0-3 (`#18` isolated Phoenixes & Colossi regroup): Precompute visible enemy combat pts,
    ;; contested enemy AA count, and our main ground-army cluster once per step so `< 4` isolated
    ;; Phoenixes (vs contested AA) or isolated Colossi regroup with main army / staging instead of
    ;; trickling individually across the map!
    (define p5-has-phx-or-col?
      (and live-obs?
           (not endgame-harmless-only-sweep?)
           (not under-tactics-base-attack?)
           (for/or ([u (in-list combat-units)])
             (and (hash? u) (memq (unit-type-sym u) '(phoenix colossus))))))
    (define p5-vis-enemy-combat-all-pts
      (if (or p5-corruptor-volley-mode? p5-has-phx-or-col?)
          (for/list ([e (in-list enemy-units)]
                     #:when (and (hash? e)
                                 (combat-unit-record? e)
                                 (not (p5-snapshot-entity? e))
                                 (real? (hash-ref e 'x #f))
                                 (real? (hash-ref e 'y #f))))
            (cons (exact->inexact (hash-ref e 'x 0.0))
                  (exact->inexact (hash-ref e 'y 0.0))))
          '()))
    (define p5-enemy-contested-aa-cnt
      (if p5-has-phx-or-col?
          (let ([aa-syms '(viking viking-fighter corruptor phoenix void-ray voidray mutalisk
                           battlecruiser carrier tempest hydralisk thor stalker marine cyclone)]
                [vis-aa (for/sum ([e (in-list enemy-units)]
                                  #:when (and (hash? e)
                                              (not (p5-snapshot-entity? e))
                                              (memq (fast-canonical-unit-sym (unit-type-sym e))
                                                    '(viking viking-fighter corruptor phoenix void-ray voidray mutalisk
                                                      battlecruiser carrier tempest hydralisk thor stalker marine cyclone))))
                          1)]
                [owm-aa (if p5-owm
                            (let ([kc (opponent-world-summary-known-unit-counts p5-owm)])
                              (if (hash? kc)
                                  (for/sum ([s (in-list '(viking viking-fighter corruptor phoenix void-ray voidray mutalisk
                                                          battlecruiser carrier tempest hydralisk thor stalker marine cyclone))])
                                    (hash-ref kc s 0))
                                  0))
                            0)])
            (max vis-aa owm-aa))
          0))
    (define-values (p5-ally-combat-pts p5-iso-regroup-x p5-iso-regroup-y)
      (if p5-has-phx-or-col?
          (let-values ([(all-pts gcnt gsx gsy)
                        (for/fold ([pts '()] [gc 0] [sx 0.0] [sy 0.0]) ([u (in-list combat-units)])
                          (define ux0 (hash-ref u 'x #f))
                          (define uy0 (hash-ref u 'y #f))
                          (if (and (real? ux0) (real? uy0))
                              (let* ([fux0 (exact->inexact ux0)]
                                     [fuy0 (exact->inexact uy0)]
                                     [ut0 (unit-type-sym u)]
                                     [gnd-main?
                                      (and (not (eq? ut0 'colossus))
                                           (not (fast-unit-is-flying-sym? ut0))
                                           (not (memq ut0 '(observer overseer warp-prism warp-prism-phasing
                                                            medivac queen high-templar disruptor disruptor-phased))))])
                                (values (cons (cons fux0 fuy0) pts)
                                        (if gnd-main? (add1 gc) gc)
                                        (if gnd-main? (fl+ sx fux0) sx)
                                        (if gnd-main? (fl+ sy fuy0) sy)))
                              (values pts gc sx sy)))])
            (if (>= gcnt 3)
                (values all-pts
                        (safe-coord (fl/ gsx (exact->inexact gcnt)) nat-x)
                        (safe-coord (fl/ gsy (exact->inexact gcnt)) nat-y))
                (if (>= live-owned-townhalls 3)
                    (values all-pts third-x third-y)
                    (values all-pts nat-x nat-y))))
          (values '() nat-x nat-y)))
    ;; L25-P0-3 (`DRIP_FEED_COLLAPSE 12 -> <= 4`, `clip03`): Defensive Ground Counter-Volley Staging.
    ;; When `enemy-within-14-of-th?` (enemy >= 1400 val camping our Natural/3rd) while Main is
    ;; unbreached and we are severely outgunned (`< 0.60x` latched to `0.78x / 2000 val / 36 sup`),
    ;; muster newly-spawned ground/mixed units (> 14t from visible enemy combat) at Main ramp via
    ;; `attack-pos` ONLY (NEVER passive `move` -> `OBRet = 0`!). When `not enemy-within-14-of-th?`,
    ;; our tightened `mass-parity-before-attack-suppress?` (L21749 & L21765 closed) handles distant
    ;; staging through `(case ut ...)` + `l34-emit-engage-or-rally!` + `l20-mass-stage-rally`!
    (define p5-l25-counter-volley-staging?
      (and live-obs?
           (l34-ctx-enemy-within-14-of-th? ctx)
           (hash? l34-sc)
           (hash-ref l34-sc 'l25-counter-volley-staging? #f)
           (not (hash-ref l34-sc 'l25-enemy-within-14-of-main? #f))))
    (define p5-l64-defensive-muster?
      (and live-obs?
           (hash? l34-sc)
           (hash-ref l34-sc 'l64-defensive-muster-active? #f)))
    (define p5-l64-local-push-val
      (if (hash? l34-sc)
          (hash-ref l34-sc 'l64-local-push-val 0)
          0))
    (define p5-vis-enemy-combat-pts
      (if (or p5-l25-counter-volley-staging? p5-l64-defensive-muster?)
          (for/list ([e (in-list enemy-units)]
                     #:when (and (hash? e)
                                 (combat-unit-record? e)
                                 (not (p5-snapshot-entity? e))
                                 (real? (hash-ref e 'x #f))
                                 (real? (hash-ref e 'y #f))))
            (cons (exact->inexact (hash-ref e 'x 0.0))
                  (exact->inexact (hash-ref e 'y 0.0))))
          '()))
    ;; Loop 64B Bug #1 + Loop 65F (`#1811`/`#1922`): Precompute friendly combat units in combat
    ;; contact (`<= 15.0t` of any visible enemy combat) once per step so `l64-muster-cmd` NEVER
    ;; peels rear units within `22.0t` of fighting allies away from an active engagement!
    (define p5-allies-in-contact-pts
      (if (and p5-l64-defensive-muster? (pair? p5-vis-enemy-combat-pts))
          (for/list ([au (in-list combat-units)]
                     #:when (and (hash? au)
                                 (real? (hash-ref au 'x #f))
                                 (real? (hash-ref au 'y #f))
                                 (let ([ax (exact->inexact (hash-ref au 'x 0.0))]
                                       [ay (exact->inexact (hash-ref au 'y 0.0))])
                                   (for/or ([ep (in-list p5-vis-enemy-combat-pts)])
                                     (fl<= (fast-dist2d ax ay (car ep) (cdr ep)) 15.0)))))
            (cons (exact->inexact (hash-ref au 'x 0.0))
                  (exact->inexact (hash-ref au 'y 0.0))))
          '()))
    ;; Loop 64 P0 #1 (`#1724`): Use precomputed generalized situational fallback anchor
    ;; (`pick-safe-fallback-point`, cached once/step in `l34-sc`) instead of hardcoded Main/Nat/3rd!
    (define-values (p5-ground-muster-x p5-ground-muster-y)
      (let ([fx (and (hash? l34-sc) (hash-ref l34-sc 'l64-fallback-x #f))]
            [fy (and (hash? l34-sc) (hash-ref l34-sc 'l64-fallback-y #f))])
        (if (and (real? fx) (real? fy))
            (values fx fy)
            (values nat-x nat-y))))

    ;; L31-P0-3 (`t04` Frontline Bio Peel for Ghosts): Precompute friendly Ghost coords & enemy
    ;; melee divers (`<= 3.5t` of any friendly Ghost) once per step so Marines/Marauders peel
    ;; close Zerglings BEFORE they interrupt Ghost Snipes (`2714`)!
    (define p5-ally-ghost-pts
      (for/list ([au (in-list combat-units)]
                 #:when (and (hash? au)
                             (eq? (unit-type-sym au) 'ghost)
                             (real? (hash-ref au 'x #f))
                             (real? (hash-ref au 'y #f))))
        (cons (exact->inexact (hash-ref au 'x 0.0))
              (exact->inexact (hash-ref au 'y 0.0)))))
    (define p5-ghost-peel-enemies
      (if (null? p5-ally-ghost-pts)
          '()
          (for/list ([e (in-list engagement-enemies)]
                     #:when (and (hash? e)
                                 (real? (hash-ref e 'x #f))
                                 (real? (hash-ref e 'y #f))
                                 (not (eq? (hash-ref e 'hallucination #f) #t))
                                 (let ([cv (hash-ref e 'cloak #f)])
                                   (not (or (eqv? cv 1) (eq? cv 'cloaked))))
                                 (let* ([est (fast-unit-combat-stats (unit-type-sym e))]
                                        [egd (if (hash? est) (exact->inexact (hash-ref est 'ground-dps 0.0)) 0.0)]
                                        [egr (if (hash? est) (exact->inexact (hash-ref est 'ground-range 0.0)) 0.0)])
                                   (and (fl> egd 0.0) (fl<= egr 1.5)))
                                 (let ([ex0 (exact->inexact (hash-ref e 'x 9999.0))]
                                       [ey0 (exact->inexact (hash-ref e 'y 9999.0))])
                                   (for/or ([gp (in-list p5-ally-ghost-pts)])
                                     (define dx (fl- ex0 (car gp)))
                                     (define dy (fl- ey0 (cdr gp)))
                                     (fl<= (fl+ (fl* dx dx) (fl* dy dy)) 12.25)))))
            e)))

    ;; L39-P0-1f (`#72` Anti-Decoy Early Home Tether): Before 4:30 (`< 6048f`) with `<= 3` early
    ;; combat defenders near an owned main/natural TownHall, NEVER chase `1` decoy Zergling mid-map
    ;; while enemy combat units enter our main/natural! Prioritize breachers closest to main/natural,
    ;; and tether `<= 2` early defenders (`< 4:00`) near home choke instead of chasing distant decoys.
    (define p5-has-owned-home-th?
      (and live-obs?
           (< frame 6048)
           (for/or ([b (in-list (or (l34-ctx-ally-bldgs ctx) '()))])
             (and (hash? b)
                  (memq (fast-canonical-structure-sym (unit-type-sym b))
                        '(nexus hatchery lair hive command-center orbital-command planetary-fortress))
                  (l34-within-r2? (hash-ref b 'x 9999.0) (hash-ref b 'y 9999.0) fbase-x fbase-y 196.0 14.0)))))
    (define p5-has-home-th?
      (and p5-has-owned-home-th?
           (<= (length combat-units) 3)))
    (define p5-early-home-breachers
      (if p5-has-home-th?
          (for/list ([e (in-list enemy-units)]
                     #:when (and (hash? e)
                                 (combat-unit-record? e)
                                 (not (p5-snapshot-entity? e))
                                 (not (eq? (hash-ref e 'hallucination #f) #t))
                                 (let ([cv (hash-ref e 'cloak #f)])
                                   (not (or (eqv? cv 1) (eq? cv 'cloaked))))
                                 (real? (hash-ref e 'x #f)) (real? (hash-ref e 'y #f))
                                 (let ([ex0 (exact->inexact (hash-ref e 'x 9999.0))]
                                       [ey0 (exact->inexact (hash-ref e 'y 9999.0))])
                                   (or (l34-within-r2? ex0 ey0 fbase-x fbase-y 400.0 20.0)
                                       (l34-within-r2? ex0 ey0 fnat-x fnat-y 324.0 18.0)))))
            e)
          '()))

    ;; L44-P0-1c (`#53 zig-reapers` 30m Home-Defense Counter-Wave Split):
    ;; When we field a large army (`>= 50` combat supply, `>= 10` combat units) and ONLY `<= 6` light
    ;; mobile harassers (`reaper`/`zergling`/`adept`/`hellion`/`banshee`/`oracle`/`phoenix`/
    ;; `mutalisk`/`dark-templar`) threaten our home bases (`<= 28t`) with ZERO heavy home enemies,
    ;; leave ONLY the closest `~30%` (min 4, max 12) defenders at home and dispatch the remaining
    ;; `~65-70%` counter-wave straight across the map to finish the enemy base!
    (define p5-home-anchor-pts
      (let ([th-pts
             (for/list ([b (in-list (or (l34-ctx-ally-bldgs ctx) '()))]
                        #:when (and (hash? b)
                                    (real? (hash-ref b 'x #f)) (real? (hash-ref b 'y #f))
                                    (memq (fast-canonical-structure-sym (unit-type-sym b))
                                          '(nexus hatchery lair hive command-center orbital-command planetary-fortress))))
               (cons (exact->inexact (hash-ref b 'x base-x))
                     (exact->inexact (hash-ref b 'y base-y))))])
        (cons (cons fbase-x fbase-y) (cons (cons fnat-x fnat-y) th-pts))))
    (define (p5-near-home-28? x y)
      (define fx0 (exact->inexact x))
      (define fy0 (exact->inexact y))
      (for/or ([pt (in-list p5-home-anchor-pts)])
        (fl<= (fast-dist2d fx0 fy0 (car pt) (cdr pt)) 28.0)))
    (define p5-vis-enemy-combat-sup
      (if live-obs?
          (for/fold ([sup 0.0]) ([e (in-list enemy-units)])
            (if (and (hash? e)
                     (combat-unit-record? e)
                     (not (p5-snapshot-entity? e))
                     (not (eq? (hash-ref e 'hallucination #f) #t))
                     (not (memq (fast-canonical-unit-sym (unit-type-sym e))
                                '(scv probe drone mule overlord overlord-cocoon overlord-transport
                                  overseer overseer-siege-mode observer larva egg))))
                (fl+ sup (flmax 0.5 (exact->inexact (sc2-supply-cost (fast-canonical-unit-sym (unit-type-sym e)) 1))))
                sup))
          0.0))
    (define p5-enemy-known-combat-sup
      (flmax p5-vis-enemy-combat-sup (exact->inexact p5-owm-bel-sup)))
    ;; L45-P0-1a (`#11 puck`, `#50 Thssprtssbt`, `H2H #02 TvT` fix + `#53 zig-reapers` preserve):
    ;; Gate `p5-light-harass-split-active?` strictly on offensive/victory posture AND decisive
    ;; combat-supply dominance (`>= 1.65 * (max 20.0 enemy-known-combat-sup)`) so parity/outnumbered
    ;; armies NEVER unsiege Tanks or march 70% blindly across the map against 1-6 Adepts/Phoenixes/Reapers!
    (define p5-light-harass-split-gate-ok?
      (and live-obs?
           p5-victory-posture?
           (>= p5-combat-sup 50.0)
           (>= p5-combat-sup (fl* 1.65 (flmax 20.0 p5-enemy-known-combat-sup)))
           (>= (length combat-units) 10)))
    (define-values (p5-light-home-harassers p5-heavy-home-enemies)
      (if p5-light-harass-split-gate-ok?
          (for/fold ([light '()] [heavy '()])
                    ([e (in-list enemy-units)]
                     #:when (and (hash? e)
                                 (combat-unit-record? e)
                                 (not (p5-snapshot-entity? e))
                                 (not (eq? (hash-ref e 'hallucination #f) #t))
                                 (real? (hash-ref e 'x #f)) (real? (hash-ref e 'y #f))
                                 (p5-near-home-28? (hash-ref e 'x 9999.0) (hash-ref e 'y 9999.0))))
            (define ec (fast-canonical-unit-sym (unit-type-sym e)))
            (if (memq ec '(reaper zergling adept hellion banshee oracle phoenix mutalisk dark-templar))
                (values (cons e light) heavy)
                (values light (cons e heavy))))
          (values '() '())))
    (define p5-light-harass-split-active?
      (and p5-light-harass-split-gate-ok?
           (pair? p5-light-home-harassers)
           (<= (length p5-light-home-harassers) 6)
           (null? p5-heavy-home-enemies)))
    (define p5-home-guard-tags
      (if p5-light-harass-split-active?
          (let* ([n-har (exact->inexact (length p5-light-home-harassers))]
                 [hcx (/ (for/sum ([he (in-list p5-light-home-harassers)])
                           (exact->inexact (hash-ref he 'x base-x)))
                         n-har)]
                 [hcy (/ (for/sum ([he (in-list p5-light-home-harassers)])
                           (exact->inexact (hash-ref he 'y base-y)))
                         n-har)]
                 [har-has-air?
                  (for/or ([he (in-list p5-light-home-harassers)])
                    (or (eq? (hash-ref he 'flying #f) #t)
                        (eq? (hash-ref he 'is-flying #f) #t)
                        (fast-unit-is-flying-sym? (unit-type-sym he))))]
                 [guard-cap (min 12 (max 4 (inexact->exact (round (* 0.30 (length combat-units))))))]
                 [cands
                  (filter (lambda (cu)
                            (define cut (unit-type-sym cu))
                            (and (not (memq cut '(siege-tank-sieged liberator-ag lurker-burrowed
                                                  widow-mine-burrowed medivac warp-prism warp-prism-phasing
                                                  observer overseer overseer-siege-mode)))
                                 (real? (hash-ref cu 'x #f)) (real? (hash-ref cu 'y #f))))
                          combat-units)]
                 [ranked
                  (sort cands <
                        #:key (lambda (cu)
                                (define cut (unit-type-sym cu))
                                (define d (fast-dist2d (exact->inexact (hash-ref cu 'x base-x))
                                                       (exact->inexact (hash-ref cu 'y base-y))
                                                       hcx hcy))
                                (define air-pen (if (and har-has-air? (not (fast-can-attack-air? cut))) 40.0 0.0))
                                (+ d air-pen)))])
            (for/seteqv ([cu (in-list (take ranked (min guard-cap (length ranked))))])
              (hash-ref cu 'id -1)))
          (seteqv)))
    (define p5-prepped-non-home-enemies
      (if p5-light-harass-split-active?
          (let ([har-set (for/seteqv ([he (in-list p5-light-home-harassers)])
                           (hash-ref he 'id -1))])
            (filter (lambda (pv)
                      (not (set-member? har-set (hash-ref (vector-ref pv 0) 'id -2))))
                    prepped-eng-enemies))
          '()))
    (define-values (p5-counter-attack-tx p5-counter-attack-ty)
      (if p5-light-harass-split-active?
          (let ([far-eb
                 (for/fold ([best #f] [bd +inf.0] #:result best)
                           ([eb (in-list (or (l34-ctx-enemy-bldgs ctx) '()))]
                            #:when (and (hash? eb)
                                        (real? (hash-ref eb 'x #f)) (real? (hash-ref eb 'y #f))
                                        (not (p5-near-home-28? (hash-ref eb 'x base-x) (hash-ref eb 'y base-y)))))
                   (define bx0 (exact->inexact (hash-ref eb 'x p5-ex0)))
                   (define by0 (exact->inexact (hash-ref eb 'y p5-ey0)))
                   (define d (fast-dist2d fbase-x fbase-y bx0 by0))
                   (if (fl< d bd) (values eb d) (values best bd)))])
            (if far-eb
                (values (safe-coord (hash-ref far-eb 'x p5-ex0) p5-ex0)
                        (safe-coord (hash-ref far-eb 'y p5-ey0) p5-ey0))
                (values (safe-coord p5-ex0 base-x)
                        (safe-coord p5-ey0 base-y))))
          (values p5-ex0 p5-ey0)))
    (define p5-blink-hv-focus-ht
      (let ([st (l34-ctx-splash-st ctx)])
        (and (hash? st) (hash-ref st 'stalker-blink-hv-focus-ht #f))))
    (define p5-all-eng-by-id
      (and (pair? engagement-enemies)
           (or eng-enemy-by-id
               (let ([ht (pooled-hasheqv! l34-sc 'l44-all-eng-by-id)])
                 (for ([e (in-list engagement-enemies)] #:when (hash? e))
                   (define id0 (hash-ref e 'id #f))
                   (when (and (exact-integer? id0) (> id0 0))
                     (hash-set! ht id0 e)))
                 ht))))

    ;; L52-2C (`#54 zig-reapers`): Detect enemy Reapers inside Main (`< 18.0t` from main Nexus)
    ;; so defending Protoss Stalkers/Adepts tether strictly inside `<= 12.0t` of the main mineral line
    ;; instead of chasing a lone decoy Reaper off the plateau to the natural!
    (define p5-protoss-main-reapers
      (if (and live-obs?
               (eq? (hash-ref p5-obs 'race #f) 'Protoss)
               (pair? enemy-units))
          (for/list ([e (in-list enemy-units)]
                     #:when (and (hash? e)
                                 (not (p5-snapshot-entity? e))
                                 (eq? (fast-canonical-unit-sym (unit-type-sym e)) 'reaper)
                                 (real? (hash-ref e 'x #f))
                                 (real? (hash-ref e 'y #f))
                                 (fl< (fast-dist2d fbase-x fbase-y
                                                   (exact->inexact (hash-ref e 'x 9999.0))
                                                   (exact->inexact (hash-ref e 'y 9999.0)))
                                      18.0)))
            e)
          '()))
    ;; Loop 63: Precompute owned TownHall points (for Anti-Phoenix Battery-Anchor Stalker leash
    ;; AND Anti-SwarmHost No-Locust-Chase base-perimeter check), home-harassing Phoenixes, and
    ;; exposed Swarm Hosts once per tick.
    (define p5-owned-th-pts
      (for/list ([b (in-list (or (l34-ctx-ally-bldgs ctx) '()))]
                 #:when (and (hash? b)
                             (real? (hash-ref b 'x #f)) (real? (hash-ref b 'y #f))
                             (memq (fast-canonical-structure-sym (unit-type-sym b))
                                   '(nexus hatchery lair hive command-center orbital-command planetary-fortress))))
        (cons (exact->inexact (hash-ref b 'x base-x))
              (exact->inexact (hash-ref b 'y base-y)))))
    (define p5-protoss-home-phoenixes
      (if (and live-obs?
               (eq? (hash-ref p5-obs 'race #f) 'Protoss)
               (pair? p5-owned-th-pts)
               (pair? enemy-units))
          (for/list ([e (in-list enemy-units)]
                     #:when (and (hash? e)
                                 (not (p5-snapshot-entity? e))
                                 (not (eq? (hash-ref e 'hallucination #f) #t))
                                 (eq? (fast-canonical-unit-sym (unit-type-sym e)) 'phoenix)
                                 (real? (hash-ref e 'x #f))
                                 (real? (hash-ref e 'y #f))
                                 (let ([px0 (exact->inexact (hash-ref e 'x 9999.0))]
                                       [py0 (exact->inexact (hash-ref e 'y 9999.0))])
                                   (for/or ([tp (in-list p5-owned-th-pts)])
                                     (fl<= (fast-dist2d px0 py0 (car tp) (cdr tp)) 26.0)))))
            e)
          '()))
    (define-values (p5-phx-anchor-x p5-phx-anchor-y p5-phoenix-anchor-stalker-tags)
      (if (>= (length p5-protoss-home-phoenixes) 2)
          (let* ([pn (exact->inexact (length p5-protoss-home-phoenixes))]
                 [pcx (fl/ (for/fold ([s 0.0]) ([pe (in-list p5-protoss-home-phoenixes)])
                             (fl+ s (exact->inexact (hash-ref pe 'x base-x))))
                           pn)]
                 [pcy (fl/ (for/fold ([s 0.0]) ([pe (in-list p5-protoss-home-phoenixes)])
                             (fl+ s (exact->inexact (hash-ref pe 'y base-y))))
                           pn)]
                 [harassed-th
                  (for/fold ([best (car p5-owned-th-pts)] [bd +inf.0] #:result best)
                            ([tp (in-list p5-owned-th-pts)])
                    (define d (fast-dist2d pcx pcy (car tp) (cdr tp)))
                    (if (fl< d bd) (values tp d) (values best bd)))]
                 [hx0 (car harassed-th)]
                 [hy0 (cdr harassed-th)]
                 ;; Anchor on ready mineral-line Shield Battery `<= 12t` of harassed Nexus if present!
                 [near-sb
                  (for/fold ([best #f] [bd 12.0] #:result best)
                            ([b (in-list (or (l34-ctx-ally-bldgs ctx) '()))]
                             #:when (and (hash? b)
                                         (eq? (fast-canonical-structure-sym (unit-type-sym b)) 'shield-battery)
                                         (>= (exact->inexact (hash-ref b 'build-progress 1.0)) 1.0)
                                         (real? (hash-ref b 'x #f)) (real? (hash-ref b 'y #f))))
                    (define sbx (exact->inexact (hash-ref b 'x hx0)))
                    (define sby (exact->inexact (hash-ref b 'y hy0)))
                    (define d (fast-dist2d hx0 hy0 sbx sby))
                    (if (fl<= d bd) (values (cons sbx sby) d) (values best bd)))]
                 [ax (if near-sb (car near-sb) hx0)]
                 [ay (if near-sb (cdr near-sb) hy0)]
                 ;; Anchor 3-5 closest Stalkers (3 for 2 Phoenixes, 4 for 3, 5 for >= 4) without
                 ;; pulling the rest of the army off the map!
                 [anchor-cap (min 5 (max 3 (add1 (length p5-protoss-home-phoenixes))))]
                 [ally-stks
                  (filter (lambda (cu)
                            (and (hash? cu)
                                 (eq? (unit-type-sym cu) 'stalker)
                                 (real? (hash-ref cu 'x #f)) (real? (hash-ref cu 'y #f))))
                          combat-units)]
                 [home-stks
                  (filter (lambda (cu)
                            (fl<= (fast-dist2d ax ay
                                               (exact->inexact (hash-ref cu 'x 9999.0))
                                               (exact->inexact (hash-ref cu 'y 9999.0)))
                                  36.0))
                          ally-stks)]
                 [stk-pool (if (>= (length home-stks) 3) home-stks ally-stks)]
                 [ranked
                  (sort stk-pool <
                        #:key (lambda (cu)
                                (fast-dist2d ax ay
                                             (exact->inexact (hash-ref cu 'x 9999.0))
                                             (exact->inexact (hash-ref cu 'y 9999.0)))))])
            (values ax ay
                    (for/seteqv ([cu (in-list (take ranked (min anchor-cap (length ranked))))])
                      (hash-ref cu 'id -1))))
          (values fbase-x fbase-y (seteqv))))
    ;; Loop 64 P1 #4 (Anti-Mutalisk Mineral-Line Anchor): Mirror Anti-Phoenix leash for all races
    ;; when >= 2 enemy Mutalisks harass within 26.0t of any owned TownHall. Anchor 3-6 closest
    ;; home AA defenders within <= 8.5t of mineral-line AA static defense / Shield Battery / TH!
    (define p5-home-mutalisks
      (if (and live-obs?
               (pair? p5-owned-th-pts)
               (pair? enemy-units))
          (for/list ([e (in-list enemy-units)]
                     #:when (and (hash? e)
                                 (not (p5-snapshot-entity? e))
                                 (not (eq? (hash-ref e 'hallucination #f) #t))
                                 (eq? (fast-canonical-unit-sym (unit-type-sym e)) 'mutalisk)
                                 (real? (hash-ref e 'x #f))
                                 (real? (hash-ref e 'y #f))
                                 (let ([mx0 (exact->inexact (hash-ref e 'x 9999.0))]
                                       [my0 (exact->inexact (hash-ref e 'y 9999.0))])
                                   (for/or ([tp (in-list p5-owned-th-pts)])
                                     (fl<= (fast-dist2d mx0 my0 (car tp) (cdr tp)) 26.0)))))
            e)
          '()))
    (define-values (p5-muta-anchor-x p5-muta-anchor-y p5-muta-anchor-tags)
      (if (>= (length p5-home-mutalisks) 2)
          (let* ([mn (exact->inexact (length p5-home-mutalisks))]
                 [mcx (fl/ (for/fold ([s 0.0]) ([me (in-list p5-home-mutalisks)])
                             (fl+ s (exact->inexact (hash-ref me 'x base-x))))
                           mn)]
                 [mcy (fl/ (for/fold ([s 0.0]) ([me (in-list p5-home-mutalisks)])
                             (fl+ s (exact->inexact (hash-ref me 'y base-y))))
                           mn)]
                 [harassed-th
                  (for/fold ([best (car p5-owned-th-pts)] [bd +inf.0] #:result best)
                            ([tp (in-list p5-owned-th-pts)])
                    (define d (fast-dist2d mcx mcy (car tp) (cdr tp)))
                    (if (fl< d bd) (values tp d) (values best bd)))]
                 [hx0 (car harassed-th)]
                 [hy0 (cdr harassed-th)]
                 [near-aa-def
                  (for/fold ([best #f] [bd 12.0] #:result best)
                            ([b (in-list (or (l34-ctx-ally-bldgs ctx) '()))]
                             #:when (and (hash? b)
                                         (memq (fast-canonical-structure-sym (unit-type-sym b))
                                               '(spore-crawler missile-turret shield-battery photon-cannon))
                                         (>= (exact->inexact (hash-ref b 'build-progress 1.0)) 1.0)
                                         (real? (hash-ref b 'x #f)) (real? (hash-ref b 'y #f))))
                    (define bx0 (exact->inexact (hash-ref b 'x hx0)))
                    (define by0 (exact->inexact (hash-ref b 'y hy0)))
                    (define d (fast-dist2d hx0 hy0 bx0 by0))
                    (if (fl<= d bd) (values (cons bx0 by0) d) (values best bd)))]
                 [ax (if near-aa-def (car near-aa-def) hx0)]
                 [ay (if near-aa-def (cdr near-aa-def) hy0)]
                 [anchor-cap (min 6 (max 3 (add1 (length p5-home-mutalisks))))]
                 [ally-aa
                  (filter (lambda (cu)
                            (and (hash? cu)
                                 (memq (unit-type-sym cu)
                                       '(stalker phoenix archon
                                         queen hydralisk corruptor
                                         marine thor viking viking-fighter))
                                 (real? (hash-ref cu 'x #f)) (real? (hash-ref cu 'y #f))))
                          combat-units)]
                 [home-aa
                  (filter (lambda (cu)
                            (fl<= (fast-dist2d ax ay
                                               (exact->inexact (hash-ref cu 'x 9999.0))
                                               (exact->inexact (hash-ref cu 'y 9999.0)))
                                  36.0))
                          ally-aa)]
                 [aa-pool (if (>= (length home-aa) 3) home-aa ally-aa)]
                 [ranked
                  (sort aa-pool <
                        #:key (lambda (cu)
                                (fast-dist2d ax ay
                                             (exact->inexact (hash-ref cu 'x 9999.0))
                                             (exact->inexact (hash-ref cu 'y 9999.0)))))])
            (values ax ay
                    (for/seteqv ([cu (in-list (take ranked (min anchor-cap (length ranked))))])
                      (hash-ref cu 'id -1))))
          (values fbase-x fbase-y (seteqv))))
    (define p5-exposed-swarm-hosts
      (if (and live-obs? (pair? enemy-units))
          (for/list ([e (in-list enemy-units)]
                     #:when (and (hash? e)
                                 (not (p5-snapshot-entity? e))
                                 (hash-has-key? RUNTIME-SWARM-HOST-SET (unit-type-sym e))
                                 (let ([cv (hash-ref e 'cloak #f)])
                                   (not (or (eqv? cv 1) (eq? cv 'cloaked))))
                                 (real? (hash-ref e 'x #f)) (real? (hash-ref e 'y #f))))
            e)
          '()))

    ;; L59 Tier-1A (`#1499` + `#1523`): Run `plan-siege-tank-targets` (`#:only-on-splash-risk? #t`)
    ;; AFTER `p5-light-harass-split-active?` / `p5-home-guard-tags` so dominant counter-wave Sieged
    ;; Tanks unsiege cleanly in Phase 5 (`L44-P0-1c` / `L45-T1a`) while staying-sieged tanks still
    ;; switch off friendly-splash-risk targets!
    (define p5-tank-splash-handled-set
      (let* ([p5-ally-units (or (l34-ctx-ally-units ctx) '())]
             [has-eligible-tank?
              (and (pair? enemy-units)
                   (for/or ([u (in-list p5-ally-units)])
                     (and (hash? u)
                          (eq? (unit-type-sym u) 'siege-tank-sieged)
                          (let ([tid (hash-ref u 'id -1)])
                            (and (not (set-member? wave3-handled-tags tid))
                                 (not (and has-combat-skip-tags? (hash-has-key? combat-skip-tags tid)))
                                 (not (and p5-light-harass-split-active?
                                           (not (set-member? p5-home-guard-tags tid)))))))))])
        (and has-eligible-tank?
             (let ([handled (mutable-seteqv)])
               (for ([std (in-list (plan-siege-tank-targets p5-ally-units enemy-units #:only-on-splash-risk? #t))])
                 (define stid (unit-mode-directive-unit-tag std))
                 (when (and (not (set-member? wave3-handled-tags stid))
                            (not (and has-combat-skip-tags? (hash-has-key? combat-skip-tags stid)))
                            (not (and p5-light-harass-split-active?
                                      (not (set-member? p5-home-guard-tags stid)))))
                   (set-add! wave3-handled-tags stid)
                   (set-add! handled stid)
                   (l34-emit-preserved! ctx (unit-mode-directive->sexp std))))
               handled))))

    (for ([u (in-list (if endgame-harmless-only-sweep? '() combat-units))])
      (define uid (hash-ref u 'id 101))
      (define u-ab-id (if live-obs? (hash-ref u 'order-ability-id 0) 0))
      (define protected-class (and (> u-ab-id 0) (fast-order-protection-class u-ab-id)))
      (define post-blink-focus-ready?
        (and (eq? (unit-type-sym u) 'stalker)
             p5-blink-hv-focus-ht
             (let ([bf-rec (hash-ref p5-blink-hv-focus-ht uid #f)])
               (and (pair? bf-rec) (<= frame (cdr bf-rec))))
             (let ([raw-wcd (hash-ref u 'weapon-cooldown (hash-ref u 'weapon_cooldown 0.0))])
               (or (not (real? raw-wcd)) (<= (exact->inexact raw-wcd) 0.05)))))
      (define skip?
        (or (and has-combat-skip-tags? (hash-has-key? combat-skip-tags uid))
            (and p5-tank-splash-handled-set (set-member? p5-tank-splash-handled-set uid))
            (and live-obs? (memq protected-class '(morph channel cast-walk)))
            (and (not post-blink-focus-ready?)
                 (order-ledger-unit-in-attack-swing? oledger u))))
      (define unit-in-counter-wave?
        (and p5-light-harass-split-active?
             (not (set-member? p5-home-guard-tags uid))
             (not (memq (unit-type-sym u)
                        '(queen observer overseer overseer-siege-mode warp-prism warp-prism-phasing)))))
      (define-values (ux uy ut target-enemy prepped-hit? used-peel-tgt?)
        (if skip?
            (values 0.0 0.0 'marine #f #f #f)
            (let ([x (hash-ref u 'x base-x)]
                  [y (hash-ref u 'y base-y)]
                  [t (unit-type-sym u)])
              ;; L44-P0-1a + L49-W1: Stalker post-blink HV focus-fire lock (`40f` after `stalker-blink-forward-snipe`);
              ;; once the initial HV target dies, automatically chain-focus the nearest living Sieged Tank /
              ;; Colossus / Liberator-AG / Disruptor / HT within `<= 8.5t` so Stalkers finish ALL Tanks/Colossi!
              (define blink-hv-tgt
                (and (eq? t 'stalker)
                     p5-blink-hv-focus-ht
                     p5-all-eng-by-id
                     (real? x) (real? y)
                     (let ([bf-rec (hash-ref p5-blink-hv-focus-ht uid #f)])
                       (and (pair? bf-rec)
                            (<= frame (cdr bf-rec))
                            (let ([fx0 (exact->inexact x)] [fy0 (exact->inexact y)])
                              (or (let ([he (hash-ref p5-all-eng-by-id (car bf-rec) #f)])
                                    (and (hash? he)
                                         (real? (hash-ref he 'x #f)) (real? (hash-ref he 'y #f))
                                         (<= (fast-dist2d fx0 fy0
                                                          (exact->inexact (hash-ref he 'x 9999.0))
                                                          (exact->inexact (hash-ref he 'y 9999.0)))
                                             8.5)
                                         he))
                                  (let ([chained
                                         (for/fold ([best #f] [best-sc +inf.0] #:result best)
                                                   ([he (in-list engagement-enemies)]
                                                    #:when (and (hash? he)
                                                                (memq (unit-type-sym he)
                                                                      '(siege-tank-sieged colossus liberator-ag disruptor high-templar))
                                                                (real? (hash-ref he 'x #f)) (real? (hash-ref he 'y #f))))
                                           (define d (fast-dist2d fx0 fy0
                                                                  (exact->inexact (hash-ref he 'x 9999.0))
                                                                  (exact->inexact (hash-ref he 'y 9999.0))))
                                           (if (fl<= d 8.5)
                                               (let ([sc (fl+ d (fl* 0.03 (exact->inexact (unit-total-hp-and-shield he))))])
                                                 (if (fl< sc best-sc) (values he sc) (values best best-sc)))
                                               (values best best-sc)))])
                                    (when chained
                                      (define ctid (hash-ref chained 'id 0))
                                      (when (and (exact-integer? ctid) (> ctid 0))
                                        (hash-set! p5-blink-hv-focus-ht uid
                                                   (cons ctid (max (cdr bf-rec) (+ frame 45))))))
                                    chained)))))))
              (define peel-tgt
                (and (not blink-hv-tgt)
                     (pair? p5-ghost-peel-enemies)
                     (memq t '(marine marauder hellbat))
                     (real? x) (real? y)
                     (let* ([fx (exact->inexact x)] [fy (exact->inexact y)]
                            [pst (fast-unit-combat-stats t)]
                            [p-air-lim (fl+ (if (hash? pst) (exact->inexact (hash-ref pst 'air-range 5.0)) 5.0) 1.0)])
                       (for/fold ([best #f] [best-sc +inf.0] #:result best)
                                 ([pe (in-list p5-ghost-peel-enemies)])
                         (define dx (fl- fx (exact->inexact (hash-ref pe 'x 9999.0))))
                         (define dy (fl- fy (exact->inexact (hash-ref pe 'y 9999.0))))
                         (define d2 (fl+ (fl* dx dx) (fl* dy dy)))
                         (if (fl<= d2 81.0)
                             (let* ([d (flsqrt d2)]
                                    [pfly?
                                     (or (eq? (hash-ref pe 'flying #f) #t)
                                         (eq? (hash-ref pe 'flying? #f) #t)
                                         (eq? (hash-ref pe 'is-flying #f) #t)
                                         (fast-unit-is-flying-sym? (unit-type-sym pe)))]
                                    [pcliff-pen
                                     (if (and pfly?
                                              (eq? (hash-ref pe 'over-unpathable-airspace? #f) #t)
                                              (fl> d p-air-lim))
                                         80.0
                                         0.0)]
                                    [sc (fl+ (fl+ d (fl* 0.02 (exact->inexact (hash-ref pe 'hp 100.0)))) pcliff-pen)])
                               (if (fl< sc best-sc) (values pe sc) (values best best-sc)))
                             (values best best-sc))))))
              (define early-home-breach-tgt
                (and (not blink-hv-tgt)
                     (not peel-tgt)
                     p5-has-home-th?
                     (pair? p5-early-home-breachers)
                     (not (l34-solo-harass-exempt-unit? ctx u))
                     (real? x) (real? y)
                     (or (l34-within-r2? x y fbase-x fbase-y 676.0 26.0)
                         (l34-within-r2? x y fnat-x fnat-y 576.0 24.0))
                     (let* ([ust (fast-unit-combat-stats t)]
                            [ug (if (hash? ust) (exact->inexact (hash-ref ust 'ground-dps 0.0)) 0.0)]
                            [ua (if (hash? ust) (exact->inexact (hash-ref ust 'air-dps 0.0)) 0.0)]
                            [u-ground? (not (fast-unit-is-flying-sym? t))]
                            [u-air-lim (fl+ (if (hash? ust) (exact->inexact (hash-ref ust 'air-range 6.0)) 6.0) 1.0)])
                       (for/fold ([best #f] [best-sc +inf.0] #:result best)
                                 ([be (in-list p5-early-home-breachers)])
                         (define bfly?
                           (or (eq? (hash-ref be 'flying #f) #t)
                               (eq? (hash-ref be 'flying? #f) #t)
                               (eq? (hash-ref be 'is-flying #f) #t)
                               (fast-unit-is-flying-sym? (unit-type-sym be))))
                         (define hit? (if bfly? (fl> ua 0.0) (fl> ug 0.0)))
                         (if hit?
                             (let* ([bx0 (exact->inexact (hash-ref be 'x 9999.0))]
                                    [by0 (exact->inexact (hash-ref be 'y 9999.0))]
                                    ;; L43-P0-1d (`e03` Marine focus-fire on lowest-EHP Adept!):
                                    ;; Weight EHP strongly (`0.12*ehp + dist-to-unit`) so ALL early
                                    ;; defenders focus-fire the EXACT same injured breacher first!
                                    ;; L55-T1 (`#75`): Penalize (`+80.0`) unreachable cliff-decoy flyers!
                                    ;; L55-T12 (`#004`): Focus revealed Dark Templars (`-40.0`) ahead of Warp Prisms!
                                    [be-ehp (exact->inexact (unit-total-hp-and-shield be))]
                                    [du (fast-dist2d (exact->inexact x) (exact->inexact y) bx0 by0)]
                                    [dt-prio-adj (if (eq? (fast-canonical-unit-sym (unit-type-sym be)) 'dark-templar) -40.0 0.0)]
                                    [cliff-pen
                                     (if (and u-ground?
                                              bfly?
                                              (eq? (hash-ref be 'over-unpathable-airspace? #f) #t)
                                              (fl> du u-air-lim))
                                         80.0
                                         0.0)]
                                    [sc (fl+ (fl+ (fl+ (fl* 0.12 be-ehp) du) dt-prio-adj) cliff-pen)])
                               (if (fl< sc best-sc) (values be sc) (values best best-sc)))
                             (values best best-sc))))))
              (cond
                [blink-hv-tgt (values x y t blink-hv-tgt #t #t)]
                [peel-tgt (values x y t peel-tgt #t #t)]
                [early-home-breach-tgt (values x y t early-home-breach-tgt #t #t)]
                [(and unit-in-counter-wave? (null? p5-prepped-non-home-enemies))
                 (values x y t #f #f #f)]
                [else
                 (let-values ([(te ph?)
                               (select-target-enemy-from-prepped
                                x y
                                (if unit-in-counter-wave? p5-prepped-non-home-enemies prepped-eng-enemies)
                                t ally-has-stealth?)])
                   (values x y t te ph? #f))]))))

      ;; L33-P0-3 (`#58` fog-flicker Corruptor volley latch & `#18` isolated Phoenix/Colossus regroup)
      ;; + L36-P0-3 (`#31` Visual-QA Corruptor Dive vs Tempests)
      ;; + L39-P0-1f (`#72` Anti-Decoy Early Home Tether)
      ;; + L44-P0-1c (`#53` Counter-Wave Dispatch when `>= 50` supply faces `<= 6` light home harassers):
      ;; Evaluate staging BEFORE `(not target-enemy)` so fog-blind frames still hold lone Corruptors,
      ;; while ANY Corruptor group (`>= 4` Corruptors) caught inside Tempest fire range (`<= 16.5t`)
      ;; IMMEDIATELY DIVES inside `6t` weapon range via `(attack-unit uid cap-id)` instead of parking
      ;; passively at `10..15t` on the cliff edge eating free Tempest shots!
      (define pre-stage-handled?
        (and (not skip?)
             (cond
               [(and unit-in-counter-wave? (not target-enemy))
                (set-add! wave3-handled-tags uid)
                (cond
                  [(and (eq? ut 'siege-tank-sieged)
                        (>= (- frame (hash-ref splash-tank-dwell-ht uid -1000)) 48))
                   (hash-set! splash-tank-dwell-ht uid frame)
                   (l34-emit-preserved! ctx (list 'cast-spell uid 'unsiege-mode))]
                  [(memq ut '(siege-tank-sieged liberator-ag lurker-burrowed widow-mine-burrowed))
                   (void)]
                  [(not (l34-within-r2? ux uy (exact->inexact p5-counter-attack-tx) (exact->inexact p5-counter-attack-ty) 25.0 5.0))
                   (l34-emit-preserved! ctx (list 'attack-pos uid p5-counter-attack-tx p5-counter-attack-ty))])
                #t]
               [(and p5-has-home-th?
                     (null? p5-early-home-breachers)
