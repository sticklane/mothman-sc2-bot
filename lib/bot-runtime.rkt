  ;; Holistic Constraint-Narrowing Opponent World Model (`lib/opponent-world-model.rkt`):
  ;; Continuously integrates enemy base/geyser timelines, geyser depletion, dead tags,
  ;; tech DAG closure, happy-path deviation (`stopped-expanding?`), and summon windows!
  (define owm-inst (and rt (rt-opponent-world-model rt)))
  (define owm-live-eligible?
    (and owm-inst
         (or (eq? (hash-ref obs 'enable-opponent-world-model #f) #t)
             (and live-obs-harvesters?
                  (or (<= frame 128)
                      (>= (opponent-world-model-last-frame owm-inst) 0))))))
  (define owm-sum
    (and owm-live-eligible?
         (let ([prev-sum (opponent-world-model-last-summary owm-inst)])
           (if (and prev-sum
                    (= (opponent-world-model-last-frame owm-inst) frame)
                    (or (not (memq effective-enemy-race '(Protoss Terran Zerg)))
                        (eq? (opponent-world-summary-enemy-race prev-sum) effective-enemy-race)))
               prev-sum
               (step-opponent-world-model!
                owm-inst
                (hash-set* obs
                           'enemy-race effective-enemy-race
                           'enemy-exp-x enemy-exp-x
                           'enemy-exp-y enemy-exp-y))))))
  (define-values (raw-prox-sup distant-enemy-combat-supply)
    (if live-obs-harvesters?
        (for/fold ([prox 0.0] [dist-sup 0.0]) ([e (in-list rush-threat-enemies)])
          (define et (unit-type-sym e))
          (define min-d2 (l2-min-dist2-to-owned-base ctx (hash-ref e 'x fbx) (hash-ref e 'y fby)))
          (define base-sup
            (if (and rush-worker-swarm? (memq et '(probe scv drone)))
                1.5
                (unit-supply-cost et)))
          (if (<= min-d2 3025.0)
              (let* ([d (sqrt min-d2)]
                     [u (/ (max 0.0 (- d 28.0)) 18.0)]
                     [w (/ 1.0 (+ 1.0 (* u u)))])
                (values (+ prox (* w base-sup)) dist-sup))
              (values prox (+ dist-sup (unit-supply-cost et)))))
        (let ([prox (for/sum ([e (in-list rush-threat-enemies)])
                      (define et (unit-type-sym e))
                      (if (and rush-worker-swarm? (memq et '(probe scv drone)))
                          1.5
                          (unit-supply-cost et)))])
          (values prox 0))))
  (define proximate-enemy-threat-supply
    (+ proxy-structure-threat-supply (exact-round raw-prox-sup)))
  (define enemy-prod-bldg-cnt
    (for/sum ([eb (in-list enemy-bldgs)])
      (if (memq (unit-type-sym eb)
                '(barracks factory starport gateway warp-gate robotics-facility stargate
                  roach-warren hydralisk-den baneling-nest spire))
