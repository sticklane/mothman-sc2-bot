             (equal? bldg-types-l2 (vector-ref tbc-cache 0))
             (equal? morph-types-l2 (vector-ref tbc-cache 1)))
        (vector-ref tbc-cache 2)
        (let ([mht (make-hasheq)])
          (for ([t (in-list bldg-types-l2)])
