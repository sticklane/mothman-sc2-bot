                       (case (hash-ref b 'order-ability-id 0)
                         [(1516) 'orbital-command]
                         [(1450) 'planetary-fortress]
                         [(1216) 'lair]
                         [(1218) 'hive]
                         [(1220) 'greater-spire]
                         [(2112) 'lurker-den]
                         [else #f]))]
               #:when (and ms
