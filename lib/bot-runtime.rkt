            (not crisis-tech-upgrade-deferral?)
            (not urgent-combat-or-intel-need?)
            (<= live-enemy-threat-supply 6.0)
            (or (and terran-saving-for-orbital?
                     (l2-imminent-escrow-needed? ctx (sc2-min-cost 'orbital-command) 0))
