                (findf (lambda (b)
                         (<= (dist2d nat-x nat-y
                                     (hash-ref b 'x -999.0)
                                     (hash-ref b 'y -999.0))
                             22.0))
                       ready-pylons))
           (and (not worker-rush-active?)
