       (for ([q (in-list (take q-ranked home-reserved-queen-cap))])
         (set-add! home-reserved-queen-ids (hash-ref q 'id 120))))
  (define (clamp-target-near-th tx ty hx hy max-r)
       (define dx (- (exact->inexact tx) (exact->inexact hx)))
       (define dy (- (exact->inexact ty) (exact->inexact hy)))
       (define d (sqrt (+ (* dx dx) (* dy dy))))
       (if (<= d max-r)
           (values tx ty)
           (values (safe-coord (+ hx (* max-r (/ dx (max 1.0 d)))) hx)
                   (safe-coord (+ hy (* max-r (/ dy (max 1.0 d)))) hy))))
  (define (queen-dispatch-creep-tumor! q #:surplus-pass? [surplus-pass? #f])
       (define qid (hash-ref q 'id 120))
       (define qx (hash-ref q 'x base-x))
       (define qy (hash-ref q 'y base-y))
       (define fqx (exact->inexact qx))
       (define fqy (exact->inexact qy))
       (define fex (exact->inexact enemy-x))
       (define fey (exact->inexact enemy-y))
       (define home-reserved? (set-member? home-reserved-queen-ids qid))
       (define-values (nth-x nth-y q->th-dist) (queen-nearest-th-dist fqx fqy))
       (cond
         [(and live-game? home-reserved? (> q->th-dist 35.0)
               (not (queen-close-combat? q 256.0)))
          ;; Recall inject/creep Queens that strayed >35 tiles from nearest Town Hall safely home
          ;; (W5-TAC-2: NEVER recall frontline Queens when enemy combat is within <= 16t!)
          (when (refractory-allow-action?! cd-tracker (list 'queen-home-recall qid) frame 16)
            (set-add! used-queen-ids qid)
            (acquire-unit-lease! leases qid 'inject-queen frame 16 #:x nth-x #:y nth-y)
            (l2-emit! ctx (list 'move qid (safe-coord nth-x base-x) (safe-coord nth-y base-y))))]
         [(and live-game? (> q->th-dist 20.0) (queen-close-combat? q 256.0))
          ;; Frontline combat Queen near active battle (<=16t): skip L2 creep-tumor so L34 fights & transfuses!
          (void)]
         [else
          (define att-key (list 'queen-att qid))
          (define att-idx (hash-ref tumor-state-ht att-key 0))
          (define th0
            (and (pair? inject-hatcheries)
                 (let ([best #f] [best-d2 +inf.0])
                   (for ([h (in-list inject-hatcheries)])
                     (define dx (fl- fqx (exact->inexact (hash-ref h 'x base-x))))
                     (define dy (fl- fqy (exact->inexact (hash-ref h 'y base-y))))
                     (define d2 (fl+ (fl* dx dx) (fl* dy dy)))
                     (when (fl< d2 best-d2)
                       (set! best h)
                       (set! best-d2 d2)))
                   best)))
          (define local-tumor
            (and (pair? all-ally-tumors)
                 (let ([best #f] [best-ed2 +inf.0])
                   (for ([t (in-list all-ally-tumors)])
                     (define tx (exact->inexact (hash-ref t 'x base-x)))
                     (define ty (exact->inexact (hash-ref t 'y base-y)))
                     (define dx (fl- fqx tx))
                     (define dy (fl- fqy ty))
                     (define tumor-near-th?
                       (or (not live-game?)
                           (not home-reserved?)
                           (let-values ([(_hx _hy td) (queen-nearest-th-dist tx ty)])
                             (<= td 22.0))))
                     (when (and tumor-near-th? (fl<= (fl+ (fl* dx dx) (fl* dy dy)) 256.0))
                       (define edx (fl- fex tx))
                       (define edy (fl- fey ty))
                       (define ed2 (fl+ (fl* edx edx) (fl* edy edy)))
                       (when (fl< ed2 best-ed2)
                         (set! best t)
                         (set! best-ed2 ed2))))
                   best)))
          (define-values (raw-tx raw-ty)
            (cond
              [(and (not live-game?) surplus-pass?)
               (define hx (if th0 (hash-ref th0 'x base-x) base-x))
               (define hy (if th0 (hash-ref th0 'y base-y) base-y))
               (define hdx (- nat-x hx))
               (define hdy (- nat-y hy))
               (define hd (max 1.0 (sqrt (+ (* hdx hdx) (* hdy hdy)))))
               (nudge-off-expansion-pads (+ hx (* 3.5 (/ hdx hd)))
                                         (+ hy (* 3.5 (/ hdy hd)))
                                         4.5)]
              [local-tumor
               (next-creep-highway-target (hash-ref local-tumor 'x qx)
                                          (hash-ref local-tumor 'y qy)
                                          6.0
                                          att-idx)]
              [th0
               (define hx (hash-ref th0 'x base-x))
               (define hy (hash-ref th0 'y base-y))
               (define d-qh (dist2d qx qy hx hy))
               (if (<= d-qh 18.0)
                   ;; Place outside the 4.5-tile pad exclusion box along the creep highway
                   (next-creep-highway-target hx hy 6.2 att-idx)
                   (if (and live-game? home-reserved?)
                       (next-creep-highway-target hx hy 6.2 att-idx)
                       (next-creep-highway-target qx qy 5.5 att-idx)))]
              [else
               (next-creep-highway-target qx qy 5.5 att-idx)]))
          (define-values (clamped-tx clamped-ty)
            (if (and live-game? home-reserved?)
                (clamp-target-near-th raw-tx raw-ty nth-x nth-y 20.5)
                (values raw-tx raw-ty)))
          ;; Re-enforce canonical expansion `3.6t` box clearance AFTER TH clamping!
          (define-values (tx ty)
            (nudge-off-expansion-pads clamped-tx clamped-ty 5.25))
          (define-values (_thx _thy target->th-dist)
            (queen-nearest-th-dist tx ty))
          (define q->target-d (dist2d qx qy tx ty))
          (cond
            [(and live-game? (> q->target-d 12.0))
             (when (and (or (not home-reserved?) (<= target->th-dist 22.0))
                        (refractory-allow-action?! cd-tracker (list 'queen-tumor-walk qid) frame 16))
               (define vdx (- tx qx))
               (define vdy (- ty qy))
               (define vd (max 1.0 (sqrt (+ (* vdx vdx) (* vdy vdy)))))
               (define raw-mx (safe-coord (- tx (* 2.0 (/ vdx vd))) tx))
               (define raw-my (safe-coord (- ty (* 2.0 (/ vdy vd))) ty))
               (define-values (mx my)
                 (if home-reserved?
                     (clamp-target-near-th raw-mx raw-my nth-x nth-y 22.0)
                     (values raw-mx raw-my)))
               (set-add! used-queen-ids qid)
               (acquire-unit-lease! leases qid 'creep-queen frame 16 #:x mx #:y my)
               (l2-emit! ctx (list 'move qid mx my)))]
            [(and (or (not live-game?) (not home-reserved?) (<= target->th-dist 22.0))
                  (refractory-allow-action?! cd-tracker
                                             (list 'queen-tumor qid)
                                             frame
                                             (if live-game? 44 SC2-CREEP-TUMOR-COOLDOWN-FRAMES)))
             (hash-set! tumor-state-ht att-key (add1 att-idx))
             (set-add! used-queen-ids qid)
             (acquire-unit-lease! leases qid 'creep-queen frame (if live-game? 16 24) #:x tx #:y ty)
             (l2-emit! ctx (list 'cast-spell qid 'spawn-creep-tumor tx ty))
             (order-ledger-record-issued! oledger qid 'cast-spell 'spawn-creep-tumor tx ty frame)])]))
  (define base-inject-queen-ids (mutable-seteqv))
  (define dedicated-creeping-queen-ids (mutable-seteqv))
  (define all-ready-hatches-injected? (null? uninjected-hatches))
  (define ready-hatch-count (length ready-hatcheries))
  (set-l2-ctx-ready-hatch-count! ctx ready-hatch-count)
  (when (pair? queens)
       (define claimed-hids (mutable-seteqv))
       (define (claim-nearest-inject-queen-for-hatch! h)
         (when (< (set-count base-inject-queen-ids) ready-hatch-count)
           (define hid (hash-ref h 'id 101))
           (unless (set-member? claimed-hids hid)
             (define hx (exact->inexact (hash-ref h 'x base-x)))
             (define hy (exact->inexact (hash-ref h 'y base-y)))
             (define best-q #f)
             (define best-d2 +inf.0)
             (for ([q (in-list queens)])
               (define qid (hash-ref q 'id 120))
               (unless (or (set-member? base-inject-queen-ids qid)
                           (and (queen-protected-order? q)
                                (let ([ab (hash-ref q 'order-ability-sym #f)]
                                      [ab-id (hash-ref q 'order-ability-id 0)])
                                  (or (memq ab '(spawn-creep-tumor spread-creep-tumor))
                                      (= ab-id 3691)
                                      (= ab-id 1694)))))
                 (define qx (exact->inexact (hash-ref q 'x base-x)))
                 (define qy (exact->inexact (hash-ref q 'y base-y)))
                 (define dx (fl- qx hx))
                 (define dy (fl- qy hy))
                 (define d2 (fl+ (fl* dx dx) (fl* dy dy)))
                 (when (fl< d2 best-d2)
                   (set! best-q q)
                   (set! best-d2 d2))))
             (when best-q
               (set-add! claimed-hids hid)
               (set-add! base-inject-queen-ids (hash-ref best-q 'id 120))))))
       (when (> ready-hatch-count 0)
         (for ([h (in-list uninjected-hatches)])
           (claim-nearest-inject-queen-for-hatch! h))
         (for ([h (in-list ready-hatcheries)])
           (claim-nearest-inject-queen-for-hatch! h)))
       (for ([q (in-list queens)])
         (define qid (hash-ref q 'id 120))
         (unless (set-member? base-inject-queen-ids qid)
           (set-add! dedicated-creeping-queen-ids qid)))
       (when (and (= (set-count dedicated-creeping-queen-ids) 0)
                  (not creep-self-sustaining?)
                  (or all-ready-hatches-injected?
                      (and (null? active-creep-tumors)
                           (>= frame 2400)
                           (pair? (cdr queens)))))
         (define promo-q
           (or (for/first ([q (in-list queens)]
                           #:when (let ([qid (hash-ref q 'id 120)])
                                    (and (not (set-member? used-queen-ids qid))
                                         (>= (hash-ref q 'energy (if live-game? 0 SC2-QUEEN-INJECT-ENERGY))
                                             SC2-QUEEN-INJECT-ENERGY)
                                         (not (queen-close-combat? q)))))
                 q)
               (car queens)))
         (set-add! dedicated-creeping-queen-ids (hash-ref promo-q 'id 120))))
  (define zero-tumors-2plus-queens?
       (and (null? active-creep-tumors) (pair? queens) (pair? (cdr queens))))
  (define base-inject-catchup-tumor-ok?
       (and (not creep-self-sustaining?)
            (null? active-creep-tumors)
            (>= frame 2200)
            (or all-ready-hatches-injected?
                (>= (length queens) (length inject-hatcheries)))))
  ;; W3-TAC-6 + Loop 64 B3 (`#1755` Graph 20 Queen Transfuse Pivot): Exempt Queens with >= 50 energy
  ;; within <= 14t (>= 4:00 / under pressure) or <= 10t (< 4:00) of an injured high-value ally
  ;; (< 70% HP or >= 60 missing HP) from L2 inject/creep so L34 Transfuse (1664) fires like Pros!
  (define l2-transfuse-targets
    (append
     (for/list ([a (in-list (l2-ctx-ally-units ctx))]
                #:when (and (hash? a)
                            (let* ([hp (hash-ref a 'hp #f)]
                                   [mhp (or (hash-ref a 'max-hp #f) (hash-ref a 'hp-max #f))])
                              (and (real? hp) (real? mhp) (>= mhp 120.0)
                                   (or (< hp (* 0.70 mhp))
                                       (>= (- mhp hp) 60.0))
                                   (>= (- mhp hp) 50.0)
                                   (real? (hash-ref a 'x #f))
                                   (real? (hash-ref a 'y #f))))))
       (vector (hash-ref a 'id -1)
               (exact->inexact (hash-ref a 'x 0.0))
               (exact->inexact (hash-ref a 'y 0.0))))
     (for/list ([b (in-list (l2-ctx-ally-bldgs ctx))]
                #:when (and (hash? b)
                            (memq (fast-canonical-structure-sym (unit-type-sym b))
                                  '(hatchery lair hive spine-crawler spore-crawler))
                            (let* ([hp (hash-ref b 'hp #f)]
                                   [mhp (or (hash-ref b 'max-hp #f) (hash-ref b 'hp-max #f))])
                              (and (real? hp) (real? mhp) (> mhp 0.0)
                                   (< hp (* 0.70 mhp))
                                   (>= (- mhp hp) 60.0)
                                   (real? (hash-ref b 'x #f))
                                   (real? (hash-ref b 'y #f))))))
       (vector (hash-ref b 'id -1)
               (exact->inexact (hash-ref b 'x 0.0))
               (exact->inexact (hash-ref b 'y 0.0))))))
  (define l2-transfuse-r2
    (if (or (>= frame 5376)
            (l2-ctx-under-base-attack? ctx)
            (> (l2-ctx-live-enemy-threat-supply ctx) 0))
        196.0
        100.0))
  (define (queen-has-urgent-transfuse-target? q)
    (and (pair? l2-transfuse-targets)
         (>= (hash-ref q 'energy 0) 50)
         (let ([qid (hash-ref q 'id -1)]
               [qx (hash-ref q 'x #f)]
               [qy (hash-ref q 'y #f)])
           (and (real? qx) (real? qy)
                (let ([fqx (exact->inexact qx)]
                      [fqy (exact->inexact qy)])
                  (for/or ([tv (in-list l2-transfuse-targets)])
                    (and (not (eqv? (vector-ref tv 0) qid))
                         (let ([dx (fl- fqx (vector-ref tv 1))]
                               [dy (fl- fqy (vector-ref tv 2))])
                           (fl<= (fl+ (fl* dx dx) (fl* dy dy)) l2-transfuse-r2)))))))))
  (define pass1-dispatched-emergency-tumor? #f)
  (for ([q (in-list queens)]
           #:when (and (not (set-member? used-queen-ids (hash-ref q 'id 120)))
                       (not (queen-close-combat? q))
                       (not (queen-has-urgent-transfuse-target? q))))
       (define qid (hash-ref q 'id 120))
       (define q-energy (hash-ref q 'energy (if live-game? 0 SC2-QUEEN-INJECT-ENERGY)))
       (define dedicated-creeper? (set-member? dedicated-creeping-queen-ids qid))
       (define can-creep-at-25?
         (or dedicated-creeper?
             (and (not creep-self-sustaining?) all-ready-hatches-injected?)
             (and (not pass1-dispatched-emergency-tumor?)
                  (or zero-tumors-2plus-queens? base-inject-catchup-tumor-ok?))))
       (define req-energy
         (if can-creep-at-25?
             SC2-QUEEN-INJECT-ENERGY
             SC2-QUEEN-TUMOR-SURPLUS-ENERGY))
       (when (>= q-energy req-energy)
         (queen-dispatch-creep-tumor! q #:surplus-pass? (>= q-energy SC2-QUEEN-TUMOR-SURPLUS-ENERGY))
         (when (and (not dedicated-creeper?)
                    (set-member? used-queen-ids qid))
           (set! pass1-dispatched-emergency-tumor? #t))))
  (fast-dispatch-macro-energy!
      queens
      uninjected-hatches
      frame
      claimed-inject-hatch-ids
      #:min-energy SC2-QUEEN-INJECT-ENERGY
      #:valid-caster?
      (lambda (q)
        (and (not (set-member? used-queen-ids (hash-ref q 'id 120)))
             ;; L41-P0-1d (`e02` Queen vs 2 Reapers): Do not lock a sole defending Queen in
             ;; protected `inject-larva (251)` while enemy combat raids within <= 10t!
             (not (queen-close-combat? q 100.0))
             (not (queen-has-urgent-transfuse-target? q))))
      #:valid-pair?
      (lambda (q h)
        (or (not live-game?)
            (<= (dist2d (hash-ref q 'x base-x) (hash-ref q 'y base-y)
                        (hash-ref h 'x base-x) (hash-ref h 'y base-y))
                18.0)))
      #:score-pair
      (lambda (q h)
        (- (dist2d (hash-ref q 'x base-x) (hash-ref q 'y base-y)
                   (hash-ref h 'x base-x) (hash-ref h 'y base-y))))
      #:emit-cast!
      (lambda (q h)
        (define qid (hash-ref q 'id 120))
        (define hid (hash-ref h 'id 101))
        (define hx (hash-ref h 'x base-x))
        (define hy (hash-ref h 'y base-y))
        (set-add! used-queen-ids qid)
        (set-add! claimed-inject-hatch-ids hid)
        (acquire-unit-lease! leases qid 'inject-queen frame 24
                             #:target-id hid #:x hx #:y hy)
        (l2-emit! ctx (list 'cast-spell qid 'inject-larva hid))
        (order-ledger-record-issued! oledger qid 'cast-spell 'inject-larva hx hy frame)))
  (for ([h (in-list uninjected-hatches)]
           #:when (not (set-member? claimed-inject-hatch-ids (hash-ref h 'id 101))))
       (define hid (hash-ref h 'id 101))
       (define hx (exact->inexact (hash-ref h 'x base-x)))
       (define hy (exact->inexact (hash-ref h 'y base-y)))
       (define-values (guard-q _guard-d2)
         (for/fold ([best #f] [best-d2 +inf.0]) ([q (in-list queens)])
           (define qid (hash-ref q 'id 120))
           (if (and (not (set-member? used-queen-ids qid))
                    (not (queen-has-urgent-transfuse-target? q))
                    (or (not (set-member? dedicated-creeping-queen-ids qid))
                        (<= (length queens) ready-hatch-count))
                    (< (hash-ref q 'energy 0) SC2-QUEEN-TUMOR-SURPLUS-ENERGY))
               (let* ([dx (fl- hx (exact->inexact (hash-ref q 'x base-x)))]
                      [dy (fl- hy (exact->inexact (hash-ref q 'y base-y)))]
                      [d2 (fl+ (fl* dx dx) (fl* dy dy))])
                 (if (and (fl<= d2 196.0) (fl< d2 best-d2))
                     (values q d2)
                     (values best best-d2)))
               (values best best-d2))))
       (when guard-q
         (define gqid (hash-ref guard-q 'id 120))
         (set-add! used-queen-ids gqid)
         (set-add! claimed-inject-hatch-ids hid)
         (acquire-unit-lease! leases gqid 'inject-queen frame 24
                              #:target-id hid #:x hx #:y hy)))
  (for ([q (in-list queens)]
           #:when (and (not (set-member? used-queen-ids (hash-ref q 'id 120)))
                       (>= (hash-ref q 'energy 0) SC2-QUEEN-INJECT-ENERGY)
                       (not (queen-close-combat? q))
                       (not (queen-has-urgent-transfuse-target? q))))
       (queen-dispatch-creep-tumor! q #:surplus-pass? #f))
  (define max-tumor-attempts (if live-game? 8 4))
  (define used-tumors-set (live-bot-runtime-used-creep-tumors rt))
  (define mature-ready-tumors
       (let ([rev '()])
         (for ([u (in-list ready-spread-tumors)])
           (define tid (hash-ref u 'id 0))
           (unless (set-member? used-tumors-set tid)
             (define st (hash-ref tumor-state-ht tid #f))
             (cond
               [(not st)
                ;; Loop 64 P0 #6: LotV Creep Tumor spread cooldown is 240f (10.71s); wait 264f (11.8s)
                ;; instead of 232f so the first spread attempt never fires 8f before maturity!
                (define init-ready-f (if live-game? (+ frame 264) frame))
                (define new-st (hash 'mature-frame init-ready-f 'attempts 0 'next-try init-ready-f))
