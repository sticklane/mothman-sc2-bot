         (and live-game?
              did
              (<= (- frame since-f) 224)
              (<= live-enemy-threat-supply 6.0)
              (>= frame SC2-TERRAN-FIRST-ADDON-SWAP-FRAME)
              did)))
  (when held-swap-donor-id
