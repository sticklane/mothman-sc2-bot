        visible-enemy-threat-supply
        (max visible-enemy-threat-supply implied-prod-threat-supply)))
  (define-values (remembered-enemy-threat-supply remembered-enemy-threat-frame)
    (cond
      [(> cur-visible-or-implied-threat 0)
