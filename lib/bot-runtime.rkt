                (or (memq 'cybernetics-core (l2-ctx-bldg-types ctx))
                    (>= (l2-ctx-minerals ctx) SC2-SURPLUS-MINERAL-BANK-THRESHOLD))
                (>= (- (l2-ctx-minerals ctx)
                       protoss-nat-reserve
                       (if protoss-holding-forge-min? (sc2-min-cost 'forge) 0))
                    (sc2-min-cost 'gateway))
                (l2-non-combat-min-ok? ctx (sc2-min-cost 'gateway) 'gateway))
       (define gw-idx (length gateways))
       (if (and allow-exact-wall-slot?
                (not worker-rush-active?)
                (not in-base-proxy-detected?)
                (< frame 2600)
                (< cur-escrow-age-frames 64)
                (<= (length nexuses) 2)
                (= gw-idx 1)
                (l2-wall-slot-powered? ctx wall-slot-3))
           (l2-emit-build-verified! ctx 'gateway
                                 (safe-coord (car wall-slot-3) (+ base-x 7.5))
                                 (safe-coord (cdr wall-slot-3) (+ base-y 4.0))
                                 SC2-BUILD-SITE-MIN-CLEARANCE
                                 #:exact-wall-slot? #t)
           (l2-emit-build-verified! ctx 'gateway
                                 (safe-coord (+ base-x 4.0 (* 3.5 (modulo gw-idx 3))))
                                 (safe-coord (+ base-y 4.0 (* 3.5 (quotient gw-idx 3)))))))
  (define cur-forge-cnt (l2-building-present-or-pending-count ctx 'forge))
  (define desired-forge-cnt
    (if (and live-game?
             (not under-base-attack?)
             (not early-survival-crisis?)
             (>= (length nexuses) 2)
             (>= eff-phase-supply 62)
             (memq 'forge ready-bldg-types)
             (or (memq 'twilight-council ready-bldg-types)
                 (>= (length nexuses) 3)
                 (>= (l2-ctx-minerals ctx) 450)))
        2
        1))
  (when (and (or (memq 'robotics-facility ready-bldg-types)
                    (memq 'twilight-council ready-bldg-types)
                    (and (memq 'cybernetics-core ready-bldg-types)
                         (or (enemy-tech-observation-requires-detection? tech-obs)
                             (l2-plan-wants-now? ctx 'forge)
                             (eq? bo-goal-sym 'forge)
                             (eq? prio-saving-for-sym 'forge)
                             (member '(build forge) prio-scheduled-actions)
                             (>= active-bases 2))))
                (or (enemy-tech-observation-requires-detection? tech-obs)
                    (not early-survival-crisis?))
                (not protoss-saving-for-expand?)
                (or (enemy-tech-observation-requires-detection? tech-obs)
                    (l2-protoss-colossus-escrow-ok? ctx (sc2-min-cost 'forge) 0))
                (or (enemy-tech-observation-requires-detection? tech-obs)
                    (l2-plan-wants-now? ctx 'forge)
                    (eq? bo-goal-sym 'forge)
                    (eq? prio-saving-for-sym 'forge)
                    (member '(build forge) prio-scheduled-actions)
                    (l2-can-spend-by-priority? ctx 'forge 'tech-upgrade))
                (< cur-forge-cnt desired-forge-cnt)
                (l2-save-cancel-rebuild-ready? ctx 'forge 60)
                (or (enemy-tech-observation-requires-detection? tech-obs)
                    (l2-plan-wants-now? ctx 'forge)
                    (eq? bo-goal-sym 'forge)
                    (eq? prio-saving-for-sym 'forge)
                    (member '(build forge) prio-scheduled-actions)
                    (>= (length nexuses) SC2-MIN-DESIRED-BASES))
                (or (not live-game?)
                    (enemy-tech-observation-requires-detection? tech-obs)
                    (l2-plan-wants-now? ctx 'forge)
                    (eq? bo-goal-sym 'forge)
                    (eq? prio-saving-for-sym 'forge)
                    (member '(build forge) prio-scheduled-actions)
                    (>= eff-phase-supply 46))
                (>= (l2-ctx-minerals ctx) (sc2-min-cost 'forge))
                (l2-non-combat-min-ok? ctx (sc2-min-cost 'forge) 'forge))
       (l2-emit-build-verified! ctx 'forge
                                 (safe-coord (+ base-x (if (= cur-forge-cnt 0) 5.0 8.5)))
                                 (safe-coord (- base-y 4.0))))
  (define cur-pc-cnt
       (+ (count (lambda (b) (eq? (fast-canonical-structure-sym (unit-type-sym b)) 'photon-cannon)) ally-bldgs)
          (order-ledger-pending-count-for-type oledger 'photon-cannon frame)))
  (define prio-wants-pc?
       (or (eq? (l2-ctx-prio-saving-for-sym ctx) 'photon-cannon)
           (let ([md (l2-ctx-macro-decision ctx)])
             (and (macro-brain-decision? md)
                  (not (not (memq 'photon-cannon (macro-brain-decision-scheduled-ids md))))))))
  (define desired-pc-cnt
       (if (and live-game? (or enemy-air-raiders? protoss-aa-needed? prio-wants-pc?))
           (min 2 (max 1 (length nexuses)))
           1))
  (when (and (memq 'forge ready-bldg-types)
                (or (enemy-tech-observation-requires-detection? tech-obs)
                    prio-wants-pc?
                    (l2-plan-wants-now? ctx 'photon-cannon)
                    (and live-game? (or enemy-air-raiders? protoss-aa-needed?)))
                (< cur-pc-cnt desired-pc-cnt)
                (l2-save-cancel-rebuild-ready? ctx 'photon-cannon 60)
                (>= (l2-ctx-minerals ctx) (sc2-min-cost 'photon-cannon))
                (refractory-allow-action?! cd-tracker
                                           (list 'static-detector 'photon-cannon)
                                           frame
                                           SC2-STATIC-DETECTOR-COOLDOWN-FRAMES))
       (define main-has-pc?
         (ormap (lambda (b)
                  (and (hash? b)
                       (eq? (fast-canonical-structure-sym (unit-type-sym b)) 'photon-cannon)
                       (<= (dist2d base-x base-y (hash-ref b 'x -999.0) (hash-ref b 'y -999.0)) 12.0)))
                ally-bldgs))
       (define nat-has-pc?
         (ormap (lambda (b)
                  (and (hash? b)
                       (eq? (fast-canonical-structure-sym (unit-type-sym b)) 'photon-cannon)
                       (<= (dist2d nat-x nat-y (hash-ref b 'x -999.0) (hash-ref b 'y -999.0)) 12.0)))
                ally-bldgs))
       (define-values (pc-x pc-y)
         (if (and live-game?
                  (or enemy-air-raiders? protoss-aa-needed?)
                  (not main-has-pc?)
                  (or (<= (length nexuses) 1) nat-has-pc?))
             (let* ([px (if first-ready-pylon (hash-ref first-ready-pylon 'x (+ base-x 4.5)) (+ base-x 4.5))]
                    [py (if first-ready-pylon (hash-ref first-ready-pylon 'y (+ base-y 2.5)) (+ base-y 2.5))])
               (values (safe-coord (+ px 2.5) base-x) (safe-coord (- py 2.5) base-y)))
             (l2-offset-defense-anchor ctx nat-x nat-y 5.5)))
       (l2-emit-build-verified! ctx 'photon-cannon pc-x pc-y 2.0)))

