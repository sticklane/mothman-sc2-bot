         [(and live-game? protoss-cloak-det-emergency?)
          (min 3 (max 1 (length nexuses)))]
         [(and live-game? (or enemy-air-raiders? protoss-aa-needed? prio-wants-pc?))
          (min 2 (max 1 (length nexuses)))]
         [else 1]))
  (when (and (memq 'forge ready-bldg-types)
                (or protoss-cloak-det-emergency?
                    (enemy-tech-observation-requires-detection? tech-obs)
                    prio-wants-pc?
                    (l2-plan-wants-now? ctx 'photon-cannon)
                    (and live-game? (or enemy-air-raiders? protoss-aa-needed?)))
                (< cur-pc-cnt desired-pc-cnt)
                (l2-save-cancel-rebuild-ready? ctx 'photon-cannon 60)
                (>= (l2-ctx-minerals ctx) (sc2-min-cost 'photon-cannon))
                (refractory-allow-action?! cd-tracker
                                           (list 'static-detector 'photon-cannon)
                                           frame
                                           (if (and protoss-cloak-det-emergency? (= cur-pc-cnt 0))
                                               44
                                               SC2-STATIC-DETECTOR-COOLDOWN-FRAMES)))
       (define main-has-pc?
         (ormap (lambda (b)
                  (and (hash? b)
                       (eq? (fast-canonical-structure-sym (unit-type-sym b)) 'photon-cannon)
                       (<= (dist2d base-x base-y (hash-ref b 'x -999.0) (hash-ref b 'y -999.0)) 12.0)))
                ally-bldgs))
       (define nat-has-pc?
         (ormap (lambda (b)
                  (and (hash? b)
                       (eq? (fast-canonical-structure-sym (unit-type-sym b)) 'photon-cannon)
                       (<= (dist2d nat-x nat-y (hash-ref b 'x -999.0) (hash-ref b 'y -999.0)) 12.0)))
                ally-bldgs))
       (define-values (pc-x pc-y)
         (if (and live-game?
                  (or protoss-cloak-det-emergency? enemy-air-raiders? protoss-aa-needed?)
                  (not main-has-pc?)
                  (or (<= (length nexuses) 1) nat-has-pc?))
             (let* ([px (if first-ready-pylon (hash-ref first-ready-pylon 'x (+ base-x 4.5)) (+ base-x 4.5))]
                    [py (if first-ready-pylon (hash-ref first-ready-pylon 'y (+ base-y 2.5)) (+ base-y 2.5))])
               (values (safe-coord (+ px 2.5) base-x) (safe-coord (- py 2.5) base-y)))
             (l2-offset-defense-anchor ctx nat-x nat-y 5.5)))
       (l2-emit-build-verified! ctx 'photon-cannon pc-x pc-y 2.0)))

(define (l2-protoss-phase3-upgrades-units! ctx)
  (define ally-combat-units (l2-ctx-ally-combat-units ctx))
  (define ally-units (l2-ctx-ally-units ctx))
  (define base-x (l2-ctx-base-x ctx))
  (define base-y (l2-ctx-base-y ctx))
  (define blocked-nat-expanded-early? (l2-ctx-blocked-nat-expanded-early? ctx))
  (define bo-goal-sym (l2-ctx-bo-goal-sym ctx))
  (define cd-tracker (l2-ctx-cd-tracker ctx))
  (define crisis-freeze-workers? (l2-ctx-crisis-freeze-workers? ctx))
  (define crisis-tech-upgrade-deferral? (l2-ctx-crisis-tech-upgrade-deferral? ctx))
  (define cur-escrow-age-frames (l2-ctx-cur-escrow-age-frames ctx))
