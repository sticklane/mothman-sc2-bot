                            (exact->inexact (hash-ref first-ready-pylon 'x base-x))
                            (exact->inexact (hash-ref first-ready-pylon 'y base-y)))
        (l2-interior-offset ctx 5.0 0.0)))
  (define gateway-wall-fallback?
       (let ([tbl (and (refractory-cooldown-tracker? cd-tracker)
                       (refractory-cooldown-tracker-table cd-tracker))])
         (when (and (null? gateways) live-game-obs? (hash? tbl))
           (define lock-entry (hash-ref tbl '(build-issue-lock gateway) #f))
           (when (pair? lock-entry)
             (define last-issue-f (car lock-entry))
             (define last-issue-cnt (cadr lock-entry))
             (define last-wall-f (hash-ref tbl '(build-issue-exact-wall gateway) -9999))
             (define wall-attempt? (= last-wall-f last-issue-f))
             (when (and (> frame last-issue-f)
                        (= (l2-cur-ally-canon-bldg-count ctx 'gateway) last-issue-cnt)
                        (= (order-ledger-pending-count-for-type oledger 'gateway frame) 0)
                        (or (and wall-attempt? power-placement-failed?)
                            (>= (- frame last-issue-f) 16)))
               (hash-remove! tbl '(build-issue-lock gateway))
               (hash-set! tbl '(gateway-wall-fallback gateway) frame))))
         (let ([fb-f (and (hash? tbl) (hash-ref tbl '(gateway-wall-fallback gateway) #f))])
           (and (exact-integer? fb-f)
                (<= 0 (- frame fb-f))
                (< (- frame fb-f) 64)))))
  (when (and (null? gateways)
                (or (not live-game-obs?)
                    (not (not first-ready-pylon))
                    (and (not worker-rush-active?)
                         (not in-base-proxy-detected?)
                         (l2-wall-slot-powered? ctx wall-slot-1)))
                (not (l2-building-present-or-pending? ctx 'gateway))
                (l2-save-cancel-rebuild-ready? ctx 'gateway 60)
                (>= (l2-ctx-minerals ctx) (sc2-min-cost 'gateway))
                (>= (- (l2-ctx-minerals ctx) (sc2-min-cost 'gateway)) hard-supply-lockout-reserve-min))
       (if (and allow-exact-wall-slot?
                (not gateway-wall-fallback?)
                (not worker-rush-active?)
                (not in-base-proxy-detected?)
                (not early-survival-crisis?)
                (not under-base-attack?)
                (< frame 2200)
                (< cur-escrow-age-frames 64)
                (<= (length nexuses) 2)
                (l2-wall-slot-powered? ctx wall-slot-1))
           (l2-emit-build-verified! ctx 'gateway
                                 (safe-coord (car wall-slot-1) inmain-powered-gx)
                                 (safe-coord (cdr wall-slot-1) inmain-powered-gy)
                                 SC2-BUILD-SITE-MIN-CLEARANCE
                                 #:exact-wall-slot? #t)
           (l2-emit-build-verified! ctx 'gateway inmain-powered-gx inmain-powered-gy)))
  (define protoss-aa-needed?
       (enemy-tech-observation-requires-anti-air? tech-obs))
  (set-l2-ctx-protoss-aa-needed?! ctx protoss-aa-needed?)
  (define enemy-muta-cnt-p
       (count (lambda (e) (eq? (unit-type-sym e) 'mutalisk)) enemy-units))
  (set-l2-ctx-enemy-muta-cnt-p! ctx enemy-muta-cnt-p)
  (define enemy-air-raiders?
       (ormap (lambda (e)
                (memq (fast-canonical-unit-sym (unit-type-sym e))
                      '(mutalisk oracle banshee)))
              enemy-units))
  (set-l2-ctx-enemy-air-raiders?! ctx enemy-air-raiders?)
  (define cur-sb-cnt
       (+ (count (lambda (b) (eq? (fast-canonical-structure-sym (unit-type-sym b)) 'shield-battery)) ally-bldgs)
          (order-ledger-pending-count-for-type oledger 'shield-battery frame)))
  (define desired-sb-cnt
       (cond
         [crisis-tech-upgrade-deferral? 2]
         [(and live-game? (or enemy-air-raiders? protoss-aa-needed?))
          (min 2 (max 1 (length nexuses)))]
         [else 1]))
  (define protoss-unpowered-no-zealot-rush? (l2-protoss-unpowered-no-zealot-rush? ctx))
  (when (and (not protoss-unpowered-no-zealot-rush?)
                (or early-survival-crisis?
                    under-base-attack?
                    forward-proxy-detected?
                    (and live-game? (or enemy-air-raiders? protoss-aa-needed?))
                    (>= (count (lambda (e) (eq? (unit-type-sym e) 'reaper)) enemy-units) 2))
                (or (not live-game-obs?) (memq 'pylon ready-bldg-types))
                (memq 'cybernetics-core ready-bldg-types)
                (< cur-sb-cnt desired-sb-cnt)
                (= (order-ledger-pending-count-for-type oledger 'shield-battery frame) 0)
                (l2-save-cancel-rebuild-ready? ctx 'shield-battery 60)
                (>= (l2-ctx-minerals ctx) (sc2-min-cost 'shield-battery))
                (or (and crisis-tech-upgrade-deferral?
                         (or (<= (hash-ref open-prod-slots 'gateway 0) 0)
                             (>= (l2-ctx-minerals ctx) (+ (sc2-min-cost 'shield-battery) 125))))
                    (<= (hash-ref open-prod-slots 'gateway 0) 0)
                    (l2-non-combat-min-ok? ctx (sc2-min-cost 'shield-battery))))
       (define main-has-sb?
         (ormap (lambda (b)
                  (and (hash? b)
                       (eq? (fast-canonical-structure-sym (unit-type-sym b)) 'shield-battery)
                       (<= (dist2d base-x base-y (hash-ref b 'x -999.0) (hash-ref b 'y -999.0)) 12.0)))
                ally-bldgs))
       (define nat-has-sb?
         (ormap (lambda (b)
                  (and (hash? b)
                       (eq? (fast-canonical-structure-sym (unit-type-sym b)) 'shield-battery)
                       (<= (dist2d nat-x nat-y (hash-ref b 'x -999.0) (hash-ref b 'y -999.0)) 12.0)))
                ally-bldgs))
       (define (pick-main-sb-coords)
         (define-values (def-sbx def-sby) (l2-interior-offset ctx 5.0 -2.0))
         (let* ([px (if first-ready-pylon (exact->inexact (hash-ref first-ready-pylon 'x def-sbx)) def-sbx)]
                [py (if first-ready-pylon (exact->inexact (hash-ref first-ready-pylon 'y def-sby)) def-sby)]
                [cand (findf (lambda (off)
                               (define cx (+ px (car off)))
                               (define cy (+ py (cdr off)))
                               (and (>= (dist2d cx cy base-x base-y) 4.0)
                                    (andmap (lambda (b)
                                              (>= (dist2d cx cy
                                                          (hash-ref b 'x -999.0)
                                                          (hash-ref b 'y -999.0))
                                                  2.6))
                                            ally-bldgs)))
                             '((-3.0 . 0.0) (0.0 . -3.0) (3.0 . -3.0) (-2.5 . 3.0) (0.0 . 3.5) (3.5 . 2.5)))])
           (if cand
               (values (safe-coord (+ px (car cand)) def-sbx) (safe-coord (+ py (cdr cand)) def-sby))
               (values def-sbx def-sby))))
       (define-values (sb-x sb-y)
         (if (or (<= (length nexuses) 1)
                 (and nat-has-sb? (not main-has-sb?)))
             (pick-main-sb-coords)
             (l2-offset-defense-anchor ctx nat-x nat-y 5.5)))
       (l2-emit-build-verified! ctx 'shield-battery sb-x sb-y 2.0))
  ;; L20-P0-3 / L21-P0-3 / L25-P0-3 (`#36 PvZ` Early Rush Hold): During active base breach
  ;; (`under-base-attack?` / `early-survival-crisis?` / `under-early-cheese?` / `< 3:00 >= 6 Lings`)
  ;; with `< 4` combat units and an idle ready Gateway/WarpGate, train Zealot #1/#2 FIRST before
  ;; CyberCore or Gateway #2 spend minerals!
  (when (and live-game?
             (or under-base-attack? early-survival-crisis? under-early-cheese? protoss-early-ling-rush?)
             (< (length (l2-ctx-ally-combat-units ctx)) 4)
             (or (memq 'gateway ready-bldg-types) (memq 'warp-gate ready-bldg-types))
             (> (hash-ref open-prod-slots 'gateway 0) 0)
             (l2-can-spend-supply? ctx (sc2-supply-cost 'zealot)))
    (define breach-need-ranged?
      (ormap (lambda (e)
               (and (hash? e)
                    (memq (fast-canonical-unit-sym (unit-type-sym e))
                          '(reaper marauder stalker roach ravager adept marine oracle void-ray banshee mutalisk))))
             enemy-units))
    ;; L29-P0-3 (`CloakLoss -> 0`): Never let breach-defense Stalkers/Adepts burn gas needed for
    ;; `Observer #1` (75G) or `RoboticsFacility #1` (100G) when cloaked/burrowed threats attack with 0 Observers!
    (define breach-cloak-threat?
      (or (pair? (l2-shimmer-ripples ctx))
          (ormap (lambda (e)
                   (and (hash? e)
                        (not (memq (fast-canonical-unit-sym (unit-type-sym e))
                                   '(creep-tumor creep-tumor-burrowed creep-tumor-queen)))
                        (or (eq? (hash-ref e 'cloaked #f) #t)
                            (memq (hash-ref e 'cloak 0) '(1 2 cloaked cloaked-detected))
                            (= (hash-ref e 'display-type 1) 3)
                            (eq? (hash-ref e 'burrowed #f) #t)
                            (memq (fast-canonical-unit-sym (unit-type-sym e))
                                  '(dark-templar banshee ghost lurker-burrowed lurker-mp-burrowed)))))
                 enemy-units)))
    (define breach-det-gas-reserve
      (if (and breach-cloak-threat?
               (= (l2-unit-count ctx 'observer) 0))
          (cond
            [(and (memq 'robotics-facility ready-bldg-types)
                  (> (hash-ref open-prod-slots 'robotics-facility 0) 0))
             (sc2-gas-cost 'observer)]
            [(and (memq 'cybernetics-core ready-bldg-types)
                  (not (l2-building-present-or-pending? ctx 'robotics-facility)))
             (sc2-gas-cost 'robotics-facility)]
            [else 0])
          0))
    (define breach-reaper-cnt
      (count (lambda (e) (and (hash? e) (eq? (fast-canonical-unit-sym (unit-type-sym e)) 'reaper)))
             enemy-units))
    (define breach-anti-reaper-stalker-only?
      (and (>= breach-reaper-cnt 2)
           (memq 'cybernetics-core ready-bldg-types)
           (< (l2-unit-count ctx 'stalker) 4)))
    (cond
      [(and protoss-early-ling-rush?
            (< (l2-unit-count ctx 'zealot) 2)
            (>= (l2-ctx-minerals ctx) (sc2-min-cost 'zealot)))
       (l2-try-train-unit! ctx 'zealot 'gateway 5 #:respect-bo-reserve? #f)]
      ;; L55-T8 (`#003 PvP`): Prefer Stalker over Adept in PvP breach defense, and cap
      ;; non-PvP breach Adepts at `< 2` so Warp Gate never floods 9+ Adepts!
      [(and (or breach-need-ranged?
                (eq? (l2-ctx-effective-enemy-race ctx) 'Protoss))
            (memq 'cybernetics-core ready-bldg-types)
            (>= (l2-ctx-minerals ctx) (sc2-min-cost 'stalker))
            (>= (- (l2-ctx-gas ctx) breach-det-gas-reserve) (sc2-gas-cost 'stalker)))
       (l2-try-train-unit! ctx 'stalker 'gateway 5 #:respect-bo-reserve? #f)]
      [(and (not breach-need-ranged?)
            (not breach-anti-reaper-stalker-only?)
            (not (eq? (l2-ctx-effective-enemy-race ctx) 'Protoss))
            (< (l2-unit-count ctx 'adept) 2)
            (memq 'cybernetics-core ready-bldg-types)
            (>= (l2-ctx-minerals ctx) (sc2-min-cost 'adept))
            (>= (- (l2-ctx-gas ctx) breach-det-gas-reserve) (sc2-gas-cost 'adept)))
       (l2-try-train-unit! ctx 'adept 'gateway 5 #:respect-bo-reserve? #f)])
    ;; L57-R1 (`#063 SmoothBrain`, `+40` Zealot leak): When CyberneticsCore is ready with
    ;; `gas >= 50` (outside pure Zergling swarms / early ling rush), hold `100..224M` (~1.5s)
    ;; for a `125M/50G` Stalker instead of dumping `100M` into an un-Charged Zealot!
    (define breach-pure-ling-swarm?
      (and (eq? (l2-ctx-effective-enemy-race ctx) 'Zerg)
           (let ([ling-cnt (count (lambda (e)
                                    (and (hash? e)
                                         (memq (fast-canonical-unit-sym (unit-type-sym e))
                                               '(zergling baneling))))
                                  enemy-units)]
                 [non-ling-cnt (count (lambda (e)
                                        (and (hash? e)
                                             (combat-unit-record? e)
                                             (not (memq (fast-canonical-unit-sym (unit-type-sym e))
                                                        '(zergling baneling)))))
                                      enemy-units)])
             (and (>= ling-cnt 6)
                  (> ling-cnt (* 2 (max 1 non-ling-cnt)))))))
    (when (and (not breach-anti-reaper-stalker-only?)
               (not (and live-game?
                         (memq 'cybernetics-core ready-bldg-types)
                         (not protoss-early-ling-rush?)
                         (not breach-pure-ling-swarm?)
                         (not (memq 'charge (l2-ctx-researched-upgs ctx)))
                         (>= (- (l2-ctx-gas ctx) breach-det-gas-reserve) (sc2-gas-cost 'stalker))
                         (< (l2-ctx-minerals ctx) 225)))
               (> (hash-ref open-prod-slots 'gateway 0) 0)
               (>= (l2-ctx-minerals ctx) (sc2-min-cost 'zealot))
               (l2-can-spend-supply? ctx (sc2-supply-cost 'zealot)))
      (l2-try-train-unit! ctx 'zealot 'gateway 5 #:respect-bo-reserve? #f)))
  (define cyber-enemy-reaper?
       (ormap (lambda (e) (eq? (fast-canonical-unit-sym (unit-type-sym e)) 'reaper))
              enemy-units))
  (when (and (or (memq 'gateway ready-bldg-types) (memq 'warp-gate ready-bldg-types))
                (not protoss-unpowered-no-zealot-rush?)
                ;; L21-P0-3 / L25-P0-3 / L57-R2 (`#078 VeTerran` 110s CyberCore deadlock):
                ;; During <4:00 (`< 5400f`) active base attack / early survival crisis, tighten
                ;; non-Reaper CyberCore deferral from `< 4` combat units to `< 2` (`< 1` vs Terran)
                ;; so Protoss never locks on 15 Zealots / 0 Stalkers for 2 minutes!
                (not (and protoss-early-ling-rush?
                          (< protoss-early-gate-defenders 2)
                          (< (l2-ctx-minerals ctx) 250)))
                (not (and live-game?
                          (< frame 5400)
                          (< (length (l2-ctx-ally-combat-units ctx))
                             (l2-protoss-cyber-defer-unit-threshold ctx))
                          (or under-base-attack? early-survival-crisis?)
                          (not cyber-enemy-reaper?)
                          (not protoss-aa-needed?)
                          (< (l2-ctx-minerals ctx) 400)))
                (or (not protoss-saving-for-expand?)
                    cyber-enemy-reaper?
                    (l2-enemy-early-pool-detected? ctx)
                    (eq? (l2-ctx-effective-enemy-race ctx) 'Terran)
                    forward-proxy-detected?
                    (>= (l2-ctx-live-enemy-threat-supply ctx) 1)
                    (>= (l2-unit-count ctx 'zealot) 1)
                    (>= frame 1500))
                (= (l2-cur-ally-canon-bldg-count ctx 'cybernetics-core) 0)
                (= (order-ledger-pending-count-for-type oledger 'cybernetics-core frame) 0)
                (not (l2-building-present-or-pending? ctx 'cybernetics-core))
                (not (l2-worker-carrying-build-ability? ctx 894 'cybernetics-core))
                (l2-save-cancel-rebuild-ready? ctx 'cybernetics-core 60)
                (>= (l2-ctx-minerals ctx) (sc2-min-cost 'cybernetics-core))
                (l2-non-combat-min-ok? ctx (sc2-min-cost 'cybernetics-core) 'cybernetics-core))
       (define-values (inmain-cy-x inmain-cy-y)
         (if first-ready-pylon
             (l2-interior-offset ctx 2.5 -2.0
                                 (exact->inexact (hash-ref first-ready-pylon 'x base-x))
                                 (exact->inexact (hash-ref first-ready-pylon 'y base-y)))
             (l2-interior-offset ctx 6.0 2.0)))
       (if (and allow-exact-wall-slot?
                (not worker-rush-active?)
                (not in-base-proxy-detected?)
                (< frame 2200)
                (< cur-escrow-age-frames 64)
                (<= (length nexuses) 2)
                (l2-wall-slot-powered? ctx wall-slot-2))
           (l2-emit-build-verified! ctx 'cybernetics-core
                                 (safe-coord (car wall-slot-2) inmain-cy-x)
                                 (safe-coord (cdr wall-slot-2) inmain-cy-y)
                                 SC2-BUILD-SITE-MIN-CLEARANCE
                                 #:exact-wall-slot? #t)
           (l2-emit-build-verified! ctx 'cybernetics-core inmain-cy-x inmain-cy-y))))

;; L29-P0-3 (Air-Dominance Ground Closure): Return (values need-closure? live-enemy-air-cnt)
;; so Protoss caps anti-air-only Phoenixes and shifts Stargates/Gateways to building-killing
;; Void Rays / Tempests / Stalkers / Zealots once air dominance is established!
(define (l2-protoss-air-dom-closure-status ctx)
  (define live-game? (l2-ctx-live-obs-harvesters? ctx))
  (define ally-combat-units (or (l2-ctx-ally-combat-units ctx) '()))
  (define enemy-units (or (l2-ctx-enemy-units ctx) '()))
  (define enemy-bldgs (or (l2-ctx-enemy-bldgs ctx) '()))
  (define frame (l2-ctx-frame ctx))
  (define ground-hitting-sup
    (for/sum ([u (in-list ally-combat-units)]
              #:when (not (memq (fast-canonical-unit-sym (unit-type-sym u))
                                '(phoenix observer warp-prism warp-prism-phasing))))
      (max 0.5 (exact->inexact (sc2-supply-cost (fast-canonical-unit-sym (unit-type-sym u)))))))
  (define live-enemy-air-cnt
    (count (lambda (e)
             (and (hash? e) (combat-unit-record? e)
                  (let ([et (fast-canonical-unit-sym (unit-type-sym e))])
                    (and (not (memq et '(overlord overseer observer warp-prism medivac)))
                         (or (eq? (hash-ref e 'flying #f) #t)
                             (eq? (hash-ref e 'is-flying #f) #t)
                             (fast-unit-is-flying-sym? et))))))
           enemy-units))
  (define live-enemy-ground-cnt
    (count (lambda (e)
             (and (hash? e) (combat-unit-record? e)
                  (let ([et (fast-canonical-unit-sym (unit-type-sym e))])
                    (not (or (eq? (hash-ref e 'flying #f) #t)
                             (eq? (hash-ref e 'is-flying #f) #t)
                             (fast-unit-is-flying-sym? et))))))
           enemy-units))
  (values (and live-game?
               (>= (l2-unit-count ctx 'phoenix) 6)
               (< live-enemy-air-cnt 12)
               (or (< ground-hitting-sup 10.0)
                   (and (>= frame 12096) (>= (l2-ctx-minerals ctx) 800))
                   (and (= live-enemy-ground-cnt 0)
                        (pair? enemy-bldgs))))
          live-enemy-air-cnt))

;; L35-P0-3 (`#75` CloakLoss -> 0, `#54` Reapers): Urgent anti-air / anti-Reaper Stalker sensor.
;; Waives Gateway #3+ / Stargate / Immortal / Probe / Zealot mineral theft when CyberneticsCore
;; is ready, gas >= 50 (+ Observer #1 / Robo #1 gas reserve if cloaked/burrowed threat with 0 Obs),
;; and Protoss still needs Stalkers (`< 6` vs >= 2 combat air, `< 4` vs >= 1 combat air or >= 2 Reapers).
(define (l2-protoss-urgent-aa-reaper-stalker-status ctx)
  (define live-game? (l2-ctx-live-obs-harvesters? ctx))
  (define ready-bldg-types (l2-ctx-ready-bldg-types ctx))
  (define open-prod-slots (l2-ctx-open-prod-slots ctx))
  (cond
    [(or (not live-game?)
         (not (memq 'cybernetics-core ready-bldg-types))
         (<= (hash-ref open-prod-slots 'gateway 0) 0)
         (not (l2-can-spend-supply? ctx (sc2-supply-cost 'stalker))))
     (values #f 0 0 0 0)]
    [else
     (define enemy-units (or (l2-ctx-enemy-units ctx) '()))
     (define enemy-bldgs (or (l2-ctx-enemy-bldgs ctx) '()))
     (define-values (vis-reap vis-air vis-cloak?)
       (for/fold ([rc 0] [ac 0] [ck? #f]) ([e (in-list enemy-units)] #:when (hash? e))
         (define cu (fast-canonical-unit-sym (unit-type-sym e)))
         (define is-air?
           (and (combat-unit-record? e)
                (not (memq cu '(overlord overseer observer warp-prism medivac)))
                (or (eq? (hash-ref e 'flying #f) #t)
                    (eq? (hash-ref e 'flying? #f) #t)
                    (eq? (hash-ref e 'is-flying #f) #t)
                    (fast-unit-is-flying-sym? cu))))
         (define is-ck?
           (and (not (memq cu '(creep-tumor creep-tumor-burrowed creep-tumor-queen)))
                (or (eq? (hash-ref e 'cloaked #f) #t)
                    (memq (hash-ref e 'cloak 0) '(1 2 cloaked cloaked-detected))
                    (= (hash-ref e 'display-type 1) 3)
                    (eq? (hash-ref e 'burrowed #f) #t)
                    (eq? (hash-ref e 'is-burrowed #f) #t)
                    (memq cu '(dark-templar banshee ghost lurker-burrowed lurker-mp-burrowed
                               widow-mine-burrowed roach-burrowed infestor-burrowed swarm-host-burrowed)))))
         (values (if (eq? cu 'reaper) (add1 rc) rc)
                 (if is-air? (add1 ac) ac)
                 (or ck? is-ck?))))
     (define rt (l2-ctx-rt ctx))
     (define owm-sum (and rt (opponent-world-model-last-summary (rt-opponent-world-model rt))))
     (define kc (and owm-sum (opponent-world-summary-known-unit-counts owm-sum)))
     (define owm-reap (if (hash? kc) (hash-ref kc 'reaper 0) 0))
     (define owm-air
       (if (hash? kc)
           (for/sum ([s (in-list '(banshee mutalisk oracle phoenix void-ray voidray
                                   liberator liberator-ag viking viking-fighter corruptor
                                   battlecruiser carrier tempest brood-lord broodlord mothership))])
             (hash-ref kc s 0))
           0))
     (define eff-reap (max vis-reap owm-reap))
     (define eff-air (max vis-air owm-air))
     (define cloak-present?
       (or vis-cloak?
           (pair? (l2-shimmer-ripples ctx))
           (ormap (lambda (eb)
                    (and (hash? eb)
                         (memq (fast-canonical-structure-sym (unit-type-sym eb))
                               '(dark-shrine lurker-den lurker-den-mp))))
                  enemy-bldgs)))
     (define cloak-det-gas-need
       (if (and cloak-present? (= (l2-unit-count ctx 'observer) 0))
           (cond
             [(and (memq 'robotics-facility ready-bldg-types)
                   (> (hash-ref open-prod-slots 'robotics-facility 0) 0))
              (sc2-gas-cost 'observer)]
             [(not (l2-building-present-or-pending? ctx 'robotics-facility))
              (sc2-gas-cost 'robotics-facility)]
             [else 0])
           0))
     (define prio-saving (l2-ctx-prio-saving-for-sym ctx))
     (define prio-sched (l2-ctx-prio-scheduled-actions ctx))
     (define mdec (l2-ctx-macro-decision ctx))
     (define brain-sched-stalker?
       (or (eq? prio-saving 'stalker)
           (and (member '(train stalker) prio-sched) #t)
           (and (macro-brain-decision? mdec)
                (memq 'stalker (macro-brain-decision-scheduled-ids mdec)))))
     (define stalker-target (if (or (>= eff-air 1) cloak-present?) 6 4))
     (define urgent?
       (and (< (l2-unit-count ctx 'stalker) stalker-target)
            (>= (l2-ctx-gas ctx) (+ (sc2-gas-cost 'stalker) cloak-det-gas-need))
            (or (>= eff-reap 2)
                (>= eff-air 1)
                (and cloak-present? (>= eff-air 1))
                (and brain-sched-stalker?
                     (or (>= eff-reap 1)
                         (l2-ctx-protoss-aa-needed? ctx)
                         (l2-ctx-enemy-air-raiders? ctx)
                         cloak-present?)))))
     (values urgent? eff-reap eff-air stalker-target cloak-det-gas-need)]))

;; L52-2C (`#54 zig-reapers`): Live + OWM enemy Reaper count independent of Gateway slot availability
;; so Robotics Facility and Zealots defer cleanly until `stalker >= 4` even while Gateways are busy.
(define (l2-protoss-enemy-reaper-count ctx)
  (define enemy-units (or (l2-ctx-enemy-units ctx) '()))
  (define vis-reap
    (count (lambda (e) (and (hash? e) (eq? (fast-canonical-unit-sym (unit-type-sym e)) 'reaper)))
           enemy-units))
  (define rt (l2-ctx-rt ctx))
  (define owm-sum (and rt (opponent-world-model-last-summary (rt-opponent-world-model rt))))
  (define kc (and owm-sum (opponent-world-summary-known-unit-counts owm-sum)))
  (define owm-reap (if (hash? kc) (hash-ref kc 'reaper 0) 0))
  (max vis-reap owm-reap))

;; L35-P0-3 (`H2H #04` PvT Anti-Bio Colossus Scaling): Detect Bio-heavy Terran (`>= 16` visible
;; or OWM-remembered Marines + Marauders) so Protoss raises Colossus cap to `4`, trains Colossi
;; strictly ahead of Disruptors/Immortals when Robotics Bay is ready, and unlocks 2nd Robo on >= 3 bases!
(define (l2-protoss-enemy-bio-heavy? ctx)
  (define live-game? (l2-ctx-live-obs-harvesters? ctx))
  (and live-game?
       (let* ([enemy-units (or (l2-ctx-enemy-units ctx) '())]
              [vis-bio (for/sum ([e (in-list enemy-units)]
                                 #:when (and (hash? e)
                                             (memq (fast-canonical-unit-sym (unit-type-sym e))
                                                   '(marine marauder))))
                         1)]
              [rt (l2-ctx-rt ctx)]
              [owm-sum (and rt (opponent-world-model-last-summary (rt-opponent-world-model rt)))]
              [kc (and owm-sum (opponent-world-summary-known-unit-counts owm-sum))]
              [owm-bio (if (hash? kc)
                           (+ (hash-ref kc 'marine 0)
                              (hash-ref kc 'marauder 0))
                           0)])
         (>= (max vis-bio owm-bio) 16))))

(define (l2-protoss-phase2-tech-expand! ctx)
  (define active-assimilators (l2-ctx-active-assimilators ctx))
  (define active-bases (l2-ctx-active-bases ctx))
  (define allow-exact-wall-slot? (l2-ctx-allow-exact-wall-slot? ctx))
  (define ally-bldgs (l2-ctx-ally-bldgs ctx))
  (define base-x (l2-ctx-base-x ctx))
  (define base-y (l2-ctx-base-y ctx))
  (define bo-goal-sym (l2-ctx-bo-goal-sym ctx))
  (define cd-tracker (l2-ctx-cd-tracker ctx))
  (define crisis-freeze-expand-or-gas? (l2-ctx-crisis-freeze-expand-or-gas? ctx))
  (define crisis-tech-upgrade-deferral? (l2-ctx-crisis-tech-upgrade-deferral? ctx))
  (define cur-escrow-age-frames (l2-ctx-cur-escrow-age-frames ctx))
  (define early-survival-crisis? (l2-ctx-early-survival-crisis? ctx))
  (define eff-phase-supply (l2-ctx-eff-phase-supply ctx))
  (define effective-enemy-race (l2-ctx-effective-enemy-race ctx))
  (define endgame-corner-hunt? (l2-ctx-endgame-corner-hunt? ctx))
  (define enemy-air-raiders? (l2-ctx-enemy-air-raiders? ctx))
  (define enemy-heavy-ground-siege? (l2-ctx-enemy-heavy-ground-siege? ctx))
  (define enemy-muta-cnt-p (l2-ctx-enemy-muta-cnt-p ctx))
  (define enemy-units (l2-ctx-enemy-units ctx))
  (define escrow-suppressed-active? (l2-ctx-escrow-suppressed-active? ctx))
  (define first-ready-pylon (l2-ctx-first-ready-pylon ctx))
  (define frame (l2-ctx-frame ctx))
  (define gateways (l2-ctx-gateways ctx))
  (define in-base-proxy-detected? (l2-ctx-in-base-proxy-detected? ctx))
  (define live-army-supply (l2-ctx-live-army-supply ctx))
  (define live-enemy-threat-supply (l2-ctx-live-enemy-threat-supply ctx))
  (define live-game? (l2-ctx-live-obs-harvesters? ctx))
  (define max-escrow-timeout-frames (l2-ctx-max-escrow-timeout-frames ctx))
  (define nat-x (l2-ctx-nat-x ctx))
  (define nat-y (l2-ctx-nat-y ctx))
  (define natural-blocked? (l2-ctx-natural-blocked? ctx))
  (define nexuses (l2-ctx-nexuses ctx))
  (define oledger (l2-ctx-oledger ctx))
  (define open-prod-slots (l2-ctx-open-prod-slots ctx))
  (define orphaned-prereqs (l2-ctx-orphaned-prereqs ctx))
  (define prio-saving-for-sym (l2-ctx-prio-saving-for-sym ctx))
  (define prio-scheduled-actions (l2-ctx-prio-scheduled-actions ctx))
  (define protoss-aa-needed? (l2-ctx-protoss-aa-needed? ctx))
  (define protoss-saving-for-expand? (l2-ctx-protoss-saving-for-expand? ctx))
  (define ready-bldg-types (l2-ctx-ready-bldg-types ctx))
  (define researched-upgs (l2-ctx-researched-upgs ctx))
  (define supply-used (l2-ctx-supply-used ctx))
  (define tech-obs (l2-ctx-tech-obs ctx))
  (define total-workers (l2-ctx-total-workers ctx))
  (define under-base-attack? (l2-ctx-under-base-attack? ctx))
  (define urgent-combat-or-intel-need? (l2-ctx-urgent-combat-or-intel-need? ctx))
  (define wall-slot-3 (l2-ctx-wall-slot-3 ctx))
  (define worker-rush-active? (l2-ctx-worker-rush-active? ctx))
  (define has-nat-nexus-or-pending?
       (or (>= (length nexuses) 2)
           (> (order-ledger-pending-count-for-type oledger 'nexus frame) 0)))
  (define desired-assimilators
       (if (and early-survival-crisis? (null? active-assimilators))
           0
           (min (* SC2-GEYSERS-PER-BASE (length nexuses))
                (if live-game?
                    (cond
                      [(and (>= (length nexuses) 4) (>= total-workers 62) (< (l2-ctx-gas ctx) 600)) 8]
                      [(and (>= (length nexuses) 3) (>= total-workers 50) (< (l2-ctx-gas ctx) 450)) 6]
                      [(and (>= eff-phase-supply 52) (>= total-workers 38) (< (l2-ctx-gas ctx) 350)) 4]
                      [(and (>= eff-phase-supply 38) (>= total-workers 32) (< (l2-ctx-gas ctx) 300)) 3]
                      [(and (eq? effective-enemy-race 'Protoss)
                            (= (length nexuses) 1)
                            (>= total-workers 17)
                            (< (l2-ctx-gas ctx) 250))
                       2]
                      [(and (l2-building-present-or-pending? ctx 'cybernetics-core)
                            (or has-nat-nexus-or-pending? (>= eff-phase-supply 32))
                            (>= total-workers 19)
                            (< (l2-ctx-gas ctx) 250))
                       2]
                      [else 1])
                    (cond
                      [(>= supply-used 54) 4]
                      [(>= supply-used 40) 3]
                      [(or (memq 'cybernetics-core (l2-ctx-bldg-types ctx)) (>= total-workers SC2-MIN-WORKERS-FOR-SECOND-GAS)) 2]
                      [else 1])))))
  (define-values (protoss-air-dom-need-ground-closure? protoss-live-enemy-air-cnt)
    (l2-protoss-air-dom-closure-status ctx))
  (define-values (p2-urgent-stalker? _p2-reap-cnt _p2-air-cnt _p2-stlk-tgt p2-cloak-det-gas-need)
    (l2-protoss-urgent-aa-reaper-stalker-status ctx))
  (define (p2-urgent-stalker-res-ok? min-cost gas-cost)
    (or (not p2-urgent-stalker?)
        (and (>= (- (l2-ctx-minerals ctx) min-cost) (sc2-min-cost 'stalker))
             (or (<= gas-cost 0)
                 (>= (- (l2-ctx-gas ctx) gas-cost) (+ (sc2-gas-cost 'stalker) p2-cloak-det-gas-need))))))
  (define p2-anti-reaper-defer-robo?
    (and live-game?
         (memq 'cybernetics-core ready-bldg-types)
         (>= (l2-protoss-enemy-reaper-count ctx) 2)
         (< (l2-unit-count ctx 'stalker) 4)
         (< (l2-ctx-minerals ctx) 400)))
  (define protoss-enemy-bio-heavy? (l2-protoss-enemy-bio-heavy? ctx))
  ;; L48-W2 (`H2H #04 PvT` RoboBay/Immortal Unblock): Hoist `protoss-enemy-capital-air?` above
  ;; `reserve-idle-stargate-aa?` so PvT requires real combat air (`enemy-air-raiders?` /
  ;; `protoss-enemy-capital-air?` / `enemy-muta-cnt-p > 0`) — never locking `150M/100G` for
  ;; Phoenixes on a routine Terran Medivac + Viking!
  (define protoss-enemy-capital-air?
       (ormap (lambda (e)
                (let ([cs (fast-canonical-unit-sym (unit-type-sym e))])
                  (or (memq cs THOR-CAPITAL-AIR-SYMS)
                      (eq? cs 'mothership))))
              enemy-units))
  (define reserve-idle-stargate-aa?
       (and live-game?
            protoss-aa-needed?
            (or (not (eq? effective-enemy-race 'Terran))
                enemy-air-raiders?
                protoss-enemy-capital-air?
                (> enemy-muta-cnt-p 0))
            (not protoss-air-dom-need-ground-closure?)
            (memq 'stargate ready-bldg-types)
            (< (l2-unit-count ctx 'phoenix) 6)
            (> (hash-ref open-prod-slots 'stargate 0) 0)))
  (define (aa-stargate-min-ok? cost)
       (>= (l2-ctx-minerals ctx) (+ cost (if reserve-idle-stargate-aa? (sc2-min-cost 'phoenix) 0))))
  (define (aa-stargate-gas-ok? cost)
       (>= (l2-ctx-gas ctx) (+ cost (if reserve-idle-stargate-aa? (sc2-gas-cost 'phoenix) 0))))
  (define colossus-goal-cap
    (cond
      [protoss-enemy-bio-heavy? 4]
      [(eq? effective-enemy-race 'Terran) 3]
      [else 2]))
  (set-l2-ctx-colossus-goal-cap! ctx colossus-goal-cap)
  ;; L23-P0-3 (`#36/#6 PvZ` `pvz_assim_before_gate`): In live games, require an actual started
  ;; Gateway/WarpGate in `ally-bldgs` (`(pair? gateways)`) — NOT merely a walking pending Probe
  ;; order in `bldg-types` — before starting Assimilator #1!
  (when (and (or (memq 'gateway (l2-ctx-bldg-types ctx)) (memq 'warp-gate (l2-ctx-bldg-types ctx)))
                (or (not live-game?) (pair? gateways))
                (not crisis-freeze-expand-or-gas?)
                (l2-save-cancel-rebuild-ready? ctx 'assimilator 60)
                (or (null? active-assimilators) (not protoss-saving-for-expand?))
                (or (< (length active-assimilators) 2)
                    (l2-protoss-colossus-escrow-ok? ctx (sc2-min-cost 'assimilator) 0))
                (let ([cur-assim-cnt (+ (length active-assimilators)
                                        (order-ledger-pending-count-for-type oledger 'assimilator frame))])
                  (and (< cur-assim-cnt desired-assimilators)
                       (or (not live-game?)
                           (>= total-workers
                               (pro-min-workers-for-next-gas-bldg 'Protoss effective-enemy-race cur-assim-cnt)))))
                (aa-stargate-min-ok? (sc2-min-cost 'assimilator))
                (l2-non-combat-min-ok? ctx (sc2-min-cost 'assimilator) 'assimilator))
       (l2-emit-gas-build-verified! ctx 'assimilator (safe-coord (+ base-x 4.0)) (safe-coord (+ base-y 4.0))))
  ;; L21-P0-3: During <4:00 (`< 5376f`) active base attack / early survival crisis,
  ;; gate Warp Gate research, Robotics Facility, Twilight Council, and non-AA Stargate
  ;; behind >= 4 combat units (unless surplus >= 450M) so minerals fund Zealots/Gateways first!
  (define early-breach-defer-tech?
    (and live-game?
         (< frame 5376)
         (< (length (l2-ctx-ally-combat-units ctx)) 4)
         (or under-base-attack? early-survival-crisis?)
         (< (l2-ctx-minerals ctx) 450)))
  (when (memq 'cybernetics-core ready-bldg-types)
       (when (and (not early-breach-defer-tech?)
                  (not protoss-saving-for-expand?)
                  (aa-stargate-min-ok? (sc2-min-cost 'warp-gate-research))
                  (aa-stargate-gas-ok? (sc2-gas-cost 'warp-gate-research))
                  (l2-non-combat-min-ok? ctx (sc2-min-cost 'warp-gate-research) 'warp-gate-research)
                  (l2-non-combat-gas-ok? ctx (sc2-gas-cost 'warp-gate-research) 'warp-gate-research)
                  (l2-upgrade-needed? ctx 'warp-gate-research)
                  (l2-upgrade-needed? ctx 'warpgate))
         (l2-emit-research-verified! ctx 'warp-gate-research))
       (when (and (not live-game?)
                  (or (memq 'warpgate researched-upgs)
                      (memq 'warp-gate-research researched-upgs))
                  (memq 'gateway ready-bldg-types))
         (l2-emit! ctx '(morph warp-gate))))
  ;; L29-P0-3 (`#52 DT:7`, `#54 Banshee:14`, `CloakLoss -> 0`): Detect live cloaked/burrowed
  ;; threats or Dark Shrine BEFORE Robotics Facility & Observer gates so `RoboticsFacility #1`
  ;; and `Observer #1` immediately bypass expand/tech/air-pressure cooldowns when `0` Observers exist!
  (define protoss-visible-cloaked-or-burrowed?
    (or (ormap (lambda (eb)
                 (and (hash? eb)
                      (memq (fast-canonical-structure-sym (unit-type-sym eb))
                            '(dark-shrine lurker-den lurker-den-mp))))
               (or (l2-ctx-enemy-bldgs ctx) '()))
        (pair? (l2-shimmer-ripples ctx))
        (for/or ([e (in-list enemy-units)])
          (and (hash? e)
               (not (memq (unit-type-sym e)
                          '(creep-tumor creep-tumor-burrowed creep-tumor-queen)))
               (or (eq? (hash-ref e 'cloaked #f) #t)
                   (memq (hash-ref e 'cloak 0) '(1 2 cloaked cloaked-detected))
                   (= (hash-ref e 'display-type 1) 3)
                   (eq? (hash-ref e 'burrowed #f) #t)
                   (eq? (hash-ref e 'is-burrowed #f) #t)
                   (memq (fast-canonical-unit-sym (unit-type-sym e))
                         '(dark-templar banshee ghost lurker-burrowed lurker-mp-burrowed
                           widow-mine-burrowed roach-burrowed infestor-burrowed swarm-host-burrowed)))))))
  (define protoss-cloak-det-emergency?
    (and live-game?
         (= (l2-unit-count ctx 'observer) 0)
         protoss-visible-cloaked-or-burrowed?))
  (define cur-robo-cnt
       (+ (count (lambda (b) (eq? (fast-canonical-structure-sym (unit-type-sym b)) 'robotics-facility))
                 ally-bldgs)
          (order-ledger-pending-count-for-type oledger 'robotics-facility frame)))
  (define brain-sched-robo-now?
    (and live-game?
         (or (eq? prio-saving-for-sym 'robotics-facility)
             (and (member '(build robotics-facility) prio-scheduled-actions) #t)
             (and (macro-brain-decision? (l2-ctx-macro-decision ctx))
                  (memq 'robotics-facility (macro-brain-decision-scheduled-ids (l2-ctx-macro-decision ctx)))))))
  (define protoss-bio-2nd-robo-now?
    (and live-game?
         (memq 'robotics-facility ready-bldg-types)
         (>= (length nexuses) 3)
         (or protoss-enemy-bio-heavy?
             brain-sched-robo-now?)
         (or (not (memq 'robotics-bay ready-bldg-types))
             (= (hash-ref open-prod-slots 'robotics-facility 0) 0)
             (>= (l2-unit-count ctx 'colossus) 1)
             (and (>= (l2-ctx-minerals ctx) (+ (sc2-min-cost 'robotics-facility) (sc2-min-cost 'colossus)))
                  (>= (l2-ctx-gas ctx) (+ (sc2-gas-cost 'robotics-facility) (sc2-gas-cost 'colossus)))))))
  (define desired-robos
       (if (and live-game?
                (memq 'robotics-facility ready-bldg-types)
                (or protoss-bio-2nd-robo-now?
                    (and (or (>= (length nexuses) 3)
                             (and (>= (l2-ctx-minerals ctx) 550) (>= (l2-ctx-gas ctx) 200)))
                         (>= eff-phase-supply 72))))
           2
           1))
  (when (and (memq 'cybernetics-core ready-bldg-types)
                (or (not early-breach-defer-tech?) (and (= cur-robo-cnt 0) protoss-cloak-det-emergency?))
                (or (not p2-anti-reaper-defer-robo?) (and (= cur-robo-cnt 0) protoss-cloak-det-emergency?))
                (or (not protoss-saving-for-expand?)
                    endgame-corner-hunt?
                    (and (= cur-robo-cnt 0) protoss-cloak-det-emergency?))
                (l2-save-cancel-rebuild-ready? ctx 'robotics-facility 60)
                (< cur-robo-cnt desired-robos)
                (or (= cur-robo-cnt 0)
                    protoss-bio-2nd-robo-now?
                    (and (l2-protoss-colossus-escrow-ok? ctx (sc2-min-cost 'robotics-facility) (sc2-gas-cost 'robotics-facility))
                         (or (>= (l2-ctx-minerals ctx) 550)
                             (l2-can-spend-by-priority? ctx 'robotics-facility 'production-scaling))))
                (or (and (= cur-robo-cnt 0)
                         (or protoss-cloak-det-emergency?
                             (not (or enemy-air-raiders?
                                      (ormap (lambda (e)
                                               (or (eq? (hash-ref e 'flying? #f) #t)
                                                   (eq? (hash-ref e 'is-flying #f) #t)))
                                             enemy-units)))))
                    (and protoss-bio-2nd-robo-now?
                         (< protoss-live-enemy-air-cnt 4))
                    (and (aa-stargate-min-ok? (sc2-min-cost 'robotics-facility))
                         (aa-stargate-gas-ok? (sc2-gas-cost 'robotics-facility))))
                (or (and (= cur-robo-cnt 0)
                         protoss-cloak-det-emergency?
                         (>= (l2-ctx-minerals ctx) (sc2-min-cost 'robotics-facility))
                         (>= (l2-ctx-gas ctx) (sc2-gas-cost 'robotics-facility)))
                    (and protoss-bio-2nd-robo-now?
                         (>= (l2-ctx-minerals ctx)
                             (+ (sc2-min-cost 'robotics-facility)
                                (l2-ctx-hard-supply-lockout-reserve-min ctx)))
                         (>= (l2-ctx-gas ctx) (sc2-gas-cost 'robotics-facility)))
                    (and (l2-non-combat-min-ok? ctx (sc2-min-cost 'robotics-facility) 'robotics-facility)
                         (l2-non-combat-gas-ok? ctx (sc2-gas-cost 'robotics-facility) 'robotics-facility))))
       (let-values ([(rbx rby) (l2-interior-offset ctx (+ 6.5 (* 3.5 cur-robo-cnt)) (+ 2.5 (* 1.5 cur-robo-cnt)))])
         (l2-emit-build-verified! ctx 'robotics-facility rbx rby
                                  #:bypass-escrow? (or protoss-bio-2nd-robo-now?
                                                       protoss-cloak-det-emergency?
                                                       (>= (l2-ctx-minerals ctx) 550))))
       (unless live-game?
         (l2-emit! ctx '(morph warp-gate))))
  ;; W8-P0-1-rt: Hoist enemy air-pressure detection above Robotics Facility production
  ;; to stop Observer / Warp Prism non-combat Robo waste (#18 15 Obs, #30 8 WP).
  ;; (`protoss-enemy-capital-air?` hoisted above `reserve-idle-stargate-aa?` in L48-W2.)
  (define protoss-enemy-air-combat-cnt
       (count (lambda (e)
                (and (hash? e)
                     (combat-unit-record? e)
                     (or (eq? (hash-ref e 'flying? #f) #t)
                         (eq? (hash-ref e 'is-flying #f) #t)
                         (fast-unit-is-flying-sym? (unit-type-sym e)))))
              enemy-units))
  (define protoss-enemy-air-pressure?
       (or protoss-enemy-capital-air?
           enemy-air-raiders?
           (>= protoss-enemy-air-combat-cnt 2)))
  (define robo-rt (l2-ctx-rt ctx))
  (define robo-st (and robo-rt (rt-door-state robo-rt)))
  ;; W10-P0-3-rt: Count Observers (977) & Warp Prisms (976) currently in Robotics Facility
  ;; production queues alongside alive + order-ledger pending so overlapping queue spam never occurs!
  (define-values (obs-in-robo-queue wp-in-robo-queue)
    (for/fold ([oc 0] [wc 0]) ([b (in-list ally-bldgs)])
      (if (and (hash? b)
               (eq? (fast-canonical-structure-sym (unit-type-sym b)) 'robotics-facility))
          (let ([ab (hash-ref b 'order-ability-id 0)])
            (cond
              [(= ab 977) (values (add1 oc) wc)]
              [(= ab 976) (values oc (add1 wc))]
              [else (values oc wc)]))
          (values oc wc))))
  ;; L38-P0-1c (`#5138254`): `l2-unit-count` already canonicalizes `observer-siege-mode -> observer`
  ;; and `warp-prism-phasing -> warp-prism`; do NOT sum both keys or 1 Observer double-counts as 2!
  (define cur-obs-alive (l2-unit-count ctx 'observer))
  (define cur-obs-total
       (+ cur-obs-alive
          obs-in-robo-queue
          (order-ledger-pending-count-for-type oledger 'observer frame)))
  (define cur-wp-alive (l2-unit-count ctx 'warp-prism))
  (when robo-st
    (when (<= frame 4)
      (hash-remove! robo-st 'last-obs-cnt)
      (hash-remove! robo-st 'last-obs-loss-frame)
      (hash-remove! robo-st 'obs-trained-cnt)
      (hash-remove! robo-st 'last-wp-cnt)
      (hash-remove! robo-st 'last-wp-loss-frame)
      (hash-remove! robo-st 'wp-trained-cnt))
    (let ([prev-obs (hash-ref robo-st 'last-obs-cnt 0)])
      (when (and (> prev-obs 0) (< cur-obs-alive prev-obs))
        (hash-set! robo-st 'last-obs-loss-frame frame))
      (hash-set! robo-st 'last-obs-cnt cur-obs-alive))
    (let ([prev-wp (hash-ref robo-st 'last-wp-cnt 0)])
      (when (and (> prev-wp 0) (< cur-wp-alive prev-wp))
        (hash-set! robo-st 'last-wp-loss-frame frame))
      (hash-set! robo-st 'last-wp-cnt cur-wp-alive)))
  (define last-obs-loss-frame
       (if robo-st (hash-ref robo-st 'last-obs-loss-frame -99999) -99999))
  (define obs-trained-cnt
       (if robo-st (hash-ref robo-st 'obs-trained-cnt 0) 0))
  (define last-wp-loss-frame
       (if robo-st (hash-ref robo-st 'last-wp-loss-frame -99999) -99999))
  (define wp-trained-cnt
       (if robo-st (hash-ref robo-st 'wp-trained-cnt 0) 0))
  (define obs-requires-det? (enemy-tech-observation-requires-detection? tech-obs))
  (define visible-cloaked-or-burrowed-enemy? protoss-visible-cloaked-or-burrowed?)
  (define obs-cloak-threat-active?
    (or obs-requires-det? visible-cloaked-or-burrowed-enemy?))
  ;; L51-2A + L52-2B (`#75 PvT who` / `#63 SmoothBrain` / `#78 VeTerran`):
  ;; In PvT, always train `Observer #1` (`25M/75G`) out of `RoboticsFacility #1` FIRST ahead of
  ;; `Immortal #1`, then CAP replacement Observers `#2+` when `not obs-cloak-threat-active?` so
  ;; Robo trains Immortals/Colossi vs Siege Tanks instead of looping Observers `#2..#4`!
  (define pvt-first-observer-priority?
    (and live-game?
         (eq? effective-enemy-race 'Terran)
         (= cur-obs-total 0)
         (or (= obs-trained-cnt 0)
             obs-cloak-threat-active?)))
  ;; Loop 65B + Loop 65H (`#1863`/`#1949`, Protoss-only): Hoist Warp Prism #1 readiness above
  ;; BOTH Robo expand-save gates so 2-base Protoss with Charge researched/pending (`>= 3` ready WGs)
  ;; OR past `4:30` (`>= 6048f`) with `>= 4` ready WGs and `>= 1` Immortal / `>= 1` Colossus
  ;; (keeping PvP `>= 2` Immortals) trains Warp Prism #1 on schedule (`5:30-7:00`) even while
  ;; saving for Nexus #3!
  (define cur-warp-prism-total
    (+ cur-wp-alive
       wp-in-robo-queue
       (order-ledger-pending-count-for-type oledger 'warp-prism frame)))
  (define cur-wg-ready-cnt
    (count (lambda (b)
             (and (hash? b)
                  (eq? (fast-canonical-structure-sym (unit-type-sym b)) 'warp-gate)
                  (>= (hash-ref b 'build-progress 1.0) SC2-BUILD-COMPLETE-PROGRESS)))
           ally-bldgs))
  (define wp-live-env-ok?
    (and (not under-base-attack?)
         (not early-survival-crisis?)
         (not protoss-enemy-capital-air?)
         (not protoss-enemy-air-pressure?)
         (or (< wp-trained-cnt 2) (>= (l2-ctx-minerals ctx) 800))
         (>= (- frame last-wp-loss-frame) 896)
         (refractory-ready? cd-tracker '(train-warp-prism) frame 896)))
  (define protoss-midgame-charge-prism-due?
    (and live-game?
         (< cur-warp-prism-total 1)
         wp-live-env-ok?
         (>= (length nexuses) 2)
         (or (and (or (memq 'charge researched-upgs)
                      (memq 'charge (l2-ctx-pending-upgs ctx)))
                  (>= cur-wg-ready-cnt 3))
             (and (>= frame 6048) (>= cur-wg-ready-cnt 4)))
         (or (>= (l2-unit-count ctx 'immortal) 1)
             (>= (l2-unit-count ctx 'colossus) 1))
         (>= (l2-ctx-minerals ctx) 250)
         (not crisis-tech-upgrade-deferral?)
         (not (eq? bo-goal-sym 'immortal))
         (not (and (eq? effective-enemy-race 'Protoss)
                   (< (l2-unit-count ctx 'immortal) 2)))
         (not (and (memq 'robotics-bay ready-bldg-types)
                   (< (l2-unit-count ctx 'colossus) 1)))))
  (when (and (or (not protoss-saving-for-expand?)
                    pvt-first-observer-priority?
                    protoss-midgame-charge-prism-due?
                    (and (= cur-obs-total 0) protoss-cloak-det-emergency?)
                    (and endgame-corner-hunt? (< cur-obs-total 1)))
                (memq 'robotics-facility ready-bldg-types)
                (l2-can-spend-supply? ctx (sc2-supply-cost 'observer)))
       (define obs-urgent-zero-det?
         (and (= cur-obs-total 0)
              obs-cloak-threat-active?))
       (define obs-owm-kc
         (and robo-rt
              (let ([owm-s (opponent-world-model-last-summary (rt-opponent-world-model robo-rt))])
                (and owm-s (opponent-world-summary-known-unit-counts owm-s)))))
       (define obs-enemy-banshee-cnt
         (max (count (lambda (e) (and (hash? e) (eq? (fast-canonical-unit-sym (unit-type-sym e)) 'banshee))) enemy-units)
              (if (hash? obs-owm-kc) (hash-ref obs-owm-kc 'banshee 0) 0)))
       (define obs-enemy-dt-cnt
         (max (count (lambda (e) (and (hash? e) (eq? (fast-canonical-unit-sym (unit-type-sym e)) 'dark-templar))) enemy-units)
              (if (hash? obs-owm-kc) (hash-ref obs-owm-kc 'dark-templar 0) 0)))
       (define cur-robo-core-cnt
         (+ (l2-unit-count ctx 'immortal) (l2-unit-count ctx 'colossus)))
       (define obs-2base-second-needed?
         (and live-game?
              (>= (length nexuses) 2)
              obs-cloak-threat-active?
              (or (>= obs-enemy-banshee-cnt 1)
                  (>= obs-enemy-dt-cnt 1)
                  (>= cur-robo-core-cnt 1))
              (< obs-trained-cnt 4)))
       (define desired-observers
         (cond
           [obs-2base-second-needed? 2]
           [(and live-game? protoss-enemy-air-pressure?) 1]
           [(and live-game? (>= (length nexuses) 2) (or obs-cloak-threat-active? (>= live-army-supply 20))) 2]
           [(and live-game? (not obs-cloak-threat-active?) (< live-army-supply 25)) 1]
           [obs-cloak-threat-active? 2]
           [else 1]))
       (define obs-mine-only-zero-core?
         (and (>= obs-trained-cnt 2)
              (= cur-robo-core-cnt 0)
              (= obs-enemy-banshee-cnt 0)
              (= obs-enemy-dt-cnt 0)))
       (define obs-loss-cd-frames
         (cond
           [(and obs-urgent-zero-det? obs-mine-only-zero-core?) 224]
           [obs-urgent-zero-det? 44]
           [(and protoss-enemy-air-pressure? (>= obs-trained-cnt 3)) 1344]
           [(and obs-2base-second-needed? (< cur-obs-total 2)) 336]
           [protoss-enemy-air-pressure? 896]
           [(and visible-cloaked-or-burrowed-enemy? (= cur-obs-total 0)) 224]
           [else 448]))
       (define obs-loss-cd-ok?
         (or (not live-game?)
             (>= (- frame last-obs-loss-frame) obs-loss-cd-frames)))
       (define obs-train-cd-frames
         (cond
           [(and obs-urgent-zero-det? obs-mine-only-zero-core?) 224]
           [obs-urgent-zero-det? 44]
           [(and obs-2base-second-needed? (< cur-obs-total 2) (< obs-trained-cnt 3)) 224]
           [(or (>= obs-trained-cnt 3) protoss-enemy-air-pressure?) 1344]
           [visible-cloaked-or-burrowed-enemy? 448]
           [else 672]))
       (define obs-train-cd-ok?
         (or (not live-game?)
             (refractory-ready? cd-tracker '(train-observer) frame obs-train-cd-frames)))
       (define obs-match-cap-ok?
         (or (not live-game?)
             (< obs-trained-cnt 4)
             (and obs-cloak-threat-active?
                  (= cur-obs-total 0)
                  (< obs-trained-cnt 8))))
       (define pvt-obs-defer-for-immortal?
         (and live-game?
              (memq effective-enemy-race '(Terran Protoss))
              (not (and endgame-corner-hunt? (null? enemy-units) (= cur-obs-total 0) (= obs-trained-cnt 0)))
              (cond
                [(eq? effective-enemy-race 'Protoss)
                 ;; Loop 65B/65C (`#1861`/`#1874`/`#1876`): In PvP, defer Observer `#2+` while
                 ;; `cur-robo-core-cnt < 4`, AND once an Observer was already trained (`>= 1`)
                 ;; while `cur-robo-core-cnt == 0` and `(not visible-cloaked-or-burrowed-enemy?)`,
                 ;; defer replacement Observer until Immortal `#1` is built!
                 (and (< cur-robo-core-cnt 4)
                      (or (>= cur-obs-total 1)
                          (and (>= obs-trained-cnt 1)
                               (not obs-cloak-threat-active?))
                          (and (>= obs-trained-cnt 1)
                               (= cur-robo-core-cnt 0)
                               (not visible-cloaked-or-burrowed-enemy?))))]
                [else
                 (or (and (>= cur-obs-total 1)
                          (= cur-robo-core-cnt 0)
                          (= obs-enemy-banshee-cnt 0)
                          (= obs-enemy-dt-cnt 0))
                     (and (>= obs-trained-cnt 1)
                          (not obs-cloak-threat-active?)
                          (< cur-robo-core-cnt 2)))])))
       ;; W11-P0-3-rt + L51-2A: Defer first Observer until army-supply >= 8 unless cloaked/burrowed
       ;; threat OR PvT first Observer #1 priority!
       (define obs-army-ready?
         (or (not live-game?)
             (>= live-army-supply 8)
             pvt-first-observer-priority?
             obs-cloak-threat-active?))
       (define obs-started-now? #f)
       (when (and (or (not protoss-saving-for-expand?)
                      pvt-first-observer-priority?
                      (and (= cur-obs-total 0) protoss-cloak-det-emergency?)
                      (and endgame-corner-hunt? (< cur-obs-total 1)))
                  (or (= cur-obs-total 0)
                      obs-cloak-threat-active?
                      (not protoss-midgame-charge-prism-due?))
                  (< cur-obs-total desired-observers)
                  (not pvt-obs-defer-for-immortal?)
                  obs-army-ready?
                  obs-loss-cd-ok?
                  obs-train-cd-ok?
                  obs-match-cap-ok?
                  (or (< cur-obs-total 1)
                      obs-cloak-threat-active?
                      (l2-protoss-colossus-escrow-ok? ctx (sc2-min-cost 'observer) (sc2-gas-cost 'observer)))
                  (or pvt-first-observer-priority?
                      obs-cloak-threat-active?
                      (aa-stargate-gas-ok? (sc2-gas-cost 'observer))))
         (when (l2-try-train-unit! ctx 'observer 'robotics-facility 1
                                   #:respect-bo-reserve? (not (or obs-urgent-zero-det?
                                                                  pvt-first-observer-priority?)))
           (set! obs-started-now? #t)
           (when live-game?
             (when robo-st
               (hash-set! robo-st 'obs-trained-cnt (add1 obs-trained-cnt)))
             (refractory-allow-action?! cd-tracker '(train-observer) frame obs-train-cd-frames))))
       (define cur-obs-total-now (+ cur-obs-total (if obs-started-now? 1 0)))
       ;; L36-P0-3 (`#5138232` PvZ 124s idle Robo): Keep Robotics Facility continuously pumping
       ;; Immortals in PvZ (`< 3` Immortals) even while expanding/saving so Roach-Ling never crushes
       ;; an idle Robo!
       (define pvz-continuous-robo-now?
         (and live-game?
              (eq? effective-enemy-race 'Zerg)
              (> (hash-ref open-prod-slots 'robotics-facility 0) 0)
              (not protoss-enemy-capital-air?)
              (< (l2-unit-count ctx 'immortal) 3)))
       ;; Loop 65B (`#1861`/`#1863`): Keep Robotics Facility continuously pumping Immortals in PvP
       ;; (`< 4` Immortals) even while expanding/saving so PvP never falls behind 2x in Immortals!
       (define pvp-continuous-robo-now?
         (and live-game?
              (eq? effective-enemy-race 'Protoss)
              (> (hash-ref open-prod-slots 'robotics-facility 0) 0)
              (not protoss-enemy-capital-air?)
              (< (l2-unit-count ctx 'immortal) 4)))
       (when (or crisis-tech-upgrade-deferral? pvz-continuous-robo-now? pvp-continuous-robo-now?
                 protoss-midgame-charge-prism-due? (not protoss-saving-for-expand?))
         ;; L35-P0-3 (`H2H #04` PvT Anti-Bio Colossus Priority): When Robotics Bay is ready and
         ;; Colossi < 4, train Colossus strictly FIRST (ahead of Disruptor and ahead of Immortal
         ;; vs Bio-heavy Terran, waiving non-combat-air Stargate reserve on Medivacs!)
         (define bio-colossus-priority-now?
           (and protoss-enemy-bio-heavy?
                (memq 'robotics-bay ready-bldg-types)
                (< (l2-unit-count ctx 'colossus) 4)))
         (when (and (not protoss-midgame-charge-prism-due?)
                    (memq 'robotics-bay ready-bldg-types)
                    (< (l2-unit-count ctx 'colossus) 4)
                    (or (and bio-colossus-priority-now?
                             (not protoss-enemy-capital-air?)
                             (< protoss-live-enemy-air-cnt 4))
                        (and (aa-stargate-min-ok? (sc2-min-cost 'colossus))
                             (aa-stargate-gas-ok? (sc2-gas-cost 'colossus))))
                    (l2-can-spend-supply? ctx (sc2-supply-cost 'colossus)))
           (l2-try-train-unit! ctx 'colossus 'robotics-facility 6
                               #:respect-bo-reserve? (not (or bio-colossus-priority-now?
                                                              crisis-tech-upgrade-deferral?))))
         (when (and crisis-tech-upgrade-deferral?
                    (or (not pvt-first-observer-priority?)
                        (> cur-obs-total-now 0))
                    (p2-urgent-stalker-res-ok? (sc2-min-cost 'immortal) (sc2-gas-cost 'immortal))
                    (or (not bio-colossus-priority-now?)
                        (< (l2-ctx-gas ctx) (sc2-gas-cost 'colossus))
                        (and (>= (l2-ctx-minerals ctx) (+ (sc2-min-cost 'immortal) (sc2-min-cost 'colossus)))
                             (>= (l2-ctx-gas ctx) (+ (sc2-gas-cost 'immortal) (sc2-gas-cost 'colossus)))))
                    (l2-can-spend-supply? ctx (sc2-supply-cost 'immortal)))
           (l2-try-train-unit! ctx 'immortal 'robotics-facility 6 #:respect-bo-reserve? #f))
         (when (and (not protoss-midgame-charge-prism-due?)
                    (memq 'robotics-bay ready-bldg-types)
                    (< (l2-unit-count ctx 'disruptor) 3)
                    (or (not bio-colossus-priority-now?)
                        (and (>= (l2-ctx-minerals ctx) (+ (sc2-min-cost 'disruptor) (sc2-min-cost 'colossus)))
                             (>= (l2-ctx-gas ctx) (+ (sc2-gas-cost 'disruptor) (sc2-gas-cost 'colossus)))))
                    ;; L53-W2-2: Require at least 1 Colossus before training Disruptors so RoboticsBay
                    ;; always delivers Colossus splash first (no 0-Colossus Disruptor gas drain).
                    (>= (l2-unit-count ctx 'colossus) 1)
                    (l2-protoss-colossus-escrow-ok? ctx (sc2-min-cost 'disruptor) (sc2-gas-cost 'disruptor))
                    (aa-stargate-min-ok? (sc2-min-cost 'disruptor))
                    (aa-stargate-gas-ok? (sc2-gas-cost 'disruptor))
                    (l2-can-spend-supply? ctx (sc2-supply-cost 'disruptor)))
           (l2-try-train-unit! ctx 'disruptor 'robotics-facility 6))
         ;; W9-P0-3-rt / L36-P0-3 / L48-W2 / L51-2A / L64-B2 (Graph 18/19 PvP Immortal Cadence):
         ;; In PvP, PvZ, AND PvT (`< 2` Immortals while no Robotics Bay is ready), never let
         ;; BO/Stalker/Stargate reserve leave an idle Robotics Facility sitting empty — EXCEPT in
         ;; PvT where `Observer #1` (`25M/75G`) must ALWAYS train FIRST ahead of `Immortal #1`!
         ;; In PvP, keep idle Robo continuously pumping Immortals up to 8 (10 on >= 3 bases) once
         ;; Observer #1 isn't urgently missing under cloak threat!
         (define pvp-idle-robo-immortal-ok?
           (and live-game?
                (memq effective-enemy-race '(Protoss Zerg Terran))
                (> (hash-ref open-prod-slots 'robotics-facility 0) 0)
                (not protoss-enemy-capital-air?)
                (cond
                  [(eq? effective-enemy-race 'Terran)
                   (and (not (memq 'robotics-bay ready-bldg-types))
                        (or (>= (l2-unit-count ctx 'observer) 1)
                            (and (>= obs-trained-cnt 1)
                                 (not obs-cloak-threat-active?)))
                        (< (l2-unit-count ctx 'immortal) 2))]
                  [(eq? effective-enemy-race 'Protoss)
                   (and (or (not obs-cloak-threat-active?)
                            (>= cur-obs-total-now 1))
                        (< (l2-unit-count ctx 'immortal)
                           (if (>= (length nexuses) 3) 10 8)))]
                  [else
                   (or (not (memq 'robotics-bay ready-bldg-types))
                       (< (l2-unit-count ctx 'immortal) 3))])))
         (when (and (or (not pvt-first-observer-priority?)
                        (> cur-obs-total-now 0))
                    (not protoss-midgame-charge-prism-due?)
                    (p2-urgent-stalker-res-ok? (sc2-min-cost 'immortal) (sc2-gas-cost 'immortal))
                    (or (not bio-colossus-priority-now?)
                        (and (>= (l2-ctx-minerals ctx) (+ (sc2-min-cost 'immortal) (sc2-min-cost 'colossus)))
                             (>= (l2-ctx-gas ctx) (+ (sc2-gas-cost 'immortal) (sc2-gas-cost 'colossus)))))
                    (or crisis-tech-upgrade-deferral?
                        pvp-idle-robo-immortal-ok?
                        (and (l2-protoss-colossus-escrow-ok? ctx (sc2-min-cost 'immortal) (sc2-gas-cost 'immortal))
                             (aa-stargate-min-ok? (sc2-min-cost 'immortal))
                             (aa-stargate-gas-ok? (sc2-gas-cost 'immortal))))
                    (l2-can-spend-supply? ctx (sc2-supply-cost 'immortal)))
           (l2-try-train-unit! ctx 'immortal 'robotics-facility 6
                            #:respect-bo-reserve? (and (not crisis-tech-upgrade-deferral?)
                                                       (not pvp-idle-robo-immortal-ok?))))
         ;; W4-P0-1d-L2 / W8-P0-1-rt / W10-P0-3-rt / Loop 65B (`#1861`/`#1863`):
         ;; Count warp-prism-phasing + in-Robo-queue (976) + order-ledger pending in < 1 cap;
         ;; block Warp Prism ONLY on actual `protoss-enemy-air-pressure?` / `protoss-enemy-capital-air?`
         ;; (never on blanket `protoss-aa-needed?` / `requires-anti-air?` from Medivacs/Overseers/Observers!),
         ;; and unlock midgame 3-base Charge + >=4 WG Warp Prism (`protoss-midgame-charge-prism-due?`)!
         (when (and (< cur-warp-prism-total 1)
                    (or (not live-game?) wp-live-env-ok?)
                    (not (eq? bo-goal-sym 'immortal))
                    (or protoss-midgame-charge-prism-due?
                        (not (eq? prio-saving-for-sym 'immortal)))
                    (or protoss-midgame-charge-prism-due?
                        (and (l2-protoss-colossus-escrow-ok? ctx (sc2-min-cost 'warp-prism) (sc2-gas-cost 'warp-prism))
                             (aa-stargate-min-ok? (sc2-min-cost 'warp-prism))))
                    (or (l2-plan-wants-now? ctx 'warp-prism)
                        protoss-midgame-charge-prism-due?
                        (and live-game?
                             (>= (l2-unit-count ctx 'immortal) 1)
                             (>= live-army-supply 20)
                             (>= (l2-ctx-minerals ctx) 350)))
                    (l2-can-spend-supply? ctx (sc2-supply-cost 'warp-prism)))
           (when (l2-try-train-unit! ctx 'warp-prism 'robotics-facility 1
                                     #:respect-bo-reserve? (not protoss-midgame-charge-prism-due?))
             (when live-game?
               (when robo-st
                 (hash-set! robo-st 'wp-trained-cnt (add1 wp-trained-cnt)))
               (refractory-allow-action?! cd-tracker '(train-warp-prism) frame 896))))))
  (define protoss-corner-flyers-needed?
       (and endgame-corner-hunt?
            (< (+ (l2-unit-count ctx 'phoenix) (l2-unit-count ctx 'void-ray)) 2)))
  (when (and (or (not protoss-saving-for-expand?)
                    protoss-corner-flyers-needed?
                    protoss-enemy-capital-air?
                    protoss-air-dom-need-ground-closure?
                    protoss-aa-needed?)
                (memq 'stargate ready-bldg-types))
       (when (and (or (not protoss-saving-for-expand?)
                      protoss-enemy-capital-air?
                      protoss-air-dom-need-ground-closure?)
                  (memq 'fleet-beacon ready-bldg-types)
                  (or protoss-enemy-capital-air?
                      protoss-air-dom-need-ground-closure?
                      (l2-plan-wants-now? ctx 'tempest)
                      enemy-heavy-ground-siege?)
                  (< (l2-unit-count ctx 'tempest) (if protoss-enemy-capital-air? 12 4))
                  (or protoss-enemy-capital-air?
                      protoss-air-dom-need-ground-closure?
                      (l2-protoss-colossus-escrow-ok? ctx (sc2-min-cost 'tempest) (sc2-gas-cost 'tempest)))
                  (l2-can-spend-supply? ctx (sc2-supply-cost 'tempest)))
         (l2-try-train-unit! ctx 'tempest 'stargate 6
                          #:respect-bo-reserve? (not (or protoss-enemy-capital-air?
                                                         protoss-air-dom-need-ground-closure?))))
       (when (and (not protoss-saving-for-expand?)
                  (not protoss-enemy-capital-air?)
                  (memq 'fleet-beacon ready-bldg-types)
                  (l2-protoss-colossus-escrow-ok? ctx (sc2-min-cost 'carrier) (sc2-gas-cost 'carrier))
                  (l2-can-spend-supply? ctx (sc2-supply-cost 'carrier)))
         (l2-try-train-unit! ctx 'carrier 'stargate 6))
       (define phoenix-cap
         (cond
           [protoss-enemy-capital-air? 0]
           [protoss-air-dom-need-ground-closure? 6]
           [(and protoss-aa-needed? (>= protoss-live-enemy-air-cnt 12)) 10]
           [protoss-aa-needed? 8]
           [else 4]))
       ;; When facing light air (Mutalisk / Banshee / Phoenix), train fast Phoenixes BEFORE heavy Void Rays,
       ;; EXCEPT when `protoss-air-dom-need-ground-closure?` is active (`>= 6` Phoenixes with `< 10` ground-hitting
       ;; supply or `0` enemy ground units -> shift Stargates to building-killing Void Rays / Tempests!).
       (when (and (not protoss-air-dom-need-ground-closure?)
                  (or protoss-corner-flyers-needed?
                      (and protoss-aa-needed? (not protoss-enemy-capital-air?))
                      (l2-plan-wants-now? ctx 'phoenix))
                  (< (l2-unit-count ctx 'phoenix) phoenix-cap)
                  (or protoss-corner-flyers-needed?
                      protoss-aa-needed?
                      (and (l2-can-spend-by-priority? ctx 'phoenix 'combat-unit)
                           (l2-protoss-colossus-escrow-ok? ctx (sc2-min-cost 'phoenix) (sc2-gas-cost 'phoenix))))
                  (l2-can-spend-supply? ctx (sc2-supply-cost 'phoenix)))
         (l2-try-train-unit! ctx 'phoenix 'stargate 6
                          #:respect-bo-reserve? (not (or protoss-corner-flyers-needed? protoss-aa-needed?))))
       (when (and (or protoss-corner-flyers-needed?
                      protoss-enemy-capital-air?
                      protoss-air-dom-need-ground-closure?
                      protoss-aa-needed?
                      (l2-plan-wants-now? ctx 'void-ray)
                      (>= (l2-ctx-minerals ctx) 250))
                  (< (l2-unit-count ctx 'void-ray) (if protoss-enemy-capital-air? 10 99))
                  (or protoss-corner-flyers-needed?
                      protoss-enemy-capital-air?
                      protoss-air-dom-need-ground-closure?
                      (and protoss-aa-needed? (< (l2-unit-count ctx 'void-ray) 8))
                      (and (l2-can-spend-by-priority? ctx 'void-ray 'combat-unit)
                           (l2-protoss-colossus-escrow-ok? ctx (sc2-min-cost 'void-ray) (sc2-gas-cost 'void-ray))))
                  (l2-can-spend-supply? ctx (sc2-supply-cost 'void-ray)))
         (l2-try-train-unit! ctx 'void-ray 'stargate 6
                          #:respect-bo-reserve? (not (or protoss-corner-flyers-needed?
                                                         protoss-enemy-capital-air?
                                                         protoss-air-dom-need-ground-closure?))))
       (when (and (not protoss-saving-for-expand?)
                  (or (not live-game?)
                      (and (not protoss-aa-needed?)
                           (< live-army-supply 30)))
                  (l2-protoss-colossus-escrow-ok? ctx (sc2-min-cost 'oracle) (sc2-gas-cost 'oracle))
                  (or (< (l2-unit-count ctx 'oracle) 1)
                      (and (< (l2-unit-count ctx 'oracle) 2)
                           (>= (l2-ctx-minerals ctx) 200)
                           (>= (l2-ctx-gas ctx) 200)))
                  (l2-can-spend-supply? ctx (sc2-supply-cost 'oracle)))
