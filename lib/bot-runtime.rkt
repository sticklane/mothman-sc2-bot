;; L51-W2 (`#1262/#1263`): Suppress removed abilities (`4107` Battery Overcharge on SC2 5.0.14)
;; whenever match-start ResponseData reports `available = #f`.
(define (runtime-suppressed-live-ability-action? act)
  (and (pair? act)
       (eq? (car act) 'cast-spell)
       (pair? (cdr act))
       (pair? (cddr act))
       (eq? (caddr act) 'battery-overcharge)
       (not (sc2-ability-live-available? 4107))))

(define (l2-emit! ctx act)
  (unless (runtime-suppressed-live-ability-action? act)
    (set-l2-ctx-actions! ctx (cons act (l2-ctx-actions ctx)))))

(define (l2-building-grounded-and-powered? ctx b)
    (if (hash? b)
        (let* ([raw-sym (unit-type-sym b)]
               [canon-sym (fast-canonical-structure-sym raw-sym)])
          (and (not (eq? (hash-ref b 'flying? #f) #t))
               (not (memq raw-sym
                          '(barracks-flying factory-flying starport-flying
                            command-center-flying orbital-command-flying
                            spine-crawler-uprooted spore-crawler-uprooted)))
               (or (not (sc2-structure-requires-pylon-power? canon-sym))
                   (not (eq? (hash-ref b 'powered? #t) #f)))))
        #t))

(define (l2-unit-stasis-frozen? ctx u)
    (define b (hash-ref u 'buffs '()))
    (and (list? b)
         (or (memq 'oracle-stasis-trap-target b)
             (memq 'stasis-ward-target b))))

(define (l2-compute-race-ideal-worker-cap ctx bases)
  (define ally-bldgs (l2-ctx-ally-bldgs ctx))
  (define base-x (l2-ctx-base-x ctx))
  (define base-y (l2-ctx-base-y ctx))
  (define step-neutral-units (l2-ctx-step-neutral-units ctx))
  (define race-max (race-macro-worker-cap (l2-ctx-race ctx)))
    (define n-bases (length bases))
    (define fallback-cap (min race-max (* SC2-IDEAL-WORKERS-PER-BASE (max 1 n-bases))))
    (cond
      [(or (null? bases)
           (null? step-neutral-units))
       fallback-cap]
      [else
       (define raw-cap
         (for/sum ([th (in-list bases)])
           (define thx (hash-ref th 'x base-x))
           (define thy (hash-ref th 'y base-y))
           (define thid (hash-ref th 'id 0))
           (define prof
             (compute-base-optimal-worker-allocation
              thx thy step-neutral-units ally-bldgs thid))
           (define pcnt (BaseResourceProfile-patch-count prof))
           (define gcnt (+ (BaseResourceProfile-gold-patch-count prof)
                           (BaseResourceProfile-rich-geyser-count prof)))
           (define vcnt (BaseResourceProfile-geyser-count prof))
           (cond
             [(and (< pcnt 4)
                   (= gcnt 0)
                   (not (and (>= n-bases 3) (>= vcnt 1))))
              SC2-IDEAL-WORKERS-PER-BASE]
             [else
              (max 0 (BaseResourceProfile-optimal-total-workers prof))])))
       (min race-max (max (if (<= n-bases 1) SC2-IDEAL-WORKERS-PER-BASE 0) raw-cap))]))

(define (l2-enemy-early-pool-detected? ctx)
  (define frame (l2-ctx-frame ctx))
  (define enemy-bldgs (or (l2-ctx-enemy-bldgs ctx) '()))
  (define enemy-units (or (l2-ctx-enemy-units ctx) '()))
  (and (< frame 3200)
       (let ([pool-seen?
              (ormap (lambda (eb)
                       (and (hash? eb)
                            (eq? (fast-canonical-structure-sym (unit-type-sym eb)) 'spawning-pool)
                            (or (< frame 1650)
                                (>= (hash-ref eb 'build-progress 0.0) 0.85))))
                     enemy-bldgs)]
             [early-ling-seen?
              (and (< frame 2900)
                   (ormap (lambda (e)
                            (and (hash? e)
                                 (eq? (fast-canonical-unit-sym (unit-type-sym e)) 'zergling)))
                          enemy-units))]
             [enemy-hatch-cnt
              (count (lambda (eb)
                       (and (hash? eb)
                            (memq (fast-canonical-structure-sym (unit-type-sym eb)) '(hatchery lair hive))))
                     enemy-bldgs)])
         (and (<= enemy-hatch-cnt 1)
              (or pool-seen? early-ling-seen?)))))

(define (l2-offset-defense-anchor ctx anchor-x anchor-y [min-dist 5.5])
  (define enemy-x (l2-ctx-enemy-x ctx))
  (define enemy-y (l2-ctx-enemy-y ctx))
  (define nat-x (l2-ctx-nat-x ctx))
  (define nat-y (l2-ctx-nat-y ctx))
  (define third-x (l2-ctx-third-x ctx))
  (define third-y (l2-ctx-third-y ctx))
    (geo:offset-defense-anchor anchor-x anchor-y enemy-x enemy-y min-dist
                               (list (cons nat-x nat-y) (cons third-x third-y))))

(define (l2-enemy-hostile-near-point? ctx px py [radius 16.0])
  (define enemy-units (l2-ctx-enemy-units ctx))
    (or (ormap (lambda (e)
                 (and (combat-unit-record? e)
                      (sc2-enemy-unit-targetable? (unit-type-sym e))
                      (<= (dist2d px py (hash-ref e 'x 9999.0) (hash-ref e 'y 9999.0)) radius)))
               enemy-units)
        (>= (count (lambda (e)
                     (and (memq (unit-type-sym e) '(probe scv drone))
                          (not (eq? (hash-ref e 'hallucination? #f) #t))
                          (not (eq? (hash-ref e 'hallucination #f) #t))
                          (<= (dist2d px py (hash-ref e 'x 9999.0) (hash-ref e 'y 9999.0)) radius)))
                   enemy-units)
            SC2-WORKER-RUSH-MIN-ENEMY-WORKERS)))

(define (l2-find-uncontested-zerg-hatchery ctx)
  (define ally-bldgs (l2-ctx-ally-bldgs ctx))
  (define base-x (l2-ctx-base-x ctx))
  (define base-y (l2-ctx-base-y ctx))
    (if (eq? (l2-ctx-uncontested-zerg-hatch-cache ctx) 'uninit)
        (let ([res (and (l2-enemy-hostile-near-point? ctx base-x base-y 16.0)
                        (for/first ([b (in-list ally-bldgs)]
                                    #:when (and (memq (fast-canonical-structure-sym (unit-type-sym b))
                                                      '(hatchery lair hive))
                                                (>= (hash-ref b 'build-progress 1.0) SC2-BUILD-COMPLETE-PROGRESS)
                                                (let ([hx (hash-ref b 'x base-x)]
                                                      [hy (hash-ref b 'y base-y)])
                                                  (and (> (dist2d base-x base-y hx hy) 8.0)
                                                       (not (l2-enemy-hostile-near-point? ctx hx hy 16.0))))))
                          b))])
          (set-l2-ctx-uncontested-zerg-hatch-cache! ctx res)
          res)
        (l2-ctx-uncontested-zerg-hatch-cache ctx)))

(define (l2-safe-zerg-build-anchor ctx default-x default-y)
    (define safe-h (l2-find-uncontested-zerg-hatchery ctx))
    (if safe-h
        (l2-interior-offset ctx 3.5 0.0
                            (exact->inexact (hash-ref safe-h 'x default-x))
                            (exact->inexact (hash-ref safe-h 'y default-y)))
        (values default-x default-y)))

;; L19-P0-3 / L20-P0-3 (`#43 ZvP` & `#16 ZvT` Spire / Roach Warren drop): Creep-ring placement
;; fallback scanning ALL ready Hatcheries/Lairs/Hives (uncontested first, radii 4.5t/6.5t/8.0t,
;; 12 rotating angles, plus relaxed-clearance pass when main creep is crowded) avoiding buildings,
;; minerals, geysers, reserved sites, and enemy combat so Zerg tech always lands on valid creep!
(define (l2-zerg-creep-ring-anchor ctx default-x default-y [retry-offset 0])
  (define ally-bldgs (l2-ctx-ally-bldgs ctx))
  (define base-x (l2-ctx-base-x ctx))
  (define base-y (l2-ctx-base-y ctx))
  (define enemy-units (l2-ctx-enemy-units ctx))
  (define frame (l2-ctx-frame ctx))
  (define live-game-obs? (l2-ctx-live-game-obs? ctx))
  (define map-grids (l2-ctx-map-grids ctx))
  (define oledger (or (l2-ctx-oledger ctx) (l2-ctx-oledger-early ctx)))
  (define step-mps (l2-ctx-step-mineral-patches ctx))
  (define step-geysers (l2-ctx-step-geysers ctx))
  (define mg-w (if (hash? map-grids) (exact-floor (safe-finite-real (hash-ref map-grids 'width 256) 256.0)) 0))
  (define mg-h (if (hash? map-grids) (exact-floor (safe-finite-real (hash-ref map-grids 'height 256) 256.0)) 0))
  (define mg-bref
    (let ([p (and (hash? map-grids)
                  (or (hash-ref map-grids 'placement-ref #f)
                      (hash-ref map-grids 'placement-pred #f)))])
      (and (procedure? p) (procedure-arity-includes? p 2) (> mg-w 0) (> mg-h 0) p)))
  (define mg-href
    (let ([p (and (hash? map-grids)
                  (or (hash-ref map-grids 'height-ref #f)
                      (hash-ref map-grids 'height-pred #f)))])
      (and (procedure? p) (procedure-arity-includes? p 2) (> mg-w 0) (> mg-h 0) p)))
  (define (grid-positive-cell? v)
    (cond [(boolean? v) v] [(real? v) (> v 0)] [else #f]))
  ;; L22-P0-3 (`#28` Spire 7x drop): Verify candidate tiles on `placement-grid` & Hatchery plateau
  ;; `height-grid` so Zerg creep-ring anchors never pick cliff edges / unbuildable ramp tiles!
  (define (cand-grid-buildable? cx cy hx hy half-span)
    (if (not mg-bref)
        #t
        (let* ([ix0 (exact-floor (- cx half-span))]
               [ix1 (exact-floor (+ cx half-span))]
               [iy0 (exact-floor (- cy half-span))]
               [iy1 (exact-floor (+ cy half-span))]
               [hh (and mg-href
                        (let ([hix (max 0 (min (sub1 mg-w) (exact-floor hx)))]
                              [hiy (max 0 (min (sub1 mg-h) (exact-floor hy)))])
                          (let ([v (mg-href hix hiy)])
                            (and (real? v) (exact->inexact v)))))])
          (and (>= ix0 1) (< ix1 (sub1 mg-w))
               (>= iy0 1) (< iy1 (sub1 mg-h))
               (for*/and ([ix (in-range ix0 (add1 ix1))]
                          [iy (in-range iy0 (add1 iy1))])
                 (and (grid-positive-cell? (mg-bref ix iy))
                      (or (not hh)
                          (let ([hv (mg-href ix iy)])
                            (or (not (real? hv))
                                (<= (abs (- (exact->inexact hv) hh)) 2.0))))))))))
  (define ready-hatches
    (filter (lambda (b)
              (and (hash? b)
                   (memq (fast-canonical-structure-sym (unit-type-sym b))
                         '(hatchery lair hive))
                   (>= (hash-ref b 'build-progress 1.0) SC2-BUILD-COMPLETE-PROGRESS)))
            ally-bldgs))
  (define ordered-hatches
    (sort ready-hatches
          (lambda (a b)
            (define ax (hash-ref a 'x base-x))
            (define ay (hash-ref a 'y base-y))
            (define bx (hash-ref b 'x base-x))
            (define by (hash-ref b 'y base-y))
            (define a-hot? (and live-game-obs? (l2-enemy-hostile-near-point? ctx ax ay 16.0)))
            (define b-hot? (and live-game-obs? (l2-enemy-hostile-near-point? ctx bx by 16.0)))
            (cond
              [(and (not a-hot?) b-hot?) #t]
              [(and a-hot? (not b-hot?)) #f]
              [else (< (fast-dist2d base-x base-y ax ay)
                       (fast-dist2d base-x base-y bx by))]))))
  (define active-rsites
    (if oledger
        (filter (lambda (rs) (<= frame (reserved-build-site-expires-frame rs)))
                (in-progress-order-ledger-reserved-sites oledger))
        '()))
  (define start-idx (modulo (+ (max 0 retry-offset) (quotient (max 0 frame) 12)) 12))
  (define (cand-clear? cx cy hx hy bldg-clr res-clr rs-clr half-span)
    (and (cand-grid-buildable? cx cy hx hy half-span)
         (or (not live-game-obs?)
             (and (not (l2-active-enemy-combat-within? enemy-units cx cy 12.0))
                  (not (l2-site-recently-contested? ctx cx cy 10.0))))
         (for/and ([ab (in-list ally-bldgs)] #:when (hash? ab))
           (>= (fast-dist2d cx cy (hash-ref ab 'x 9999.0) (hash-ref ab 'y 9999.0)) bldg-clr))
         (for/and ([mp (in-list step-mps)] #:when (hash? mp))
           (>= (fast-dist2d cx cy (hash-ref mp 'x 9999.0) (hash-ref mp 'y 9999.0)) res-clr))
         (for/and ([gy (in-list step-geysers)] #:when (hash? gy))
           (>= (fast-dist2d cx cy (hash-ref gy 'x 9999.0) (hash-ref gy 'y 9999.0)) res-clr))
         (for/and ([rs (in-list active-rsites)])
           (>= (fast-dist2d cx cy (reserved-build-site-x rs) (reserved-build-site-y rs)) rs-clr))))
  (define (search-pass bldg-clr res-clr rs-clr half-span)
    (for*/first ([h (in-list ordered-hatches)]
                 [rad (in-list '(4.5 5.5 6.5 7.5 8.5))]
                 [step-i (in-range 12)]
                 #:do [(define hx (exact->inexact (hash-ref h 'x base-x)))
                       (define hy (exact->inexact (hash-ref h 'y base-y)))
                       (define ang (* (modulo (+ start-idx step-i) 12) (/ pi 6.0)))
                       (define cx (safe-coord (+ hx (* rad (cos ang))) default-x))
                       (define cy (safe-coord (+ hy (* rad (sin ang))) default-y))]
                 #:when (cand-clear? cx cy hx hy bldg-clr res-clr rs-clr half-span))
      (cons cx cy)))
  (define found
    (or (search-pass 3.4 3.2 3.0 1.0)
        (search-pass 2.8 2.6 2.4 0.75)))
  (if found
      (values (car found) (cdr found))
      (l2-safe-zerg-build-anchor ctx default-x default-y)))

;; Compute SC2 under-construction vitality metrics including shields.
;; Unfinished buildings start at 10% vitality and ramp linearly to 100%:
;;   expected = 0.10 + 0.90 * build_progress.
(define (l2-bldg-shield-inclusive-vitality-pct b)
  (define raw-prog (hash-ref b 'build-progress SANITIZE-MISSING))
  (define prog
    (if (eq? raw-prog SANITIZE-MISSING)
        (if (hash-ref b 'under-construction #f) 0.5 1.0)
        raw-prog))
  (define hull-present? (not (eq? (hash-ref b 'hull-hp SANITIZE-MISSING) SANITIZE-MISSING)))
  (define hp (max 0.0 (exact->inexact (hash-ref b 'hp 100))))
  (define max-hp (max 0.0 (exact->inexact (hash-ref b 'max-hp 500))))
  (define shield
    (if hull-present?
        0.0
        (max 0.0 (exact->inexact (hash-ref b 'shield (hash-ref b 'shields 0))))))
  (define max-shield
    (if hull-present?
        0.0
        (max 0.0 (exact->inexact (hash-ref b 'max-shield
                                           (hash-ref b 'shield-max (hash-ref b 'max-shields 0)))))))
  (define vitality-pct (/ (+ hp shield) (max 1.0 (+ max-hp max-shield))))
  (define expected-vitality-pct (+ 0.10 (* 0.90 prog)))
  (values prog vitality-pct expected-vitality-pct))

(define (l2-enemy-weapon-attacker-within? bx by radius enemy-units)
  (define r2 (* radius radius))
  (define bx-fl (exact->inexact bx))
  (define by-fl (exact->inexact by))
  (for/or ([e (in-list enemy-units)])
    (and (hash? e)
         (let ([et (unit-type-sym e)])
           (and (fast-enemy-unit-targetable? et)
                (not (hash-ref NON-COMBAT-AND-SCOUT-ENEMY-HT et #f))
                (or (fast-can-attack-ground? et)
                    (fast-can-attack-air? et))
                (let ([dx (- bx-fl (exact->inexact (hash-ref e 'x 9999.0)))]
                      [dy (- by-fl (exact->inexact (hash-ref e 'y 9999.0)))])
                  (<= (+ (* dx dx) (* dy dy)) r2)))))))

(define (l2-in-progress-bldg-dying? b enemy-units base-x base-y live-game?
                                     #:min-prog [min-prog 0.08]
                                     #:max-vit [max-vit 0.12])
  (define-values (prog vitality-pct expected-vitality-pct)
    (l2-bldg-shield-inclusive-vitality-pct b))
  (and (< prog SC2-BUILD-COMPLETE-PROGRESS)
       (> prog min-prog)
       (< vitality-pct (* 0.30 expected-vitality-pct))
       (or (not max-vit) (< vitality-pct max-vit))
       (let ([bx (hash-ref b 'x base-x)]
             [by (hash-ref b 'y base-y)])
         (or (and (not live-game?) (eq? (hash-ref b 'under-attack #f) #t))
             (l2-enemy-weapon-attacker-within? bx by 8.5 enemy-units)))))

(define (l2-combat-supply-within? units bx by radius enemy?)
  (define r2 (* radius radius))
  (define bx-fl (exact->inexact bx))
  (define by-fl (exact->inexact by))
  (for/fold ([sup 0.0]) ([u (in-list units)])
    (if (hash? u)
        (let* ([ut (unit-type-sym u)]
               [ct (fast-canonical-unit-sym ut)]
               [combat?
                (if enemy?
                    (and (fast-enemy-unit-targetable? ut)
                         (not (hash-ref NON-COMBAT-AND-SCOUT-ENEMY-HT ut #f))
                         (not (combat-unit-excluded-sym? ut)))
                    (or (eq? ct 'queen)
                        (and (not (combat-unit-excluded-sym? ut))
                             (not (eq? (hash-ref u 'is-hallucination #f) #t))
                             (not (eq? (hash-ref u 'hallucination #f) #t))
                             (not (eq? (hash-ref u 'hallucination? #f) #t)))))])
          (if combat?
              (let ([dx (- bx-fl (exact->inexact (hash-ref u 'x 9999.0)))]
                    [dy (- by-fl (exact->inexact (hash-ref u 'y 9999.0)))])
                (if (<= (+ (* dx dx) (* dy dy)) r2)
                    (+ sup (max 0.5 (exact->inexact (sc2-supply-cost ct))))
                    sup))
              sup))
        sup)))

(define (l2-active-enemy-combat-within? enemy-units x y radius)
  (and (list? enemy-units)
       (pair? enemy-units)
       (let ([fx (exact->inexact x)]
             [fy (exact->inexact y)]
             [r2 (fl* (exact->inexact radius) (exact->inexact radius))])
         (for/or ([e (in-list enemy-units)])
           (and (hash? e)
                (combat-unit-record? e)
                (let ([ut (unit-type-sym e)])
                  (not (memq ut '(drone probe scv overlord overseer observer changeling
                                  changeling-zealot changeling-marine changeling-marine-shield
                                  changeling-zergling changeling-zergling-wings larva egg))))
                (let ([dx (fl- fx (exact->inexact (hash-ref e 'x 9999.0)))]
                      [dy (fl- fy (exact->inexact (hash-ref e 'y 9999.0)))])
                  (fl<= (fl+ (fl* dx dx) (fl* dy dy)) r2)))))))

;; W5-P0-1c-rt: Escalate contested-site TTL & radius on repeated cancels/losses at the same base
;; (strike 1: 336f/10t; strike 2: 1008f/14t; strike >=3: 2016f/16t) so static defense like
;; SporeCrawler is never rebuilt and self-canceled 11x on the same contested tile.
(define (l2-contested-site-strikes rec)
  (if (and (vector? rec) (>= (vector-length rec) 4))
      (vector-ref rec 3)
      1))

(define (l2-contested-site-ttl strikes)
  (cond
    [(>= strikes 3) 2016]
    [(= strikes 2) 1008]
    [else 336]))

(define (l2-record-contested-site! ctx canon-sym x y)
  (define cd-tracker (l2-ctx-cd-tracker ctx))
  (define frame (l2-ctx-frame ctx))
  (when (and (refractory-cooldown-tracker? cd-tracker)
             (hash? (refractory-cooldown-tracker-table cd-tracker)))
    (define tbl (refractory-cooldown-tracker-table cd-tracker))
    (define fx (exact->inexact x))
    (define fy (exact->inexact y))
    (define prev-sym-rec (hash-ref tbl (list 'contested-cancel-site canon-sym) #f))
    (define sym-strikes
      (if (and (vector? prev-sym-rec)
               (< (- frame (vector-ref prev-sym-rec 2)) 2688)
               (let ([dx (fl- fx (vector-ref prev-sym-rec 0))]
                     [dy (fl- fy (vector-ref prev-sym-rec 1))])
                 (fl<= (fl+ (fl* dx dx) (fl* dy dy)) 196.0)))
          (min 5 (add1 (l2-contested-site-strikes prev-sym-rec)))
          1))
    (define old-sites
      (filter (lambda (rec) (and (vector? rec) (< (- frame (vector-ref rec 2)) 2688)))
              (hash-ref tbl 'contested-cancel-sites '())))
    (define near-strikes
      (for/fold ([mx sym-strikes]) ([rec (in-list old-sites)])
        (define dx (fl- fx (vector-ref rec 0)))
        (define dy (fl- fy (vector-ref rec 1)))
        (if (fl<= (fl+ (fl* dx dx) (fl* dy dy)) 196.0)
            (max mx (min 5 (add1 (l2-contested-site-strikes rec))))
            mx)))
    (define new-rec (vector fx fy frame near-strikes))
    (hash-set! tbl (list 'contested-cancel-site canon-sym) new-rec)
    (hash-set! tbl 'contested-cancel-sites
               (cons new-rec (take old-sites (min 14 (length old-sites)))))))

(define (l2-site-recently-contested? ctx x y [radius 10.0])
  (define cd-tracker (l2-ctx-cd-tracker ctx))
  (define frame (l2-ctx-frame ctx))
  (and (refractory-cooldown-tracker? cd-tracker)
       (hash? (refractory-cooldown-tracker-table cd-tracker))
       (let ([sites (hash-ref (refractory-cooldown-tracker-table cd-tracker) 'contested-cancel-sites '())]
             [fx (exact->inexact x)]
             [fy (exact->inexact y)]
             [base-r (exact->inexact radius)])
         (for/or ([rec (in-list sites)])
           (and (vector? rec)
                (let* ([st (l2-contested-site-strikes rec)]
                       [ttl (l2-contested-site-ttl st)]
                       [eff-r (cond [(>= st 3) (flmax base-r 16.0)]
                                    [(= st 2) (flmax base-r 14.0)]
                                    [else base-r])])
                  (and (< (- frame (vector-ref rec 2)) ttl)
                       (let ([dx (fl- fx (vector-ref rec 0))]
                             [dy (fl- fy (vector-ref rec 1))])
                         (fl<= (fl+ (fl* dx dx) (fl* dy dy)) (fl* eff-r eff-r))))))))))

(define (l2-save-cancel-rebuild-ready? ctx bldg-sym [cooldown-frames 60] #:bldg [b #f])
  (define cd-tracker (l2-ctx-cd-tracker ctx))
  (define frame (l2-ctx-frame ctx))
  (define race (l2-ctx-race ctx))
  (define cs (fast-canonical-structure-sym bldg-sym))
  (define cancel-cd-key (fast-save-cancel-rebuild-key cs))
  (define cd-tbl
    (and (refractory-cooldown-tracker? cd-tracker)
         (hash? (refractory-cooldown-tracker-table cd-tracker))
         (refractory-cooldown-tracker-table cd-tracker)))
  (define last-cancel-f (and cd-tbl (hash-ref cd-tbl cancel-cd-key #f)))
  (define csite (and cd-tbl (hash-ref cd-tbl (list 'contested-cancel-site cs) #f)))
  ;; When enemy combat units are still actively contesting the canceled/destroyed site
  ;; (or the site suffered repeated cancels/losses), apply escalating rebuild backoff so
  ;; destroyed/canceled buildings are never fed back into active enemy fire (#5134177 / W5-P0-1c).
  (define csite-strikes (if (vector? csite) (l2-contested-site-strikes csite) 0))
  (define site-contested-now?
    (and (vector? csite)
         (< (- frame (vector-ref csite 2)) (l2-contested-site-ttl csite-strikes))
         (l2-active-enemy-combat-within? (l2-ctx-enemy-units ctx)
                                         (vector-ref csite 0)
                                         (vector-ref csite 1)
                                         12.0)))
  (define repeat-cancel-cooldown
    (cond
      [(>= csite-strikes 3) 1344]
      [(= csite-strikes 2) 672]
      [else 0]))
  (define eff-cooldown
    (max cooldown-frames
         repeat-cancel-cooldown
         (if site-contested-now? (l2-contested-site-ttl csite-strikes) 0)))
  (define bldg-cancel-ok?
    (or (not (hash? b))
        (l2-in-progress-bldg-dying? b
                                    (l2-ctx-enemy-units ctx)
                                    (l2-ctx-base-x ctx)
                                    (l2-ctx-base-y ctx)
                                    (l2-ctx-live-game? ctx)
                                    #:min-prog 0.10
                                    #:max-vit #f)))
  (and bldg-cancel-ok?
       (if (not (exact-integer? last-cancel-f))
           #t
           (let ([elapsed (- frame last-cancel-f)])
             (if (not (eq? race 'Zerg))
                 (>= elapsed eff-cooldown)
                 (cond
                   [(>= elapsed (max 16 eff-cooldown)) #t]
                   [(< elapsed (min 16 eff-cooldown)) #f]
                   [else
                    (>= elapsed (if (and (not site-contested-now?)
                                         (l2-find-uncontested-zerg-hatchery ctx))
                                    16
                                    eff-cooldown))]))))))

(define (l2-enemy-bldg-is-proxy? ctx eb)
  (define early-enemy-nat-x (l2-ctx-early-enemy-nat-x ctx))
  (define early-enemy-nat-y (l2-ctx-early-enemy-nat-y ctx))
  (define early-enemy-third-x (l2-ctx-early-enemy-third-x ctx))
  (define early-enemy-third-y (l2-ctx-early-enemy-third-y ctx))
  (define enemy-x (l2-ctx-enemy-x ctx))
  (define enemy-y (l2-ctx-enemy-y ctx))
  (define frame (l2-ctx-frame ctx))
    (cond
      [(and (hash? eb) (hash-has-key? eb 'is-proxy?))
       (eq? (hash-ref eb 'is-proxy? #f) #t)]
      [(not (and (hash? eb) (hash-has-key? eb 'x) (hash-has-key? eb 'y)))
       #f]
      [else
       (define canon (fast-canonical-structure-sym (unit-type-sym eb)))
       (define ebx (exact->inexact (hash-ref eb 'x 9999.0)))
       (define eby (exact->inexact (hash-ref eb 'y 9999.0)))
       (define dx-e (- ebx enemy-x))
       (define dy-e (- eby enemy-y))
       (define dx-n (- ebx early-enemy-nat-x))
       (define dy-n (- eby early-enemy-nat-y))
       (define dx-3 (- ebx early-enemy-third-x))
       (define dy-3 (- eby early-enemy-third-y))
       (and (not (memq canon '(creep-tumor creep-tumor-burrowed creep-tumor-queen
                               oracle-stasis-trap stasis-ward auto-turret)))
            (not (and (>= frame 3360)
                      (memq canon '(hatchery lair hive nexus command-center orbital-command planetary-fortress))))
            (> (+ (* dx-e dx-e) (* dy-e dy-e)) 784.0)
            (> (+ (* dx-n dx-n) (* dy-n dy-n)) 784.0)
            (> (+ (* dx-3 dx-3) (* dy-3 dy-3)) 784.0))]))

(define (l2-raw-eb-explicit-build-progress? ctx eb)
  (define raw-enemy-bldgs-early (l2-ctx-raw-enemy-bldgs-early ctx))
    (define eid (hash-ref eb 'id #f))
    (define raw-match
      (and eid
           (findf (lambda (rb)
                    (and (hash? rb)
                         (equal? (hash-ref rb 'id #f) eid)))
                  raw-enemy-bldgs-early)))
    (and raw-match (hash-has-key? raw-match 'build-progress)))

(define (l2-pad-hash-list-xy-sum ctx xs acc)
    (for/fold ([s acc]) ([u (in-list xs)])
      (if (hash? u)
          (let ([ux (hash-ref u 'x 0.0)]
                [uy (hash-ref u 'y 0.0)])
            (fl+ s (fl+ (if (real? ux) (exact->inexact ux) 0.0)
                        (if (real? uy) (exact->inexact uy) 0.0))))
          s)))

(define (l2-pad-cands-xy-sum ctx pads acc)
    (for/fold ([s acc]) ([p (in-list pads)])
      (cond
        [(pair? p)
         (cond
           [(and (real? (car p)) (real? (cdr p)))
            (fl+ s (fl+ (exact->inexact (car p)) (exact->inexact (cdr p))))]
           [(and (real? (car p)) (pair? (cdr p)) (real? (cadr p)))
            (fl+ s (fl+ (exact->inexact (car p)) (exact->inexact (cadr p))))]
           [else s])]
        [(hash? p)
         (let ([px (hash-ref p 'x 0.0)]
               [py (hash-ref p 'y 0.0)])
           (fl+ s (fl+ (if (real? px) (exact->inexact px) 0.0)
                       (if (real? py) (exact->inexact py) 0.0))))]
        [else s])))

(define (l2-pad-core-xy-sig ctx)
  (let* ([sc (l2-ctx-l2-sc ctx)]
         [cached (and sc (hash-ref sc 'pad-core-xy-sig #f))])
    (or cached
        (let* ([ac (l2-ctx-ally-combat-units ctx)]
               [eb (l2-ctx-enemy-bldgs ctx)]
               [eu (l2-ctx-enemy-units ctx)]
               [n-ac (length ac)]
               [n-eb (length eb)]
               [n-eu (length eu)]
               [s (l2-pad-hash-list-xy-sum
                   ctx ac
                   (l2-pad-hash-list-xy-sum
                    ctx eb
                    (l2-pad-hash-list-xy-sum ctx eu 0.0)))]
               [v (vector n-ac n-eb n-eu s)])
          (when sc (hash-set! sc 'pad-core-xy-sig v))
          v))))

(define (l2-pad-camped-posterior ctx px py [radius 11.5])
  (define ally-combat-units (l2-ctx-ally-combat-units ctx))
  (define base-x (l2-ctx-base-x ctx))
  (define base-y (l2-ctx-base-y ctx))
  (define enemy-bldgs (l2-ctx-enemy-bldgs ctx))
  (define enemy-units (l2-ctx-enemy-units ctx))
  (define enemy-x (l2-ctx-enemy-x ctx))
  (define enemy-y (l2-ctx-enemy-y ctx))
  (define live-obs-harvesters? (l2-ctx-live-obs-harvesters? ctx))
  (define mmstate-rush-post (l2-ctx-mmstate-rush-post ctx))
    (cond
      [(and (l2-ctx-pad-last-px ctx) (equal? px (l2-ctx-pad-last-px ctx)) (equal? py (l2-ctx-pad-last-py ctx)) (equal? radius (l2-ctx-pad-last-r ctx)))
       (l2-ctx-pad-last-val ctx)]
      [(and (l2-ctx-pad-camped-cache ctx) (hash-ref (l2-ctx-pad-camped-cache ctx) (cons px (cons py radius)) #f))
       => values]
      [else
       (define frame (l2-ctx-frame ctx))
       (define rt (l2-ctx-rt ctx))
       (define persist-tbl
         (and live-obs-harvesters?
              rt
              (hash-ref! (rt-door-state rt) 'pad-camped-persist make-hash)))
       (define key (and persist-tbl (list px py radius)))
       (define pentry (and persist-tbl (hash-ref persist-tbl key #f)))
       (define ttl-limit (if (= (modulo frame 16) 8) 24 16))
       (define core-sig (and persist-tbl (l2-pad-core-xy-sig ctx)))
       (define persist-hit?
         (and (vector? pentry)
              (>= frame (vector-ref pentry 0))
              (< (- frame (vector-ref pentry 0)) ttl-limit)
              (= base-x (vector-ref pentry 1))
              (= base-y (vector-ref pentry 2))
              (= enemy-x (vector-ref pentry 3))
              (= enemy-y (vector-ref pentry 4))
              (equal? mmstate-rush-post (vector-ref pentry 5))
              (= (vector-ref core-sig 0) (vector-ref pentry 6))
              (= (vector-ref core-sig 1) (vector-ref pentry 7))
              (= (vector-ref core-sig 2) (vector-ref pentry 8))
              (fl= (vector-ref core-sig 3) (vector-ref pentry 9))))
       (define res
         (if persist-hit?
             (vector-ref pentry 10)
             (let ()
               (define fpx (if (flonum? px) px (exact->inexact px)))
               (define fpy (if (flonum? py) py (exact->inexact py)))
               (define r (if (flonum? radius) radius (exact->inexact radius)))
               (define r2 (fl* r r))
               (define camp-bldg?
                 (for/or ([eb (in-list enemy-bldgs)])
                   (let ([canon (fast-canonical-structure-sym (unit-type-sym eb))])
                     (and (or (memq canon '(photon-cannon bunker planetary-fortress spine-crawler
                                                          hatchery lair hive nexus command-center orbital-command))
                              (memq canon SC2-TOWNHALL-STRUCTURE-SYMS))
                          (let ([dx (fl- fpx (exact->inexact (hash-ref eb 'x 9999.0)))]
                                [dy (fl- fpy (exact->inexact (hash-ref eb 'y 9999.0)))])
                            (fl<= (fl+ (fl* dx dx) (fl* dy dy)) r2))))))
               (define camp-combat-cnt
                 (for/sum ([e (in-list enemy-units)])
                   (if (combat-unit-record? e)
                       (let ([dx (fl- fpx (exact->inexact (hash-ref e 'x 9999.0)))]
                             [dy (fl- fpy (exact->inexact (hash-ref e 'y 9999.0)))])
                         (if (fl<= (fl+ (fl* dx dx) (fl* dy dy)) r2) 1 0))
                       0)))
               (define ally-near-cnt
                 (for/sum ([a (in-list ally-combat-units)])
                   (let ([dx (fl- fpx (exact->inexact (hash-ref a 'x base-x)))]
                         [dy (fl- fpy (exact->inexact (hash-ref a 'y base-y)))])
                     (if (fl<= (fl+ (fl* dx dx) (fl* dy dy)) 196.0) 1 0))))
               (define v
                 (compute-bayesian-pad-camped-posterior
                  #:camp-building-observed? camp-bldg?
                  #:enemy-combat-count camp-combat-cnt
                  #:ally-defender-count ally-near-cnt
                  #:total-ally-combat-count (if core-sig (vector-ref core-sig 0) (length ally-combat-units))
                  #:live-obs? live-obs-harvesters?
                  #:dist-to-our-base (fast-dist2d px py base-x base-y)
                  #:dist-to-enemy-base (fast-dist2d px py enemy-x enemy-y)
                  #:rush-posterior mmstate-rush-post))
               (when persist-tbl
                 (hash-set! persist-tbl
                            key
                            (vector frame base-x base-y enemy-x enemy-y mmstate-rush-post
                                    (vector-ref core-sig 0) (vector-ref core-sig 1)
                                    (vector-ref core-sig 2) (vector-ref core-sig 3)
                                    v)))
               v)))
       (if (not (l2-ctx-pad-last-px ctx))
           (begin
             (set-l2-ctx-pad-last-px! ctx px)
             (set-l2-ctx-pad-last-py! ctx py)
             (set-l2-ctx-pad-last-r! ctx radius)
             (set-l2-ctx-pad-last-val! ctx res))
           (begin
             (unless (l2-ctx-pad-camped-cache ctx) (set-l2-ctx-pad-camped-cache! ctx (make-hash)))
             (hash-set! (l2-ctx-pad-camped-cache ctx) (cons px (cons py radius)) res)))
       res]))

(define (l2-pad-camped-by-enemy? ctx px py [radius 11.5])
    (>= (l2-pad-camped-posterior ctx px py radius) 0.55))

(define (l2-any-natural-blocker? ctx)
  (define enemy-bldgs (l2-ctx-enemy-bldgs ctx))
  (define enemy-units (l2-ctx-enemy-units ctx))
  (define nat-block-thresh2 (l2-ctx-nat-block-thresh2 ctx))
  (define nat-x (l2-ctx-nat-x ctx))
  (define nat-y (l2-ctx-nat-y ctx))
    (define nx (exact->inexact nat-x))
    (define ny (exact->inexact nat-y))
    (define-syntax-rule (blocker-in-list? lst)
      (for/or ([e (in-list lst)])
        (define dx (fl- nx (exact->inexact (hash-ref e 'x 9999))))
        (define dy (fl- ny (exact->inexact (hash-ref e 'y 9999))))
        (fl<= (fl+ (fl* dx dx) (fl* dy dy)) nat-block-thresh2)))
    (or (blocker-in-list? enemy-units)
        (blocker-in-list? enemy-bldgs)))

(define (l2-record-expand-pad-issued! ctx px py)
  (define rt (l2-ctx-rt ctx))
  (when (and (l2-ctx-live-obs-harvesters? ctx)
             (real? px)
             (real? py))
    (hash-set! (rt-door-state rt)
               'last-exp-pad-rec
               (vector (l2-ctx-frame ctx)
                       (l2-ctx-active-bases ctx)
                       (exact->inexact px)
                       (exact->inexact py)))))

(define (l2-select-uncamped-expansion-pad ctx [prefer-natural? #f])
  (define active-bases (l2-ctx-active-bases ctx))
  (define ally-combat-units (l2-ctx-ally-combat-units ctx))
  (define base-x (l2-ctx-base-x ctx))
  (define base-y (l2-ctx-base-y ctx))
  (define enemy-bldgs (l2-ctx-enemy-bldgs ctx))
  (define enemy-units (l2-ctx-enemy-units ctx))
  (define enemy-x (l2-ctx-enemy-x ctx))
  (define enemy-y (l2-ctx-enemy-y ctx))
  (define expansion-pads (l2-ctx-expansion-pads ctx))
  (define frame (l2-ctx-frame ctx))
  (define live-obs-harvesters? (l2-ctx-live-obs-harvesters? ctx))
  (define minerals (l2-ctx-minerals ctx))
  (define mmstate-rush-post (l2-ctx-mmstate-rush-post ctx))
  (define nat-x (l2-ctx-nat-x ctx))
  (define nat-y (l2-ctx-nat-y ctx))
  (define natural-blocked? (l2-ctx-natural-blocked? ctx))
  (define prio-saving-for-sym (l2-ctx-prio-saving-for-sym ctx))
  (define race-th-sym (l2-ctx-race-th-sym ctx))
  (define rt (l2-ctx-rt ctx))
  (define third-x (l2-ctx-third-x ctx))
  (define third-y (l2-ctx-third-y ctx))
  (define townhalls (l2-ctx-townhalls ctx))
  (define uncamped-pad-cache (l2-ctx-uncamped-pad-cache ctx))
  ;; L19-P0-3 (`#009`/`#012` 1BaseLock): Detect when our last emitted `(expand px py)` failed
  ;; to start a base after >= 96f so we rotate off the blocked/unbuildable pad to a safe 3rd/back pad!
  (define door-st (rt-door-state rt))
  (define last-exp-rec (and live-obs-harvesters? (hash-ref door-st 'last-exp-pad-rec #f)))
  (define oledger (or (l2-ctx-oledger ctx) (l2-ctx-oledger-early ctx)))
  (define failed-exp-pad
    (and (vector? last-exp-rec)
         (= (vector-ref last-exp-rec 1) active-bases)
         (>= (- frame (vector-ref last-exp-rec 0)) 96)
         (<= (- frame (vector-ref last-exp-rec 0)) 1600)
         (or (not oledger)
             (= (order-ledger-pending-count-for-type oledger race-th-sym frame) 0))
         (cons (vector-ref last-exp-rec 2) (vector-ref last-exp-rec 3))))
  (define allow-1base-backpad-fallback?
    (and (= active-bases 1)
         (or (>= minerals 400)
             (and (>= minerals 250) (eq? prio-saving-for-sym race-th-sym)))))
    (define key (and prefer-natural? #t))
    (define step-cached (hash-ref uncamped-pad-cache key #f))
    (cond
      [step-cached
       (values (car step-cached) (cdr step-cached))]
      [else
       (define persist-tbl
         (and live-obs-harvesters?
              (hash-ref! door-st 'uncamped-pad-persist make-hasheq)))
       (define pentry (and persist-tbl (hash-ref persist-tbl key #f)))
       (define ttl-limit (if (= (modulo frame 16) 8) 24 16))
       (define nat-blk? (and natural-blocked? #t))
       (define post-2500? (>= frame 2500))
       (define n-th (if persist-tbl (length townhalls) 0))
       (define core-sig (and persist-tbl (l2-pad-core-xy-sig ctx)))
       (define n-ac (if core-sig (vector-ref core-sig 0) 0))
       (define n-eb (if core-sig (vector-ref core-sig 1) 0))
       (define n-eu (if core-sig (vector-ref core-sig 2) 0))
       (define n-ep (if persist-tbl (length expansion-pads) 0))
       (define xy-csum-box #f)
       (define (get-xy-csum)
         (or xy-csum-box
             (let ([s (l2-pad-cands-xy-sum ctx
                       expansion-pads
                       (l2-pad-hash-list-xy-sum ctx
                        townhalls (vector-ref core-sig 3)))])
               (set! xy-csum-box s)
               s)))
       (cond
         [(and (vector? pentry)
               (>= (vector-length pentry) 23)
               (>= frame (vector-ref pentry 0))
               (< (- frame (vector-ref pentry 0)) ttl-limit)
               (eq? nat-blk? (vector-ref pentry 1))
               (eq? post-2500? (vector-ref pentry 2))
               (= active-bases (vector-ref pentry 3))
               (= base-x (vector-ref pentry 10))
               (= base-y (vector-ref pentry 11))
               (= nat-x (vector-ref pentry 12))
               (= nat-y (vector-ref pentry 13))
               (= third-x (vector-ref pentry 14))
               (= third-y (vector-ref pentry 15))
               (= enemy-x (vector-ref pentry 16))
               (= enemy-y (vector-ref pentry 17))
               (= n-th (vector-ref pentry 4))
               (= n-eu (vector-ref pentry 5))
               (= n-eb (vector-ref pentry 6))
               (= n-ac (vector-ref pentry 7))
               (= n-ep (vector-ref pentry 8))
               (equal? mmstate-rush-post (vector-ref pentry 9))
               (fl= (get-xy-csum) (vector-ref pentry 18))
               (equal? failed-exp-pad (vector-ref pentry 21))
               (eq? allow-1base-backpad-fallback? (vector-ref pentry 22))
               (let ([cpx (vector-ref pentry 19)]
                     [cpy (vector-ref pentry 20)])
                 (or (not (and cpx cpy))
                     (not (l2-site-recently-contested? ctx cpx cpy 12.0)))))
          (define px (vector-ref pentry 19))
          (define py (vector-ref pentry 20))
          (hash-set! uncamped-pad-cache key (cons px py))
          (values px py)]
         [else
          (define (near-failed-pad? x y)
            (and failed-exp-pad
                 (real? x) (real? y)
                 (<= (fast-dist2d x y (car failed-exp-pad) (cdr failed-exp-pad)) 6.0)))
          (define (pad-has-enemy-bldg? x y rad)
            (and (real? x) (real? y)
                 (for/or ([eb (in-list enemy-bldgs)] #:when (hash? eb))
                   (<= (fast-dist2d x y
                                    (hash-ref eb 'x 9999.0)
                                    (hash-ref eb 'y 9999.0))
                       rad))))
          (define failed-nat-pad? (near-failed-pad? nat-x nat-y))
          ;; W11-P0-1-rt (`#28` Hatchery x7 self-cancel loop at (90,94)): Exclude pads within
          ;; 12t of a recently canceled/destroyed contested site when safe alternative pads exist!
          ;; L19-P0-3: Also exclude a recently failed `(expand)` pad or enemy-building-blocked pad.
          (define non-contested-pads
            (if (and live-obs-harvesters? (pair? expansion-pads))
                (filter (lambda (p)
                          (not (and (pair? p)
                                    (real? (car p))
                                    (real? (cdr p))
                                    (or (l2-site-recently-contested? ctx (car p) (cdr p) 12.0)
                                        (pad-has-enemy-bldg? (car p) (cdr p) 6.5)))))
                        expansion-pads)
                expansion-pads))
          (define safe-expansion-pads
            (if (and failed-exp-pad (pair? non-contested-pads))
                (let ([rotated (filter (lambda (p)
                                         (not (and (pair? p)
                                                   (near-failed-pad? (car p) (cdr p)))))
                                       non-contested-pads)])
                  (if (pair? rotated) rotated non-contested-pads))
                non-contested-pads))
          (let-values ([(px0 py0)
                        (placement:select-uncamped-expansion-pad
                         safe-expansion-pads
                         (and prefer-natural? (not failed-nat-pad?) (not natural-blocked?))
                         #:base-x base-x
                         #:base-y base-y
                         #:nat-x nat-x
                         #:nat-y nat-y
                         #:third-x third-x
                         #:third-y third-y
                         #:enemy-x enemy-x
                         #:enemy-y enemy-y
                         #:townhalls townhalls
                         #:enemy-units enemy-units
                         #:enemy-bldgs enemy-bldgs
                         #:ally-combat-units ally-combat-units
                         #:natural-blocked? (or natural-blocked? failed-nat-pad?)
                         #:live-obs? live-obs-harvesters?
                         #:active-bases active-bases
                         #:frame frame
                         #:rush-posterior mmstate-rush-post)])
            ;; L19-P0-3: When on 1 base with >= 400M (or Brain saving >= 250M) and primary selection
            ;; returned `#f #f`, repeated the just-failed pad, or hit a blocked pad, pick the safest
            ;; uncamped 3rd/back pad!
            (define-values (px py)
              (if (and allow-1base-backpad-fallback?
                       (or (not (and px0 py0))
                           (near-failed-pad? px0 py0)
                           (pad-has-enemy-bldg? px0 py0 6.5)
                           (and (or natural-blocked? failed-nat-pad?)
                                (<= (fast-dist2d px0 py0 nat-x nat-y) 6.0))))
                  (let* ([raw-cands
                          (append (if (list? expansion-pads) expansion-pads '())
                                  (if (and (real? third-x) (real? third-y))
                                      (list (cons third-x third-y))
                                      '()))]
                         [unowned-cands
                          (filter (lambda (p)
                                    (and (pair? p) (real? (car p)) (real? (cdr p))
                                         (for/and ([th (in-list townhalls)] #:when (hash? th))
                                           (> (fast-dist2d (car p) (cdr p)
                                                           (hash-ref th 'x 9999.0)
                                                           (hash-ref th 'y 9999.0))
                                              8.0))))
                                  raw-cands)]
                         [pad-enemy-sup
                          (lambda (cx cy rad)
                            (for/sum ([e (in-list enemy-units)]
                                      #:when (and (hash? e)
                                                  (combat-unit-record? e)
                                                  (<= (fast-dist2d cx cy
                                                                   (hash-ref e 'x 9999.0)
                                                                   (hash-ref e 'y 9999.0))
                                                      rad)))
                              (max 0.5 (exact->inexact (sc2-supply-cost (fast-canonical-unit-sym (unit-type-sym e)))))))]
                         [uncamped-cands
                          (filter (lambda (p)
                                    (and (< (pad-enemy-sup (car p) (cdr p) 12.0) 4.0)
                                         (not (pad-has-enemy-bldg? (car p) (cdr p) 9.0))))
                                  unowned-cands)]
                         [clean-cands
                          (let ([nc (filter (lambda (p)
                                              (and (not (near-failed-pad? (car p) (cdr p)))
                                                   (or (not live-obs-harvesters?)
                                                       (not (l2-site-recently-contested? ctx (car p) (cdr p) 12.0)))))
                                            uncamped-cands)])
                            (cond
                              [(pair? nc) nc]
                              [else
                               (let ([nf (filter (lambda (p) (not (near-failed-pad? (car p) (cdr p))))
                                                 uncamped-cands)])
                                 (if (pair? nf) nf uncamped-cands))]))])
                    (define-values (best-pad _best-score)
                      (for/fold ([best #f] [best-score +inf.0]) ([p (in-list clean-cands)])
                        (define cx (exact->inexact (car p)))
                        (define cy (exact->inexact (cdr p)))
                        (define esup (pad-enemy-sup cx cy 15.0))
                        (define d-home (fast-dist2d cx cy base-x base-y))
                        (define d-enemy (fast-dist2d cx cy enemy-x enemy-y))
                        (define score (+ (* 100.0 esup) d-home (* -0.45 d-enemy)))
                        (if (< score best-score)
                            (values p score)
                            (values best best-score))))
                    (if best-pad
                        (values (car best-pad) (cdr best-pad))
                        (values px0 py0)))
                  (values px0 py0)))
            (hash-set! uncamped-pad-cache key (cons px py))
            (when persist-tbl
              (hash-set! persist-tbl
                         key
                         (vector frame nat-blk? post-2500? active-bases
                                 n-th n-eu n-eb n-ac n-ep mmstate-rush-post
                                 base-x base-y nat-x nat-y third-x third-y
                                 enemy-x enemy-y (get-xy-csum) px py
                                 failed-exp-pad allow-1base-backpad-fallback?)))
            (values px py))])]))

(define (l2-scout-encounters-early-worker-rush? ctx sw)
  (define base-x (l2-ctx-base-x ctx))
  (define base-y (l2-ctx-base-y ctx))
  (define enemy-units (l2-ctx-enemy-units ctx))
  (define enemy-x (l2-ctx-enemy-x ctx))
  (define enemy-y (l2-ctx-enemy-y ctx))
  (define frame (l2-ctx-frame ctx))
  (define scout-rush-aborted-latch? (l2-ctx-scout-rush-aborted-latch? ctx))
  (define worker-rush-active? (l2-ctx-worker-rush-active? ctx))
    (and sw
         (< frame 3360)
         (let ([swx (hash-ref sw 'x base-x)]
               [swy (hash-ref sw 'y base-y)])
           (and (> (dist2d swx swy base-x base-y) 8.0)
                (or worker-rush-active?
                    scout-rush-aborted-latch?
                    (>= (count (lambda (e)
                                 (define ex0 (hash-ref e 'x 9999.0))
                                 (define ey0 (hash-ref e 'y 9999.0))
                                 (and (memq (unit-type-sym e) '(probe scv drone))
                                      (<= (dist2d swx swy ex0 ey0) 14.0)
                                      (> (dist2d ex0 ey0 enemy-x enemy-y) 16.0)))
                               enemy-units)
                        3)
                    (>= (count (lambda (e)
                                 (and (memq (unit-type-sym e) '(probe scv drone))
                                      (<= (dist2d swx swy
                                                  (hash-ref e 'x 9999.0)
                                                  (hash-ref e 'y 9999.0))
                                          5.5)))
                               enemy-units)
                        3))))))

(define (l2-recall-building-group! ctx g)
  (define base-x (l2-ctx-base-x ctx))
  (define base-y (l2-ctx-base-y ctx))
  (define cg4-cap (l2-ctx-cg4-cap ctx))
  (define cg5-cap (l2-ctx-cg5-cap ctx))
  (define cg6-cap (l2-ctx-cg6-cap ctx))
  (define cg7-cap (l2-ctx-cg7-cap ctx))
  (define cortex (l2-ctx-cortex ctx))
  (define recalled-groups (l2-ctx-recalled-groups ctx))
    (when (and (not (set-member? recalled-groups g))
               (not (null? (hash-ref (case g
                                       [(4) cg4-cap]
                                       [(5) cg5-cap]
                                       [(6) cg6-cap]
                                       [(7) cg7-cap]
                                       [else (hash)])
                                     'ready-tags '())))
               (not (in-camera-viewport? (human-cortex-cam-x cortex)
                                         (human-cortex-cam-y cortex)
                                         base-x base-y)))
      (set-add! recalled-groups g)
      (l2-emit! ctx (list 'control-group-recall g))))

(define (l2-min-dist2-to-owned-base ctx ex ey)
  (define fbx (l2-ctx-fbx ctx))
  (define fby (l2-ctx-fby ctx))
  (define fnx (l2-ctx-fnx ctx))
  (define fny (l2-ctx-fny ctx))
  (define ftx (l2-ctx-ftx ctx))
  (define fty (l2-ctx-fty ctx))
  (define has-nat? (l2-ctx-has-nat? ctx))
  (define has-third? (l2-ctx-has-third? ctx))
    (define fex (exact->inexact ex))
    (define fey (exact->inexact ey))
    (define dx1 (- fex fbx))
    (define dy1 (- fey fby))
    (define d2-1 (+ (* dx1 dx1) (* dy1 dy1)))
    (define d2-2 (if has-nat?
                     (let ([dx (- fex fnx)] [dy (- fey fny)]) (+ (* dx dx) (* dy dy)))
                     +inf.0))
    (define d2-3 (if has-third?
                     (let ([dx (- fex ftx)] [dy (- fey fty)]) (+ (* dx dx) (* dy dy)))
                     +inf.0))
    (min d2-1 d2-2 d2-3))

(define (l2-min-dist-to-owned-base ctx ex ey)
    (sqrt (l2-min-dist2-to-owned-base ctx ex ey)))

(define (l2-ally-has-vision-of? ctx sx sy)
  (define ally-units (l2-ctx-ally-units ctx))
    (define fsx (exact->inexact sx))
    (define fsy (exact->inexact sy))
    (for/or ([u (in-list ally-units)])
      (define ux (hash-ref u 'x SANITIZE-MISSING))
      (define uy (hash-ref u 'y SANITIZE-MISSING))
      (and (not (eq? ux SANITIZE-MISSING))
           (not (eq? uy SANITIZE-MISSING))
           (let ([dx (fl- (exact->inexact ux) fsx)]
                 [dy (fl- (exact->inexact uy) fsy)])
             (fl<= (fl+ (fl* dx dx) (fl* dy dy)) 225.0)))))

(define (l2-enemy-seen-near? ctx sx sy radius)
  (define enemy-bldgs (l2-ctx-enemy-bldgs ctx))
  (define enemy-units (l2-ctx-enemy-units ctx))
    (define fsx (exact->inexact sx))
    (define fsy (exact->inexact sy))
    (define r (exact->inexact radius))
    (define r2 (fl* r r))
    (or (for/or ([e (in-list enemy-units)])
          (define ex (hash-ref e 'x SANITIZE-MISSING))
          (define ey (hash-ref e 'y SANITIZE-MISSING))
          (and (not (eq? ex SANITIZE-MISSING))
               (not (eq? ey SANITIZE-MISSING))
               (let ([dx (fl- (exact->inexact ex) fsx)]
                     [dy (fl- (exact->inexact ey) fsy)])
                 (fl<= (fl+ (fl* dx dx) (fl* dy dy)) r2))))
        (for/or ([e (in-list enemy-bldgs)])
          (define ex (hash-ref e 'x SANITIZE-MISSING))
          (define ey (hash-ref e 'y SANITIZE-MISSING))
          (and (not (eq? ex SANITIZE-MISSING))
               (not (eq? ey SANITIZE-MISSING))
               (let ([dx (fl- (exact->inexact ex) fsx)]
                     [dy (fl- (exact->inexact ey) fsy)])
                 (fl<= (fl+ (fl* dx dx) (fl* dy dy)) r2))))))

;; Weak-keyed peak economy/army tracker & Slice 1.5C opportunity-cost / loss-recovery helpers.
(define-rt-weak-state rt-loss-recovery-state (make-hasheq))

(define (l2-enemy-base-and-gas-counts enemy-bldgs obs)
  (define eb-from-obs (hash-ref obs 'enemy-bases #f))
  (define eg-from-obs (hash-ref obs 'enemy-gas-count #f))
  (define th-cnt 0)
  (define gas-cnt 0)
  (for ([b (in-list enemy-bldgs)]
        #:when (hash? b))
    (define cs (fast-canonical-structure-sym (unit-type-sym b)))
    (cond
      [(memq cs '(hatchery lair hive nexus command-center orbital-command planetary-fortress))
       (set! th-cnt (add1 th-cnt))]
      [(memq cs '(extractor extractor-rich assimilator assimilator-rich refinery refinery-rich))
       (set! gas-cnt (add1 gas-cnt))]))
  (values (max 1
               th-cnt
               (if (real? eb-from-obs) (inexact->exact (floor eb-from-obs)) 0))
          (max gas-cnt
               (if (real? eg-from-obs) (inexact->exact (floor eg-from-obs)) 0))))

(define (l2-opp-rec-unit-needs-bldg? bldg-sym rec-units)
  (define csym (sc2-canonical-structure-sym bldg-sym))
  (and (pair? rec-units)
       (case csym
         [(lair)
          (and (ormap (lambda (u) (memq u '(mutalisk corruptor viper brood-lord broodlord hydralisk lurker overseer))) rec-units) #t)]
         [(hive)
          (and (ormap (lambda (u) (memq u '(viper ultralisk brood-lord broodlord))) rec-units) #t)]
         [(spire)
          (and (ormap (lambda (u) (memq u '(mutalisk corruptor brood-lord broodlord))) rec-units) #t)]
         [(greater-spire)
          (and (ormap (lambda (u) (memq u '(brood-lord broodlord))) rec-units) #t)]
         [(hydralisk-den)
          (and (ormap (lambda (u) (memq u '(hydralisk lurker))) rec-units) #t)]
         [(infestation-pit)
          (and (ormap (lambda (u) (memq u '(infestor swarm-host viper brood-lord broodlord ultralisk))) rec-units) #t)]
         [(ultralisk-cavern) (and (memq 'ultralisk rec-units) #t)]
         [(lurker-den lurker-den-mp) (and (memq 'lurker rec-units) #t)]
         [(baneling-nest) (and (memq 'baneling rec-units) #t)]
         [(stargate)
          (and (ormap (lambda (u) (memq u '(phoenix void-ray voidray oracle carrier tempest))) rec-units) #t)]
         [(fleet-beacon)
          (and (ormap (lambda (u) (memq u '(carrier tempest mothership))) rec-units) #t)]
         [(templar-archive templar-archives)
          (and (ormap (lambda (u) (memq u '(high-templar archon))) rec-units) #t)]
         [(dark-shrine) (and (ormap (lambda (u) (memq u '(dark-templar archon))) rec-units) #t)]
         [(robotics-bay) (and (ormap (lambda (u) (memq u '(colossus disruptor))) rec-units) #t)]
         [(twilight-council) (and (ormap (lambda (u) (memq u '(zealot stalker adept dark-templar high-templar archon))) rec-units) #t)]
         [(forge) (and (ormap (lambda (u) (memq u '(photon-cannon))) rec-units) #t)]
         [(fusion-core) (and (memq 'battlecruiser rec-units) #t)]
         [(ghost-academy) (and (memq 'ghost rec-units) #t)]
         [else #f])))

(define (l2-update-loss-recovery-and-opp-cost! ctx)
  (define rt (l2-ctx-rt ctx))
  (define obs (l2-ctx-obs ctx))
  (define frame (l2-ctx-frame ctx))
  (define total-workers (l2-ctx-total-workers ctx))
  (define active-bases (l2-ctx-active-bases ctx))
  (define supply-used (l2-ctx-supply-used ctx))
  (define peak-supply (max supply-used (or (l2-ctx-cur-peak-supply ctx) supply-used) (hash-ref obs 'peak-supply-reached 0)))
  (define live-army-supply (l2-ctx-live-army-supply ctx))
  (define live-enemy-threat-supply (l2-ctx-live-enemy-threat-supply ctx))
  (define enemy-units (l2-ctx-enemy-units ctx))
  (define enemy-bldgs (l2-ctx-enemy-bldgs ctx))
  (define live-game-obs? (l2-ctx-live-game-obs? ctx))
  (define st (rt-loss-recovery-state rt))
  (define prev-f (hash-ref st 'prev-frame -1))
  (define reset? (or (<= frame 4) (< frame prev-f)))
  (define obs-pw (hash-ref obs 'peak-workers 0))
  (define obs-pb (hash-ref obs 'peak-bases 0))
  (define obs-pa (hash-ref obs 'peak-army-supply 0))
  (define peak-workers
    (if reset?
        (max total-workers obs-pw)
        (max (hash-ref st 'peak-workers 0) total-workers obs-pw)))
  (define peak-bases
    (if reset?
        (max active-bases obs-pb)
        (max (hash-ref st 'peak-bases 1) active-bases obs-pb)))
  (define peak-army-supply
    (if reset?
        (max live-army-supply obs-pa)
        (max (hash-ref st 'peak-army-supply 0) live-army-supply obs-pa)))
  (hash-set! st 'prev-frame frame)
  (hash-set! st 'peak-workers peak-workers)
  (hash-set! st 'peak-bases peak-bases)
  (hash-set! st 'peak-army-supply peak-army-supply)
  (set-l2-ctx-tracked-peak-workers! ctx peak-workers)
  (set-l2-ctx-tracked-peak-bases! ctx peak-bases)
  (set-l2-ctx-tracked-peak-army-supply! ctx peak-army-supply)
  (define lr-ht
    (evaluate-loss-recovery-macro-mode
     (hasheq 'workers total-workers
             'peak-workers peak-workers
             'active-bases active-bases
             'peak-bases peak-bases
             'supply-used supply-used
             'peak-supply-reached peak-supply
             'army-supply live-army-supply
             'peak-army-supply peak-army-supply
             'enemy-threat-supply live-enemy-threat-supply
             'frame frame)))
  (set-l2-ctx-loss-recovery-ht! ctx lr-ht)
  (define-values (e-bases e-gas) (l2-enemy-base-and-gas-counts enemy-bldgs obs))
  (define len-eu (length enemy-units))
  (define len-eb (length enemy-bldgs))
  (define occ (and (not reset?) (hash-ref st 'opp-cache #f)))
  (define opp-ht
    (if (and (vector? occ)
             (or (and (eq? enemy-units (vector-ref occ 0))
                      (eq? enemy-bldgs (vector-ref occ 1))
                      (= e-bases (vector-ref occ 2))
                      (= e-gas (vector-ref occ 3)))
                 (and live-game-obs?
                      (> frame 120)
                      (>= (+ len-eu len-eb) 30)
                      (>= frame (vector-ref occ 4))
                      (< (- frame (vector-ref occ 4)) 8)
                      (= len-eu (vector-ref occ 5))
                      (= len-eb (vector-ref occ 6))
                      (= e-bases (vector-ref occ 2))
                      (= e-gas (vector-ref occ 3)))))
        (vector-ref occ 7)
        (let ([res (evaluate-opponent-opportunity-cost-commitment
                    enemy-units enemy-bldgs frame e-bases e-gas)])
          (hash-set! st 'opp-cache
                     (vector enemy-units enemy-bldgs e-bases e-gas frame len-eu len-eb res))
          res)))
  (set-l2-ctx-opp-commit-ht! ctx opp-ht))

(define (l2-unit-suppressed-by-counter-pivot? ctx unit-sym)
  (define opp-ht (l2-ctx-opp-commit-ht ctx))
  (define lr-ht (l2-ctx-loss-recovery-ht ctx))
  (define hard-ov? (and (hash? opp-ht) (eq? (hash-ref opp-ht 'hard-override-build-order? #f) #t)))
  (define dom-path (if (hash? opp-ht) (hash-ref opp-ht 'dominant-path 'none) 'none))
  (define suppress-failing?
    (and (hash? lr-ht)
         (eq? (hash-ref lr-ht 'suppress-failing-comp? #f) #t)
         (eq? dom-path 'capital-air-fleet)))
  (define suppressed (and (hash? opp-ht) (hash-ref opp-ht 'suppressed-non-counter-units #f)))
  (define md (l2-ctx-macro-decision ctx))
  (define canon-u (sc2-canonical-unit-sym unit-sym))
  ;; Never veto a unit that Phase 8 explicitly scheduled/saved-for, or when floating >= 600M on non-capital-air,
  ;; or when our anti-air facility (`starport`/`stargate`/`spire`) isn't ready yet (#5131026, #5130656, #5131238)!
  (define brain-approved?
    (or (eq? (l2-ctx-prio-saving-for-sym ctx) unit-sym)
        (eq? (l2-ctx-prio-saving-for-sym ctx) canon-u)
        (and (macro-brain-decision? md)
             (or (not (not (memq unit-sym (macro-brain-decision-scheduled-ids md))))
                 (not (not (memq canon-u (macro-brain-decision-scheduled-ids md))))))))
  (define ready-btypes (or (l2-ctx-ready-bldg-types ctx) '()))
  (define open-slots (l2-ctx-open-prod-slots ctx))
  (define counter-facility-ready-with-slot?
    (case (l2-ctx-race ctx)
      [(Terran)  (and (memq 'starport ready-btypes)
                      (or (not (hash? open-slots)) (> (hash-ref open-slots 'starport 0) 0)))]
      [(Protoss) (or (and (memq 'stargate ready-btypes)
                          (or (not (hash? open-slots)) (> (hash-ref open-slots 'stargate 0) 0)))
                     (and (memq 'cybernetics-core ready-btypes)
                          (or (memq 'gateway ready-btypes) (memq 'warp-gate ready-btypes))
                          (or (not (hash? open-slots)) (> (hash-ref open-slots 'gateway 0) 0))))]
      [(Zerg)    (or (memq 'spire ready-btypes)
                     (memq 'greater-spire ready-btypes)
                     (memq 'hydralisk-den ready-btypes))]
      [else #t]))
  (and (or hard-ov? suppress-failing?)
       (pair? suppressed)
       (not brain-approved?)
       (or (not (l2-ctx-live-obs-harvesters? ctx))
           (and counter-facility-ready-with-slot?
                (or (eq? dom-path 'capital-air-fleet)
                    (< (l2-ctx-minerals ctx) 600))))
       (let ([recs (hash-ref opp-ht 'recommended-counter-units '())])
         (and (not (memq canon-u '(drone probe scv overlord observer overseer queen)))
              (not (or (memq unit-sym recs) (memq canon-u recs)))
              (or (memq unit-sym suppressed)
                  (memq canon-u suppressed)
                  (and (eq? canon-u 'viking-fighter) (memq 'viking suppressed))
                  (and (eq? canon-u 'viking) (memq 'viking-fighter suppressed)))))))

(define (l2-apply-loss-recovery-and-opp-cost-gates! ctx)
  (define opp-ht (l2-ctx-opp-commit-ht ctx))
  (define lr-ht (l2-ctx-loss-recovery-ht ctx))
  (define hard-ov? (and (hash? opp-ht) (eq? (hash-ref opp-ht 'hard-override-build-order? #f) #t)))
  (define dom-path (if (hash? opp-ht) (hash-ref opp-ht 'dominant-path 'none) 'none))
  (define rec-units (if (hash? opp-ht) (hash-ref opp-ht 'recommended-counter-units '()) '()))
  (define lr-unlock? (and (hash? lr-ht) (eq? (hash-ref lr-ht 'unlock-locked-path? #f) #t)))
  (define lr-preempt? (and (hash? lr-ht) (eq? (hash-ref lr-ht 'preempt-greedy-tech? #f) #t)))
  (define lr-boost-workers? (and (hash? lr-ht) (eq? (hash-ref lr-ht 'boost-workers? #f) #t)))
  (define lr-boost-expand? (and (hash? lr-ht) (eq? (hash-ref lr-ht 'boost-expand? #f) #t)))
  (define cur-prio (l2-ctx-prio-saving-for-sym ctx))
  (define prio-protected-from-override?
    (and cur-prio
         (let ([cu (sc2-canonical-unit-sym cur-prio)]
               [cs (sc2-canonical-structure-sym cur-prio)])
           (or (memq cu '(drone probe scv overlord pylon supply-depot hatchery nexus command-center orbital-command))
               (memq cs '(hatchery nexus command-center orbital-command
                          spore-crawler missile-turret photon-cannon shield-battery bunker spine-crawler))
               (memq cu rec-units)
               (memq cur-prio rec-units)
               (l2-opp-rec-unit-needs-bldg? cs rec-units)))))
  ;; Phase 9 must NEVER wipe Phase 8's expansion/protected escrow (`#5131251`, `#5130502`, `#5131026`),
  ;; only releasing build-order locks when a true capital-air / hard commitment invalidates a non-counter target!
  (when (and (or hard-ov? (and lr-unlock? (eq? dom-path 'capital-air-fleet)))
             (not prio-protected-from-override?))
    (set-l2-ctx-bo-reserved-min! ctx 0)
    (set-l2-ctx-bo-reserved-gas! ctx 0)
    (set-l2-ctx-escrow-suppressed-active?! ctx #t)
    (when cur-prio
      (set-l2-ctx-prio-saving-for-sym! ctx #f)))
  ;; Only defer tech/upgrades during acute low-army (<16) or low-worker (<28) danger below 800M,
  ;; NEVER permanently across 15-35 min games when army/economy are established (#5131238, #5130439)!
  (when (and lr-preempt?
             (or (< (l2-ctx-live-army-supply ctx) 16)
                 (< (l2-ctx-total-workers ctx) 28))
             (< (l2-ctx-minerals ctx) 800))
    (set-l2-ctx-crisis-tech-upgrade-deferral?! ctx #t))
  (when (and lr-boost-workers?
             (not (l2-ctx-worker-rush-active? ctx))
             (< (l2-ctx-total-workers ctx) (max 24 (or (l2-ctx-target-workers ctx) 24))))
    (set-l2-ctx-crisis-freeze-workers?! ctx #f))
  (when lr-boost-expand?
    (set-l2-ctx-desired-bases!
     ctx
     (max (or (l2-ctx-desired-bases ctx) 2)
          (min SC2-MAX-ACTIVE-BASES
               (max 2
                    (add1 (l2-ctx-active-bases ctx))
                    (or (l2-ctx-tracked-peak-bases ctx) 1)))))
    (unless (l2-ctx-hard-supply-lockout? ctx)
      (set-l2-ctx-crisis-freeze-expand-or-gas?! ctx #f))))

(define (l2-shimmer-ripples ctx)
  (define obs0 (l2-ctx-obs ctx))
  (define raw0 (l2-ctx-raw-obs ctx))
  (define v1 (and (hash? obs0) (hash-ref obs0 'shimmer-and-burrow-ripples #f)))
  (define v2 (and (hash? raw0) (hash-ref raw0 'shimmer-and-burrow-ripples #f)))
  (cond
    [(and (list? v1) (pair? v1)) (filter hash? v1)]
    [(and (list? v2) (pair? v2)) (filter hash? v2)]
    [else '()]))

(define (l2-queue-opp-cost-and-recovery-static-defense! ctx)
  (define opp-ht (l2-ctx-opp-commit-ht ctx))
  (define lr-ht (l2-ctx-loss-recovery-ht ctx))
  (define boost-sd? (and (hash? lr-ht) (eq? (hash-ref lr-ht 'boost-static-defense? #f) #t)))
  (define boost-exp? (and (hash? lr-ht) (eq? (hash-ref lr-ht 'boost-expand? #f) #t)))
  (define hard-ov? (and (hash? opp-ht) (eq? (hash-ref opp-ht 'hard-override-build-order? #f) #t)))
  (define dom-path (if (hash? opp-ht) (hash-ref opp-ht 'dominant-path 'none) 'none))
  (define air-or-stealth-opp?
    (or (memq dom-path '(capital-air-fleet air-harass dark-templar banshee oracle mutalisk air))
        (let ([recs (if (hash? opp-ht) (hash-ref opp-ht 'recommended-counter-units '()) '())])
          (and (ormap (lambda (s) (memq s '(spore-crawler missile-turret photon-cannon))) recs) #t))))
  (define tech-obs (l2-ctx-tech-obs ctx))
  ;; L29-P0-3 (`#52 DT:7`, `#54 Banshee:14`, `CloakLoss -> 0`): Detect live cloaked/burrowed
  ;; threats directly so emergency static detectors + Forge/EBay unblock IMMEDIATELY at the
  ;; threatened base's mineral line even without `boost-sd?`/`hard-ov?`!
  (define active-cloak-threats
    (let* ([eus (or (l2-ctx-enemy-units ctx) '())]
           [rips (l2-shimmer-ripples ctx)])
      (append
       (filter (lambda (e)
                 (and (hash? e)
                      (not (memq (fast-canonical-unit-sym (unit-type-sym e))
                                 '(creep-tumor creep-tumor-burrowed creep-tumor-queen)))
                      (or (eq? (hash-ref e 'cloaked #f) #t)
                          (memq (hash-ref e 'cloak 0) '(1 2 cloaked cloaked-detected))
                          (= (hash-ref e 'display-type 1) 3)
                          (eq? (hash-ref e 'burrowed #f) #t)
                          (eq? (hash-ref e 'is-burrowed #f) #t)
                          (memq (fast-canonical-unit-sym (unit-type-sym e))
                                '(dark-templar banshee ghost lurker-burrowed lurker-mp-burrowed
                                  widow-mine-burrowed)))))
               eus)
       (filter hash? rips))))
  (define active-cloak-bldg-seen?
    (ormap (lambda (eb)
             (and (hash? eb)
                  (memq (fast-canonical-structure-sym (unit-type-sym eb))
                        '(dark-shrine lurker-den lurker-den-mp))))
           (or (l2-ctx-enemy-bldgs ctx) '())))
  (define active-cloak-emergency?
    (or (pair? active-cloak-threats)
        active-cloak-bldg-seen?))
  (define genuine-air-or-cloak-threat?
    (or active-cloak-emergency?
        air-or-stealth-opp?
        (l2-ctx-enemy-cloaked-or-air? ctx)
        (and tech-obs
             (enemy-tech-observation-requires-anti-air? tech-obs))
        (ormap (lambda (e)
                 (and (hash? e)
                      (memq (fast-canonical-unit-sym (unit-type-sym e))
                            '(banshee dark-templar ghost lurker mutalisk void-ray
                              carrier oracle widow-mine phoenix liberator battlecruiser tempest))))
               (l2-ctx-enemy-units ctx))))
  (when (and (or active-cloak-emergency? boost-sd? (and hard-ov? (not (eq? dom-path 'none))))
             (not (l2-ctx-worker-rush-active? ctx))
             (>= (l2-ctx-total-workers ctx) 4)
             (or active-cloak-emergency?
                 (>= (l2-ctx-total-workers ctx) 10)
                 (>= (l2-ctx-minerals ctx) 200)))
    (define race (l2-ctx-race ctx))
    (define frame (l2-ctx-frame ctx))
    (define oledger (l2-ctx-oledger ctx))
    (define cd-tracker (l2-ctx-cd-tracker ctx))
    (define ready-bldg-types (l2-ctx-ready-bldg-types ctx))
    (define active-bases (max 1 (l2-ctx-active-bases ctx)))
    (define base-x (l2-ctx-base-x ctx))
    (define base-y (l2-ctx-base-y ctx))
    (define nat-x (l2-ctx-nat-x ctx))
    (define nat-y (l2-ctx-nat-y ctx))
    (define live-game? (l2-ctx-live-obs-harvesters? ctx))
    (define aa-desire-cap (min 3 (max 1 active-bases)))
    (define ground-desire-cap (min 2 (max 1 active-bases)))
    (define (count-sd sym)
      (+ (l2-cur-ally-canon-bldg-count ctx sym)
         (order-ledger-pending-count-for-type oledger sym frame)))
    (define zerg-aa-min-res
      (if (and (eq? race 'Zerg)
               (not active-cloak-emergency?)
               (not boost-sd?)
               (not (memq dom-path '(dark-templar banshee))))
          (l2-ctx-zerg-spire-res-min ctx)
          0))
    ;; Anchor static detectors at the threatened TownHall lacking a detector within 12t
    ;; during `active-cloak-emergency?`, falling back to Main/Natural mineral line!
    (define ally-th-pts-sd
      (for/list ([b (in-list (or (l2-ctx-ally-bldgs ctx) '()))]
                 #:when (and (hash? b)
                             (memq (fast-canonical-structure-sym (unit-type-sym b))
                                   '(hatchery lair hive nexus command-center orbital-command planetary-fortress))
                             (real? (hash-ref b 'x #f))
                             (real? (hash-ref b 'y #f))))
        (cons (exact->inexact (hash-ref b 'x base-x))
              (exact->inexact (hash-ref b 'y base-y)))))
    (define (pick-sd-anchor sym)
      (define existing-sd-pts
        (for/list ([b (in-list (or (l2-ctx-ally-bldgs ctx) '()))]
                   #:when (and (hash? b)
                               (eq? (fast-canonical-structure-sym (unit-type-sym b)) sym)
                               (real? (hash-ref b 'x #f))
                               (real? (hash-ref b 'y #f))))
          (cons (exact->inexact (hash-ref b 'x base-x))
                (exact->inexact (hash-ref b 'y base-y)))))
      (define (th-has-sd? th)
        (for/or ([sp (in-list existing-sd-pts)])
          (<= (dist2d (car th) (cdr th) (car sp) (cdr sp)) 12.0)))
      (define undefended-ths (filter (lambda (th) (not (th-has-sd? th))) ally-th-pts-sd))
      (cond
        [(and active-cloak-emergency? (pair? undefended-ths) (pair? active-cloak-threats))
         (define ct0 (car active-cloak-threats))
         (define cx (exact->inexact (hash-ref ct0 'x base-x)))
         (define cy (exact->inexact (hash-ref ct0 'y base-y)))
         (define best-th (argmin (lambda (th) (dist2d (car th) (cdr th) cx cy)) undefended-ths))
         (l2-mineral-line-offset ctx (car best-th) (cdr best-th) 2.5)]
        [(and active-cloak-emergency? (pair? undefended-ths))
         (define best-th (car undefended-ths))
         (l2-mineral-line-offset ctx (car best-th) (cdr best-th) 2.5)]
        [(<= active-bases 1)
         (values (safe-coord (+ base-x (* 0.25 (- nat-x base-x))) base-x)
                 (safe-coord (+ base-y (* 0.25 (- nat-y base-y))) base-y))]
        [else (values nat-x nat-y)]))
    (define (try-sd! sym req-ready? cap)
      (define cur-cnt (count-sd sym))
      (define eff-cd
        (if (and active-cloak-emergency? (= cur-cnt 0))
            44
            SC2-STATIC-DETECTOR-COOLDOWN-FRAMES))
      (and (or (not live-game?) req-ready?)
           (< cur-cnt cap)
           (l2-save-cancel-rebuild-ready? ctx sym 60)
           (>= (- (l2-ctx-minerals ctx) zerg-aa-min-res) (sc2-min-cost sym))
           (refractory-allow-action?! cd-tracker (list 'slice15-static-def sym) frame eff-cd)
           (let-values ([(ax ay) (pick-sd-anchor sym)])
             (l2-emit-build-verified! ctx sym ax ay 2.0)
             #t)))
    (case race
      [(Zerg)
       (define pool-ready? (memq 'spawning-pool ready-bldg-types))
       (when (and genuine-air-or-cloak-threat?
                  (try-sd! 'spore-crawler pool-ready? aa-desire-cap))
         (void))
       (when boost-sd?
         (try-sd! 'spine-crawler pool-ready? ground-desire-cap))]
      [(Protoss)
       (define has-pylon? (or (not live-game?) (> (or (l2-ctx-real-pylon-count ctx) 0) 0)))
       (define forge-ready? (and has-pylon? (memq 'forge ready-bldg-types)))
       (define cyber-ready? (and has-pylon? (memq 'cybernetics-core ready-bldg-types)))
       ;; Strictly gate Forge & Photon Cannons on genuine air/cloak threat (NOT pure ground `boost-sd?`)!
       (when (and genuine-air-or-cloak-threat?
                  (not forge-ready?)
                  (not (l2-building-present-or-pending? ctx 'forge))
                  (l2-building-present-or-pending? ctx 'pylon)
                  (>= (l2-ctx-minerals ctx) (+ (sc2-min-cost 'forge) (if active-cloak-emergency? 0 50)))
                  (l2-save-cancel-rebuild-ready? ctx 'forge 60))
         (let-values ([(fx fy) (l2-interior-offset ctx 5.5 2.5)])
           (l2-emit-build-verified! ctx 'forge fx fy)))
       (or (and genuine-air-or-cloak-threat?
                (try-sd! 'photon-cannon forge-ready? aa-desire-cap))
           (and boost-sd? (try-sd! 'shield-battery cyber-ready? ground-desire-cap)))]
      [(Terran)
       (define rax-ready? (memq 'barracks ready-bldg-types))
       (define ebay-ready? (memq 'engineering-bay ready-bldg-types))
       ;; L30-P0-3 / L31-P0-3 (`#32`/`#08`/`#26` Natural CC Escrow Guard): Do not let non-emergency static-D
       ;; spends break an active 1-base Natural `command-center` escrow (`saving_for`, `bo-goal`, or top-2 `escrow_queue`)!
       (define terran-hold-sd-for-nat-cc?
         (and live-game?
              (= active-bases 1)
              (not active-cloak-emergency?)
              (l2-ctx-terran-saving-for-cc-expand? ctx)
              (l2-terran-1base-cc-intent? ctx)
              (not (l2-ctx-early-survival-crisis? ctx))
              (not (l2-ctx-under-base-attack? ctx))
              (<= (l2-ctx-live-enemy-threat-supply ctx) (max 6.0 (l2-ctx-live-army-supply ctx)))
              (< (- (l2-ctx-minerals ctx) 100) (sc2-min-cost 'command-center))))
       ;; Strictly gate EBay & Missile Turrets on genuine air/cloak threat (NOT pure ground `boost-sd?`)!
       (when (and genuine-air-or-cloak-threat?
                  (not terran-hold-sd-for-nat-cc?)
                  (not ebay-ready?)
                  (not (l2-building-present-or-pending? ctx 'engineering-bay))
                  rax-ready?
                  (>= (l2-ctx-minerals ctx) (+ (sc2-min-cost 'engineering-bay) (if active-cloak-emergency? 0 50)))
                  (l2-save-cancel-rebuild-ready? ctx 'engineering-bay 60))
         (let-values ([(ex ey) (l2-interior-offset ctx 5.5 -2.5)])
           (l2-emit-build-verified! ctx 'engineering-bay ex ey #:bypass-escrow? #t)))
       (define sd-cur-marines (l2-unit-count ctx 'marine))
       (define sd-enemy-reapers
         (max (count (lambda (e)
                       (and (hash? e)
                            (eq? (fast-canonical-unit-sym (unit-type-sym e)) 'reaper)))
                     (or (l2-ctx-enemy-units ctx) '()))
              (let* ([rt3 (l2-ctx-rt ctx)]
                     [os (and rt3 (opponent-world-model-last-summary (rt-opponent-world-model rt3)))]
                     [kc (and os (opponent-world-summary-known-unit-counts os))])
                (if (hash? kc) (hash-ref kc 'reaper 0) 0))))
       (define sd-bunker-marine-ok?
         (or (not live-game?)
             (>= sd-cur-marines 2)
             (and (>= sd-cur-marines 1)
                  (or (>= sd-enemy-reapers 2)
                      (l2-ctx-under-base-attack? ctx)))))
       (define sd-unfinished-bunker-cnt
         (+ (count (lambda (b)
                     (and (hash? b)
                          (eq? (fast-canonical-structure-sym (unit-type-sym b)) 'bunker)
                          (< (hash-ref b 'build-progress 1.0) SC2-BUILD-COMPLETE-PROGRESS)))
                   (or (l2-ctx-ally-bldgs ctx) '()))
            (order-ledger-pending-count-for-type oledger 'bunker frame)))
       (define sd-bunker-cap
         (if (and live-game? (< frame 5376))
             (if (and (>= sd-cur-marines 6)
                      (or (l2-ctx-under-base-attack? ctx)
                          (l2-ctx-early-survival-crisis? ctx)))
                 (min 2 ground-desire-cap)
                 1)
             ground-desire-cap))
       (define sd-protect-early-nat-cc-bunker?
         (and live-game?
              (= active-bases 1)
              (< frame 3024)
              (not (l2-ctx-under-base-attack? ctx))
              (not (l2-ctx-worker-rush-active? ctx))
              (not (l2-ctx-in-base-proxy-detected? ctx))
              (< (- (l2-ctx-minerals ctx) (sc2-min-cost 'bunker))
                 (sc2-min-cost 'command-center))))
       (or (and genuine-air-or-cloak-threat?
                (not terran-hold-sd-for-nat-cc?)
                (try-sd! 'missile-turret ebay-ready? aa-desire-cap))
           ;; L49-W1 + L51-2B + L63B Bug #1B: Require Marine backing (>= 2 Marines, or >= 1 only vs
           ;; >= 2 Reapers or active base breach), at most 0 unfinished Bunkers, < 4:00 cap 1 unless
           ;; >= 6 Marines & attack/crisis, and protect < 2:15 1-base Natural CC from non-breach Bunkers.
           (and boost-sd?
                (not terran-hold-sd-for-nat-cc?)
                (not sd-protect-early-nat-cc-bunker?)
                sd-bunker-marine-ok?
                (or (not live-game?) (= sd-unfinished-bunker-cnt 0))
                (not (and live-game?
                          (eq? (l2-ctx-effective-enemy-race ctx) 'Zerg)
                          (<= active-bases 1)
                          (< frame 3360)
                          (not (l2-ctx-worker-rush-active? ctx))
                          (not (l2-ctx-in-base-proxy-detected? ctx))
                          (not (l2-ctx-forward-proxy-detected? ctx))
                          (not (l2-ctx-under-base-attack? ctx))
                          (not (for/or ([e (in-list (or (l2-ctx-enemy-units ctx) '()))])
                                 (and (hash? e)
                                      (combat-unit-record? e)
                                      (not (memq (unit-type-sym e) '(drone overlord overseer larva egg)))
                                      (or (<= (dist2d base-x base-y (hash-ref e 'x 9999.0) (hash-ref e 'y 9999.0)) 36.0)
                                          (<= (dist2d nat-x nat-y (hash-ref e 'x 9999.0) (hash-ref e 'y 9999.0)) 30.0)))))))
                (or (not live-game?)
                    (l2-ctx-early-survival-crisis? ctx)
                    (l2-ctx-under-early-cheese? ctx)
                    (l2-ctx-under-base-attack? ctx)
                    (and (>= (l2-ctx-live-enemy-threat-supply ctx) 4.0)
                         (> (l2-ctx-live-enemy-threat-supply ctx)
                            (* 1.15 (l2-ctx-live-army-supply ctx)))))
                (try-sd! 'bunker rax-ready? sd-bunker-cap)))]))
  ;; When base-loss-recovery fires and no expand is pending, reclaim uncamped expansion pad cleanly.
  (when (and boost-exp?
             (not (l2-ctx-worker-rush-active? ctx))
             (not (l2-ctx-early-survival-crisis? ctx))
             (not (l2-ctx-under-base-attack? ctx)))
    (define race (l2-ctx-race ctx))
    (define th-sym (case race [(Zerg) 'hatchery] [(Protoss) 'nexus] [else 'command-center]))
    (define th-cost (sc2-min-cost th-sym))
    (define oledger (l2-ctx-oledger ctx))
    (define frame (l2-ctx-frame ctx))
    (define cd-tracker (l2-ctx-cd-tracker ctx))
    (define max-auto-bases (if (eq? race 'Zerg) 5 SC2-MAX-ACTIVE-BASES))
    (when (and (>= (l2-ctx-minerals ctx) th-cost)
               (= (order-ledger-pending-count-for-type oledger th-sym frame) 0)
               (not (l2-build-issue-blocked? ctx th-sym))
               (< (l2-ctx-active-bases ctx) max-auto-bases)
               (or (not (eq? race 'Zerg))
                   (< (l2-ctx-active-bases ctx) 4)
                   (>= (l2-ctx-live-army-supply ctx) 45))
               (l2-save-cancel-rebuild-ready? ctx th-sym 224)
               (refractory-ready? cd-tracker (list 'auto-expand race) frame SC2-EXPANSION-COOLDOWN-FRAMES))
      (define-values (exp-x exp-y) (l2-select-uncamped-expansion-pad ctx (< (l2-ctx-active-bases ctx) 2)))
      (when (and exp-x exp-y
                 (not (l2-site-recently-contested? ctx exp-x exp-y 12.0))
                 (refractory-allow-action?! cd-tracker (list 'auto-expand race) frame SC2-EXPANSION-COOLDOWN-FRAMES))
        (l2-emit! ctx (list 'expand exp-x exp-y))
        (l2-record-expand-pad-issued! ctx exp-x exp-y)
        (l2-record-build-issue-lock! ctx th-sym)
        (order-ledger-record-issued! oledger (+ 812000 (modulo frame 10000)) 'expand th-sym exp-x exp-y frame)
        (l2-spend-resources-and-supply! ctx th-cost 0 0)))))

(define (l2-get-ready-bldgs ctx)
  (or (l2-ctx-ready-bldgs ctx)
      (filter (lambda (b)
                (and (hash? b)
                     (>= (hash-ref b 'build-progress 1.0) SC2-BUILD-COMPLETE-PROGRESS)))
              (or (l2-ctx-ally-bldgs ctx) '()))))

(define (l2-rebalance-offline-mined-out-workers! ctx)
  (define step-mineral-patches (l2-ctx-step-mineral-patches ctx))
  (define ready-bldgs (l2-get-ready-bldgs ctx))
  (define workers (l2-ctx-non-building-workers ctx))
  (define live-game? (l2-ctx-live-obs-harvesters? ctx))
  (define frame (l2-ctx-frame ctx))
  (define cd-tracker (l2-ctx-cd-tracker ctx))
  ;; Loop 61 (`#1609` RC-4): In live matches, `saturate-workers-and-gas-commands` (Sec 0b + Sec 3)
  ;; + TownHall `RALLY_WORKERS (3690)` are the single source of truth for mineral rebalancing with
  ;; in-flight accounting & per-base coalescing. Keep this helper strictly for synthetic non-live tests!
  (when (and (not live-game?)
             (pair? step-mineral-patches)
             (pair? ready-bldgs)
             (pair? (cdr ready-bldgs))
             (pair? workers)
             (not (l2-ctx-worker-rush-active? ctx)))
    (define ally-ths
      (for/list ([b (in-list ready-bldgs)]
                 #:when (and (hash? b)
                             (not (eq? (hash-ref b 'flying #f) #t))
                             (not (eq? (hash-ref b 'is-flying #f) #t))
                             (memq (fast-canonical-structure-sym (unit-type-sym b))
                                   '(hatchery lair hive nexus command-center orbital-command planetary-fortress))))
        b))
    (when (and (pair? ally-ths) (pair? (cdr ally-ths)))
      (define enemy-units (l2-ctx-enemy-units ctx))
      (define ally-combat-units (l2-ctx-ally-combat-units ctx))
      (define leases (l2-ctx-leases ctx))
      (define offline-ths '())
      (define over-th-infos '())
      (define online-patches-info '())
      (for ([th (in-list ally-ths)])
        (define tx (exact->inexact (hash-ref th 'x 0.0)))
        (define ty (exact->inexact (hash-ref th 'y 0.0)))
        (define near-patches
          (for/list ([mp (in-list step-mineral-patches)]
                     #:when (and (hash? mp)
                                 (> (hash-ref mp 'mineral-contents 1500) 0)
                                 (> (hash-ref mp 'id 0) 0)
                                 (<= (fast-dist2d tx ty (hash-ref mp 'x 9999.0) (hash-ref mp 'y 9999.0)) 12.0)))
            mp))
        (define combat-e-near
          (count (lambda (e)
                   (and (hash? e)
                        (combat-unit-record? e)
                        (<= (fast-dist2d tx ty (hash-ref e 'x 9999.0) (hash-ref e 'y 9999.0)) 12.0)))
                 enemy-units))
        (define combat-a-near
          (count (lambda (a)
                   (and (hash? a)
                        (<= (fast-dist2d tx ty (hash-ref a 'x 9999.0) (hash-ref a 'y 9999.0)) 12.0)))
                 ally-combat-units))
        (define ideal-h (hash-ref th 'ideal-harvesters 16))
        (define assigned-h (hash-ref th 'assigned-harvesters 0))
        (define patch-cap (min 16 (* 2 (length near-patches))))
        (define safe-base? (or (< combat-e-near 3) (>= combat-a-near 2)))
        (define th-offline?
          (or (eq? (hash-ref th 'mined-out #f) #t)
              (eq? (hash-ref th 'mined-out? #f) #t)
              (= ideal-h 0)
              (null? near-patches)
              (not safe-base?)))
        (cond
          [th-offline? (set! offline-ths (cons th offline-ths))]
          [(pair? near-patches)
           (when (> assigned-h patch-cap)
             (define pset
               (for/seteq ([mp (in-list near-patches)])
                 (hash-ref mp 'id 0)))
             (set! over-th-infos
                   (cons (list th tx ty (- assigned-h patch-cap) pset) over-th-infos)))
           (when (or (< assigned-h patch-cap) (not live-game?))
             (define deficit (max 1 (- (max patch-cap (if live-game? patch-cap (max 16 ideal-h))) assigned-h)))
             (set! online-patches-info (cons (list th near-patches deficit tx ty) online-patches-info)))]))
      (when (and (or (pair? offline-ths) (pair? over-th-infos))
                 (pair? online-patches-info))
        (define best-online
          (argmax (lambda (info) (third info)) online-patches-info))
        (define target-patch
          (argmax (lambda (mp) (hash-ref mp 'mineral-contents 1000))
                  (second best-online)))
        (define target-pid (hash-ref target-patch 'id 0))
        (define online-patch-ids
          (for*/seteq ([info (in-list online-patches-info)]
                       [mp (in-list (second info))])
            (hash-ref mp 'id 0)))
        (define over-excess-boxes
          (for/list ([oi (in-list over-th-infos)])
            (list (second oi) (third oi) (box (fourth oi)) (fifth oi))))
        (when (> target-pid 0)
          (let loop ([rem workers] [moved 0])
            (when (and (< moved 4) (pair? rem))
              (define w (car rem))
              (define wid (hash-ref w 'id 0))
              (define wx (exact->inexact (hash-ref w 'x 0.0)))
              (define wy (exact->inexact (hash-ref w 'y 0.0)))
              (define tgt-id (hash-ref w 'order-target-id 0))
              (define near-off?
                (and (pair? offline-ths)
                     (ormap (lambda (oth)
                              (<= (fast-dist2d wx wy (hash-ref oth 'x 9999.0) (hash-ref oth 'y 9999.0)) 12.5))
                            offline-ths)
                     (not (set-member? online-patch-ids tgt-id))))
              (define near-over-box
                (and (not near-off?)
                     (pair? over-excess-boxes)
                     (for/first ([ob (in-list over-excess-boxes)]
                                 #:when (and (> (unbox (third ob)) 0)
                                             (<= (fast-dist2d wx wy (first ob) (second ob)) 12.5)
                                             (or (= tgt-id 0)
                                                 (set-member? (fourth ob) tgt-id))))
                       ob)))
              (define need-move?
                (and (> wid 0)
                     (or near-off? near-over-box)
                     (not (worker-carrying-minerals-or-gas? w))
                     (not (unit-leased-above? leases wid 'harvester frame))
                     (refractory-allow-action?! cd-tracker (list 'rebalance-offline-w wid) frame 36)))
              (when need-move?
                (when near-over-box
                  (set-box! (third near-over-box) (sub1 (unbox (third near-over-box)))))
                (l2-emit! ctx (list 'harvest-mineral wid target-pid)))
              (loop (cdr rem) (if need-move? (add1 moved) moved)))))))))

(define (l2-crisis-tech-bldg-deferred? ctx bldg-sym)
  (define crisis-tech-upgrade-deferral? (l2-ctx-crisis-tech-upgrade-deferral? ctx))
  (define opp-ht (l2-ctx-opp-commit-ht ctx))
  (define lr-ht (l2-ctx-loss-recovery-ht ctx))
  (define csym (sc2-canonical-structure-sym bldg-sym))
  (define hard-ov? (and (hash? opp-ht) (eq? (hash-ref opp-ht 'hard-override-build-order? #f) #t)))
  (define rec-units (if (hash? opp-ht) (hash-ref opp-ht 'recommended-counter-units '()) '()))
  (define dom-path (if (hash? opp-ht) (hash-ref opp-ht 'dominant-path 'none) 'none))
  (define preempt-lr? (and (hash? lr-ht) (eq? (hash-ref lr-ht 'preempt-greedy-tech? #f) #t)))
  (define md (l2-ctx-macro-decision ctx))
  (define brain-sched-spire?
    (and (eq? csym 'spire)
         (or (eq? (l2-ctx-prio-saving-for-sym ctx) 'spire)
             (and (macro-brain-decision? md)
                  (not (not (memq 'spire (macro-brain-decision-scheduled-ids md))))))))
  (define under-ground-crisis?
    (and (or (l2-ctx-under-base-attack? ctx)
             (l2-ctx-urgent-combat-or-intel-need? ctx))
         (not (l2-ctx-enemy-cloaked-or-air? ctx))
         (not (memq dom-path '(capital-air-fleet air-harass)))))
  ;; L21-P0-3 / L57-R2 (`#078 VeTerran` 110s CyberCore deadlock): During <4:00 (`< 5400f`) live
  ;; active base attack / early survival crisis (without Reapers / cloaked / air threats), defer
  ;; Robotics Facility / Stargate / Twilight Council / Forge until >= 4 combat units (or >= 400M),
  ;; while tightening Cybernetics Core deferral to `< 2` combat units (`< 1` vs Terran; keep `< 4`
  ;; during `< 3:00` 12-Pool Zergling rush only while `< 2` Gateways so Gateway #2 drops first!).
  (define tech-obs-cb (l2-ctx-tech-obs ctx))
  (define protoss-early-breach-tech-defer?
    (and (eq? (l2-ctx-race ctx) 'Protoss)
         (l2-ctx-live-obs-harvesters? ctx)
         (< (l2-ctx-frame ctx) 5400)
         (< (length (l2-ctx-ally-combat-units ctx))
            (if (eq? csym 'cybernetics-core)
                (l2-protoss-cyber-defer-unit-threshold ctx)
                4))
         (or (l2-ctx-under-base-attack? ctx)
             (l2-ctx-early-survival-crisis? ctx))
         (< (l2-ctx-minerals ctx) 400)
         (not (l2-ctx-enemy-cloaked-or-air? ctx))
         (not (and tech-obs-cb (enemy-tech-observation-requires-anti-air? tech-obs-cb)))
         (not (ormap (lambda (e)
                       (and (hash? e)
                            (eq? (fast-canonical-unit-sym (unit-type-sym e)) 'reaper)))
                     (l2-ctx-enemy-units ctx)))
         (not (not (memq csym '(cybernetics-core robotics-facility stargate twilight-council forge))))))
  (or protoss-early-breach-tech-defer?
      (and (not (and (l2-ctx-zerg-real-anti-air-threat? ctx)
                     (memq csym '(lair hydralisk-den spire))))
           (not brain-sched-spire?)
           (or crisis-tech-upgrade-deferral? preempt-lr?)
           (or under-ground-crisis?
               (not (and hard-ov? (l2-opp-rec-unit-needs-bldg? csym rec-units))))
           (not (not (memq csym CRISIS-DEFERRED-TECH-BLDG-SYMS))))))

;; L37-P0-2 (`#846` North-vs-South Spawn Symmetry): Compute canonical mineral-away / interior
;; basis `(ux, uy, px, py)` around `(anchor-x, anchor-y)` so ALL L2 fallback & non-wall anchors
;; are 100% rotation-invariant across NW/NE/SW/SE spawns (zero hardcoded `+X,-Y` / `+X,+Y` bias!).
(define (l2-interior-basis ctx [given-ax #f] [given-ay #f])
  (define base-x (exact->inexact (l2-ctx-base-x ctx)))
  (define base-y (exact->inexact (l2-ctx-base-y ctx)))
  (define nat-x (exact->inexact (l2-ctx-nat-x ctx)))
  (define nat-y (exact->inexact (l2-ctx-nat-y ctx)))
  (define enemy-x (exact->inexact (l2-ctx-enemy-x ctx)))
  (define enemy-y (exact->inexact (l2-ctx-enemy-y ctx)))
  (define ax (if (real? given-ax) (exact->inexact given-ax) base-x))
  (define ay (if (real? given-ay) (exact->inexact given-ay) base-y))
  (define obs (l2-ctx-obs ctx))
  (define raw-mps
    (let ([s (l2-ctx-step-mineral-patches ctx)])
      (cond
        [(and (list? s) (pair? s)) s]
        [(hash? obs)
         (let ([m (hash-ref obs 'mineral-patches '())])
           (if (list? m) m '()))]
        [else '()])))
  (define local-mps
    (filter (lambda (mp)
              (and (hash? mp)
                   (<= (dist2d ax ay
                               (exact->inexact (hash-ref mp 'x ax))
                               (exact->inexact (hash-ref mp 'y ay)))
                       13.0)))
            raw-mps))
  (define-values (ux uy)
    (cond
      [(pair? local-mps)
       (define cnt (length local-mps))
       (define mcx (/ (for/sum ([m (in-list local-mps)]) (exact->inexact (hash-ref m 'x ax))) cnt))
       (define mcy (/ (for/sum ([m (in-list local-mps)]) (exact->inexact (hash-ref m 'y ay))) cnt))
       (define dx (- ax mcx))
       (define dy (- ay mcy))
       (define d (sqrt (+ (* dx dx) (* dy dy))))
       (if (> d 0.5)
           (values (/ dx d) (/ dy d))
           (let* ([ndx (- nat-x ax)]
                  [ndy (- nat-y ay)]
                  [nd (max 1.0 (sqrt (+ (* ndx ndx) (* ndy ndy))))])
             (values (/ ndx nd) (/ ndy nd))))]
      [(> (dist2d ax ay nat-x nat-y) 2.0)
       (define dx (- nat-x ax))
       (define dy (- nat-y ay))
       (define d (max 1.0 (sqrt (+ (* dx dx) (* dy dy)))))
       (values (/ dx d) (/ dy d))]
      [(> (dist2d ax ay base-x base-y) 2.0)
       (define dx (- base-x ax))
       (define dy (- base-y ay))
       (define d (max 1.0 (sqrt (+ (* dx dx) (* dy dy)))))
       (values (/ dx d) (/ dy d))]
      [else
       (define dx (- enemy-x ax))
       (define dy (- enemy-y ay))
       (define d (max 1.0 (sqrt (+ (* dx dx) (* dy dy)))))
       (values (/ dx d) (/ dy d))]))
  (values ux uy (- uy) ux))

(define (l2-interior-offset ctx fwd [lat 0.0] [given-ax #f] [given-ay #f])
  (define ax (if (real? given-ax) (exact->inexact given-ax) (exact->inexact (l2-ctx-base-x ctx))))
  (define ay (if (real? given-ay) (exact->inexact given-ay) (exact->inexact (l2-ctx-base-y ctx))))
  (define-values (ux uy px py) (l2-interior-basis ctx ax ay))
  (values (safe-coord (+ ax (* fwd ux) (* lat px)) ax)
          (safe-coord (+ ay (* fwd uy) (* lat py)) ay)))

;; Place static detectors (`spore-crawler` / `missile-turret` / `photon-cannon`) toward the
;; base's local mineral patches on every spawn corner (NW/NE/SW/SE), falling back to interior.
(define (l2-mineral-line-offset ctx anchor-x anchor-y [dist 3.0])
  (define ax (exact->inexact anchor-x))
  (define ay (exact->inexact anchor-y))
  (define obs (l2-ctx-obs ctx))
  (define raw-mps
    (let ([s (l2-ctx-step-mineral-patches ctx)])
      (cond
        [(and (list? s) (pair? s)) s]
        [(hash? obs)
         (let ([m (hash-ref obs 'mineral-patches '())])
           (if (list? m) m '()))]
        [else '()])))
  (define local-mps
    (filter (lambda (mp)
              (and (hash? mp)
                   (<= (dist2d ax ay
                               (exact->inexact (hash-ref mp 'x ax))
                               (exact->inexact (hash-ref mp 'y ay)))
                       13.0)))
            raw-mps))
  (if (pair? local-mps)
      (let* ([cnt (length local-mps)]
             [mcx (/ (for/sum ([m (in-list local-mps)]) (exact->inexact (hash-ref m 'x ax))) cnt)]
             [mcy (/ (for/sum ([m (in-list local-mps)]) (exact->inexact (hash-ref m 'y ay))) cnt)]
             [dx (- mcx ax)]
             [dy (- mcy ay)]
             [d (max 0.5 (sqrt (+ (* dx dx) (* dy dy))))])
        (values (safe-coord (+ ax (* dist (/ dx d))) ax)
                (safe-coord (+ ay (* dist (/ dy d))) ay)))
      (l2-interior-offset ctx dist 0.0 ax ay)))

;; L37-P0-2 (`#846` + `#855` `#47 NW` Depot Box): Route non-wall `supply-depot` #3+ and
;; `pylon` #2+ through `placement:solve-pro-simcity-layout-placement` when map grids are
;; present (falling back cleanly to spawn-symmetric `fallback-x/y` otherwise).
(define (l2-simcity-supply-anchor ctx canon-sym fallback-x fallback-y)
  (define map-grids (l2-ctx-map-grids ctx))
  (define live-game-obs? (l2-ctx-live-obs-harvesters? ctx))
  (if (and live-game-obs? (hash? map-grids))
      (let* ([rt (l2-ctx-rt ctx)]
             [race (l2-ctx-race ctx)]
             [base-x (l2-ctx-base-x ctx)]
             [base-y (l2-ctx-base-y ctx)]
             [nat-x (l2-ctx-nat-x ctx)]
             [nat-y (l2-ctx-nat-y ctx)]
             [enemy-x (l2-ctx-enemy-x ctx)]
             [enemy-y (l2-ctx-enemy-y ctx)]
             [ally-bldgs (or (l2-ctx-ally-bldgs ctx) '())]
             [step-mineral-patches (or (l2-ctx-step-mineral-patches ctx) '())]
             [step-geysers (or (l2-ctx-step-geysers ctx) '())]
             [expansion-pads (or (l2-ctx-expansion-pads ctx) '())]
             [oledger (l2-ctx-oledger ctx)]
             [frame (l2-ctx-frame ctx)]
             [rsites
              (for/list ([rs (in-list (in-progress-order-ledger-reserved-sites oledger))]
                         #:when (<= frame (reserved-build-site-expires-frame rs)))
                (hasheq 'x (reserved-build-site-x rs)
                        'y (reserved-build-site-y rs)
                        'bldg-sym (reserved-build-site-bldg-sym rs)
                        'builder-id (reserved-build-site-builder-id rs)
                        'expires-frame (reserved-build-site-expires-frame rs)))]
             [wall-bbs (l2-wall-aabbs-for-build ctx #f)])
        (define-values (sx sy)
          (placement:solve-pro-simcity-layout-placement
           canon-sym race base-x base-y nat-x nat-y
           #:enemy-x enemy-x
           #:enemy-y enemy-y
           #:ally-bldgs ally-bldgs
           #:mineral-patches step-mineral-patches
           #:geysers step-geysers
           #:reserved-sites rsites
           #:reserved-aabbs wall-bbs
           #:expansion-pads expansion-pads
           #:map-grids map-grids
           #:frame frame))
        (if (and (real? sx) (real? sy)
                 (not (nan? sx)) (not (nan? sy))
                 (> (dist2d sx sy base-x base-y) 2.5))
            (values (safe-coord sx fallback-x) (safe-coord sy fallback-y))
            (values fallback-x fallback-y)))
      (values fallback-x fallback-y)))

(define (l2-emergency-inmain-supply-anchor ctx retry-idx)
  (define base-x (l2-ctx-base-x ctx))
  (define base-y (l2-ctx-base-y ctx))
  (define nat-x (l2-ctx-nat-x ctx))
  (define nat-y (l2-ctx-nat-y ctx))
  (define obs (l2-ctx-obs ctx))
    (define main-mps
      (filter (lambda (mp)
                (and (hash? mp)
                     (<= (dist2d base-x base-y
                                 (hash-ref mp 'x base-x)
                                 (hash-ref mp 'y base-y))
                         13.0)))
              (let ([mps (hash-ref obs 'mineral-patches '())])
                (if (list? mps) mps '()))))
    (define-values (ux uy)
      (cond
        [(not (null? main-mps))
         (define cnt (length main-mps))
         (define mcx (/ (for/sum ([m (in-list main-mps)]) (exact->inexact (hash-ref m 'x base-x))) cnt))
         (define mcy (/ (for/sum ([m (in-list main-mps)]) (exact->inexact (hash-ref m 'y base-y))) cnt))
         (define dx (- (exact->inexact base-x) mcx))
         (define dy (- (exact->inexact base-y) mcy))
         (define d (max 0.5 (sqrt (+ (* dx dx) (* dy dy)))))
         (values (/ dx d) (/ dy d))]
        [else
         (define dx (- (exact->inexact nat-x) (exact->inexact base-x)))
         (define dy (- (exact->inexact nat-y) (exact->inexact base-y)))
         (define d (max 1.0 (sqrt (+ (* dx dx) (* dy dy)))))
         (values (/ dx d) (/ dy d))]))
    (define angle-offsets '#(0.0 0.55 -0.55 1.10 -1.10 1.65 -1.65))
    (define ang (vector-ref angle-offsets (modulo (max 0 retry-idx) (vector-length angle-offsets))))
    (define ca (cos ang))
    (define sa (sin ang))
    (define rx (- (* ux ca) (* uy sa)))
    (define ry (+ (* ux sa) (* uy ca)))
    (define rad (+ 5.5 (* 0.5 (quotient (max 0 retry-idx) (vector-length angle-offsets)))))
    (values (safe-coord (+ base-x (* rad rx)) (+ base-x 4.5))
            (safe-coord (+ base-y (* rad ry)) (+ base-y 4.5))))

(define (l2-wall-aabbs-for-build ctx exact-wall-slot?)
  (define step-wall-aabbs (l2-ctx-step-wall-aabbs ctx))
    (if exact-wall-slot?
        (filter (lambda (r)
                  (not (memq (reserved-aabb-kind r)
                             '(wall-slot doorway-corridor terran-addon-pad))))
                step-wall-aabbs)
        step-wall-aabbs))

(define (l2-can-spend-supply? ctx cost)
  (define reserve-supply-floor? (l2-ctx-reserve-supply-floor? ctx))
  (define zerg-hold-overlord-min? (l2-ctx-zerg-hold-overlord-min? ctx))
    (and (not reserve-supply-floor?)
         (not zerg-hold-overlord-min?)
         (>= (l2-ctx-effective-free-supply ctx) cost)
         (> (l2-ctx-supply-left ctx) 0)))

(define (l2-spend-resources-and-supply! ctx m-cost g-cost s-cost)
  (set-l2-ctx-minerals! ctx (max 0 (- (l2-ctx-minerals ctx) m-cost)))
  (set-l2-ctx-gas! ctx (max 0 (- (l2-ctx-gas ctx) g-cost)))
  (when (and (> g-cost 0) (> (l2-ctx-bo-reserved-gas ctx) 0))
    (set-l2-ctx-bo-reserved-gas! ctx (max 0 (- (l2-ctx-bo-reserved-gas ctx) g-cost)))
    (set-l2-ctx-bo-reserved-min! ctx (max 0 (- (l2-ctx-bo-reserved-min ctx) m-cost))))
  (when (> s-cost 0)
    (set-l2-ctx-supply-left! ctx (max 0 (- (l2-ctx-supply-left ctx) s-cost)))
    (set-l2-ctx-effective-free-supply! ctx (max 0 (- (l2-ctx-effective-free-supply ctx) s-cost)))))

(define (l2-upgrade-needed? ctx upg-sym)
  (define frame (l2-ctx-frame ctx))
  (define oledger (l2-ctx-oledger ctx))
  (define researched-upgs (l2-ctx-researched-upgs ctx))
    (and (not (eq? upg-sym 'pathogen-glands))
         ;; Phase 0 Patch Resilience: when live ResponseData is loaded (`'stimpack` is always
         ;; defined in every SC2 build), skip upgrades absent from the live server's upgrade table.
         (or (not (sc2-upgrade-defined-in-live-data? 'stimpack))
             (sc2-upgrade-defined-in-live-data? upg-sym))
         (not (memq upg-sym researched-upgs))
         (not (memq upg-sym (l2-ctx-pending-upgs ctx)))
         (= (order-ledger-pending-count-for-type oledger upg-sym frame) 0)))

(define (l2-cur-ally-canon-bldg-count ctx bldg-sym)
  (define ally-bldgs (l2-ctx-ally-bldgs ctx))
    (unless (l2-ctx-ally-canon-bldg-counts-ht ctx)
      (define ht (make-hasheq))
      (for ([b (in-list ally-bldgs)]
            #:when (hash? b))
        (define cs (fast-canonical-structure-sym (unit-type-sym b)))
        (hash-set! ht cs (add1 (hash-ref ht cs 0))))
      (for ([ut (in-list (or (l2-ctx-unit-types ctx) '()))])
        (cond
          [(eq? ut 'spore-crawler-uprooted)
           (hash-set! ht 'spore-crawler (add1 (hash-ref ht 'spore-crawler 0)))]
          [(eq? ut 'spine-crawler-uprooted)
           (hash-set! ht 'spine-crawler (add1 (hash-ref ht 'spine-crawler 0)))]))
      (set-l2-ctx-ally-canon-bldg-counts-ht! ctx ht))
    (hash-ref (l2-ctx-ally-canon-bldg-counts-ht ctx) (fast-canonical-structure-sym bldg-sym) 0))

(define (l2-record-build-issue-lock! ctx bldg-sym)
  (define cd-tracker (l2-ctx-cd-tracker ctx))
  (define frame (l2-ctx-frame ctx))
  (define live-game-obs? (l2-ctx-live-game-obs? ctx))
    (when (and live-game-obs?
               (refractory-cooldown-tracker? cd-tracker)
               (hash? (refractory-cooldown-tracker-table cd-tracker)))
      (define tbl (refractory-cooldown-tracker-table cd-tracker))
      (define cs (fast-canonical-structure-sym bldg-sym))
      (define key (fast-build-issue-lock-key cs))
      (define cur-cnt (l2-cur-ally-canon-bldg-count ctx cs))
      (define prev (hash-ref tbl key #f))
      (define fail-streak
        (if (and (pair? prev)
                 (>= (length prev) 2)
                 (= cur-cnt (cadr prev))
                 (<= 0 (- frame (car prev)))
                 (< (- frame (car prev)) 672))
            (min 4 (add1 (if (>= (length prev) 3) (caddr prev) 0)))
            0))
      (hash-set! tbl key (list frame cur-cnt fail-streak))))

(define (l2-build-issue-blocked? ctx bldg-sym [cd-frames #f])
  (define cd-tracker (l2-ctx-cd-tracker ctx))
  (define frame (l2-ctx-frame ctx))
  (define live-game-obs? (l2-ctx-live-game-obs? ctx))
    (define cs (fast-canonical-structure-sym bldg-sym))
    (define tbl (and live-game-obs?
                     (refractory-cooldown-tracker? cd-tracker)
                     (refractory-cooldown-tracker-table cd-tracker)))
    (define lock-entry (and (hash? tbl) (hash-ref tbl (fast-build-issue-lock-key cs) #f)))
    (and (pair? lock-entry)
         (let* ([last-issue-f (car lock-entry)]
                [last-issue-cnt (cadr lock-entry)]
                [fail-streak (if (>= (length lock-entry) 3) (caddr lock-entry) 0)]
                [supply-or-first-core?
                 (or (memq cs '(supply-depot pylon lair hive orbital-command planetary-fortress))
                     (and (= last-issue-cnt 0)
                          (memq cs '(barracks spawning-pool gateway factory starport))))]
                [eff-cd (cond
                          [(exact-integer? cd-frames) cd-frames]
                          [(and (eq? cs 'spawning-pool)
                                (l2-ctx-worker-rush-active? ctx)
                                (= (l2-cur-ally-canon-bldg-count ctx cs) 0))
                           12]
                          ;; L38-P0-1c (`#5138250`): Singleton Cybernetics Core takes >56f when a Probe walks
                          ;; from main minerals to a natural wall slot; hold issue lock for 168f (7.5s) while
                          ;; count == 0 so escrow fallback (`64f`) never launches a duplicate CyberCore Probe!
                          [(and (eq? cs 'cybernetics-core)
                                (= last-issue-cnt 0))
                           168]
                          [supply-or-first-core? 56]
                          [(and (eq? cs 'spire)
                                (or (l2-ctx-zerg-holding-for-aa-spire? ctx)
                                    (and (macro-brain-decision? (l2-ctx-macro-decision ctx))
                                         (memq 'spire (macro-brain-decision-scheduled-ids (l2-ctx-macro-decision ctx))))))
                           28]
                          [(and (memq cs '(nexus command-center hatchery))
                                (<= (l2-ctx-active-bases ctx) 1)
                                (>= (l2-ctx-minerals ctx) (sc2-min-cost cs)))
                           84]
                          [(>= fail-streak 3) 336]
                          [(= fail-streak 2) 224]
                          [(= fail-streak 1) 112]
                          [else 56])])
           (and (<= 0 (- frame last-issue-f))
                (< (- frame last-issue-f) eff-cd)
                (= (l2-cur-ally-canon-bldg-count ctx cs) last-issue-cnt)
                (let ([last-cancel-f (hash-ref tbl (fast-save-cancel-rebuild-key cs) #f)])
                  (not (and (exact-integer? last-cancel-f)
                            (>= last-cancel-f last-issue-f)
                            (l2-save-cancel-rebuild-ready? ctx cs 60))))))))

(define (l2-building-present-or-pending-count ctx bldg-sym [include-free-addons? #f])
  (define frame (l2-ctx-frame ctx))
  (define oledger (or (l2-ctx-oledger ctx) (l2-ctx-oledger-early ctx)))
  (define cs (fast-canonical-structure-sym bldg-sym))
  (define live-and-morph-cnt
    (let ([eq-syms (fast-structure-equivalent-syms bldg-sym include-free-addons?)])
      (+ (for/sum ([s (in-list (or (l2-ctx-bldg-types ctx) '()))])
           (define cs-s (fast-canonical-structure-sym s))
           (if (or (eq? cs-s cs) (memq s eq-syms) (memq cs-s eq-syms)) 1 0))
         (for/sum ([ut (in-list (or (l2-ctx-unit-types ctx) '()))])
           (cond
             [(and (eq? cs 'spore-crawler) (eq? ut 'spore-crawler-uprooted)) 1]
             [(and (eq? cs 'spine-crawler) (eq? ut 'spine-crawler-uprooted)) 1]
             [else 0])))))
  (define pending-cnt
    (if oledger
        (max (order-ledger-pending-count-for-type oledger cs frame)
             (if (eq? bldg-sym cs)
                 0
                 (order-ledger-pending-count-for-type oledger bldg-sym frame)))
        0))
  (define issue-lock-bump
    (if (and (= pending-cnt 0) (l2-build-issue-blocked? ctx cs)) 1 0))
  (+ live-and-morph-cnt pending-cnt issue-lock-bump))

(define (l2-building-present-or-pending? ctx bldg-sym [include-free-addons? #f])
  (define frame (l2-ctx-frame ctx))
  (define oledger (or (l2-ctx-oledger ctx) (l2-ctx-oledger-early ctx)))
  (define bt (or (l2-ctx-bldg-types ctx) '()))
  (define mt (or (l2-ctx-morphing-bldg-types ctx) '()))
  (define ut (or (l2-ctx-unit-types ctx) '()))
  (define eq-syms (fast-structure-equivalent-syms bldg-sym include-free-addons?))
  (for/or ([s (in-list eq-syms)])
    (define cs (fast-canonical-structure-sym s))
    (or (memq s bt)
        (memq cs bt)
        (memq s mt)
        (memq cs mt)
        (and (eq? cs 'spore-crawler) (memq 'spore-crawler-uprooted ut))
        (and (eq? cs 'spine-crawler) (memq 'spine-crawler-uprooted ut))
        (and oledger (> (order-ledger-pending-count-for-type oledger s frame) 0))
        (and oledger
             (not (eq? cs s))
             (> (order-ledger-pending-count-for-type oledger cs frame) 0))
        (l2-build-issue-blocked? ctx cs))))

;; L36-P0-3 (`#5138232`) / L38-P0-1c (`#5138250`): Detect any friendly worker currently walking
;; or carrying a queued order to place a building (e.g. Probe carrying ability 894
;; `build-cybernetics-core` as ord0 OR queued behind `harvest-return`/`move`, OR tagged with
;; `'build-target`) even after order-ledger TTL or wire `worker-build-order-stuck?` expires!
(define (l2-worker-carrying-build-ability? ctx ability-id [canon-bldg-sym #f])
  (define target-ab-sym
    (and canon-bldg-sym
         (string->symbol (format "build-~a" canon-bldg-sym))))
  (define (unit-matches? u)
    (and (hash? u)
         (or (eqv? (hash-ref u 'order-ability-id 0) ability-id)
             (and target-ab-sym
                  (eq? (hash-ref u 'order-ability-sym #f) target-ab-sym))
             (and canon-bldg-sym
                  (let ([bt (hash-ref u 'build-target #f)])
                    (and bt (eq? (fast-canonical-structure-sym bt) canon-bldg-sym))))
             (let ([ords (hash-ref u 'orders '())])
               (and (list? ords)
                    (for/or ([o (in-list ords)])
                      (or (eqv? o ability-id)
                          (and target-ab-sym (eq? o target-ab-sym))
                          (and (hash? o)
                               (or (eqv? (hash-ref o 'ability-id 0) ability-id)
                                   (eqv? (hash-ref o 'ability_id 0) ability-id)
                                   (and target-ab-sym
                                        (or (eq? (hash-ref o 'ability-sym #f) target-ab-sym)
                                            (eq? (hash-ref o 'ability #f) target-ab-sym))))))))))))
  (or (for/or ([u (in-list (or (l2-ctx-workers ctx) '()))]) (unit-matches? u))
      (for/or ([u (in-list (or (l2-ctx-ally-units ctx) '()))]) (unit-matches? u))))

;; =============================================================================
;; Loop 66 Phase C1: Central L2 Macro Arbiter Spend Funnel (`arbiter-resolve!`)
;; Enforces active BO/brain escrow centrally on non-essential live spends while
;; recording structured `'budget-gas`, `'budget-mineral`, and `'facility-busy`
;; override signals into `(rt-arbiter-ledger rt)` for cross-step adaptation!
;; =============================================================================
(define (l2-has-ready-research-slot-owner? ctx r-slot)
  (or (not r-slot)
      (> (hash-ref (or (l2-ctx-open-prod-slots ctx) (hasheq)) r-slot 0) 0)
      (ormap (lambda (bt)
               (eq? (l2-normalize-facility-slot-sym ctx bt) r-slot))
             (or (l2-ctx-ready-bldg-types ctx) '()))))

(define (l2-has-ready-producer-owner? ctx producer-key)
  (or (eq? producer-key 'larva)
      (> (hash-ref (or (l2-ctx-open-prod-slots ctx) (hasheq)) producer-key 0) 0)
      (let ([rtypes (or (l2-ctx-ready-bldg-types ctx) '())])
        (case producer-key
          [(gateway) (and (or (memq 'gateway rtypes) (memq 'warp-gate rtypes)) #t)]
          [(townhall)
           (ormap (lambda (s)
                    (memq s '(hatchery lair hive nexus command-center orbital-command planetary-fortress)))
                  rtypes)]
          [(barracks-techlab) (and (memq 'barracks rtypes) #t)]
          [(factory-techlab)  (and (memq 'factory rtypes) #t)]
          [(starport-techlab) (and (memq 'starport rtypes) #t)]
          [else (and (memq producer-key rtypes) #t)]))))

(define (l2-arbiter-authorize-spend! ctx id-sym domain priority
                                     #:minerals m
                                     #:gas g
                                     #:supply [sup 0]
                                     #:larva [larv 0]
                                     #:facility-slot [fslot #f]
                                     #:essential? [essential? #f]
                                     #:alternatives [alts '()])
  (define live-game? (l2-ctx-live-obs-harvesters? ctx))
  (define rt (l2-ctx-rt ctx))
  (define ledger (and rt (rt-arbiter-ledger rt)))
  (cond
    [(or (not live-game?) (not ledger)) #t]
    [else
     (define frame (safe-nonneg-int (l2-ctx-frame ctx) 0))
     (define cur-min (safe-nonneg-int (l2-ctx-minerals ctx) 0))
     (define cur-gas (safe-nonneg-int (l2-ctx-gas ctx) 0))
     (define cur-sup
       (let ([sl (l2-ctx-supply-left ctx)])
         (if (exact-integer? sl) sl 200)))
     (define open-slots (or (l2-ctx-open-prod-slots ctx) (hasheq)))
     (define cur-larva (hash-ref open-slots 'larva 0))
     (define eff-min (max 0 (if (exact-integer? m) m (exact-round m))))
     (define eff-gas (max 0 (if (exact-integer? g) g (exact-round g))))
     (define eff-sup (max 0 (if (exact-integer? sup) sup (exact-round sup))))
     (define eff-larv (max 0 (if (exact-integer? larv) larv (exact-round larv))))
     (define active-escrow-sym (l2-ctx-active-escrow-sym ctx))
     (define escrow-suppressed? (l2-ctx-escrow-suppressed-active? ctx))
     (define res-min (if escrow-suppressed? 0 (safe-nonneg-int (l2-ctx-bo-reserved-min ctx) 0)))
     (define res-gas (if escrow-suppressed? 0 (safe-nonneg-int (l2-ctx-bo-reserved-gas ctx) 0)))
     (define enforce-escrow?
       (and (not essential?)
            (> (+ res-min res-gas) 0)
            (not (and active-escrow-sym
                      (or (eq? id-sym active-escrow-sym)
                          (eq? (sc2-canonical-structure-sym id-sym)
                               (sc2-canonical-structure-sym active-escrow-sym)))))))
     (define slot-ok? (or (not fslot) (> (hash-ref open-slots fslot 0) 0)))
     (define raw-afford?
       (and slot-ok?
            (<= eff-larv cur-larva)
            (or (= eff-sup 0) (<= eff-sup cur-sup))
            (or (= eff-min 0) (<= eff-min cur-min))
            (or (= eff-gas 0) (<= eff-gas cur-gas))))
     ;; Zero-allocation fast path when essential (or no active escrow) AND affordable + slot open
     (if (and (not enforce-escrow?) raw-afford?)
         #t
         (let ()
           (define budget
             (make-arbiter-budget-snapshot
              #:minerals cur-min
              #:gas cur-gas
              #:supply-left cur-sup
              #:larva-count cur-larva
              #:open-facility-slots open-slots))
           (define spend-prop
             (make-proposal
              (list 'l2-spend id-sym)
              'l2-macro-runtime
              domain
              priority
              (list 'authorize id-sym)
              #:cost (make-proposal-cost
                      #:minerals eff-min
                      #:gas eff-gas
                      #:supply eff-sup
                      #:larva eff-larv
                      #:facility-slot fslot)
              #:attention-tier (if essential? 0 2)
              #:alternatives (if (list? alts) alts '())
              #:rationale (if enforce-escrow? 'l2-escrow-checked-spend 'l2-macro-spend)))
           (define escrow-props
             (if enforce-escrow?
                 (list (make-proposal
                        (list 'l2-escrow (or active-escrow-sym 'bo-reserve))
                        'l2-macro-escrow
                        'macro
                        (max (+ (exact->inexact priority) 100.0) 850.0)
                        (list 'escrow (or active-escrow-sym 'bo-reserve))
                        #:cost (make-proposal-cost #:minerals res-min #:gas res-gas)
                        #:attention-tier 1
                        #:rationale 'active-macro-escrow
                        #:blocking-escrow? #t))
                 '()))
           (define res
             (arbiter-resolve! ledger frame budget (append escrow-props (list spend-prop))))
           (define accepted-acts (arbiter-result-approved-actions res))
           (cond
             [(ormap (lambda (a) (and (pair? a) (eq? (car a) 'authorize) (eq? (second a) id-sym)))
                     accepted-acts)
              #t]
             [(and (pair? alts)
                   (ormap (lambda (a) (and (pair? a) (not (eq? (car a) 'escrow)))) accepted-acts))
              => (lambda (alt-act) alt-act)]
             [else #f])))]))

(define (l2-brain-scheduled-now? ctx sym)
  (define md (l2-ctx-macro-decision ctx))
  (and (macro-brain-decision? md)
       (let ([sids (macro-brain-decision-scheduled-ids md)]
             [csym (sc2-canonical-structure-sym sym)])
         (and (or (memq sym sids) (memq csym sids)) #t))))

(define (l2-emit-build-verified! ctx bldg-sym raw-x raw-y
                                [clearance SC2-BUILD-SITE-MIN-CLEARANCE]
                                #:exact-wall-slot? [exact-wall-slot? #f]
                                #:waive-worker-reserve? [waive-worker-reserve? #f]
                                #:bypass-escrow? [bypass-escrow? #f])
  (define SIMCITY-EXCLUDED-BLDG-SYMS (l2-ctx-SIMCITY-EXCLUDED-BLDG-SYMS ctx))
  (define ally-bldgs (l2-ctx-ally-bldgs ctx))
  (define base-x (l2-ctx-base-x ctx))
  (define base-y (l2-ctx-base-y ctx))
  (define cd-tracker (l2-ctx-cd-tracker ctx))
  (define enemy-x (l2-ctx-enemy-x ctx))
  (define enemy-y (l2-ctx-enemy-y ctx))
  (define expansion-pads (l2-ctx-expansion-pads ctx))
  (define frame (l2-ctx-frame ctx))
  (define live-game-obs? (l2-ctx-live-game-obs? ctx))
  (define map-grids (l2-ctx-map-grids ctx))
  (define nat-x (l2-ctx-nat-x ctx))
  (define nat-y (l2-ctx-nat-y ctx))
  (define oledger (l2-ctx-oledger ctx))
  (define race (l2-ctx-race ctx))
  (define rt (l2-ctx-rt ctx))
  (define step-geysers (l2-ctx-step-geysers ctx))
  (define step-mineral-patches (l2-ctx-step-mineral-patches ctx))
    (define canon-sym (fast-canonical-structure-sym bldg-sym))
    (define w-res-min (l2-brain-worker-reserve-min ctx canon-sym))
    (define static-def?
      (and (memq canon-sym '(spine-crawler spore-crawler photon-cannon shield-battery missile-turret bunker))
           #t))
    (define bldg-essential?
      (or static-def?
          (and (memq canon-sym '(pylon supply-depot)) #t)
          exact-wall-slot?
          waive-worker-reserve?
          bypass-escrow?
          (l2-ctx-early-survival-crisis? ctx)
          (l2-ctx-under-base-attack? ctx)
          (eq? canon-sym (l2-ctx-bo-goal-sym ctx))
          (eq? canon-sym (l2-ctx-active-escrow-sym ctx))
          (eq? canon-sym (l2-ctx-prio-saving-for-sym ctx))
          (and (memq canon-sym (or (l2-ctx-repaired-prereqs ctx) '())) #t)
          (l2-brain-scheduled-now? ctx canon-sym)))
    (unless (or (l2-build-issue-blocked? ctx canon-sym)
                ;; W6-P0-2-rt / L36-P0-3 (`#5138232`) / L38-P0-1c (`#5138250`): Strict singleton
                ;; Cybernetics Core guard across all callers, including Probes with queued 894 orders!
                (and (eq? canon-sym 'cybernetics-core)
                     (or (> (l2-cur-ally-canon-bldg-count ctx 'cybernetics-core) 0)
                         (l2-building-present-or-pending? ctx 'cybernetics-core)
                         (l2-worker-carrying-build-ability? ctx 894 'cybernetics-core)))
                (l2-crisis-tech-bldg-deferred? ctx canon-sym)
                (and (not waive-worker-reserve?)
                     (> w-res-min 0)
                     (< (- (l2-ctx-minerals ctx) w-res-min) (sc2-min-cost bldg-sym)))
                (not (l2-arbiter-authorize-spend!
                      ctx canon-sym 'macro (if bldg-essential? 780.0 600.0)
                      #:minerals (sc2-min-cost bldg-sym)
                      #:gas (sc2-gas-cost bldg-sym)
                      #:essential? bldg-essential?)))
      ;; Never let `solve-pro-simcity-layout-placement` relocate a 1-base high-ground static
      ;; defense anchor (`raw-x, raw-y` near `base-x, base-y`) down to the unowned natural front!
      (define keep-1base-inmain-sd?
        (and static-def?
             (<= (l2-ctx-active-bases ctx) 1)
             (<= (fast-dist2d raw-x raw-y base-x base-y) 12.0)))
      ;; L55-T3 (`#73 ZvP who`): When a caller explicitly targets an off-main base (`> 14t` from
      ;; Main) for a static detector (`spore-crawler`, `missile-turret`, `photon-cannon`), honor
      ;; `(raw-x, raw-y)` directly instead of letting `solve-pro-simcity-layout-placement`
      ;; (which ignores `raw-x/y`!) drag Natural/3rd-base static detectors back to Main!
      (define keep-offmain-static-det?
        (and (memq canon-sym '(spore-crawler missile-turret photon-cannon))
             (> (fast-dist2d raw-x raw-y base-x base-y) 14.0)))
      ;; L22-P0-3 (`#36 PvZ`): During <4:00 early survival crisis / base attack, NEVER let
      ;; `solve-pro-simcity-layout-placement` relocate an emergency Protoss Gateway out to the
      ;; breached natural wall — keep it strictly in-main near Main Nexus!
      (define keep-protoss-crisis-inmain-gate?
        (and (eq? race 'Protoss)
             (eq? canon-sym 'gateway)
             live-game-obs?
             (< frame 5400)
             (or (l2-ctx-early-survival-crisis? ctx)
                 (l2-ctx-under-base-attack? ctx))))
      ;; L19-P0-3 / L20-P0-3 (`#43 ZvP` & `#16 ZvT` Spire/RoachWarren): Honor verified
      ;; creep-ring fallback coordinates for Zerg creep tech buildings on Spire, off-main anchor,
      ;; contested main, or retry (`fail-streak > 0`) instead of overwriting with stale `sc-cache`!
      (define zerg-creep-tech-bldg?
        (and (eq? race 'Zerg)
             (not (not (memq canon-sym '(spire roach-warren baneling-nest hydralisk-den
                                         infestation-pit lurker-den ultralisk-cavern
                                         evolution-chamber spawning-pool))))))
      (define zerg-spire-creep-ring-bypass?
        (and zerg-creep-tech-bldg?
             (or (eq? canon-sym 'spire)
                 (> (fast-dist2d raw-x raw-y base-x base-y) 14.0)
                 (and live-game-obs? (l2-enemy-hostile-near-point? ctx base-x base-y 16.0))
                 (let* ([tbl (and live-game-obs?
                                  (refractory-cooldown-tracker? cd-tracker)
                                  (refractory-cooldown-tracker-table cd-tracker))]
                        [le (and (hash? tbl) (hash-ref tbl (fast-build-issue-lock-key canon-sym) #f))])
                   (and (pair? le) (>= (length le) 3) (> (caddr le) 0))))))
      (define use-simcity?
        (and (not exact-wall-slot?)
             (not keep-1base-inmain-sd?)
             (not keep-offmain-static-det?)
             (not keep-protoss-crisis-inmain-gate?)
             (not zerg-spire-creep-ring-bypass?)
             (not (memq canon-sym SIMCITY-EXCLUDED-BLDG-SYMS))
             (or static-def?
                 live-game-obs?
                 (pair? step-mineral-patches)
                 (pair? step-geysers)
                 map-grids)
             (or static-def?
                 (let ([d-base (fast-dist2d raw-x raw-y base-x base-y)]
                       [d-nat (fast-dist2d raw-x raw-y nat-x nat-y)])
                   (and (<= d-base 25.0)
                        (or (<= d-base d-nat)
                            (<= (fast-dist2d base-x base-y nat-x nat-y) 1.0)))))))
      (define-values (target-x target-y)
        (if use-simcity?
            (let* ([sc-cache (rt-simcity-cache rt)]
                   [sc-key (if (or static-def?
                                   (> (fast-dist2d raw-x raw-y base-x base-y) 25.0))
                               (list canon-sym
                                     (inexact->exact (round base-x))
                                     (inexact->exact (round base-y))
                                     (quotient (inexact->exact (round raw-x)) 8)
                                     (quotient (inexact->exact (round raw-y)) 8)
                                     (length (l2-ctx-bldg-types ctx)))
                               (list canon-sym
                                     (inexact->exact (round base-x))
                                     (inexact->exact (round base-y))
                                     (length (l2-ctx-bldg-types ctx))))]
                   [cached (hash-ref sc-cache sc-key #f)])
              (if cached
                  (values (car cached) (cdr cached))
                  (let ([rsites
                         (for/list ([rs (in-list (in-progress-order-ledger-reserved-sites oledger))]
                                    #:when (<= frame (reserved-build-site-expires-frame rs)))
                           (hasheq 'x (reserved-build-site-x rs)
                                   'y (reserved-build-site-y rs)
                                   'bldg-sym (reserved-build-site-bldg-sym rs)
                                   'builder-id (reserved-build-site-builder-id rs)
                                   'expires-frame (reserved-build-site-expires-frame rs)))]
                        [wall-bbs (l2-wall-aabbs-for-build ctx #f)])
                    (define-values (sx sy)
                      (placement:solve-pro-simcity-layout-placement
                       canon-sym race base-x base-y nat-x nat-y
                       #:enemy-x enemy-x
                       #:enemy-y enemy-y
                       #:ally-bldgs ally-bldgs
                       #:mineral-patches step-mineral-patches
                       #:geysers step-geysers
                       #:reserved-sites rsites
                       #:reserved-aabbs wall-bbs
                       #:expansion-pads expansion-pads
                       #:map-grids map-grids
                       #:frame frame))
                    (hash-set! sc-cache sc-key (cons sx sy))
                    (values sx sy))))
            (values raw-x raw-y)))
      (define-values (bx by)
        (order-ledger-resolve-build-coords!
         oledger bldg-sym target-x target-y ally-bldgs frame clearance
         #:expansion-pads expansion-pads
         #:exact-wall-slot? exact-wall-slot?
         #:reserved-aabbs (l2-wall-aabbs-for-build ctx exact-wall-slot?)))
      (define sx0 (safe-coord bx raw-x))
      (define sy0 (safe-coord by raw-y))
      ;; Never re-place a building directly into active enemy combat fire (`#5134177`):
      ;; if the target site is contested (`<= 12` tiles of active enemy combat units, or
      ;; within `10` tiles of a recently canceled/destroyed site), shift placement to safe
      ;; main interior; if no safe interior site exists, abort emitting the build!
      (define site-danger-r (if static-def? 9.5 12.0))
      (define enemy-units-cur (l2-ctx-enemy-units ctx))
      (define site-contested?
        (and live-game-obs?
             (or (l2-active-enemy-combat-within? enemy-units-cur sx0 sy0 site-danger-r)
                 (l2-site-recently-contested? ctx sx0 sy0 10.0))))
      (define-values (sx sy emit-ok? used-exact-wall?)
        (if (not site-contested?)
            (values sx0 sy0 #t exact-wall-slot?)
            (let loop ([retry-i 0])
              (cond
                [(>= retry-i 7)
                 (values sx0 sy0 #f #f)]
                [else
                 (define-values (cand-ax cand-ay)
                   (if zerg-creep-tech-bldg?
                       (l2-zerg-creep-ring-anchor ctx raw-x raw-y (+ retry-i 1))
                       (l2-emergency-inmain-supply-anchor ctx retry-i)))
                 (define-values (rx ry)
                   (order-ledger-resolve-build-coords!
                    oledger bldg-sym cand-ax cand-ay ally-bldgs frame clearance
                    #:expansion-pads expansion-pads
                    #:exact-wall-slot? #f
                    #:reserved-aabbs (l2-wall-aabbs-for-build ctx #f)))
                 (define csx (safe-coord rx cand-ax))
                 (define csy (safe-coord ry cand-ay))
                 (if (and (not (l2-active-enemy-combat-within? enemy-units-cur csx csy site-danger-r))
                          (not (l2-site-recently-contested? ctx csx csy 10.0)))
                     (values csx csy #t #f)
                     (loop (add1 retry-i)))]))))
      (when emit-ok?
        (l2-emit! ctx (list 'build bldg-sym sx sy))
        (l2-record-build-issue-lock! ctx canon-sym)
        (when (and used-exact-wall?
                   live-game-obs?
                   (refractory-cooldown-tracker? cd-tracker)
                   (hash? (refractory-cooldown-tracker-table cd-tracker)))
          (hash-set! (refractory-cooldown-tracker-table cd-tracker)
                     (list 'build-issue-exact-wall canon-sym)
                     frame))
        (order-ledger-record-issued! oledger (+ 820000 (modulo frame 10000) (length (l2-ctx-actions ctx)))
                                     'build bldg-sym sx sy frame)
        (set-l2-ctx-bldg-types! ctx (cons canon-sym (l2-ctx-bldg-types ctx)))
        (l2-spend-resources-and-supply! ctx (sc2-min-cost bldg-sym) (sc2-gas-cost bldg-sym) 0))))

(define (l2-emit-gas-build-verified! ctx gas-sym raw-x raw-y [cost-sym gas-sym])
  (define base-x (l2-ctx-base-x ctx))
  (define base-y (l2-ctx-base-y ctx))
  (define frame (l2-ctx-frame ctx))
  (define oledger (l2-ctx-oledger ctx))
  (define rt (l2-ctx-rt ctx))
    (define canon-sym (fast-canonical-structure-sym gas-sym))
    (define gas-essential?
      (or (< (l2-cur-ally-canon-bldg-count ctx canon-sym)
             (if (>= (l2-ctx-active-bases ctx) 2) 2 1))
          (eq? canon-sym (l2-ctx-bo-goal-sym ctx))
          (eq? canon-sym (l2-ctx-active-escrow-sym ctx))
          (eq? canon-sym (l2-ctx-prio-saving-for-sym ctx))
          (l2-brain-scheduled-now? ctx canon-sym)
          (and rt
               (>= (arbiter-recent-override-count (rt-arbiter-ledger rt) 'l2-macro-runtime 'budget-gas frame #:window-frames 224) 3))))
    (unless (or (l2-build-issue-blocked? ctx canon-sym)
                (not (l2-arbiter-authorize-spend!
                      ctx canon-sym 'macro (if gas-essential? 760.0 600.0)
                      #:minerals (sc2-min-cost cost-sym)
                      #:gas 0
                      #:essential? gas-essential?)))
      (define sx (safe-coord raw-x (+ base-x 4.0)))
      (define sy (safe-coord raw-y (+ base-y 4.0)))
      (l2-emit! ctx (list 'build gas-sym sx sy))
      (l2-record-build-issue-lock! ctx canon-sym)
      (order-ledger-record-issued! oledger (+ 815000 (modulo frame 10000) (length (l2-ctx-actions ctx)))
                                   'build gas-sym sx sy frame)
      (set-l2-ctx-bldg-types! ctx (cons canon-sym (l2-ctx-bldg-types ctx)))
      (l2-spend-resources-and-supply! ctx (sc2-min-cost cost-sym) 0 0)))

(define (l2-unit-count ctx sym)
    (hash-ref (l2-ctx-unit-counts ctx) (sc2-canonical-unit-sym sym) 0))

(define (l2-normalize-facility-slot-sym ctx sym)
    (define csym (sc2-canonical-structure-sym sym))
    (case csym
      [(gateway warp-gate) 'gateway]
      [(hatchery lair hive nexus command-center orbital-command planetary-fortress) 'townhall]
      [(spire greater-spire) 'spire]
      [else csym]))

(define (l2-barracks-addon-kind ctx b)
  (define terran-rax-reactor-bldgs (l2-ctx-terran-rax-reactor-bldgs ctx))
  (define terran-rax-techlab-bldgs (l2-ctx-terran-rax-techlab-bldgs ctx))
    (define explicit (hash-ref b 'addon #f))
    (define atag (hash-ref b 'add-on-tag 0))
    (cond
      [(eq? explicit 'techlab) 'techlab]
      [(eq? explicit 'reactor) 'reactor]
      [(and (> atag 0)
            (for/or ([ab (in-list terran-rax-techlab-bldgs)]) (equal? (hash-ref ab 'id -1) atag)))
       'techlab]
      [(and (> atag 0)
            (for/or ([ab (in-list terran-rax-reactor-bldgs)]) (equal? (hash-ref ab 'id -1) atag)))
       'reactor]
      [else
       (define bx (exact->inexact (hash-ref b 'x -999.0)))
       (define by (exact->inexact (hash-ref b 'y -999.0)))
       (define ax (fl+ bx (exact->inexact SC2-TERRAN-ADDON-OFFSET-X)))
       (define ay (fl+ by (exact->inexact SC2-TERRAN-ADDON-OFFSET-Y)))
       (cond
         [(for/or ([ab (in-list terran-rax-techlab-bldgs)])
            (define dx (fl- ax (exact->inexact (hash-ref ab 'x -9999.0))))
            (define dy (fl- ay (exact->inexact (hash-ref ab 'y -9999.0))))
            (fl<= (fl+ (fl* dx dx) (fl* dy dy)) 3.0625))
          'techlab]
         [(for/or ([ab (in-list terran-rax-reactor-bldgs)])
            (define dx (fl- ax (exact->inexact (hash-ref ab 'x -9999.0))))
            (define dy (fl- ay (exact->inexact (hash-ref ab 'y -9999.0))))
            (fl<= (fl+ (fl* dx dx) (fl* dy dy)) 3.0625))
          'reactor]
         [else #f])]))

;; Loop 62 Phase 2: Single upgrade-researcher slot authority in `lib/priority-macro-brain.rkt`
;; (`sc2-upgrade-researcher-slot`, covering all canonical upgrades and legacy aliases).
(define (l2-upgrade-researcher-slot ctx upg-sym)
  (define raw-slot (sc2-upgrade-researcher-slot upg-sym))
  (and raw-slot (l2-normalize-facility-slot-sym ctx raw-slot)))

(define (l2-emit-research-verified! ctx upg-sym)
  (define base-x (l2-ctx-base-x ctx))
  (define base-y (l2-ctx-base-y ctx))
  (define crisis-tech-upgrade-deferral? (l2-ctx-crisis-tech-upgrade-deferral? ctx))
  (define frame (l2-ctx-frame ctx))
  (define live-game? (l2-ctx-live-obs-harvesters? ctx))
  (define oledger (l2-ctx-oledger ctx))
  (define open-prod-slots (l2-ctx-open-prod-slots ctx))
  (define rt (l2-ctx-rt ctx))
    (define r-slot (l2-upgrade-researcher-slot ctx upg-sym))
    (define essential-combat-upg?
      (and (memq upg-sym '(stimpack metabolic-boost warp-gate zerg-flyer-armor-1 zerg-flyer-armor-2 interference-matrix))
           #t))
    (define w-res-min (l2-brain-worker-reserve-min ctx upg-sym))
    (define m-cost (sc2-min-cost upg-sym))
    (define g-cost (sc2-gas-cost upg-sym))
    (define upg-essential?
      (or essential-combat-upg?
          (and (>= (l2-ctx-active-bases ctx) 2)
               (memq upg-sym '(protoss-ground-weapons-1
                               terran-infantry-weapons-1
                               zerg-missile-weapons-1
                               zerg-melee-weapons-1))
               #t)
          (eq? upg-sym (l2-ctx-bo-goal-sym ctx))
          (eq? upg-sym (l2-ctx-active-escrow-sym ctx))
          (eq? upg-sym (l2-ctx-prio-saving-for-sym ctx))
          (l2-brain-scheduled-now? ctx upg-sym)
          (>= (l2-ctx-minerals ctx) 800)))
    (define eligible-now?
      (and (or (not crisis-tech-upgrade-deferral?)
               essential-combat-upg?
               (>= (l2-ctx-minerals ctx) 800))
           (l2-upgrade-needed? ctx upg-sym)
           (or (not live-game?)
               (l2-has-ready-research-slot-owner? ctx r-slot))))
    (when (and eligible-now?
               (l2-arbiter-authorize-spend!
                ctx upg-sym 'macro (if upg-essential? 780.0 620.0)
                #:minerals (+ m-cost w-res-min)
                #:gas g-cost
                #:facility-slot (and live-game? r-slot)
                #:essential? upg-essential?)
               (or (not live-game?)
                   (not r-slot)
                   (> (hash-ref open-prod-slots r-slot 0) 0))
               (>= (- (l2-ctx-minerals ctx) w-res-min) m-cost)
               (>= (l2-ctx-gas ctx) g-cost)
               (or (not live-game?)
                   (refractory-allow-action?! (live-bot-runtime-cooldown-tracker rt)
                                              (list 'research-upg upg-sym)
                                              frame
                                              28)))
      (l2-recall-building-group! ctx 7)
      (l2-emit! ctx (list 'research upg-sym))
      (set-l2-ctx-pending-upgs! ctx (cons upg-sym (l2-ctx-pending-upgs ctx)))
      (when (and live-game? r-slot)
        (hash-set! open-prod-slots r-slot (max 0 (sub1 (hash-ref open-prod-slots r-slot 0)))))
      (order-ledger-record-issued! oledger (+ 850000 (modulo frame 10000) (length (l2-ctx-actions ctx)))
                                   'research upg-sym base-x base-y frame)
      (l2-spend-resources-and-supply! ctx m-cost g-cost 0)))

;; Launch up to the number of idle `slot-sym` researchers, advancing +1 -> +2 -> +3 only once prereqs complete.
(define (l2-emit-upgrade-queue! ctx slot-sym specs)
  (define live-game? (l2-ctx-live-obs-harvesters? ctx))
  (define researched-upgs (l2-ctx-researched-upgs ctx))
  (define slots-left
    (if live-game?
        (hash-ref (l2-ctx-open-prod-slots ctx) slot-sym 0)
        (max 1 (l2-cur-ally-canon-bldg-count ctx slot-sym))))
  (let loop ([rem specs] [avail slots-left])
    (when (and (> avail 0) (not (null? rem)))
      (match-define (list upg-sym req-prev extra-ok?) (car rem))
      (define prereq-ok? (or (not live-game?) (not req-prev) (memq req-prev researched-upgs)))
      (define launched?
        (and extra-ok?
             prereq-ok?
             (l2-upgrade-needed? ctx upg-sym)
             (begin
               (l2-emit-research-verified! ctx upg-sym)
               (and (memq upg-sym (l2-ctx-pending-upgs ctx)) #t))))
      (loop (cdr rem) (if launched? (sub1 avail) avail)))))

(define (l2-tech-plan-boosted-unit? ctx sym)
  (define tp (l2-ctx-tech-plan ctx))
  (define tech-obs (l2-ctx-tech-obs ctx))
  (and (adaptive-tech-plan? tp)
       (or (and (memq sym (adaptive-tech-plan-priority-morphs tp)) #t)
           (let ([p (assq sym (adaptive-tech-plan-desired-unit-mix tp))])
             (and p
                  (>= (cdr p) 0.30)
                  (or (>= (or (l2-ctx-eff-phase-supply ctx) 0) 26)
                      (and tech-obs
                           (or (enemy-tech-observation-requires-anti-air? tech-obs)
                               (enemy-tech-observation-requires-detection? tech-obs)))))))))

(define (l2-plan-wants-now? ctx sym)
  (define bo-goal-sym (l2-ctx-bo-goal-sym ctx))
  (define macro-decision (l2-ctx-macro-decision ctx))
  (define plan-next-actions-ht (l2-ctx-plan-next-actions-ht ctx))
  (define tp (l2-ctx-tech-plan ctx))
    (define csym (sc2-canonical-structure-sym sym))
    (or (eq? bo-goal-sym sym)
        (eq? bo-goal-sym csym)
        (hash-has-key? plan-next-actions-ht sym)
        (hash-has-key? plan-next-actions-ht csym)
        (not (not (memq sym (macro-brain-decision-scheduled-ids macro-decision))))
        (not (not (memq csym (macro-brain-decision-scheduled-ids macro-decision))))
        (and (adaptive-tech-plan? tp)
             (or (and (or (memq sym (adaptive-tech-plan-priority-upgrades tp))
                          (memq csym (adaptive-tech-plan-priority-upgrades tp)))
                      #t)
                 (and (or (memq sym (adaptive-tech-plan-priority-morphs tp))
                          (memq csym (adaptive-tech-plan-priority-morphs tp)))
                      #t)
                 (and (or (memq sym (adaptive-tech-plan-counter-tech-buildings tp))
                          (memq csym (adaptive-tech-plan-counter-tech-buildings tp)))
                      (or (not (memq csym '(ultralisk-cavern hive greater-spire fusion-core)))
                          (>= (or (l2-ctx-eff-phase-supply ctx) 0) 50)))
                 (l2-tech-plan-boosted-unit? ctx sym)))))

(define (l2-core-progression-exempt-from-surcharge? ctx target-sym)
  (define active-escrow-sym (l2-ctx-active-escrow-sym ctx))
  (define ally-combat-units (l2-ctx-ally-combat-units ctx))
  (define bo-goal-sym (l2-ctx-bo-goal-sym ctx))
  (define effective-enemy-race (l2-ctx-effective-enemy-race ctx))
  (define enemy-units (l2-ctx-enemy-units ctx))
  (define frame (l2-ctx-frame ctx))
  (define live-enemy-threat-supply (l2-ctx-live-enemy-threat-supply ctx))
  (define supply-used (l2-ctx-supply-used ctx))
  (define total-bldg-counts (l2-ctx-total-bldg-counts ctx))
  (define under-base-attack? (l2-ctx-under-base-attack? ctx))
  (define enemy-has-reaper-or-air?
    (and (list? enemy-units)
         (ormap (lambda (e)
                  (and (hash? e)
                       (or (eq? (fast-canonical-unit-sym (unit-type-sym e)) 'reaper)
                           (hash-ref e 'flying? #f))))
                enemy-units)))
    (and target-sym
         (or (and (eq? target-sym 'robotics-facility)
                  (= (sc2-count-equivalent-structures total-bldg-counts 'robotics-facility #f) 0)
                  (>= supply-used 30))
             (and (eq? target-sym 'spawning-pool)
                  (= (sc2-count-equivalent-structures total-bldg-counts 'spawning-pool #f) 0))
             ;; W18-P0-3-rt (`#14 T v oberon`): First Factory TechLab (50M/25G, Siege Tank unlock)
             ;; is core survival progression — never tax it with +125M/+50G non-combat surcharge!
             (and (eq? target-sym 'factory-techlab)
                  (= (sc2-count-equivalent-structures total-bldg-counts 'factory-techlab #f) 0))
             (and (eq? target-sym 'cybernetics-core)
                  (= (sc2-count-equivalent-structures total-bldg-counts 'cybernetics-core #f) 0)
                  (or (not under-base-attack?)
                      enemy-has-reaper-or-air?
                      (eq? effective-enemy-race 'Terran)
                      (and (list? ally-combat-units) (not (null? ally-combat-units)))
                      (>= frame 1400)))
             (and (not under-base-attack?)
                  (or (memq target-sym
                            '(spawning-pool cybernetics-core forge
                              orbital-command barracks-techlab factory starport engineering-bay
                              robotics-facility twilight-council))
                      (and (<= live-enemy-threat-supply 4.0)
                           (or (eq? target-sym bo-goal-sym)
                               (eq? target-sym active-escrow-sym)
                               (memq target-sym
                                     '(roach-warren queen
                                       hatchery nexus command-center
                                       warp-gate-research metabolic-boost stimpack lair)))))))))

;; W6-P0-3-rt: Detect when Terran's first Factory (150M/100G) is ready to drop ahead of
;; Barracks #2+, Bunkers #2+, Refinery #2+, Engineering Bay, and Marauders (matching Pro ~128-150s
;; while preserving Suite 5.15 `stimpack-ready-ahead-of-factory?` and PV7 stale-intel liveness).
(define (l2-terran-need-factory1-now? ctx)
  (and (eq? (l2-ctx-race ctx) 'Terran)
       (l2-ctx-live-obs-harvesters? ctx)
       (memq 'barracks (or (l2-ctx-ready-bldg-types ctx) '()))
       (= (l2-cur-ally-canon-bldg-count ctx 'factory) 0)
       (not (memq 'factory (or (l2-ctx-bldg-types ctx) '())))
       (let ([oledger (l2-ctx-oledger ctx)])
         (or (not oledger)
             (= (order-ledger-pending-count-for-type oledger 'factory (l2-ctx-frame ctx)) 0)))
       (not (l2-build-issue-blocked? ctx 'factory))
       (l2-save-cancel-rebuild-ready? ctx 'factory 60)
       (>= (l2-ctx-gas ctx) (sc2-gas-cost 'factory))
       (not (l2-ctx-terran-saving-for-expand? ctx))
       (not (l2-ctx-early-survival-crisis? ctx))
       (not (l2-ctx-under-base-attack? ctx))
       ;; Preserve PV7 stale-intel-preemption: when severely blind with <2 army supply,
       ;; train basic defender/scout first before spending 150M on Factory #1.
       (or (not (l2-ctx-severe-intel-blindness? ctx))
           (>= (or (l2-ctx-live-army-supply ctx) 0) 2))
       ;; Preserve Suite 5.15: never preempt Stimpack when TechLab + 2 Orbitals + Stimpack ready
       (not (and (memq 'barracks-techlab (or (l2-ctx-ready-bldg-types ctx) '()))
                 (not (l2-ctx-urgent-combat-or-intel-need? ctx))
                 (l2-upgrade-needed? ctx 'stimpack)
                 (>= (count (lambda (b)
                              (and (hash? b)
                                   (memq (unit-type-sym b) '(orbital-command orbital-command-flying))))
                            (or (l2-ctx-ally-bldgs ctx) '()))
                     2)
                 (>= (l2-ctx-minerals ctx) (sc2-min-cost 'stimpack))
                 (>= (l2-ctx-gas ctx) (sc2-gas-cost 'stimpack))))))

;; Reserve `50M * remaining-brain-scheduled-workers` ahead of lower-ranked L2 spenders
;; (optional tech, upgrades, addons, non-crisis specialist units) so L2's phase order
;; never drains minerals that Brain already allocated to workers!
(define (l2-brain-worker-reserve-min ctx target-sym)
  (define rem (or (l2-ctx-brain-scheduled-workers-rem ctx) 0))
  (define w-util (or (l2-ctx-brain-scheduled-worker-util ctx) 0.0))
  (define race (l2-ctx-race ctx))
  (define w-slot (if (eq? race 'Zerg) 'larva 'townhall))
  (define open-slots (l2-ctx-open-prod-slots ctx))
  (define ps (l2-ctx-prio-summary ctx))
  (cond
    [(or (<= rem 0)
         (not (l2-ctx-live-obs-harvesters? ctx))
         (not (hash? ps))
         (not (hash? open-slots))
         (<= (hash-ref open-slots w-slot 0) 0)
         (l2-ctx-crisis-freeze-workers? ctx)
         (l2-ctx-under-base-attack? ctx)
         (l2-ctx-under-early-cheese? ctx)
         (l2-ctx-early-survival-crisis? ctx)
         (l2-ctx-endgame-corner-hunt? ctx)
         (not (l2-worker-army-curve-satisfied? ctx))
         (not (l2-can-spend-supply? ctx 1))
         (and (eq? race 'Terran)
              (l2-ctx-terran-saving-for-orbital? ctx)
              (<= (or (l2-ctx-terran-morphed-th-open-slots ctx) 0) 0))
         (memq target-sym '(drone probe scv overlord pylon supply-depot
                            hatchery nexus command-center orbital-command
                            spawning-pool spire barracks gateway))
         ;; L24-P0-3: Exempt Factory #1 whenever gas >= 75G (not just >= 100G) so continuous
         ;; SCV training never stalls Terran's 1-1-1 core Factory #1 (`#11/#26/#17/#41`).
         (and (eq? target-sym 'factory)
              (or (l2-terran-need-factory1-now? ctx)
                  (and (= (l2-cur-ally-canon-bldg-count ctx 'factory) 0)
                       (>= (l2-ctx-gas ctx) 75))))
         (and (memq target-sym '(bunker spine-crawler spore-crawler shield-battery
                                 photon-cannon missile-turret))
              (> (or (l2-ctx-live-enemy-threat-supply ctx) 0) 0))
         (let ([sf (l2-ctx-prio-saving-for-sym ctx)])
           (and target-sym
                sf
                (not (eq? sf 'none))
                (or (eq? target-sym sf)
                    (eq? (fast-canonical-structure-sym target-sym)
                         (fast-canonical-structure-sym sf)))
                (let ([node (lookup-sc2-tech-node target-sym)])
                  (and node (eq? (sc2-tech-node-kind node) 'build)))
                (not (l2-building-present-or-pending? ctx target-sym)))))
     0]
    [else
     (define target-canon-u (and target-sym (sc2-canonical-unit-sym target-sym)))
     (define target-canon-b (and target-sym (fast-canonical-structure-sym target-sym)))
     (define target-alt
       (case target-sym
         [(warp-gate-research warpgate-research) 'warp-gate]
         [(metabolic-boost) 'zergling-movementspeed]
         [(zergling-movementspeed) 'metabolic-boost]
         [(viking) 'viking-fighter]
         [(viking-fighter viking-assault) 'viking]
         [else #f]))
     (define target-u
       (or (and target-sym
                (for/or ([d (in-list (hash-ref ps 'decisions '()))])
                  (define did (and (hash? d) (hash-ref d 'id #f)))
                  (and did
                       (or (eq? did target-sym)
                           (and target-alt (eq? did target-alt))
                           (eq? (sc2-canonical-unit-sym did) target-canon-u)
                           (eq? (fast-canonical-structure-sym did) target-canon-b))
                       (hash-ref d 'utility #f))))
           0.0))
     (if (< target-u w-util)
         (* (sc2-min-cost (case race [(Zerg) 'drone] [(Terran) 'scv] [else 'probe]))
            (min rem (hash-ref open-slots w-slot 0)))
         0)]))

(define (l2-scheduled-combat-reserve ctx [target-sym #f])
  (define md (l2-ctx-macro-decision ctx))
  (define ps (l2-ctx-prio-summary ctx))
  (define open-prod-slots (l2-ctx-open-prod-slots ctx))
  (cond
    [(or (not (l2-ctx-live-obs-harvesters? ctx))
         (not (macro-brain-decision? md))
         (not (hash? ps))
         (memq target-sym '(pylon supply-depot overlord))
         (and (eq? target-sym 'factory)
              (l2-terran-need-factory1-now? ctx)
              (<= (or (l2-ctx-live-enemy-threat-supply ctx) 0) 2.0)))
     (values 0 0)]
    [else
     (define decisions (hash-ref ps 'decisions '()))
     (define target-canon-u (and target-sym (sc2-canonical-unit-sym target-sym)))
     (define target-canon-b (and target-sym (fast-canonical-structure-sym target-sym)))
     (define target-alt
       (case target-sym
         [(warp-gate-research warpgate-research) 'warp-gate]
         [(metabolic-boost) 'zergling-movementspeed]
         [(zergling-movementspeed) 'metabolic-boost]
         [(viking) 'viking-fighter]
         [(viking-fighter viking-assault) 'viking]
         [else #f]))
     (define target-u
       (or (and target-sym
                (for/or ([d (in-list decisions)])
                  (define did (and (hash? d) (hash-ref d 'id #f)))
                  (and did
                       (or (eq? did target-sym)
                           (and target-alt (eq? did target-alt))
                           (eq? (sc2-canonical-unit-sym did) target-canon-u)
                           (eq? (fast-canonical-structure-sym did) target-canon-b))
                       (hash-ref d 'utility #f))))
           0.0))
     ;; Sum (rather than `max`) all higher-utility scheduled combat/counter/worker items within bank
     ;; so sequential Layer 2 building/upgrade phases cannot piecemeal-drain minerals needed for
     ;; higher-ranked Brain-scheduled items!
     (for/fold ([r-min 0] [r-gas 0])
               ([d (in-list decisions)])
       (define u-sym (and (hash? d) (hash-ref d 'id #f)))
       (define d-cat (and (hash? d) (hash-ref d 'category #f)))
       (define u-mc (if u-sym (max 0 (sc2-min-cost u-sym)) 0))
       (define u-gc (if u-sym (max 0 (sc2-gas-cost u-sym)) 0))
       (if (and u-sym
                (eq? (hash-ref d 'outcome #f) 'scheduled)
                (> (hash-ref d 'utility 0.0) target-u)
                (<= (+ r-min u-mc) (l2-ctx-minerals ctx))
                (<= (+ r-gas u-gc) (l2-ctx-gas ctx))
                (or (and (eq? d-cat 'combat-unit)
                         (not (l2-unit-suppressed-by-counter-pivot? ctx u-sym))
                         (l2-can-spend-supply? ctx (sc2-supply-cost u-sym))
                         (let* ([lookup-sym (case u-sym [(viking-fighter viking-assault) 'viking] [else u-sym])]
                                [node (lookup-sc2-tech-node lookup-sym)]
                                [pslot0 (and node (sc2-tech-node-producer-slot node))]
                                [slot (case pslot0
                                        [(warp-gate warpgate) 'gateway]
                                        [(hatchery lair hive) 'larva]
                                        [else pslot0])])
                           (and slot (hash? open-prod-slots) (> (hash-ref open-prod-slots slot 0) 0))))
                    (and (memq d-cat '(counter-tech tech-upgrade))
                         (let ([node (lookup-sc2-tech-node u-sym)])
                           (and node (eq? (sc2-tech-node-kind node) 'build)))
                         (not (l2-building-present-or-pending? ctx u-sym))
                         (or (eq? u-sym (l2-ctx-bo-goal-sym ctx))
                             (and target-sym
                                  (not (memq target-sym (macro-brain-decision-scheduled-ids md))))))
                    (and (eq? d-cat 'worker)
                         (> (or (l2-ctx-brain-scheduled-workers-rem ctx) 0) 0)
                         (not (l2-ctx-under-base-attack? ctx))
                         (not (l2-ctx-early-survival-crisis? ctx))
                         (not (l2-ctx-crisis-freeze-workers? ctx))
                         (not (memq target-sym '(hatchery nexus command-center orbital-command
                                                 lair hive cybernetics-core
                                                 spawning-pool barracks gateway
                                                 pylon supply-depot overlord)))
                         (not (let ([sf (l2-ctx-prio-saving-for-sym ctx)])
                                (and target-sym
                                     sf
                                     (not (eq? sf 'none))
                                     (or (eq? target-sym sf)
                                         (eq? (fast-canonical-structure-sym target-sym)
                                              (fast-canonical-structure-sym sf)))
                                     (let ([node (lookup-sc2-tech-node target-sym)])
                                       (and node (eq? (sc2-tech-node-kind node) 'build)))
                                     (not (l2-building-present-or-pending? ctx target-sym)))))
                         (l2-can-spend-supply? ctx 1)
                         (let ([w-slot (if (eq? (l2-ctx-race ctx) 'Zerg) 'larva 'townhall)])
                           (and (hash? open-prod-slots) (> (hash-ref open-prod-slots w-slot 0) 0))))))
           (values (+ r-min u-mc)
                   (+ r-gas u-gc))
           (values r-min r-gas)))]))

(define (l2-non-combat-min-ok? ctx cost [target-sym #f])
  (define basic-combat-min-floor (l2-ctx-basic-combat-min-floor ctx))
  (define hard-supply-lockout-reserve-min (l2-ctx-hard-supply-lockout-reserve-min ctx))
  (define urgent-combat-or-intel-need? (l2-ctx-urgent-combat-or-intel-need? ctx))
  (define zerg-hold-overlord-min? (l2-ctx-zerg-hold-overlord-min? ctx))
  (define-values (sched-combat-min _sched-combat-gas)
    (l2-scheduled-combat-reserve ctx target-sym))
  (define worker-res-min (l2-brain-worker-reserve-min ctx target-sym))
    (define supply-lock-floor
      (cond
        [(memq target-sym '(pylon supply-depot overlord)) 0]
        [zerg-hold-overlord-min?
         (max hard-supply-lockout-reserve-min (sc2-min-cost 'overlord))]
        [else hard-supply-lockout-reserve-min]))
    (and (>= (- (l2-ctx-minerals ctx) cost) supply-lock-floor)
         (>= (- (l2-ctx-minerals ctx) cost) (max sched-combat-min worker-res-min))
         (>= (- (l2-ctx-minerals ctx) cost)
             (cond
               [(not urgent-combat-or-intel-need?) 0]
               [(l2-core-progression-exempt-from-surcharge? ctx target-sym) basic-combat-min-floor]
               [else 125]))))

(define (l2-non-combat-gas-ok? ctx cost [target-sym #f])
  (define urgent-combat-or-intel-need? (l2-ctx-urgent-combat-or-intel-need? ctx))
  (define-values (_sched-combat-min sched-combat-gas)
    (l2-scheduled-combat-reserve ctx target-sym))
    (or (<= cost 0)
        (and (>= (- (l2-ctx-gas ctx) cost) sched-combat-gas)
             (>= (- (l2-ctx-gas ctx) cost)
                 (if (and urgent-combat-or-intel-need?
                          (not (l2-core-progression-exempt-from-surcharge? ctx target-sym)))
                     50
                     0)))))

(define (l2-worker-army-curve-satisfied? ctx)
  (define active-bases (l2-ctx-active-bases ctx))
  (define live-army-supply (l2-ctx-live-army-supply ctx))
  (define live-enemy-threat-supply (l2-ctx-live-enemy-threat-supply ctx))
  (define live-game? (l2-ctx-live-obs-harvesters? ctx))
  (define total-workers (l2-ctx-total-workers ctx))
  (define under-base-attack? (l2-ctx-under-base-attack? ctx))
  (define zerg-fog-army-floor-ok? (l2-ctx-zerg-fog-army-floor-ok? ctx))
    (and zerg-fog-army-floor-ok?
         (or (not live-game?)
             (< total-workers 24)
             (and (not under-base-attack?)
                  (or (<= live-enemy-threat-supply 0)
                      (<= live-enemy-threat-supply (* 1.50 (max 6 live-army-supply)))
                      ;; L48-W2 (`H2H #01 ZvZ` Drone-vs-Combat Guard): Do NOT allow `(< total-workers (* 22 active-bases))`
                      ;; to greenlight unbounded droning once `total-workers >= 48` while army lags behind threat!
                      (and (< total-workers (* 22 active-bases))
                           (or (< total-workers 48)
                               (>= live-army-supply
                                   (max 24.0 (* 0.85 live-enemy-threat-supply)))))))
             (>= live-army-supply
                 (required-army-supply-for-worker-growth total-workers live-enemy-threat-supply)))))

(define (l2-can-spend-by-priority? ctx id-sym [cat-sym 'combat-unit])
  (define ally-combat-units (l2-ctx-ally-combat-units ctx))
  (define escrow-suppressed-active? (l2-ctx-escrow-suppressed-active? ctx))
  (define goal-stream-alloc (l2-ctx-goal-stream-alloc ctx))
  (define live-enemy-threat-supply (l2-ctx-live-enemy-threat-supply ctx))
  (define live-game? (l2-ctx-live-obs-harvesters? ctx))
  (define macro-decision (l2-ctx-macro-decision ctx))
  (define protoss-pending-robo-gas-reserve (l2-ctx-protoss-pending-robo-gas-reserve ctx))
  (define severe-intel-blindness? (l2-ctx-severe-intel-blindness? ctx))
  (define under-base-attack? (l2-ctx-under-base-attack? ctx))
    (define m-cost (sc2-min-cost id-sym))
    (define g-cost (sc2-gas-cost id-sym))
    (define alt-sym
      (case id-sym
        [(viking) 'viking-fighter]
        [(viking-fighter viking-assault) 'viking]
        [(templar-archive) 'templar-archives]
        [(templar-archives) 'templar-archive]
        [(lurker-den) 'lurker-den-mp]
        [(lurker-den-mp) 'lurker-den]
        [else #f]))
    (or (not live-game?)
        (and escrow-suppressed-active?
             (or (memq cat-sym '(combat-unit worker))
                 (not (l2-ctx-crisis-tech-upgrade-deferral? ctx)))
             (>= (l2-ctx-minerals ctx) m-cost)
             (>= (l2-ctx-gas ctx) g-cost))
        (and (eq? cat-sym 'combat-unit)
             (>= (l2-ctx-minerals ctx) m-cost)
             (>= (- (l2-ctx-minerals ctx) m-cost) (l2-ctx-hard-supply-lockout-reserve-min ctx))
             (>= (- (l2-ctx-gas ctx) g-cost) (if (> g-cost 0) protoss-pending-robo-gas-reserve 0))
             (or under-base-attack?
                 (>= live-enemy-threat-supply (max 6 (+ (l2-ctx-live-army-supply ctx) 2)))
                 escrow-suppressed-active?
                 (and severe-intel-blindness? (null? ally-combat-units))))
        (macro-brain-can-spend? macro-decision id-sym (l2-ctx-minerals ctx) (l2-ctx-gas ctx) cat-sym)
        (and alt-sym
             (macro-brain-can-spend? macro-decision alt-sym (l2-ctx-minerals ctx) (l2-ctx-gas ctx) cat-sym))
        (and (eq? cat-sym 'combat-unit)
             (>= (l2-ctx-minerals ctx) m-cost)
             (>= (- (l2-ctx-minerals ctx) m-cost) (l2-ctx-bo-reserved-min ctx))
             (>= (- (l2-ctx-gas ctx) g-cost)
                 (max (l2-ctx-bo-reserved-gas ctx)
                      (if (> g-cost 0) protoss-pending-robo-gas-reserve 0)))
             (or (l2-tech-plan-boosted-unit? ctx id-sym)
                 (and alt-sym (l2-tech-plan-boosted-unit? ctx alt-sym))))
        (and (not under-base-attack?)
             (<= live-enemy-threat-supply 0)
             (case cat-sym
               [(expansion) (decoupled-stream-can-spend? goal-stream-alloc 'expansion m-cost g-cost)]
               [(production-scaling)
                (and (>= (l2-ctx-minerals ctx) 550)
                     (decoupled-stream-can-spend? goal-stream-alloc 'production-facilities m-cost g-cost))]
               [else #f]))))

(define (l2-try-train-unit! ctx unit-sym producer-key [recall-group #f]
                            #:respect-bo-reserve? [respect-bo? #f]
                            #:max-batch [max-batch-cap #f]
                            #:alternatives [alts '()])
  (define active-bases (l2-ctx-active-bases ctx))
  (define base-x (l2-ctx-base-x ctx))
  (define base-y (l2-ctx-base-y ctx))
  (define bo-goal-sym (l2-ctx-bo-goal-sym ctx))
  (define frame (l2-ctx-frame ctx))
  (define live-enemy-threat-supply (l2-ctx-live-enemy-threat-supply ctx))
  (define live-game? (l2-ctx-live-obs-harvesters? ctx))
  (define macro-decision (l2-ctx-macro-decision ctx))
  (define oledger (l2-ctx-oledger ctx))
  (define open-prod-slots (l2-ctx-open-prod-slots ctx))
  (define total-workers (l2-ctx-total-workers ctx))
  (define under-base-attack? (l2-ctx-under-base-attack? ctx))
    (define m-cost (sc2-min-cost unit-sym))
    (define g-cost (sc2-gas-cost unit-sym))
    (define s-cost (sc2-supply-cost unit-sym))
    (define alt-u-sym (if (eq? unit-sym 'viking) 'viking-fighter #f))
    (define is-bo-head?
      (or (and (eq? bo-goal-sym unit-sym)
               (or (not live-game?)
                   (not (memq unit-sym '(drone probe scv)))
                   (memq (l2-ctx-prio-saving-for-sym ctx) (list 'none #f unit-sym))))
          (and alt-u-sym (eq? bo-goal-sym alt-u-sym))
          (and live-game?
               (or (not (not (memq unit-sym (macro-brain-decision-scheduled-ids macro-decision))))
                   (and alt-u-sym
                        (not (not (memq alt-u-sym (macro-brain-decision-scheduled-ids macro-decision)))))))))
    (define max-batch
      (cond
        [(not live-game?) 1]
        [(and (memq unit-sym '(drone probe scv))
              (>= active-bases 2)
              (< total-workers (min (race-macro-worker-cap (l2-ctx-race ctx)) (* 22 active-bases)))
              (not under-base-attack?)
              (<= live-enemy-threat-supply 0))
         (min (if (eq? unit-sym 'drone) 6 3) (if (eq? unit-sym 'drone) 6 active-bases))]
        [(memq unit-sym '(drone probe scv queen overlord observer warp-prism sentry raven)) 1]
        [(>= (l2-ctx-minerals ctx) 1000) 8]
        [(>= (l2-ctx-minerals ctx) 600) 6]
        [else 4]))
    (define eff-max-batch
      (if (and (exact-integer? max-batch-cap) (>= max-batch-cap 0))
          (min max-batch max-batch-cap)
          max-batch))
    (define is-worker-unit? (and (memq unit-sym '(drone probe scv)) #t))
    (define sched-unit-cnt
      (if (and live-game? (macro-brain-decision? macro-decision))
          (count (lambda (s) (or (eq? s unit-sym) (and alt-u-sym (eq? s alt-u-sym))))
                 (macro-brain-decision-scheduled-ids macro-decision))
          0))
    (define w-res-min
      (if (or is-worker-unit? (eq? unit-sym 'overlord))
          0
          (l2-brain-worker-reserve-min ctx unit-sym)))
    (if (or (l2-unit-suppressed-by-counter-pivot? ctx unit-sym)
            (and live-game? (eq? unit-sym 'cyclone) (>= (l2-unit-count ctx 'cyclone) 2)))
        #f
        (let loop ([trained 0])
          (define avail-slots (hash-ref open-prod-slots producer-key 0))
          (define bo-res-bypass?
            (and is-bo-head?
                 (or (= trained 0) (< trained sched-unit-cnt))))
          (define bo-min-deduct (if (and respect-bo? (not bo-res-bypass?)) (l2-ctx-bo-reserved-min ctx) 0))
          (define eff-min (- (l2-ctx-minerals ctx) (max bo-min-deduct w-res-min)))
          (define eff-gas (if (and respect-bo? (not bo-res-bypass?)) (- (l2-ctx-gas ctx) (l2-ctx-bo-reserved-gas ctx)) (l2-ctx-gas ctx)))
          (cond
            [(and (< trained eff-max-batch)
                  (> avail-slots 0)
                  (l2-can-spend-supply? ctx s-cost)
                  (or (<= m-cost 0) (>= eff-min m-cost))
                  (or (<= g-cost 0) (>= eff-gas g-cost)))
             (hash-set! open-prod-slots producer-key (sub1 avail-slots))
             (when (and recall-group (= trained 0))
               (l2-recall-building-group! ctx recall-group))
             (l2-emit! ctx (list 'train unit-sym))
             (order-ledger-record-issued! oledger (+ 860000 (modulo frame 10000) (length (l2-ctx-actions ctx)))
                                          'train unit-sym base-x base-y frame)
             (set-l2-ctx-unit-counts! ctx (hash-update (l2-ctx-unit-counts ctx) (sc2-canonical-unit-sym unit-sym) add1 0))
             (when (and is-worker-unit? (> (or (l2-ctx-brain-scheduled-workers-rem ctx) 0) 0))
               (set-l2-ctx-brain-scheduled-workers-rem! ctx (sub1 (l2-ctx-brain-scheduled-workers-rem ctx))))
             (l2-spend-resources-and-supply! ctx m-cost g-cost s-cost)
             (loop (add1 trained))]
            [else
             ;; Loop 66 Phase C1: Record structured `'budget-gas` / `'facility-busy` overrides in
             ;; `(rt-arbiter-ledger rt)` when a live combat unit train fails due to gas or full slots
             ;; (and honor optional mineral-only `#:alternatives` fallback proposals when provided!).
             (when (and live-game?
                        (= trained 0)
                        (> eff-max-batch 0)
                        (not is-worker-unit?)
                        (not (eq? unit-sym 'overlord))
                        (l2-can-spend-supply? ctx s-cost)
                        (l2-has-ready-producer-owner? ctx producer-key)
                        (or (<= avail-slots 0)
                            (and (> g-cost 0)
                                 (< eff-gas g-cost)
                                 (or (<= m-cost 0) (>= eff-min m-cost)))))
               (define arb-auth
                 (l2-arbiter-authorize-spend!
                  ctx unit-sym 'macro (if (or (not respect-bo?) bo-res-bypass?) 740.0 580.0)
                  #:minerals m-cost
                  #:gas g-cost
                  #:supply s-cost
                  #:larva (if (eq? producer-key 'larva) 1 0)
                  #:facility-slot producer-key
                  #:essential? (or (not respect-bo?) bo-res-bypass?)
                  #:alternatives alts))
               (when (and (pair? arb-auth)
                          (eq? (car arb-auth) 'train)
                          (symbol? (second arb-auth)))
                 (define alt-sym (second arb-auth))
                 (l2-try-train-unit! ctx alt-sym producer-key recall-group
                                     #:respect-bo-reserve? respect-bo?
                                     #:max-batch 1)))
             (> trained 0)]))))

(define (l2-emit-building-morph-verified! ctx target-sym source-syms [recall-group 4])
  (define base-x (l2-ctx-base-x ctx))
  (define base-y (l2-ctx-base-y ctx))
  (define frame (l2-ctx-frame ctx))
  (define live-game? (l2-ctx-live-obs-harvesters? ctx))
  (define oledger (l2-ctx-oledger ctx))
  (define open-prod-slots (l2-ctx-open-prod-slots ctx))
  (define ready-bldg-types (l2-ctx-ready-bldg-types ctx))
  (define ready-bldgs (l2-ctx-ready-bldgs ctx))
    (define m-cost (sc2-min-cost target-sym))
    (define g-cost (sc2-gas-cost target-sym))
    (define-values (src-bldg idle-src-cnt)
      (for/fold ([first-b #f] [cnt 0])
                ([b (in-list ready-bldgs)])
        (define ord-cnt (hash-ref b 'order-count 0))
        (define ord-ab  (hash-ref b 'order-ability-id 0))
        (define non-blocking-rally?
          (and (= ord-cnt 1)
               ;; Loop 61 (`#1609` RC-7): Fix rally list — remove `3691` (BUILD_CREEPTUMOR), add `199/203/207`.
               (memv ord-ab '(195 199 203 207 211 212 3673 3690))))
        (if (and (hash? b)
                 (memq (fast-canonical-structure-sym (unit-type-sym b)) source-syms)
                 (or (and (<= ord-cnt 0) (= ord-ab 0))
                     non-blocking-rally?)
                 (not (order-ledger-facility-busy? oledger b frame)))
            (values (or first-b b) (add1 cnt))
            (values first-b cnt))))
    (define w-res-min (l2-brain-worker-reserve-min ctx target-sym))
    (define has-src-type?
      (and (ormap (lambda (s) (memq s ready-bldg-types)) source-syms) #t))
    (define morph-essential?
      (or (and (memq (fast-canonical-structure-sym target-sym) '(orbital-command planetary-fortress)) #t)
          (eq? target-sym (l2-ctx-bo-goal-sym ctx))
          (eq? target-sym (l2-ctx-active-escrow-sym ctx))
          (eq? target-sym (l2-ctx-prio-saving-for-sym ctx))
          (l2-brain-scheduled-now? ctx target-sym)))
    (define morph-arb-ok?
      (if (and live-game?
               has-src-type?
               (not (l2-crisis-tech-bldg-deferred? ctx target-sym))
               (not (l2-building-present-or-pending? ctx target-sym)))
          (and (l2-arbiter-authorize-spend!
                ctx target-sym 'macro (if morph-essential? 790.0 640.0)
                #:minerals (+ m-cost w-res-min)
                #:gas g-cost
                #:facility-slot (if src-bldg #f 'morph-source-busy)
                #:essential? morph-essential?)
               #t)
          #t))
    (cond
      [(and morph-arb-ok?
            (not (l2-crisis-tech-bldg-deferred? ctx target-sym))
            (not (l2-building-present-or-pending? ctx target-sym))
            (>= (- (l2-ctx-minerals ctx) w-res-min) m-cost)
            (>= (l2-ctx-gas ctx) g-cost)
            (or src-bldg
                (and (not live-game?)
                     has-src-type?)))
       (when recall-group
         (l2-recall-building-group! ctx recall-group))
       (l2-emit! ctx (list 'morph target-sym))
       (define rec-id
         (if (hash? src-bldg)
             (hash-ref src-bldg 'id (+ 821000 (modulo frame 10000) (length (l2-ctx-actions ctx))))
             (+ 821000 (modulo frame 10000) (length (l2-ctx-actions ctx)))))
       (order-ledger-record-issued! oledger rec-id 'morph target-sym base-x base-y frame)
       (when (and live-game?
                  (or (not (eq? (fast-canonical-structure-sym target-sym) 'orbital-command))
                      (<= idle-src-cnt 1)))
         (l2-record-build-issue-lock! ctx target-sym))
       (set-l2-ctx-bldg-types! ctx (cons (sc2-canonical-structure-sym target-sym) (l2-ctx-bldg-types ctx)))
       (set-l2-ctx-morphing-bldg-types! ctx (cons (sc2-canonical-structure-sym target-sym) (l2-ctx-morphing-bldg-types ctx)))
       (when (and live-game? (ormap (lambda (s) (memq s '(hatchery lair command-center))) source-syms))
         (hash-set! open-prod-slots 'townhall
                    (max 0 (sub1 (hash-ref open-prod-slots 'townhall 0)))))
       (l2-spend-resources-and-supply! ctx m-cost g-cost 0)
       #t]
      [else #f]))

(define (l2-emit-unit-morph-verified! ctx target-sym source-sym [net-supply-cost 0]
                                      #:waive-worker-reserve? [waive-worker-reserve? #f])
  (define base-x (l2-ctx-base-x ctx))
  (define base-y (l2-ctx-base-y ctx))
  (define frame (l2-ctx-frame ctx))
  (define live-game? (l2-ctx-live-obs-harvesters? ctx))
  (define oledger (l2-ctx-oledger ctx))
  (define open-prod-slots (l2-ctx-open-prod-slots ctx))
  (define unit-types (l2-ctx-unit-types ctx))
    (define m-cost (sc2-min-cost target-sym))
    (define g-cost (sc2-gas-cost target-sym))
    (define avail-src (hash-ref open-prod-slots source-sym 0))
    (define w-res-min (if waive-worker-reserve? 0 (l2-brain-worker-reserve-min ctx target-sym)))
    (cond
      [(l2-unit-suppressed-by-counter-pivot? ctx target-sym) #f]
      [(and (or (> avail-src 0)
                (and (not live-game?) (memq source-sym unit-types)))
            (or (<= net-supply-cost 0) (l2-can-spend-supply? ctx net-supply-cost))
            (>= (- (l2-ctx-minerals ctx) w-res-min) m-cost)
            (>= (l2-ctx-gas ctx) g-cost))
       (when (> avail-src 0)
         (hash-set! open-prod-slots source-sym (sub1 avail-src)))
       (l2-emit! ctx (list 'morph target-sym))
       (order-ledger-record-issued! oledger (+ 865000 (modulo frame 10000) (length (l2-ctx-actions ctx)))
                                    'morph target-sym base-x base-y frame)
       (set-l2-ctx-unit-counts! ctx (hash-update (l2-ctx-unit-counts ctx) (sc2-canonical-unit-sym target-sym) add1 0))
       (l2-spend-resources-and-supply! ctx m-cost g-cost (max 0 net-supply-cost))
       #t]
      [else #f]))

(define (l2-third-base-prereqs-ready-for-escrow? ctx)
  (define eff-phase-supply (l2-ctx-eff-phase-supply ctx))
  (define live-army-supply (l2-ctx-live-army-supply ctx))
  (define live-game? (l2-ctx-live-obs-harvesters? ctx))
  (define race (l2-ctx-race ctx))
  (define ready-bldg-types (l2-ctx-ready-bldg-types ctx))
    (case race
      [(Zerg)
       (and (>= eff-phase-supply 30)
            (memq 'spawning-pool ready-bldg-types))]
      [(Protoss)
       (and (>= eff-phase-supply 46)
            (>= live-army-supply 10)
            (or (>= (l2-ctx-total-workers ctx) 38)
                (eq? (l2-ctx-prio-saving-for-sym ctx) 'nexus)
                (not (and (memq 'robotics-bay ready-bldg-types)
                          (= (l2-unit-count ctx 'colossus) 0))))
            (or (memq 'robotics-facility (l2-ctx-bldg-types ctx))
                (memq 'twilight-council (l2-ctx-bldg-types ctx))
                (memq 'stargate (l2-ctx-bldg-types ctx))
                (eq? (l2-ctx-prio-saving-for-sym ctx) 'nexus)
                (l2-plan-wants-now? ctx 'nexus)))]
      [(Terran)
       (and (>= eff-phase-supply 42)
            (or (not live-game?) (>= live-army-supply 10) (>= (l2-ctx-minerals ctx) 550))
            (or (not live-game?)
                (memq 'starport ready-bldg-types)
                (>= (l2-ctx-minerals ctx) 550))
            (or live-game?
                (memq 'starport (l2-ctx-bldg-types ctx))
                (and (not (memq 'factory ready-bldg-types))
                     (or (memq 'factory (l2-ctx-bldg-types ctx))
                         (l2-plan-wants-now? ctx 'command-center)))))]
      [else #f]))

(define (l2-macro-brain-expand-backed-off? ctx)
  (define md (l2-ctx-macro-decision ctx))
  (define ps (l2-ctx-prio-summary ctx))
  (define race-th-sym (l2-ctx-race-th-sym ctx))
  (and (l2-ctx-live-obs-harvesters? ctx)
       (macro-brain-decision? md)
       (hash? ps)
       (not (eq? (macro-brain-decision-saving-for md) race-th-sym))
       (for/or ([d (in-list (hash-ref ps 'decisions '()))])
         (and (hash? d)
              (eq? (hash-ref d 'id #f) race-th-sym)
              (or (<= (hash-ref d 'utility 999.0) 50.0)
                  (and (not (eq? (l2-ctx-bo-goal-sym ctx) race-th-sym))
                       (not (hash-ref d 'blocking? #t))
                       (pair? (macro-brain-decision-scheduled-ids md))))))))

;; L31-P0-3 (`#08`/`#26`): Check whether `sym` appears in the top-N entries of the Macro Brain's
;; `escrow_queue` (`blocked-by-escrow` / `escrowed-saving` trace items) so a 1-base Terran CC #2
;; ranked #2 behind e.g. Starport still activates the 1-base Natural CC mineral hold!
(define (macro-decision-sym-in-escrow-queue-top-n? md sym [max-n 2])
  (and (macro-brain-decision? md)
       (let ([sched (macro-brain-decision-priority-schedule md)])
         (and (priority-schedule-result? sched)
              (let loop ([rem (priority-schedule-decision-trace sched)] [seen 0])
                (cond
                  [(or (null? rem) (>= seen max-n)) #f]
                  [else
                   (define d (car rem))
                   (if (and (priority-decision-entry? d)
                            (memq (priority-decision-entry-outcome d)
                                  '(blocked-by-escrow escrowed-saving)))
                       (if (eq? (priority-decision-entry-id d) sym)
                           #t
                           (loop (cdr rem) (add1 seen)))
                       (loop (cdr rem) seen))]))))))

