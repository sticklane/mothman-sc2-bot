             (length undefended-harassers))))
    (define h-cy
      (if (null? undefended-harassers)
          enemy-y
          (/ (for/sum ([h (in-list undefended-harassers)])
               (exact->inexact (hash-ref h 'y base-y)))
             (length undefended-harassers))))
    (define best-safe-mp
      (and (not (null? safe-harass-mps))
