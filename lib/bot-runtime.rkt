(define (pooled-hasheq! scratch key)
  (let ([ht (hash-ref scratch key #f)])
    (if (hash? ht)
        (begin (hash-clear! ht) ht)
        (let ([nht (make-hasheq)])
          (hash-set! scratch key nht)
          nht))))

(define (pooled-hasheqv! scratch key)
  (let ([ht (hash-ref scratch key #f)])
    (if (hash? ht)
        (begin (hash-clear! ht) ht)
        (let ([nht (make-hasheqv)])
          (hash-set! scratch key nht)
          nht))))

(define (pooled-mutable-set! scratch key)
  (let ([s (hash-ref scratch key #f)])
    (if s
        (begin (set-clear! s) s)
        (let ([ns (mutable-set)])
          (hash-set! scratch key ns)
          ns))))

(define (pooled-mutable-seteqv! scratch key)
  (let ([s (hash-ref scratch key #f)])
    (if s
        (begin (set-clear! s) s)
        (let ([ns (mutable-seteqv)])
          (hash-set! scratch key ns)
          ns))))

(define (pooled-mutable-seteq! scratch key)
  (let ([s (hash-ref scratch key #f)])
    (if s
        (begin (set-clear! s) s)
        (let ([ns (mutable-seteq)])
          (hash-set! scratch key ns)
          ns))))

(define (mutable-hasheq-matches-immut? mht immut)
  (and (hash? immut)
       (= (hash-count mht) (hash-count immut))
       (for/and ([(k v) (in-hash mht)])
         (equal? (hash-ref immut k RUNTIME-MISSING) v))))

(define (reuse-or-freeze-hasheq! scratch key mht)
  (define cached (hash-ref scratch key #f))
  (if (mutable-hasheq-matches-immut? mht cached)
      cached
      (let ([frozen (for/hasheq ([(k v) (in-hash mht)]) (values k v))])
        (hash-set! scratch key frozen)
        frozen)))

