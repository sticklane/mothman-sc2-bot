          (loop (cdr rem) (if (l34-viking-aa-screen-unit? (car rem) ux uy ex ey) (add1 cnt) cnt)))))
  (if live-obs?
      eng-cnt
      (+ eng-cnt
         (let bloop ([rem enemy-bldgs] [cnt 0])
           (if (null? rem)
               cnt
               (let ([eb (car rem)])
                 (if (and (l34-viking-aa-screen-unit? eb ux uy ex ey)
                          (let ([bid (hash-ref eb 'id #f)])
                            (or (not bid)
                                (let uloop ([eu enemy-units])
                                  (or (null? eu)
                                      (and (not (equal? (hash-ref (car eu) 'id #f) bid))
                                           (uloop (cdr eu))))))))
                     (bloop (cdr rem) (add1 cnt))
                     (bloop (cdr rem) cnt))))))))
(define (l34-viper-find-consume-bldg ctx ux uy)
  (define ally-bldgs (l34-ctx-ally-bldgs ctx))
  (define base-x (l34-ctx-base-x ctx))
  (define base-y (l34-ctx-base-y ctx))
  (let loop ([rem ally-bldgs])
    (and (pair? rem)
         (let ([b (car rem)])
           (if (and (>= (hash-ref b 'hp 0) 350)
                    (<= (dist2d ux uy (hash-ref b 'x base-x) (hash-ref b 'y base-y)) 14.0))
               b
               (loop (cdr rem)))))))
(define (l34-viper-find-air-clump ctx ux uy)
  (define enemy-units (l34-ctx-enemy-units ctx))
  (let loop ([rem enemy-units])
    (and (pair? rem)
         (let ([e (car rem)])
           (if (and (fast-unit-is-flying-sym? (unit-type-sym e))
                    (<= (fast-dist2d ux uy (hash-ref e 'x 9999.0) (hash-ref e 'y 9999.0)) 9.0)
                    (>= (let ([ex2 (hash-ref e 'x 0.0)] [ey2 (hash-ref e 'y 0.0)])
                          (let oloop ([orem enemy-units] [cnt 0])
                            (if (or (null? orem) (>= cnt 3))
                                cnt
                                (let ([o (car orem)])
                                  (oloop (cdr orem)
                                         (if (and (fast-unit-is-flying-sym? (unit-type-sym o))
                                                  (<= (fast-dist2d ex2 ey2
                                                                   (hash-ref o 'x 9999.0) (hash-ref o 'y 9999.0))
                                                      3.5))
                                             (add1 cnt)
                                             cnt))))))
                        3))
               e
               (loop (cdr rem)))))))
(define (l34-viper-find-cloud-tgt ctx ux uy)
  (define enemy-units (l34-ctx-enemy-units ctx))
  (let loop ([rem enemy-units])
    (and (pair? rem)
         (let* ([e (car rem)]
                [et2 (unit-type-sym e)])
           (if (and (not (fast-unit-is-flying-sym? et2))
                    (<= (fast-dist2d ux uy (hash-ref e 'x 9999.0) (hash-ref e 'y 9999.0)) 11.0)
                    (or (eq? et2 'siege-tank-sieged)
                        (>= (let ([ex2 (hash-ref e 'x 0.0)] [ey2 (hash-ref e 'y 0.0)])
                              (let oloop ([orem enemy-units] [cnt 0])
                                (if (or (null? orem) (>= cnt 4))
                                    cnt
                                    (let ([o (car orem)])
                                      (oloop (cdr orem)
                                             (if (<= (fast-dist2d ex2 ey2
                                                                  (hash-ref o 'x 9999.0) (hash-ref o 'y 9999.0))
                                                     2.5)
                                                 (add1 cnt)
                                                 cnt))))))
                            4)))
               e
               (loop (cdr rem)))))))
(define (l34-viper-find-abduct-tgt ctx ux uy)
  (define enemy-units (l34-ctx-enemy-units ctx))
  (let loop ([rem enemy-units])
    (and (pair? rem)
         (let ([e (car rem)])
           (if (and (memq (unit-type-sym e)
                          '(siege-tank siege-tank-sieged colossus thor thor-ap
                            carrier tempest immortal battlecruiser brood-lord lurker-burrowed))
                    (<= (dist2d ux uy (hash-ref e 'x 9999.0) (hash-ref e 'y 9999.0)) 9.5))
               e
               (loop (cdr rem)))))))
(define (l34-infestor-find-fungal-tgt ctx ux uy)
  (define enemy-units (l34-ctx-enemy-units ctx))
  (let loop ([rem enemy-units])
    (and (pair? rem)
         (let ([e (car rem)])
           (if (and (<= (dist2d ux uy (hash-ref e 'x 9999.0) (hash-ref e 'y 9999.0)) 10.0)
                    (>= (let ([ex2 (hash-ref e 'x 0.0)] [ey2 (hash-ref e 'y 0.0)])
                          (let oloop ([orem enemy-units] [cnt 0])
                            (if (or (null? orem) (>= cnt 3))
                                cnt
                                (let ([o (car orem)])
                                  (oloop (cdr orem)
                                         (if (<= (dist2d ex2 ey2
                                                         (hash-ref o 'x 9999.0) (hash-ref o 'y 9999.0))
                                                 2.5)
                                             (add1 cnt)
                                             cnt))))))
                        3))
               e
               (loop (cdr rem)))))))
(define (l34-ht-find-storm-tgt ctx ux uy)
  (define enemy-units (l34-ctx-enemy-units ctx))
  (define effects (l34-ctx-effects ctx))
  (let loop ([rem enemy-units])
    (and (pair? rem)
         (let* ([e (car rem)]
                [ex2 (hash-ref e 'x 9999.0)]
                [ey2 (hash-ref e 'y 9999.0)])
           (if (and (<= (dist2d ux uy ex2 ey2) 9.0)
                    (not (let eloop ([efrem effects])
                           (and (pair? efrem)
                                (let ([eff (car efrem)])
                                  (or (and (memq (hash-ref eff 'type 'none) '(psi-storm psionic-storm))
                                           (<= (dist2d ex2 ey2
                                                       (hash-ref eff 'x 9999.0)
                                                       (hash-ref eff 'y 9999.0))
                                               2.0))
                                      (eloop (cdr efrem)))))))
                    (or (eq? (unit-type-sym e) 'siege-tank-sieged)
                        (>= (let oloop ([orem enemy-units] [cnt 0])
                              (if (or (null? orem) (>= cnt 3))
                                  cnt
                                  (let ([o (car orem)])
                                    (oloop (cdr orem)
                                           (if (<= (dist2d ex2 ey2
                                                           (hash-ref o 'x 9999.0) (hash-ref o 'y 9999.0))
                                                   2.0)
                                               (add1 cnt)
                                               cnt)))))
                            3)))
               e
               (loop (cdr rem)))))))
(define (l34-ht-find-feedback-tgt ctx ux uy)
  (define enemy-units (l34-ctx-enemy-units ctx))
  (let loop ([rem enemy-units])
    (and (pair? rem)
         (let ([e (car rem)])
           (if (and (>= (hash-ref e 'energy 0) 75)
                    (<= (dist2d ux uy (hash-ref e 'x 9999.0) (hash-ref e 'y 9999.0)) 10.0))
               e
               (loop (cdr rem)))))))

(define (l34-phase1-setup! ctx rt raw-obs fap-score sanitized?)
  (set-l34-ctx-actions! ctx '())
  (set-l34-ctx-bo-tplan-box! ctx #f)
  (define obs (if sanitized? raw-obs (sanitize-obs-hash raw-obs)))
  (define frame (hash-ref obs 'frame 0))
  (define oledger (live-bot-runtime-order-ledger rt))
  (define tbrain (live-bot-runtime-tactical-brain rt))
  (define ally-units (hash-ref obs 'ally-units '()))
  (define ally-bldgs (hash-ref obs 'ally-buildings '()))
  (define raw-enemy-units (hash-ref obs 'enemy-units '()))
  (define raw-enemy-bldgs (hash-ref obs 'enemy-buildings '()))
  ;; W5-P0-1c-rt: Strip passive enemy CreepTumors ONCE at L34 ingress so 300-tumor ZvZ games
  ;; don't burn O(N*300) across L34 or create fake `-3406` DisengageRetreat tactical arenas!
  ;; Preserve a bounded sample (<= 12) + boolean flag for `plan-counter-creep-clearing`.
  (define-values (enemy-units stripped-tumors-u)
    (let loop ([rem raw-enemy-units] [keep '()] [tum '()] [tc 0] [hit? #f])
      (cond
        [(null? rem) (values (if hit? (reverse keep) raw-enemy-units) (reverse tum))]
        [else
         (define e (car rem))
         (if (and (hash? e) (hash-ref RUNTIME-TUMOR-SET (unit-type-sym e) #f))
             (loop (cdr rem) keep (if (< tc 12) (cons e tum) tum) (add1 tc) #t)
             (loop (cdr rem) (cons e keep) tum tc hit?))])))
  (define-values (enemy-bldgs stripped-tumors-b)
    (let loop ([rem raw-enemy-bldgs] [keep '()] [tum stripped-tumors-u] [tc (length stripped-tumors-u)] [hit? #f])
      (cond
        [(null? rem) (values (if hit? (reverse keep) raw-enemy-bldgs) tum)]
        [else
         (define e (car rem))
         (if (and (hash? e) (hash-ref RUNTIME-TUMOR-SET (unit-type-sym e) #f))
             (loop (cdr rem) keep (if (< tc 12) (cons e tum) tum) (add1 tc) #t)
             (loop (cdr rem) (cons e keep) tum tc hit?))])))
  (define effects (hash-ref obs 'effects '()))
  (define live-upgrades-tracked? (hash-has-key? raw-obs 'researched-upgrades))
  (define researched-upgs (hash-ref obs 'researched-upgrades '()))
  (define base-x (hash-ref obs 'base-x SC2-DEFAULT-HOME-BASE-X))
  (define base-y (hash-ref obs 'base-y SC2-DEFAULT-HOME-BASE-Y))
  (define nat-x (hash-ref obs 'natural-x SC2-DEFAULT-NATURAL-X))
  (define nat-y (hash-ref obs 'natural-y SC2-DEFAULT-NATURAL-Y))
  (define third-x (hash-ref obs 'third-x SC2-DEFAULT-THIRD-X))
  (define third-y (hash-ref obs 'third-y SC2-DEFAULT-THIRD-Y))
  (define enemy-x (hash-ref obs 'enemy-x SC2-DEFAULT-ENEMY-BASE-X))
  (define enemy-y (hash-ref obs 'enemy-y SC2-DEFAULT-ENEMY-BASE-Y))
  (define enemy-exp-x (hash-ref obs 'enemy-expand-x SC2-DEFAULT-ENEMY-EXPAND-X))
  (define enemy-exp-y (hash-ref obs 'enemy-expand-y SC2-DEFAULT-ENEMY-EXPAND-Y))
  (define enemy-third-x
    (let ([v (hash-ref raw-obs 'enemy-third-x #f)])
      (if (finite-real? v)
          (safe-coord v 132.0)
          (safe-coord (* 0.72 enemy-x) 132.0))))
  (define enemy-third-y
    (let ([v (hash-ref raw-obs 'enemy-third-y #f)])
      (if (finite-real? v)
          (safe-coord v 132.0)
          (safe-coord (* 0.72 enemy-y) 132.0))))
  (define pending-upgs (hash-ref obs 'pending-upgrades '()))

  (define leases (rt-role-leases rt))
  (define bstates (rt-bistable-states rt))
  (define splash-st (rt-splash-state rt))
  (define spotter-ht (rt-spotter-lings rt))
  (define live-tactics-obs? (hash-has-key? raw-obs 'mineral-harvesters))
  (define wave3-frame-box (rt-wave3-frame-box rt))
  (define splash-wm-disarmed-ht (hash-ref! splash-st 'wm-disarmed-ht make-hasheqv))
  (define splash-mode-dwell-ht (hash-ref! splash-st 'mode-dwell-ht make-hasheqv))
  (define splash-wm-dwell-ht (hash-ref! splash-st 'wm-dwell-ht make-hasheqv))
  (define splash-lib-dwell-ht (hash-ref! splash-st 'lib-dwell-ht make-hasheqv))
  (define splash-vik-dwell-ht (hash-ref! splash-st 'vik-dwell-ht make-hasheqv))
  (define splash-thor-dwell-ht (hash-ref! splash-st 'thor-dwell-ht make-hasheqv))
  (define splash-bc-jump-ht (hash-ref! splash-st 'bc-jump-ready-ht make-hasheqv))
  (define splash-bc-yamato-ht (hash-ref! splash-st 'bc-yamato-ready-ht make-hasheqv))
  (define splash-tank-dwell-ht (hash-ref! splash-st 'tank-dwell-ht make-hasheqv))
  (define prev-wave3-frame (unbox wave3-frame-box))
  (when (and (>= prev-wave3-frame 0) (< frame prev-wave3-frame))
    (reset-wave3-tactical-state! rt))
  (set-box! wave3-frame-box frame)
  (define spell-claims-rt (rt-spell-claims rt))
  (define unit-mode-tr (rt-unit-mode-tracker rt))
  (define transport-tr (rt-transport-tracker rt))
  (define l34-sc (rt-l34-scratch rt))
  (define wave3-handled-tags (pooled-mutable-seteqv! l34-sc 'wave3-handled-tags))
  (define snipe-locked-tags (pooled-mutable-seteqv! l34-sc 'snipe-locked-tags))
  (define wave3-preserved-set (pooled-mutable-set! l34-sc 'wave3-preserved-set))

  ;; ---------------------------------------------------------------------------
  ;; Zerg Zergling Spotter Scouts (Up to 3 Map Watch Posts, 0-APM Hold Until Needed)
  ;; ---------------------------------------------------------------------------
  ;; W5-P0-1c-rt: Exclude harmless non-combat scouts/overlords/overseers/tumors/changelings & fog
  ;; snapshots from `under-tactics-base-attack?` so a stray Overlord/Tumor near base never blocks
  ;; `endgame-building-hunt` (#1 5m stall fix!). Also save bounded enemy tumors for creep clearing.
  (hash-set! l34-sc 'w5-cohesion-info #f)
  (hash-set! l34-sc 'stripped-enemy-tumors stripped-tumors-b)
  (define under-tactics-base-attack?
    (let ([bx (if (flonum? base-x) base-x (exact->inexact base-x))]
          [by (if (flonum? base-y) base-y (exact->inexact base-y))]
          [nx (if (flonum? nat-x) nat-x (exact->inexact nat-x))]
          [ny (if (flonum? nat-y) nat-y (exact->inexact nat-y))])
      (for/or ([e (in-list enemy-units)])
        (and (hash? e)
             (not (eq? (hash-ref e 'snapshot? #f) #t))
             (eqv? (hash-ref e 'display-type 1) 1)
             (not (memq (unit-type-sym e)
                        '(creep-tumor creep-tumor-burrowed creep-tumor-queen
                          overlord overlord-cocoon overlord-transport overlord-transport-cocoon
                          overseer overseer-siege-mode observer larva egg
                          changeling changeling-zealot changeling-zergling
                          changeling-zergling-wings changeling-marine changeling-marine-shield)))
             (let* ([rx (hash-ref e 'x 9999.0)]
                    [ry (hash-ref e 'y 9999.0)]
                    [ex (if (flonum? rx) rx (exact->inexact rx))]
                    [ey (if (flonum? ry) ry (exact->inexact ry))]
                    [dx1 (fl- bx ex)]
                    [dy1 (fl- by ey)]
                    [dx2 (fl- nx ex)]
                    [dy2 (fl- ny ey)])
               (or (fl<= (fl+ (fl* dx1 dx1) (fl* dy1 dy1)) 676.0)
                   (fl<= (fl+ (fl* dx2 dx2) (fl* dy2 dy2)) 676.0)))))))
  (define door-st-tactics (rt-door-state rt))
  (set-l34-ctx-rt! ctx rt)
  (set-l34-ctx-raw-obs! ctx raw-obs)
  (set-l34-ctx-fap-score! ctx fap-score)
  (set-l34-ctx-obs! ctx obs)
  (set-l34-ctx-frame! ctx frame)
  (set-l34-ctx-oledger! ctx oledger)
  (set-l34-ctx-ally-units! ctx ally-units)
  (set-l34-ctx-ally-bldgs! ctx ally-bldgs)
  (set-l34-ctx-enemy-units! ctx enemy-units)
  (set-l34-ctx-enemy-bldgs! ctx enemy-bldgs)
  (set-l34-ctx-effects! ctx effects)
  (set-l34-ctx-live-upgrades-tracked?! ctx live-upgrades-tracked?)
  (set-l34-ctx-researched-upgs! ctx researched-upgs)
  (set-l34-ctx-base-x! ctx base-x)
  (set-l34-ctx-base-y! ctx base-y)
  (set-l34-ctx-nat-x! ctx nat-x)
  (set-l34-ctx-nat-y! ctx nat-y)
  (set-l34-ctx-third-x! ctx third-x)
  (set-l34-ctx-third-y! ctx third-y)
  (set-l34-ctx-enemy-x! ctx enemy-x)
  (set-l34-ctx-enemy-y! ctx enemy-y)
  (set-l34-ctx-enemy-exp-x! ctx enemy-exp-x)
  (set-l34-ctx-enemy-exp-y! ctx enemy-exp-y)
  (set-l34-ctx-enemy-third-x! ctx enemy-third-x)
  (set-l34-ctx-enemy-third-y! ctx enemy-third-y)
  (set-l34-ctx-pending-upgs! ctx pending-upgs)
  (set-l34-ctx-leases! ctx leases)
  (set-l34-ctx-bstates! ctx bstates)
  (set-l34-ctx-splash-st! ctx splash-st)
  (set-l34-ctx-live-tactics-obs?! ctx live-tactics-obs?)
  (set-l34-ctx-live-obs?! ctx live-tactics-obs?)
  (set-l34-ctx-splash-wm-disarmed-ht! ctx splash-wm-disarmed-ht)
  (set-l34-ctx-splash-mode-dwell-ht! ctx splash-mode-dwell-ht)
  (set-l34-ctx-splash-wm-dwell-ht! ctx splash-wm-dwell-ht)
  (set-l34-ctx-splash-lib-dwell-ht! ctx splash-lib-dwell-ht)
  (set-l34-ctx-splash-vik-dwell-ht! ctx splash-vik-dwell-ht)
  (set-l34-ctx-splash-thor-dwell-ht! ctx splash-thor-dwell-ht)
  (set-l34-ctx-splash-bc-jump-ht! ctx splash-bc-jump-ht)
  (set-l34-ctx-splash-bc-yamato-ht! ctx splash-bc-yamato-ht)
  (set-l34-ctx-splash-tank-dwell-ht! ctx splash-tank-dwell-ht)
  (set-l34-ctx-spell-claims-rt! ctx spell-claims-rt)
  (set-l34-ctx-unit-mode-tr! ctx unit-mode-tr)
  (set-l34-ctx-transport-tr! ctx transport-tr)
  (set-l34-ctx-l34-sc! ctx l34-sc)
  (set-l34-ctx-wave3-handled-tags! ctx wave3-handled-tags)
  (set-l34-ctx-snipe-locked-tags! ctx snipe-locked-tags)
  (set-l34-ctx-wave3-preserved-set! ctx wave3-preserved-set)
  (set-l34-ctx-under-tactics-base-attack?! ctx under-tactics-base-attack?)
  (set-l34-ctx-door-st-tactics! ctx door-st-tactics)
  (when (and live-tactics-obs?
             (eq? (live-bot-runtime-actual-race rt) 'Zerg)
             (not under-tactics-base-attack?)
             (< (safe-nonneg-int (hash-ref obs 'supply-used 0) 0) 165)
             (not (hash-ref obs 'enemy-main-cleared #f))
             (not (hash-ref (rt-endgame-sweep-state rt) 'enemy-main-cleared? #f)))
    (define map-dx (- enemy-x base-x))
    (define map-dy (- enemy-y base-y))
    (define map-d (max 1.0 (sqrt (+ (* map-dx map-dx) (* map-dy map-dy)))))
    (define map-px (/ (- map-dy) map-d))
    (define map-py (/ map-dx map-d))
    (define spotter-posts
      (list (list 'enemy-front
                  (safe-coord (+ enemy-exp-x (* 0.28 (- nat-x enemy-exp-x))) enemy-exp-x)
                  (safe-coord (+ enemy-exp-y (* 0.28 (- nat-y enemy-exp-y))) enemy-exp-y))
            (list 'enemy-third
                  (safe-coord (+ enemy-exp-x (* 14.0 map-px)) enemy-exp-x)
                  (safe-coord (+ enemy-exp-y (* 14.0 map-py)) enemy-exp-y))
            (list 'enemy-fourth
                  (safe-coord (+ (* 0.5 (+ nat-x enemy-exp-x)) (* -14.0 map-px)) nat-x)
                  (safe-coord (+ (* 0.5 (+ nat-y enemy-exp-y)) (* -14.0 map-py)) nat-y))))
    (define all-live-lings
      (for/list ([u (in-list ally-units)]
                 #:when (and (eq? (unit-type-sym u) 'zergling)
                             (not (or (eq? (hash-ref u 'is-hallucination #f) #t)
                                      (eq? (hash-ref u 'hallucination #f) #t)))))
        u))
    ;; Loop 65D (`#1899`/`#1900`): Scale simultaneous Zergling watch-post spotters by
    ;; live Zergling count (`>= 12 -> 3`, `>= 8 -> 2`, `>= 6 -> 1`, else `0`) so a 6-Ling
    ;; runby never sacrifices 50% (3/6) of its squad to watch posts!
    (define live-ling-cnt (length all-live-lings))
    (define max-spotter-posts
      (cond [(>= live-ling-cnt 12) 3]
            [(>= live-ling-cnt 8)  2]
            [(>= live-ling-cnt 6)  1]
            [else 0]))
    (define active-spotter-cnt
      (for/sum ([post (in-list spotter-posts)])
        (define pe (hash-ref spotter-ht (first post) #f))
        (define pt (and (hash? pe) (hash-ref pe 'tag #f)))
        (if (and pt (ormap (lambda (u) (equal? (hash-ref u 'id -1) pt)) all-live-lings))
            1
            0)))
    (for ([post (in-list spotter-posts)])
      (define pkey (first post))
      (define px (second post))
      (define py (third post))
      (define prev-entry (hash-ref spotter-ht pkey #f))
      (define prev-tag (and (hash? prev-entry) (hash-ref prev-entry 'tag #f)))
      (define cd-until (if (hash? prev-entry) (hash-ref prev-entry 'cooldown-until 0) 0))
      (define repost-after (if (hash? prev-entry) (hash-ref prev-entry 'repost-after 0) 0))
      (define live-spotter
        (and prev-tag
             (for/first ([u (in-list all-live-lings)]
                         #:when (equal? (hash-ref u 'id -1) prev-tag))
               u)))
      (cond
        [(and prev-tag (not live-spotter))
         (hash-set! spotter-ht pkey
                    (hash 'tag #f
                          'cooldown-until (max cd-until (+ frame 672))
                          'repost-after (+ frame 672)))]
        [(and (not live-spotter)
              (>= frame cd-until)
              (< active-spotter-cnt max-spotter-posts))
         (define fpx (exact->inexact px))
         (define fpy (exact->inexact py))
         ;; W5-TAC-1: Never steal Zerglings actively engaged within `<=16t` of enemy combat units!
         (define spotter-combat-enemy-coords
           (for/list ([e (in-list enemy-units)]
                      #:when (and (hash? e)
                                  (combat-unit-record? e)
                                  (not (memq (unit-type-sym e)
                                             '(overlord overlord-cocoon overlord-transport overlord-transport-cocoon
                                               overseer overseer-siege-mode observer larva egg
                                               changeling changeling-zealot changeling-zergling
                                               changeling-zergling-wings changeling-marine changeling-marine-shield
                                               creep-tumor creep-tumor-burrowed creep-tumor-queen)))
                                  (real? (hash-ref e 'x #f))
                                  (real? (hash-ref e 'y #f))))
             (cons (exact->inexact (hash-ref e 'x 0.0))
                   (exact->inexact (hash-ref e 'y 0.0)))))
         (define chosen #f)
         (define best-d2 +inf.0)
         (for ([u (in-list all-live-lings)])
           (unless (unit-leased-above? leases (hash-ref u 'id 0) 'army frame)
             (define fux (exact->inexact (hash-ref u 'x px)))
             (define fuy (exact->inexact (hash-ref u 'y py)))
             (define in-combat?
               (for/or ([ec (in-list spotter-combat-enemy-coords)])
                 (define edx (fl- fux (car ec)))
                 (define edy (fl- fuy (cdr ec)))
                 (fl<= (fl+ (fl* edx edx) (fl* edy edy)) 256.0)))
             (unless in-combat?
               (define dx (fl- fpx fux))
               (define dy (fl- fpy fuy))
               (define d2 (fl+ (fl* dx dx) (fl* dy dy)))
               (when (fl< d2 best-d2)
                 (set! chosen u)
                 (set! best-d2 d2)))))
         (when chosen
           (define sid (hash-ref chosen 'id 0))
           (set! active-spotter-cnt (add1 active-spotter-cnt))
           (acquire-unit-lease! leases sid 'spotter frame 32 #:x px #:y py)
           (hash-set! spotter-ht pkey
                      (hash 'tag sid 'cooldown-until 0 'repost-after 0))
           (when (fl> best-d2 6.25)
             (l34-emit! ctx (list 'move sid px py))))]
        [live-spotter
         (define sid (hash-ref live-spotter 'id 0))
         (define sx (hash-ref live-spotter 'x px))
         (define sy (hash-ref live-spotter 'y py))
         (acquire-unit-lease! leases sid 'spotter frame 32 #:x px #:y py)
         (define fsx (if (flonum? sx) sx (exact->inexact sx)))
         (define fsy (if (flonum? sy) sy (exact->inexact sy)))
         (define threat-near
           (for/first ([e (in-list enemy-units)]
                       #:when (let* ([rx (hash-ref e 'x 9999.0)]
                                     [ry (hash-ref e 'y 9999.0)]
                                     [dx (fl- fsx (if (flonum? rx) rx (exact->inexact rx)))]
                                     [dy (fl- fsy (if (flonum? ry) ry (exact->inexact ry)))])
                                (fl<= (fl+ (fl* dx dx) (fl* dy dy)) 81.0)))
             e))
         (cond
           [threat-near
            (define-values (rx ry)
              (compute-kite-vector sx sy
                                   (hash-ref threat-near 'x sx)
                                   (hash-ref threat-near 'y sy)
                                   6.0))
            (hash-set! spotter-ht pkey
                       (hash 'tag sid 'cooldown-until cd-until 'repost-after (+ frame 180)))
            (when (refractory-allow-action?! (live-bot-runtime-cooldown-tracker rt)
                                             (list 'spotter-evade sid)
                                             frame
                                             16)
              (l34-emit! ctx (list 'move sid (safe-coord rx nat-x) (safe-coord ry nat-y))))]
           [(< frame repost-after)
            (void)]
           [(<= (dist2d sx sy px py) 2.0)
            (void)]
           [(and (> (dist2d sx sy px py) 2.5)
                 (refractory-allow-action?! (live-bot-runtime-cooldown-tracker rt)
                                            (list 'spotter-move sid)
                                            frame
                                            28))
            (l34-emit! ctx (list 'move sid px py))])])))

  (define-values (combat-units ground-combat-units live-overseers stasis-frozen-tags
                  cu-cnt cu-sum-x cu-sum-y gcu-cnt gcu-sum-x gcu-sum-y)
    (let loop ([rem ally-units]
               [cu-rev '()] [gcu-rev '()] [ov-rev '()] [sf-ids '()]
               [cc 0] [cx 0.0] [cy 0.0]
               [gc 0] [gx 0.0] [gy 0.0])
      (if (null? rem)
          (values (reverse cu-rev) (reverse gcu-rev) (reverse ov-rev) sf-ids cc cx cy gc gx gy)
          (let* ([u (car rem)]
                 [ut (unit-type-sym u)]
                 [n-ov-rev
                  (if (and (or (eq? ut 'overseer) (eq? ut 'overseer-siege-mode))
                           (not (eq? (hash-ref u 'is-hallucination #f) #t))
                           (not (eq? (hash-ref u 'hallucination #f) #t)))
                      (cons u ov-rev)
                      ov-rev)]
                 [stasis-frozen?
                  (let ([b (hash-ref u 'buffs #f)])
                    (and (list? b)
                         (or (memq 'oracle-stasis-trap-target b)
                             (memq 'stasis-ward-target b))))]
                 [n-sf-ids
                  (if stasis-frozen?
                      (let ([sid (hash-ref u 'id (hash-ref u 'tag -1))])
                        (if (and (exact-integer? sid) (> sid 0))
                            (cons sid sf-ids)
                            sf-ids))
                      sf-ids)]
                 [combat?
                  (and (not stasis-frozen?)
                       (combat-unit-record? u)
                       ;; Loop 65C (`#1874`/`#1876`): Keep active `'staging-group` (`50`) &
                       ;; `'strike-group` (`55`) combat units in `combat-units` on subsequent frames
                       ;; (only exclude utility leases `> 'strike-group`: `'creep-queen` 65, `'spotter` 68,
                       ;; `'scout` 70, `'detector-escort` 75, `'evac` 85, `'door-guard` 90, `'builder` 100)!
                       (not (unit-leased-above? leases (hash-ref u 'id 0) 'strike-group frame)))])
            (if (not combat?)
                (loop (cdr rem) cu-rev gcu-rev n-ov-rev n-sf-ids cc cx cy gc gx gy)
                (let* ([ux-raw (safe-finite-real (hash-ref u 'x nat-x) nat-x)]
                       [uy-raw (safe-finite-real (hash-ref u 'y nat-y) nat-y)]
                       [ux (if (flonum? ux-raw) ux-raw (exact->inexact ux-raw))]
                       [uy (if (flonum? uy-raw) uy-raw (exact->inexact uy-raw))]
                       [ncx (fl+ cx ux)]
                       [ncy (fl+ cy uy)])
                  (if (fast-unit-is-flying-sym? ut)
                      (loop (cdr rem) (cons u cu-rev) gcu-rev n-ov-rev n-sf-ids
                            (add1 cc) ncx ncy gc gx gy)
                      (loop (cdr rem) (cons u cu-rev) (cons u gcu-rev) n-ov-rev n-sf-ids
                            (add1 cc) ncx ncy (add1 gc) (fl+ gx ux) (fl+ gy uy)))))))))
  (define ft (perception-grid-squad-finger-tree (live-bot-runtime-perception rt)))
  (define total-dps (combat-measure-dps (ft-measure ft)))
  (define-values (vanguard-ft reserve-ft)
    (split-by-dps ft (exact-ceiling (* 0.70 total-dps))))
  (define vanguard-count (combat-measure-count (ft-measure vanguard-ft)))
  (define reserve-count (combat-measure-count (ft-measure reserve-ft)))

  ;; Compute primary army centroid early for Overseer escort & siege-line positioning
  (define prelim-army-cx
    (if (= cu-cnt 0)
        nat-x
        (safe-coord (fl/ cu-sum-x (exact->inexact cu-cnt)) nat-x)))
  (define prelim-army-cy
    (if (= cu-cnt 0)
        nat-y
        (safe-coord (fl/ cu-sum-y (exact->inexact cu-cnt)) nat-y)))
  (define ground-army-cx
    (if (= gcu-cnt 0)
        nat-x
        (safe-coord (fl/ gcu-sum-x (exact->inexact gcu-cnt)) nat-x)))
  (define ground-army-cy
    (if (= gcu-cnt 0)
        nat-y
        (safe-coord (fl/ gcu-sum-y (exact->inexact gcu-cnt)) nat-y)))
  (define first-stealth-threat-near-army
    (and (pair? live-overseers)
         (or (for/or ([e (in-list enemy-units)]) (l34-stealth-unit-or-bldg? e))
             (for/or ([e (in-list enemy-bldgs)]) (l34-stealth-unit-or-bldg? e)))
         (let ()
           (define cu-xs
             (for/list ([cu (in-list combat-units)]) (exact->inexact (hash-ref cu 'x base-x))))
           (define cu-ys
             (for/list ([cu (in-list combat-units)]) (exact->inexact (hash-ref cu 'y base-y))))
           (define (near-3-combat? e)
             (and (l34-stealth-unit-or-bldg? e)
                  (let ([ex0 (exact->inexact (hash-ref e 'x 9999.0))]
                        [ey0 (exact->inexact (hash-ref e 'y 9999.0))])
                    (let loop ([xs cu-xs] [ys cu-ys] [hits 0])
                      (cond
                        [(>= hits 3) #t]
                        [(null? xs) #f]
                        [else
                         (define dx (fl- ex0 (car xs)))
                         (define dy (fl- ey0 (car ys)))
                         (loop (cdr xs) (cdr ys)
                               (if (fl<= (fl+ (fl* dx dx) (fl* dy dy)) 196.0)
                                   (add1 hits)
                                   hits))])))))
           (or (for/first ([e (in-list enemy-units)] #:when (near-3-combat? e)) e)
               (for/first ([e (in-list enemy-bldgs)] #:when (near-3-combat? e)) e)))))
  (define reveal-assigned-ov-id
    (and first-stealth-threat-near-army
         (let ([ftx (exact->inexact (hash-ref first-stealth-threat-near-army 'x prelim-army-cx))]
               [fty (exact->inexact (hash-ref first-stealth-threat-near-army 'y prelim-army-cy))]
               [best-ov #f]
               [best-d2 +inf.0])
           (for ([ov (in-list live-overseers)])
             (define dx (fl- ftx (exact->inexact (hash-ref ov 'x base-x))))
             (define dy (fl- fty (exact->inexact (hash-ref ov 'y base-y))))
             (define d2 (fl+ (fl* dx dx) (fl* dy dy)))
             (when (fl< d2 best-d2)
               (set! best-ov ov)
               (set! best-d2 d2)))
           (and best-ov (hash-ref best-ov 'id #f)))))
  (define stealth-threats-near-army
    (if first-stealth-threat-near-army (list first-stealth-threat-near-army) '()))
  (for ([ov (in-list live-overseers)])
    (define ov-id (hash-ref ov 'id 0))
    (define ovx (hash-ref ov 'x base-x))
    (define ovy (hash-ref ov 'y base-y))
    (acquire-unit-lease! leases ov-id 'detector-escort frame 24
                         #:x prelim-army-cx #:y prelim-army-cy)
    (define fovx (if (flonum? ovx) ovx (exact->inexact ovx)))
    (define fovy (if (flonum? ovy) ovy (exact->inexact ovy)))
    (define allies-near-ov
      (let loop ([rem combat-units] [cnt 0])
        (cond
          [(or (>= cnt 3) (null? rem)) cnt]
          [else
           (define cu (car rem))
           (define cux (hash-ref cu 'x base-x))
           (define cuy (hash-ref cu 'y base-y))
           (define dx (fl- fovx (if (flonum? cux) cux (exact->inexact cux))))
           (define dy (fl- fovy (if (flonum? cuy) cuy (exact->inexact cuy))))
           (loop (cdr rem) (if (fl<= (fl+ (fl* dx dx) (fl* dy dy)) 144.0) (add1 cnt) cnt))])))
    (define (aa-danger-radius et)
      (define cs (fast-canonical-unit-sym et))
      (cond
        [(memq cs '(missile-turret thor thor-ap viking-fighter tempest carrier battlecruiser phoenix)) 9.5]
        [(memq cs '(widow-mine widow-mine-burrowed)) 6.8]
        [else 7.5]))
    (define (aa-threat-unit? e)
      (define et (unit-type-sym e))
      (or (fast-can-attack-air? et)
          (memq (fast-canonical-unit-sym et) '(widow-mine widow-mine-burrowed bunker))))
    (define (nearest-aa-at px py max-r)
      (define fpx (exact->inexact px))
      (define fpy (exact->inexact py))
      (define best-e #f)
      (define best-d max-r)
      (define (scan lst)
        (for ([e (in-list lst)] #:when (and (hash? e) (aa-threat-unit? e)))
          (define rx (hash-ref e 'x 9999.0))
          (define ry (hash-ref e 'y 9999.0))
          (when (and (real? rx) (real? ry))
            (define dx (fl- fpx (exact->inexact rx)))
            (define dy (fl- fpy (exact->inexact ry)))
            (define d (flsqrt (fl+ (fl* dx dx) (fl* dy dy))))
            (when (fl< d best-d)
              (set! best-d d)
              (set! best-e e)))))
      (scan enemy-units)
      (scan enemy-bldgs)
      (values best-e best-d))
    (define-values (near-aa-ov near-aa-ov-d) (nearest-aa-at fovx fovy 11.5))
    (define ov-in-aa-fire?
      (and near-aa-ov
           (fl<= near-aa-ov-d (aa-danger-radius (unit-type-sym near-aa-ov)))))
    (define ov-hp-rat
      (let* ([ohp (exact->inexact (hash-ref ov 'hp 200.0))]
             [omhp (exact->inexact (max 1.0 (hash-ref ov 'max-hp (hash-ref ov 'health-max 200.0))))])
        (fl/ ohp omhp)))
    (define is-reveal-ov?
      (and reveal-assigned-ov-id (equal? ov-id reveal-assigned-ov-id)))
    (cond
      ;; L40-P0-1f (`#16` 11/11 Overseer AA suicide fix): Pull ANY Overseer immediately out of
      ;; enemy AA fire (Marine/Thor/Viking/Turret/Mine) REGARDLESS of `allies-near-ov`, unless it
      ;; is a healthy assigned detector standing outside `> 6.2t` of AA!
      [(and ov-in-aa-fire?
            (or (not is-reveal-ov?)
                (fl< ov-hp-rat 0.72)
                (fl<= near-aa-ov-d 6.2)))
       (define aax (exact->inexact (hash-ref near-aa-ov 'x prelim-army-cx)))
       (define aay (exact->inexact (hash-ref near-aa-ov 'y prelim-army-cy)))
       (define d-aa (flmax 0.5 (fast-dist2d fovx fovy aax aay)))
       (define d-hm (flmax 1.0 (fast-dist2d fovx fovy (exact->inexact base-x) (exact->inexact base-y))))
       (define vx (fl+ (fl* 0.65 (fl/ (fl- fovx aax) d-aa))
                       (fl* 0.35 (fl/ (fl- (exact->inexact base-x) fovx) d-hm))))
       (define vy (fl+ (fl* 0.65 (fl/ (fl- fovy aay) d-aa))
                       (fl* 0.35 (fl/ (fl- (exact->inexact base-y) fovy) d-hm))))
       (define vn (flmax 0.1 (flsqrt (fl+ (fl* vx vx) (fl* vy vy)))))
       (define rx (safe-coord (fl+ fovx (fl* 4.5 (fl/ vx vn))) base-x))
       (define ry (safe-coord (fl+ fovy (fl* 4.5 (fl/ vy vn))) base-y))
       (when (refractory-allow-action?! (live-bot-runtime-cooldown-tracker rt)
                                        (list 'ov-retreat ov-id)
                                        frame
                                        10)
         (l34-emit! ctx (list 'move ov-id rx ry)))]
      [is-reveal-ov?
       (define thr (car stealth-threats-near-army))
       (define tx0 (exact->inexact (hash-ref thr 'x prelim-army-cx)))
       (define ty0 (exact->inexact (hash-ref thr 'y prelim-army-cy)))
       (define d-back (flmax 1.0 (fast-dist2d tx0 ty0 (exact->inexact prelim-army-cx) (exact->inexact prelim-army-cy))))
       ;; Stand at 9.8t (inside 11.0t Overseer detection radius) instead of 8.5t, nudged off nearby AA!
       (define stand-x0 (fl+ tx0 (fl* 9.8 (fl/ (fl- (exact->inexact prelim-army-cx) tx0) d-back))))
       (define stand-y0 (fl+ ty0 (fl* 9.8 (fl/ (fl- (exact->inexact prelim-army-cy) ty0) d-back))))
       (define-values (st-aa st-aa-d) (nearest-aa-at stand-x0 stand-y0 7.0))
       (define-values (stand-x stand-y)
         (if st-aa
             (let* ([aax (exact->inexact (hash-ref st-aa 'x tx0))]
                    [aay (exact->inexact (hash-ref st-aa 'y ty0))]
                    [dn (flmax 0.5 (fast-dist2d stand-x0 stand-y0 aax aay))]
                    [nx (fl+ stand-x0 (fl* 2.0 (fl/ (fl- stand-x0 aax) dn)))]
                    [ny (fl+ stand-y0 (fl* 2.0 (fl/ (fl- stand-y0 aay) dn)))]
                    [dt (fast-dist2d nx ny tx0 ty0)])
               (if (fl> dt 10.5)
                   (values (safe-coord (fl+ tx0 (fl* 10.5 (fl/ (fl- nx tx0) dt))) prelim-army-cx)
                           (safe-coord (fl+ ty0 (fl* 10.5 (fl/ (fl- ny ty0) dt))) prelim-army-cy))
                   (values (safe-coord nx prelim-army-cx) (safe-coord ny prelim-army-cy))))
             (values (safe-coord stand-x0 prelim-army-cx) (safe-coord stand-y0 prelim-army-cy))))
       (when (and (> (dist2d ovx ovy stand-x stand-y) 2.0)
                  (refractory-allow-action?! (live-bot-runtime-cooldown-tracker rt)
                                             (list 'ov-reveal ov-id)
                                             frame
                                             16))
         (l34-emit! ctx (list 'move ov-id stand-x stand-y)))]
      [(and (< allies-near-ov 3) near-aa-ov)
       (define d-home (max 1.0 (dist2d ovx ovy base-x base-y)))
       (define rx (safe-coord (+ ovx (* 6.0 (/ (- base-x ovx) d-home))) base-x))
       (define ry (safe-coord (+ ovy (* 6.0 (/ (- base-y ovy) d-home))) base-y))
       (when (refractory-allow-action?! (live-bot-runtime-cooldown-tracker rt)
                                        (list 'ov-retreat ov-id)
                                        frame
                                        16)
         (l34-emit! ctx (list 'move ov-id rx ry)))]
      [(not (null? combat-units))
       ;; Hover 4.5t behind army centroid toward home (7.0t when enemy AA is within 9.5t of army)!
       (define-values (army-aa _army-aa-d) (nearest-aa-at prelim-army-cx prelim-army-cy 9.5))
       (define rear-off (if army-aa 7.0 4.5))
       (define d-home (max 1.0 (dist2d prelim-army-cx prelim-army-cy base-x base-y)))
       (define leash-x (safe-coord (+ prelim-army-cx (* rear-off (/ (- base-x prelim-army-cx) d-home))) prelim-army-cx))
       (define leash-y (safe-coord (+ prelim-army-cy (* rear-off (/ (- base-y prelim-army-cy) d-home))) prelim-army-cy))
       (when (and (> (dist2d ovx ovy leash-x leash-y) 2.2)
                  (refractory-allow-action?! (live-bot-runtime-cooldown-tracker rt)
                                             (list 'ov-escort ov-id)
                                             frame
                                             16))
         (l34-emit! ctx (list 'move ov-id leash-x leash-y)))]))

  (set-l34-ctx-combat-units! ctx combat-units)
  (set-l34-ctx-ft! ctx ft)
  (set-l34-ctx-ground-army-cx! ctx ground-army-cx)
  (set-l34-ctx-ground-army-cy! ctx ground-army-cy)
  (set-l34-ctx-prelim-army-cx! ctx prelim-army-cx)
  (set-l34-ctx-prelim-army-cy! ctx prelim-army-cy)
  (set-l34-ctx-reserve-count! ctx reserve-count)
  (set-l34-ctx-stasis-frozen-tags! ctx stasis-frozen-tags)
  (set-l34-ctx-tbrain! ctx tbrain)
  (set-l34-ctx-vanguard-count! ctx vanguard-count)
)

(define (l34-combat-eval-sig<? e1 e2)
  (define k1 (car e1))
  (define k2 (car e2))
  (define t1 (first k1))
  (define t2 (first k2))
  (cond
    [(symbol<? t1 t2) #t]
    [(not (eq? t1 t2)) #f]
    [else
     (define h1 (or (second k1) -1))
     (define h2 (or (second k2) -1))
     (cond
       [(< h1 h2) #t]
       [(> h1 h2) #f]
       [else
        (define s1 (or (third k1) -1))
        (define s2 (or (third k2) -1))
        (cond
          [(< s1 s2) #t]
          [(> s1 s2) #f]
          [else (< (fourth k1) (fourth k2))])])]))

(define (l34-summarize-for-combat-eval units)
  (if (null? units)
      '()
      (let ([ht (make-hash)])
        (for ([u (in-list units)])
          (define ut (unit-type-sym u))
          ;; W7-P0-1-rt: Prefer raw `'hull-hp` over live combined `'hp` (= health + shield)
          ;; so Protoss shields are never double-counted in combat prediction!
          (define hp-raw (or (hash-ref u 'hull-hp #f) (hash-ref u 'hp #f)))
          (define hp-r
            (and (real? hp-raw) (= (- hp-raw hp-raw) 0)
                 (inexact->exact (round hp-raw))))
          (define sh-raw (or (hash-ref u 'shields #f) (hash-ref u 'shield #f)))
          (define sh-r
            (and (real? sh-raw) (= (- sh-raw sh-raw) 0)
                 (inexact->exact (round sh-raw))))
          (define fly?
            (or (eq? (hash-ref u 'flying? #f) #t)
                (eq? (hash-ref u 'is_flying #f) #t)
                (eq? (hash-ref u 'is-flying #f) #t)
                (fast-unit-is-flying-sym? ut)))
          (define buffs (hash-ref u 'buffs #f))
          (define bar?
            (or (eq? (hash-ref u 'barrier-active? #f) #t)
                (eq? (hash-ref u 'barrier? #f) #t)
                (and (list? buffs) (memq 'immortal-overload buffs) #t)))
          (define aam?
            (or (eq? (hash-ref u 'aam-debuff? #f) #t)
                (and (list? buffs) (memq 'anti-armor-missile buffs) #t)))
          (define gs?
            (or (eq? (hash-ref u 'guardian-shield? #f) #t)
                (and (list? buffs) (memq 'guardian-shield buffs) #t)))
          (define mask
            (bitwise-ior (if fly? 1 0)
                         (if bar? 2 0)
                         (if aam? 4 0)
                         (if gs? 8 0)))
          (define k (list ut hp-r sh-r mask))
          (hash-set! ht k (add1 (hash-ref ht k 0))))
        (sort (hash->list ht) l34-combat-eval-sig<?))))

(define (l34-sig->combat-hashes sig)
  (for/list ([entry (in-list sig)])
    (define k (car entry))
    (define cnt (cdr entry))
    (define ut (first k))
    (define hp-r (second k))
    (define sh-r (third k))
    (define mask (fourth k))
    (define fly? (bitwise-bit-set? mask 0))
    (define bar? (bitwise-bit-set? mask 1))
    (define aam? (bitwise-bit-set? mask 2))
    (define gs? (bitwise-bit-set? mask 3))
    (cond
      [(and hp-r sh-r)
       (hash 'type ut 'count cnt 'hp hp-r 'shields sh-r
             'flying? fly? 'barrier-active? bar? 'aam-debuff? aam? 'guardian-shield? gs?)]
      [hp-r
       (hash 'type ut 'count cnt 'hp hp-r
             'flying? fly? 'barrier-active? bar? 'aam-debuff? aam? 'guardian-shield? gs?)]
      [sh-r
       (hash 'type ut 'count cnt 'shields sh-r
             'flying? fly? 'barrier-active? bar? 'aam-debuff? aam? 'guardian-shield? gs?)]
      [else
       (hash 'type ut 'count cnt
             'flying? fly? 'barrier-active? bar? 'aam-debuff? aam? 'guardian-shield? gs?)])))

(define (l34-eval-combat-prediction! ctx)
  (define rt (l34-ctx-rt ctx))
  (define obs (l34-ctx-obs ctx))
  (define frame (l34-ctx-frame ctx))
  (define ally-bldgs (l34-ctx-ally-bldgs ctx))
  (define combat-units (l34-ctx-combat-units ctx))
  (define enemy-units (l34-ctx-enemy-units ctx))
  (define enemy-bldgs (l34-ctx-enemy-bldgs ctx))
  (define researched-upgs (l34-ctx-researched-upgs ctx))
  (define enemy-def-bldgs
    (for/list ([eb (in-list enemy-bldgs)]
               #:when (and (memq (unit-type-sym eb)
                                 '(photon-cannon spine-crawler spore-crawler bunker planetary-fortress missile-turret))
                           (>= (hash-ref eb 'build-progress 1.0) SC2-BUILD-COMPLETE-PROGRESS)))
      eb))
  (define th-coords
    (for/list ([b (in-list ally-bldgs)]
               #:when (bitwise-bit-set? (fast-ally-bldg-flags (unit-type-sym b)) 2))
      (cons (exact->inexact (safe-finite-real (hash-ref b 'x 0.0) 0.0))
            (exact->inexact (safe-finite-real (hash-ref b 'y 0.0) 0.0)))))
  (define home-anchor-ths
    (cond
      [(pair? th-coords) th-coords]
      [(pair? ally-bldgs)
       (list (cons (exact->inexact (safe-finite-real (l34-ctx-base-x ctx) 32.5))
                   (exact->inexact (safe-finite-real (l34-ctx-base-y ctx) 32.5))))]
      [else '()]))
  ;; W2-P0-1(a) / L30-P0-3 (`#14/#23` `OBRet -> 0`): Home-territory defense covering main, natural,
