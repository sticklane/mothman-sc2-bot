            (filter (lambda (h)
                      (define hx (hash-ref h 'x 9999.0))
                      (define hy (hash-ref h 'y 9999.0))
                      (define h-flying? (harasser-is-flying? h))
                      (< (count (lambda (d)
                                  (and (harass-defender-matches? d h-flying?)
