  (define enemy-bldgs (l2-ctx-enemy-bldgs ctx))
  (define enemy-units (l2-ctx-enemy-units ctx))
  (define frame (l2-ctx-frame ctx))
  (define hard-supply-lockout-reserve-min (l2-ctx-hard-supply-lockout-reserve-min ctx))
  (define hatcheries (l2-ctx-hatcheries ctx))
  (define live-army-supply (l2-ctx-live-army-supply ctx))
  (define live-enemy-threat-supply (l2-ctx-live-enemy-threat-supply ctx))
  (define live-game? (l2-ctx-live-obs-harvesters? ctx))
  (define macro-plan (l2-ctx-macro-plan ctx))
  (define nat-x (l2-ctx-nat-x ctx))
  (define nat-y (l2-ctx-nat-y ctx))
  (define oledger (l2-ctx-oledger ctx))
  (define open-prod-slots (l2-ctx-open-prod-slots ctx))
  (define prio-saving-for-sym (l2-ctx-prio-saving-for-sym ctx))
  (define ready-bldg-types (l2-ctx-ready-bldg-types ctx))
  (define ready-hatch-count (l2-ctx-ready-hatch-count ctx))
  (define supply-used (l2-ctx-supply-used ctx))
  (define tech-obs (l2-ctx-tech-obs ctx))
  (define total-workers (l2-ctx-total-workers ctx))
  (define under-base-attack? (l2-ctx-under-base-attack? ctx))
  (define under-early-cheese? (l2-ctx-under-early-cheese? ctx))
  (define forward-proxy-detected? (l2-ctx-forward-proxy-detected? ctx))
  (define in-base-proxy-detected? (l2-ctx-in-base-proxy-detected? ctx))
  (define orphaned-prereqs (l2-ctx-orphaned-prereqs ctx))
  (define worker-rush-active? (l2-ctx-worker-rush-active? ctx))
  (define zerg-fog-army-floor-ok? (l2-ctx-zerg-fog-army-floor-ok? ctx))
  (define zerg-early-pool-rush?
    (and live-game?
         (< frame 2600)
         (or (ormap (lambda (e)
                      (memq (unit-type-sym e) '(zergling reaper zealot marine marauder adept)))
                    enemy-units)
             (ormap (lambda (eb)
                      (and (eq? (fast-canonical-structure-sym (unit-type-sym eb)) 'spawning-pool)
                           (or (< frame 1500)
                               (>= (hash-ref eb 'build-progress 0.0) 0.75))))
                    enemy-bldgs))))
  (define zerg-early-rush-or-proxy?
    (or worker-rush-active?
        in-base-proxy-detected?
        forward-proxy-detected?
        under-early-cheese?
        early-survival-crisis?
        zerg-early-pool-rush?))
  ;; L22-P0-3 (`#28` ZvP Spire 7x drop) + L37-P0-2 (`#25/#73` ZvT Banshee mobile AA):
  ;; Detect confirmed Banshees (even 1 visible or OWM-remembered) & `>= 2` StarportTechLabs
  ;; alongside heavy/multi-unit air threats so Zerg rushes `Lair -> HydraDen/Spire` + Queens!
  (define zerg-owm-sum-p1
    (let ([rt1 (l2-ctx-rt ctx)])
      (and rt1 (opponent-world-model-last-summary (rt-opponent-world-model rt1)))))
  (define zerg-owm-kc-p1 (and zerg-owm-sum-p1 (opponent-world-summary-known-unit-counts zerg-owm-sum-p1)))
  (define zerg-owm-bc-p1 (and zerg-owm-sum-p1 (opponent-world-summary-known-bldg-counts zerg-owm-sum-p1)))
  (define-values (zerg-real-anti-air-threat? zerg-banshee-air-threat? zerg-heavy-cap-air-threat?)
       (let ([real-air-units 0]
             [heavy-air-units 0]
             [banshee-units 0]
             [transport-air-units 0])
         (for ([e (in-list enemy-units)])
           (define et (fast-canonical-unit-sym (unit-type-sym e)))
           (case et
             [(mutalisk void-ray voidray carrier tempest battlecruiser brood-lord broodlord colossus)
              (set! real-air-units (add1 real-air-units))
              (set! heavy-air-units (add1 heavy-air-units))]
             [(banshee)
              (set! banshee-units (add1 banshee-units))
              (set! real-air-units (add1 real-air-units))]
             [(oracle phoenix liberator liberator-ag viking viking-fighter)
              (set! real-air-units (add1 real-air-units))]
             [(medivac warp-prism warp-prism-phasing)
              (set! transport-air-units (add1 transport-air-units))]))
         (define owm-banshees (if (hash? zerg-owm-kc-p1) (hash-ref zerg-owm-kc-p1 'banshee 0) 0))
         (define owm-heavy-air
           (if (hash? zerg-owm-kc-p1)
               (+ (hash-ref zerg-owm-kc-p1 'battlecruiser 0)
                  (hash-ref zerg-owm-kc-p1 'carrier 0)
                  (hash-ref zerg-owm-kc-p1 'tempest 0)
                  (hash-ref zerg-owm-kc-p1 'void-ray 0)
                  (hash-ref zerg-owm-kc-p1 'voidray 0)
                  (hash-ref zerg-owm-kc-p1 'brood-lord 0)
                  (hash-ref zerg-owm-kc-p1 'broodlord 0)
                  (hash-ref zerg-owm-kc-p1 'mutalisk 0))
               0))
         (define vis-sptl-cnt
           (for/sum ([eb (in-list enemy-bldgs)])
             (if (memq (fast-canonical-structure-sym (unit-type-sym eb)) '(starport-techlab starport-tech-lab)) 1 0)))
         (define owm-sptl-cnt
           (if (hash? zerg-owm-bc-p1)
               (+ (hash-ref zerg-owm-bc-p1 'starport-techlab 0)
                  (hash-ref zerg-owm-bc-p1 'starport-tech-lab 0))
               0))
         (define air-tech-bldgs
           (for/sum ([eb (in-list enemy-bldgs)])
             (if (memq (fast-canonical-structure-sym (unit-type-sym eb))
                       '(stargate fleet-beacon spire greater-spire
                         starport-techlab starport-tech-lab fusion-core))
                 1
                 0)))
         (define banshee-threat?
           (and live-game?
                (or (> banshee-units 0)
                    (> owm-banshees 0)
                    (>= (max vis-sptl-cnt owm-sptl-cnt) 2))))
         (define heavy-cap-threat?
           (and live-game?
                (or (> heavy-air-units 0) (> owm-heavy-air 0))))
         (define medivac-or-prism-only?
           (and (> transport-air-units 0)
                (= real-air-units 0)
                (= air-tech-bldgs 0)
                (not banshee-threat?)
                (not heavy-cap-threat?)))
         (define real-aa?
           (cond
             [(not live-game?)
              (enemy-tech-observation-requires-anti-air? tech-obs)]
             [medivac-or-prism-only? #f]
             [(or heavy-cap-threat? banshee-threat? (>= real-air-units 2) (> air-tech-bldgs 0)) #t]
             [(and (null? enemy-units) (null? enemy-bldgs)
                   (not (eq? effective-enemy-race 'Terran)))
              (enemy-tech-observation-requires-anti-air? tech-obs)]
             [else #f]))
         (values real-aa? banshee-threat? heavy-cap-threat?)))
  (set-l2-ctx-zerg-real-anti-air-threat?! ctx zerg-real-anti-air-threat?)
  (set-l2-ctx-zerg-heavy-cap-air-threat?! ctx zerg-heavy-cap-air-threat?)
  (define brain-wants-spire-now?
    (or (eq? prio-saving-for-sym 'spire)
        (and (macro-brain-decision? (l2-ctx-macro-decision ctx))
             (not (not (memq 'spire (macro-brain-decision-scheduled-ids (l2-ctx-macro-decision ctx))))))))
  (define brain-wants-hydra-den-now?
    (or (eq? prio-saving-for-sym 'hydralisk-den)
        (and (macro-brain-decision? (l2-ctx-macro-decision ctx))
             (not (not (memq 'hydralisk-den (macro-brain-decision-scheduled-ids (l2-ctx-macro-decision ctx))))))))
  ;; L27-P0-3 (`#28`) + L37-P0-2 (`#25/#73` Banshee): Activate `zerg-holding-for-aa-spire?`
  ;; starting at `gas >= 40` unless Brain explicitly scheduled `hydralisk-den` or Banshee threat
  ;; is unlocking faster `hydralisk-den` (`100M/100G`) first (with no heavy Capital Air!).
  (define zerg-prefer-hydra-den-for-banshee?
    (and live-game?
         (not zerg-heavy-cap-air-threat?)
         (not (l2-building-present-or-pending? ctx 'hydralisk-den))
         (not (l2-building-present-or-pending? ctx 'spire))
         (or brain-wants-hydra-den-now?
             (and zerg-banshee-air-threat?
                  (not brain-wants-spire-now?)
                  (< (l2-ctx-gas ctx) (sc2-gas-cost 'spire))))))
  (define zerg-cap-air-scouted-no-defer?
    (zerg-cap-air-tech-or-unit-scouted? enemy-units enemy-bldgs zerg-owm-kc-p1 zerg-owm-bc-p1 tech-obs))
  (set-l2-ctx-zerg-cap-air-scouted-no-defer?! ctx zerg-cap-air-scouted-no-defer?)
  (define zerg-defer-spire-over-hydraden?
    (and live-game?
         (l2-building-present-or-pending? ctx 'hydralisk-den)
         (or (< (length hatcheries) 3) (< live-army-supply 24))
         (not zerg-heavy-cap-air-threat?)
         (not zerg-cap-air-scouted-no-defer?)))
  (define zerg-holding-for-aa-spire?
       (and live-game?
            (or (memq 'lair ready-bldg-types) (memq 'hive ready-bldg-types))
            (not (l2-building-present-or-pending? ctx 'spire))
            (not (l2-building-present-or-pending? ctx 'greater-spire))
            (not zerg-prefer-hydra-den-for-banshee?)
            (not zerg-defer-spire-over-hydraden?)
            (not (and zerg-banshee-air-threat?
                      (not zerg-heavy-cap-air-threat?)
                      (not zerg-cap-air-scouted-no-defer?)
                      (memq 'hydralisk-den ready-bldg-types)
                      (< (l2-unit-count ctx 'hydralisk) 8)))
            (>= (l2-ctx-gas ctx) 40)
            (or brain-wants-spire-now?
                zerg-real-anti-air-threat?
                zerg-cap-air-scouted-no-defer?
                (and (not crisis-tech-upgrade-deferral?)
                     (>= (length hatcheries) 3)
                     (enemy-tech-observation-requires-anti-air? tech-obs)))))
  (set-l2-ctx-zerg-holding-for-aa-spire?! ctx zerg-holding-for-aa-spire?)
  ;; L23-P0-3 (`#28 ZvP` Corruptor > Hydra vs Capital Air): Hold gas from >= 50G whenever
  ;; Spire is ready and Brain scheduled/saved for Corruptor (up to 16) or live air threat (up to 12)
  ;; so 50G Hydralisks never drain gas below 100G before Corruptors can spawn!
  (define brain-wants-corruptor-now?
    (or (eq? prio-saving-for-sym 'corruptor)
        (and (macro-brain-decision? (l2-ctx-macro-decision ctx))
             (not (not (memq 'corruptor (macro-brain-decision-scheduled-ids (l2-ctx-macro-decision ctx))))))))
  (define zerg-corr-hold-cap
    (cond
      [zerg-heavy-cap-air-threat? 12]
      [(or (memq 'greater-spire ready-bldg-types)
           (l2-building-present-or-pending? ctx 'greater-spire))
       6]
      [else 4]))
  (define zerg-holding-for-aa-corruptor?
       (and live-game?
            (or (memq 'spire ready-bldg-types) (memq 'greater-spire ready-bldg-types))
            (or (and brain-wants-corruptor-now?
                     (< (l2-unit-count ctx 'corruptor) (if zerg-heavy-cap-air-threat? 16 zerg-corr-hold-cap)))
                (and zerg-real-anti-air-threat?
                     (< (l2-unit-count ctx 'corruptor) zerg-corr-hold-cap)))
            (>= (l2-ctx-gas ctx) 50)))
  (set-l2-ctx-zerg-holding-for-aa-corruptor?! ctx zerg-holding-for-aa-corruptor?)
  (when (and (or (memq 'lair ready-bldg-types) (memq 'hive ready-bldg-types))
             (not zerg-defer-spire-over-hydraden?)
             (or brain-wants-spire-now?
                 zerg-holding-for-aa-spire?
                 zerg-cap-air-scouted-no-defer?
                 (and zerg-real-anti-air-threat? (not zerg-prefer-hydra-den-for-banshee?)))
             (not (l2-building-present-or-pending? ctx 'spire))
             (not (l2-building-present-or-pending? ctx 'greater-spire))
             (l2-save-cancel-rebuild-ready? ctx 'spire 60)
             (>= (l2-ctx-minerals ctx) (sc2-min-cost 'spire))
             (>= (l2-ctx-gas ctx) (sc2-gas-cost 'spire)))
    (define-values (sp-def-x sp-def-y) (l2-interior-offset ctx 5.5 2.0))
    (define-values (sp-ax sp-ay)
      (l2-zerg-creep-ring-anchor ctx sp-def-x sp-def-y))
    (l2-emit-build-verified! ctx 'spire sp-ax sp-ay)
    (when (l2-building-present-or-pending? ctx 'spire)
      (set! zerg-holding-for-aa-spire? #f)
      (set-l2-ctx-zerg-holding-for-aa-spire?! ctx #f)))
  ;; L37-P0-2 (`#25/#73` ZvT Banshee): Dispatch urgent `hydralisk-den` (`100M/100G`) right here in
  ;; Phase 1 (BEFORE Extractor / EvolutionChamber / RoachWarren / BanelingNest!) whenever Lair is
  ;; ready and Brain scheduled `hydralisk-den` or Banshee air threat needs fast mobile AA
  ;; (yielding if Spire is already ready and `< 2` Corruptors exist so Corruptors spawn first!).
  (when (and live-game?
             (or (memq 'lair ready-bldg-types) (memq 'hive ready-bldg-types))
             (or brain-wants-hydra-den-now? zerg-prefer-hydra-den-for-banshee?)
             (not (and (memq 'spire ready-bldg-types) (< (l2-unit-count ctx 'corruptor) 2)))
             (not (l2-building-present-or-pending? ctx 'hydralisk-den))
             (l2-save-cancel-rebuild-ready? ctx 'hydralisk-den 60)
             (>= (l2-ctx-minerals ctx) (sc2-min-cost 'hydralisk-den))
             (>= (l2-ctx-gas ctx) (sc2-gas-cost 'hydralisk-den)))
    (define-values (hd1-def-x hd1-def-y) (l2-interior-offset ctx 5.0 3.0))
    (define-values (hd1-ax hd1-ay)
      (l2-safe-zerg-build-anchor ctx hd1-def-x hd1-def-y))
    (l2-emit-build-verified! ctx 'hydralisk-den hd1-ax hd1-ay))
  (define zerg-spire-res-min
       (cond
         [zerg-holding-for-aa-spire? (sc2-min-cost 'spire)]
         [zerg-holding-for-aa-corruptor? (sc2-min-cost 'corruptor)]
         [else 0]))
  (set-l2-ctx-zerg-spire-res-min! ctx zerg-spire-res-min)
  (define zerg-spire-res-gas
       (cond
         [zerg-holding-for-aa-spire? (sc2-gas-cost 'spire)]
         [zerg-holding-for-aa-corruptor? (sc2-gas-cost 'corruptor)]
         [else 0]))
  (set-l2-ctx-zerg-spire-res-gas! ctx zerg-spire-res-gas)
  (when zerg-holding-for-aa-spire?
    (set-l2-ctx-bo-reserved-min! ctx (max (l2-ctx-bo-reserved-min ctx) zerg-spire-res-min))
    (set-l2-ctx-bo-reserved-gas! ctx (max (l2-ctx-bo-reserved-gas ctx) zerg-spire-res-gas)))
  ;; L22-P0-3 (`#34 ZvZ`): Honor Brain-scheduled `spawning-pool` and ZvZ Pool-first (`< 1:30`)
  ;; BEFORE Hatchery #2 can preempt the 200M bank!
  (define brain-sched-pool-now?
    (or (eq? prio-saving-for-sym 'spawning-pool)
        (and (macro-brain-decision? (l2-ctx-macro-decision ctx))
             (not (not (memq 'spawning-pool (macro-brain-decision-scheduled-ids (l2-ctx-macro-decision ctx))))))))
  (define zerg-pool-before-nat-hatch?
    (and live-game?
         (= (length hatcheries) 1)
         (not (l2-building-present-or-pending? ctx 'spawning-pool))
         (or brain-sched-pool-now?
             (and (eq? effective-enemy-race 'Zerg)
                  (< frame 2016)))))
  ;; L23-P0-3 (`#34 ZvZ` 12-Pool Wave-2 Hold): Mirror Brain's ZvZ early-rush hold in L2 —
  ;; under active <4:00 ZvZ early Ling pressure, do NOT spend 300M on Hatchery #2 until
  ;; >= 10 Zerglings AND (1 Queen or 1 Spine Crawler) are out to beat both wave 1 and wave 2!
  (define zvz-early-ling-rush-active?
    (and live-game?
         (eq? effective-enemy-race 'Zerg)
         (< frame 5376)
         (or early-survival-crisis?
             under-base-attack?
             (l2-enemy-early-pool-detected? ctx)
             (>= (count (lambda (e)
                          (and (hash? e)
                               (eq? (fast-canonical-unit-sym (unit-type-sym e)) 'zergling)))
                        enemy-units)
                 4))))
  (define zvz-early-ling-rush-hold-hatch2?
    (and zvz-early-ling-rush-active?
         (< (length hatcheries) 2)
         (or (< (l2-unit-count ctx 'zergling) 10)
             (and (= (l2-unit-count ctx 'queen) 0)
                  (= (l2-building-present-or-pending-count ctx 'spine-crawler) 0)))))
  ;; W9-P0-4-rt: Never expand or drop macro Hatcheries under real base attack (only allow
  ;; 4th-Hatch mineral overflow during trivial pokes where threat <= 4 & army >= 20 & no
  ;; building damage, preserving [UNCOVERED-Z4]), require saturated workers/army before 4th/5th
  ;; overflow Hatches, and backoff rebuilds of destroyed 4th+ Hatches (`#16` fix!).
  (define zerg-only-light-skirmish?
       (and (<= live-enemy-threat-supply 4)
            (>= live-army-supply 20)
            (not bldg-actively-damaged?)))
  (define zerg-4th-hatch-mineral-overflow?
       (and live-game?
            (>= (length hatcheries) 2)
            (< (length hatcheries) 5)
            (or (not under-base-attack?) zerg-only-light-skirmish?)
            (>= (l2-ctx-minerals ctx) (if (>= (length hatcheries) 3) 900 1000))
            (or (>= total-workers (if (>= (length hatcheries) 3) 48 28))
                (and (>= (length hatcheries) 3)
                     (>= total-workers 38)
                     (>= live-army-supply 20)))
            (not worker-rush-active?)
            (not early-survival-crisis?)
            (not bldg-actively-damaged?)
            (<= live-enemy-threat-supply (max 10 (+ live-army-supply 4)))))
  (define brain-sched-z-nat-hatch?
    (and live-game?
         (< (length hatcheries) 2)
         (not zvz-early-ling-rush-hold-hatch2?)
         (>= (l2-ctx-minerals ctx) (sc2-min-cost 'hatchery))
         (macro-brain-decision? (l2-ctx-macro-decision ctx))
         (let ([sids (macro-brain-decision-scheduled-ids (l2-ctx-macro-decision ctx))])
           (and (memq 'hatchery sids)
                (not (memq 'overlord sids))))
         (not (and (l2-ctx-severe-intel-blindness? ctx) (null? ally-combat-units)))
         (not worker-rush-active?)
         (not under-early-cheese?)
         (not early-survival-crisis?)
         (not bldg-actively-damaged?)
         (or (not under-base-attack?)
             (<= live-enemy-threat-supply live-army-supply))))
  (define zerg-exp-x #f)
  (define zerg-exp-y #f)
  (when (and (>= (l2-ctx-minerals ctx) (sc2-min-cost 'hatchery))
                (not zerg-pool-before-nat-hatch?)
                (not zvz-early-ling-rush-hold-hatch2?)
                (or (< (length hatcheries) 2)
