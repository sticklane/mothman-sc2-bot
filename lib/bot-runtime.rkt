                                  (member '(build gateway) prio-scheduled-actions))
                             3
                             2)
                         1)
                     (cond
                         [(>= (length nexuses) 3)
                          (max 8 (* SC2-PROTOSS-FACILITIES-PER-BASE (length nexuses)))]
                         [(= (length nexuses) 2)
                          (cond
                            [(or (>= gw-ref-minerals 650)
                                 (and brain-sched-gate-aligned?
                                      (or (>= gw-ref-minerals 450)
                                          (and (>= gw-ref-minerals 300)
