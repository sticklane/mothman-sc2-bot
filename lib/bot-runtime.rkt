          'dps (cons sanitized-nonneg-int? sanitize-opt-nonneg-12)
          'z (cons exact-integer? sanitize-opt-exact-10)
          'speed (cons sanitized-nonneg-inexact? sanitize-opt-nonneg-real-3)
