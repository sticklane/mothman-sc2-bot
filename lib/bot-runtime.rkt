                (let* ([px (hash-ref crisis-inmain-pyl 'x base-x)]
                       [py (hash-ref crisis-inmain-pyl 'y base-y)]
                       [offs '((2.5 . 0.5) (-2.5 . 0.5) (0.5 . 2.5) (0.5 . -2.5))]
                       [off (list-ref offs (modulo gw-idx (length offs)))])
                  (values (safe-coord (+ px (car off)) (+ base-x 3.5))
