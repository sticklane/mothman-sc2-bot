  (define zerg-holding-lair-min?
       (and live-game?
            (not crisis-tech-upgrade-deferral?)
            (not (l2-building-present-or-pending? ctx 'lair))
            (or (and (>= (l2-ctx-gas ctx) 80) zerg-wants-lair-now?)
                (and (>= (l2-ctx-gas ctx) (sc2-gas-cost 'lair))
