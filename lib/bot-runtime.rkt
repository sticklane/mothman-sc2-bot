  (when (and (memq 'spawning-pool ready-bldg-types)
                (l2-upgrade-needed? ctx 'metabolic-boost)
                (>= (- (l2-ctx-minerals ctx) zerg-spire-res-min) (sc2-min-cost 'metabolic-boost))
                (>= (- (l2-ctx-gas ctx) zerg-spire-res-gas) (sc2-gas-cost 'metabolic-boost))
                (l2-non-combat-min-ok? ctx (sc2-min-cost 'metabolic-boost) 'metabolic-boost)
                (l2-non-combat-gas-ok? ctx (sc2-gas-cost 'metabolic-boost) 'metabolic-boost))
       (l2-emit-research-verified! ctx 'metabolic-boost))
  (define zerg-hive-t3-tech-ready?
       (and live-game?
            (memq 'hive ready-bldg-types)
            (or (memq 'ultralisk-cavern ready-bldg-types)
                (memq 'greater-spire ready-bldg-types))))
  ;; W8-P0-2-rt / L20-P0-3 (`#16 ZvT` 11t dropped): Keep roach-warren & baneling-nest mutually
  ;; exclusive while (< (length hatcheries) 3) (unless attack/crisis), honor Brain-scheduled
