                        (l2-can-spend-by-priority? ctx 'thor 'combat-unit)))
           (l2-try-train-unit! ctx 'thor 'factory 6 #:respect-bo-reserve? (and (not enemy-capital-air?) terran-bo-escrow-imminent?)))
