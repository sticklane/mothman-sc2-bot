            (define ry (hash-ref e 'y 9999.0))
            (define ex (if (flonum? rx) rx (exact->inexact rx)))
            (define ey (if (flonum? ry) ry (exact->inexact ry)))
            (define bx-fl (if (flonum? base-x) base-x (exact->inexact base-x)))
