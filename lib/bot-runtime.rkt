                   #:when (let ([et (unit-type-sym e)])
                            (and (or (eq? et 'drone) (eq? et 'probe) (eq? et 'scv))
                                 (not (eq? (hash-ref e 'is-hallucination #f) #t))
                                 (let* ([rx (hash-ref e 'x 9999.0)]
                                        [ry (hash-ref e 'y 9999.0)]
                                        [ex (if (flonum? rx) rx (exact->inexact rx))]
                                        [ey (if (flonum? ry) ry (exact->inexact ry))])
                                   (for/or ([bc (in-list owned-base-fxys)])
                                     (define dx (fl- (car bc) ex))
                                     (define dy (fl- (cdr bc) ey))
                                     (fl<= (fl+ (fl* dx dx) (fl* dy dy)) 484.0))))))
          e)))
  (define drill-stack-min-count (if live-obs-harvesters? 6 4))
  (define stacked-enemy-workers
    (if (or (< (length enemy-workers-near-base) drill-stack-min-count)
            (and live-obs-harvesters?
                 worker-rush-active?
                 (<= ally-combat-supply-early 0)))
        '()
        (let* ([n (length enemy-workers-near-base)]
               [xs (make-flvector n)]
               [ys (make-flvector n)])
          (for ([o (in-list enemy-workers-near-base)] [i (in-naturals)])
            (flvector-set! xs i (exact->inexact (hash-ref o 'x base-x)))
            (flvector-set! ys i (exact->inexact (hash-ref o 'y base-y))))
          (define anchor-idx
            (for/first ([i (in-range n)]
                        #:when (let ([ex (flvector-ref xs i)]
                                     [ey (flvector-ref ys i)])
                                 (>= (for/sum ([j (in-range n)])
                                       (define dx (fl- ex (flvector-ref xs j)))
                                       (define dy (fl- ey (flvector-ref ys j)))
                                       (if (fl<= (fl+ (fl* dx dx) (fl* dy dy)) 0.2025) 1 0))
                                     drill-stack-min-count)))
              i))
          (if anchor-idx
              (let ([ax (flvector-ref xs anchor-idx)]
                    [ay (flvector-ref ys anchor-idx)])
                (for/list ([o (in-list enemy-workers-near-base)]
                           [ox (in-flvector xs)]
                           [oy (in-flvector ys)]
                           #:when (let ([dx (fl- ax ox)]
                                        [dy (fl- ay oy)])
                                    (fl<= (fl+ (fl* dx dx) (fl* dy dy)) 0.2025)))
                  o))
              '()))))
  (when (>= (length stacked-enemy-workers) drill-stack-min-count)
    (define ew0 (car stacked-enemy-workers))
    (define ewx (hash-ref ew0 'x base-x))
    (define ewy (hash-ref ew0 'y base-y))
    (define anchor-bc
      (argmin (lambda (bc) (dist2d (car bc) (cdr bc) ewx ewy))
              owned-base-coords))
    (define dx (- (car anchor-bc) ewx))
    (define dy (- (cdr anchor-bc) ewy))
    (define d (max 1.0 (sqrt (+ (* dx dx) (* dy dy)))))
    (define perp-x (safe-coord (+ ewx (* 4.0 (- (/ dy d)))) (car anchor-bc)))
    (define perp-y (safe-coord (+ ewy (* 4.0 (/ dx d))) (cdr anchor-bc)))
    (l2-emit! ctx (list 'counter-enemy-worker-drill (length stacked-enemy-workers) perp-x perp-y))
    ;; NEVER emit passive `(move wid perp-x perp-y)` during worker rush or in-base proxy defense!
    (when (and (not worker-rush-active?)
               (not in-base-proxy-detected?))
      (for ([w (in-list workers)]
            #:when (and (not (worker-has-engine-build-order? w))
                        (not (order-ledger-unit-has-active-build? oledger-early (hash-ref w 'id 0) w))
                        (<= (dist2d ewx ewy (hash-ref w 'x base-x) (hash-ref w 'y base-y)) 8.0)))
        (l2-emit! ctx (list 'move (hash-ref w 'id 10) perp-x perp-y)))))
  (define mmstate-pad (live-bot-runtime-mirror-mind rt))
  (define mmstate-rush-post
    (let ([ar (and mmstate-pad (mirror-mind-state-last-action-reading mmstate-pad))]
          [hyp (and mmstate-pad (mirror-mind-state-strategic-hypothesis mmstate-pad))])
      (if (or (and ar (action-lens-reading-proxy-or-rush-detected? ar))
              (memq hyp '(proxy-production-or-all-in rush early-aggression)))
          0.65
          0.12)))
  (set-l2-ctx-mmstate-rush-post! ctx mmstate-rush-post))

(define (l2-phase4-expansion-pads! ctx)
