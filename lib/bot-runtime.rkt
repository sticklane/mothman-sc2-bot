             terran-infantry-weapons-1 terran-infantry-weapons-2 terran-infantry-weapons-3
             terran-infantry-armor-1 terran-infantry-armor-2 terran-infantry-armor-3
             hi-sec-auto-tracking)
            'engineering-bay]
           [(vehicle-weapons-1 terran-vehicle-weapons-1 terran-vehicle-weapons-2 terran-vehicle-weapons-3
             terran-vehicle-and-ship-plating-1 terran-vehicle-and-ship-plating-2 terran-vehicle-and-ship-plating-3
             terran-ship-weapons-1 terran-ship-weapons-2 terran-ship-weapons-3)
            'armory]
           [(stimpack combat-shield concussive-shells) 'barracks-techlab]
           [(drilling-claws infernal-pre-igniter smart-servos cyclone-lock-on-damage) 'factory-techlab]
           [(banshee-cloak hyperflight-rotors) 'starport-techlab]
           [(personal-cloaking) 'ghost-academy]
           [(weapon-refit) 'fusion-core]
           [(ground-weapons-1 ground-armor-1
             protoss-ground-weapons-1 protoss-ground-weapons-2 protoss-ground-weapons-3
             protoss-ground-armor-1 protoss-ground-armor-2 protoss-ground-armor-3
             protoss-shields-1 protoss-shields-2 protoss-shields-3)
            'forge]
           [(warpgate warpgate-research warp-gate warp-gate-research protoss-air-weapons-1 protoss-air-armor-1)
            'cybernetics-core]
           [(charge blink resonating-glaives) 'twilight-council]
           [(extended-thermal-lance gravitic-booster gravitic-drive) 'robotics-bay]
           [(psi-storm psionic-storm) 'templar-archive]
           [(shadow-stride) 'dark-shrine]
           [(flux-vanes anion-pulse-crystals) 'fleet-beacon]
           [(missile-attacks-1 ground-carapace-1
             zerg-missile-weapons-1 zerg-missile-weapons-2 zerg-missile-weapons-3
             zerg-ground-armor-1 zerg-ground-armor-2 zerg-ground-armor-3
             zerg-melee-weapons-1 zerg-melee-weapons-2 zerg-melee-weapons-3)
            'evolution-chamber]
           [(zergling-movementspeed metabolic-boost zergling-attackspeed adrenal-glands) 'spawning-pool]
           [(overlord-speed pneumatized-carapace burrow) 'townhall]
           [(glial-reconstitution tunneling-claws) 'roach-warren]
           [(centrifical-hooks) 'baneling-nest]
           [(grooved-spines muscular-augments) 'hydralisk-den]
           [(lurker-range seismic-spines adaptive-talons) 'lurker-den]
           [(neural-parasite pathogen-glands) 'infestation-pit]
           [(chitinous-plating anabolic-synthesis) 'ultralisk-cavern]
           [(zerg-flyer-weapons-1 zerg-flyer-armor-1) 'spire]
           [else #f])]))
    (and raw-slot (l2-normalize-facility-slot-sym ctx raw-slot)))

(define (l2-emit-research-verified! ctx upg-sym)
  (define base-x (l2-ctx-base-x ctx))
  (define base-y (l2-ctx-base-y ctx))
  (define crisis-tech-upgrade-deferral? (l2-ctx-crisis-tech-upgrade-deferral? ctx))
  (define frame (l2-ctx-frame ctx))
  (define live-game? (l2-ctx-live-obs-harvesters? ctx))
  (define oledger (l2-ctx-oledger ctx))
  (define open-prod-slots (l2-ctx-open-prod-slots ctx))
  (define rt (l2-ctx-rt ctx))
    (define r-slot (l2-upgrade-researcher-slot ctx upg-sym))
    (define essential-combat-upg?
      (memq upg-sym '(stimpack metabolic-boost warp-gate)))
    (when (and (or (not crisis-tech-upgrade-deferral?)
                   essential-combat-upg?
                   (>= (l2-ctx-minerals ctx) 800))
               (l2-upgrade-needed? ctx upg-sym)
               (or (not live-game?)
                   (not r-slot)
                   (> (hash-ref open-prod-slots r-slot 0) 0))
               (>= (l2-ctx-minerals ctx) (sc2-min-cost upg-sym))
               (>= (l2-ctx-gas ctx) (sc2-gas-cost upg-sym))
               (or (not live-game?)
                   (refractory-allow-action?! (live-bot-runtime-cooldown-tracker rt)
                                              (list 'research-upg upg-sym)
                                              frame
                                              28)))
      (l2-recall-building-group! ctx 7)
      (l2-emit! ctx (list 'research upg-sym))
      (set-l2-ctx-pending-upgs! ctx (cons upg-sym (l2-ctx-pending-upgs ctx)))
      (when (and live-game? r-slot)
        (hash-set! open-prod-slots r-slot (max 0 (sub1 (hash-ref open-prod-slots r-slot 0)))))
      (order-ledger-record-issued! oledger (+ 850000 (modulo frame 10000) (length (l2-ctx-actions ctx)))
                                   'research upg-sym base-x base-y frame)
      (l2-spend-resources-and-supply! ctx (sc2-min-cost upg-sym) (sc2-gas-cost upg-sym) 0)))

;; Launch up to the number of idle `slot-sym` researchers, advancing +1 -> +2 -> +3 only once prereqs complete.
(define (l2-emit-upgrade-queue! ctx slot-sym specs)
  (define live-game? (l2-ctx-live-obs-harvesters? ctx))
  (define researched-upgs (l2-ctx-researched-upgs ctx))
  (define slots-left
    (if live-game?
        (hash-ref (l2-ctx-open-prod-slots ctx) slot-sym 0)
        (max 1 (l2-cur-ally-canon-bldg-count ctx slot-sym))))
  (let loop ([rem specs] [avail slots-left])
    (when (and (> avail 0) (not (null? rem)))
      (match-define (list upg-sym req-prev extra-ok?) (car rem))
      (define prereq-ok? (or (not live-game?) (not req-prev) (memq req-prev researched-upgs)))
      (define launched?
        (and extra-ok?
             prereq-ok?
             (l2-upgrade-needed? ctx upg-sym)
             (begin
               (l2-emit-research-verified! ctx upg-sym)
               (and (memq upg-sym (l2-ctx-pending-upgs ctx)) #t))))
      (loop (cdr rem) (if launched? (sub1 avail) avail)))))

(define (l2-tech-plan-boosted-unit? ctx sym)
  (define tp (l2-ctx-tech-plan ctx))
  (define tech-obs (l2-ctx-tech-obs ctx))
  (and (adaptive-tech-plan? tp)
       (or (and (memq sym (adaptive-tech-plan-priority-morphs tp)) #t)
           (let ([p (assq sym (adaptive-tech-plan-desired-unit-mix tp))])
             (and p
                  (>= (cdr p) 0.30)
                  (or (>= (or (l2-ctx-eff-phase-supply ctx) 0) 26)
                      (and tech-obs
                           (or (enemy-tech-observation-requires-anti-air? tech-obs)
                               (enemy-tech-observation-requires-detection? tech-obs)))))))))

(define (l2-plan-wants-now? ctx sym)
  (define bo-goal-sym (l2-ctx-bo-goal-sym ctx))
  (define macro-decision (l2-ctx-macro-decision ctx))
  (define plan-next-actions-ht (l2-ctx-plan-next-actions-ht ctx))
  (define tp (l2-ctx-tech-plan ctx))
    (define csym (sc2-canonical-structure-sym sym))
    (or (eq? bo-goal-sym sym)
        (eq? bo-goal-sym csym)
        (hash-has-key? plan-next-actions-ht sym)
        (hash-has-key? plan-next-actions-ht csym)
        (not (not (memq sym (macro-brain-decision-scheduled-ids macro-decision))))
        (not (not (memq csym (macro-brain-decision-scheduled-ids macro-decision))))
        (and (adaptive-tech-plan? tp)
             (or (and (or (memq sym (adaptive-tech-plan-priority-upgrades tp))
                          (memq csym (adaptive-tech-plan-priority-upgrades tp)))
                      #t)
                 (and (or (memq sym (adaptive-tech-plan-priority-morphs tp))
                          (memq csym (adaptive-tech-plan-priority-morphs tp)))
                      #t)
                 (and (or (memq sym (adaptive-tech-plan-counter-tech-buildings tp))
                          (memq csym (adaptive-tech-plan-counter-tech-buildings tp)))
                      (or (not (memq csym '(ultralisk-cavern hive greater-spire fusion-core)))
                          (>= (or (l2-ctx-eff-phase-supply ctx) 0) 50)))
                 (l2-tech-plan-boosted-unit? ctx sym)))))

(define (l2-core-progression-exempt-from-surcharge? ctx target-sym)
  (define active-escrow-sym (l2-ctx-active-escrow-sym ctx))
  (define ally-combat-units (l2-ctx-ally-combat-units ctx))
  (define bo-goal-sym (l2-ctx-bo-goal-sym ctx))
  (define effective-enemy-race (l2-ctx-effective-enemy-race ctx))
  (define enemy-units (l2-ctx-enemy-units ctx))
  (define frame (l2-ctx-frame ctx))
  (define live-enemy-threat-supply (l2-ctx-live-enemy-threat-supply ctx))
  (define supply-used (l2-ctx-supply-used ctx))
  (define total-bldg-counts (l2-ctx-total-bldg-counts ctx))
  (define under-base-attack? (l2-ctx-under-base-attack? ctx))
  (define enemy-has-reaper-or-air?
    (and (list? enemy-units)
         (ormap (lambda (e)
                  (and (hash? e)
                       (or (eq? (fast-canonical-unit-sym (unit-type-sym e)) 'reaper)
                           (hash-ref e 'flying? #f))))
                enemy-units)))
    (and target-sym
         (or (and (eq? target-sym 'robotics-facility)
                  (= (sc2-count-equivalent-structures total-bldg-counts 'robotics-facility #f) 0)
                  (>= supply-used 30))
             (and (eq? target-sym 'spawning-pool)
                  (= (sc2-count-equivalent-structures total-bldg-counts 'spawning-pool #f) 0))
             (and (eq? target-sym 'cybernetics-core)
                  (= (sc2-count-equivalent-structures total-bldg-counts 'cybernetics-core #f) 0)
                  (or (not under-base-attack?)
                      enemy-has-reaper-or-air?
                      (eq? effective-enemy-race 'Terran)
                      (and (list? ally-combat-units) (not (null? ally-combat-units)))
                      (>= frame 1400)))
             (and (not under-base-attack?)
                  (or (memq target-sym
                            '(spawning-pool cybernetics-core forge
                              orbital-command barracks-techlab factory starport engineering-bay
                              robotics-facility twilight-council))
                      (and (<= live-enemy-threat-supply 4.0)
                           (or (eq? target-sym bo-goal-sym)
                               (eq? target-sym active-escrow-sym)
                               (memq target-sym
                                     '(roach-warren queen
                                       hatchery nexus command-center
                                       warp-gate-research metabolic-boost stimpack lair)))))))))

(define (l2-scheduled-combat-reserve ctx [target-sym #f])
  (define md (l2-ctx-macro-decision ctx))
  (define ps (l2-ctx-prio-summary ctx))
  (define open-prod-slots (l2-ctx-open-prod-slots ctx))
  (cond
    [(or (not (l2-ctx-live-obs-harvesters? ctx))
         (not (macro-brain-decision? md))
         (not (hash? ps))
         (memq target-sym '(pylon supply-depot overlord)))
     (values 0 0)]
    [else
     (define decisions (hash-ref ps 'decisions '()))
     (define target-canon-u (and target-sym (sc2-canonical-unit-sym target-sym)))
     (define target-canon-b (and target-sym (fast-canonical-structure-sym target-sym)))
     (define target-u
       (or (and target-sym
                (for/or ([d (in-list decisions)])
                  (define did (and (hash? d) (hash-ref d 'id #f)))
                  (and did
                       (or (eq? did target-sym)
                           (eq? (sc2-canonical-unit-sym did) target-canon-u)
                           (eq? (fast-canonical-structure-sym did) target-canon-b))
                       (hash-ref d 'utility #f))))
           0.0))
     ;; Sum (rather than `max`) all higher-utility scheduled combat/counter items within current bank
     ;; so sequential Layer 2 building/worker phases cannot piecemeal-drain minerals needed for the
     ;; scheduled combat wave (`marauder` + `medivac` + `siege-tank`, etc.)!
     (for/fold ([r-min 0] [r-gas 0])
               ([d (in-list decisions)])
       (define u-sym (and (hash? d) (hash-ref d 'id #f)))
       (define d-cat (and (hash? d) (hash-ref d 'category #f)))
       (define u-mc (if u-sym (max 0 (sc2-min-cost u-sym)) 0))
       (define u-gc (if u-sym (max 0 (sc2-gas-cost u-sym)) 0))
       (if (and u-sym
                (eq? (hash-ref d 'outcome #f) 'scheduled)
                (> (hash-ref d 'utility 0.0) target-u)
                (<= (+ r-min u-mc) (l2-ctx-minerals ctx))
                (<= (+ r-gas u-gc) (l2-ctx-gas ctx))
                (or (and (eq? d-cat 'combat-unit)
                         (not (l2-unit-suppressed-by-counter-pivot? ctx u-sym))
                         (l2-can-spend-supply? ctx (sc2-supply-cost u-sym))
                         (let* ([lookup-sym (case u-sym [(viking-fighter viking-assault) 'viking] [else u-sym])]
                                [node (lookup-sc2-tech-node lookup-sym)]
                                [pslot0 (and node (sc2-tech-node-producer-slot node))]
                                [slot (case pslot0
                                        [(warp-gate warpgate) 'gateway]
                                        [(hatchery lair hive) 'larva]
                                        [else pslot0])])
                           (and slot (hash? open-prod-slots) (> (hash-ref open-prod-slots slot 0) 0))))
                    (and (memq d-cat '(counter-tech tech-upgrade))
                         (let ([node (lookup-sc2-tech-node u-sym)])
                           (and node (eq? (sc2-tech-node-kind node) 'build)))
                         (not (l2-building-present-or-pending? ctx u-sym))
                         (or (eq? u-sym (l2-ctx-bo-goal-sym ctx))
                             (and target-sym
                                  (not (memq target-sym (macro-brain-decision-scheduled-ids md))))))))
           (values (+ r-min u-mc)
                   (+ r-gas u-gc))
           (values r-min r-gas)))]))

(define (l2-non-combat-min-ok? ctx cost [target-sym #f])
  (define basic-combat-min-floor (l2-ctx-basic-combat-min-floor ctx))
  (define hard-supply-lockout-reserve-min (l2-ctx-hard-supply-lockout-reserve-min ctx))
  (define urgent-combat-or-intel-need? (l2-ctx-urgent-combat-or-intel-need? ctx))
  (define zerg-hold-overlord-min? (l2-ctx-zerg-hold-overlord-min? ctx))
  (define-values (sched-combat-min _sched-combat-gas)
    (l2-scheduled-combat-reserve ctx target-sym))
    (define supply-lock-floor
      (cond
        [(memq target-sym '(pylon supply-depot overlord)) 0]
        [zerg-hold-overlord-min?
         (max hard-supply-lockout-reserve-min (sc2-min-cost 'overlord))]
        [else hard-supply-lockout-reserve-min]))
    (and (>= (- (l2-ctx-minerals ctx) cost) supply-lock-floor)
         (>= (- (l2-ctx-minerals ctx) cost) sched-combat-min)
         (>= (- (l2-ctx-minerals ctx) cost)
             (cond
               [(not urgent-combat-or-intel-need?) 0]
               [(l2-core-progression-exempt-from-surcharge? ctx target-sym) basic-combat-min-floor]
               [else 125]))))

(define (l2-non-combat-gas-ok? ctx cost [target-sym #f])
  (define urgent-combat-or-intel-need? (l2-ctx-urgent-combat-or-intel-need? ctx))
  (define-values (_sched-combat-min sched-combat-gas)
    (l2-scheduled-combat-reserve ctx target-sym))
    (or (<= cost 0)
        (and (>= (- (l2-ctx-gas ctx) cost) sched-combat-gas)
             (>= (- (l2-ctx-gas ctx) cost)
                 (if (and urgent-combat-or-intel-need?
                          (not (l2-core-progression-exempt-from-surcharge? ctx target-sym)))
                     50
                     0)))))

(define (l2-worker-army-curve-satisfied? ctx)
  (define active-bases (l2-ctx-active-bases ctx))
  (define larva-slot-cnt (l2-ctx-larva-slot-cnt ctx))
  (define live-army-supply (l2-ctx-live-army-supply ctx))
  (define live-enemy-threat-supply (l2-ctx-live-enemy-threat-supply ctx))
  (define live-game? (l2-ctx-live-obs-harvesters? ctx))
  (define live-open-combat-slots (l2-ctx-live-open-combat-slots ctx))
  (define race (l2-ctx-race ctx))
  (define total-workers (l2-ctx-total-workers ctx))
  (define under-base-attack? (l2-ctx-under-base-attack? ctx))
  (define zerg-fog-army-floor-ok? (l2-ctx-zerg-fog-army-floor-ok? ctx))
    (and zerg-fog-army-floor-ok?
         (or (not live-game?)
             (< total-workers 24)
             (and (eq? race 'Zerg)
                  (not under-base-attack?)
                  (>= active-bases 3)
                  (< total-workers 55)
                  (>= live-army-supply 4.0))
             (and (not under-base-attack?)
                  (<= live-enemy-threat-supply 0)
                  (or (and (< total-workers (min 66 (* 20 active-bases))) (>= (l2-ctx-minerals ctx) 150))
                      (and (>= (l2-ctx-minerals ctx) 350)
                           (<= (if (exact-integer? live-open-combat-slots)
                                   (+ live-open-combat-slots larva-slot-cnt)
                                   99)
                               1))))
             (>= live-army-supply
                 (required-army-supply-for-worker-growth total-workers live-enemy-threat-supply)))))

(define (l2-can-spend-by-priority? ctx id-sym [cat-sym 'combat-unit])
  (define ally-combat-units (l2-ctx-ally-combat-units ctx))
  (define escrow-suppressed-active? (l2-ctx-escrow-suppressed-active? ctx))
  (define goal-stream-alloc (l2-ctx-goal-stream-alloc ctx))
  (define live-enemy-threat-supply (l2-ctx-live-enemy-threat-supply ctx))
  (define live-game? (l2-ctx-live-obs-harvesters? ctx))
  (define macro-decision (l2-ctx-macro-decision ctx))
  (define protoss-pending-robo-gas-reserve (l2-ctx-protoss-pending-robo-gas-reserve ctx))
  (define severe-intel-blindness? (l2-ctx-severe-intel-blindness? ctx))
  (define under-base-attack? (l2-ctx-under-base-attack? ctx))
    (define m-cost (sc2-min-cost id-sym))
    (define g-cost (sc2-gas-cost id-sym))
    (define alt-sym
      (case id-sym
        [(viking) 'viking-fighter]
        [(viking-fighter viking-assault) 'viking]
        [(templar-archive) 'templar-archives]
        [(templar-archives) 'templar-archive]
        [(lurker-den) 'lurker-den-mp]
        [(lurker-den-mp) 'lurker-den]
        [else #f]))
    (or (not live-game?)
        (and escrow-suppressed-active?
             (or (memq cat-sym '(combat-unit worker))
                 (not (l2-ctx-crisis-tech-upgrade-deferral? ctx)))
             (>= (l2-ctx-minerals ctx) m-cost)
             (>= (l2-ctx-gas ctx) g-cost))
        (and (eq? cat-sym 'combat-unit)
             (>= (l2-ctx-minerals ctx) m-cost)
             (>= (- (l2-ctx-minerals ctx) m-cost) (l2-ctx-hard-supply-lockout-reserve-min ctx))
             (>= (- (l2-ctx-gas ctx) g-cost) (if (> g-cost 0) protoss-pending-robo-gas-reserve 0))
             (or under-base-attack?
                 (>= live-enemy-threat-supply (max 6 (+ (l2-ctx-live-army-supply ctx) 2)))
                 escrow-suppressed-active?
                 (and severe-intel-blindness? (null? ally-combat-units))))
        (macro-brain-can-spend? macro-decision id-sym (l2-ctx-minerals ctx) (l2-ctx-gas ctx) cat-sym)
        (and alt-sym
             (macro-brain-can-spend? macro-decision alt-sym (l2-ctx-minerals ctx) (l2-ctx-gas ctx) cat-sym))
        (and (eq? cat-sym 'combat-unit)
             (>= (l2-ctx-minerals ctx) m-cost)
             (>= (- (l2-ctx-minerals ctx) m-cost) (l2-ctx-bo-reserved-min ctx))
             (>= (- (l2-ctx-gas ctx) g-cost)
                 (max (l2-ctx-bo-reserved-gas ctx)
                      (if (> g-cost 0) protoss-pending-robo-gas-reserve 0)))
             (or (l2-tech-plan-boosted-unit? ctx id-sym)
                 (and alt-sym (l2-tech-plan-boosted-unit? ctx alt-sym))))
        (and (not under-base-attack?)
             (<= live-enemy-threat-supply 0)
             (case cat-sym
               [(expansion) (decoupled-stream-can-spend? goal-stream-alloc 'expansion m-cost g-cost)]
               [(production-scaling)
                (and (>= (l2-ctx-minerals ctx) 550)
                     (decoupled-stream-can-spend? goal-stream-alloc 'production-facilities m-cost g-cost))]
               [else #f]))))

(define (l2-try-train-unit! ctx unit-sym producer-key [recall-group #f] #:respect-bo-reserve? [respect-bo? #f])
  (define active-bases (l2-ctx-active-bases ctx))
  (define base-x (l2-ctx-base-x ctx))
  (define base-y (l2-ctx-base-y ctx))
  (define bo-goal-sym (l2-ctx-bo-goal-sym ctx))
  (define frame (l2-ctx-frame ctx))
  (define live-enemy-threat-supply (l2-ctx-live-enemy-threat-supply ctx))
  (define live-game? (l2-ctx-live-obs-harvesters? ctx))
  (define macro-decision (l2-ctx-macro-decision ctx))
  (define oledger (l2-ctx-oledger ctx))
  (define open-prod-slots (l2-ctx-open-prod-slots ctx))
  (define total-workers (l2-ctx-total-workers ctx))
  (define under-base-attack? (l2-ctx-under-base-attack? ctx))
    (define m-cost (sc2-min-cost unit-sym))
    (define g-cost (sc2-gas-cost unit-sym))
    (define s-cost (sc2-supply-cost unit-sym))
    (define alt-u-sym (if (eq? unit-sym 'viking) 'viking-fighter #f))
    (define is-bo-head?
      (or (and (eq? bo-goal-sym unit-sym)
               (or (not live-game?)
                   (not (memq unit-sym '(drone probe scv)))
                   (memq (l2-ctx-prio-saving-for-sym ctx) (list 'none #f unit-sym))))
          (and alt-u-sym (eq? bo-goal-sym alt-u-sym))
          (and live-game?
               (or (not (not (memq unit-sym (macro-brain-decision-scheduled-ids macro-decision))))
                   (and alt-u-sym
                        (not (not (memq alt-u-sym (macro-brain-decision-scheduled-ids macro-decision)))))))))
    (define max-batch
      (cond
        [(not live-game?) 1]
        [(and (memq unit-sym '(drone probe scv))
              (>= active-bases 2)
              (< total-workers (min 70 (* 22 active-bases)))
              (not under-base-attack?)
              (<= live-enemy-threat-supply 0))
         (min 3 active-bases)]
        [(memq unit-sym '(drone probe scv queen overlord observer sentry raven)) 1]
        [(>= (l2-ctx-minerals ctx) 1000) 8]
        [(>= (l2-ctx-minerals ctx) 600) 6]
        [else 4]))
    (if (l2-unit-suppressed-by-counter-pivot? ctx unit-sym)
        #f
        (let loop ([trained 0])
          (define avail-slots (hash-ref open-prod-slots producer-key 0))
          (define eff-min (if (and respect-bo? (not (and is-bo-head? (= trained 0)))) (- (l2-ctx-minerals ctx) (l2-ctx-bo-reserved-min ctx)) (l2-ctx-minerals ctx)))
          (define eff-gas (if (and respect-bo? (not (and is-bo-head? (= trained 0)))) (- (l2-ctx-gas ctx) (l2-ctx-bo-reserved-gas ctx)) (l2-ctx-gas ctx)))
          (cond
            [(and (< trained max-batch)
                  (> avail-slots 0)
                  (l2-can-spend-supply? ctx s-cost)
                  (or (<= m-cost 0) (>= eff-min m-cost))
                  (or (<= g-cost 0) (>= eff-gas g-cost)))
             (hash-set! open-prod-slots producer-key (sub1 avail-slots))
             (when (and recall-group (= trained 0))
               (l2-recall-building-group! ctx recall-group))
             (l2-emit! ctx (list 'train unit-sym))
             (order-ledger-record-issued! oledger (+ 860000 (modulo frame 10000) (length (l2-ctx-actions ctx)))
                                          'train unit-sym base-x base-y frame)
             (set-l2-ctx-unit-counts! ctx (hash-update (l2-ctx-unit-counts ctx) (sc2-canonical-unit-sym unit-sym) add1 0))
             (l2-spend-resources-and-supply! ctx m-cost g-cost s-cost)
             (loop (add1 trained))]
            [else (> trained 0)]))))

(define (l2-emit-building-morph-verified! ctx target-sym source-syms [recall-group 4])
  (define base-x (l2-ctx-base-x ctx))
  (define base-y (l2-ctx-base-y ctx))
  (define frame (l2-ctx-frame ctx))
  (define live-game? (l2-ctx-live-obs-harvesters? ctx))
  (define oledger (l2-ctx-oledger ctx))
  (define open-prod-slots (l2-ctx-open-prod-slots ctx))
  (define ready-bldg-types (l2-ctx-ready-bldg-types ctx))
  (define ready-bldgs (l2-ctx-ready-bldgs ctx))
    (define m-cost (sc2-min-cost target-sym))
    (define g-cost (sc2-gas-cost target-sym))
    (define-values (src-bldg idle-src-cnt)
      (for/fold ([first-b #f] [cnt 0])
                ([b (in-list ready-bldgs)])
        (if (and (hash? b)
                 (memq (fast-canonical-structure-sym (unit-type-sym b)) source-syms)
                 (<= (hash-ref b 'order-count 0) 0)
                 (= (hash-ref b 'order-ability-id 0) 0)
                 (not (order-ledger-facility-busy? oledger b frame)))
            (values (or first-b b) (add1 cnt))
            (values first-b cnt))))
    (cond
      [(and (not (l2-crisis-tech-bldg-deferred? ctx target-sym))
            (not (l2-building-present-or-pending? ctx target-sym))
            (>= (l2-ctx-minerals ctx) m-cost)
            (>= (l2-ctx-gas ctx) g-cost)
            (or src-bldg
                (and (not live-game?)
                     (ormap (lambda (s) (memq s ready-bldg-types)) source-syms))))
       (when recall-group
         (l2-recall-building-group! ctx recall-group))
       (l2-emit! ctx (list 'morph target-sym))
       (define rec-id
         (if (hash? src-bldg)
             (hash-ref src-bldg 'id (+ 821000 (modulo frame 10000) (length (l2-ctx-actions ctx))))
             (+ 821000 (modulo frame 10000) (length (l2-ctx-actions ctx)))))
       (order-ledger-record-issued! oledger rec-id 'morph target-sym base-x base-y frame)
       (when (and live-game?
                  (or (not (eq? (fast-canonical-structure-sym target-sym) 'orbital-command))
                      (<= idle-src-cnt 1)))
         (l2-record-build-issue-lock! ctx target-sym))
       (set-l2-ctx-bldg-types! ctx (cons (sc2-canonical-structure-sym target-sym) (l2-ctx-bldg-types ctx)))
       (set-l2-ctx-morphing-bldg-types! ctx (cons (sc2-canonical-structure-sym target-sym) (l2-ctx-morphing-bldg-types ctx)))
       (when (and live-game? (ormap (lambda (s) (memq s '(hatchery lair command-center))) source-syms))
         (hash-set! open-prod-slots 'townhall
                    (max 0 (sub1 (hash-ref open-prod-slots 'townhall 0)))))
       (l2-spend-resources-and-supply! ctx m-cost g-cost 0)
       #t]
      [else #f]))

(define (l2-emit-unit-morph-verified! ctx target-sym source-sym [net-supply-cost 0])
  (define base-x (l2-ctx-base-x ctx))
  (define base-y (l2-ctx-base-y ctx))
  (define frame (l2-ctx-frame ctx))
  (define live-game? (l2-ctx-live-obs-harvesters? ctx))
  (define oledger (l2-ctx-oledger ctx))
  (define open-prod-slots (l2-ctx-open-prod-slots ctx))
  (define unit-types (l2-ctx-unit-types ctx))
    (define m-cost (sc2-min-cost target-sym))
    (define g-cost (sc2-gas-cost target-sym))
    (define avail-src (hash-ref open-prod-slots source-sym 0))
    (cond
      [(l2-unit-suppressed-by-counter-pivot? ctx target-sym) #f]
      [(and (or (> avail-src 0)
                (and (not live-game?) (memq source-sym unit-types)))
            (or (<= net-supply-cost 0) (l2-can-spend-supply? ctx net-supply-cost))
            (>= (l2-ctx-minerals ctx) m-cost)
            (>= (l2-ctx-gas ctx) g-cost))
       (when (> avail-src 0)
         (hash-set! open-prod-slots source-sym (sub1 avail-src)))
       (l2-emit! ctx (list 'morph target-sym))
       (order-ledger-record-issued! oledger (+ 865000 (modulo frame 10000) (length (l2-ctx-actions ctx)))
                                    'morph target-sym base-x base-y frame)
       (set-l2-ctx-unit-counts! ctx (hash-update (l2-ctx-unit-counts ctx) (sc2-canonical-unit-sym target-sym) add1 0))
       (l2-spend-resources-and-supply! ctx m-cost g-cost (max 0 net-supply-cost))
       #t]
      [else #f]))

(define (l2-third-base-prereqs-ready-for-escrow? ctx)
  (define eff-phase-supply (l2-ctx-eff-phase-supply ctx))
  (define live-army-supply (l2-ctx-live-army-supply ctx))
  (define live-game? (l2-ctx-live-obs-harvesters? ctx))
  (define race (l2-ctx-race ctx))
  (define ready-bldg-types (l2-ctx-ready-bldg-types ctx))
    (case race
      [(Zerg)
       (and (>= eff-phase-supply 30)
            (memq 'spawning-pool ready-bldg-types))]
      [(Protoss)
       (and (>= eff-phase-supply 46)
            (>= live-army-supply 10)
            (or (>= (l2-ctx-total-workers ctx) 38)
                (eq? (l2-ctx-prio-saving-for-sym ctx) 'nexus)
                (not (and (memq 'robotics-bay ready-bldg-types)
                          (= (l2-unit-count ctx 'colossus) 0))))
            (or (memq 'robotics-facility (l2-ctx-bldg-types ctx))
                (memq 'twilight-council (l2-ctx-bldg-types ctx))
                (memq 'stargate (l2-ctx-bldg-types ctx))
                (eq? (l2-ctx-prio-saving-for-sym ctx) 'nexus)
                (l2-plan-wants-now? ctx 'nexus)))]
      [(Terran)
       (and (>= eff-phase-supply 42)
            (or (not live-game?) (>= live-army-supply 10) (>= (l2-ctx-minerals ctx) 550))
            (or (not live-game?)
                (memq 'starport ready-bldg-types)
                (>= (l2-ctx-minerals ctx) 550))
            (or live-game?
                (memq 'starport (l2-ctx-bldg-types ctx))
                (and (not (memq 'factory ready-bldg-types))
                     (or (memq 'factory (l2-ctx-bldg-types ctx))
                         (l2-plan-wants-now? ctx 'command-center)))))]
      [else #f]))

(define (l2-macro-brain-expand-backed-off? ctx)
  (define md (l2-ctx-macro-decision ctx))
  (define ps (l2-ctx-prio-summary ctx))
  (define race-th-sym (l2-ctx-race-th-sym ctx))
  (and (l2-ctx-live-obs-harvesters? ctx)
       (macro-brain-decision? md)
       (hash? ps)
       (not (eq? (macro-brain-decision-saving-for md) race-th-sym))
       (for/or ([d (in-list (hash-ref ps 'decisions '()))])
         (and (hash? d)
              (eq? (hash-ref d 'id #f) race-th-sym)
              (or (<= (hash-ref d 'utility 999.0) 50.0)
                  (and (not (eq? (l2-ctx-bo-goal-sym ctx) race-th-sym))
                       (not (hash-ref d 'blocking? #t))
                       (pair? (macro-brain-decision-scheduled-ids md))))))))

(define (l2-saving-for-expansion-now? ctx cur-base-count)
  (define ally-combat-units (l2-ctx-ally-combat-units ctx))
  (define blocked-nat-expanded-early? (l2-ctx-blocked-nat-expanded-early? ctx))
  (define bo-goal-sym (l2-ctx-bo-goal-sym ctx))
  (define crisis-freeze-expand-or-gas? (l2-ctx-crisis-freeze-expand-or-gas? ctx))
  (define cur-escrow-age-frames (l2-ctx-cur-escrow-age-frames ctx))
  (define desired-bases (l2-ctx-desired-bases ctx))
  (define early-survival-crisis? (l2-ctx-early-survival-crisis? ctx))
  (define eff-phase-supply (l2-ctx-eff-phase-supply ctx))
  (define escrow-suppressed-active? (l2-ctx-escrow-suppressed-active? ctx))
  (define forward-proxy-detected? (l2-ctx-forward-proxy-detected? ctx))
  (define frame (l2-ctx-frame ctx))
  (define live-army-supply (l2-ctx-live-army-supply ctx))
  (define live-enemy-threat-supply (l2-ctx-live-enemy-threat-supply ctx))
  (define live-game? (l2-ctx-live-obs-harvesters? ctx))
  (define max-escrow-timeout-frames (l2-ctx-max-escrow-timeout-frames ctx))
  (define natural-blocked? (l2-ctx-natural-blocked? ctx))
  (define oledger (l2-ctx-oledger ctx))
  (define orphaned-prereqs (l2-ctx-orphaned-prereqs ctx))
  (define pressure-metrics (l2-ctx-pressure-metrics ctx))
  (define race (l2-ctx-race ctx))
  (define race-th-sym (l2-ctx-race-th-sym ctx))
  (define severe-intel-blindness? (l2-ctx-severe-intel-blindness? ctx))
  (define total-workers (l2-ctx-total-workers ctx))
  (define under-base-attack? (l2-ctx-under-base-attack? ctx))
  (define under-early-cheese? (l2-ctx-under-early-cheese? ctx))
  (define urgent-combat-or-intel-need? (l2-ctx-urgent-combat-or-intel-need? ctx))
    (and (not under-base-attack?)
         (not under-early-cheese?)
         (not early-survival-crisis?)
         (not crisis-freeze-expand-or-gas?)
         (not blocked-nat-expanded-early?)
         (not (and live-game? (= cur-base-count 1) natural-blocked?))
         (not (and live-game? (<= cur-base-count 1) forward-proxy-detected?))
         (<= live-enemy-threat-supply
             (if (= cur-base-count 1)
                 4.0
                 (max 6.0 (* 0.85 live-army-supply))))
         (not urgent-combat-or-intel-need?)
         (not escrow-suppressed-active?)
         (not (l2-macro-brain-expand-backed-off? ctx))
         (< cur-escrow-age-frames max-escrow-timeout-frames)
         (or (not live-game?)
             (and (= cur-base-count 1) (< frame (if (eq? race 'Zerg) 2400 3800)))
             (>= live-army-supply 2))
         (or (not live-game?) (not severe-intel-blindness?) (not (null? ally-combat-units)))
         (null? orphaned-prereqs)
         (< (hash-ref pressure-metrics 'threat-pressure 0.0) 0.85)
         (= (order-ledger-pending-count-for-type oledger race-th-sym frame) 0)
         (< (l2-ctx-minerals ctx) (sc2-min-cost race-th-sym))
         (or (and live-game?
                  (= cur-base-count 1)
                  (case race
                    [(Zerg) (>= total-workers 15)]
                    [(Protoss) (and (>= total-workers 17)
                                    (or (memq 'gateway (l2-ctx-bldg-types ctx)) (memq 'warp-gate (l2-ctx-bldg-types ctx)))
                                    (memq 'assimilator (l2-ctx-bldg-types ctx)))]
                    [(Terran) (and (>= total-workers 18)
                                   (memq 'barracks (l2-ctx-bldg-types ctx))
                                   (memq 'refinery (l2-ctx-bldg-types ctx))
                                   (l2-building-present-or-pending? ctx 'orbital-command))]
                    [else #f]))
             (and live-game?
                  (eq? bo-goal-sym race-th-sym)
                  (or (= cur-base-count 1)
                      (and (= cur-base-count 2) (l2-third-base-prereqs-ready-for-escrow? ctx))
                      (and (>= cur-base-count 3)
                           (>= eff-phase-supply (case race [(Protoss) 66] [(Terran) 62] [else 48]))
                           (>= live-army-supply (if (eq? race 'Zerg) 8 18))))
                  (>= total-workers (if (eq? race 'Zerg) 15 18)))
             (and (> frame 1800)
                  (< cur-base-count desired-bases)
                  (>= total-workers
                      (if (and live-game? (= cur-base-count 2))
                          (if (eq? race 'Zerg) 28 35)
                          (* (max 1 cur-base-count) SC2-IDEAL-WORKERS-PER-BASE)))
                  (or (not live-game?)
                      (= cur-base-count 1)
                      (eq? bo-goal-sym race-th-sym)
                      (eq? (l2-ctx-prio-saving-for-sym ctx) race-th-sym)
                      (and (macro-brain-decision? (l2-ctx-macro-decision ctx))
                           (not (not (memq race-th-sym (macro-brain-decision-scheduled-ids (l2-ctx-macro-decision ctx)))))))
                  (if live-game?
                      (or (= cur-base-count 1)
                          (and (= cur-base-count 2) (l2-third-base-prereqs-ready-for-escrow? ctx))
                          (and (>= cur-base-count 3)
                               (>= eff-phase-supply (case race [(Protoss) 66] [(Terran) 62] [else 48]))
                               (>= live-army-supply (* (if (eq? race 'Zerg) 4 7) cur-base-count))))
                      (>= (length ally-combat-units) 4))))
         ;; Keep expensive uncamped-pad check last so failed scalar/prereq checks short-circuit cleanly.
         (or (not live-game?)
             (let-values ([(ux uy) (l2-select-uncamped-expansion-pad ctx (= cur-base-count 1))])
               (and ux uy #t)))))

(define (l2-heavy-siege-record? ctx e)
    (define sym (unit-type-sym e))
    (define cached (hash-ref HEAVY-SIEGE-CACHE sym 'miss))
    (if (eq? cached 'miss)
        (let ([v (and (memq (fast-canonical-unit-sym sym)
                            '(siege-tank siege-tank-sieged colossus archon immortal thor planetary-fortress))
                      #t)])
          (hash-set! HEAVY-SIEGE-CACHE sym v)
          v)
        cached))

(define (l2-active-gas-bldg? ctx b)
    (> (hash-ref b 'vespene-contents 1) 0))

(define (l2-wall-slot-powered? ctx slot-pt)
  (define ally-bldgs (l2-ctx-ally-bldgs ctx))
  (define bypass-wall-pylon? (l2-ctx-bypass-wall-pylon? ctx))
  (define live-game-obs? (l2-ctx-live-game-obs? ctx))
       (and (pair? slot-pt)
            (not bypass-wall-pylon?)
            (or (not live-game-obs?)
                (ormap (lambda (b)
                         (and (hash? b)
                              (eq? (fast-canonical-structure-sym (unit-type-sym b)) 'pylon)
                              (>= (hash-ref b 'build-progress 1.0) SC2-BUILD-COMPLETE-PROGRESS)
                              (<= (dist2d (car slot-pt) (cdr slot-pt)
                                          (hash-ref b 'x -999.0)
                                          (hash-ref b 'y -999.0))
                                  6.2)))
                       ally-bldgs))))

(define (l2-protoss-holding-colossus-now? ctx)
  (define colossus-goal-cap (l2-ctx-colossus-goal-cap ctx))
  (define cur-escrow-age-frames (l2-ctx-cur-escrow-age-frames ctx))
  (define early-survival-crisis? (l2-ctx-early-survival-crisis? ctx))
  (define escrow-suppressed-active? (l2-ctx-escrow-suppressed-active? ctx))
  (define live-game? (l2-ctx-live-obs-harvesters? ctx))
  (define max-escrow-timeout-frames (l2-ctx-max-escrow-timeout-frames ctx))
  (define open-prod-slots (l2-ctx-open-prod-slots ctx))
  (define protoss-saving-for-expand? (l2-ctx-protoss-saving-for-expand? ctx))
  (define ready-bldg-types (l2-ctx-ready-bldg-types ctx))
  (define under-base-attack? (l2-ctx-under-base-attack? ctx))
       (and live-game?
            (not protoss-saving-for-expand?)
            (not early-survival-crisis?)
            (not under-base-attack?)
            (not escrow-suppressed-active?)
            (< cur-escrow-age-frames max-escrow-timeout-frames)
            (memq 'robotics-bay ready-bldg-types)
            (memq 'robotics-facility ready-bldg-types)
            (> (hash-ref open-prod-slots 'robotics-facility 0) 0)
            (< (l2-unit-count ctx 'colossus) colossus-goal-cap)
            (l2-can-spend-supply? ctx (sc2-supply-cost 'colossus))))

(define (l2-protoss-holding-etl-now? ctx)
  (define cur-escrow-age-frames (l2-ctx-cur-escrow-age-frames ctx))
  (define early-survival-crisis? (l2-ctx-early-survival-crisis? ctx))
  (define escrow-suppressed-active? (l2-ctx-escrow-suppressed-active? ctx))
  (define live-game? (l2-ctx-live-obs-harvesters? ctx))
  (define max-escrow-timeout-frames (l2-ctx-max-escrow-timeout-frames ctx))
  (define open-prod-slots (l2-ctx-open-prod-slots ctx))
  (define protoss-saving-for-expand? (l2-ctx-protoss-saving-for-expand? ctx))
  (define ready-bldg-types (l2-ctx-ready-bldg-types ctx))
  (define under-base-attack? (l2-ctx-under-base-attack? ctx))
  (and live-game?
       (not protoss-saving-for-expand?)
       (not early-survival-crisis?)
       (not under-base-attack?)
       (not (l2-ctx-urgent-combat-or-intel-need? ctx))
       (not (l2-ctx-crisis-tech-upgrade-deferral? ctx))
       (not escrow-suppressed-active?)
       (< cur-escrow-age-frames max-escrow-timeout-frames)
       (memq 'robotics-bay ready-bldg-types)
       (> (hash-ref open-prod-slots 'robotics-bay 0) 0)
       (>= (l2-unit-count ctx 'colossus) 1)
       (l2-upgrade-needed? ctx 'extended-thermal-lance)))

(define (l2-protoss-colossus-escrow-ok? ctx m-cost g-cost #:for-etl? [for-etl? #f])
       (and (or (not (l2-protoss-holding-colossus-now? ctx))
                (and (>= (- (l2-ctx-minerals ctx) m-cost) (sc2-min-cost 'colossus))
                     (>= (- (l2-ctx-gas ctx) g-cost) (sc2-gas-cost 'colossus))))
            (or for-etl?
                (not (l2-protoss-holding-etl-now? ctx))
                (and (>= (- (l2-ctx-minerals ctx) m-cost) (sc2-min-cost 'extended-thermal-lance))
                     (>= (- (l2-ctx-gas ctx) g-cost) (sc2-gas-cost 'extended-thermal-lance))))))

(define (l2-terran-facility-has-addon? ctx b)
  (define terran-addon-ox (l2-ctx-terran-addon-ox ctx))
  (define terran-addon-oy (l2-ctx-terran-addon-oy ctx))
  (define terran-addon-xs (l2-ctx-terran-addon-xs ctx))
  (define terran-addon-ys (l2-ctx-terran-addon-ys ctx))
       (or (eq? (hash-ref b 'has-addon? #f) #t)
           (not (not (hash-ref b 'addon #f)))
           (> (hash-ref b 'add-on-tag 0) 0)
           (and (pair? terran-addon-xs)
                (let ([tx (fl+ (exact->inexact (hash-ref b 'x -999.0)) terran-addon-ox)]
                      [ty (fl+ (exact->inexact (hash-ref b 'y -999.0)) terran-addon-oy)])
                  (for/or ([ax (in-list terran-addon-xs)]
                           [ay (in-list terran-addon-ys)])
                    (define dx (fl- tx ax))
                    (define dy (fl- ty ay))
                    (fl<= (fl+ (fl* dx dx) (fl* dy dy)) 3.0625))))))

(define (l2-facility-being-swapped? ctx b)
  (define addon-swap-acts (l2-ctx-addon-swap-acts ctx))
       (define bid (hash-ref b 'id -1))
       (for/or ([a (in-list addon-swap-acts)])
         (and (pair? a)
              (eq? (car a) 'terran-addon-swap)
              (>= (length a) 3)
              (or (equal? (second a) bid)
                  (equal? (third a) bid)))))

(define (l2-grounded-bare-facility ctx sym)
  (define ally-bldgs (l2-ctx-ally-bldgs ctx))
  (define claimed-addon-fac-ids (l2-ctx-claimed-addon-fac-ids ctx))
  (define frame (l2-ctx-frame ctx))
  (define live-game? (l2-ctx-live-obs-harvesters? ctx))
  (define oledger (l2-ctx-oledger ctx))
       (for/first ([b (in-list ally-bldgs)]
                   #:when (and (eq? (unit-type-sym b) sym)
                               (l2-building-grounded-and-powered? ctx b)
                               (>= (hash-ref b 'build-progress 1.0) SC2-BUILD-COMPLETE-PROGRESS)
                               (or (not live-game?) (= (hash-ref b 'order-count 0) 0))
                               (not (l2-terran-facility-has-addon? ctx b))
                               (not (l2-facility-being-swapped? ctx b))
                               (not (set-member? claimed-addon-fac-ids (hash-ref b 'id -1)))
                               (or (not live-game?)
                                   (not (order-ledger-facility-busy? oledger b frame)))))
         b))

;; Estimate 3-second mineral and gas income so priority escrows pause idle production only when < 3s away.
(define (l2-income-3s-minerals-gas ctx)
  (define obs (l2-ctx-obs ctx))
  (define total-w (l2-ctx-total-workers ctx))
  (define ready-bldgs (l2-ctx-ready-bldg-types ctx))
  (define min-w
    (max 1 (hash-ref obs 'mineral-harvesters
                     (max 1 (- total-w (* 3 (length (l2-ctx-active-refineries ctx))))))))
  (define gas-w
    (max 0 (hash-ref obs 'gas-harvesters (* 3 (length (l2-ctx-active-refineries ctx))))))
  (define mule-bonus (if (memq 'orbital-command ready-bldgs) 8.0 0.0))
  (values (+ 10.0 (* 2.8 min-w) mule-bonus)
          (+ 3.0 (* 3.75 gas-w))))

(define (l2-imminent-escrow-needed? ctx target-min [target-gas 0])
  (define-values (m3 g3) (l2-income-3s-minerals-gas ctx))
  (define missing-m (max 0 (- target-min (l2-ctx-minerals ctx))))
  (define missing-g (max 0 (- target-gas (l2-ctx-gas ctx))))
  (and (<= missing-m m3)
       (<= missing-g g3)))

(define (l2-holding-for-first-starport? ctx)
  (define cur-escrow-age-frames (l2-ctx-cur-escrow-age-frames ctx))
  (define early-survival-crisis? (l2-ctx-early-survival-crisis? ctx))
  (define escrow-suppressed-active? (l2-ctx-escrow-suppressed-active? ctx))
  (define live-game? (l2-ctx-live-obs-harvesters? ctx))
  (define max-escrow-timeout-frames (l2-ctx-max-escrow-timeout-frames ctx))
  (define ready-bldg-types (l2-ctx-ready-bldg-types ctx))
  (define terran-cannon-breakout-mode? (l2-ctx-terran-cannon-breakout-mode? ctx))
  (define terran-saving-for-expand? (l2-ctx-terran-saving-for-expand? ctx))
  (define under-base-attack? (l2-ctx-under-base-attack? ctx))
       (and live-game?
            (memq 'factory ready-bldg-types)
            (not terran-cannon-breakout-mode?)
            (not terran-saving-for-expand?)
            (not early-survival-crisis?)
            (not under-base-attack?)
            (not escrow-suppressed-active?)
            (< cur-escrow-age-frames max-escrow-timeout-frames)
            (not (l2-building-present-or-pending? ctx 'starport))
            (or (eq? (l2-ctx-active-escrow-sym ctx) 'starport)
                (l2-imminent-escrow-needed? ctx (sc2-min-cost 'starport) (sc2-gas-cost 'starport)))))

(define (l2-starport-escrow-ok? ctx m-cost g-cost)
       (or (not (l2-holding-for-first-starport? ctx))
           (and (>= (- (l2-ctx-minerals ctx) m-cost) (sc2-min-cost 'starport))
                (>= (- (l2-ctx-gas ctx) g-cost) (sc2-gas-cost 'starport)))))

(define (l2-phase1-setup! ctx rt raw-obs orig-raw-obs sanitized?)
  (set-l2-ctx-rt! ctx rt)
  (set-l2-ctx-raw-obs! ctx raw-obs)
  (set-l2-ctx-orig-raw-obs! ctx orig-raw-obs)
  (define obs (if sanitized? raw-obs (sanitize-obs-hash raw-obs)))
  (set-l2-ctx-obs! ctx obs)
  (define raw-rt-race (live-bot-runtime-actual-race rt))
  (define race
    (if (eq? raw-rt-race 'Random)
        (detect-actual-race-from-obs obs 'Zerg)
        raw-rt-race))
  (set-l2-ctx-race! ctx race)
  (define frame (hash-ref obs 'frame 0))
  (set-l2-ctx-frame! ctx frame)
  (set-l2-ctx-minerals! ctx (hash-ref obs 'minerals 200))
  (set-l2-ctx-gas! ctx (hash-ref obs 'gas SC2-STARTING-GAS))
  (define supply-used (hash-ref obs 'supply-used SC2-STARTING-WORKERS))
  (set-l2-ctx-supply-used! ctx supply-used)
  (define supply-cap (hash-ref obs 'supply-cap SC2-TOWN-HALL-SUPPLY-PROVIDED))
  (set-l2-ctx-supply-cap! ctx supply-cap)
  (set-l2-ctx-pending-supply! ctx (hash-ref obs 'pending-supply 0))
  (set-l2-ctx-supply-left! ctx (hash-ref obs 'supply-left (- supply-cap supply-used)))
  (define ally-units (hash-ref obs 'ally-units '()))
  (set-l2-ctx-ally-units! ctx ally-units)
  (define ally-bldgs (hash-ref obs 'ally-buildings '()))
  (set-l2-ctx-ally-bldgs! ctx ally-bldgs)
  (define enemy-units (hash-ref obs 'enemy-units '()))
  (set-l2-ctx-enemy-units! ctx enemy-units)
  (define enemy-bldgs (hash-ref obs 'enemy-buildings '()))
  (set-l2-ctx-enemy-bldgs! ctx enemy-bldgs)
  (define base-x (hash-ref obs 'base-x SC2-DEFAULT-HOME-BASE-X))
  (set-l2-ctx-base-x! ctx base-x)
  (define base-y (hash-ref obs 'base-y SC2-DEFAULT-HOME-BASE-Y))
  (set-l2-ctx-base-y! ctx base-y)
  (define nat-x (hash-ref obs 'natural-x SC2-DEFAULT-NATURAL-X))
  (set-l2-ctx-nat-x! ctx nat-x)
  (define nat-y (hash-ref obs 'natural-y SC2-DEFAULT-NATURAL-Y))
  (set-l2-ctx-nat-y! ctx nat-y)
  (define third-x (hash-ref obs 'third-x SC2-DEFAULT-THIRD-X))
  (set-l2-ctx-third-x! ctx third-x)
  (define third-y (hash-ref obs 'third-y SC2-DEFAULT-THIRD-Y))
  (set-l2-ctx-third-y! ctx third-y)
  (define enemy-x (hash-ref obs 'enemy-x SC2-DEFAULT-ENEMY-BASE-X))
  (set-l2-ctx-enemy-x! ctx enemy-x)
  (define enemy-y (hash-ref obs 'enemy-y SC2-DEFAULT-ENEMY-BASE-Y))
  (set-l2-ctx-enemy-y! ctx enemy-y)
  (set-l2-ctx-actions! ctx '())
  (define protoss-powered-structure-syms
    SC2-PROTOSS-PYLON-POWERED-STRUCTURE-SYMS)
  (set-l2-ctx-bldg-types! ctx
    (for/list ([b (in-list ally-bldgs)])
      (fast-canonical-structure-sym (unit-type-sym b))))
  (define-values (unit-types raw-workers workers obs-frozen-workers)
    (for/fold ([ut-rev '()] [rw-rev '()] [w-rev '()] [frozen-cnt 0]
               #:result (values (reverse ut-rev)
                                (reverse rw-rev)
                                (reverse w-rev)
                                frozen-cnt))
              ([u (in-list ally-units)])
      (define ut (unit-type-sym u))
      (define ut-rev2 (cons ut ut-rev))
      (if (memq ut '(drone probe scv))
          (if (l2-unit-stasis-frozen? ctx u)
              (values ut-rev2 (cons u rw-rev) w-rev (+ frozen-cnt 1))
              (values ut-rev2 (cons u rw-rev) (cons u w-rev) frozen-cnt))
          (values ut-rev2 rw-rev w-rev frozen-cnt))))
  (set-l2-ctx-unit-types! ctx unit-types)
  (set-l2-ctx-workers! ctx workers)
  (define frozen-worker-count
    (max obs-frozen-workers
         (safe-nonneg-int (hash-ref obs 'stasis-frozen-worker-count 0) 0)))
  (define active-worker-count
    (if (<= (length raw-workers) 2)
        (let ([harv-active (+ (safe-nonneg-int (hash-ref obs 'mineral-harvesters 0) 0)
                              (safe-nonneg-int
                               (hash-ref obs 'vespene-harvesters
                                         (lambda () (hash-ref obs 'gas-harvesters 0)))
                               0))]
              [unit-or-food (max (length raw-workers)
                                 (safe-nonneg-int (hash-ref obs 'food-workers 0) 0))])
          (max 0 (max harv-active (- unit-or-food frozen-worker-count))))
        (max 0 (- (length raw-workers) frozen-worker-count))))
  (set-l2-ctx-active-worker-count! ctx active-worker-count)
  (define pending-workers (hash-ref obs 'pending-workers 0))
  (set-l2-ctx-pending-workers! ctx pending-workers)
  (define total-workers (+ active-worker-count pending-workers))
  (set-l2-ctx-total-workers! ctx total-workers)
  (when (> frozen-worker-count 0)
    (l2-emit! ctx (list 'stasis-worker-stoppage-compensation frozen-worker-count)))
  (define cd-tracker (live-bot-runtime-cooldown-tracker rt))
  (set-l2-ctx-cd-tracker! ctx cd-tracker)
  (define leases (rt-role-leases rt))
  (set-l2-ctx-leases! ctx leases)
  (define oledger-early (live-bot-runtime-order-ledger rt))
  (set-l2-ctx-oledger-early! ctx oledger-early)
  (define map-grids (hash-ref obs 'map-grids #f))
  (set-l2-ctx-map-grids! ctx map-grids)
  (define step-mineral-patches
    (let ([raw (hash-ref obs 'mineral-patches '())])
      (cond
        [(or (not (list? raw)) (null? raw)) '()]
