(define (refractory-ready? tracker key frame cooldown-frames)
  (or (not (refractory-cooldown-tracker? tracker))
      (let* ([tbl (refractory-cooldown-tracker-table tracker)]
             [last-f (hash-ref tbl key #f)])
        (or (not last-f)
            (let ([f (if (exact-integer? frame) frame (inexact->exact (truncate (if (real? frame) frame 0))))]
                  [cd (if (exact-integer? cooldown-frames)
                          (max 0 cooldown-frames)
                          (max 0 (inexact->exact (truncate (if (real? cooldown-frames) cooldown-frames 0)))))])
              (>= (- f last-f) cd))))))

;; Updates optional key `k` in `h` only when present and changed after running `sanitizer`.
(define (sanitize-optional-key h k sanitizer)
  (define old-v (hash-ref h k SANITIZE-MISSING))
  (if (eq? old-v SANITIZE-MISSING)
      h
      (let ([new-v (sanitizer old-v)])
        (if (equal? new-v old-v)
            h
            (hash-set h k new-v)))))

(define-syntax-rule (sanitize-opt-key-inline h k pred? sanitizer)
  (let ([v (hash-ref h k SANITIZE-MISSING)])
    (if (or (eq? v SANITIZE-MISSING) (pred? v))
        h
        (let ([nv (sanitizer v)])
          (if (equal? nv v) h (hash-set h k nv))))))

(define (tel-set ht k v)
  (define cur (hash-ref ht k RUNTIME-MISSING))
  (if (or (eqv? cur v)
          (and (not (eq? cur RUNTIME-MISSING))
               (equal? cur v)))
      ht
      (hash-set ht k v)))

