;; Select the best targetable enemy unit for `attacker-type` within weapon domain
;; (filters out untargetable projectiles/larva/eggs, enforces air/ground weapon
;; domain matching, de-prioritizes passive scouts/decoys/interceptors/broodlings
;; when real threats exist, and prioritizes Light/Bio clumps for Banelings).
(define PREP-LIGHT-XS (make-flvector 256))
(define PREP-LIGHT-YS (make-flvector 256))

(define (prep-enemy-target-descriptors enemy-units include-nearby-light?)
  (define-values (light-xs light-ys light-cnt)
    (if include-nearby-light?
        (let* ([n (length enemy-units)]
               [cap (flvector-length PREP-LIGHT-XS)]
               [xs (if (<= n cap) PREP-LIGHT-XS (make-flvector n))]
               [ys (if (<= n cap) PREP-LIGHT-YS (make-flvector n))])
          (let loop ([rem enemy-units] [cnt 0])
            (if (null? rem)
                (values xs ys cnt)
                (let ([o (car rem)])
                  (if (bitwise-bit-set? (fast-enemy-sym-flags (unit-type-sym o)) 6)
                      (let ([ox-raw (hash-ref o 'x 0.0)]
                            [oy-raw (hash-ref o 'y 0.0)])
                        (flvector-set! xs cnt (if (flonum? ox-raw) ox-raw (exact->inexact ox-raw)))
                        (flvector-set! ys cnt (if (flonum? oy-raw) oy-raw (exact->inexact oy-raw)))
                        (loop (cdr rem) (add1 cnt)))
                      (loop (cdr rem) cnt))))))
        (values #f #f 0)))
  (let loop ([rem enemy-units] [rev '()])
    (if (null? rem)
        (reverse rev)
        (let* ([e (car rem)]
               [et (unit-type-sym e)]
               [flags (fast-enemy-sym-flags et)])
          (if (or (bitwise-bit-set? flags 0)
                  (eq? (hash-ref e 'hallucination #f) #t))
              (loop (cdr rem) rev)
              (let* ([ex-raw (hash-ref e 'x 9999.0)]
                     [ey-raw (hash-ref e 'y 9999.0)]
                     [ex (if (flonum? ex-raw) ex-raw (exact->inexact ex-raw))]
                     [ey (if (flonum? ey-raw) ey-raw (exact->inexact ey-raw))]
                     [eflying?
                      (or (bitwise-bit-set? flags 8)
                          (eq? (hash-ref e 'is-flying #f) #t)
                          (eq? (hash-ref e 'flying? #f) #t)
                          (eq? (hash-ref e 'flying #f) #t))]
                     [hp-raw (hash-ref e 'hp 100.0)]
                     [hp
                      (cond
                        [(and (flonum? hp-raw) (fl= (fl- hp-raw hp-raw) 0.0)) hp-raw]
                        [(exact-integer? hp-raw) (->fl hp-raw)]
                        [else (exact->inexact (fast-finite-real hp-raw 100.0))])]
                     [changeling?
                      (or (bitwise-bit-set? flags 1)
                          (eq? (hash-ref e 'changeling? #f) #t))]
                     [mobile-det? (bitwise-bit-set? flags 2)]
                     [static-det? (bitwise-bit-set? flags 3)]
                     [passive? (bitwise-bit-set? flags 4)]
                     [struct? (bitwise-bit-set? flags 5)]
                     [light-bio? (bitwise-bit-set? flags 6)]
                     [armored? (bitwise-bit-set? flags 7)]
                     [worker? (and (memq et '(scv probe drone mule)) #t)]
                     [is-detector? (or mobile-det? static-det?)]
                     [combat-threat?
                      (and (not worker?) (not struct?) (not passive?) (not changeling?))]
                     [base-adj
                      (fl+ (if changeling? -220.0 0.0)
                           (fl+ (if struct? 30.0 0.0)
                                ;; L55-T12: Focus revealed Dark Templars (`-45.0`) ahead of Warp Prisms;
                                ;; Loop 63: Focus exposed Swarm Hosts (`-60.0`) ahead of screening units/Locusts!
                                (cond
                                  [(eq? et 'dark-templar) -45.0]
                                  [(hash-has-key? RUNTIME-SWARM-HOST-SET et) -60.0]
                                  [else 0.0])))]
                     [adj-plain
                      (if passive? (fl+ base-adj 250.0) base-adj)]
                     ;; L43-P0-1a + L44-P0-1c (General Detector-First Across ALL 3 Races & `d01`/`d02`):
                     ;; When our local squad has cloaked/burrowed combat units, strongly boost ALL
                     ;; enemy detectors (`-360.0`) so Vikings/Phoenixes/Corruptors/Stalkers/Hydras/DTs
                     ;; snipe live Observers/Ravens/Overseers/Turrets/Cannons/Spores first!
                     [adj-stealth
                      (fl+ base-adj
                           (fl+ (if is-detector? -360.0 0.0)
                                (fl+ (if (and eflying?
                                              (memq et '(banshee oracle liberator-ag void-ray battlecruiser carrier brood-lord broodlord)))
                                         -90.0
                                         0.0)
                                     (if (and passive? (not mobile-det?)) 250.0 0.0))))]
                     [bane-light-bonus
                      (if (and include-nearby-light? light-bio?)
                          (let jloop ([j 0] [cnt 0])
                            (if (= j light-cnt)
                                (fl- -45.0 (fl* 12.0 (->fl cnt)))
                                (let ([dx (fl- ex (flvector-ref light-xs j))])
                                  (if (fl<= (flabs dx) 2.2)
                                      (let ([dy (fl- ey (flvector-ref light-ys j))])
                                        (jloop (add1 j)
                                               (if (fl<= (fl+ (fl* dx dx) (fl* dy dy)) 4.84)
                                                   (add1 cnt)
                                                   cnt)))
                                      (jloop (add1 j) cnt)))))
                          (if (or armored? struct?) 80.0 0.0))])
                (loop (cdr rem)
                      (cons (vector e ex ey eflying? hp adj-plain adj-stealth bane-light-bonus
                                    worker? combat-threat? is-detector?)
                            rev))))))))

(define (select-target-enemy-from-prepped ux uy prepped [attacker-type 'marine] [ally-has-stealth? #f])
  (define baneling-attacker? (eq? attacker-type 'baneling))
  (define sieged-tank-attacker? (eq? attacker-type 'siege-tank-sieged))
  (define adept-attacker? (eq? attacker-type 'adept))
  (define hellion-attacker? (eq? attacker-type 'hellion))
  (define raider-attacker?
    (and (memq attacker-type '(hellion adept oracle banshee mutalisk zergling reaper dark-templar zealot)) #t))
  (define stealth-active?
    (or ally-has-stealth?
        (hash-ref RUNTIME-STEALTH-SET attacker-type #f)))
  (define can-air? (fast-can-attack-air? attacker-type))
  (define can-gnd? (fast-can-attack-ground? attacker-type))
  ;; L55-T1 (`#75 PvT who`): Ground AA units penalize flying enemies hovering over unpathable
  ;; cliff dead-airspace when beyond `(+ air-range 1.0)`, so Stalkers/Marines/Hydras shoot
  ;; reachable mineral-line Banshees instead of slamming into cliff walls!
  (define attacker-ground? (not (fast-unit-is-flying-sym? attacker-type)))
  (define attacker-cliff-air-lim
    (fl+ (let ([st (fast-unit-combat-stats attacker-type)])
           (if (hash? st) (exact->inexact (hash-ref st 'air-range 6.0)) 6.0))
         1.0))
  (define attacker-cliff-air-lim2 (fl* attacker-cliff-air-lim attacker-cliff-air-lim))
  (define fx (if (flonum? ux) ux (exact->inexact ux)))
  (define fy (if (flonum? uy) uy (exact->inexact uy)))
  ;; L44-P0-1a (`#04 PvT` / `#82 PvT`): Gate `-85.0` `raider-adj` worker focus strictly to
  ;; mineral-line runby context (nearby non-worker enemy combat threats `<= 8.0t` are light:
  ;; `<= 3` for dedicated harassers, `<= 2` for Zealots/Zerglings/DTs/Reapers), NEVER pulling
  ;; Zealots/Adepts/Zerglings off a real frontal army clash!
  (define raider-runby-context?
    (and raider-attacker?
         (let ([max-local-combat (if (memq attacker-type '(hellion adept oracle banshee mutalisk)) 3 2)])
           (let rloop ([rem prepped] [cnt 0])
             (cond
               [(> cnt max-local-combat) #f]
               [(null? rem) #t]
               [else
                (let ([rv (car rem)])
                  (if (vector-ref rv 9)
                      (let* ([rdx (fl- (vector-ref rv 1) fx)]
                             [rdy (fl- (vector-ref rv 2) fy)])
                        (if (fl<= (fl+ (fl* rdx rdx) (fl* rdy rdy)) 64.0)
                            (rloop (cdr rem) (add1 cnt))
                            (rloop (cdr rem) cnt)))
                      (rloop (cdr rem) cnt)))])))))
  (define focus-r (if (flonum? SC2-ENGAGEMENT-FOCUS-FIRE-RADIUS)
                      SC2-ENGAGEMENT-FOCUS-FIRE-RADIUS
                      (exact->inexact SC2-ENGAGEMENT-FOCUS-FIRE-RADIUS)))
  (define focus-r2 (fl* focus-r focus-r))
  ;; L49-W1 + L49-W2 (Unified Squad-Wide Detector Snipe Focus + Sole Powering Pylon Disable):
  ;; When our squad has cloaked/burrowed allies (`stealth-active?`), if a single live enemy `pylon`
  ;; (within `<= 22t`) is the SOLE power source (`<= 6.5t`) of `>= 2` live `photon-cannon`s, target
  ;; that `400`-EHP Pylon FIRST (`-520.0` bonus) to disable all powered Cannons simultaneously!
  ;; Otherwise deterministically pick ONE primary live enemy detector (lowest EHP, lowest tag ID).
  (define sole-power-pylon-id
    (and stealth-active?
         can-gnd?
         (let* ([live-pylons
                 (for/list ([v (in-list prepped)]
                            #:when (let ([e0 (vector-ref v 0)])
                                     (and (hash? e0)
                                          (not (eq? (hash-ref e0 'snapshot? #f) #t))
                                          (eq? (fast-canonical-structure-sym (unit-type-sym e0)) 'pylon))))
                   v)]
                [live-cannons
                 (for/list ([v (in-list prepped)]
                            #:when (let ([e0 (vector-ref v 0)])
                                     (and (hash? e0)
                                          (not (eq? (hash-ref e0 'snapshot? #f) #t))
                                          (eq? (fast-canonical-structure-sym (unit-type-sym e0)) 'photon-cannon))))
                   v)])
           (and (pair? live-pylons)
                (>= (length live-cannons) 2)
                (for/fold ([best-id #f] [best-ehp +inf.0] #:result best-id)
                          ([pv (in-list live-pylons)])
                  (define pe (vector-ref pv 0))
                  (define px (vector-ref pv 1))
                  (define py (vector-ref pv 2))
                  (define dx (fl- px fx))
                  (define dy (fl- py fy))
                  (define d2 (fl+ (fl* dx dx) (fl* dy dy)))
                  (if (fl<= d2 484.0)
                      (let ([sole-cnt
                             (for/sum ([cv (in-list live-cannons)])
                               (define cx (vector-ref cv 1))
                               (define cy (vector-ref cv 2))
                               (define cdx (fl- cx px))
                               (define cdy (fl- cy py))
                               (if (fl<= (fl+ (fl* cdx cdx) (fl* cdy cdy)) 42.25)
                                   (let ([other-p?
                                          (for/or ([opv (in-list live-pylons)])
                                            (and (not (eq? opv pv))
                                                 (let ([odx (fl- cx (vector-ref opv 1))]
                                                       [ody (fl- cy (vector-ref opv 2))])
                                                   (fl<= (fl+ (fl* odx odx) (fl* ody ody)) 42.25))))])
                                     (if other-p? 0 1))
                                   0))])
                        (if (>= sole-cnt 2)
                            (let* ([tid (hash-ref pe 'id 0)]
                                   [ehp (exact->inexact (unit-total-hp-and-shield pe))]
                                   [better? (or (not best-id)
                                                (fl< ehp (fl- best-ehp 1.0))
                                                (and (fl<= (flabs (fl- ehp best-ehp)) 1.0)
                                                     (< tid best-id)))])
                              (if better? (values tid ehp) (values best-id best-ehp)))
                            (values best-id best-ehp)))
                      (values best-id best-ehp)))))))
  (define primary-det-id
    (or sole-power-pylon-id
        (and stealth-active?
             (let loop-d ([rem prepped] [best-id #f] [best-ehp +inf.0])
               (if (null? rem)
                   best-id
                   (let* ([v (car rem)]
                          [edet? (vector-ref v 10)])
                     (if (not edet?)
                         (loop-d (cdr rem) best-id best-ehp)
                         (let* ([e0 (vector-ref v 0)]
                                [efly? (vector-ref v 3)]
                                [cv (and (hash? e0) (hash-ref e0 'cloak #f))]
                                [undet? (or (eqv? cv 1) (eq? cv 'cloaked))]
                                [hit? (and (not undet?) (if efly? can-air? can-gnd?))]
                                [dx (fl- (vector-ref v 1) fx)]
                                [dy (fl- (vector-ref v 2) fy)]
                                [d2 (fl+ (fl* dx dx) (fl* dy dy))])
                           (if (and hit? (fl<= d2 484.0) (hash? e0))
                               (let* ([tid (hash-ref e0 'id 0)]
                                      [ehp (exact->inexact (unit-total-hp-and-shield e0))]
                                      [better? (or (not best-id)
                                                   (fl< ehp (fl- best-ehp 1.0))
                                                   (and (fl<= (flabs (fl- ehp best-ehp)) 1.0)
                                                        (< tid best-id)))])
                                 (if better?
                                     (loop-d (cdr rem) tid ehp)
                                     (loop-d (cdr rem) best-id best-ehp)))
                               (loop-d (cdr rem) best-id best-ehp))))))))))
  (let loop ([rem prepped]
             [best-valid #f]
             [best-valid-sc +inf.0]
             [best-any #f]
             [best-any-sc +inf.0])
    (if (null? rem)
        (if best-valid
            (values best-valid #t)
            (values best-any #f))
        (let* ([v (car rem)]
               [e0 (vector-ref v 0)]
               [eflying? (vector-ref v 3)]
               ;; W11-P0-4-rt (`w11-tac-2`): Never unit-target undetected `cloak=1` enemies!
               [undetected-clk?
                (and (hash? e0)
                     (let ([cv (hash-ref e0 'cloak #f)])
                       (or (eqv? cv 1) (eq? cv 'cloaked))))]
               [raw-valid? (and (not undetected-clk?)
                                (if eflying? can-air? can-gnd?))])
          (if (or raw-valid? (not best-valid))
              (let* ([ex (vector-ref v 1)]
                     [ey (vector-ref v 2)]
                     [dx (fl- ex fx)]
                     [dy (fl- ey fy)]
                     [d2 (fl+ (fl* dx dx) (fl* dy dy))]
                     ;; W10-TAC-4: SC2 Sieged Tank 2.0t edge-to-edge min-range deadzone (>=3.25t center-to-center)
                     [valid? (and raw-valid?
                                  (or (not sieged-tank-attacker?)
                                      (fl>= d2 10.5625)))])
                (if (and (not valid?) best-valid)
                    (loop (cdr rem) best-valid best-valid-sc best-any best-any-sc)
                    (let* ([adj-base (if stealth-active? (vector-ref v 6) (vector-ref v 5))]
                           [hp (vector-ref v 4)]
                           [eworker? (vector-ref v 8)]
                           [edet? (vector-ref v 10)]
                           ;; L43-P0-1c + L44-P0-1a (Runby-Only Worker Focus): Raiders prioritize
                           ;; mineral-line workers ONLY in mineral-line runby context!
                           [raider-adj
                            (cond
                              [(and raider-runby-context? eworker? (fl<= d2 196.0))
                               (define base-w-adj -85.0)
                               (cond
                                 [adept-attacker?
                                  (fl+ base-w-adj (fl* 1.15 hp))]
                                 [(and hellion-attacker? (fl<= d2 42.25) (fl> d2 0.01))
                                  (define inv-d (fl/ 1.0 (flsqrt d2)))
                                  (define rvx (fl* dx inv-d))
                                  (define rvy (fl* dy inv-d))
                                  (define aligned-cnt
                                    (for/fold ([cnt 0]) ([ov (in-list prepped)])
                                      (if (and (vector-ref ov 8) (not (eq? ov v)))
                                          (let* ([odx (fl- (vector-ref ov 1) fx)]
                                                 [ody (fl- (vector-ref ov 2) fy)]
                                                 [proj (fl+ (fl* odx rvx) (fl* ody rvy))])
                                            (if (and (fl>= proj 0.0)
                                                     (fl<= proj 5.5)
                                                     (fl<= (flabs (fl- (fl* odx rvy) (fl* ody rvx))) 0.65))
                                                (add1 cnt)
                                                cnt))
                                          cnt)))
                                  (fl- base-w-adj (fl* 18.0 (->fl aligned-cnt)))]
                                 [else base-w-adj])]
                              [else 0.0])]
                           [is-primary-det?
                            (and primary-det-id (hash? e0) (eqv? (hash-ref e0 'id -1) primary-det-id))]
                           [primary-det-adj
                            (cond
                              [(and is-primary-det? edet?) -140.0]
                              [is-primary-det? -520.0]
                              [else 0.0])]
                           [cliff-air-pen
                            (if (and attacker-ground?
                                     eflying?
                                     (hash? e0)
                                     (eq? (hash-ref e0 'over-unpathable-airspace? #f) #t)
                                     (fl> d2 attacker-cliff-air-lim2))
                                220.0
                                0.0)]
                           [adj (fl+ (fl+ (fl+ (if baneling-attacker? (fl+ adj-base (vector-ref v 7)) adj-base)
                                               raider-adj)
                                          primary-det-adj)
                                     cliff-air-pen)]
                           [cur-best (if valid? best-valid-sc best-any-sc)]
                           [pruned?
                            (and (not (and stealth-active? edet?))
                                 (not is-primary-det?)
                                 (fl< cur-best +inf.0)
                                 (if (fl> d2 focus-r2)
                                     (let ([margin (fl- cur-best (fl+ adj (fl+ 100.0 (fl* 0.02 hp))))])
                                       (or (fl<= margin 0.0)
                                           (fl> (fl* 16.0 d2) (fl* margin margin))))
                                     (let ([margin (fl- cur-best (fl+ adj (fl* 0.05 hp)))])
                                       (or (fl<= margin 0.0)
                                           (fl> (fl* 4.0 d2) (fl* margin margin))))))])
                      (if pruned?
                          (loop (cdr rem) best-valid best-valid-sc best-any best-any-sc)
                          (let* ([e (vector-ref v 0)]
                                 [d (flsqrt d2)]
                                 [sc (fl+ adj
                                          (if (fl<= d focus-r)
                                              (fl+ (fl* 2.0 d) (fl* 0.05 hp))
                                              (fl+ 100.0 (fl+ (fl* 4.0 d) (fl* 0.02 hp)))))])
                            (if valid?
                                (if (fl< sc best-valid-sc)
                                    (loop (cdr rem) e sc best-any best-any-sc)
                                    (loop (cdr rem) best-valid best-valid-sc best-any best-any-sc))
                                (if (fl< sc best-any-sc)
                                    (loop (cdr rem) best-valid best-valid-sc e sc)
                                    (loop (cdr rem) best-valid best-valid-sc best-any best-any-sc))))))))
              (loop (cdr rem) best-valid best-valid-sc best-any best-any-sc))))))

(define (select-target-enemy-for-unit ux uy enemy-units [attacker-type 'marine] [ally-has-stealth? #f])
  (define baneling-attacker? (eq? attacker-type 'baneling))
  (define prepped (prep-enemy-target-descriptors enemy-units baneling-attacker?))
  (define-values (tgt _valid?)
    (select-target-enemy-from-prepped ux uy prepped attacker-type ally-has-stealth?))
  tgt)


