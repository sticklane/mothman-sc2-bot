       (define-values (target-x target-y)
         (nudge-off-expansion-pads raw-target-x raw-target-y 5.25))
       (define next-att (add1 att))
       (hash-set! tumor-state-ht tid
                  (hash-set* st 'attempts next-att 'next-try (+ frame (if live-game? 40 68))))
       (when (or (not live-game?) (>= next-att max-tumor-attempts))
         (set-add! (live-bot-runtime-used-creep-tumors rt) tid))
       (l2-emit! ctx (list 'cast tid 'spread-creep-tumor target-x target-y))))

;; Reserve scheduled un-emitted townhall expansion minerals on ctx so phase2/3 spenders
;; cannot consume the expansion bank when the `'expand` action waits on cooldown or pad checks.
(define (l2-protect-unemitted-scheduled-expansion! ctx race-th-sym)
  (define md (l2-ctx-macro-decision ctx))
  (define one-base-light-poke-ok?
    (and (< (l2-ctx-active-bases ctx) 2)
         (not (l2-ctx-worker-rush-active? ctx))
         (not (l2-ctx-under-early-cheese? ctx))
         (not (l2-ctx-bldg-actively-damaged? ctx))
         (<= (l2-ctx-live-enemy-threat-supply ctx)
             (max 2.0 (l2-ctx-live-army-supply ctx)))
         (or (not (l2-ctx-under-base-attack? ctx))
             (<= (l2-ctx-live-enemy-threat-supply ctx)
                 (l2-ctx-live-army-supply ctx)))))
  (when (and (l2-ctx-live-obs-harvesters? ctx)
             md
             (= (order-ledger-pending-count-for-type (l2-ctx-oledger ctx) race-th-sym (l2-ctx-frame ctx)) 0)
             (not (l2-ctx-escrow-suppressed-active? ctx))
             (or (not (l2-ctx-under-base-attack? ctx)) one-base-light-poke-ok?)
             (not (l2-ctx-early-survival-crisis? ctx))
             ;; W5-P0-2-rt: Never let urgent-combat-or-intel-need? strip protection from a
             ;; Brain-scheduled 1-base Natural expansion when enemy threat is tiny (<=2.0)
             ;; and intel is not severely blind (preserves PV7 stale-intel preemption).
             (not (l2-ctx-severe-intel-blindness? ctx))
             (or (< (l2-ctx-active-bases ctx) 2)
                 (not (l2-ctx-urgent-combat-or-intel-need? ctx)))
             (or (not (l2-ctx-crisis-tech-upgrade-deferral? ctx)) one-base-light-poke-ok?)
             (or (<= (l2-ctx-live-enemy-threat-supply ctx) 2.0) one-base-light-poke-ok?)
             (or (< (l2-ctx-minerals ctx) 600) (< (l2-ctx-active-bases ctx) 2))
             (memq race-th-sym (macro-brain-decision-scheduled-ids md)))
    (set-l2-ctx-bo-reserved-min! ctx
                                 (max (l2-ctx-bo-reserved-min ctx)
                                      (sc2-min-cost race-th-sym)))))

;; Respect mineral-only escrows unconditionally, and gas-gated escrows while gas is within 25G.
;; L23-P0-3 (synergy with L23-P0-2 continuous SCV/Probe engine): When Macro Brain explicitly
;; scheduled a Terran SCV or Protoss Probe from dedicated TownHall slots and the BO/saving
;; goal is NOT a supply provider or TownHall expansion, never let L2 BO reserves freeze 50M workers!
(define (l2-worker-respect-bo-reserve? ctx)
  (define race (l2-ctx-race ctx))
  (define pacts (or (l2-ctx-prio-scheduled-actions ctx) '()))
  (define bo-sym (l2-ctx-bo-goal-sym ctx))
  (define sav-sym (l2-ctx-prio-saving-for-sym ctx))
  (define pt-brain-sched-worker?
    (and (memq race '(Terran Protoss))
         (not (not (member (if (eq? race 'Terran) '(train scv) '(train probe)) pacts)))
         (not (memq bo-sym '(pylon supply-depot nexus command-center)))
         (not (memq sav-sym '(pylon supply-depot nexus command-center)))))
  (and (not pt-brain-sched-worker?)
       (l2-ctx-live-obs-harvesters? ctx)
       (or (> (l2-ctx-bo-reserved-min ctx) 0)
           (> (l2-ctx-bo-reserved-gas ctx) 0))
       (or (<= (l2-ctx-bo-reserved-gas ctx) 0)
           (>= (l2-ctx-gas ctx) (- (l2-ctx-bo-reserved-gas ctx) 25)))))

;; L58 BUG #4 (`#58 Creepy` / `#31 sc2ai`): Immediately exempt Zerg Spire from
;; `zerg-defer-spire-over-hydraden?` whenever ANY `tempest`, `carrier`,
;; `fleet-beacon`, or `>= 2` `stargate` is scouted live OR remembered in OWM/tech-obs!
(define (zerg-cap-air-tech-or-unit-scouted? enemy-units enemy-bldgs owm-kc owm-bc [tech-obs #f])
  (define vis-cap-unit?
    (for/or ([e (in-list (or enemy-units '()))])
      (and (hash? e)
           (memq (fast-canonical-unit-sym (unit-type-sym e)) '(tempest carrier))
           #t)))
  (define vis-fb?
    (for/or ([eb (in-list (or enemy-bldgs '()))])
      (and (hash? eb)
           (eq? (fast-canonical-structure-sym (unit-type-sym eb)) 'fleet-beacon))))
  (define vis-sg-cnt
    (for/sum ([eb (in-list (or enemy-bldgs '()))])
      (if (and (hash? eb)
               (eq? (fast-canonical-structure-sym (unit-type-sym eb)) 'stargate))
          1
          0)))
  (define owm-cap-unit?
    (and (hash? owm-kc)
         (or (> (hash-ref owm-kc 'tempest 0) 0)
             (> (hash-ref owm-kc 'carrier 0) 0))))
  (define owm-fb?
    (and (hash? owm-bc)
         (> (hash-ref owm-bc 'fleet-beacon 0) 0)))
  (define owm-sg-cnt
    (if (hash? owm-bc) (hash-ref owm-bc 'stargate 0) 0))
  (define tobs-fb-or-cap?
    (and (enemy-tech-observation? tech-obs)
         (or (not (not (memq 'fleet-beacon (enemy-tech-observation-implied-tech-buildings tech-obs))))
             (not (not (memq 'fleet-beacon (enemy-tech-observation-active-research-buildings tech-obs)))))))
  (or vis-cap-unit? vis-fb? (>= vis-sg-cnt 2)
      owm-cap-unit? owm-fb? (>= owm-sg-cnt 2)
      tobs-fb-or-cap?))

(define (l2-zerg-phase2-expand-tech-def! ctx)
  (define active-extractors (l2-ctx-active-extractors ctx))
  (define ally-bldgs (l2-ctx-ally-bldgs ctx))
  (define ally-combat-units (l2-ctx-ally-combat-units ctx))
  (define base-x (l2-ctx-base-x ctx))
  (define base-y (l2-ctx-base-y ctx))
  (define bldg-actively-damaged? (l2-ctx-bldg-actively-damaged? ctx))
  (define blocked-nat-expanded-early? (l2-ctx-blocked-nat-expanded-early? ctx))
  (define bo-goal-sym (l2-ctx-bo-goal-sym ctx))
  (define cd-tracker (l2-ctx-cd-tracker ctx))
  (define creep-self-sustaining? (l2-ctx-creep-self-sustaining? ctx))
  (define crisis-freeze-expand-or-gas? (l2-ctx-crisis-freeze-expand-or-gas? ctx))
  (define crisis-tech-upgrade-deferral? (l2-ctx-crisis-tech-upgrade-deferral? ctx))
  (define desired-bases (l2-ctx-desired-bases ctx))
  (define early-survival-crisis? (l2-ctx-early-survival-crisis? ctx))
  (define eff-phase-supply (l2-ctx-eff-phase-supply ctx))
  (define effective-enemy-race (l2-ctx-effective-enemy-race ctx))
