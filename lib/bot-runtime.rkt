  (define zvz-enemy-lurker-or-spine?
    (and (eq? effective-enemy-race 'Zerg)
         (or (ormap (lambda (e)
                      (and (hash? e)
                           (memq (fast-canonical-unit-sym (unit-type-sym e))
                                 '(lurker lurker-burrowed lurker-mp lurker-mp-burrowed))))
                    enemy-units)
