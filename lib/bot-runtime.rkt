                         (>= (hash-ref b 'build-progress 1.0) 1.0)
                         (or (memq (hash-ref b 'addon #f) '(techlab factory-techlab))
                             (memq (hash-ref b 'addon-type #f) '(techlab factory-techlab))
                             (let* ([atag (hash-ref b 'add-on-tag 0)]
                                    [addon-rec (and (> atag 0)
                                                    (findf (lambda (ab)
                                                             (and (hash? ab)
                                                                  (= (hash-ref ab 'id -1) atag)))
                                                           ally-bldgs))])
                               (and (> atag 0)
                                    (if addon-rec
                                        (and (>= (hash-ref addon-rec 'build-progress 1.0) 1.0)
                                             (memq (unit-type-sym addon-rec) '(factory-techlab techlab)))
                                        #t))))))
                  ally-bldgs)
           (not (hash-has-key? raw-obs 'mineral-harvesters))))
  (define terran-saving-for-cc-expand? (l2-ctx-terran-saving-for-cc-expand? ctx))
  (define terran-orbital-freezes-all-scvs?
       (and terran-saving-for-orbital?
            (<= (or (l2-ctx-terran-morphed-th-open-slots ctx) 0) 0)))
  ;; L28-P0-3 / L37-P0-2 (`#17/#11/#62/#68/#32` `TvT0Tank 4->0` & `TvP 0-7-1`):
  ;; Track Brain-scheduled `siege-tank`, TvT (`< 4`) & TvP (`< 3`) Tank demand with ready
  ;; Factory-TL, and a brief (<2s) `[100M..150M)` SCV/Marine mineral hold when `gas >= 125`
  ;; so `SCV`/`Marine`/`Marauder` never loop-drain minerals below 150M!
  (define cur-siege-tanks-p3
    (+ (l2-unit-count ctx 'siege-tank)
       (order-ledger-pending-count-for-type oledger 'siege-tank frame)))
  (define brain-sched-siege-tank-p3?
    (and live-game?
         has-fac-tl?
         (memq 'factory ready-bldg-types)
         (or (not (not (member '(train siege-tank) prio-scheduled-actions)))
             (eq? (l2-ctx-prio-saving-for-sym ctx) 'siege-tank)
             (and (macro-brain-decision? (l2-ctx-macro-decision ctx))
                  (not (not (memq 'siege-tank (macro-brain-decision-scheduled-ids (l2-ctx-macro-decision ctx)))))))))
  (define tvt-need-tanks-p3?
    (and live-game?
         has-fac-tl?
         (memq 'factory ready-bldg-types)
         (eq? effective-enemy-race 'Terran)
         (< cur-siege-tanks-p3 4)))
  (define tvp-need-tanks-p3?
    (and live-game?
         has-fac-tl?
         (memq 'factory ready-bldg-types)
         (eq? effective-enemy-race 'Protoss)
         (< cur-siege-tanks-p3 3)))
  (define terran-tank-target-p3
    (cond
      [(eq? effective-enemy-race 'Terran) 4]
      [(eq? effective-enemy-race 'Protoss) 3]
      [else 2]))
  (define-values (p3-fast-rush-override? p3-reaper-or-ling-swarm-override? _p3-t-reap _p3-t-ling)
    (l2-terran-early-fast-rush-status ctx))
  (define terran-priority-tank-p3?
    (and live-game?
         has-fac-tl?
         (memq 'factory ready-bldg-types)
         (> (hash-ref open-prod-slots 'factory 0) 0)
         (not enemy-capital-air?)
         (not p3-reaper-or-ling-swarm-override?)
         (or brain-sched-siege-tank-p3?
             tvt-need-tanks-p3?
             (and tvp-need-tanks-p3? (>= (l2-ctx-gas ctx) (sc2-gas-cost 'siege-tank))))))
  (define terran-hold-for-siege-tank-now?
    (and live-game?
         has-fac-tl?
         (memq 'factory ready-bldg-types)
         (> (hash-ref open-prod-slots 'factory 0) 0)
         (not enemy-capital-air?)
         (not p3-reaper-or-ling-swarm-override?)
         (not (l2-ctx-early-survival-crisis? ctx))
         (not (and under-base-attack? (< live-army-supply 4)))
         (>= total-workers 18)
         (>= (l2-ctx-gas ctx) (sc2-gas-cost 'siege-tank))
         (>= (l2-ctx-minerals ctx) 100)
         (< (l2-ctx-minerals ctx) (sc2-min-cost 'siege-tank))
         (or brain-sched-siege-tank-p3?
             (< cur-siege-tanks-p3 terran-tank-target-p3))))
  (define brain-saving-oc1-p3?
    (and live-game?
         (eq? (l2-ctx-prio-saving-for-sym ctx) 'orbital-command)
         (= (l2-cur-ally-canon-bldg-count ctx 'orbital-command) 0)
         (memq 'barracks ready-bldg-types)
         (not under-base-attack?)
         (not under-early-cheese?)
         (not (l2-ctx-early-survival-crisis? ctx))
         (<= live-enemy-threat-supply 2.0)))
  ;; W6-P0-3-rt: Brief (~2.5s) mineral escrow when gas >= 100 & minerals in [100..150) so
  ;; SCVs/Marines/Marauders never continuously drain minerals right before Factory #1 drops.
  (define terran-hold-for-factory1-now?
       (and (l2-terran-need-factory1-now? ctx)
            (>= (l2-ctx-minerals ctx) 100)
            (< (l2-ctx-minerals ctx) (+ (sc2-min-cost 'factory) (sc2-min-cost 'scv)))))
  (define terran-scv-priority?
       (and (or (not terran-saving-for-cc-expand?)
                (and (not terran-orbital-freezes-all-scvs?)
                     (not (not (member '(train scv) prio-scheduled-actions)))
                     (or (>= (length ccs) 2)
                         (< (l2-ctx-minerals ctx)
                            (if (and (l2-terran-1base-cc-intent? ctx)
                                     (>= total-workers 18))
                                150
                                225))))
                (and (not terran-orbital-freezes-all-scvs?) (< total-workers 17) (< (l2-ctx-minerals ctx) 225)))
            (not crisis-freeze-workers?)
            (l2-worker-army-curve-satisfied? ctx)
            (not terran-orbital-freezes-all-scvs?)
            (not (and terran-hold-for-factory1-now? (>= total-workers 18)))
            (not terran-hold-for-siege-tank-now?)
            (or (not urgent-combat-or-intel-need?)
                (not (l2-ctx-can-train-basic-combat-now? ctx))
                (and (< frame 3360) (< total-workers 18) (<= live-enemy-threat-supply 0) (not under-base-attack?))
                (and (not under-base-attack?)
                     (< live-enemy-threat-supply 6)
                     (>= (l2-ctx-minerals ctx) (+ (sc2-min-cost 'scv) (l2-ctx-basic-combat-min-floor ctx)))))
            (or (< total-workers terran-ideal-worker-cap)
                (l2-can-spend-by-priority? ctx 'scv 'worker))
            (< total-workers (min 66 (max target-workers terran-ideal-worker-cap)))
            (or (not live-game?)
                (not under-base-attack?)
                (< total-workers 20)
                (not (memq 'barracks ready-bldg-types))
                (>= live-army-supply (max 4.0 (* 1.15 live-enemy-threat-supply))))
            (>= (l2-ctx-minerals ctx)
                (+ (sc2-min-cost 'scv)
                   (if (and live-game?
                            (>= total-workers 18)
                            (or under-base-attack?
                                (> live-enemy-threat-supply live-army-supply)))
                       (let-values ([(cm _cg) (l2-scheduled-combat-reserve ctx 'scv)]) cm)
                       0)))
            (l2-can-spend-supply? ctx (sc2-supply-cost 'scv))
            (or (not (or brain-sched-siege-tank-p3?
                         (and terran-priority-tank-p3?
                              (>= total-workers 18)
                              (>= (l2-ctx-gas ctx) (sc2-gas-cost 'siege-tank)))))
                (>= (- (l2-ctx-minerals ctx) (sc2-min-cost 'scv)) (sc2-min-cost 'siege-tank)))
            (or (not brain-saving-oc1-p3?)
                (>= (- (l2-ctx-minerals ctx) (sc2-min-cost 'scv)) (sc2-min-cost 'orbital-command)))
            (let-values ([(fr-ov? _fr-rl? _fr-r _fr-l) (l2-terran-early-fast-rush-status ctx)])
              (or (not fr-ov?)
                  (< total-workers 16)
                  (>= (- (l2-ctx-minerals ctx) (sc2-min-cost 'scv))
                      (l2-terran-early-fast-rush-min-reserve ctx))))
            (not under-early-cheese?)))
  (when terran-scv-priority?
       (l2-try-train-unit! ctx 'scv 'townhall 4
                        #:respect-bo-reserve? (or brain-saving-oc1-p3?
                                                  (l2-worker-respect-bo-reserve? ctx))))
  (set-l2-ctx-brain-scheduled-workers-rem! ctx 0)
  ;; L19-P0-3 / L24-P0-3 / L30-P0-3 / L31-P0-3 (`#32`/`#08`/`#26` Natural CC Escrow Guard):
  ;; Fire whenever `'command-center` is `saving_for`, `bo-goal`, top-2 of `escrow_queue`, or scheduled,
  ;; and bank >= 150M (with >= 16 workers and >= 4 army or 0 threat; else >= 225M), holding non-emergency
  ;; Barracks/Factory/Marine spends so 1-base Terran climbs cleanly to 400M!
  (define terran-brain-saving-1base-cc?
    (and live-game?
         (= (length ccs) 1)
         terran-saving-for-cc-expand?
         (or (l2-terran-1base-cc-intent? ctx)
             (and (macro-brain-decision? (l2-ctx-macro-decision ctx))
                  (memq 'command-center
                        (macro-brain-decision-scheduled-ids (l2-ctx-macro-decision ctx)))))
         (>= (l2-ctx-minerals ctx)
             (if (and (l2-terran-1base-cc-intent? ctx)
                      (>= total-workers 16)
                      (or (>= live-army-supply 4) (<= live-enemy-threat-supply 0)))
                 150
                 225))
         (<= live-enemy-threat-supply (max 6.0 live-army-supply))
         (not (l2-ctx-worker-rush-active? ctx))
         (not under-early-cheese?)
         (not (l2-ctx-early-survival-crisis? ctx))
         (not (l2-ctx-bldg-actively-damaged? ctx))
         (or (not under-base-attack?)
             (<= live-enemy-threat-supply live-army-supply))))
  (define terran-expand-escrow-imminent?
       (or terran-brain-saving-1base-cc?
           (and live-game?
                (not crisis-tech-upgrade-deferral?)
                (not urgent-combat-or-intel-need?)
                (<= live-enemy-threat-supply 6.0)
                (or (and terran-saving-for-orbital?
                         (l2-imminent-escrow-needed? ctx (sc2-min-cost 'orbital-command) 0))
                    (and terran-saving-for-expand?
                         (l2-imminent-escrow-needed?
                          ctx
                          (max (l2-ctx-reserved-expansion-minerals ctx)
                               (sc2-min-cost 'command-center))
                          0))))))
  (define terran-prod-save-hold?
       (if live-game? terran-expand-escrow-imminent? terran-saving-for-expand?))
  (define terran-orbital-save-hold?
       (if live-game?
           (and terran-saving-for-orbital?
                (not crisis-tech-upgrade-deferral?)
                (not urgent-combat-or-intel-need?)
                (<= live-enemy-threat-supply 6.0)
                (l2-imminent-escrow-needed? ctx (sc2-min-cost 'orbital-command) 0))
           terran-saving-for-orbital?))
  (define terran-bo-escrow-imminent?
       (and live-game?
            (or (> (l2-ctx-bo-reserved-min ctx) 0)
                (> (l2-ctx-bo-reserved-gas ctx) 0))
            (<= live-enemy-threat-supply 6.0)
            (not urgent-combat-or-intel-need?)
            (l2-imminent-escrow-needed? ctx (l2-ctx-bo-reserved-min ctx) (l2-ctx-bo-reserved-gas ctx))))
  (define door-st-prod (rt-door-state rt))
  (define held-swap-donor-id
       (let ([did (hash-ref door-st-prod 'pending-swap-donor-id #f)]
             [since-f (hash-ref door-st-prod 'pending-swap-since -9999)])
         (and live-game?
              did
              (<= (- frame since-f) 224)
              (<= live-enemy-threat-supply 6.0)
              (>= frame SC2-TERRAN-FIRST-ADDON-SWAP-FRAME)
              did)))
  (when held-swap-donor-id
       (define dtype (hash-ref door-st-prod 'pending-swap-donor-type #f))
       (when (memq dtype '(barracks factory))
         (define cur-d-slots (hash-ref open-prod-slots dtype 0))
         (when (> cur-d-slots 0)
           (hash-set! open-prod-slots dtype (sub1 cur-d-slots)))))
  ;; W11-P0-2-rt / W12-P0-3-rt (`#14`/`#35`) / L19-P0-3: Allow Barracks #1 early Marines (< 8 army supply)
  ;; during expand escrow, yielding when Brain is saving for 1-base CC #2 at >= 250M (or >= 350M peaceful),
  ;; and ALWAYS bypass holds during active `early-survival-crisis?`!
  (define terran-early-marine-bypass?
    (and live-game?
         (< live-army-supply 8)
         (< (l2-unit-count ctx 'marine) 10)
         (memq 'barracks ready-bldg-types)
         (or (l2-ctx-early-survival-crisis? ctx)
             (and (not terran-brain-saving-1base-cc?)
                  (not (and (= (length ccs) 1)
                            (>= (l2-ctx-minerals ctx) 350)
                            (<= live-enemy-threat-supply 0)))))))
  ;; L29-P0-3 (`#52 DT:7`, `#54 Banshee:14`, `CloakLoss -> 0`): Train urgent `Raven #1` FIRST
  ;; before Barracks/Factory spend minerals/gas whenever a cloaked/burrowed threat is active with 0 Ravens!
  (define terran-raven-cloak-urgent?
    (and live-game?
         (= (l2-unit-count ctx 'raven) 0)
         (or (pair? (l2-shimmer-ripples ctx))
             (ormap (lambda (eb)
                      (and (hash? eb)
                           (memq (fast-canonical-structure-sym (unit-type-sym eb))
                                 '(dark-shrine lurker-den lurker-den-mp))))
                    (or (l2-ctx-enemy-bldgs ctx) '()))
             (ormap (lambda (e)
                      (and (hash? e)
                           (not (memq (fast-canonical-unit-sym (unit-type-sym e))
                                      '(creep-tumor creep-tumor-burrowed creep-tumor-queen)))
                           (or (eq? (hash-ref e 'cloaked #f) #t)
                               (memq (hash-ref e 'cloak 0) '(1 2 cloaked cloaked-detected))
                               (= (hash-ref e 'display-type 1) 3)
                               (eq? (hash-ref e 'burrowed #f) #t)
                               (memq (fast-canonical-unit-sym (unit-type-sym e))
                                     '(dark-templar banshee ghost lurker-burrowed lurker-mp-burrowed)))))
                    enemy-units))))
  (when (and terran-raven-cloak-urgent?
             (memq 'starport ready-bldg-types)
             (memq 'starport-techlab ready-bldg-types)
             (l2-can-spend-supply? ctx (sc2-supply-cost 'raven)))
    (l2-try-train-unit! ctx 'raven 'starport 6 #:respect-bo-reserve? #f))
  (define terran-tank-bypass-save-hold?
    (or brain-sched-siege-tank-p3?
        (and (not terran-brain-saving-1base-cc?)
             (or tvt-need-tanks-p3?
                 (and tvp-need-tanks-p3? (>= (l2-ctx-gas ctx) (sc2-gas-cost 'siege-tank)))))))
  (when (and (or (not terran-prod-save-hold?)
                    terran-tank-bypass-save-hold?
                    terran-early-marine-bypass?
                    p3-fast-rush-override?
                    (l2-ctx-early-survival-crisis? ctx)
                    (and crisis-tech-upgrade-deferral?
                         (not (and terran-brain-saving-1base-cc?
                                   (<= live-enemy-threat-supply live-army-supply))))
                    enemy-capital-air?
                    (and endgame-corner-hunt? (< (l2-unit-count ctx 'viking) 2)))
                (or crisis-tech-upgrade-deferral?
                    terran-tank-bypass-save-hold?
                    p3-fast-rush-override?
                    (l2-ctx-early-survival-crisis? ctx)
                    (and (not terran-orbital-save-hold?) (not brain-saving-oc1-p3?))
                    (>= (- (l2-ctx-minerals ctx) (sc2-min-cost 'marine)) (sc2-min-cost 'orbital-command)))
                (l2-can-spend-supply? ctx (sc2-supply-cost 'marine)))
       ;; L37-P0-2 (`#17/#11/#62/#68/#32` `TvT0Tank 4->0` & `TvP 0-7-1`) + L53-W2-1 + L56-W2-3:
       ;; Train priority `siege-tank` FIRST (preserving fast Tank #1/#2), EXCEPT in non-TvT once
       ;; `SiegeTank >= 2` and `Starport` is ready & idle with `0` Medivacs (+ >= 4 Bio, no
       ;; urgent AA/Colossus priority), yield 100M/100G so `Medivac #1` trains ahead of Tank #3+!
       ;; (`TvT` never lets Medivacs jump ahead of Viking #1–#2 / Siege Tank #3+!)
       (define yield-tank3-for-medivac1?
         (and live-game?
              (not (eq? effective-enemy-race 'Terran))
              (>= cur-siege-tanks-p3 2)
              (= (l2-unit-count ctx 'medivac) 0)
              (memq 'starport ready-bldg-types)
              (> (hash-ref open-prod-slots 'starport 0) 0)
              (not enemy-capital-air?)
              (or (not (enemy-tech-observation-requires-anti-air? tech-obs))
                  (>= (l2-unit-count ctx 'viking) 2))
              (>= (+ (l2-unit-count ctx 'marine) (l2-unit-count ctx 'marauder)) 4)
              (l2-can-spend-supply? ctx (sc2-supply-cost 'medivac))
              (or (< (l2-ctx-minerals ctx) (+ (sc2-min-cost 'siege-tank) (sc2-min-cost 'medivac)))
                  (< (l2-ctx-gas ctx) (+ (sc2-gas-cost 'siege-tank) (sc2-gas-cost 'medivac))))))
       (when (and terran-priority-tank-p3?
                  (not yield-tank3-for-medivac1?)
                  (or (not terran-prod-save-hold?)
                      terran-tank-bypass-save-hold?
                      terran-cannon-breakout-mode?
                      crisis-tech-upgrade-deferral?)
                  (>= (l2-ctx-minerals ctx) (sc2-min-cost 'siege-tank))
                  (>= (l2-ctx-gas ctx) (sc2-gas-cost 'siege-tank))
                  (l2-can-spend-supply? ctx (sc2-supply-cost 'siege-tank)))
         (l2-try-train-unit! ctx 'siege-tank 'factory 6 #:respect-bo-reserve? #f))
       ;; L35-P0-3 (`#41` Zerglings, `#53` Reapers): Pre-5:00 early-rush Hellion/Marine override!
       ;; Immediately pump Hellions from bare/Reactor Factories (or TechLab Factory vs >= 3 Reapers
       ;; / >= 12 Zerglings or < 125G) + Marines from Barracks without waiting for FactoryTechLab,
       ;; Starport, SiegeTank, or OrbitalCommand escrow until >= 4 Hellions or >= 10 Marines!
       (when p3-fast-rush-override?
         ;; L52 (`#77 TvT VeTerran`): Never let fast-rush Hellion occupy a Tech-Lab Factory
         ;; while `siege-tank < 4` in TvT (unless facing >= 3 Reapers / Ling swarm), nor a bare
         ;; Factory #1 waiting on `FactoryTechLab` in TvT!
         (when (and (memq 'factory ready-bldg-types)
                    (< (+ (l2-unit-count ctx 'hellion) (l2-unit-count ctx 'hellbat)) 4)
                    (not (and (eq? effective-enemy-race 'Terran)
                              (not p3-reaper-or-ling-swarm-override?)
                              (< (l2-unit-count ctx 'siege-tank) 4)
                              (or has-fac-tl?
                                  (and (not (l2-building-present-or-pending? ctx 'factory-techlab #t))
                                       (let ([bf (l2-grounded-bare-facility ctx 'factory 'factory-techlab)])
                                         (and bf (not (l2-addon-pad-blocked? ctx bf))))))))
                    (or (not has-fac-tl?)
                        p3-reaper-or-ling-swarm-override?
                        (< (l2-ctx-gas ctx) (sc2-gas-cost 'siege-tank)))
                    (l2-can-spend-supply? ctx (sc2-supply-cost 'hellion)))
           (l2-try-train-unit! ctx 'hellion 'factory 6 #:respect-bo-reserve? #f))
         (when (and (memq 'barracks ready-bldg-types)
                    (not terran-hold-for-siege-tank-now?)
                    (< (l2-unit-count ctx 'marine) 10)
                    (l2-can-spend-supply? ctx (sc2-supply-cost 'marine)))
           (l2-try-train-unit! ctx 'marine 'barracks 5 #:respect-bo-reserve? #f)))
       ;; L32-P0-3 (`#20` 168 Banshees `AirAAStarve` -> continuous Vikings) + L34-P0-3 (`#02` TvT):
       ;; Detect air-dominated enemy compositions (`>= 4` combat air & `>= enemy ground combat`),
       ;; while capping TvT Viking scaling (`<= 8`) when enemy fields a grounded Tank+Bio core
       ;; (`>= 4` Siege Tanks & `>= 4` ground Bio, no capital air) so Tanks never get starved!
       (define-values (p3-enemy-air-cnt p3-enemy-gnd-cnt p3-enemy-tank-cnt p3-enemy-bio-cnt p3-vis-colossus-cnt)
         (for/fold ([ac 0] [gc 0] [tc 0] [bc 0] [cc 0]) ([e (in-list enemy-units)] #:when (and (hash? e) (combat-unit-record? e)))
           (define cu (fast-canonical-unit-sym (unit-type-sym e)))
           (if (memq cu '(banshee phoenix mutalisk oracle void-ray voidray
                          liberator liberator-ag viking viking-fighter corruptor
                          battlecruiser carrier tempest brood-lord broodlord mothership))
               (values (add1 ac) gc tc bc cc)
               (values ac
                       (add1 gc)
                       (if (memq cu '(siege-tank siege-tank-sieged)) (add1 tc) tc)
                       (if (memq cu '(marine marauder)) (add1 bc) bc)
                       (if (eq? cu 'colossus) (add1 cc) cc)))))
       ;; L36-P0-3 (`#5138231` TvP 0 Vikings vs 3 Colossi): Detect visible or OWM-remembered
       ;; enemy Colossi / Robotics Bay and lock `>= 3` Vikings per Colossus (min 3, cap 16)
       ;; BEFORE Medivacs/Tanks drain Starport slots or gas!
       (define p3-owm-sum-t (and rt (opponent-world-model-last-summary (rt-opponent-world-model rt))))
       (define p3-owm-kc-t (and p3-owm-sum-t (opponent-world-summary-known-unit-counts p3-owm-sum-t)))
       (define p3-owm-bc-t (and p3-owm-sum-t (opponent-world-summary-known-bldg-counts p3-owm-sum-t)))
       (define p3-enemy-colossus-cnt
         (max p3-vis-colossus-cnt
              (if (hash? p3-owm-kc-t) (hash-ref p3-owm-kc-t 'colossus 0) 0)))
       (define p3-enemy-robo-bay?
         (or (ormap (lambda (eb)
                      (and (hash? eb)
                           (eq? (fast-canonical-structure-sym (unit-type-sym eb)) 'robotics-bay)))
                    (or (l2-ctx-enemy-bldgs ctx) '()))
             (and (hash? p3-owm-bc-t)
                  (> (+ (hash-ref p3-owm-bc-t 'robotics-bay 0)
                        (hash-ref p3-owm-bc-t 'robotics-support-bay 0))
                     0))))
       (define tvp-colossus-viking-target
         (if (or (> p3-enemy-colossus-cnt 0) p3-enemy-robo-bay?)
             (min 16 (max 3 (* 3 (max 1 p3-enemy-colossus-cnt))))
             0))
       (define p3-tvt-enemy-tank-ground-core?
         (and (eq? effective-enemy-race 'Terran)
              (not enemy-capital-air?)
              (>= p3-enemy-tank-cnt 4)
              (>= p3-enemy-bio-cnt 4)))
       (define enemy-air-dominated-p3?
         (and (not p3-tvt-enemy-tank-ground-core?)
              (>= p3-enemy-air-cnt 4)
              (>= p3-enemy-air-cnt p3-enemy-gnd-cnt)))
       (define desired-viking-cap
         (max tvp-colossus-viking-target
              (cond
                [enemy-capital-air? 24]
                [p3-tvt-enemy-tank-ground-core? 8]
                [enemy-air-dominated-p3? 20]
                [(or (enemy-tech-observation-requires-anti-air? tech-obs) endgame-corner-hunt?) 12]
                [else 10])))
       (define-values (enemy-stalker-cnt-thor enemy-heavy-cap-air?)
         (if (and has-fac-tl?
                  (memq 'factory ready-bldg-types)
                  (memq 'armory ready-bldg-types)
                  (or (not terran-prod-save-hold?)
                      enemy-capital-air?
                      terran-cannon-breakout-mode?
                      crisis-tech-upgrade-deferral?))
             (let loop ([rem enemy-units] [st 0] [hc? #f])
               (cond
                 [(or (null? rem) (and hc? (>= st 6))) (values st hc?)]
                 [else
                  (define cu (fast-canonical-unit-sym (unit-type-sym (car rem))))
                  (loop (cdr rem)
                        (if (and (< st 6) (eq? cu 'stalker)) (add1 st) st)
                        (or hc? (and (memq cu '(battlecruiser carrier mothership brood-lord broodlord)) #t)))]))
             (values 0 #f)))
       (define live-thor-cap
         (cond
           [(or (>= enemy-stalker-cnt-thor 6) enemy-heavy-cap-air?) 6]
           [enemy-capital-air? 5]
           [else 4]))
       ;; Priority corner-hunter air-to-air: ensure >= 2 Vikings before Medivacs/tanks consume Starport/gas!
       (when (and endgame-corner-hunt?
                  (memq 'starport ready-bldg-types)
                  (< (l2-unit-count ctx 'viking) 2))
         (l2-try-train-unit! ctx 'viking 'starport 6 #:respect-bo-reserve? #f))
       ;; Priority vs-Air & Anti-Colossus Vikings (`#5138231`): ensure >= 2 Vikings vs Air AND
       ;; >= 3 Vikings per observed Colossus (or Robotics Bay) BEFORE Medivacs/Tanks consume gas!
       ;; L49-W2 (`#02 TvT`): In the non-Colossus `requires-anti-air?` branch, yield gas to ready
       ;; `FactoryTechLab` Siege Tank #1..#3 (`125G`) when no enemy Capital Air exists!
       (when (and live-game?
                  (not endgame-corner-hunt?)
                  (or (not terran-prod-save-hold?) crisis-tech-upgrade-deferral? (> tvp-colossus-viking-target 0))
                  (memq 'starport ready-bldg-types)
                  (or (and (> tvp-colossus-viking-target 0)
                           (< (l2-unit-count ctx 'viking) tvp-colossus-viking-target))
                      (and (enemy-tech-observation-requires-anti-air? tech-obs)
                           (< (l2-unit-count ctx 'viking) 2)
                           (or (not (and has-fac-tl?
                                         (> (hash-ref open-prod-slots 'factory 0) 0)
                                         (not enemy-capital-air?)
                                         (or brain-sched-siege-tank-p3?
                                             (and tvt-need-tanks-p3? (< cur-siege-tanks-p3 3)))))
                               (>= (- (l2-ctx-gas ctx) (sc2-gas-cost 'viking))
                                   (sc2-gas-cost 'siege-tank))))))
         (l2-try-train-unit! ctx 'viking 'starport 6 #:respect-bo-reserve? #f))
       ;; Facing Capital Air: start ready Factory-TL Thor before uncapped Reactor Starport Vikings drain minerals!
       (when (and enemy-capital-air?
                  has-fac-tl?
                  (memq 'factory ready-bldg-types)
                  (memq 'armory ready-bldg-types)
                  (< (l2-unit-count ctx 'thor) live-thor-cap))
         (l2-try-train-unit! ctx 'thor 'factory 6 #:respect-bo-reserve? #f))
       ;; Facing Capital Air with Starport-TL ready: queue 1 Raven (Interference Matrix / detection) before Vikings fill all Starport slots!
       (when (and enemy-capital-air?
                  (memq 'starport ready-bldg-types)
                  (memq 'starport-techlab ready-bldg-types)
                  (< (l2-unit-count ctx 'raven) 2))
         (l2-try-train-unit! ctx 'raven 'starport 6 #:respect-bo-reserve? #f))
       ;; L59 (`#74 who` TvT vs 8 Cloaked Banshees): Immediately train Raven (with Starport-TL)
       ;; and Vikings from ready Starport whenever live or OWM Banshees are active!
       (define p3-banshee-cnt
         (max (count (lambda (e)
                       (and (hash? e) (eq? (fast-canonical-unit-sym (unit-type-sym e)) 'banshee)))
                     enemy-units)
              (let* ([owm-s (and rt (opponent-world-model-last-summary (rt-opponent-world-model rt)))]
                     [owm-k (and owm-s (opponent-world-summary-known-unit-counts owm-s))])
                (if (hash? owm-k) (hash-ref owm-k 'banshee 0) 0))))
       (when (and (> p3-banshee-cnt 0)
                  (memq 'starport ready-bldg-types)
                  (memq 'starport-techlab ready-bldg-types)
                  (< (l2-unit-count ctx 'raven) 1))
         (l2-try-train-unit! ctx 'raven 'starport 6 #:respect-bo-reserve? #f))
       (when (and (> p3-banshee-cnt 0)
                  (memq 'starport ready-bldg-types)
                  (< (l2-unit-count ctx 'viking) (min desired-viking-cap (max 4 (+ p3-banshee-cnt 2)))))
         (l2-try-train-unit! ctx 'viking 'starport 6 #:respect-bo-reserve? #f))
       ;; Priority Capital Air / Air-Dominated Vikings (up to 20–24) BEFORE Medivacs/Tanks consume Starport slots or gas!
       (when (and (memq 'starport ready-bldg-types)
                  (or enemy-capital-air? enemy-air-dominated-p3?)
                  (< (l2-unit-count ctx 'viking) desired-viking-cap))
         (l2-try-train-unit! ctx 'viking 'starport 6 #:respect-bo-reserve? #f))
       ;; Priority bio sustain (#5122349) + Loop 64 B2 (Graph 18 Proportional Medivac Cap):
       ;; Cap Medivacs proportionally to Bio supply (`<= floor(bio_sup / 5)`, max `6`,
       ;; never `#3+` unless `bio_sup >= 14`) across ALL Starport Medivac train paths!
       (define priority-medivac1-after-tanks?
         (and (not (eq? effective-enemy-race 'Terran))
              (>= cur-siege-tanks-p3 2)
              (= (l2-unit-count ctx 'medivac) 0)
              (not terran-brain-saving-1base-cc?)))
       (define terran-bio-sup-p3
         (+ (l2-unit-count ctx 'marine)
            (* 2 (l2-unit-count ctx 'marauder))
            (* 2 (l2-unit-count ctx 'ghost))
            (l2-unit-count ctx 'reaper)))
       (define prop-medivac-cap-p3
         (let* ([raw-prop (max (if (or (>= terran-bio-sup-p3 6) priority-medivac1-after-tanks?) 1 0)
                               (quotient terran-bio-sup-p3 5))]
                [gated (if (< terran-bio-sup-p3 14) (min 2 raw-prop) raw-prop)])
           (min 6 gated)))
       (when (and live-game?
                  (or (not crisis-tech-upgrade-deferral?) priority-medivac1-after-tanks?)
                  (or (not terran-prod-save-hold?) priority-medivac1-after-tanks?)
                  (memq 'starport ready-bldg-types)
                  (or (not (and (> (hash-ref open-prod-slots 'factory 0) 0)
                                (or (and brain-sched-siege-tank-p3?
                                         (not (and (not (eq? effective-enemy-race 'Terran))
                                                   (>= cur-siege-tanks-p3 2)
                                                   (= (l2-unit-count ctx 'medivac) 0))))
                                    (and tvt-need-tanks-p3? (< cur-siege-tanks-p3 2)))))
                      (and (>= (- (l2-ctx-minerals ctx) (sc2-min-cost 'medivac)) (sc2-min-cost 'siege-tank))
                           (>= (- (l2-ctx-gas ctx) (sc2-gas-cost 'medivac)) (sc2-gas-cost 'siege-tank))))
                  (or (not enemy-capital-air?) (>= (l2-unit-count ctx 'viking) 8))
                  (or (not enemy-air-dominated-p3?)
                      (>= (l2-unit-count ctx 'viking) (max 6 (+ 2 p3-enemy-air-cnt))))
                  (or (= tvp-colossus-viking-target 0)
                      (>= (l2-unit-count ctx 'viking) (min 6 tvp-colossus-viking-target)))
                  (or (not (enemy-tech-observation-requires-anti-air? tech-obs))
                      (>= (l2-unit-count ctx 'viking) 2))
                  (>= (+ (l2-unit-count ctx 'marine) (l2-unit-count ctx 'marauder))
                      (if (and (not (eq? effective-enemy-race 'Terran))
                               (>= cur-siege-tanks-p3 2)
                               (= (l2-unit-count ctx 'medivac) 0))
                          4
                          6))
                  (< (l2-unit-count ctx 'medivac) (min (if enemy-capital-air? 1 2) prop-medivac-cap-p3))
                  (l2-can-spend-supply? ctx (sc2-supply-cost 'medivac)))
         (l2-try-train-unit! ctx 'medivac 'starport 6 #:respect-bo-reserve? #f))
       ;; Factory production first (Group 6): Siege Tank / Thor on Factory-TechLab
       (when (and (or (not terran-prod-save-hold?)
                      brain-sched-siege-tank-p3?
                      (and tvt-need-tanks-p3? has-fac-tl? (not terran-brain-saving-1base-cc?))
                      (and tvp-need-tanks-p3? has-fac-tl? (not terran-brain-saving-1base-cc?)
                           (>= (l2-ctx-gas ctx) (sc2-gas-cost 'siege-tank)))
                      terran-cannon-breakout-mode?
                      crisis-tech-upgrade-deferral?
                      enemy-capital-air?)
                  (memq 'factory ready-bldg-types))
         (when (and has-fac-tl?
                    (memq 'armory ready-bldg-types)
                    (or enemy-capital-air?
                        (l2-starport-escrow-ok? ctx (sc2-min-cost 'thor) (sc2-gas-cost 'thor)))
                    (or (and enemy-capital-air?
                             (< (l2-unit-count ctx 'thor) live-thor-cap)
                             (>= (l2-ctx-minerals ctx) (sc2-min-cost 'thor))
                             (>= (l2-ctx-gas ctx) (sc2-gas-cost 'thor)))
                        (and (or (enemy-tech-observation-requires-anti-air? tech-obs)
                                 (and (not crisis-tech-upgrade-deferral?)
                                      (>= (l2-unit-count ctx 'siege-tank) 4)))
                             (< (l2-unit-count ctx 'thor) 4)
                             (>= (l2-ctx-minerals ctx) (sc2-min-cost 'thor))
                             (>= (l2-ctx-gas ctx) (sc2-gas-cost 'thor)))
                        (l2-plan-wants-now? ctx 'thor))
                    (or enemy-capital-air?
                        (not terran-bo-escrow-imminent?)
                        (l2-can-spend-by-priority? ctx 'thor 'combat-unit)))
           (l2-try-train-unit! ctx 'thor 'factory 6 #:respect-bo-reserve? (and (not enemy-capital-air?) terran-bo-escrow-imminent?)))
         ;; W9-P0-1-rt / W11-P0-2-rt / L36-P0-3 (`#5138233` TvP 14 Widow Mines): Count pending
         ;; Widow Mines and strictly cap TvP Widow Mines `<= 2` early (`< 5:30` / `< 2` CCs)
         ;; and `<= 3` midgame so bare Factories never spam 14 Mines while starving Starport/Bio!
         (define cur-widow-mines
           (+ (l2-unit-count ctx 'widow-mine)
              (order-ledger-pending-count-for-type oledger 'widow-mine frame)))
         (define cur-siege-tanks (l2-unit-count ctx 'siege-tank))
         (define cur-factory-cnt (l2-cur-ally-canon-bldg-count ctx 'factory))
         (define tvt-need-tanks?
           (and (eq? effective-enemy-race 'Terran) (< cur-siege-tanks 4)))
         (define max-widow-mine-cap
           (cond
             [tvt-need-tanks? 1]
             [(eq? effective-enemy-race 'Protoss)
              (if (or (< frame 7392) (< (length ccs) 2)) 2 3)]
             [else 4]))
         ;; L24-P0-3 (`#47/#17/#41` `TvT0Tank`): Always hold TechLab Factory for Siege Tanks
         ;; even at 0..49G while `< 4` Tanks in TvT (`< 3` non-TvT) so 25G Widow Mines and
         ;; 100M Hellions can NEVER infinite-drain gas/slots ahead of Siege Tanks!
         (define hold-fac-tl-for-tank?
           (and live-game?
                has-fac-tl?
                (not enemy-capital-air?)
                (not p3-reaper-or-ling-swarm-override?)
                (or (< cur-siege-tanks (if (eq? effective-enemy-race 'Terran) 4 3))
                    (and (< cur-siege-tanks 6)
                         (>= (l2-ctx-gas ctx) 50)))))
         ;; W18-P0-3-rt / L20-P0-3 / L52 (`#17/#32/#77 TvT` `TvT0Tank`):
         ;; Never let bare-Factory WidowMine/Hellion clog Factory #1 in TvT (even `< 22` workers!)
         ;; or non-TvT once `total-workers >= 22` while `factory-techlab` is missing!
         (define hold-bare-fac-for-techlab?
           (and live-game?
                (not p3-reaper-or-ling-swarm-override?)
                (or (eq? effective-enemy-race 'Terran) (not p3-fast-rush-override?))
                (not has-fac-tl?)
                (not (l2-building-present-or-pending? ctx 'factory-techlab #t))
                (let ([bf (l2-grounded-bare-facility ctx 'factory 'factory-techlab)])
                  (and bf (not (l2-addon-pad-blocked? ctx bf))))
                (or (eq? effective-enemy-race 'Terran)
                    (>= total-workers 22)
                    (and (>= (l2-ctx-gas ctx) (sc2-gas-cost 'factory-techlab))
                         (< (l2-ctx-minerals ctx) 125)
                         (>= live-army-supply 4)
                         (or (eq? (l2-ctx-prio-saving-for-sym ctx) 'factory-techlab)
                             (member '(build factory-techlab) (l2-ctx-prio-scheduled-actions ctx)))))))
         (if has-fac-tl?
             (when (and (or (not enemy-capital-air?)
                            (>= (l2-unit-count ctx 'viking) 12)
                            (>= (l2-ctx-gas ctx) 250))
                        ;; L28-P0-3 / L37-P0-2 (`#17` TvT0Tank & TvP): Bypass Starport escrow whenever
                        ;; Brain scheduled `siege-tank`, `tvt-need-tanks?`, or `tvp-need-tanks-p3?`!
                        (or terran-cannon-breakout-mode?
                            crisis-tech-upgrade-deferral?
                            brain-sched-siege-tank-p3?
                            tvt-need-tanks?
                            tvp-need-tanks-p3?
                            (l2-starport-escrow-ok? ctx (sc2-min-cost 'siege-tank) (sc2-gas-cost 'siege-tank))))
               (l2-try-train-unit! ctx 'siege-tank 'factory 6 #:respect-bo-reserve? #f))
             (when (and (not hold-bare-fac-for-techlab?)
                        (or (not live-game?) (< cur-widow-mines max-widow-mine-cap))
                        (or crisis-tech-upgrade-deferral?
                            (l2-starport-escrow-ok? ctx (sc2-min-cost 'widow-mine) (sc2-gas-cost 'widow-mine))))
               (l2-try-train-unit! ctx 'widow-mine 'factory 6)))
         (when (and (not hold-fac-tl-for-tank?)
                    (not hold-bare-fac-for-techlab?)
                    (or crisis-tech-upgrade-deferral?
                        (l2-starport-escrow-ok? ctx (sc2-min-cost 'hellion) (sc2-gas-cost 'hellion)))
                    (if live-game?
                        (and (or (not has-fac-tl?) (< (l2-ctx-gas ctx) (sc2-gas-cost 'siege-tank)))
                             (or (< (l2-unit-count ctx 'hellion) 4)
                                 (> (hash-ref open-prod-slots 'factory 0) 0)))
                        (or (< (l2-ctx-gas ctx) (sc2-gas-cost 'siege-tank))
                            (>= (l2-ctx-minerals ctx) (+ (sc2-min-cost 'siege-tank) (* 2 (sc2-min-cost 'marine)))))))
           (l2-try-train-unit! ctx 'hellion 'factory 6 #:respect-bo-reserve? (and live-game? terran-bo-escrow-imminent?)))
         ;; Continuous Factory idle-slot fill when not waiting on an imminent (< 3s) priority escrow
         (when (and live-game?
                    (> (hash-ref open-prod-slots 'factory 0) 0)
                    (not terran-prod-save-hold?)
                    (not terran-bo-escrow-imminent?))
           (when (and has-fac-tl?
                      (or (not enemy-capital-air?) (>= (l2-ctx-gas ctx) 250))
                      (or brain-sched-siege-tank-p3?
                          tvt-need-tanks?
                          (l2-starport-escrow-ok? ctx (sc2-min-cost 'siege-tank) (sc2-gas-cost 'siege-tank))))
             (l2-try-train-unit! ctx 'siege-tank 'factory 6 #:respect-bo-reserve? #f))
           (when (and (< cur-widow-mines max-widow-mine-cap)
                      (not hold-fac-tl-for-tank?)
                      (not hold-bare-fac-for-techlab?)
                      (not (and has-fac-tl? (<= cur-factory-cnt 1)))
                      (not (and has-fac-tl? tvt-need-tanks?))
                      (l2-starport-escrow-ok? ctx (sc2-min-cost 'widow-mine) (sc2-gas-cost 'widow-mine)))
             (l2-try-train-unit! ctx 'widow-mine 'factory 6 #:respect-bo-reserve? #f))
           (when (and (not hold-fac-tl-for-tank?)
                      (not hold-bare-fac-for-techlab?)
                      (> (hash-ref open-prod-slots 'factory 0) 0)
                      (l2-starport-escrow-ok? ctx (sc2-min-cost 'hellion) 0))
             (l2-try-train-unit! ctx 'hellion 'factory 6 #:respect-bo-reserve? #f))))
       ;; Starport production (Group 6): Battlecruiser -> Raven -> Vikings (up to 24 vs capital air) -> Medivac -> Liberator
       (when (and (or (not terran-prod-save-hold?) enemy-capital-air?)
                  (memq 'starport ready-bldg-types))
         (when (and (memq 'fusion-core ready-bldg-types)
                    (memq 'starport-techlab ready-bldg-types)
                    (< (l2-unit-count ctx 'battlecruiser) 4)
                    (or (l2-plan-wants-now? ctx 'battlecruiser)
                        (and (>= (l2-ctx-minerals ctx) 450) (>= (l2-ctx-gas ctx) 350)))
                    (l2-can-spend-supply? ctx (sc2-supply-cost 'battlecruiser)))
           (l2-try-train-unit! ctx 'battlecruiser 'starport 6 #:respect-bo-reserve? (if live-game? terran-bo-escrow-imminent? #t)))
         (when (and (memq 'starport-techlab ready-bldg-types)
                    (< (l2-unit-count ctx 'raven)
                       (if (or enemy-capital-air? terran-raven-cloak-urgent? (enemy-tech-observation-requires-detection? tech-obs)) 2 1))
                    (or enemy-capital-air?
                        terran-raven-cloak-urgent?
                        (enemy-tech-observation-requires-detection? tech-obs)
                        endgame-corner-hunt?
                        (l2-plan-wants-now? ctx 'raven)
                        (and live-game? (>= live-army-supply 30))))
           (l2-try-train-unit! ctx 'raven 'starport 6
                               #:respect-bo-reserve? (and (not enemy-capital-air?)
                                                          (not terran-raven-cloak-urgent?)
                                                          (if live-game? terran-bo-escrow-imminent? #t))))
         ;; L49-W2 + L50-W1 (`#1174` / `#1201` `#02 TvT` & `#50 TvP` Starport Gas Yield):
         ;; Require an OPEN Factory slot (`open-prod-slots 'factory > 0`) so busy FactoryTechLabs
         ;; never hold `125G` idle for `32s` starving Medivacs, AND exempt the first `2` Medivacs
         ;; when `(not tvt-need-tanks-p3?)`!
         (define sp-yield-gas-for-tank?
           (and live-game?
                has-fac-tl?
                (> (hash-ref open-prod-slots 'factory 0) 0)
                (not enemy-capital-air?)
                (or brain-sched-siege-tank-p3?
                    (and tvt-need-tanks-p3? (< cur-siege-tanks-p3 3)))))
         (define (sp-tank-gas-ok? unit-sym)
           (or (not sp-yield-gas-for-tank?)
               (and (eq? unit-sym 'medivac)
                    (or (and (not tvt-need-tanks-p3?) (< (l2-unit-count ctx 'medivac) 2))
                        (and (not (eq? effective-enemy-race 'Terran))
                             (>= cur-siege-tanks-p3 2)
                             (= (l2-unit-count ctx 'medivac) 0))))
               (>= (- (l2-ctx-gas ctx) (sc2-gas-cost unit-sym))
                   (sc2-gas-cost 'siege-tank))))
         (when (and live-game?
                    (or enemy-capital-air? (enemy-tech-observation-requires-anti-air? tech-obs))
                    (sp-tank-gas-ok? 'viking)
                    (< (l2-unit-count ctx 'viking) (if enemy-capital-air? desired-viking-cap 2)))
           (l2-try-train-unit! ctx 'viking 'starport 6 #:respect-bo-reserve? #f))
         (define base-medivac-cap
           (cond
             [enemy-capital-air? 2]
             [(enemy-tech-observation-requires-anti-air? tech-obs)
              (if (>= (l2-unit-count ctx 'viking) 8) 4 2)]
             [(or (>= (length ccs) 4) (>= eff-phase-supply 130)) 6]
             [else 4]))
         (define desired-medivac-cap
           (min base-medivac-cap prop-medivac-cap-p3))
         (when (and (or (not enemy-capital-air?) (>= (l2-unit-count ctx 'viking) 12))
                    (or (not live-game?)
                        (not (enemy-tech-observation-requires-anti-air? tech-obs))
                        (>= (l2-unit-count ctx 'viking) 2))
                    (sp-tank-gas-ok? 'medivac)
                    (or (not live-game?)
                        (and (< (l2-unit-count ctx 'medivac) desired-medivac-cap)
                             (or (< (l2-unit-count ctx 'medivac)
                                    (min desired-medivac-cap
                                         (if (enemy-tech-observation-requires-anti-air? tech-obs) 2 4)))
                                 (not terran-bo-escrow-imminent?)
                                 (l2-can-spend-by-priority? ctx 'medivac 'combat-unit)))))
           (l2-try-train-unit! ctx 'medivac 'starport 6 #:respect-bo-reserve? (if live-game? terran-bo-escrow-imminent? #t)))
         (when (and live-game?
                    (or enemy-capital-air? (enemy-tech-observation-requires-anti-air? tech-obs))
                    (sp-tank-gas-ok? 'viking)
                    (< (l2-unit-count ctx 'viking) (if enemy-capital-air? desired-viking-cap 8)))
           (l2-try-train-unit! ctx 'viking 'starport 6 #:respect-bo-reserve? #f))
         (define enemy-ground-siege-for-lib?
           (ormap (lambda (e)
                    (memq (unit-type-sym e)
                          '(siege-tank siege-tank-sieged lurker lurker-burrowed ultralisk)))
                  enemy-units))
         (define desired-liberator-cap
           (cond
             [(>= (length ccs) 4) 8]
             [enemy-ground-siege-for-lib? 6]
             [else 4]))
         (when (and (sp-tank-gas-ok? 'viking)
                    (or (not live-game?)
                        (and (or enemy-capital-air? (enemy-tech-observation-requires-anti-air? tech-obs))
                             (< (l2-unit-count ctx 'viking) desired-viking-cap))
                        (and endgame-corner-hunt?
                             (< (l2-unit-count ctx 'viking) 10))
                        (and (< (l2-unit-count ctx 'viking) desired-viking-cap)
                             (>= (l2-unit-count ctx 'medivac) 2)
                             (or (l2-plan-wants-now? ctx 'viking)
                                 (not terran-bo-escrow-imminent?)
                                 (>= (l2-unit-count ctx 'liberator) desired-liberator-cap))
                             (or (not terran-bo-escrow-imminent?)
                                 (l2-can-spend-by-priority? ctx 'viking 'combat-unit)))))
           (l2-try-train-unit! ctx 'viking 'starport 6 #:respect-bo-reserve? (and (not enemy-capital-air?) (if live-game? terran-bo-escrow-imminent? #t))))
         (when (and (< (l2-unit-count ctx 'liberator) desired-liberator-cap)
                    (sp-tank-gas-ok? 'liberator)
                    (or (l2-plan-wants-now? ctx 'liberator)
                        (and live-game?
                             (>= eff-phase-supply 80)
                             (>= (l2-unit-count ctx 'medivac) (if enemy-ground-siege-for-lib? 1 2))))
                    (or (not terran-bo-escrow-imminent?)
