                         (and (not (worker-has-engine-build-order? w))
                              (not (order-ledger-unit-has-active-build? oledger-early wid w))))
                     (>= (hash-ref w 'hp SC2-DRONE-MAX-HP) SC2-HEALTHY-WORKER-PULL-MIN-HP)))
