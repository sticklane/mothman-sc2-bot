                 (<= live-defending-force-supply 2)))))
  (define under-base-attack?
    (or (eq? (hash-ref obs 'under-attack? #f) #t)
        (eq? (hash-ref obs 'under-attack #f) #t)
        worker-rush-active?
        in-base-proxy-detected?
        enemy-attacking-base-or-nat?
        (and (not live-obs-harvesters?)
             (> live-enemy-threat-supply 0)
             (> live-enemy-threat-supply (max 4 live-army-supply)))))
  (set-l2-ctx-under-base-attack?! ctx under-base-attack?)
  (define crisis-tech-upgrade-deferral?
    (and under-base-attack?
         (or (< live-army-supply (* 1.15 live-enemy-threat-supply))
             (< total-workers 30))))
  (set-l2-ctx-crisis-tech-upgrade-deferral?! ctx crisis-tech-upgrade-deferral?)
  (define owm-urgent-pad (and owm-sum (opponent-world-summary-urgent-scout-pad owm-sum)))
  (when (and (>= frame 448)
             (or (< intel-confidence 0.65)
                 (pair? owm-urgent-pad)
                 (zero? (modulo frame 672)))
             (or (not live-obs-harvesters?)
                 (refractory-allow-action?! cd-tracker 'live-periodic-scout frame 96)))
    (define recon-tx
      (if (pair? owm-urgent-pad)
          (car owm-urgent-pad)
          (case intel-priority-sector
            [(enemy-natural) enemy-exp-x]
            [(enemy-main)    enemy-x]
            [(enemy-third)   enemy-third-x]
            [else            corridor-mid-x])))
    (define recon-ty
      (if (pair? owm-urgent-pad)
          (cdr owm-urgent-pad)
          (case intel-priority-sector
            [(enemy-natural) enemy-exp-y]
            [(enemy-main)    enemy-y]
            [(enemy-third)   enemy-third-y]
            [else            corridor-mid-y])))
    ;; W3-TAC-8 / W8-TAC-4: Never steal frontline combat units or combat Sentries within
    ;; <= 16.0 tiles of visible enemy combat for recon/hallucination scouting.
    (define scout-enemy-combat-coords
      (for/list ([e (in-list (l2-ctx-enemy-units ctx))]
                 #:when (and (hash? e)
                             (combat-unit-record? e)
                             (real? (hash-ref e 'x #f))
                             (real? (hash-ref e 'y #f))))
        (cons (exact->inexact (hash-ref e 'x 0.0))
              (exact->inexact (hash-ref e 'y 0.0)))))
    (define (spotter-near-frontline-enemy? u)
      (and (pair? scout-enemy-combat-coords)
           (let ([ux (hash-ref u 'x #f)]
                 [uy (hash-ref u 'y #f)])
             (and (real? ux) (real? uy)
                  (let ([fux (exact->inexact ux)]
                        [fuy (exact->inexact uy)])
                    (for/or ([ec (in-list scout-enemy-combat-coords)])
                      (define dx (fl- fux (car ec)))
                      (define dy (fl- fuy (cdr ec)))
                      (fl<= (fl+ (fl* dx dx) (fl* dy dy)) 256.0)))))))
    (case race
      [(Protoss)
       ;; L38-P0-1c + L41-P0-1c (`#5138254` / `#75 PvP` `CloakLoss 1->0`): NEVER send sole Observer #1
       ;; across the map via periodic-scout under cloaked/burrowed/WarpPrism-drop threat or base attack!
       ;; When >= 2 Observers exist, ALWAYS reserve the home-closest Observer #1 (`drop-right sorted-obs 1`)
       ;; so even if Observer #2 is busy at the front, Observer #1 NEVER abandons home Nexuses!
       (define ally-observers
         (filter (lambda (u)
                   (and (hash? u)
                        (memq (unit-type-sym u) '(observer observer-siege-mode))))
                 ally-units))
       (define protoss-obs-cloak-threat?
         (or (and tech-obs (enemy-tech-observation-requires-detection? tech-obs))
             (pair? (l2-shimmer-ripples ctx))
             (ormap (lambda (eb)
                      (and (hash? eb)
                           (memq (fast-canonical-structure-sym (unit-type-sym eb))
                                 '(dark-shrine lurker-den lurker-den-mp))))
                    (or (l2-ctx-enemy-bldgs ctx) '()))
             (ormap (lambda (e)
                      (and (hash? e)
                           (not (memq (fast-canonical-unit-sym (unit-type-sym e))
                                      '(creep-tumor creep-tumor-burrowed creep-tumor-queen)))
                           (or (eq? (hash-ref e 'cloaked #f) #t)
                               (memq (hash-ref e 'cloak 0) '(1 2 cloaked cloaked-detected))
                               (= (hash-ref e 'display-type 1) 3)
                               (eq? (hash-ref e 'burrowed #f) #t)
                               (eq? (hash-ref e 'is-burrowed #f) #t)
