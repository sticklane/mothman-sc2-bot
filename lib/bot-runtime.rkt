;; Pure racket/base 1-to-1 macro energy dispatcher eliminating Typed/Untyped higher-order hash copies.
(define (fast-dispatch-macro-energy! casters candidates frame claimed-targets-set
                                      #:min-energy min-energy
                                      #:valid-caster? [valid-caster? #f]
                                      #:valid-pair? valid-pair?
                                      #:score-pair score-pair
                                      #:emit-cast! emit-cast!)
  (define local-claimed-casters (make-hash))
  (define local-claimed-targets (make-hash))
  (define (entity-key x)
    (if (hash? x) (or (hash-ref x 'id #f) (hash-ref x 'tag #f) x) x))
  (define (target-claimed? tkey raw-cand)
    (or (hash-ref local-claimed-targets tkey #f)
        (cond
          [(set-mutable? claimed-targets-set)
           (or (set-member? claimed-targets-set tkey)
               (set-member? claimed-targets-set raw-cand))]
          [(set? claimed-targets-set)
           (or (set-member? claimed-targets-set tkey)
               (set-member? claimed-targets-set raw-cand))]
          [(hash? claimed-targets-set)
           (or (not (eq? (hash-ref claimed-targets-set tkey RUNTIME-MISSING) RUNTIME-MISSING))
               (not (eq? (hash-ref claimed-targets-set raw-cand RUNTIME-MISSING) RUNTIME-MISSING)))]
          [else #f])))
  (define (claim-target! tkey)
    (hash-set! local-claimed-targets tkey #t)
    (cond
      [(set-mutable? claimed-targets-set) (set-add! claimed-targets-set tkey)]
      [(and (hash? claimed-targets-set) (not (immutable? claimed-targets-set)))
       (hash-set! claimed-targets-set tkey frame)]
      [else (void)]))
  (define eligible-casters
    (for/list ([c (in-list casters)]
               #:when (and (or (not (hash? c))
                               (let ([en (hash-ref c 'energy 0.0)])
                                 (and (real? en) (>= en min-energy))))
                           (or (not valid-caster?) (valid-caster? c))))
      c))
  (define scored-pairs
    (for*/fold ([acc '()])
               ([c (in-list eligible-casters)]
                [cand (in-list candidates)])
      (define tkey (entity-key cand))
      (if (and (not (target-claimed? tkey cand))
               (valid-pair? c cand))
          (let ([sc (score-pair c cand)])
            (if (and (real? sc) (not (nan? sc)) (not (infinite? sc)))
                (cons (vector (exact->inexact sc) c cand (entity-key c) tkey) acc)
                acc))
          acc)))
  (define sorted-pairs (sort scored-pairs (lambda (a b) (> (vector-ref a 0) (vector-ref b 0)))))
  (define emitted '())
  (for ([v (in-list sorted-pairs)])
    (define c (vector-ref v 1))
    (define cand (vector-ref v 2))
    (define ckey (vector-ref v 3))
    (define tkey (vector-ref v 4))
    (unless (or (hash-ref local-claimed-casters ckey #f)
                (target-claimed? tkey cand))
      (hash-set! local-claimed-casters ckey #t)
      (claim-target! tkey)
      (define res (emit-cast! c cand))
      (when (and res (not (void? res)))
        (set! emitted (cons res emitted)))))
  (reverse emitted))

