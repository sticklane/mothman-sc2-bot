                                             SC2-STATIC-DETECTOR-COOLDOWN-FRAMES))
         (if live-game?
             (let-values ([(pcx pcy) (l2-offset-defense-anchor ctx nat-x nat-y 5.5)])
               (l2-emit-build-verified! ctx 'photon-cannon pcx pcy 2.0))
             (l2-emit! ctx (list 'build 'photon-cannon nat-x nat-y)))))
  (when (and (memq 'robotics-bay ready-bldg-types)
                (not urgent-combat-or-intel-need?))
       (cond
         [(and (or (not live-game?)
                   (>= (l2-unit-count ctx 'colossus) 1))
               (l2-protoss-colossus-escrow-ok? ctx (sc2-min-cost 'extended-thermal-lance) (sc2-gas-cost 'extended-thermal-lance) #:for-etl? #t)
               (l2-upgrade-needed? ctx 'extended-thermal-lance))
          (l2-emit-research-verified! ctx 'extended-thermal-lance)]
         [(and (or (not live-game?)
                   (l2-plan-wants-now? ctx 'gravitic-booster)
                   (>= (l2-unit-count ctx 'observer) 1))
               (l2-protoss-colossus-escrow-ok? ctx (sc2-min-cost 'gravitic-booster) (sc2-gas-cost 'gravitic-booster))
               (l2-upgrade-needed? ctx 'gravitic-booster))
          (l2-emit-research-verified! ctx 'gravitic-booster)]))
  (define storm-ready? (memq 'psi-storm researched-upgs))
  (define high-energy-ht-count
       (if (and live-game? storm-ready? (< enemy-muta-cnt-p 3))
           (min 2 (count (lambda (u)
                           (and (eq? (unit-type-sym u) 'high-templar)
                                (>= (hash-ref u 'energy 0) 75)))
                         ally-units))
           0))
  (define avail-ht-slots (max 0 (- (hash-ref open-prod-slots 'high-templar 0) high-energy-ht-count)))
  (define avail-dt-slots (hash-ref open-prod-slots 'dark-templar 0))
  (when (if live-game?
               (>= (+ avail-ht-slots avail-dt-slots) 2)
               (>= (count (lambda (u) (memq (unit-type-sym u) '(high-templar dark-templar))) ally-units) 2))
       (define consume-ht (min 2 avail-ht-slots))
       (define consume-dt (min (- 2 consume-ht) avail-dt-slots))
       (when (> consume-ht 0)
         (hash-set! open-prod-slots 'high-templar
                    (max 0 (- (hash-ref open-prod-slots 'high-templar 0) consume-ht))))
       (when (> consume-dt 0)
         (hash-set! open-prod-slots 'dark-templar (- avail-dt-slots consume-dt)))
       (l2-emit! ctx '(morph archon))
       (order-ledger-record-issued! oledger (+ 865500 (modulo frame 10000) (length (l2-ctx-actions ctx)))
                                    'morph 'archon base-x base-y frame))
  (define protoss-ideal-worker-cap
       (l2-compute-race-ideal-worker-cap ctx nexuses))
  (define protoss-probe-priority?
       (and (or (not protoss-saving-for-expand?)
                (and (< total-workers 17) (< (l2-ctx-minerals ctx) 200)))
            (not crisis-freeze-workers?)
            (l2-worker-army-curve-satisfied? ctx)
            (not urgent-combat-or-intel-need?)
            (or (< total-workers protoss-ideal-worker-cap)
                (l2-can-spend-by-priority? ctx 'probe 'worker))
            (< total-workers (min 70 (max target-workers protoss-ideal-worker-cap)))
            (or (not live-game?)
                (and (not under-base-attack?) (<= live-enemy-threat-supply 0))
                (< total-workers 20)
                (not (or (memq 'gateway ready-bldg-types) (memq 'warp-gate ready-bldg-types)))
                (>= (length ally-combat-units) 3)
                (>= live-army-supply (* 6 (max 1 (length nexuses)))))
            (>= (l2-ctx-minerals ctx)
                (+ (sc2-min-cost 'probe)
                   (max
                    (if (and live-game?
                             (>= total-workers 18)
                             bo-goal-sym
                             (not (memq bo-goal-sym '(hatchery nexus command-center drone probe scv)))
                             (> (sc2-gas-cost bo-goal-sym) 0)
                             (>= (l2-ctx-gas ctx) (sc2-gas-cost bo-goal-sym)))
                        (sc2-min-cost bo-goal-sym)
                        0)
                    (let-values ([(cm _cg) (l2-scheduled-combat-reserve ctx 'probe)])
                      cm))))
            (l2-can-spend-supply? ctx (sc2-supply-cost 'probe))
            (not under-early-cheese?)
            (< (hash-ref pressure-metrics 'threat-pressure 0.0) 0.85)))
  (when protoss-probe-priority?
       (l2-try-train-unit! ctx 'probe 'townhall 4
                        #:respect-bo-reserve? (l2-worker-respect-bo-reserve? ctx)))
  (define (gateway-unit-colossus-ok? u-sym)
       (or crisis-tech-upgrade-deferral?
           (and (or (<= (sc2-gas-cost u-sym) 0)
                    (>= (- (l2-ctx-gas ctx) (sc2-gas-cost u-sym)) protoss-pending-robo-gas-reserve))
                (or urgent-combat-or-intel-need?
                    under-base-attack?
                    (and (eq? u-sym 'zealot) (>= (l2-ctx-minerals ctx) 400))
                    (l2-protoss-colossus-escrow-ok? ctx (sc2-min-cost u-sym) (sc2-gas-cost u-sym))))))
  (when (and (or crisis-tech-upgrade-deferral? (not protoss-saving-for-expand?))
                (l2-can-spend-supply? ctx (sc2-supply-cost 'zealot)))
       (cond
         [(memq 'cybernetics-core ready-bldg-types)
          ;; Dark Templar when Dark Shrine is ready
          (when (and (not crisis-tech-upgrade-deferral?)
                     (memq 'dark-shrine ready-bldg-types)
                     (gateway-unit-colossus-ok? 'dark-templar)
                     (or (l2-plan-wants-now? ctx 'dark-templar)
                         (< (l2-unit-count ctx 'dark-templar) 3))
                     (>= (l2-ctx-gas ctx) (sc2-gas-cost 'dark-templar))
                     (l2-can-spend-by-priority? ctx 'dark-templar 'combat-unit))
            (l2-try-train-unit! ctx 'dark-templar 'gateway 5 #:respect-bo-reserve? #t))
          ;; High Templar -> Psi Storm & Archon when Templar Archives ready
          (when (and (not crisis-tech-upgrade-deferral?)
                     (memq 'templar-archive ready-bldg-types)
                     (gateway-unit-colossus-ok? 'high-templar)
                     (< (l2-unit-count ctx 'high-templar) 6)
                     (>= (l2-ctx-gas ctx) (sc2-gas-cost 'high-templar)))
            (l2-try-train-unit! ctx 'high-templar 'gateway 5 #:respect-bo-reserve? #t))
          ;; Guardian Shield aura + gas sink: maintain 1 Sentry (respecting exact 100G cost & bo=sentry goal!)
          (when (and (not crisis-tech-upgrade-deferral?)
                     (>= (l2-ctx-gas ctx) (sc2-gas-cost 'sentry))
                     (gateway-unit-colossus-ok? 'sentry)
                     (or (eq? bo-goal-sym 'sentry)
                         (l2-plan-wants-now? ctx 'sentry)
                         (>= (length ally-combat-units) 2))
                     (if live-game?
                         (and (< (l2-unit-count ctx 'sentry) 1)
                              (or (eq? bo-goal-sym 'sentry)
                                  (eq? prio-saving-for-sym 'sentry)
                                  (l2-plan-wants-now? ctx 'sentry)
                                  (>= (l2-unit-count ctx 'stalker) 4)
                                  (and (>= (l2-ctx-gas ctx) 120) (>= (length ally-combat-units) 2))))
                         (< (l2-unit-count ctx 'sentry) 2)))
            (l2-try-train-unit! ctx 'sentry 'gateway 5 #:respect-bo-reserve? #t))
          ;; Counter-composition sensors: Zergling/Baneling floods (#5122350) vs Reaper/proxy Terran (#5122354)
          (define-values (enemy-reaper-cnt enemy-light-swarm-cnt enemy-armored-or-air-cnt pvz-unit? pvz-air?)
            (for/fold ([reap 0] [light 0] [arm-air 0] [pvz? #f] [pvz-air? #f])
                      ([e (in-list enemy-units)])
              (define ut (unit-type-sym e))
              (values
               (if (eq? ut 'reaper) (add1 reap) reap)
               (if (memq ut '(zergling baneling marine)) (add1 light) light)
               (if (memq ut '(roach ravager marauder stalker immortal siege-tank siege-tank-sieged
                                    thor ultralisk colossus mutalisk void-ray phoenix banshee viking medivac liberator))
                   (add1 arm-air)
                   arm-air)
               (or pvz?
                   (and (memq ut '(zergling baneling roach ravager hydralisk lurker
                                            lurker-burrowed lurker-mp-burrowed mutalisk corruptor
                                            ultralisk brood-lord broodlord drone queen overlord))
                        #t))
               (or pvz-air?
                   (and (memq ut '(mutalisk corruptor brood-lord broodlord))
                        #t)))))
          (define pvz-matchup?
            (and live-game?
                 (or (eq? effective-enemy-race 'Zerg)
                     pvz-unit?)))
          (define pvz-air-threat?
            (and pvz-matchup? pvz-air?))
          (define pvz-ling-swarm-mode?
            (and live-game?
                 (>= enemy-light-swarm-cnt 6)
                 (> enemy-light-swarm-cnt (* 2 (max 1 enemy-armored-or-air-cnt)))))
          (define pvz-anti-ground-mode?
            (and pvz-matchup?
                 (not pvz-air-threat?)
                 (or (> enemy-light-swarm-cnt 0)
                     (> enemy-armored-or-air-cnt 0)
                     (< (l2-unit-count ctx 'zealot) (max 4 (* 2 (l2-unit-count ctx 'stalker)))))))
          (define anti-reaper-or-proxy-terran?
            (and live-game?
                 (or (>= enemy-reaper-cnt 1)
                     (and forward-proxy-detected? (eq? effective-enemy-race 'Terran)))))
          (cond
            [pvz-ling-swarm-mode?
             ;; Counter Zergling/Baneling floods (#5122350) with tanky Zealots + Adepts
             ;; instead of overbuilding Stalkers that get surrounded and shredded!
             (when (and (< (l2-unit-count ctx 'adept) 6)
                        (gateway-unit-colossus-ok? 'adept)
                        (or (l2-can-spend-by-priority? ctx 'adept 'combat-unit)
                            (l2-can-spend-by-priority? ctx 'stalker 'combat-unit)))
               (l2-try-train-unit! ctx 'adept 'gateway 5 #:respect-bo-reserve? #t))
             (when (and (gateway-unit-colossus-ok? 'zealot)
                        (or (l2-can-spend-by-priority? ctx 'zealot 'combat-unit)
                            (l2-can-spend-by-priority? ctx 'stalker 'combat-unit)))
               (l2-try-train-unit! ctx 'zealot 'gateway 5 #:respect-bo-reserve? #t))
             (when (and (gateway-unit-colossus-ok? 'stalker)
                        (or pvz-air-threat?
                            (and (not pvz-matchup?) (enemy-tech-observation-requires-anti-air? tech-obs))
                            (< (l2-unit-count ctx 'stalker)
                               (if (>= (l2-ctx-gas ctx) 225) 8 2)))
                        (l2-can-spend-by-priority? ctx 'stalker 'combat-unit))
               (l2-try-train-unit! ctx 'stalker 'gateway 5 #:respect-bo-reserve? #t))]
            [pvz-anti-ground-mode?
             ;; In PvZ vs Roach/Ravager/Zergling (`P0-2b`), conserve gas for Immortals/Archons/Colossi,
             ;; but when floating >= 150G (and not actively saving for Immortal), convert gas into Stalkers!
             (when (and (gateway-unit-colossus-ok? 'stalker)
                        (>= (l2-ctx-gas ctx) 150)
                        (< (l2-unit-count ctx 'stalker) (if (>= (l2-ctx-gas ctx) 300) 10 5))
                        (not (and (memq 'robotics-facility ready-bldg-types)
                                  (> (hash-ref open-prod-slots 'robotics-facility 0) 0)
                                  (or (eq? bo-goal-sym 'immortal)
                                      (eq? prio-saving-for-sym 'immortal))
                                  (< (l2-ctx-minerals ctx) (+ (sc2-min-cost 'immortal) (sc2-min-cost 'stalker)))))
                        (l2-can-spend-by-priority? ctx 'stalker 'combat-unit))
               (l2-try-train-unit! ctx 'stalker 'gateway 5 #:respect-bo-reserve? #t))
             (when (and (gateway-unit-colossus-ok? 'zealot)
                        (l2-can-spend-by-priority? ctx 'zealot 'combat-unit))
               (l2-try-train-unit! ctx 'zealot 'gateway 5 #:respect-bo-reserve? #t))
             (when (and (< (l2-unit-count ctx 'adept) 3)
                        (< frame 4000)
                        (gateway-unit-colossus-ok? 'adept)
                        (l2-can-spend-by-priority? ctx 'adept 'combat-unit))
               (l2-try-train-unit! ctx 'adept 'gateway 5 #:respect-bo-reserve? #t))
             (when (and (gateway-unit-colossus-ok? 'stalker)
                        (< (l2-unit-count ctx 'stalker) (if (>= (l2-ctx-gas ctx) 225) 5 3))
                        (l2-can-spend-by-priority? ctx 'stalker 'combat-unit))
               (l2-try-train-unit! ctx 'stalker 'gateway 5 #:respect-bo-reserve? #t))]
            [anti-reaper-or-proxy-terran?
             ;; Counter proxy Reapers / proxy Barracks (#5122354, #5131254) with ranged Stalkers first;
             ;; vs >= 2 Reapers, do NOT waste 100M on slow un-Charged Zealots that get kited to death!
             (when (and (gateway-unit-colossus-ok? 'stalker)
                        (l2-can-spend-by-priority? ctx 'stalker 'combat-unit))
               (l2-try-train-unit! ctx 'stalker 'gateway 5 #:respect-bo-reserve? #t))
             (when (and (< enemy-reaper-cnt 2)
                        (< (l2-unit-count ctx 'adept) 3)
                        (gateway-unit-colossus-ok? 'adept)
                        (or (l2-can-spend-by-priority? ctx 'adept 'combat-unit)
                            (l2-can-spend-by-priority? ctx 'stalker 'combat-unit)))
               (l2-try-train-unit! ctx 'adept 'gateway 5 #:respect-bo-reserve? #t))
             (when (and (gateway-unit-colossus-ok? 'zealot)
                        (l2-can-spend-by-priority? ctx 'zealot 'combat-unit)
                        (or (memq 'charge researched-upgs)
                            (>= (l2-ctx-minerals ctx) 300)
                            (and (< enemy-reaper-cnt 2)
                                 (or (< (l2-ctx-gas ctx) (sc2-gas-cost 'adept))
                                     (>= (l2-ctx-minerals ctx) 225)))))
               (l2-try-train-unit! ctx 'zealot 'gateway 5 #:respect-bo-reserve? #t))]
            [else
             ;; Early scouting / light-unit Adept when planned
             (when (and (not crisis-tech-upgrade-deferral?)
                        (gateway-unit-colossus-ok? 'adept)
                        (or (l2-plan-wants-now? ctx 'adept)
                            (and live-game? (< frame 3000) (< (l2-unit-count ctx 'adept) 1) (= (l2-unit-count ctx 'stalker) 0)))
                        (l2-can-spend-by-priority? ctx 'adept 'combat-unit))
               (l2-try-train-unit! ctx 'adept 'gateway 5 #:respect-bo-reserve? #t))
             (when (and (gateway-unit-colossus-ok? 'stalker)
                        (or crisis-tech-upgrade-deferral?
                            (l2-can-spend-by-priority? ctx 'stalker 'combat-unit)))
               (l2-try-train-unit! ctx 'stalker 'gateway 5 #:respect-bo-reserve? (not crisis-tech-upgrade-deferral?)))
             (when (and (gateway-unit-colossus-ok? 'zealot)
                        (or crisis-tech-upgrade-deferral?
                            (and (l2-can-spend-by-priority? ctx 'zealot 'combat-unit)
                                 (or (< (l2-ctx-gas ctx) (sc2-gas-cost 'stalker))
                                     (and (> protoss-pending-robo-gas-reserve 0)
                                          (< (- (l2-ctx-gas ctx) protoss-pending-robo-gas-reserve) (sc2-gas-cost 'stalker)))
                                     (>= (l2-ctx-minerals ctx) 225)
                                     (and urgent-combat-or-intel-need? (< (l2-ctx-minerals ctx) (sc2-min-cost 'stalker)))
                                     (and (memq 'charge researched-upgs)
                                          (< (l2-ctx-gas ctx) 200)
                                          (<= (l2-unit-count ctx 'zealot) (l2-unit-count ctx 'stalker)))))))
               (l2-try-train-unit! ctx 'zealot 'gateway 5 #:respect-bo-reserve? (not crisis-tech-upgrade-deferral?)))])]
         [(and (or (memq 'gateway ready-bldg-types) (memq 'warp-gate ready-bldg-types))
               (gateway-unit-colossus-ok? 'zealot)
               (or crisis-tech-upgrade-deferral?
                   (l2-can-spend-by-priority? ctx 'zealot 'combat-unit))
               (let ([need-core-first?
                      (and (= (l2-cur-ally-canon-bldg-count ctx 'cybernetics-core) 0)
                           (= (order-ledger-pending-count-for-type oledger 'cybernetics-core frame) 0)
                           (or (ormap (lambda (e) (eq? (fast-canonical-unit-sym (unit-type-sym e)) 'reaper))
                                      enemy-units)
                               (and (eq? effective-enemy-race 'Terran)
                                    (>= (l2-unit-count ctx 'zealot) 1))))])
                 (or (not need-core-first?)
                     (>= (- (l2-ctx-minerals ctx) (sc2-min-cost 'zealot))
                         (sc2-min-cost 'cybernetics-core)))))
          (l2-try-train-unit! ctx 'zealot 'gateway 5 #:respect-bo-reserve? (not crisis-tech-upgrade-deferral?))]))
  (when (and (not protoss-probe-priority?)
                (not crisis-freeze-workers?)
                (l2-worker-army-curve-satisfied? ctx)
                (not protoss-saving-for-expand?)
                (l2-can-spend-by-priority? ctx 'probe 'worker)
                (< total-workers
                   (if live-game?
                       (min 70 (max target-workers protoss-ideal-worker-cap))
                       target-workers))
                (or (member '(train probe) prio-scheduled-actions)
                    worker-rush-active?
                    (< total-workers 14)
                    (< (hash-ref pressure-metrics 'threat-pressure 0.0) 1.0)))
       (l2-try-train-unit! ctx 'probe 'townhall 4
                        #:respect-bo-reserve? (l2-worker-respect-bo-reserve? ctx))))

(define (l2-terran-phase1-orbital-addon-expand! ctx)
  (define allow-exact-wall-slot? (l2-ctx-allow-exact-wall-slot? ctx))
  (define ally-bldgs (l2-ctx-ally-bldgs ctx))
  (define base-x (l2-ctx-base-x ctx))
  (define base-y (l2-ctx-base-y ctx))
  (define blocked-nat-expanded-early? (l2-ctx-blocked-nat-expanded-early? ctx))
  (define bypass-wall-depot1? (l2-ctx-bypass-wall-depot1? ctx))
  (define cd-tracker (l2-ctx-cd-tracker ctx))
  (define crisis-freeze-expand-or-gas? (l2-ctx-crisis-freeze-expand-or-gas? ctx))
  (define crisis-tech-upgrade-deferral? (l2-ctx-crisis-tech-upgrade-deferral? ctx))
  (define cur-escrow-age-frames (l2-ctx-cur-escrow-age-frames ctx))
  (define desired-bases (l2-ctx-desired-bases ctx))
  (define early-survival-crisis? (l2-ctx-early-survival-crisis? ctx))
  (define eff-phase-supply (l2-ctx-eff-phase-supply ctx))
  (define endgame-corner-hunt? (l2-ctx-endgame-corner-hunt? ctx))
  (define enemy-units (l2-ctx-enemy-units ctx))
  (define escrow-suppressed-active? (l2-ctx-escrow-suppressed-active? ctx))
  (define forward-proxy-detected? (l2-ctx-forward-proxy-detected? ctx))
  (define frame (l2-ctx-frame ctx))
  (define hard-supply-lockout-reserve-min (l2-ctx-hard-supply-lockout-reserve-min ctx))
  (define in-base-proxy-completed-cannon? (l2-ctx-in-base-proxy-completed-cannon? ctx))
  (define intel-confidence (l2-ctx-intel-confidence ctx))
  (define live-army-supply (l2-ctx-live-army-supply ctx))
  (define live-enemy-threat-supply (l2-ctx-live-enemy-threat-supply ctx))
  (define live-game-obs? (l2-ctx-live-game-obs? ctx))
  (define live-game? (l2-ctx-live-obs-harvesters? ctx))
  (define macro-plan (l2-ctx-macro-plan ctx))
  (define max-escrow-timeout-frames (l2-ctx-max-escrow-timeout-frames ctx))
  (define nat-x (l2-ctx-nat-x ctx))
  (define nat-y (l2-ctx-nat-y ctx))
  (define natural-blocked? (l2-ctx-natural-blocked? ctx))
  (define obs (l2-ctx-obs ctx))
  (define oledger (l2-ctx-oledger ctx))
  (define open-prod-slots (l2-ctx-open-prod-slots ctx))
  (define orphaned-prereqs (l2-ctx-orphaned-prereqs ctx))
  (define ready-bldg-types (l2-ctx-ready-bldg-types ctx))
  (define rt (l2-ctx-rt ctx))
  (define supply-used (l2-ctx-supply-used ctx))
  (define tech-obs (l2-ctx-tech-obs ctx))
  (define terran-ramp-wall (l2-ctx-terran-ramp-wall ctx))
  (define total-workers (l2-ctx-total-workers ctx))
  (define under-base-attack? (l2-ctx-under-base-attack? ctx))
  (define under-early-cheese? (l2-ctx-under-early-cheese? ctx))
  (define urgent-combat-or-intel-need? (l2-ctx-urgent-combat-or-intel-need? ctx))
  (define ccs-rev '())
  (define refineries-rev '())
  (define active-refineries-rev '())
  (define barracks-rev '())
  (define factories-rev '())
  (for ([b (in-list ally-bldgs)])
       (define cs (fast-canonical-structure-sym (unit-type-sym b)))
       (cond
         [(memq cs '(command-center orbital-command planetary-fortress))
          (set! ccs-rev (cons b ccs-rev))]
         [(eq? cs 'refinery)
          (set! refineries-rev (cons b refineries-rev))
          (when (l2-active-gas-bldg? ctx b)
            (set! active-refineries-rev (cons b active-refineries-rev)))]
         [(eq? cs 'barracks)
          (set! barracks-rev (cons b barracks-rev))]
         [(eq? cs 'factory)
          (set! factories-rev (cons b factories-rev))]))
  (define ccs (reverse ccs-rev))
  (set-l2-ctx-ccs! ctx ccs)
  (define refineries (reverse refineries-rev))
  (define active-refineries (reverse active-refineries-rev))
  (set-l2-ctx-active-refineries! ctx active-refineries)
  (define barracks-list (reverse barracks-rev))
  (set-l2-ctx-barracks-list! ctx barracks-list)
  (define factories-list (reverse factories-rev))
  (set-l2-ctx-factories-list! ctx factories-list)
  (define mule-patch-id (hash-ref obs 'mineral-patch-id SC2-SYNTHETIC-MINERAL-PATCH-ID))
  (define raw-mineral-patches
       (let ([mps (hash-ref obs 'mineral-patches '())])
         (if (list? mps) (filter hash? mps) '())))
  (define splash-st (rt-splash-state rt))
  (define scanned-pts '())
  (define claimed-mule-patches (mutable-seteqv))
  (define scan-candidates-box RUNTIME-MISSING)
  (define (get-scan-candidates)
    (when (eq? scan-candidates-box RUNTIME-MISSING)
      (set! scan-candidates-box
            (for/list ([e (in-list enemy-units)]
                       #:when (or (hash-ref e 'cloaked #f)
                                  (hash-ref e 'burrowed #f)
                                  (memq (fast-canonical-unit-sym (unit-type-sym e))
                                        '(lurker dark-templar banshee ghost widow-mine))))
              e)))
    scan-candidates-box)
  (define ally-combat-units (l2-ctx-ally-combat-units ctx))
  (define safe-ths-for-mule
    (for/list ([th (in-list ccs)]
               #:when (and (l2-building-grounded-and-powered? ctx th)
                           (>= (hash-ref th 'build-progress 1.0) SC2-BUILD-COMPLETE-PROGRESS)))
      (cons (exact->inexact (hash-ref th 'x base-x))
            (exact->inexact (hash-ref th 'y base-y)))))
  (define (mule-patch-safe? mp)
    (define mpx (exact->inexact (hash-ref mp 'x base-x)))
    (define mpy (exact->inexact (hash-ref mp 'y base-y)))
    (define e-near
      (for/sum ([e (in-list enemy-units)]
                #:when (and (hash? e) (combat-unit-record? e)))
        (define dx (fl- mpx (exact->inexact (hash-ref e 'x 9999.0))))
        (define dy (fl- mpy (exact->inexact (hash-ref e 'y 9999.0))))
        (if (fl<= (fl+ (fl* dx dx) (fl* dy dy)) 100.0) 1 0)))
    (or (= e-near 0)
        (let ([a-near
               (for/sum ([a (in-list ally-combat-units)]
                         #:when (hash? a))
                 (define dx (fl- mpx (exact->inexact (hash-ref a 'x 9999.0))))
                 (define dy (fl- mpy (exact->inexact (hash-ref a 'y 9999.0))))
                 (if (fl<= (fl+ (fl* dx dx) (fl* dy dy)) 144.0) 1 0))])
          (>= a-near (* 2 e-near)))))
  (define enemy-cloaked-or-burrowed-active?
    (and live-game?
         (= (l2-unit-count ctx 'raven) 0)
         (or (pair? (get-scan-candidates))
             (and tech-obs (enemy-tech-observation-requires-detection? tech-obs)))))
  (define reserved-scan-orbital? #f)
  (for ([cc (in-list ccs)])
       (define raw-ctype (unit-type-sym cc))
       (define cid (hash-ref cc 'id 301))
       (define cenergy (hash-ref cc 'energy SC2-ORBITAL-MULE-ENERGY))
       (cond
         [(and (eq? raw-ctype 'command-center)
               (l2-building-grounded-and-powered? ctx cc)
               (>= (hash-ref cc 'build-progress 1.0) SC2-BUILD-COMPLETE-PROGRESS)
               (<= (hash-ref cc 'order-count 0) 0)
               (= (hash-ref cc 'order-ability-id 0) 0)
