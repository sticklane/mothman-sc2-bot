                          (not (l2-building-present-or-pending? ctx 'hive))
                          (< (l2-ctx-gas ctx) 175)
                          (not zvz-home-doorstep-bile-breach?)))
                (>= (- (l2-ctx-minerals ctx) zerg-spire-res-min) (sc2-min-cost 'ravager))
                (>= (- (l2-ctx-gas ctx) zerg-spire-res-gas) (sc2-gas-cost 'ravager))
