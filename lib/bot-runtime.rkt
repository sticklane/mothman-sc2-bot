(define (sanitize-record-list raw fn def-x def-y)
  (if (list? raw)
      (let loop ([rem raw] [acc-rev '()] [idx 0] [same? #t])
        (cond
          [(null? rem)
           (if same? raw (reverse acc-rev))]
          [else
           (define item (car rem))
           (define nitem (fn item def-x def-y))
           (cond
             [(and same? (eq? nitem item))
              (loop (cdr rem) '() (add1 idx) #t)]
             [same?
              (define prefix-rev
                (let copy ([p raw] [n idx] [acc '()])
                  (if (zero? n) acc (copy (cdr p) (sub1 n) (cons (car p) acc)))))
              (loop (cdr rem) (cons nitem prefix-rev) (add1 idx) #f)]
             [else
              (loop (cdr rem) (cons nitem acc-rev) (add1 idx) #f)])]))
      '()))

(define (apply-hash-chgs h chgs)
  (let loop ([rem chgs] [acc h])
    (if (null? rem)
        acc
        (loop (cddr rem) (hash-set acc (car rem) (cadr rem))))))

(define (apply-sanitized-chgs base-h chgs)
  (cond
    [(null? chgs) base-h]
    [(null? (cddr chgs)) (hash-set base-h (car chgs) (cadr chgs))]
    [(null? (cddddr chgs)) (hash-set* base-h (car chgs) (cadr chgs) (caddr chgs) (cadddr chgs))]
    [else (apply-hash-chgs base-h chgs)]))

(define-inline (sanitize-record-core rec default-x default-y bldg?)
  (define base-h (if (immutable? rec) rec (for/hash ([(k v) (in-hash rec)]) (values k v))))
  (define chgs '())
  (define id-v (hash-ref base-h 'id SANITIZE-MISSING))
  (cond
    [(eq? id-v SANITIZE-MISSING) (set! chgs (cons 'id (cons 101 chgs)))]
    [(not (and (exact-integer? id-v) (>= id-v 0)))
     (define nv (safe-nonneg-int id-v 101))
     (unless (eq? nv id-v) (set! chgs (cons 'id (cons nv chgs))))])
  (define tp-v (hash-ref base-h 'type SANITIZE-MISSING))
  (cond
    [(eq? tp-v SANITIZE-MISSING) (set! chgs (cons 'type (cons 'unknown chgs)))]
    [(not (symbol? tp-v))
     (define nv (if (string? tp-v) (string->symbol (string-downcase tp-v)) 'unknown))
     (unless (eq? nv tp-v) (set! chgs (cons 'type (cons nv chgs))))])
  (define xv (hash-ref base-h 'x SANITIZE-MISSING))
  (cond
    [(eq? xv SANITIZE-MISSING)
     (set! chgs (cons 'x (cons (safe-coord default-x default-x) chgs)))]
    [(and (flonum? xv) (fl>= xv 0.0) (fl<= xv 256.0))
     (define r (fl* (flround (fl* xv 2.0)) 0.5))
     (unless (fl= xv r) (set! chgs (cons 'x (cons r chgs))))]
    [(and (exact-integer? xv) (>= xv 0) (<= xv 256)) (void)]
    [else
     (define nv (safe-coord xv default-x))
     (unless (equal? nv xv) (set! chgs (cons 'x (cons nv chgs))))])
  (define yv (hash-ref base-h 'y SANITIZE-MISSING))
  (cond
    [(eq? yv SANITIZE-MISSING)
     (set! chgs (cons 'y (cons (safe-coord default-y default-y) chgs)))]
    [(and (flonum? yv) (fl>= yv 0.0) (fl<= yv 256.0))
     (define r (fl* (flround (fl* yv 2.0)) 0.5))
     (unless (fl= yv r) (set! chgs (cons 'y (cons r chgs))))]
    [(and (exact-integer? yv) (>= yv 0) (<= yv 256)) (void)]
    [else
     (define nv (safe-coord yv default-y))
     (unless (equal? nv yv) (set! chgs (cons 'y (cons nv chgs))))])
  (define raw-hp (hash-ref base-h 'hp SANITIZE-MISSING))
  (define raw-mhp (hash-ref base-h 'max-hp SANITIZE-MISSING))
  (define hp-val
    (cond
      [(eq? raw-hp SANITIZE-MISSING)
       (define def-hp
         (if bldg?
             (if (and (exact-integer? raw-mhp) (>= raw-mhp 1)) raw-mhp 500)
             45))
       (set! chgs (cons 'hp (cons def-hp chgs)))
       def-hp]
      [(and (exact-integer? raw-hp) (>= raw-hp 1)) raw-hp]
      [else
       (define nv (max 1 (safe-nonneg-int raw-hp (if bldg? 500 45))))
       (unless (eq? nv raw-hp) (set! chgs (cons 'hp (cons nv chgs))))
       nv]))
  (define max-hp-val
    (cond
      [(eq? raw-mhp SANITIZE-MISSING)
       (if bldg?
           (let ([m (max 500 hp-val)])
             (set! chgs (cons 'max-hp (cons m chgs)))
             m)
           500)]
      [(and (exact-integer? raw-mhp) (>= raw-mhp 1)) raw-mhp]
      [else
       (define m (max 1 (safe-nonneg-int raw-mhp hp-val)))
       (unless (equal? m raw-mhp) (set! chgs (cons 'max-hp (cons m chgs))))
       m]))
  (define raw-hpp (hash-ref base-h 'hp-pct SANITIZE-MISSING))
  (cond
    [(eq? raw-hpp SANITIZE-MISSING)
     (when bldg?
       (define pct (flmax 0.0 (flmin 1.0 (fl/ (->fl hp-val) (->fl max-hp-val)))))
       (set! chgs (cons 'hp-pct (cons pct chgs))))]
    [(or (and (flonum? raw-hpp) (fl>= raw-hpp 0.0) (fl<= raw-hpp 1.0))
         (and (real? raw-hpp) (inexact? raw-hpp) (>= raw-hpp 0.0) (<= raw-hpp 1.0)))
     (void)]
    [else
     (define nv (sanitize-opt-unit-interval-1 raw-hpp))
     (unless (equal? nv raw-hpp) (set! chgs (cons 'hp-pct (cons nv chgs))))])
  (when bldg?
    (define bp (hash-ref base-h 'build-progress SANITIZE-MISSING))
    (cond
      [(eq? bp SANITIZE-MISSING)
       (define uc (hash-ref base-h 'under-construction #f))
       (set! chgs (cons 'build-progress (cons (if uc 0.5 1.0) chgs)))]
      [(or (and (flonum? bp) (fl>= bp 0.0) (fl<= bp 1.0))
           (and (real? bp) (inexact? bp) (>= bp 0.0) (<= bp 1.0)))
       (void)]
      [else
       (define nv (flmax 0.0 (flmin 1.0 (safe-finite-real bp 1.0))))
       (unless (equal? nv bp) (set! chgs (cons 'build-progress (cons nv chgs))))])
    (define ih (hash-ref base-h 'ideal-harvesters SANITIZE-MISSING))
    (unless (or (eq? ih SANITIZE-MISSING) (and (exact-integer? ih) (>= ih 0)))
      (define nv (sanitize-opt-nonneg-16 ih))
      (unless (equal? nv ih) (set! chgs (cons 'ideal-harvesters (cons nv chgs)))))
    (define ah (hash-ref base-h 'assigned-harvesters SANITIZE-MISSING))
    (unless (or (eq? ah SANITIZE-MISSING) (and (exact-integer? ah) (>= ah 0)))
      (define nv (sanitize-opt-nonneg-16 ah))
      (unless (equal? nv ah) (set! chgs (cons 'assigned-harvesters (cons nv chgs))))))
  (define sh (hash-ref base-h 'shield SANITIZE-MISSING))
  (unless (or (eq? sh SANITIZE-MISSING) (and (exact-integer? sh) (>= sh 0)))
    (define nv (sanitize-opt-nonneg-0 sh))
    (unless (equal? nv sh) (set! chgs (cons 'shield (cons nv chgs)))))
  (define en (hash-ref base-h 'energy SANITIZE-MISSING))
  (unless (or (eq? en SANITIZE-MISSING) (and (exact-integer? en) (>= en 0)))
    (define nv (sanitize-opt-nonneg-0 en))
    (unless (equal? nv en) (set! chgs (cons 'energy (cons nv chgs)))))
  (define zv (hash-ref base-h 'z SANITIZE-MISSING))
  (unless (or (eq? zv SANITIZE-MISSING) (exact-integer? zv))
    (define nv (sanitize-opt-exact-10 zv))
    (unless (equal? nv zv) (set! chgs (cons 'z (cons nv chgs)))))
  (define au (hash-ref base-h 'atk-upg SANITIZE-MISSING))
  (unless (or (eq? au SANITIZE-MISSING) (and (exact-integer? au) (>= au 0)))
    (define nv (sanitize-opt-nonneg-0 au))
    (unless (equal? nv au) (set! chgs (cons 'atk-upg (cons nv chgs)))))
  (define aru (hash-ref base-h 'arm-upg SANITIZE-MISSING))
  (unless (or (eq? aru SANITIZE-MISSING) (and (exact-integer? aru) (>= aru 0)))
    (define nv (sanitize-opt-nonneg-0 aru))
    (unless (equal? nv aru) (set! chgs (cons 'arm-upg (cons nv chgs)))))
  (define su (hash-ref base-h 'shd-upg SANITIZE-MISSING))
  (unless (or (eq? su SANITIZE-MISSING) (and (exact-integer? su) (>= su 0)))
    (define nv (sanitize-opt-nonneg-0 su))
    (unless (equal? nv su) (set! chgs (cons 'shd-upg (cons nv chgs)))))
  (define dpsv (hash-ref base-h 'dps SANITIZE-MISSING))
  (unless (or (eq? dpsv SANITIZE-MISSING) (and (exact-integer? dpsv) (>= dpsv 0)))
    (define nv (sanitize-opt-nonneg-12 dpsv))
    (unless (equal? nv dpsv) (set! chgs (cons 'dps (cons nv chgs)))))
  (define spv (hash-ref base-h 'speed SANITIZE-MISSING))
  (unless (or (eq? spv SANITIZE-MISSING)
              (and (flonum? spv) (fl>= spv 0.0) (fl< spv +inf.0))
              (and (real? spv) (inexact? spv) (>= spv 0.0) (< spv +inf.0)))
    (define nv (sanitize-opt-nonneg-real-3 spv))
    (unless (equal? nv spv) (set! chgs (cons 'speed (cons nv chgs)))))
  (define drr (hash-ref base-h 'damage-rate-ratio SANITIZE-MISSING))
  (unless (or (eq? drr SANITIZE-MISSING)
              (and (flonum? drr) (fl>= drr 0.0) (fl< drr +inf.0))
              (and (real? drr) (inexact? drr) (>= drr 0.0) (< drr +inf.0)))
    (define nv (sanitize-opt-nonneg-real-1 drr))
    (unless (equal? nv drr) (set! chgs (cons 'damage-rate-ratio (cons nv chgs)))))
  (define dtm (hash-ref base-h 'damage-taken-multiplier SANITIZE-MISSING))
  (unless (or (eq? dtm SANITIZE-MISSING)
              (and (flonum? dtm) (fl>= dtm 0.0) (fl< dtm +inf.0))
              (and (real? dtm) (inexact? dtm) (>= dtm 0.0) (< dtm +inf.0)))
    (define nv (sanitize-opt-nonneg-real-1 dtm))
    (unless (equal? nv dtm) (set! chgs (cons 'damage-taken-multiplier (cons nv chgs)))))
  (apply-sanitized-chgs base-h chgs))

(define (sanitize-unit-record u [default-x 32.5] [default-y 32.5])
  (if (hash? u)
      (sanitize-record-core u default-x default-y #f)
      (hash 'id 101 'type 'zergling 'x default-x 'y default-y 'hp 35)))

(define (sanitize-bldg-record b [default-x 32.5] [default-y 32.5])
  (if (hash? b)
      (sanitize-record-core b default-x default-y #t)
      (hash 'id 201 'type 'hatchery 'x default-x 'y default-y 'hp 1500 'max-hp 1500 'hp-pct 1.0 'build-progress 1.0)))

(define (sanitize-effect-record eff)
  (cond
    [(hash? eff)
     (define raw-t (hash-ref eff 'type 'none))
     (define t (if (symbol? raw-t) raw-t 'none))
     (hash 'type t
           'x (safe-coord (hash-ref eff 'x 0.0) 0.0)
           'y (safe-coord (hash-ref eff 'y 0.0) 0.0))]
    [(and (list? eff) (= (length eff) 3))
     (hash 'type (if (symbol? (first eff)) (first eff) 'none)
           'x (safe-coord (second eff) 0.0)
           'y (safe-coord (third eff) 0.0))]
    [else
     (hash 'type 'none 'x 0.0 'y 0.0)]))

(define (sanitize-obs-hash obs)
  (cond
    [(not (hash? obs)) (sanitize-obs-hash (hash))]
    [(and (immutable? obs) (eq? (hash-ref obs '__sanitized? #f) #t)) obs]
    [else
     (define base-h (if (immutable? obs) obs (for/hash ([(k v) (in-hash obs)]) (values k v))))
     (define frame (safe-nonneg-int (hash-ref base-h 'frame 0) 0))
     (define minerals (safe-nonneg-int (hash-ref base-h 'minerals 200) 0))
     (define gas (safe-nonneg-int (hash-ref base-h 'gas 0) 0))
     (define supply-used (safe-nonneg-int (hash-ref base-h 'supply-used 12) 12))
     (define supply-cap (min 200 (safe-nonneg-int (hash-ref base-h 'supply-cap 15) 15)))
     (define supply-left
       (max 0 (safe-exact-int (hash-ref base-h 'supply-left (- supply-cap supply-used))
                              (max 0 (- supply-cap supply-used)))))
     (define pending-supply (safe-nonneg-int (hash-ref base-h 'pending-supply 0) 0))
     (define pending-workers (safe-nonneg-int (hash-ref base-h 'pending-workers 0) 0))
     (define depleting-bases
       (safe-nonneg-int (hash-ref base-h 'depleting-bases
                                  (if (or (eq? (hash-ref base-h 'mined-out #f) #t)
                                          (eq? (hash-ref base-h 'mined-out? #f) #t))
                                      1
                                      0))
                        0))
     (define busy-facilities (safe-nonneg-int (hash-ref base-h 'busy-facilities 0) 0))
     (define busy-townhalls (safe-nonneg-int (hash-ref base-h 'busy-townhalls 0) 0))
     (define enemy-workers-killed (safe-nonneg-int (hash-ref base-h 'enemy-workers-killed 0) 0))
     (define mineral-patch-id (safe-nonneg-int (hash-ref base-h 'mineral-patch-id 504) 504))
     (define base-x (safe-coord (hash-ref base-h 'base-x 32.5) 32.5))
     (define base-y (safe-coord (hash-ref base-h 'base-y 32.5) 32.5))
     (define enemy-x (safe-coord (hash-ref base-h 'enemy-x 160.5) 160.5))
     (define enemy-y (safe-coord (hash-ref base-h 'enemy-y 160.5) 160.5))
     (define dir-computed? #f)
     (define cached-ux 0.0)
     (define cached-uy 0.0)
     (define (ensure-dir!)
       (unless dir-computed?
         (let* ([dx (exact->inexact (- enemy-x base-x))]
                [dy (exact->inexact (- enemy-y base-y))]
                [d  (max 1.0 (sqrt (+ (* dx dx) (* dy dy))))])
           (set! cached-ux (/ dx d))
           (set! cached-uy (/ dy d))
           (set! dir-computed? #t))))
     (define raw-nat-x (hash-ref base-h 'natural-x SANITIZE-MISSING))
     (define raw-nat-y (hash-ref base-h 'natural-y SANITIZE-MISSING))
     (define nat-x
       (if (sanitized-tile-coord? raw-nat-x)
           raw-nat-x
           (let ()
             (ensure-dir!)
             (define def-nx (safe-coord (+ base-x (* 18.0 cached-ux)) 45.0))
             (safe-coord (if (eq? raw-nat-x SANITIZE-MISSING) def-nx raw-nat-x) def-nx))))
     (define nat-y
       (if (sanitized-tile-coord? raw-nat-y)
           raw-nat-y
           (let ()
             (ensure-dir!)
             (define def-ny (safe-coord (+ base-y (* 18.0 cached-uy)) 45.0))
             (safe-coord (if (eq? raw-nat-y SANITIZE-MISSING) def-ny raw-nat-y) def-ny))))
     (define raw-au (hash-ref base-h 'ally-units '()))
     (define raw-ab (hash-ref base-h 'ally-buildings '()))
     (define raw-eu (hash-ref base-h 'enemy-units '()))
     (define raw-eb (hash-ref base-h 'enemy-buildings '()))
     (define raw-eff (hash-ref base-h 'effects '()))
     (define ally-units
       (sanitize-record-list raw-au sanitize-unit-record base-x base-y))
     (define ally-buildings
       (sanitize-record-list raw-ab sanitize-bldg-record base-x base-y))
     (define third-x-raw (hash-ref base-h 'third-x #f))
     (define third-y-raw (hash-ref base-h 'third-y #f))
     (define has-explicit-third?
       (and (finite-real? third-x-raw)
            (finite-real? third-y-raw)))
     (define owned-third-th
       (and (not has-explicit-third?)
            (let ([fbx (exact->inexact base-x)]
                  [fby (exact->inexact base-y)]
                  [fnx (exact->inexact nat-x)]
                  [fny (exact->inexact nat-y)])
              (for/first ([b (in-list ally-buildings)]
                          #:when (and (hash? b)
                                      (memq (fast-canonical-structure-sym (hash-ref b 'type 'none))
                                            '(hatchery lair hive nexus command-center orbital-command planetary-fortress))
                                      (let* ([bx (exact->inexact (hash-ref b 'x base-x))]
                                             [by (exact->inexact (hash-ref b 'y base-y))]
                                             [dx1 (fl- bx fbx)]
                                             [dy1 (fl- by fby)]
                                             [dx2 (fl- bx fnx)]
                                             [dy2 (fl- by fny)])
                                        (and (fl> (fl+ (fl* dx1 dx1) (fl* dy1 dy1)) 49.0)
                                             (fl> (fl+ (fl* dx2 dx2) (fl* dy2 dy2)) 49.0)))))
                b))))
     (define third-x
       (if has-explicit-third?
           (safe-coord third-x-raw 60.5)
           (if owned-third-th
               (safe-coord (hash-ref owned-third-th 'x 60.5) 60.5)
               (begin
                 (ensure-dir!)
                 (safe-coord (+ base-x (* 24.25 cached-ux) (* -14.0 cached-uy)) 60.5)))))
     (define third-y
       (if has-explicit-third?
           (safe-coord third-y-raw 40.5)
           (if owned-third-th
               (safe-coord (hash-ref owned-third-th 'y 40.5) 40.5)
               (begin
                 (ensure-dir!)
                 (safe-coord (+ base-y (* 24.25 cached-uy) (* 14.0 cached-ux)) 40.5)))))
     (define raw-eexp-x
       (let ([v (hash-ref base-h 'enemy-expand-x SANITIZE-MISSING)])
         (if (eq? v SANITIZE-MISSING) (hash-ref base-h 'enemy-exp-x SANITIZE-MISSING) v)))
     (define enemy-exp-x
       (if (sanitized-tile-coord? raw-eexp-x)
           raw-eexp-x
           (let ()
             (ensure-dir!)
             (define def-eex (safe-coord (- enemy-x (* 18.0 cached-ux)) 148.0))
             (safe-coord (if (eq? raw-eexp-x SANITIZE-MISSING) def-eex raw-eexp-x) def-eex))))
     (define raw-eexp-y
       (let ([v (hash-ref base-h 'enemy-expand-y SANITIZE-MISSING)])
         (if (eq? v SANITIZE-MISSING) (hash-ref base-h 'enemy-exp-y SANITIZE-MISSING) v)))
     (define enemy-exp-y
       (if (sanitized-tile-coord? raw-eexp-y)
           raw-eexp-y
           (let ()
             (ensure-dir!)
             (define def-eey (safe-coord (- enemy-y (* 18.0 cached-uy)) 148.0))
             (safe-coord (if (eq? raw-eexp-y SANITIZE-MISSING) def-eey raw-eexp-y) def-eey))))
     (define enemy-units
       (sanitize-record-list raw-eu sanitize-unit-record nat-x nat-y))
     (define enemy-buildings
       (sanitize-record-list raw-eb sanitize-bldg-record enemy-x enemy-y))
     (define effects
       (if (and (list? raw-eff) (pair? raw-eff))
           (for/list ([e (in-list raw-eff)]) (sanitize-effect-record e))
           '()))
     (define vis-secs
       (let ([vs (hash-ref base-h 'visible-sectors '(0 1 2 3))])
         (cond
           [(not (list? vs)) '(0 1 2 3)]
           [(for/and ([v (in-list vs)]) (and (exact-integer? v) (>= v 0) (< v 64))) vs]
           [else
            (for/list ([raw (in-list vs)]
                       #:when (let ([idx (if (exact-integer? raw) raw (safe-exact-int raw -1))])
                                (and (>= idx 0) (< idx 64))))
              (if (exact-integer? raw) raw (safe-exact-int raw -1)))])))
     (define res-upgs
       (let ([ru (hash-ref base-h 'researched-upgrades '())])
         (cond
           [(or (not (list? ru)) (null? ru)) '()]
           [(for/and ([u (in-list ru)]) (symbol? u)) ru]
           [else (for/list ([u (in-list ru)] #:when (symbol? u)) u)])))
     (define pend-upgs
       (let ([pu (hash-ref base-h 'pending-upgrades '())])
         (cond
           [(or (not (list? pu)) (null? pu)) '()]
           [(for/and ([u (in-list pu)]) (symbol? u)) pu]
           [else (for/list ([u (in-list pu)] #:when (symbol? u)) u)])))
     (define nuke-points
       (let* ([raw-pts (hash-ref base-h 'nuke-points '())]
              [pts-from-list
               (if (list? raw-pts)
                   (for/list ([p (in-list raw-pts)]
                              #:when (and (pair? p) (real? (car p)) (real? (cdr p))))
                     (cons (safe-coord (car p) nat-x) (safe-coord (cdr p) nat-y)))
                   '())]
              [pts-from-effects
               (for/fold ([acc '()]) ([ef (in-list (if (list? raw-eff) raw-eff '()))] #:when (hash? ef))
                 (define eid (hash-ref ef 'effect-id (hash-ref ef 'id 0)))
                 (define esym (hash-ref ef 'type (hash-ref ef 'effect #f)))
                 (if (or (eqv? eid 7) (eq? esym 'nuke-persistent) (eq? esym 'nuke))
                     (let ([ex (hash-ref ef 'x #f)]
                           [ey (hash-ref ef 'y #f)]
                           [pos-list (hash-ref ef 'positions '())])
                       (cond
                         [(and (real? ex) (real? ey))
                          (cons (cons (safe-coord ex nat-x) (safe-coord ey nat-y)) acc)]
                         [(pair? pos-list)
                          (for/fold ([a2 acc]) ([pp (in-list pos-list)])
                            (cond
                              [(and (pair? pp) (real? (car pp)) (real? (cdr pp)))
                               (cons (cons (safe-coord (car pp) nat-x) (safe-coord (cdr pp) nat-y)) a2)]
                              [(and (hash? pp) (real? (hash-ref pp 'x #f)) (real? (hash-ref pp 'y #f)))
                               (cons (cons (safe-coord (hash-ref pp 'x) nat-x) (safe-coord (hash-ref pp 'y) nat-y)) a2)]
                              [else a2]))]
                         [else acc]))
                     acc))]
              [na-raw (hash-ref base-h 'nuke-alert #f)]
              [pts-from-alert
               (if (and (pair? na-raw) (real? (car na-raw)) (real? (cdr na-raw)))
                   (list (cons (safe-coord (car na-raw) nat-x) (safe-coord (cdr na-raw) nat-y)))
                   '())]
              [combined (append pts-from-list pts-from-effects pts-from-alert)])
         (reverse
          (for/fold ([uniq '()]) ([pt (in-list combined)])
            (if (for/or ([u (in-list uniq)])
                  (and (< (abs (- (car pt) (car u))) 0.5)
                       (< (abs (- (cdr pt) (cdr u))) 0.5)))
                uniq
                (cons pt uniq))))))
     (define nuke-alert
       (let ([na (hash-ref base-h 'nuke-alert #f)])
         (cond
           [(pair? nuke-points) (car nuke-points)]
           [(not na) #f]
           [(pair? na) (cons (safe-coord (car na) nat-x) (safe-coord (cdr na) nat-y))]
           [else (cons nat-x nat-y)])))
     (define out-h
       (if (eq? (hash-ref base-h '__sanitized? #f) #t)
           base-h
           (hash-set base-h '__sanitized? #t)))
     (define-syntax-rule (push-obs-eq k v)
       (unless (eq? (hash-ref base-h k SANITIZE-MISSING) v)
         (set! out-h (hash-set out-h k v))))
     (define-syntax-rule (push-obs-eqv k v)
       (unless (equal? (hash-ref base-h k SANITIZE-MISSING) v)
         (set! out-h (hash-set out-h k v))))
     (define-syntax-rule (push-opt-key k pred? sanitizer)
       (let ([ov (hash-ref base-h k SANITIZE-MISSING)])
         (unless (or (eq? ov SANITIZE-MISSING) (pred? ov))
           (let ([nv (sanitizer ov)])
             (unless (equal? nv ov)
               (set! out-h (hash-set out-h k nv)))))))
     (push-obs-eq 'frame frame)
     (push-obs-eq 'minerals minerals)
     (push-obs-eq 'gas gas)
     (push-obs-eq 'supply-used supply-used)
     (push-obs-eq 'supply-cap supply-cap)
     (push-obs-eq 'supply-left supply-left)
     (push-obs-eq 'pending-supply pending-supply)
     (push-obs-eq 'pending-workers pending-workers)
     (push-obs-eq 'depleting-bases depleting-bases)
     (push-obs-eq 'busy-facilities busy-facilities)
     (push-obs-eq 'busy-townhalls busy-townhalls)
     (push-obs-eq 'enemy-workers-killed enemy-workers-killed)
     (push-obs-eq 'mineral-patch-id mineral-patch-id)
     (push-obs-eqv 'base-x base-x)
     (push-obs-eqv 'base-y base-y)
     (push-obs-eqv 'natural-x nat-x)
     (push-obs-eqv 'natural-y nat-y)
     (push-obs-eqv 'third-x third-x)
     (push-obs-eqv 'third-y third-y)
     (push-obs-eqv 'enemy-x enemy-x)
     (push-obs-eqv 'enemy-y enemy-y)
     (push-obs-eqv 'enemy-expand-x enemy-exp-x)
     (push-obs-eqv 'enemy-exp-x enemy-exp-x)
     (push-obs-eqv 'enemy-expand-y enemy-exp-y)
     (push-obs-eqv 'enemy-exp-y enemy-exp-y)
     (push-obs-eq 'ally-units ally-units)
     (push-obs-eq 'ally-buildings ally-buildings)
     (push-obs-eq 'enemy-units enemy-units)
     (push-obs-eq 'enemy-buildings enemy-buildings)
     (push-obs-eq 'effects effects)
     (push-obs-eq 'visible-sectors vis-secs)
     (push-obs-eq 'researched-upgrades res-upgs)
     (push-obs-eq 'pending-upgrades pend-upgs)
     (push-obs-eqv 'nuke-alert nuke-alert)
     (push-obs-eqv 'nuke-points nuke-points)
     (push-opt-key 'gas-workers sanitized-nonneg-int? sanitize-opt-nonneg-0)
     (push-opt-key 'our-terrain-z exact-integer? sanitize-opt-exact-10)
     (push-opt-key 'enemy-terrain-z exact-integer? sanitize-opt-exact-10)
     (push-opt-key 'mineral-harvesters sanitized-nonneg-int? sanitize-opt-nonneg-0)
     (push-opt-key 'ideal-mineral-harvesters sanitized-nonneg-int? sanitize-opt-nonneg-0)
     (push-opt-key 'gas-harvesters sanitized-nonneg-int? sanitize-opt-nonneg-0)
     (push-opt-key 'ideal-gas-harvesters sanitized-nonneg-int? sanitize-opt-nonneg-0)
     (push-opt-key 'army-supply sanitized-nonneg-int? sanitize-opt-nonneg-0)
     out-h]))

(define (detect-actual-race-from-obs obs fallback-race)
  (define obs-race (hash-ref obs 'actual-race (hash-ref obs 'race #f)))
  (cond
    [(and obs-race (not (memq obs-race '(Random random "Random" "random"))))
     (normalize-race-sym obs-race)]
    [else
     (define all-types
       (append (map (lambda (u) (fast-canonical-unit-sym (unit-type-sym u)))
                    (hash-ref obs 'ally-units '()))
               (map (lambda (b) (fast-canonical-structure-sym (unit-type-sym b)))
                    (hash-ref obs 'ally-buildings '()))))
     (cond
       [(ormap (lambda (t) (memq t '(drone overlord overseer hatchery lair hive spawning-pool zergling roach queen))) all-types)
        'Zerg]
       [(ormap (lambda (t) (memq t '(probe nexus pylon gateway warp-gate forge cybernetics-core zealot stalker adept sentry))) all-types)
        'Protoss]
       [(ormap (lambda (t) (memq t '(scv command-center orbital-command planetary-fortress supply-depot barracks factory starport marine marauder siege-tank))) all-types)
        'Terran]
       [else fallback-race])]))

;; =============================================================================
;; Layer 1: Spatial Perception & Frame-0 Random Race Resolution
;; =============================================================================

(define (step-layer1-perception! rt raw-obs #:sanitized? [sanitized? #f])
  (define obs (if sanitized? raw-obs (sanitize-obs-hash raw-obs)))
  (define frame (hash-ref obs 'frame 0))
  (define resolved-race (detect-actual-race-from-obs obs (live-bot-runtime-actual-race rt)))
  (set-live-bot-runtime-actual-race! rt resolved-race)
  (set-mastermind-state-race! (live-bot-runtime-mastermind rt) resolved-race)
  (set-mirror-mind-state-our-race! (live-bot-runtime-mirror-mind rt) resolved-race)
  (when (and (eq? (live-bot-runtime-configured-race rt) 'Random)
             (not (eq? resolved-race 'Random))
             (not (live-bot-runtime-doctrine rt)))
    (define cur-pers (mastermind-state-personality (live-bot-runtime-mastermind rt)))
    (define target-pers (default-personality-for-race resolved-race))
    (when (and (bot-personality? cur-pers)
               (bot-personality? target-pers)
               (memq (bot-personality-name cur-pers)
                     '(SCARLETT-CREEP-SWARM-PERSONALITY
                       MARV-MACRO-OPEN-PERSONALITY
                       CLEM-TEMPO-MULTITASK-PERSONALITY))
               (not (eq? (bot-personality-name cur-pers)
                         (bot-personality-name target-pers))))
      (set-mastermind-state-personality! (live-bot-runtime-mastermind rt) target-pers)))
  (define (finite-nonneg-coord? v)
    (if (flonum? v)
        (and (fl>= v 0.0) (fl= (fl- v v) 0.0))
        (and (real? v) (>= v 0) (= (- v v) 0))))
  (define ally-units
    (let ([raw (hash-ref obs 'ally-units '())])
      (let loop ([rem raw])
        (cond
          [(null? rem) raw]
          [(let ([u (car rem)])
             (and (hash? u)
                  (not (and (finite-nonneg-coord? (hash-ref u 'x #f))
                            (finite-nonneg-coord? (hash-ref u 'y #f))))))
           (map (lambda (u)
                  (if (hash? u)
                      (let ([ux (hash-ref u 'x #f)]
                            [uy (hash-ref u 'y #f)])
                        (if (and (finite-nonneg-coord? ux) (finite-nonneg-coord? uy))
                            u
                            (let ([nx (safe-nonneg-int ux 32)]
                                  [ny (safe-nonneg-int uy 32)])
                              (if (and (eqv? ux nx) (eqv? uy ny))
                                  u
                                  (hash-set (hash-set u 'x nx) 'y ny)))))
                      u))
                raw)]
          [else (loop (cdr rem))]))))
  (define enemy-units
    (let ([raw (hash-ref obs 'enemy-units '())])
      (let loop ([rem raw])
        (cond
          [(null? rem) raw]
          [(let ([u (car rem)])
             (and (hash? u)
                  (not (and (finite-nonneg-coord? (hash-ref u 'x #f))
                            (finite-nonneg-coord? (hash-ref u 'y #f))))))
           (map (lambda (u)
                  (if (hash? u)
                      (let ([ux (hash-ref u 'x #f)]
                            [uy (hash-ref u 'y #f)])
                        (if (and (finite-nonneg-coord? ux) (finite-nonneg-coord? uy))
                            u
                            (let ([nx (safe-nonneg-int ux 160)]
                                  [ny (safe-nonneg-int uy 160)])
                              (if (and (eqv? ux nx) (eqv? uy ny))
                                  u
                                  (hash-set (hash-set u 'x nx) 'y ny)))))
                      u))
                raw)]
          [else (loop (cdr rem))]))))
  (define visible-sectors (hash-ref obs 'visible-sectors '(0 1 2 3)))
  ;; Loop 64 P0 #0 (`#1738`): Hoist Opponent World Model into Layer 1 Perception BEFORE
  ;; `step-layer1c-mirror-mind!` so Mirror Mind consumes fresh same-frame opponent beliefs
  ;; (zero 1-step stale belief lag), while L2 Phase 6 reuses the same-frame summary!
  (define owm-inst-l1 (rt-opponent-world-model rt))
  (define live-obs-owm-l1? (and (hash? raw-obs) (hash-has-key? raw-obs 'mineral-harvesters)))
  (when (and owm-inst-l1
             (or (eq? (hash-ref obs 'enable-opponent-world-model #f) #t)
                 (and live-obs-owm-l1?
                      (or (<= frame 128)
                          (>= (opponent-world-model-last-frame owm-inst-l1) 0)))))
    (define prev-tel-l1 (live-bot-runtime-last-telemetry rt))
    (define raw-er-l1 (hash-ref obs 'enemy-race 'Unknown))
    (define eff-er-l1
      (if (memq raw-er-l1 '(Protoss Terran Zerg))
          raw-er-l1
          (if (hash? prev-tel-l1)
              (hash-ref prev-tel-l1 'effective-enemy-race raw-er-l1)
              raw-er-l1)))
    (define enemy-exp-x-l1
      (hash-ref obs 'enemy-expand-x
                (lambda ()
                  (hash-ref obs 'enemy-exp-x
                            (lambda () (safe-coord (* 0.85 (hash-ref obs 'enemy-x 160.0)) 148.0))))))
    (define enemy-exp-y-l1
      (hash-ref obs 'enemy-expand-y
                (lambda ()
                  (hash-ref obs 'enemy-exp-y
                            (lambda () (safe-coord (* 0.85 (hash-ref obs 'enemy-y 160.0)) 148.0))))))
    (step-opponent-world-model!
     owm-inst-l1
     (hash-set* obs
                'enemy-race eff-er-l1
                'enemy-exp-x enemy-exp-x-l1
                'enemy-exp-y enemy-exp-y-l1)))
  (perception-grid-ingest-frame!
   (live-bot-runtime-perception rt)
   frame
   ally-units
   enemy-units
   visible-sectors))

;; =============================================================================
;; Layer 1b: ZeroSpace Mastermind & Posture State Machine
;; =============================================================================

(define filter-rush-threat-cache-cell (make-thread-cell #f))

(define (filter-rush-threat-enemies enemy-units [base-x 32.5] [base-y 32.5] [nat-x 45.0] [nat-y 45.0])
  (define bx (if (flonum? base-x) base-x (exact->inexact base-x)))
  (define by (if (flonum? base-y) base-y (exact->inexact base-y)))
  (define nx (if (flonum? nat-x) nat-x (exact->inexact nat-x)))
  (define ny (if (flonum? nat-y) nat-y (exact->inexact nat-y)))
  (define cached (thread-cell-ref filter-rush-threat-cache-cell))
  (if (and cached
           (eq? (vector-ref cached 0) enemy-units)
           (fl= (vector-ref cached 1) bx)
           (fl= (vector-ref cached 2) by)
           (fl= (vector-ref cached 3) nx)
           (fl= (vector-ref cached 4) ny))
      (vector-ref cached 5)
      (let ([res
             (for/list ([e (in-list (if (list? enemy-units) enemy-units '()))]
                        #:when (and (hash? e)
                                    (let ([t (unit-type-sym e)])
                                      (and (not (fast-scout-or-noncombat-enemy-sym? t))
                                           (not (eq? (hash-ref e 'changeling? #f) #t))
                                           (not (eq? (hash-ref e 'is-hallucination #f) #t))
                                           (not (eq? (hash-ref e 'hallucination? #f) #t))
                                           (not (eq? (hash-ref e 'hallucination #f) #t))
                                           (or (not (or (eq? t 'drone) (eq? t 'probe) (eq? t 'scv)))
                                               (let ([ex-raw (safe-coord (hash-ref e 'x nx) nx)]
                                                     [ey-raw (safe-coord (hash-ref e 'y ny) ny)])
                                                 (define ex (if (flonum? ex-raw) ex-raw (exact->inexact ex-raw)))
                                                 (define ey (if (flonum? ey-raw) ey-raw (exact->inexact ey-raw)))
                                                 (define dx1 (fl- bx ex))
                                                 (define dy1 (fl- by ey))
                                                 (define dx2 (fl- nx ex))
                                                 (define dy2 (fl- ny ey))
                                                 (or (fl<= (fl+ (fl* dx1 dx1) (fl* dy1 dy1)) 2025.0)
                                                     (fl<= (fl+ (fl* dx2 dx2) (fl* dy2 dy2)) 2025.0))))))))
               e)])
        (when (and (list? enemy-units)
                   (or (null? enemy-units)
                       (and (hash? (car enemy-units)) (immutable? (car enemy-units)))))
          (thread-cell-set! filter-rush-threat-cache-cell (vector enemy-units bx by nx ny res)))
        res)))

(define (l1b-enemy-army-supply-and-workers obs rt frame)
  (define enemy-units (hash-ref obs 'enemy-units '()))
  (define enemy-bldgs (hash-ref obs 'enemy-buildings '()))
  (define wstate (rt-wave-loss-state rt))
  (define vis-enemy-army-sup
    (for/fold ([sup 0.0]) ([e (in-list enemy-units)])
      (if (and (hash? e)
               (let ([ut (unit-type-sym e)])
                 (and (fast-enemy-unit-targetable? ut)
                      (not (hash-ref NON-COMBAT-AND-SCOUT-ENEMY-HT ut #f))
                      (not (combat-unit-excluded-sym? ut))
                      (not (eq? (hash-ref e 'is-hallucination #f) #t))
                      (not (eq? (hash-ref e 'hallucination #f) #t))
                      (not (eq? (hash-ref e 'hallucination? #f) #t)))))
          (+ sup (max 0.5 (exact->inexact (sc2-supply-cost (fast-canonical-unit-sym (unit-type-sym e))))))
          sup)))
  (define vis-enemy-workers
    (for/sum ([e (in-list enemy-units)])
      (if (and (hash? e)
               (memq (fast-canonical-unit-sym (unit-type-sym e)) '(drone probe scv)))
          1
          0)))
  (define vis-enemy-ths
    (for/sum ([eb (in-list enemy-bldgs)])
      (if (and (hash? eb)
               (memq (fast-canonical-structure-sym (unit-type-sym eb))
                     '(command-center orbital-command planetary-fortress nexus hatchery lair hive)))
          1
          0)))
  (define remembered-sup (exact->inexact (hash-ref wstate 'recent-enemy-army-supply 0.0)))
  (define remembered-frame (hash-ref wstate 'recent-enemy-army-frame -9999))
  (define decayed-remembered
    (if (> remembered-sup 0.0)
        (max 0.0 (* remembered-sup (max 0.0 (- 1.0 (/ (max 0 (- frame remembered-frame)) 672.0)))))
        0.0))
  (define explicit-army (hash-ref obs 'estimated-enemy-army-supply #f))
  (define est-enemy-army
    (cond
      [(finite-real? explicit-army) (max 0.0 (exact->inexact explicit-army))]
      [(> vis-enemy-army-sup 0.0) (max vis-enemy-army-sup decayed-remembered)]
      [else decayed-remembered]))
  (define mmstate (live-bot-runtime-mirror-mind rt))
  (define mmledger (and mmstate (mirror-mind-state-last-shadow-ledger mmstate)))
  (define explicit-workers (hash-ref obs 'estimated-enemy-workers #f))
  (define est-enemy-workers
    (cond
      [(real? explicit-workers) (max 0 (inexact->exact (round explicit-workers)))]
      [else
       (define ledger-workers
         (if (shadow-ledger? mmledger)
             (inexact->exact (round (max 0.0 (exact->inexact (shadow-ledger-predicted-enemy-workers mmledger)))))
             0))
       (max vis-enemy-workers ledger-workers (* 12 (max 1 vis-enemy-ths)))]))
  (values vis-enemy-army-sup est-enemy-army est-enemy-workers vis-enemy-ths))

(define (compute-next-posture rt raw-obs [raw-fap-score 0]
                              #:rush-enemies [pre-rush-enemies #f]
                              #:ally-unit-types [pre-ally-unit-types #f]
                              #:ally-bldgs [pre-ally-bldgs #f]
                              #:combat-army-supply [pre-combat-sup #f]
                              #:est-enemy-army-supply [pre-est-enemy-army #f]
                              #:worker-count [pre-worker-cnt #f]
                              #:est-enemy-workers [pre-est-enemy-workers #f]
                              #:wave-loss-pullback? [pre-wave-loss-pullback? #f])
  (define obs (sanitize-obs-hash raw-obs))
  (define fap-score (safe-finite-real (hash-ref obs 'fap-score raw-fap-score) 0.0))
  (define frame (hash-ref obs 'frame 0))
  (define cfg-race (live-bot-runtime-configured-race rt))
  (define act-race (live-bot-runtime-actual-race rt))
  (define cur (live-bot-runtime-posture rt))
  (define base-x (hash-ref obs 'base-x 32.5))
  (define base-y (hash-ref obs 'base-y 32.5))
  (define nat-x (hash-ref obs 'natural-x 45.0))
  (define nat-y (hash-ref obs 'natural-y 45.0))
  (define ally-units (hash-ref obs 'ally-units '()))
  (define enemy-units (hash-ref obs 'enemy-units '()))
  (define rush-enemies
    (or pre-rush-enemies
        (filter-rush-threat-enemies enemy-units base-x base-y nat-x nat-y)))
  (define ally-unit-types
    (or pre-ally-unit-types
        (map unit-type-sym ally-units)))
  (define ally-bldgs
    (or pre-ally-bldgs
        (map unit-type-sym (hash-ref obs 'ally-buildings '()))))

  (define has-economy-army-obs?
    (or (hash-has-key? raw-obs 'mineral-harvesters)
        (hash-has-key? raw-obs 'supply-used)
        (hash-has-key? raw-obs 'supply-cap)
        (hash-has-key? raw-obs 'army-supply)
        (hash-has-key? raw-obs 'food-army)
        (hash-has-key? raw-obs 'workers)
        (hash-has-key? raw-obs 'food-workers)
        (pair? (hash-ref raw-obs 'ally-units '()))))
  (define combat-army-supply
    (if (real? pre-combat-sup)
        (exact->inexact pre-combat-sup)
        (let ([unit-sup
               (for/fold ([sup 0.0]) ([u (in-list ally-units)])
                 (if (and (hash? u)
                          (let ([t (unit-type-sym u)])
                            (and (not (combat-unit-excluded-sym? t))
                                 (not (eq? (hash-ref u 'is-hallucination #f) #t))
                                 (not (eq? (hash-ref u 'hallucination #f) #t))
                                 (not (eq? (hash-ref u 'hallucination? #f) #t)))))
                     (+ sup (max 0.5 (exact->inexact (sc2-supply-cost (fast-canonical-unit-sym (unit-type-sym u))))))
                     sup))])
          (if (> unit-sup 0.0)
              unit-sup
              (exact->inexact (safe-finite-real (hash-ref obs 'army-supply (hash-ref obs 'food-army 0)) 0.0))))))
  (define worker-count
    (if (real? pre-worker-cnt)
        (inexact->exact (round pre-worker-cnt))
        (let ([raw-w (for/sum ([t (in-list ally-unit-types)])
                       (if (memq t '(drone probe scv)) 1 0))])
          (if (<= raw-w 2)
              (max raw-w
                   (safe-nonneg-int (hash-ref obs 'workers (hash-ref obs 'food-workers 0)) 0)
                   (+ (safe-nonneg-int (hash-ref obs 'mineral-harvesters 0) 0)
                      (safe-nonneg-int (hash-ref obs 'gas-harvesters 0) 0)))
              raw-w))))
  (define-values (_vis-e-sup computed-est-e-sup computed-est-e-workers _vis-e-ths)
    (if (and (real? pre-est-enemy-army) (real? pre-est-enemy-workers))
        (values 0.0 (exact->inexact pre-est-enemy-army) (inexact->exact (round pre-est-enemy-workers)) 0)
        (l1b-enemy-army-supply-and-workers obs rt frame)))
  (define est-enemy-army-supply
    (if (real? pre-est-enemy-army) (exact->inexact pre-est-enemy-army) computed-est-e-sup))
  (define est-enemy-workers
    (if (real? pre-est-enemy-workers) (inexact->exact (round pre-est-enemy-workers)) computed-est-e-workers))
  (define food-used (safe-nonneg-int (hash-ref obs 'supply-used 12) 12))
  (define food-cap (safe-nonneg-int (hash-ref obs 'supply-cap 15) 15))
  (define not-supply-blocked? (or (< food-used food-cap) (>= food-cap 194)))
  (define wstate (rt-wave-loss-state rt))
  (define pullback-until (hash-ref wstate 'pullback-until-frame -1))
  (define wave-pullback?
    (or pre-wave-loss-pullback?
        (< frame pullback-until)))

  (define in-crisis?
    (not (not (memq cur '(EarlyScoutCrisis CrisisZealotRush CrisisZerglingFlood CrisisEarlyBust)))))
  (define in-victory?
    (not (not (memq cur '(MothmanApexVictory SwarmVictory ProtossArmadaVictory
                          TerranDominionVictory ChameleonSupremeVictory)))))
  (define in-midgame-recovery-or-contain?
    (not (not (memq cur '(StalkerImmortalColossus MacroHydraLurker BioTankMedivac
                          MidGameBioTankContain DragoonReaverVanguard MutaLurkerContain
                          VesselGhostPush TriRaceVanguardContain)))))

  ;; Hysteresis band [-8, -2] (±3 around -5) for crisis entry/exit
  (define rush-fap-threat?
    (if in-crisis?
        (<= fap-score -2.0)
        (< fap-score -8.0)))

  (define rush-threat?
    (and (< frame 2500)
         (>= (length rush-enemies) 3)
         rush-fap-threat?))

  ;; Multi-factor Victory gates (Bug 2):
  ;; Enter *Victory ONLY with real army, economy, and supply headroom:
  ;;   army >= 28, army >= 1.25 * est-enemy-army, workers >= min(36, 0.85 * est-enemy-workers), not supply-blocked.
  ;; Pull back to macro-contain/defend when army < 0.85 * est-enemy-army OR wave loses >35% supply without killing a base.
  (define victory-enter-multi-factor-ok?
    (or (not has-economy-army-obs?)
        (and (>= combat-army-supply 28.0)
             (>= combat-army-supply (* 1.25 est-enemy-army-supply))
             (>= worker-count (min 36 (* 0.85 est-enemy-workers)))
             not-supply-blocked?
             (not wave-pullback?))))
  (define victory-pullback-triggered?
    (and in-victory?
         has-economy-army-obs?
         (or wave-pullback?
             (< combat-army-supply 16.0)
             (and (> est-enemy-army-supply 0.0)
                  (< combat-army-supply (* 0.85 est-enemy-army-supply))))))

  ;; Hysteresis deadband: enter >= +13.0 (or no rush & >= +8.0), exit <= -5.0, catastrophic < -15.0
  (define catastrophic-deficit? (or (< fap-score -15.0) victory-pullback-triggered?))
  (define victory-fap-ok?
    (cond
      [catastrophic-deficit? #f]
      [in-victory?           (> fap-score -5.0)]
      [else
       (and victory-enter-multi-factor-ok?
            (or (>= fap-score 13.0)
                (and (null? rush-enemies) (>= fap-score 8.0))))]))

  (cond
    [(and (eq? cfg-race 'Random)
          (or (eq? act-race 'Random)
              (not (hash-has-key? raw-obs 'mineral-harvesters))))
     (define victory-ready?
       (or (>= frame 3500)
           (memq 'ghost ally-unit-types)
           (memq 'colossus ally-unit-types)
           (memq 'corruptor ally-unit-types)
           in-victory?))
     (cond
       [rush-threat? 'EarlyScoutCrisis]
       [(and victory-ready? victory-fap-ok?)
        'MothmanApexVictory]
       [(and victory-ready? catastrophic-deficit?)
        'MidGameBioTankContain]
       [(and victory-ready? (eq? cur 'MidGameBioTankContain))
        'MidGameBioTankContain]
       [(or (>= frame 1800)
            (memq 'starport ally-bldgs)
            (memq 'spire ally-bldgs)
            (memq 'robotics-facility ally-bldgs))
        'TriRaceVanguardContain]
       [(>= frame 350) 'AdaptiveCounterRecovery]
       [else 'RandomRollOpening])]
    [(eq? act-race 'Zerg)
     (define victory-ready?
       (or (>= frame 3200)
           (memq 'hive ally-bldgs)
           (memq 'corruptor ally-unit-types)
           in-victory?))
     (cond
       [rush-threat? 'CrisisZealotRush]
       [(and victory-ready? victory-fap-ok?)
        'SwarmVictory]
       [(and victory-ready? catastrophic-deficit?)
        'MacroHydraLurker]
       [(and victory-ready? (eq? cur 'MacroHydraLurker))
        'MacroHydraLurker]
       [(or (memq 'lair ally-bldgs) (memq 'spire ally-bldgs) (>= frame 1800))
        'MutaLurkerContain]
       [(or (>= frame 300) (memq 'spawning-pool ally-bldgs))
        'SunkenLairRecovery]
       [else 'Macro12Hatch])]
    [(eq? act-race 'Protoss)
     (define victory-ready?
       (or (>= frame 2600)
           (memq 'stalker ally-unit-types)
           (memq 'colossus ally-unit-types)
           in-victory?))
     (cond
       [rush-threat? 'CrisisZerglingFlood]
       [(and victory-ready? victory-fap-ok?)
        'ProtossArmadaVictory]
       [(and victory-ready? catastrophic-deficit?)
        'StalkerImmortalColossus]
       [(and victory-ready? (eq? cur 'StalkerImmortalColossus))
        'StalkerImmortalColossus]
       [(or (memq 'cybernetics-core ally-bldgs) (memq 'robotics-facility ally-bldgs) (>= frame 1800))
        'DragoonReaverVanguard]
       [(or (>= frame 300) (memq 'gateway ally-bldgs) (memq 'warp-gate ally-bldgs) (memq 'forge ally-bldgs))
        'CannonWallRecovery]
       [else 'ForgeFastExpand])]
    [else ;; Terran
     (define victory-ready?
       (or (>= frame 3200)
           (memq 'ghost ally-unit-types)
           in-victory?))
     (cond
       [rush-threat? 'CrisisEarlyBust]
       [(and victory-ready? victory-fap-ok?)
        'MothmanApexVictory]
       [(and victory-ready? catastrophic-deficit?)
        'BioTankMedivac]
       [(and victory-ready? (eq? cur 'BioTankMedivac))
        'BioTankMedivac]
       [(or (memq 'starport ally-bldgs) (memq 'siege-tank ally-unit-types) (>= frame 1800))
        'VesselGhostPush]
       ;; L59-P2 + L63B Bug #1B:
       ;; In live matches before 2:00 (< 2688f), NEVER enter `BunkerSiegeRecovery` on a single
       ;; enemy worker scout (<= 1 worker, 0 combat units in `rush-enemies`); require at least
       ;; 1 combat unit or >= 2 rush workers (or recovering from `CrisisEarlyBust`).
       [(if (and (hash-has-key? raw-obs 'mineral-harvesters) (< frame 2688))
            (let-values ([(w-cnt c-cnt)
                          (for/fold ([w 0] [c 0]) ([e (in-list rush-enemies)])
                            (define et (unit-type-sym e))
                            (if (or (eq? et 'drone) (eq? et 'probe) (eq? et 'scv))
                                (values (add1 w) c)
                                (values w (add1 c))))])
              (or (> c-cnt 0) (>= w-cnt 2) (eq? cur 'CrisisEarlyBust)))
            (or (>= frame 300) (memq 'barracks ally-bldgs)))
        'BunkerSiegeRecovery]
       [else 'OneRaxFE])]))

(define (step-layer1b-mastermind! rt raw-obs #:sanitized? [sanitized? #f])
  (define obs (if sanitized? raw-obs (sanitize-obs-hash raw-obs)))
  (define frame (safe-nonneg-int (hash-ref obs 'frame 0) 0))
  (define ally-units (hash-ref obs 'ally-units '()))
  (define enemy-units (hash-ref obs 'enemy-units '()))
  (define enemy-bldgs (hash-ref obs 'enemy-buildings '()))
  (define base-x (hash-ref obs 'base-x 32.5))
  (define base-y (hash-ref obs 'base-y 32.5))
  (define nat-x (hash-ref obs 'natural-x 45.0))
  (define nat-y (hash-ref obs 'natural-y 45.0))
  (define ally-combat-rev '())
  (define ally-unit-types-rev '())
  (define worker-cnt 0)
  (define combat-army-supply 0.0)
  (for ([u (in-list ally-units)])
    (define t (unit-type-sym u))
    (set! ally-unit-types-rev (cons t ally-unit-types-rev))
    (when (hash? u)
      (when (memq t '(drone probe scv))
        (set! worker-cnt (add1 worker-cnt)))
      (when (and (not (combat-unit-excluded-sym? t))
                 (not (eq? (hash-ref u 'is-hallucination #f) #t))
                 (not (eq? (hash-ref u 'hallucination #f) #t))
                 (not (eq? (hash-ref u 'hallucination? #f) #t)))
        (set! combat-army-supply
              (+ combat-army-supply
                 (max 0.5 (exact->inexact (sc2-supply-cost (fast-canonical-unit-sym t))))))
        (set! ally-combat-rev (cons u ally-combat-rev)))))
  (define eff-worker-cnt
    (if (<= worker-cnt 2)
        (max worker-cnt
             (safe-nonneg-int (hash-ref obs 'workers (hash-ref obs 'food-workers 0)) 0)
             (+ (safe-nonneg-int (hash-ref obs 'mineral-harvesters 0) 0)
                (safe-nonneg-int (hash-ref obs 'gas-harvesters 0) 0)))
        worker-cnt))
  (define ally-combat (reverse ally-combat-rev))
  (define ally-unit-types (reverse ally-unit-types-rev))
  (define enemy-combat (filter-rush-threat-enemies enemy-units base-x base-y nat-x nat-y))
  (define-values (vis-enemy-army-sup est-enemy-army-sup est-enemy-workers _vis-e-ths)
    (l1b-enemy-army-supply-and-workers obs rt frame))
  ;; Update remembered enemy army supply & wave-loss (>35% supply without enemy base kill) state
  (define wstate (rt-wave-loss-state rt))
  (when (<= frame 4)
    (hash-clear! wstate))
  (when (> vis-enemy-army-sup 0.0)
    (hash-set! wstate 'recent-enemy-army-supply
               (if (or (>= vis-enemy-army-sup (hash-ref wstate 'recent-enemy-army-supply 0.0))
                       (> (- frame (hash-ref wstate 'recent-enemy-army-frame -9999)) 112))
                   vis-enemy-army-sup
                   (hash-ref wstate 'recent-enemy-army-supply 0.0)))
    (hash-set! wstate 'recent-enemy-army-frame frame))
  ;; Detect enemy Town Hall destruction when a previously seen enemy TH vanishes under friendly vision
  (define seen-th-coords (hash-ref wstate 'seen-enemy-ths (hash)))
  (define cur-th-coords
    (for/fold ([acc (hash)]) ([eb (in-list enemy-bldgs)])
      (if (and (hash? eb)
               (memq (fast-canonical-structure-sym (unit-type-sym eb))
                     '(command-center orbital-command planetary-fortress nexus hatchery lair hive)))
          (let ([tid (hash-ref eb 'id #f)]
                [ex (hash-ref eb 'x #f)]
                [ey (hash-ref eb 'y #f)])
            (if (and (exact-integer? tid) (> tid 0) (real? ex) (real? ey))
                (hash-set acc tid (cons (exact->inexact ex) (exact->inexact ey)))
                acc))
          acc)))
  (define base-killed-this-step?
    (for/or ([(tid xy) (in-hash seen-th-coords)])
      (and (not (hash-has-key? cur-th-coords tid))
           (for/or ([u (in-list ally-combat)])
             (<= (fast-dist2d (hash-ref u 'x 9999.0) (hash-ref u 'y 9999.0) (car xy) (cdr xy))
                 20.0)))))
  (hash-set! wstate 'seen-enemy-ths
             (for/fold ([m cur-th-coords]) ([(tid xy) (in-hash seen-th-coords)])
               (if (or (hash-has-key? cur-th-coords tid) base-killed-this-step?)
                   m
                   ;; Keep unkilled TH coords up to ~45s so destruction is caught when scouted
                   (hash-set m tid xy))))
  (when base-killed-this-step?
    (hash-set! wstate 'killed-base-since-peak? #t)
    (hash-set! wstate 'peak-wave-supply combat-army-supply))
  (define cur-posture-now (live-bot-runtime-posture rt))
  (define attack-wave-now?
    (or (not (not (memq cur-posture-now '(MothmanApexVictory SwarmVictory ProtossArmadaVictory
                                           TerranDominionVictory ChameleonSupremeVictory))))
        (eq? (hash-ref (rt-bistable-states rt) 'army-attack-wave #f) #t)))
  (define wave-loss-pullback? #f)
  (cond
    [attack-wave-now?
     (define prev-peak (exact->inexact (hash-ref wstate 'peak-wave-supply 0.0)))
     (when (not (hash-ref wstate 'wave-active? #f))
       (hash-set! wstate 'wave-active? #t)
       (hash-set! wstate 'killed-base-since-peak? #f)
       (hash-set! wstate 'peak-wave-supply combat-army-supply))
     (define cur-peak (max prev-peak combat-army-supply))
     (hash-set! wstate 'peak-wave-supply cur-peak)
     (when (or (and (> est-enemy-army-sup 0.0)
                    (< combat-army-supply (* 0.85 est-enemy-army-sup)))
               (and (>= cur-peak 16.0)
                    (< combat-army-supply (* 0.65 cur-peak))
                    (not (hash-ref wstate 'killed-base-since-peak? #f))))
       (set! wave-loss-pullback? #t)
       (hash-set! wstate 'pullback-until-frame (+ frame 224))
       (hash-set! wstate 'wave-active? #f)
       (hash-set! wstate 'peak-wave-supply 0.0))]
    [else
     (hash-set! wstate 'wave-active? #f)
     (hash-set! wstate 'peak-wave-supply 0.0)])
  (hash-set! wstate 'est-enemy-army-supply est-enemy-army-sup)
  (hash-set! wstate 'combat-army-supply combat-army-supply)
  (define fap-score
    (let ([ov (hash-ref obs 'fap-score #f)])
      (if (finite-real? ov)
          (safe-finite-real ov 0.0)
          (fap-evaluate-engagement ally-combat enemy-combat))))
  (define ally-bldgs (map unit-type-sym (hash-ref obs 'ally-buildings '())))
  (define mstate (live-bot-runtime-mastermind rt))
  (step-double-reaction! mstate
                         #:fap-score fap-score
                         #:enemy-units enemy-units
                         #:ally-buildings ally-bldgs
                         #:self-workers (max 4 eff-worker-cnt)
                         #:enemy-workers (max 4 est-enemy-workers)
                         #:self-army (inexact->exact (round (* 50.0 combat-army-supply)))
                         #:enemy-army (inexact->exact (round (* 50.0 est-enemy-army-sup))))
  (when (live-bot-runtime-doctrine rt)
    (define new-p (step-doctrine-loadout! (live-bot-runtime-doctrine rt)
                                          #:fap-score fap-score
                                          #:under-rush? (< fap-score -20)))
    (set-mastermind-state-personality! mstate new-p))
  (define next-posture
    (compute-next-posture rt obs fap-score
                          #:rush-enemies enemy-combat
                          #:ally-unit-types ally-unit-types
                          #:ally-bldgs ally-bldgs
                          #:combat-army-supply combat-army-supply
                          #:est-enemy-army-supply est-enemy-army-sup
                          #:worker-count eff-worker-cnt
                          #:est-enemy-workers est-enemy-workers
                          #:wave-loss-pullback? wave-loss-pullback?))
  (define old-posture (live-bot-runtime-posture rt))
  (define posture-actions
    (if (not (eq? next-posture old-posture))
        (let* ([new-hist (append (live-bot-runtime-posture-history rt) (list next-posture))]
               [capped-hist (if (> (length new-hist) 32)
                                (drop new-hist (- (length new-hist) 32))
                                new-hist)])
          (set-live-bot-runtime-posture! rt next-posture)
          (set-live-bot-runtime-posture-history! rt capped-hist)
          (list (list 'posture-transition next-posture)))
        '()))
  (values posture-actions fap-score))

;; =============================================================================
;; Layer 1c: Adaptive Mirror-Mind Opponent Prediction Layer
;; =============================================================================

;; W5-P0-1c-rt: Strip passive CreepTumors before crossing the Typed/Untyped boundary into
;; `step-mirror-mind-predictor!` (cuts L1c 3.88ms -> 0.66ms in 300-tumor ZvZ while keeping
;; at most 1 enemy tumor if no other enemy units/buildings exist for Zerg race inference).
(define (runtime-strip-creep-tumors-list xs [keep-one-if-all-tumors? #f])
  (if (not (pair? xs))
      xs
      (let loop ([rem xs] [acc '()] [first-tumor #f] [stripped? #f])
        (cond
          [(null? rem)
           (cond
             [(not stripped?) xs]
             [(and keep-one-if-all-tumors? (null? acc) first-tumor)
              (list first-tumor)]
             [else (reverse acc)])]
          [else
           (define item (car rem))
           (if (and (hash? item)
                    (hash-ref RUNTIME-TUMOR-SET (unit-type-sym item) #f))
               (loop (cdr rem) acc (or first-tumor item) #t)
               (loop (cdr rem) (cons item acc) first-tumor stripped?))]))))

;; L36-P0-3 (`#834`): Compute our researched combat upgrade tier matching
;; `infer-enemy-implied-tech-and-upgrades` (`max-atk + max-arm + max-shd`, floor 1 if any upgrade)
;; so `mirror-enemy-upgrade-advantage` no longer compares enemy tier against hardcoded `0`!
(define (runtime-compute-our-upgrade-tier researched-upgs)
  (if (not (list? researched-upgs))
      0
      (let-values ([(ma mr ms any?)
                    (for/fold ([a 0] [r 0] [s 0] [any? #f]) ([u (in-list researched-upgs)])
                      (define sym (cond [(symbol? u) u] [(string? u) (string->symbol (string-downcase u))] [else #f]))
                      (if (not sym)
                          (values a r s any?)
                          (let* ([st (symbol->string sym)]
                                 [lvl (cond
                                        [(or (regexp-match? #rx"(^|-)3$|level-?3$" st)
                                             (regexp-match? #rx"level3$" st)) 3]
                                        [(or (regexp-match? #rx"(^|-)2$|level-?2$" st)
                                             (regexp-match? #rx"level2$" st)) 2]
                                        [(or (regexp-match? #rx"(^|-)1$|level-?1$" st)
                                             (regexp-match? #rx"level1$" st)) 1]
                                        [else 0])]
                                 [is-shd? (and (> lvl 0) (regexp-match? #rx"shield" st))]
                                 [is-arm? (and (> lvl 0) (not is-shd?) (regexp-match? #rx"armor|plating|carapace" st))]
                                 [is-atk? (and (> lvl 0) (not is-shd?) (not is-arm?) (regexp-match? #rx"weapon|attack|missile|melee" st))])
                            (values (if is-atk? (max a lvl) a)
                                    (if is-arm? (max r lvl) r)
                                    (if is-shd? (max s lvl) s)
                                    #t))))])
        (max (+ ma mr ms) (if any? 1 0)))))

(define (step-layer1c-mirror-mind! rt obs)
  (define mmstate (live-bot-runtime-mirror-mind rt))
  (define owm-sum
    (and rt
         (opponent-world-model-last-summary (rt-opponent-world-model rt))))
  ;; L59 Tier-1A (`#1499`): Wire `record-enemy-tech-building-destroyed!` when previously seen
  ;; enemy tech buildings appear in `dead-tags`/`dead-units` so destroyed enemy tech is cleared!
  (when (and rt mmstate (hash? obs))
    (define ds-mm (rt-door-state rt))
    (define seen-tb
      (or (hash-ref ds-mm 'l59-seen-enemy-tech-bldgs #f)
          (let ([ht (make-hasheqv)])
            (hash-set! ds-mm 'l59-seen-enemy-tech-bldgs ht)
            ht)))
    (define eb-list (hash-ref obs 'enemy-buildings '()))
    (define eu-list (hash-ref obs 'enemy-units '()))
    (when (list? eb-list)
      (for ([eb (in-list eb-list)] #:when (hash? eb))
        (define bid (hash-ref eb 'id #f))
        (when (and (exact-integer? bid) (> bid 0))
          (define bt (fast-canonical-structure-sym (unit-type-sym eb)))
          (when (memq bt '(spawning-pool roach-warren baneling-nest lair hive hydralisk-den
                           spire greater-spire infestation-pit lurker-den ultralisk-cavern nydus-network
                           barracks factory starport armory ghost-academy fusion-core engineering-bay
                           gateway cybernetics-core robotics-facility robotics-bay stargate fleet-beacon
                           twilight-council templar-archive dark-shrine forge))
            (hash-set! seen-tb bid bt)))))
    (define dead-tags-obs
      (let ([dt (hash-ref obs 'dead-tags '())]
            [du (hash-ref obs 'dead-units '())])
        (cond
          [(and (list? dt) (pair? dt)) dt]
          [(and (list? du) (pair? du)) du]
          [else '()])))
    (when (and (pair? dead-tags-obs) (> (hash-count seen-tb) 0))
      (for ([did (in-list dead-tags-obs)] #:when (exact-integer? did))
        (define dead-bt (hash-ref seen-tb did #f))
        (when dead-bt
          (record-enemy-tech-building-destroyed! mmstate dead-bt (if (list? eu-list) eu-list '()) #:bldg-id did)
          (hash-remove! seen-tb did)))))
  (define obs0
    (if (hash? obs)
        (let* ([raw-eu (hash-ref obs 'enemy-units '())]
               [raw-eb (hash-ref obs 'enemy-buildings '())]
               [raw-ab (hash-ref obs 'ally-buildings '())]
               [eu* (runtime-strip-creep-tumors-list raw-eu (null? raw-eb))]
               [eb* (runtime-strip-creep-tumors-list raw-eb (null? eu*))]
               [ab* (runtime-strip-creep-tumors-list raw-ab #f)]
               [o1 (if (eq? eu* raw-eu) obs (hash-set obs 'enemy-units eu*))]
               [o2 (if (eq? eb* raw-eb) o1 (hash-set o1 'enemy-buildings eb*))])
          (if (eq? ab* raw-ab) o2 (hash-set o2 'ally-buildings ab*)))
        obs))
  (define obs*
    (if (hash? obs0)
        (let* ([o1 (if (and owm-sum (not (hash-has-key? obs0 'believed-enemy-army-value)))
                       (hash-set obs0 'believed-enemy-army-value
                                 (opponent-world-summary-believed-total-army-value owm-sum))
                       obs0)]
               [owm-wk (if owm-sum (opponent-world-summary-workers-killed owm-sum) 0)]
               [obs-wk (safe-nonneg-int (hash-ref o1 'enemy-workers-killed 0) 0)]
               [eff-wk (max owm-wk obs-wk)]
               [o2 (if (or (> eff-wk obs-wk) (not (hash-has-key? o1 'enemy-workers-killed)))
                       (hash-set o1 'enemy-workers-killed eff-wk)
                       o1)]
               [o3 (if (hash-has-key? o2 'our-upgrade-tier)
                       o2
                       (hash-set o2 'our-upgrade-tier
                                 (runtime-compute-our-upgrade-tier
                                  (hash-ref o2 'researched-upgrades '()))))])
          o3)
        obs0))
  (step-mirror-mind-predictor! mmstate obs*))

