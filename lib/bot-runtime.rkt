                         (enemy-tech-observation-enemy-upgrade-advantage tech-obs)))
  (define ms-trust (or (hash-ref obs 'mirror-trust-mode #f)
                       (and mmstate (mirror-mind-state-trust-mode mmstate))))
  (define ms-strat (or (hash-ref obs 'mirror-strategy #f)
                       (and mmstate (mirror-mind-state-strategic-hypothesis mmstate))))
  (define sup-used-bkt (quotient (max supply-used 0) 4))
  (define pend-sup-key (min eff-pending-supply 8))
  ;; Loop 66 Phase C1: Cross-step arbiter override counters for macro-brain gas/facility boosts
  (define arb-ledger-p8 (let ([rt (l2-ctx-rt ctx)]) (and rt (rt-arbiter-ledger rt))))
  (define arb-gas-ov-cnt
    (if (and live-game? arb-ledger-p8)
        (arbiter-recent-override-count arb-ledger-p8 'l2-macro-runtime 'budget-gas frame #:window-frames 224)
        0))
  (define arb-fac-ov-cnt
    (if (and live-game? arb-ledger-p8)
        (arbiter-recent-override-count arb-ledger-p8 'l2-macro-runtime 'facility-busy frame #:window-frames 336)
        0))
  (define arb-gas-boost-active? (>= arb-gas-ov-cnt 3))
  (define arb-fac-boost-active? (>= arb-fac-ov-cnt 4))
  (define macro-cache-ok?
    (and live-game?
         (> frame 60)
         (let* ([cf (vector-ref mc-cv 0)]
                [base-ttl (if (< frame 2400) 13 29)]
                [ttl (if (and (= (modulo frame 16) 8)
                              (not supply-at-risk?))
                         (+ base-ttl 4)
                         base-ttl)])
           (and (exact-integer? cf) (>= frame cf) (< (- frame cf) ttl)))
         (eq? (vector-ref mc-cv 6) race)
         (eq? (vector-ref mc-cv 7) effective-enemy-race)
         (= (vector-ref mc-cv 8) min-bkt25)
         (= (vector-ref mc-cv 9) gas-bkt25)
         (= (vector-ref mc-cv 10) sup-used-bkt)
         (= (vector-ref mc-cv 11) supply-cap)
         (= (vector-ref mc-cv 12) sup-left-key)
         (= (vector-ref mc-cv 13) pend-sup-key)
         (= (vector-ref mc-cv 14) total-workers)
         (= (vector-ref mc-cv 15) active-bases)
         (= (vector-ref mc-cv 16) eff-min-harvesters)
         (equal? (vector-ref mc-cv 17) eff-gas-harv-arg)
         (equal? (vector-ref mc-cv 18) ready-bldg-counts)
         (equal? (vector-ref mc-cv 19) total-bldg-counts)
         (equal? (vector-ref mc-cv 20) (l2-ctx-unit-counts ctx))
         (equal? (vector-ref mc-cv 21) enemy-u-counts)
         (equal? (vector-ref mc-cv 22) researched-upgs)
         (equal? (vector-ref mc-cv 23) (l2-ctx-pending-upgs ctx))
         (equal? (vector-ref mc-cv 24) open-prod-slots-snapshot)
         (equal? (vector-ref mc-cv 25) live-army-supply)
         (equal? (vector-ref mc-cv 26) live-enemy-threat-supply)
         (eq? (vector-ref mc-cv 27) (not (not under-base-attack?)))
         (eq? (vector-ref mc-cv 28) (not (not req-aa?)))
         (eq? (vector-ref mc-cv 29) (not (not req-det?)))
         (eq? (vector-ref mc-cv 30) (not (not supply-at-risk?)))
         (= (vector-ref mc-cv 31) cur-peak-supply)
         (equal? (vector-ref mc-cv 32) base-x)
         (equal? (vector-ref mc-cv 33) base-y)
         (equal? (vector-ref mc-cv 34) nat-x)
         (equal? (vector-ref mc-cv 35) nat-y)
         (equal? (vector-ref mc-cv 36) third-x)
         (equal? (vector-ref mc-cv 37) third-y)
         (eq? (vector-ref mc-cv 38) ms-preemptive)
         (eq? (vector-ref mc-cv 39) ms-pred)
         (equal? (vector-ref mc-cv 40) ms-min-bases)
         (eq? (vector-ref mc-cv 41) ms-verdict)
         (eq? (vector-ref mc-cv 42) ms-det?)
         (eq? (vector-ref mc-cv 43) ms-aa?)
         (equal? (vector-ref mc-cv 44) ms-upg-adv)
         (eq? (vector-ref mc-cv 45) ms-trust)
         (eq? (vector-ref mc-cv 46) ms-strat)
         (equal? (vector-ref mc-cv 47) depleting-bases)
         (eq? (vector-ref mc-cv 48) (not (not natural-blocked?)))
         (equal? (vector-ref mc-cv 80) enemy-b-counts)
         (equal? (vector-ref mc-cv 81) owm-believed-sup-bkt)
         (eq? (vector-ref mc-cv 82) owm-stopped-exp?)
         (equal? (vector-ref mc-cv 83) owm-siege-cnt)
         (eq? (vector-ref mc-cv 84) arb-gas-boost-active?)
         (eq? (vector-ref mc-cv 85) arb-fac-boost-active?)))
  (define-values (macro-world macro-decision dyn-plan plan-next-actions-ht repaired-prereqs)
    (if macro-cache-ok?
        (values (vector-ref mc-cv 1)
                (vector-ref mc-cv 2)
                (vector-ref mc-cv 3)
                (vector-ref mc-cv 4)
                (vector-ref mc-cv 5))
        (let* ([owm-attrition
                (and owm-sum-p8
                     (evaluate-attrition-and-relative-strength
                      (l2-ctx-ally-units ctx)
                      enemy-units
                      #:enemy-lost-value (+ (opponent-world-summary-destroyed-min owm-sum-p8)
                                            (exact-round (* 1.5 (opponent-world-summary-destroyed-gas owm-sum-p8))))
                      #:predicted-enemy-bases (max 1 (opponent-world-summary-confirmed-bases owm-sum-p8))
                      #:predicted-enemy-workers (opponent-world-summary-estimated-workers owm-sum-p8)
                      #:observed-enemy-geysers (opponent-world-summary-confirmed-geysers owm-sum-p8)
                      #:believed-enemy-army-value owm-believed-val))]
               [mirror-signals-ht
                (hasheq 'mirror-preemptive-unit ms-preemptive
                        'mirror-predicted-enemy-unit ms-pred
                        'mirror-recommended-min-bases ms-min-bases
                        'mirror-macro-verdict ms-verdict
                        'mirror-requires-detection? ms-det?
                        'mirror-requires-anti-air? ms-aa?
                        'mirror-enemy-upgrade-advantage ms-upg-adv
                        'mirror-trust-mode ms-trust
                        'mirror-strategy ms-strat
                        'believed-enemy-army-supply owm-believed-sup
                        'believed-enemy-army-value owm-believed-val
                        'opp-stopped-expanding? owm-stopped-exp?
                        'enemy-siege-or-turtle-count owm-siege-cnt
                        'attrition-recommended-action (and owm-attrition (attrition-strength-verdict-recommended-action owm-attrition))
                        'relative-army-strength (and owm-attrition (attrition-strength-verdict-relative-army-ratio owm-attrition)))]
               [mw (make-macro-world-state
                    #:race race
                    #:enemy-race effective-enemy-race
                    #:frame frame
                    #:minerals (l2-ctx-minerals ctx)
                    #:gas (l2-ctx-gas ctx)
                    #:supply-used supply-used
                    #:supply-cap supply-cap
                    #:supply-left (l2-ctx-supply-left ctx)
                    #:pending-supply eff-pending-supply
                    #:workers total-workers
                    #:active-bases active-bases
                    #:mineral-harvesters eff-min-harvesters
                    #:gas-harvesters eff-gas-harv-arg
                    #:ready-building-counts ready-bldg-counts
                    #:total-building-counts total-bldg-counts
                    #:unit-counts (l2-ctx-unit-counts ctx)
                    #:enemy-unit-counts enemy-u-counts
                    #:enemy-building-counts enemy-b-counts
                    #:researched-upgrades researched-upgs
                    #:pending-upgrades (l2-ctx-pending-upgs ctx)
                    #:open-facility-slots open-prod-slots-snapshot
                    #:army-supply live-army-supply
                    #:enemy-threat-supply live-enemy-threat-supply
                    #:under-attack? under-base-attack?
                    #:requires-anti-air? req-aa?
                    #:requires-detection? req-det?
                    #:supply-at-risk? supply-at-risk?
                    #:peak-supply-reached cur-peak-supply
                    #:base-x base-x #:base-y base-y
                    #:nat-x nat-x #:nat-y nat-y
                    #:third-x third-x #:third-y third-y
                    #:mirror-signals mirror-signals-ht
                    #:depleting-bases depleting-bases
                    #:natural-blocked? natural-blocked?)]
               [md (step-priority-macro-brain
                    mw
                    #:arbiter-gas-override-count arb-gas-ov-cnt
                    #:arbiter-facility-override-count arb-fac-ov-cnt)]
               [dp (macro-brain-decision-dynamic-plan md)]
               [pn (if (dynamic-macro-plan? dp)
                       (dynamic-macro-plan-translated-next-actions dp)
                       (hasheq))]
               [rp (macro-brain-decision-repaired-prereqs md)])
          (when (and live-game? (> frame 60))
            (vector-set! mc-cv 0 frame)
            (vector-set! mc-cv 1 mw)
            (vector-set! mc-cv 2 md)
            (vector-set! mc-cv 3 dp)
            (vector-set! mc-cv 4 pn)
            (vector-set! mc-cv 5 rp)
            (vector-set! mc-cv 6 race)
            (vector-set! mc-cv 7 effective-enemy-race)
            (vector-set! mc-cv 8 min-bkt25)
            (vector-set! mc-cv 9 gas-bkt25)
            (vector-set! mc-cv 10 sup-used-bkt)
            (vector-set! mc-cv 11 supply-cap)
            (vector-set! mc-cv 12 sup-left-key)
            (vector-set! mc-cv 13 pend-sup-key)
            (vector-set! mc-cv 14 total-workers)
            (vector-set! mc-cv 15 active-bases)
            (vector-set! mc-cv 16 eff-min-harvesters)
            (vector-set! mc-cv 17 eff-gas-harv-arg)
            (vector-set! mc-cv 18 ready-bldg-counts)
            (vector-set! mc-cv 19 total-bldg-counts)
            (vector-set! mc-cv 20 (l2-ctx-unit-counts ctx))
            (vector-set! mc-cv 21 enemy-u-counts)
            (vector-set! mc-cv 22 researched-upgs)
            (vector-set! mc-cv 23 (l2-ctx-pending-upgs ctx))
            (vector-set! mc-cv 24 open-prod-slots-snapshot)
            (vector-set! mc-cv 25 live-army-supply)
            (vector-set! mc-cv 26 live-enemy-threat-supply)
            (vector-set! mc-cv 27 (not (not under-base-attack?)))
            (vector-set! mc-cv 28 (not (not req-aa?)))
            (vector-set! mc-cv 29 (not (not req-det?)))
            (vector-set! mc-cv 30 (not (not supply-at-risk?)))
            (vector-set! mc-cv 31 cur-peak-supply)
            (vector-set! mc-cv 32 base-x)
            (vector-set! mc-cv 33 base-y)
            (vector-set! mc-cv 34 nat-x)
            (vector-set! mc-cv 35 nat-y)
            (vector-set! mc-cv 36 third-x)
            (vector-set! mc-cv 37 third-y)
            (vector-set! mc-cv 38 ms-preemptive)
            (vector-set! mc-cv 39 ms-pred)
            (vector-set! mc-cv 40 ms-min-bases)
            (vector-set! mc-cv 41 ms-verdict)
            (vector-set! mc-cv 42 ms-det?)
            (vector-set! mc-cv 43 ms-aa?)
            (vector-set! mc-cv 44 ms-upg-adv)
            (vector-set! mc-cv 45 ms-trust)
            (vector-set! mc-cv 46 ms-strat)
            (vector-set! mc-cv 47 depleting-bases)
            (vector-set! mc-cv 48 (not (not natural-blocked?)))
            (vector-set! mc-cv 80 enemy-b-counts)
            (vector-set! mc-cv 81 owm-believed-sup-bkt)
            (vector-set! mc-cv 82 owm-stopped-exp?)
            (vector-set! mc-cv 83 owm-siege-cnt)
            (vector-set! mc-cv 84 arb-gas-boost-active?)
            (vector-set! mc-cv 85 arb-fac-boost-active?))
          (values mw md dp pn rp))))
  (set-l2-ctx-macro-decision! ctx macro-decision)
  ;; L59 Tier-1A (`#1502`/`#1507`): Expose Watchdog Law 1 `'stage2-expand-ring` stalled goal
  ;; symbols on `rt-door-state` so `step-live-bot-runtime!` returns `'watchdog-expand-ring-syms`
  ;; to `sim/racket-sc2-ladder-main.rkt` -> `translate-bot-actions->sc2-raw-commands`!
  (let ([wd-rt (l2-ctx-rt ctx)])
    (when (and wd-rt (macro-brain-decision? macro-decision))
      (define wd-info (macro-brain-decision-watchdog-info macro-decision))
      (define wd-ring-syms
        (if (and (hash? wd-info)
                 (eq? (hash-ref wd-info 'goal-stage 'ok) 'stage2-expand-ring)
                 (symbol? (hash-ref wd-info 'stalled-goal #f)))
            (list (hash-ref wd-info 'stalled-goal #f))
            '()))
      (hash-set! (rt-door-state wd-rt) 'watchdog-expand-ring-syms wd-ring-syms)))
  (set-l2-ctx-dyn-plan! ctx dyn-plan)
  (set-l2-ctx-plan-next-actions-ht! ctx plan-next-actions-ht)
  (set-l2-ctx-repaired-prereqs! ctx repaired-prereqs)
  (when live-game?
