  (define prio-summary (l2-ctx-prio-summary ctx))
  (define race (l2-ctx-race ctx))
  (define remembered-enemy-threat-frame (l2-ctx-remembered-enemy-threat-frame ctx))
  (define remembered-enemy-threat-supply (l2-ctx-remembered-enemy-threat-supply ctx))
  (define repaired-prereqs (l2-ctx-repaired-prereqs ctx))
  (define researched-upgs (l2-ctx-researched-upgs ctx))
  (define rt (l2-ctx-rt ctx))
  (define scout-worker-id (l2-ctx-scout-worker-id ctx))
  (define stream-spendable-ht (l2-ctx-stream-spendable-ht ctx))
  (define supply-cap (l2-ctx-supply-cap ctx))
  (define supply-used (l2-ctx-supply-used ctx))
  (define target-workers (l2-ctx-target-workers ctx))
  (define third-x (l2-ctx-third-x ctx))
  (define third-y (l2-ctx-third-y ctx))
  (define total-workers (l2-ctx-total-workers ctx))
  (define under-base-attack? (l2-ctx-under-base-attack? ctx))
  ;; L57-R4 (`self_cancel_loops 4 -> 0`): Rate-limit the `202/200` Zerg Spore-trick
  ;; (`>= 672f` / `30s` cooldown after any Spore-trick cancel, capped at `< 2` total
  ;; Spore-trick cancels per match) so `SELF_CANCEL_LOOP(SporeCrawler)` never fires!
  (define max-sup-scout-st (and rt (rt-scout-state rt)))
  (when (and (hash? max-sup-scout-st) (<= frame 4))
    (hash-remove! max-sup-scout-st 'last-spore-trick-cancel-frame)
    (hash-remove! max-sup-scout-st 'spore-trick-cancel-cnt))
  (define last-spore-trick-cancel-f
    (if (hash? max-sup-scout-st)
        (hash-ref max-sup-scout-st 'last-spore-trick-cancel-frame -99999)
        -99999))
  (define spore-trick-cancel-cnt
    (if (hash? max-sup-scout-st)
        (hash-ref max-sup-scout-st 'spore-trick-cancel-cnt 0)
        0))
  (define allow-spore-trick-now?
    (or (not live-game?)
        (and (< spore-trick-cancel-cnt 2)
             (or (< frame last-spore-trick-cancel-f)
                 (>= (- frame last-spore-trick-cancel-f) 672)))))
  (define max-sup-plan
    (evaluate-max-supply-manager
     #:race race
     #:minerals (l2-ctx-minerals ctx)
     #:gas (l2-ctx-gas ctx)
     #:supply-used supply-used
     #:supply-cap supply-cap
     #:workers total-workers
     #:active-bases active-bases
     #:ally-units ally-units
     #:ally-buildings ally-bldgs
     #:base-x base-x
     #:base-y base-y
     #:nat-x nat-x
     #:nat-y nat-y
     #:third-x third-x
     #:third-y third-y
     #:enemy-x (hash-ref obs 'enemy-x SC2-DEFAULT-ENEMY-BASE-X)
     #:enemy-y (hash-ref obs 'enemy-y SC2-DEFAULT-ENEMY-BASE-Y)
     #:allow-spore-trick? allow-spore-trick-now?))
  (when (and (max-supply-plan-active? max-sup-plan)
             (refractory-allow-action?! cd-tracker
                                        (list 'max-supply-manager race)
                                        frame
                                        48))
    (define emitted-spore-cancels 0)
    (for ([ms-act (in-list (max-supply-plan-combined-actions max-sup-plan))])
      (when (and (pair? ms-act) (eq? (car ms-act) 'cancel-building))
        (set! emitted-spore-cancels (add1 emitted-spore-cancels)))
      (l2-emit! ctx ms-act))
    (when (and (> emitted-spore-cancels 0) (hash? max-sup-scout-st))
      (hash-set! max-sup-scout-st 'last-spore-trick-cancel-frame frame)
      (hash-set! max-sup-scout-st 'spore-trick-cancel-cnt (+ spore-trick-cancel-cnt emitted-spore-cancels))))
  (define cam-bmark-save-acts
    (cortex-sync-camera-bookmarks! cortex obs))
  (for ([ca (in-list cam-bmark-save-acts)])
    (l2-emit! ctx ca))
  (unless (live-bot-runtime-bookmarks-initialized? rt)
    (set-live-bot-runtime-bookmarks-initialized?! rt #t)
    (when (null? cam-bmark-save-acts)
      (cortex-save-camera-bookmark! cortex 1 base-x base-y)
      (l2-emit! ctx (list 'camera-bookmark-save 1 base-x base-y))))
  (define exp-entry
    (or (unbox (rt-experiment-box rt))
        (let* ([seed-pos
                (inexact->exact
                 (abs (+ (* 17 (round base-x))
                         (* 31 (round base-y))
                         (* 7 (round enemy-x))
                         (* 13 (round enemy-y)))))]
               [sel (select-match-experiment race effective-enemy-race seed-pos)]
               [sx-sy (let-values ([(sx sy) (resolve-experiment-spot-coord sel base-x base-y enemy-x enemy-y)])
                        (cons sx sy))]
               [tag (format-experiment-log-tag sel)]
               [entry (vector sel (car sx-sy) (cdr sx-sy) tag)])
          (set-box! (rt-experiment-box rt) entry)
          entry)))
  (define match-exp-sel (vector-ref exp-entry 0))
  (define exp-spot-x (vector-ref exp-entry 1))
  (define exp-spot-y (vector-ref exp-entry 2))
  (define exp-log-tag (vector-ref exp-entry 3))
  (define enemy-cnt-now (length enemy-units))
  (define cached-sit-vec (unbox (rt-sit-plan-cache rt)))
  (define refresh-sit?
    (or (not cached-sit-vec)
        (not live-game?)
        (>= (- frame (vector-ref cached-sit-vec 0))
            (if (= (modulo frame 16) 8) 20 16))
        (not (= enemy-cnt-now (vector-ref cached-sit-vec 1)))
        (not (eq? effective-enemy-race (vector-ref cached-sit-vec 2)))))
  (define sit-plan
    (if refresh-sit?
        (let ([plan (evaluate-situational-counter-plan obs race effective-enemy-race frame)])
          (set-box! (rt-sit-plan-cache rt)
                    (vector frame enemy-cnt-now effective-enemy-race plan))
          plan)
        (vector-ref cached-sit-vec 3)))
  (define sit-primary (situational-counter-plan-primary-situation sit-plan))
  (when (and refresh-sit?
             live-game?
             (not under-base-attack?)
             (not crisis-tech-upgrade-deferral?)
             (not (l2-ctx-urgent-combat-or-intel-need? ctx))
             (not (l2-ctx-zerg-saving-for-expand? ctx))
             (not (l2-ctx-protoss-saving-for-expand? ctx))
             (not (l2-ctx-terran-saving-for-expand? ctx))
             (or (>= (l2-ctx-minerals ctx) 150) (>= (l2-ctx-gas ctx) 100))
             (refractory-allow-action?! cd-tracker 'situational-upgrade frame 32))
    (define enemy-comp-syms (hash-keys enemy-u-counts))
    (define ready-bldgs (l2-ctx-ready-bldg-types ctx))
    (define sit-upgs
      (select-situational-upgrades
       race sit-primary enemy-comp-syms
       researched-upgs (l2-ctx-pending-upgs ctx) ready-bldgs (l2-ctx-minerals ctx) (l2-ctx-gas ctx)))
    (define sit-protoss-air-ships
      (+ (l2-unit-count ctx 'void-ray)
         (l2-unit-count ctx 'carrier)
         (l2-unit-count ctx 'tempest)
         (l2-unit-count ctx 'phoenix)
         (l2-unit-count ctx 'oracle)))
    (define sit-terran-air-ships
      (+ (l2-unit-count ctx 'viking)
         (l2-unit-count ctx 'viking-fighter)
         (l2-unit-count ctx 'banshee)
         (l2-unit-count ctx 'liberator)
         (l2-unit-count ctx 'battlecruiser)
         (l2-unit-count ctx 'raven)))
    (define (sit-upgrade-prereq-ok? su)
      (cond
        [(eq? su 'drilling-claws)
         (and (memq 'armory ready-bldgs)
              (>= (l2-unit-count ctx 'widow-mine) 2))]
        [(memq su '(protoss-air-weapons-1 protoss-air-armor-1))
         (and (memq 'stargate ready-bldgs)
              (>= sit-protoss-air-ships 3))]
        [(memq su '(protoss-air-weapons-2 protoss-air-weapons-3
                    protoss-air-armor-2 protoss-air-armor-3))
         (and (memq 'stargate ready-bldgs)
              (memq 'fleet-beacon ready-bldgs)
              (>= sit-protoss-air-ships 3))]
        [(memq su '(terran-ship-weapons-1 terran-ship-weapons-2 terran-ship-weapons-3))
         (and (memq 'starport ready-bldgs)
              (>= sit-terran-air-ships 3))]
        [else #t]))
    (for/first ([su (in-list sit-upgs)]
                #:when (and (sit-upgrade-prereq-ok? su)
                            (>= (- (l2-ctx-minerals ctx) (sc2-min-cost su)) (l2-ctx-bo-reserved-min ctx))
                            (>= (- (l2-ctx-gas ctx) (sc2-gas-cost su)) (l2-ctx-bo-reserved-gas ctx))
                            (l2-non-combat-min-ok? ctx (sc2-min-cost su) su)
                            (l2-non-combat-gas-ok? ctx (sc2-gas-cost su) su)
                            (l2-can-spend-by-priority? ctx su 'tech-upgrade)
                            (let ([before (length (l2-ctx-actions ctx))])
                              (l2-emit-research-verified! ctx su)
                              (> (length (l2-ctx-actions ctx)) before))))
      #t))
  (define prev-tel (live-bot-runtime-last-telemetry rt))
  (set-live-bot-runtime-last-telemetry!
   rt
   (hash-set* (if (hash? prev-tel) prev-tel (hash))
              'priority-summary prio-summary
              'priority-log-line prio-log-line
              'effective-enemy-race effective-enemy-race
              'pad-camped-posterior (l2-pad-camped-posterior ctx nat-x nat-y 11.5)
              'bo-active-goal bo-active-goal
              'target-workers target-workers
              'target-army-supply (pro-bo-eval-result-target-army-supply bo-eval)
              'bank-target bank-target
              'goal-stream-allocation goal-stream-alloc
              'decoupled-stream-spendable stream-spendable-ht
              'goal-streams DEC-GOAL-STREAMS
              'max-supply-plan max-sup-plan
              'dynamic-plan dyn-plan
              'dynamic-plan-next-actions
              (if (dynamic-macro-plan? dyn-plan)
                  (map plan-goal-node-next-action-sym (dynamic-macro-plan-actionable-goals dyn-plan))
                  '())
              'dynamic-plan-in-progress
              (if (dynamic-macro-plan? dyn-plan)
                  (dynamic-macro-plan-in-progress-syms dyn-plan)
                  '())
              'peak-supply-reached cur-peak-supply
              'repaired-prereqs repaired-prereqs
              'priority-repaired-prereqs repaired-prereqs
              'scout-worker-id scout-worker-id
              'last-enemy-seen-frame last-enemy-seen-frame
              'last-seen-main-frame last-seen-main-frame
              'last-seen-natural-frame last-seen-natural-frame
              'last-seen-third-frame last-seen-third-frame
              'last-seen-army-frame last-seen-army-frame
              'intel-staleness-frames intel-staleness-frames
              'intel-freshness intel-freshness
              'intel-coverage intel-coverage
              'intel-confidence intel-confidence
              'intel-deficit intel-deficit
              'intel-priority-sector intel-priority-sector
              'intel-target-goal intel-target-goal
              'intel-pressure (hash-ref pressure-metrics 'intel-pressure 0.0)
              'intel-gathering-method active-intel-method
              'remembered-enemy-threat-supply remembered-enemy-threat-supply
              'remembered-enemy-threat-frame remembered-enemy-threat-frame
              'escrow-goal-sym active-escrow-sym
              'escrow-had-reserve? (and (not escrow-timed-out-now?)
                                        (> (+ (l2-ctx-bo-reserved-min ctx) (l2-ctx-bo-reserved-gas ctx)) 0))
              'escrow-age-frames (if escrow-timed-out-now? 0 cur-escrow-age-frames)
              'escrow-peak-min (if escrow-timed-out-now? obs-minerals cur-escrow-peak-min)
              'escrow-prev-min obs-minerals
              'escrow-last-gain-frame
              (let* ([prev-tel (or (l2-ctx-prev-telemetry-ht ctx) (hash))]
                     [prev-g (hash-ref prev-tel 'escrow-goal-sym #f)]
                     [prev-m (hash-ref prev-tel 'escrow-prev-min obs-minerals)]
                     [prev-gf (hash-ref prev-tel 'escrow-last-gain-frame -9999)])
                (cond
                  [escrow-timed-out-now? -9999]
                  [(not (and active-escrow-sym
                             (not (eq? active-escrow-sym 'none))
                             (eq? active-escrow-sym prev-g)))
                   -9999]
                  [(> obs-minerals prev-m) frame]
                  [else prev-gf]))
              'escrow-start-frame (if escrow-timed-out-now? frame cur-escrow-start-frame)
              'escrow-last-frame frame
              'escrow-suppressed-goal escrow-suppressed-goal
              'escrow-suppressed-until-frame escrow-suppressed-until-frame
              'exp-goal-streak-start (if escrow-timed-out-now? #f cur-exp-streak-start)
              'exp-goal-th-count cur-th-total-cnt
              'exp-goal-last-frame (if exp-goal-sym-this-step frame prev-exp-last-f)
              'exp-timeout-count next-exp-timeout-cnt
              'experiment-id (MatchExperimentSelection-experiment-id match-exp-sel)
              'experiment-spot-idx (MatchExperimentSelection-spot-idx match-exp-sel)
              'spot-label (MatchExperimentSelection-spot-label match-exp-sel)
              'experiment-spot-label (MatchExperimentSelection-spot-label match-exp-sel)
              'experiment-tag exp-log-tag
              'experiment-spot-x exp-spot-x
              'experiment-spot-y exp-spot-y
              'experiment match-exp-sel
              'situational-plan sit-plan
              'primary-situation sit-primary
              'rush-fighting-worker-ids (l2-ctx-cur-rush-fighting-wids ctx)))
  (reverse (l2-ctx-actions ctx))
  (reverse (l2-ctx-actions ctx)))

(define (step-layer2-economy! rt raw-obs #:raw-obs [orig-raw-obs #f] #:sanitized? [sanitized? #f])
  (define ctx (rt-l2-ctx rt))
  (l2-phase1-setup! ctx rt raw-obs orig-raw-obs sanitized?)
  (l2-phase2-worker-rush! ctx)
  (l2-phase3-recall-cancel-scout! ctx)
  (l2-phase4-expansion-pads! ctx)
  (l2-phase5-threat-proxy! ctx)
  (l2-phase6-crisis-supply! ctx)
  (l2-phase7-wall-counts! ctx)
  (l2-phase8-macro-escrow! ctx)
  (case (l2-ctx-race ctx)
    [(Zerg)
     (l2-zerg-phase1-inject-creep! ctx)
     (l2-zerg-phase2-expand-tech-def! ctx)
     (l2-zerg-phase3-units-drones! ctx)]
    [(Protoss)
     (l2-protoss-phase1-chrono-wall! ctx)
     (l2-protoss-phase2-tech-expand! ctx)
     (l2-protoss-phase3-upgrades-units! ctx)]
    [(Terran)
     (l2-terran-phase1-orbital-addon-expand! ctx)
     (l2-terran-phase2-tech-starport! ctx)
     (l2-terran-phase3-units-depots! ctx)])
  (l2-queue-opp-cost-and-recovery-static-defense! ctx)
  (define out-acts (l2-phase9-post-race-telemetry! ctx))
  (l2-clear-ctx-refs! ctx)
  out-acts)


