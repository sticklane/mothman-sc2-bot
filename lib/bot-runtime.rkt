               (define hy (hash-ref near-harasser 'y base-y))
               ;; L39-P0-1f + L40-P0-1f + L41-P0-1d + L42-P0-1d (`e03`/`e04`): For Adepts, scatter
               ;; evacuating SCVs across 2-3 SPATIALLY SEPARATED safe patches strictly farther from
               ;; Adepts than current worker position (preferring paths clear of Adepts!) instead
               ;; of clumping on 1 corner or running toward an Adept!
               (define far-local-mp
                 (and (not best-safe-mp)
                      (not near-h-flying?)
                      (not (null? owned-mineral-patches))
                      (let* ([scored
                              (sort (map (lambda (mp)
                                           (define mpx (exact->inexact (hash-ref mp 'x base-x)))
                                           (define mpy (exact->inexact (hash-ref mp 'y base-y)))
                                           (define md
                                             (for/fold ([m +inf.0]) ([h (in-list undefended-harassers)])
                                               (min m (dist2d mpx mpy
                                                              (exact->inexact (hash-ref h 'x 9999.0))
                                                              (exact->inexact (hash-ref h 'y 9999.0))))))
                                           (cons md mp))
                                         owned-mineral-patches)
                                    >
                                    #:key car)]
                             [cands
                              (filter (lambda (p)
                                        (and (>= (car p) 4.5)
                                             (>= (- (car p) near-h-dist) 1.5)))
                                      scored)]
                             [farther-cands
                              (if (and (null? cands) (eq? near-h-sym 'adept))
                                  (filter (lambda (p) (>= (- (car p) near-h-dist) 0.8)) scored)
                                  cands)]
                             [eff-cands
                              (if (and (null? farther-cands) (eq? near-h-sym 'adept))
                                  scored
                                  farther-cands)]
                             [top-k
                              (if (and (eq? near-h-sym 'adept) (>= (length eff-cands) 3))
                                  (let* ([pool (take eff-cands (min 5 (length eff-cands)))]
                                         [clear-pool
                                          (filter (lambda (p)
                                                    (define mpx (exact->inexact (hash-ref (cdr p) 'x base-x)))
                                                    (define mpy (exact->inexact (hash-ref (cdr p) 'y base-y)))
                                                    (define midx (* 0.5 (+ (exact->inexact wx) mpx)))
                                                    (define midy (* 0.5 (+ (exact->inexact wy) mpy)))
                                                    (for/and ([h (in-list undefended-harassers)])
                                                      (> (dist2d midx midy
                                                                 (exact->inexact (hash-ref h 'x 9999.0))
                                                                 (exact->inexact (hash-ref h 'y 9999.0)))
                                                         2.2)))
                                                  pool)]
                                         [use-pool (if (>= (length clear-pool) 2) clear-pool pool)]
                                         [p0 (car use-pool)]
                                         [rest1 (cdr use-pool)]
                                         [p1 (and (pair? rest1)
                                                  (argmax (lambda (q)
                                                            (dist2d (exact->inexact (hash-ref (cdr p0) 'x base-x))
                                                                    (exact->inexact (hash-ref (cdr p0) 'y base-y))
                                                                    (exact->inexact (hash-ref (cdr q) 'x base-x))
                                                                    (exact->inexact (hash-ref (cdr q) 'y base-y))))
                                                          rest1))]
                                         [rest2 (and p1 (remq p1 rest1))]
                                         [p2 (and (pair? rest2)
                                                  (argmax (lambda (q)
                                                            (min (dist2d (exact->inexact (hash-ref (cdr p0) 'x base-x))
                                                                         (exact->inexact (hash-ref (cdr p0) 'y base-y))
                                                                         (exact->inexact (hash-ref (cdr q) 'x base-x))
                                                                         (exact->inexact (hash-ref (cdr q) 'y base-y)))
                                                                 (dist2d (exact->inexact (hash-ref (cdr p1) 'x base-x))
                                                                         (exact->inexact (hash-ref (cdr p1) 'y base-y))
                                                                         (exact->inexact (hash-ref (cdr q) 'x base-x))
                                                                         (exact->inexact (hash-ref (cdr q) 'y base-y)))))
                                                          rest2))])
                                    (filter values (list p0 p1 p2)))
                                  (take eff-cands (min 3 (length eff-cands))))])
                        (and (pair? top-k)
                             (cdr (list-ref top-k (modulo wid (length top-k))))))))
               (define new-until (+ frame (if far-local-mp 6 24)))
               (unless harass-evac-ht
                 (set! harass-evac-ht (make-hasheqv))
                 (hash-set! rush-def-st 'harass-evac-by-wid harass-evac-ht))
               (hash-set! harass-evac-ht wid new-until)
               (when (> new-until max-harass-evac-until)
                 (set! max-harass-evac-until new-until)
                 (hash-set! rush-def-st 'max-harass-evac-until new-until))
               (cond
                 [best-safe-mp
                  (l2-emit! ctx (list 'mineral-walk
                               wid
                               (safe-nonneg-int (hash-ref best-safe-mp 'id 0) 0)
                               (safe-coord (hash-ref best-safe-mp 'x base-x) base-x)
                               (safe-coord (hash-ref best-safe-mp 'y base-y) base-y)))]
                 [far-local-mp
                  (l2-emit! ctx (list 'mineral-walk
                               wid
                               (safe-nonneg-int (hash-ref far-local-mp 'id 0) 0)
                               (safe-coord (hash-ref far-local-mp 'x base-x) base-x)
                               (safe-coord (hash-ref far-local-mp 'y base-y) base-y)))]
                 [else
                  (define raw-dx (- (exact->inexact wx) (exact->inexact hx)))
                  (define raw-dy (- (exact->inexact wy) (exact->inexact hy)))
                  (define raw-d (sqrt (+ (* raw-dx raw-dx) (* raw-dy raw-dy))))
                  (define-values (ux uy)
                    (if (>= raw-d 0.25)
                        (values (/ raw-dx raw-d) (/ raw-dy raw-d))
                        (let* ([bdx (- (exact->inexact base-x) (exact->inexact hx))]
                               [bdy (- (exact->inexact base-y) (exact->inexact hy))]
                               [bd (sqrt (+ (* bdx bdx) (* bdy bdy)))])
                          (if (>= bd 0.25)
                              (values (/ bdx bd) (/ bdy bd))
                              (values 1.0 0.0)))))
                  (define away-x (safe-coord (+ wx (* 9.0 ux)) base-x))
                  (define away-y (safe-coord (+ wy (* 9.0 uy)) base-y))
                  (l2-emit! ctx (list 'mineral-walk wid 0 away-x away-y))])
               new-until]
              [else prev-evac-until]))
          (when (or threatened? (< frame evac-until))
            (define ttl (if (> evac-until frame) (max 1 (- evac-until frame)) 24))
            (acquire-unit-lease! leases wid 'evac frame ttl #:x wx #:y wy))))))
  (define raw-enemy-units-for-drill
    (let ([reu (and (hash? raw-obs) (hash-ref raw-obs 'enemy-units #f))])
      (if (and (list? reu) (for/and ([e (in-list reu)]) (hash? e)))
          reu
          enemy-units)))
  (define owned-base-fxys
    (for/list ([bc (in-list owned-base-coords)])
      (let ([bx (car bc)] [by (cdr bc)])
        (cons (if (flonum? bx) bx (exact->inexact bx))
              (if (flonum? by) by (exact->inexact by))))))
  (define enemy-workers-near-base
    (if (or (null? raw-enemy-units-for-drill) (null? owned-base-fxys))
        '()
        (for/list ([e (in-list raw-enemy-units-for-drill)]
                   #:when (let ([et (unit-type-sym e)])
                            (and (or (eq? et 'drone) (eq? et 'probe) (eq? et 'scv))
                                 (not (eq? (hash-ref e 'is-hallucination #f) #t))
                                 (let* ([rx (hash-ref e 'x 9999.0)]
                                        [ry (hash-ref e 'y 9999.0)]
                                        [ex (if (flonum? rx) rx (exact->inexact rx))]
                                        [ey (if (flonum? ry) ry (exact->inexact ry))])
                                   (for/or ([bc (in-list owned-base-fxys)])
                                     (define dx (fl- (car bc) ex))
                                     (define dy (fl- (cdr bc) ey))
                                     (fl<= (fl+ (fl* dx dx) (fl* dy dy)) 484.0))))))
          e)))
  (define drill-stack-min-count (if live-obs-harvesters? 6 4))
  (define stacked-enemy-workers
    (if (or (< (length enemy-workers-near-base) drill-stack-min-count)
            (and live-obs-harvesters?
                 worker-rush-active?
                 (<= ally-combat-supply-early 0)))
        '()
        (let* ([n (length enemy-workers-near-base)]
               [xs (make-flvector n)]
               [ys (make-flvector n)])
          (for ([o (in-list enemy-workers-near-base)] [i (in-naturals)])
            (flvector-set! xs i (exact->inexact (hash-ref o 'x base-x)))
            (flvector-set! ys i (exact->inexact (hash-ref o 'y base-y))))
          (define anchor-idx
            (for/first ([i (in-range n)]
                        #:when (let ([ex (flvector-ref xs i)]
                                     [ey (flvector-ref ys i)])
                                 (>= (for/sum ([j (in-range n)])
                                       (define dx (fl- ex (flvector-ref xs j)))
                                       (define dy (fl- ey (flvector-ref ys j)))
                                       (if (fl<= (fl+ (fl* dx dx) (fl* dy dy)) 0.2025) 1 0))
                                     drill-stack-min-count)))
              i))
          (if anchor-idx
              (let ([ax (flvector-ref xs anchor-idx)]
                    [ay (flvector-ref ys anchor-idx)])
                (for/list ([o (in-list enemy-workers-near-base)]
                           [ox (in-flvector xs)]
                           [oy (in-flvector ys)]
                           #:when (let ([dx (fl- ax ox)]
                                        [dy (fl- ay oy)])
                                    (fl<= (fl+ (fl* dx dx) (fl* dy dy)) 0.2025)))
                  o))
              '()))))
  (when (>= (length stacked-enemy-workers) drill-stack-min-count)
    (define ew0 (car stacked-enemy-workers))
    (define ewx (hash-ref ew0 'x base-x))
    (define ewy (hash-ref ew0 'y base-y))
    (define anchor-bc
      (argmin (lambda (bc) (dist2d (car bc) (cdr bc) ewx ewy))
              owned-base-coords))
    (define dx (- (car anchor-bc) ewx))
    (define dy (- (cdr anchor-bc) ewy))
    (define d (max 1.0 (sqrt (+ (* dx dx) (* dy dy)))))
    (define perp-x (safe-coord (+ ewx (* 4.0 (- (/ dy d)))) (car anchor-bc)))
    (define perp-y (safe-coord (+ ewy (* 4.0 (/ dx d))) (cdr anchor-bc)))
    (l2-emit! ctx (list 'counter-enemy-worker-drill (length stacked-enemy-workers) perp-x perp-y))
    ;; NEVER emit passive `(move wid perp-x perp-y)` during worker rush or in-base proxy defense!
    (when (and (not worker-rush-active?)
               (not in-base-proxy-detected?))
      (for ([w (in-list workers)]
            #:when (and (not (worker-has-engine-build-order? w))
                        (not (order-ledger-unit-has-active-build? oledger-early (hash-ref w 'id 0) w))
                        (<= (dist2d ewx ewy (hash-ref w 'x base-x) (hash-ref w 'y base-y)) 8.0)))
        (l2-emit! ctx (list 'move (hash-ref w 'id 10) perp-x perp-y)))))
  (define mmstate-pad (live-bot-runtime-mirror-mind rt))
  (define mmstate-rush-post
    (let ([ar (and mmstate-pad (mirror-mind-state-last-action-reading mmstate-pad))]
          [hyp (and mmstate-pad (mirror-mind-state-strategic-hypothesis mmstate-pad))])
      (if (or (and ar (action-lens-reading-proxy-or-rush-detected? ar))
              (memq hyp '(proxy-production-or-all-in rush early-aggression)))
          0.65
          0.12)))
  (set-l2-ctx-mmstate-rush-post! ctx mmstate-rush-post))

(define (l2-phase4-expansion-pads! ctx)
  (define active-bases (l2-ctx-active-bases ctx))
