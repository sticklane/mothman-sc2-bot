        ;; Phase-5 defenders' focus-fire on revealed Dark Templars with `(attack-unit uid prism)`!
        (define revealed-dt-present?
          (for/or ([e (in-list enemy-units)])
            (and (hash? e)
                 (eq? (fast-canonical-unit-sym (unit-type-sym e)) 'dark-templar)
                 (let ([cv (hash-ref e 'cloak #f)])
                   (not (or (eqv? cv 1) (eq? cv 'cloaked)))))))
        (define prism-ids-me
          (if revealed-dt-present?
              (for/seteqv ([e (in-list enemy-units)]
                           #:when (and (hash? e)
                                       (memq (fast-canonical-unit-sym (unit-type-sym e))
                                             '(warp-prism warp-prism-phasing))
                                       (exact-integer? (hash-ref e 'id #f))))
                (hash-ref e 'id))
              (seteqv)))
        (define eff-me-acts
          (let* ([acts-1
                  (if (set-empty? prism-ids-me)
                      me-acts
                      (filter (lambda (a)
                                (not (and (pair? a)
                                          (eq? (car a) 'attack-unit)
                                          (>= (length a) 3)
                                          (set-member? prism-ids-me (caddr a)))))
                              me-acts))])
            ;; L58-P1 (`sc2-trn-n05`): Never fire Nexus `mass-recall` (`3757`) on a healthy loaded
            ;; raiding transport (`cargo > 0` & `hp >= 40%`) or healthy mineral-line raiders
            ;; (`avg hp >= 55%` within `14t` of `>= 4` enemy workers), which teleports raids home
            ;; and causes `88:YouCantIssueCommandsToThatUnit` during the 3.6s stasis windup!
            (filter
             (lambda (a)
               (not (and (list? a)
                         (memq (car a) '(cast cast-spell))
                         (>= (length a) 5)
                         (memq (third a) '(mass-recall nexus-mass-recall))
                         (real? (fourth a)) (real? (fifth a))
                         (let ([rx (exact->inexact (fourth a))]
                               [ry (exact->inexact (fifth a))])
                           (or (for/or ([u (in-list ally-units)])
                                 ;; L58-P2 (`sc2-trn-n05`): Never fire Nexus `mass-recall` (`3757`) on a
                                 ;; Warp Prism drop/juggle squad (loaded OR unloaded!) — the Warp Prism
                                 ;; is already a mobile evacuation transport and recall freezes it for 3.6s!
                                 (and (hash? u)
                                      (memq (unit-type-sym u) '(warp-prism warp-prism-phasing))
                                      (real? (hash-ref u 'x #f)) (real? (hash-ref u 'y #f))
                                      (<= (fast-dist2d rx ry
                                                       (exact->inexact (hash-ref u 'x 9999.0))
                                                       (exact->inexact (hash-ref u 'y 9999.0)))
                                          16.0)))
                               (and (>= (count (lambda (e)
                                                 (and (hash? e)
                                                      (memq (fast-canonical-unit-sym (unit-type-sym e))
                                                            '(drone scv probe mule))
                                                      (real? (hash-ref e 'x #f)) (real? (hash-ref e 'y #f))
                                                      (<= (fast-dist2d rx ry
                                                                       (exact->inexact (hash-ref e 'x 9999.0))
                                                                       (exact->inexact (hash-ref e 'y 9999.0)))
                                                          14.0)))
                                               enemy-units)
                                        4)
                                    (let-values ([(hsum msum cnt)
                                                  (for/fold ([hs 0.0] [ms 0.0] [c 0]) ([u (in-list ally-units)])
                                                    (if (and (hash? u)
                                                             (combat-unit-record? u)
                                                             (real? (hash-ref u 'x #f)) (real? (hash-ref u 'y #f))
                                                             (<= (fast-dist2d rx ry
                                                                              (exact->inexact (hash-ref u 'x 9999.0))
                                                                              (exact->inexact (hash-ref u 'y 9999.0)))
                                                                 8.0))
                                                        (values (+ hs (exact->inexact (unit-total-hp-and-shield u)))
                                                                (+ ms (max 1.0 (exact->inexact (+ (hash-ref u 'max-hp 100.0)
                                                                                                  (hash-ref u 'max-shield 0.0)))))
                                                                (add1 c))
                                                        (values hs ms c)))])
                                      (and (> cnt 0) (>= (/ hsum (max 1.0 msum)) 0.55)))))))))
             acts-1)))
        (emit-direct-batch! eff-me-acts))))

  ;; Direct Tactic #7: `situational-counter-planner.rkt`
  (when (and (or (pair? ally-units) (pair? ally-bldgs))
             (or has-any-enemy?
                 (hash-ref obs 'proxy-detected? #f)
                 (hash-ref obs 'our-army-trapped? #f)))
    (define cached-sit-vec (unbox (rt-sit-plan-cache rt)))
    (define sit-plan
      (if (and (vector? cached-sit-vec) (>= (vector-length cached-sit-vec) 4))
          (vector-ref cached-sit-vec 3)
          (evaluate-situational-counter-plan obs direct-our-race direct-enemy-race frame)))
    (define raw-sit-acts (situational-counter-plan-ability-actions sit-plan))
    (when (pair? raw-sit-acts)
      (define remapped-acts
        (let ([has-id-1? 'unknown]
              [first-eid 'unknown])
          (for/list ([act (in-list raw-sit-acts)]
                     #:when (let ([ok? (cond
                                         [(and (pair? act)
                                               (eq? (car act) 'cast-spell)
                                               (= (length act) 4)
                                               (equal? (cadddr act) 1))
                                          (when (eq? has-id-1? 'unknown)
                                            (set! has-id-1?
                                                  (for/or ([e (in-list enemy-units)])
                                                    (define eid (let ([id0 (hash-ref e 'id #f)]) (if id0 id0 (hash-ref e 'tag -1))))
                                                    (= eid 1)))
                                            (unless has-id-1?
                                              (set! first-eid
                                                    (for/or ([e (in-list enemy-units)])
                                                      (define id (let ([id0 (hash-ref e 'id #f)]) (if id0 id0 (hash-ref e 'tag -1))))
                                                      (and (exact-integer? id) (> id 0) id)))))
                                          (or has-id-1? first-eid)]
                                         [else #t])])
                              ok?))
            (if (and (pair? act)
                     (eq? (car act) 'cast-spell)
                     (= (length act) 4)
                     (equal? (cadddr act) 1)
                     (not has-id-1?))
                (list (car act) (cadr act) (caddr act) first-eid)
                act))))
      (emit-direct-batch! remapped-acts)))

  (define pre-valid-tags (ensure-rt-valid-enemy-tags! rt obs))
  (define sanitized-tactic-actions
    (sanitize-stale-target-actions (reverse (l34-ctx-actions ctx))
                                   obs
                                   #:pos-cache (rt-enemy-pos-cache rt)
                                   #:precomputed-valid-tags pre-valid-tags))
  (values sanitized-tactic-actions vanguard-count reserve-count))

(define (step-layer3-and-4-tactics! rt raw-obs fap-score #:sanitized? [sanitized? #f])
  (define ctx (rt-l34-ctx rt))
  (l34-phase1-setup! ctx rt raw-obs fap-score sanitized?)
  (l34-phase2-tbrain-drops! ctx)
  (l34-phase3-classify! ctx)
  (l34-phase4a-hazards-wm! ctx)
  (l34-phase4b-baneling-oracle! ctx)
  (l34-phase5a-wave-casters! ctx)
  (l34-phase5b-engage! ctx)
  (l34-phase6-raid-concave-reach! ctx)
  (define-values (sanitized-tactic-actions vanguard-count reserve-count)
    (l34-phase7-direct-tactics! ctx))
  (l34-clear-ctx-refs! ctx)
  (values sanitized-tactic-actions vanguard-count reserve-count))


;; =============================================================================
;; Layer 5: Human Cortex Camera Saccades, Ability Throttling & Token Filtering
;; =============================================================================

(define (step-layer5-human-cortex! rt raw-actions raw-obs #:sanitized? [sanitized? #f])
  (define obs (if sanitized? raw-obs (sanitize-obs-hash raw-obs)))
  (define frame (hash-ref obs 'frame 0))
  (define limiter (live-bot-runtime-cast-limiter rt))
  (define cortex (live-bot-runtime-cortex rt))
  (define nat-x (hash-ref obs 'natural-x 45.0))
  (define nat-y (hash-ref obs 'natural-y 45.0))

  (define compile-sel?
    (or (not (eq? (hash-ref raw-obs 'mineral-harvesters RUNTIME-MISSING) RUNTIME-MISSING))
        (hash-ref raw-obs 'compile-human-selections? #f)))
  ;; W9-TAC-2: Pre-coalesce zero-target squad ability casts (`stimpack`, `siege-mode`,
  ;; `unsiege-mode`, burrow/mode toggles) BEFORE `throttle-ability-casts!` so pressing
  ;; Stimpack or Siege Mode for a full squad counts as ONE cast instead of getting capped at 2 units!
  (define pre-coalesced-actions
    (if (not compile-sel?)
        raw-actions
        (let ()
          (define (squad-zero-target-cast-key act)
            (and (pair? act)
                 (let ([head (car act)])
                   (or (eq? head 'cast) (eq? head 'cast-spell)))
                 (pair? (cdr act))
                 (pair? (cddr act))
                 (null? (cdddr act))
                 (let ([uid (cadr act)]
                       [sp (caddr act)])
                   (and (or (exact-integer? uid) (list? uid))
                        (memq sp '(stimpack stim guardian-shield
                                   siege-mode morph-siege-mode unsiege-mode unsiege
                                   burrow unburrow burrow-down burrow-up
                                   widow-mine-burrow widow-mine-unburrow
                                   lurker-burrow lurker-unburrow
                                   morph-liberator-aa liberator-aa-mode
                                   morph-viking-assault morph-viking-fighter
                                   morph-hellbat morph-hellion
                                   morph-thor-high-impact morph-thor-explosive
                                   cloak-banshee prismatic-alignment))
                        sp))))
          (define sp->uids (make-hasheq))
          (define any-multi? #f)
          (for ([act (in-list raw-actions)])
            (define sp (squad-zero-target-cast-key act))
            (when sp
              (define prev (hash-ref sp->uids sp '()))
              (when (pair? prev) (set! any-multi? #t))
              (define u (cadr act))
              (hash-set! sp->uids sp
                         (if (list? u)
                             (for/fold ([acc prev]) ([x (in-list u)]) (cons x acc))
                             (cons u prev)))))
          (if (not any-multi?)
              raw-actions
              (let ([emitted (make-hasheq)])
                (for/fold ([acc '()] #:result (reverse acc)) ([act (in-list raw-actions)])
                  (define sp (squad-zero-target-cast-key act))
                  (cond
                    [(not sp) (cons act acc)]
                    [(hash-has-key? emitted sp) acc]
                    [else
                     (hash-set! emitted sp #t)
                     (define uids (reverse (hash-ref sp->uids sp '())))
                     (define uarg (if (and (pair? uids) (null? (cdr uids))) (car uids) uids))
                     (cons (list (car act) uarg sp) acc)])))))))

  ;; 1. Refractory ability cast limiter (cross Typed/Untyped boundary only for cast candidates)
  (define cast-acts
    (for/fold ([acc '()]) ([act (in-list pre-coalesced-actions)])
      (if (and (pair? act)
               (let ([head (car act)])
                 (or (eq? head 'cast)
                     (eq? head 'cast-spell)
                     (eq? head 'use-ability)
                     (eq? head 'inject-larva))))
          (cons act acc)
          acc)))
  (define-values (unthrottled-actions spell-throttled)
    (if (null? cast-acts)
        (begin
          (throttle-ability-casts! limiter '() frame)
          (values pre-coalesced-actions 0))
        (let-values ([(kept-casts throttled)
                      (throttle-ability-casts! limiter (reverse cast-acts) frame)])
          (if (= throttled 0)
              (values pre-coalesced-actions 0)
              (let loop ([rem pre-coalesced-actions] [krem kept-casts] [acc '()])
                (cond
                  [(null? rem) (values (reverse acc) throttled)]
                  [else
                   (define act (car rem))
                   (define cast?
                     (and (pair? act)
                          (let ([head (car act)])
                            (or (eq? head 'cast)
                                (eq? head 'cast-spell)
                                (eq? head 'use-ability)
                                (eq? head 'inject-larva)))))
                   (if (not cast?)
                       (loop (cdr rem) krem (cons act acc))
                       (if (and (pair? krem) (equal? act (car krem)))
                           (loop (cdr rem) (cdr krem) (cons act acc))
                           (loop (cdr rem) krem acc)))]))))))

  ;; 2. Selection & Control-Group Compiler + Per-Action Camera Framing for Un-Grouped Units
  (define base-x (hash-ref obs 'base-x 32.5))
  (define base-y (hash-ref obs 'base-y 32.5))
  (define ally-units (hash-ref obs 'ally-units '()))
  (define ally-bldgs (hash-ref obs 'ally-buildings '()))
  (define l5-sc (rt-l5-scratch rt))
  (define all-cgroup-member-ids (pooled-hasheqv! l5-sc 'all-cgroup-member-ids))
  (for ([g (in-range 1 7)])
    (for ([uid (in-list (cortex-get-control-group cortex g))])
      (when (exact-integer? uid)
        (hash-set! all-cgroup-member-ids uid #t))))
  (define unit-pos-cache #f)
  (define (get-unit-pos-by-id)
    (or unit-pos-cache
        (let ([ht (make-hasheqv)])
          (for ([r (in-list ally-units)])
            (when (hash? r)
              (define id (hash-ref r 'id #f))
              (define x (hash-ref r 'x #f))
              (define y (hash-ref r 'y #f))
              (when (and (exact-integer? id) (real? x) (real? y))
                (hash-set! ht id (cons (exact->inexact x) (exact->inexact y))))))
          (for ([r (in-list ally-bldgs)])
            (when (hash? r)
              (define id (hash-ref r 'id #f))
              (define x (hash-ref r 'x #f))
              (define y (hash-ref r 'y #f))
              (when (and (exact-integer? id) (real? x) (real? y))
                (hash-set! ht id (cons (exact->inexact x) (exact->inexact y))))))
          (set! unit-pos-cache ht)
          ht)))

  (define selection-compiled-actions
    (if (or (not (eq? (hash-ref raw-obs 'mineral-harvesters RUNTIME-MISSING) RUNTIME-MISSING))
            (hash-ref raw-obs 'compile-human-selections? #f))
        (cortex-collapse-and-compile-selections!
         cortex
         unthrottled-actions
         ally-units
         ally-bldgs)
        unthrottled-actions))

  (define cam-moved? #f)
  (define framed-actions
    (let loop ([rem selection-compiled-actions]
               [cx (human-cortex-cam-x cortex)]
               [cy (human-cortex-cam-y cortex)]
               [acc '()])
      (cond
        [(null? rem) (reverse acc)]
        [else
         (define act (car rem))
         (define-values (next-cx next-cy new-acc)
           (match act
             [(list 'move-camera (? real? mx) (? real? my))
              (set! cam-moved? #t)
              (cortex-move-camera! cortex (exact->inexact mx) (exact->inexact my))
              (values (exact->inexact mx) (exact->inexact my) (cons act acc))]
             [(list 'camera-focus _ (? real? mx) (? real? my))
              (set! cam-moved? #t)
              (cortex-move-camera! cortex (exact->inexact mx) (exact->inexact my))
              (values (exact->inexact mx) (exact->inexact my) (cons act acc))]
             [(list 'camera-focus (? real? mx) (? real? my))
              (set! cam-moved? #t)
              (cortex-move-camera! cortex (exact->inexact mx) (exact->inexact my))
              (values (exact->inexact mx) (exact->inexact my) (cons act acc))]
             [_
              (define focus
                (action-requires-camera-focus act all-cgroup-member-ids get-unit-pos-by-id base-x base-y))
              (if (and (pair? focus)
                       (not (in-camera-viewport? cx cy (car focus) (cdr focus))))
                  (let ([fx (safe-coord (car focus) cx)]
                        [fy (safe-coord (cdr focus) cy)])
                    (set! cam-moved? #t)
                    (cortex-move-camera! cortex fx fy)
                    (values fx fy (cons act (cons (list 'move-camera fx fy) acc))))
                  (values cx cy (cons act acc)))]))
         (loop (cdr rem) next-cx next-cy new-acc)])))

  ;; Fallback enemy focal check only when no per-action camera framing occurred
  (define enemy-units (hash-ref obs 'enemy-units '()))
  (define cam-actions
    (cond
      [cam-moved? '()]
      [(and (not (null? enemy-units))
            (not (in-camera-viewport? (human-cortex-cam-x cortex)
                                      (human-cortex-cam-y cortex)
                                      (hash-ref (car enemy-units) 'x nat-x)
                                      (hash-ref (car enemy-units) 'y nat-y))))
       (define tx (safe-coord (hash-ref (car enemy-units) 'x nat-x) nat-x))
       (define ty (safe-coord (hash-ref (car enemy-units) 'y nat-y) nat-y))
       (cortex-move-camera! cortex tx ty)
       (list (list 'move-camera tx ty))]
      [else
       (cortex-move-camera! cortex
                            (human-cortex-cam-x cortex)
                            (human-cortex-cam-y cortex))
       '()]))

  (define combined (append cam-actions framed-actions))
  (define-values (accepted dropped)
    (cortex-filter-actions! cortex combined))
  (values accepted dropped spell-throttled))

;; =============================================================================
;; Layer 5b: Pro-Human Camera Saccade (60-90 SPM) & APM/EPM Discipline Governor
;; =============================================================================

(define PRO-CAMERA-SACCADE-ZONES
  '(home-macro-base
    natural-expansion
    active-army-front
    harass-or-blocker-zone))

(define (step-pro-human-camera-and-apm-governor! rt [raw-obs (hash)] #:sanitized? [sanitized? #f])
  (define obs (if sanitized? raw-obs (sanitize-obs-hash raw-obs)))
  (define frame (hash-ref obs 'frame 0))
  (define cortex (live-bot-runtime-cortex rt))
  (define bmarks (human-cortex-camera-bookmarks cortex))
  (define base-x (hash-ref obs 'base-x 32.5))
  (define base-y (hash-ref obs 'base-y 32.5))
  (define nat-x (hash-ref obs 'natural-x 45.0))
  (define nat-y (hash-ref obs 'natural-y 45.0))
  (define enemy-x (hash-ref obs 'enemy-x 160.5))
  (define enemy-y (hash-ref obs 'enemy-y 160.5))
  (define enemy-exp-x (hash-ref obs 'enemy-expand-x 148.0))
  (define enemy-exp-y (hash-ref obs 'enemy-expand-y 148.0))
  (define enemy-units (hash-ref obs 'enemy-units '()))
  (define ally-units (hash-ref obs 'ally-units '()))
  (define ally-bldgs (hash-ref obs 'ally-buildings '()))
  (define live-cam-obs?
    (not (eq? (hash-ref raw-obs 'mineral-harvesters RUNTIME-MISSING) RUNTIME-MISSING)))

  ;; L59 Pro Camera Governor: Dwell >= 26 frames (~1.16s) in live games for Pro 36-40 SPM,
  ;; using dynamic Base-Centered Camera Hotkeys (`F1..F8` mapped to owned townhalls) +
  ;; crisp Minimap-Click jumps (`>= 18t`) to Active Army Front & Active Harass/Drop/Scout zones.
  (define dwell-min
    (if live-cam-obs?
        (max 26 SC2-CAMERA-SACCADE-MIN-DWELL-FRAMES)
        SC2-CAMERA-SACCADE-MIN-DWELL-FRAMES))
  (define last-frame (hash-ref bmarks 'last-saccade-frame #f))
  (define cur-idx (safe-nonneg-int (hash-ref bmarks 'saccade-zone-idx 0) 0))
  (define saccade-due?
    (or (not (exact-integer? last-frame))
        (= frame last-frame)
        (>= (abs (- frame last-frame)) dwell-min)))

  (define fbx (if (flonum? base-x) base-x (exact->inexact base-x)))
  (define fby (if (flonum? base-y) base-y (exact->inexact base-y)))
  (define fnx (if (flonum? nat-x) nat-x (exact->inexact nat-x)))
  (define fny (if (flonum? nat-y) nat-y (exact->inexact nat-y)))

  ;; Extract actual owned townhalls sorted stably by distance from main `(base-x, base-y)` -> `F1..F8`!
  (define owned-townhall-pts
    (let* ([raw-ths
            (for/list ([b (in-list ally-bldgs)]
                       #:when (and (hash? b)
                                   (memq (fast-canonical-structure-sym (unit-type-sym b))
                                         '(nexus hatchery lair hive
                                           command-center orbital-command planetary-fortress))
                                   (real? (hash-ref b 'x #f))
                                   (real? (hash-ref b 'y #f))))
              (cons (exact->inexact (hash-ref b 'x base-x))
                    (exact->inexact (hash-ref b 'y base-y))))]
           [sorted-ths
            (sort raw-ths
                  (lambda (p1 p2)
                    (define d1 (+ (sqr (- (car p1) fbx)) (sqr (- (cdr p1) fby))))
                    (define d2 (+ (sqr (- (car p2) fbx)) (sqr (- (cdr p2) fby))))
                    (if (= d1 d2)
                        (or (< (car p1) (car p2))
                            (and (= (car p1) (car p2)) (< (cdr p1) (cdr p2))))
                        (< d1 d2))))])
      (take sorted-ths (min 8 (length sorted-ths)))))
  (for ([pt (in-list owned-townhall-pts)]
        [slot (in-naturals 1)])
    (cortex-save-camera-bookmark! cortex slot (car pt) (cdr pt)))

  (define (find-nearest-th-slot px py max-r)
    (define fpx (if (flonum? px) px (exact->inexact px)))
    (define fpy (if (flonum? py) py (exact->inexact py)))
    (define max-r2 (fl* max-r max-r))
    (for/fold ([best-slot #f] [best-pt #f] [best-d2 max-r2] #:result (values best-slot best-pt))
              ([pt (in-list owned-townhall-pts)]
               [slot (in-naturals 1)])
      (define dx (fl- fpx (car pt)))
      (define dy (fl- fpy (cdr pt)))
      (define d2 (fl+ (fl* dx dx) (fl* dy dy)))
      (if (fl<= d2 best-d2)
          (values slot pt d2)
          (values best-slot best-pt best-d2))))

  (define active-crisis-now?
    (or (eq? (hash-ref obs 'under-attack #f) #t)
        (eq? (hash-ref obs 'under-cheese-rush #f) #t)
        (for/or ([b (in-list ally-bldgs)])
          (and (hash? b) (eq? (hash-ref b 'under-attack #f) #t)))
        (for/or ([e (in-list enemy-units)])
          (and (hash? e)
               (let* ([rx (hash-ref e 'x 9999.0)]
                      [ry (hash-ref e 'y 9999.0)]
                      [ex (if (flonum? rx) rx (exact->inexact rx))]
                      [ey (if (flonum? ry) ry (exact->inexact ry))])
                 (or (let ([dx1 (fl- ex fbx)] [dy1 (fl- ey fby)]
                           [dx2 (fl- ex fnx)] [dy2 (fl- ey fny)])
                       (or (fl<= (fl+ (fl* dx1 dx1) (fl* dy1 dy1)) 784.0)
                           (fl<= (fl+ (fl* dx2 dx2) (fl* dy2 dy2)) 784.0)))
                     (for/or ([pt (in-list owned-townhall-pts)])
                       (define dx (fl- ex (car pt)))
                       (define dy (fl- ey (cdr pt)))
                       (fl<= (fl+ (fl* dx dx) (fl* dy dy)) 625.0))))))))

  ;; Locate live army front & active harass/drop/scout focus points in live games
  (define-values (live-army-pt live-harass-pt)
    (if (not live-cam-obs?)
        (values #f #f)
        (let ([cx-sum 0.0] [cy-sum 0.0] [c-cnt 0]
              [harass-pt #f] [harass-d2 0.0])
          (for ([u (in-list ally-units)]
                #:when (and (hash? u) (real? (hash-ref u 'x #f)) (real? (hash-ref u 'y #f))))
            (define ut (fast-canonical-unit-sym (unit-type-sym u)))
            (define ux (exact->inexact (hash-ref u 'x base-x)))
            (define uy (exact->inexact (hash-ref u 'y base-y)))
            (define d2-home (fl+ (fl* (fl- ux fbx) (fl- ux fbx))
                                 (fl* (fl- uy fby) (fl- uy fby))))
            (cond
              [(or (memq ut '(oracle banshee mutalisk dark-templar reaper adept hellion
                              warp-prism warp-prism-phasing overlord-transport))
                   (and (eq? ut 'medivac)
                        (or (> (safe-nonneg-int (hash-ref u 'cargo-space-taken 0) 0) 0)
                            (pair? (hash-ref u 'passengers '()))))
                   (and (memq ut '(scv probe drone)) (fl>= d2-home 1024.0)))
               (when (and (fl>= d2-home 484.0) (fl> d2-home harass-d2))
                 (set! harass-d2 d2-home)
                 (set! harass-pt (cons ux uy)))]
              [(combat-unit-record? u)
               (set! cx-sum (fl+ cx-sum ux))
               (set! cy-sum (fl+ cy-sum uy))
               (set! c-cnt (add1 c-cnt))]))
          (define army-pt
            (cond
              [(and (pair? enemy-units) (> c-cnt 0))
               (define acx (fl/ cx-sum (exact->inexact c-cnt)))
               (define acy (fl/ cy-sum (exact->inexact c-cnt)))
               (define near-e
                 (argmin (lambda (e)
                           (fast-dist2d acx acy
                                        (exact->inexact (hash-ref e 'x acx))
                                        (exact->inexact (hash-ref e 'y acy))))
                         enemy-units))
               (cons (safe-coord (hash-ref near-e 'x acx) acx)
                     (safe-coord (hash-ref near-e 'y acy) acy))]
              [(> c-cnt 0)
               (cons (fl/ cx-sum (exact->inexact c-cnt))
                     (fl/ cy-sum (exact->inexact c-cnt)))]
              [(pair? enemy-units)
               (cons (safe-coord (hash-ref (car enemy-units) 'x nat-x) nat-x)
                     (safe-coord (hash-ref (car enemy-units) 'y nat-y) nat-y))]
              [else #f]))
          (values army-pt harass-pt))))

  (define prev-focus-f (hash-ref bmarks 'last-camera-focus-frame #f))
  (define prev-focus-x (safe-finite-real (hash-ref bmarks 'last-camera-focus-x base-x) base-x))
  (define prev-focus-y (safe-finite-real (hash-ref bmarks 'last-camera-focus-y base-y) base-y))

  ;; Construct camera action (`(camera-bookmark-jump slot th-x th-y)` for bases or
  ;; `(camera-focus 'minimap-jump tx ty)` for distant tactical jumps in live games;
  ;; preserve legacy 4-zone `PRO-CAMERA-SACCADE-ZONES` for non-live synthetic calls).
  (define-values (cam-cmd zx zy)
    (cond
      [live-cam-obs?
       (define base-entries
         (if (pair? owned-townhall-pts)
             (for/list ([pt (in-list owned-townhall-pts)]
                        [slot (in-naturals 1)])
               (list 'bookmark slot (car pt) (cdr pt)))
             (list (list 'bookmark 1 base-x base-y))))
       (define army-entries
         (if live-army-pt
             (list (list 'tactical 'active-army-front (car live-army-pt) (cdr live-army-pt)))
             (list (list 'tactical 'active-army-front
                         (safe-coord (* 0.5 (+ nat-x enemy-x)) nat-x)
                         (safe-coord (* 0.5 (+ nat-y enemy-y)) nat-y)))))
       (define harass-entries
         (cond
           [live-harass-pt
            (list (list 'tactical 'harass-or-blocker-zone (car live-harass-pt) (cdr live-harass-pt)))]
           [(>= frame 3360)
            (list (list 'tactical 'harass-or-blocker-zone enemy-exp-x enemy-exp-y))]
           [else '()]))
       ;; L59 (`#1514`/`#1516`): When `active-crisis-now?` is true, INTERLEAVE crisis focus
       ;; with `F1..F8` base-centered camera hotkeys (`[crisis, F1, crisis, F2, ...]`, skipping
       ;; duplicate same-base slots) instead of locking onto `(car enemy-units)` every tick!
       (define crisis-entry
         (and active-crisis-now?
              (pair? enemy-units)
              (let* ([crisis-e
                      (argmin (lambda (e)
                                (define ex (exact->inexact (hash-ref e 'x base-x)))
                                (define ey (exact->inexact (hash-ref e 'y base-y)))
                                (if (pair? owned-townhall-pts)
                                    (for/fold ([md +inf.0]) ([pt (in-list owned-townhall-pts)])
                                      (flmin md (fast-dist2d ex ey (car pt) (cdr pt))))
                                    (fast-dist2d ex ey fbx fby)))
                              enemy-units)]
                     [cx (safe-coord (hash-ref crisis-e 'x nat-x) nat-x)]
                     [cy (safe-coord (hash-ref crisis-e 'y nat-y) nat-y)])
                (define-values (th-slot th-pt) (find-nearest-th-slot cx cy 16.0))
                (if (and th-slot th-pt)
                    (list 'bookmark th-slot (car th-pt) (cdr th-pt))
                    (list 'minimap 'crisis cx cy)))))
       (define live-cycle
         (if crisis-entry
             (let* ([crisis-slot (and (eq? (car crisis-entry) 'bookmark) (cadr crisis-entry))]
                    [cx0 (exact->inexact (caddr crisis-entry))]
                    [cy0 (exact->inexact (cadddr crisis-entry))]
                    [other-bases
                     (filter (lambda (be) (not (eqv? (cadr be) crisis-slot))) base-entries)]
                    [alt-entries
                     (if (pair? other-bases)
                         other-bases
                         (let* ([base-alt (append army-entries harass-entries)]
                                [far-alt
                                 (filter (lambda (ae)
                                           (fl>= (fast-dist2d (exact->inexact (caddr ae))
                                                              (exact->inexact (cadddr ae))
                                                              cx0 cy0)
                                                 14.0))
                                         base-alt)])
                           (if (pair? far-alt)
                               far-alt
                               (list (list 'tactical 'harass-or-blocker-zone enemy-exp-x enemy-exp-y)))))])
               (if (pair? alt-entries)
                   (apply append (for/list ([ae (in-list alt-entries)]) (list crisis-entry ae)))
                   (list crisis-entry)))
             (append base-entries army-entries harass-entries)))
       (define cycle-len (max 1 (length live-cycle)))
       (define next-idx
         (cond
           [(not (exact-integer? last-frame)) 0]
           [saccade-due? (modulo (add1 cur-idx) cycle-len)]
           [else (modulo cur-idx cycle-len)]))
       (when saccade-due?
         (hash-set! bmarks 'last-saccade-frame frame)
         (hash-set! bmarks 'saccade-zone-idx next-idx))
       (define entry (list-ref live-cycle next-idx))
       (case (car entry)
         [(bookmark)
          (define slot (cadr entry))
          (define bx (caddr entry))
          (define by (cadddr entry))
          (values (list 'camera-bookmark-jump slot bx by) bx by)]
         [(minimap)
          (define tx (caddr entry))
          (define ty (cadddr entry))
          (values (list 'camera-focus 'minimap-jump tx ty) tx ty)]
         [else
          (define zsym (cadr entry))
          (define tx (caddr entry))
          (define ty (cadddr entry))
          (define-values (th-slot th-pt) (find-nearest-th-slot tx ty 16.0))
          (cond
            [(and th-slot th-pt)
             (values (list 'camera-bookmark-jump th-slot (car th-pt) (cdr th-pt))
                     (car th-pt) (cdr th-pt))]
            [(>= (dist2d tx ty prev-focus-x prev-focus-y) 18.0)
             (values (list 'camera-focus 'minimap-jump tx ty) tx ty)]
            [else
             (values (list 'camera-focus zsym tx ty) tx ty)])])]
      [else
       (define next-idx
         (cond
           [(not (exact-integer? last-frame)) 0]
           [saccade-due?
            (modulo (add1 cur-idx) (length PRO-CAMERA-SACCADE-ZONES))]
           [else (modulo cur-idx (length PRO-CAMERA-SACCADE-ZONES))]))
       (when saccade-due?
         (hash-set! bmarks 'last-saccade-frame frame)
         (hash-set! bmarks 'saccade-zone-idx next-idx))
       (define zone (list-ref PRO-CAMERA-SACCADE-ZONES next-idx))
       (define-values (tx ty)
         (case zone
           [(home-macro-base) (values base-x base-y)]
           [(natural-expansion) (values nat-x nat-y)]
           [(active-army-front)
            (if (not (null? enemy-units))
                (values (safe-coord (hash-ref (car enemy-units) 'x nat-x) nat-x)
                        (safe-coord (hash-ref (car enemy-units) 'y nat-y) nat-y))
                (values (safe-coord (* 0.5 (+ nat-x enemy-x)) nat-x)
                        (safe-coord (* 0.5 (+ nat-y enemy-y)) nat-y)))]
           [(harass-or-blocker-zone) (values enemy-exp-x enemy-exp-y)]
           [else (values base-x base-y)]))
       (values (list 'camera-focus zone tx ty) tx ty)]))

  (define crisis-cam-jump?
    (and active-crisis-now?
         (or (not (exact-integer? prev-focus-f))
             (>= (- frame prev-focus-f) 10))
         (> (dist2d zx zy prev-focus-x prev-focus-y) 18.0)))
  (define emit-camera-focus?
    (or (not live-cam-obs?)
        (not (exact-integer? prev-focus-f))
        (< frame prev-focus-f)
        (>= (- frame prev-focus-f) 20)
        crisis-cam-jump?))
  (when emit-camera-focus?
    (hash-set! bmarks 'last-camera-focus-frame frame)
    (hash-set! bmarks 'last-camera-focus-x zx)
    (hash-set! bmarks 'last-camera-focus-y zy))

  (define prof (get-pro-cortex-profile (human-cortex-profile-name cortex)))
  (define target-apm (min 420 (safe-nonneg-int (hash-ref prof 'mean-epm 400) 400)))
  (if emit-camera-focus?
      (list cam-cmd
            (list 'human-apm-discipline target-apm 3 #t #t))
      (list (list 'human-apm-discipline target-apm 3 #t #t))))

;; =============================================================================
;; Top-Level 5-Layer Step (`step-live-bot-runtime!`)
;; =============================================================================

(define EXTENDED-STASIS-AND-DRILL-HEADS
  '(worker-drill-stack-attack
    evacuate-workers-from-stasis-ward
    trigger-stasis-ward-single-unit
    counter-enemy-worker-drill
    stasis-worker-stoppage-compensation
    return-workers-to-gather))

(define (step-live-bot-runtime! rt [obs-or-sexp (hash)])
  (define t0-step-ms (current-inexact-monotonic-milliseconds))
  (define raw-obs
    (cond
      [(hash? obs-or-sexp) obs-or-sexp]
      [(pair? obs-or-sexp) (parse-frame-state-sexp obs-or-sexp)]
      [(string? obs-or-sexp)
       (with-handlers ([exn:fail? (lambda (_e) (hash))])
         (parse-frame-state-sexp (read (open-input-string obs-or-sexp))))]
      [else (hash)]))
  (define obs (sanitize-obs-hash raw-obs))

  (set-live-bot-runtime-step-count! rt (add1 (live-bot-runtime-step-count rt)))
  (set-box! (rt-wall-aabbs-box rt) '())
  (vector-set! (rt-valid-tags-cache rt) 0 #f)

  ;; Layer 1
  (step-layer1-perception! rt obs #:sanitized? #t)
  ;; Layer 1b
  (define-values (posture-acts fap-score) (step-layer1b-mastermind! rt obs #:sanitized? #t))
  ;; Layer 1c (Generic k-Level Mirror-Mind Opponent Prediction Layer)
  ;; Cache unchanged midgame predictions up to 16 frames (~0.7s) in live games while running immediately on any change.
  (define step-frame-early (safe-nonneg-int (hash-ref obs 'frame 0) 0))
  (define door-st-cache (rt-door-state rt))
  (define mirror-cache (hash-ref door-st-cache 'mirror-cache #f))
  (define mirror-sig
    (list (length (hash-ref obs 'enemy-units '()))
          (length (hash-ref obs 'enemy-buildings '()))
          (length (hash-ref obs 'ally-buildings '()))
          (not (not (hash-ref obs 'under-attack #f)))))
  (define has-mh?
    (not (eq? (hash-ref raw-obs 'mineral-harvesters RUNTIME-MISSING) RUNTIME-MISSING)))
  (define run-mirror-now?
    (or (not has-mh?)
        (not (vector? mirror-cache))
        (<= step-frame-early 16)
        (< step-frame-early (vector-ref mirror-cache 0))
        (and (>= (- step-frame-early (vector-ref mirror-cache 0)) 16)
             (= (modulo step-frame-early 16) 8))
        (not (equal? mirror-sig (vector-ref mirror-cache 1)))))
  (define mirror-acts
    (cond
      [run-mirror-now?
       (define ma (step-layer1c-mirror-mind! rt obs))
       (hash-set! door-st-cache 'mirror-cache (vector step-frame-early mirror-sig ma))
       ma]
      [else '()]))
  (define mmstate-now (live-bot-runtime-mirror-mind rt))
  (define mmtech-now (and mmstate-now (mirror-mind-state-last-tech-observation mmstate-now)))
  (define obs-with-mirror
    (if mmstate-now
        (let* ([m-strat (mirror-mind-state-strategic-hypothesis mmstate-now)]
               [m-tact (mirror-mind-state-tactical-target mmstate-now)]
               [m-pre (mirror-mind-state-preemptive-counter-unit mmstate-now)]
               [m-pred (mirror-mind-state-predicted-enemy-unit mmstate-now)]
               [m-bases (mirror-mind-state-recommended-min-bases mmstate-now)]
               [m-verd (mirror-mind-state-mirror-macro-verdict mmstate-now)]
               [m-trust (mirror-mind-state-trust-mode mmstate-now)]
               [m-det? (and mmtech-now (enemy-tech-observation-requires-detection? mmtech-now))]
               [m-aa? (and mmtech-now (enemy-tech-observation-requires-anti-air? mmtech-now))]
               [m-upg (if mmtech-now (enemy-tech-observation-enemy-upgrade-advantage mmtech-now) 0)])
          (if (and (eq? (hash-ref obs 'mirror-strategy RUNTIME-MISSING) RUNTIME-MISSING)
                   (eq? (hash-ref obs 'mirror-tactical-target RUNTIME-MISSING) RUNTIME-MISSING)
                   (eq? (hash-ref obs 'mirror-preemptive-unit RUNTIME-MISSING) RUNTIME-MISSING)
                   (eq? (hash-ref obs 'mirror-predicted-enemy-unit RUNTIME-MISSING) RUNTIME-MISSING)
                   (eq? (hash-ref obs 'mirror-recommended-min-bases RUNTIME-MISSING) RUNTIME-MISSING)
                   (eq? (hash-ref obs 'mirror-macro-verdict RUNTIME-MISSING) RUNTIME-MISSING)
                   (eq? (hash-ref obs 'mirror-trust-mode RUNTIME-MISSING) RUNTIME-MISSING)
                   (eq? (hash-ref obs 'mirror-requires-detection? RUNTIME-MISSING) RUNTIME-MISSING)
                   (eq? (hash-ref obs 'mirror-requires-anti-air? RUNTIME-MISSING) RUNTIME-MISSING)
                   (eq? (hash-ref obs 'mirror-enemy-upgrade-advantage RUNTIME-MISSING) RUNTIME-MISSING))
              (hash-set* obs
                         'mirror-strategy m-strat
                         'mirror-tactical-target m-tact
                         'mirror-preemptive-unit m-pre
                         'mirror-predicted-enemy-unit m-pred
                         'mirror-recommended-min-bases m-bases
                         'mirror-macro-verdict m-verd
                         'mirror-trust-mode m-trust
                         'mirror-requires-detection? m-det?
                         'mirror-requires-anti-air? m-aa?
                         'mirror-enemy-upgrade-advantage m-upg)
              (let* ([o1 (if (eq? (hash-ref obs 'mirror-strategy RUNTIME-MISSING) RUNTIME-MISSING) (hash-set obs 'mirror-strategy m-strat) obs)]
                     [o2 (if (eq? (hash-ref o1 'mirror-tactical-target RUNTIME-MISSING) RUNTIME-MISSING) (hash-set o1 'mirror-tactical-target m-tact) o1)]
                     [o3 (if (eq? (hash-ref o2 'mirror-preemptive-unit RUNTIME-MISSING) RUNTIME-MISSING) (hash-set o2 'mirror-preemptive-unit m-pre) o2)]
                     [o4 (if (eq? (hash-ref o3 'mirror-predicted-enemy-unit RUNTIME-MISSING) RUNTIME-MISSING) (hash-set o3 'mirror-predicted-enemy-unit m-pred) o3)]
                     [o5 (if (eq? (hash-ref o4 'mirror-recommended-min-bases RUNTIME-MISSING) RUNTIME-MISSING) (hash-set o4 'mirror-recommended-min-bases m-bases) o4)]
                     [o6 (if (eq? (hash-ref o5 'mirror-macro-verdict RUNTIME-MISSING) RUNTIME-MISSING) (hash-set o5 'mirror-macro-verdict m-verd) o5)]
                     [o7 (if (eq? (hash-ref o6 'mirror-trust-mode RUNTIME-MISSING) RUNTIME-MISSING) (hash-set o6 'mirror-trust-mode m-trust) o6)]
                     [o8 (if (eq? (hash-ref o7 'mirror-requires-detection? RUNTIME-MISSING) RUNTIME-MISSING) (hash-set o7 'mirror-requires-detection? m-det?) o7)]
                     [o9 (if (eq? (hash-ref o8 'mirror-requires-anti-air? RUNTIME-MISSING) RUNTIME-MISSING) (hash-set o8 'mirror-requires-anti-air? m-aa?) o8)]
                     [o10 (if (eq? (hash-ref o9 'mirror-enemy-upgrade-advantage RUNTIME-MISSING) RUNTIME-MISSING) (hash-set o9 'mirror-enemy-upgrade-advantage m-upg) o9)])
                o10)))
        obs))
  ;; Layer 2
  (define econ-acts (step-layer2-economy! rt obs-with-mirror #:raw-obs raw-obs #:sanitized? #t))
  ;; Layer 3 & 4
  (define-values (tactic-acts vanguard-cnt reserve-cnt)
    (step-layer3-and-4-tactics! rt obs-with-mirror fap-score #:sanitized? #t))

  (define has-drill-head-passthrough?
    (and (hash? raw-obs)
         (or has-mh?
             (not (eq? (hash-ref raw-obs 'raw-mineral-harvesters RUNTIME-MISSING) RUNTIME-MISSING))
             (hash-ref raw-obs 'include-extended-drill-actions? #f))))
  ;; Loop 65 Addendum (`#1846`): Hoist tactical forward-Prism `(warp-in ...)` actions ahead of
  ;; `econ-acts` so `sc2-protobuf-ws.rkt` claims ready Warp Gates at the phased Warp Prism FIRST!
  (define-values (prism-warp-acts non-warp-tactic-acts)
    (if (ormap (lambda (a) (and (pair? a) (eq? (car a) 'warp-in))) tactic-acts)
        (partition (lambda (a) (and (pair? a) (eq? (car a) 'warp-in))) tactic-acts)
        (values '() tactic-acts)))
  (define raw-actions
    (if has-drill-head-passthrough?
        (if (null? prism-warp-acts)
            (append posture-acts econ-acts tactic-acts)
            (append posture-acts prism-warp-acts econ-acts non-warp-tactic-acts))
        (let ([acc-rev '()])
          (define (keep-non-drill! xs)
            (for ([a (in-list xs)])
              (unless (and (pair? a) (memq (car a) EXTENDED-STASIS-AND-DRILL-HEADS))
                (set! acc-rev (cons a acc-rev)))))
          (keep-non-drill! posture-acts)
          (unless (null? prism-warp-acts) (keep-non-drill! prism-warp-acts))
          (keep-non-drill! econ-acts)
          (keep-non-drill! non-warp-tactic-acts)
          (reverse acc-rev))))

  ;; Layer 5
  (define-values (accepted dropped spell-throttled)
    (step-layer5-human-cortex! rt raw-actions obs #:sanitized? #t))
  ;; Layer 5b: Pro-Human Camera Saccade (60-90 SPM) & APM/EPM Discipline Governor
  (define pro-apm-acts
    (step-pro-human-camera-and-apm-governor! rt obs #:sanitized? #t))
  (define cur-msp
    (let ([lt (live-bot-runtime-last-telemetry rt)])
      (and (hash? lt) (hash-ref lt 'max-supply-plan #f))))
  (define msp-set
    (if (and (max-supply-plan? cur-msp) (max-supply-plan-active? cur-msp))
        (max-supply-plan-combined-actions cur-msp)
        '()))
  (define accepted-ht-box #f)
  (define accepted-coalesced-cast-ht #f)
  (define accepted-coalesced-unit-ht #f)
  (define (get-accepted-ht)
    (unless accepted-ht-box
      (define ht (make-hash))
      (define cht (make-hash))
      (define uht (make-hash))
      (for ([a (in-list accepted)])
        (hash-set! ht a #t)
        ;; W12-P0-4-rt (`w12-tac-3`): Index coalesced multi-unit commands in `accepted` so
        ;; `preserved-tactical-directives` never re-appends individual single-tag copies on top!
        (when (and (pair? a) (pair? (cdr a)) (list? (cadr a)))
          (define h (car a))
          (cond
            [(and (or (eq? h 'cast) (eq? h 'cast-spell)) (pair? (cddr a)))
             (define sp (caddr a))
             (for ([uid (in-list (cadr a))])
               (when (exact-integer? uid)
                 (hash-set! cht (cons uid sp) #t)))]
            [(memq h '(attack-unit attack-pos move kite retreat hold-position))
             (for ([uid (in-list (cadr a))])
               (when (exact-integer? uid)
                 (hash-set! uht (cons h uid) #t)))])))
      (set! accepted-ht-box ht)
      (set! accepted-coalesced-cast-ht cht)
      (set! accepted-coalesced-unit-ht uht))
    accepted-ht-box)
  (define (action-already-in-accepted? a)
    (define ht (get-accepted-ht))
    (or (hash-ref ht a #f)
        (and (pair? a) (pair? (cdr a))
             (let ([h (car a)] [uid (cadr a)])
               (cond
                 [(and (or (eq? h 'cast) (eq? h 'cast-spell))
                       (exact-integer? uid)
                       (pair? (cddr a)))
                  (hash-ref accepted-coalesced-cast-ht (cons uid (caddr a)) #f)]
                 [(and (memq h '(attack-unit attack-pos move kite retreat hold-position))
                       (exact-integer? uid))
                  (hash-ref accepted-coalesced-unit-ht (cons h uid) #f)]
                 [else #f])))))
  (define msp-action-ht
    (and (pair? msp-set)
         (let ([ht (make-hash)])
           (for ([x (in-list msp-set)]) (hash-set! ht x #t))
           ht)))
  (define preserved-tactical-directives
    (let ([acc-rev '()]
          [splash-st-rt (rt-splash-state rt)])
      (define disruptor-dir-set
        (and (hash? splash-st-rt)
             (equal? (hash-ref splash-st-rt 'disruptor-directive-frame #f) step-frame-early)
             (hash-ref splash-st-rt 'disruptor-directive-set #f)))
      (define wave3-dir-set
        (and (hash? splash-st-rt)
             (equal? (hash-ref splash-st-rt 'wave3-preserved-frame #f) step-frame-early)
             (hash-ref splash-st-rt 'wave3-preserved-set #f)))
      (for ([a (in-list econ-acts)])
        (when (and (pair? a)
                   (let ([h (car a)])
                     (or (hash-ref PRESERVED-ECON-HEAD-SET h #f)
                         (and (or (eq? h 'cast) (eq? h 'cast-spell))
                              (pair? (cdr a))
                              (pair? (cddr a))
                              (hash-ref PRESERVED-ECON-CAST-SET (caddr a) #f))
                         (and msp-action-ht (hash-ref msp-action-ht a #f))))
                   (not (action-already-in-accepted? a)))
          (set! acc-rev (cons a acc-rev))))
      (for ([a (in-list tactic-acts)])
        (when (and (pair? a)
                   (let ([h (car a)])
                     (or (hash-ref PRESERVED-TACTIC-HEAD-SET h #f)
                         (and (or (eq? h 'cast) (eq? h 'cast-spell))
                              (pair? (cdr a))
                              (pair? (cddr a))
                              (hash-ref PRESERVED-TACTIC-CAST-SET (caddr a) #f))
                         (and disruptor-dir-set (set-member? disruptor-dir-set a))
                         (and wave3-dir-set (set-member? wave3-dir-set a))))
                   (not (action-already-in-accepted? a)))
          (set! acc-rev (cons a acc-rev))))
      (reverse acc-rev)))

  (define cortex (live-bot-runtime-cortex rt))
  (define mstate (live-bot-runtime-mastermind rt))
  (define mmstate (live-bot-runtime-mirror-mind rt))
  (define tbrain (live-bot-runtime-tactical-brain rt))
  (define oledger (live-bot-runtime-order-ledger rt))
  (define mmledger (mirror-mind-state-last-shadow-ledger mmstate))
  (define mmalloc (mirror-mind-state-toolbox-allocation mmstate))
  (define mmtech (mirror-mind-state-last-tech-observation mmstate))
  (define mmzs (mirror-mind-state-last-zero-sum-reading mmstate))
  (define scouted-sec-cnt
    (max 1 (length (hash-ref obs 'visible-sectors '(0 1 2 3)))))
