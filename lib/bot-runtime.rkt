(define (fast-enemy-sym-flags sym)
  (or (hash-ref ENEMY-SYM-FLAGS-CACHE sym #f)
      (let ([flags (+ (if (hash-ref RUNTIME-UNTARGETABLE-SET sym #f) 1 0)
                      (if (hash-ref RUNTIME-CHANGELING-SET sym #f) 2 0)
                      (if (hash-ref RUNTIME-MOBILE-DET-SET sym #f) 4 0)
                      (if (hash-ref RUNTIME-STATIC-DET-SET sym #f) 8 0)
                      (if (hash-ref RUNTIME-PASSIVE-DECOY-SET sym #f) 16 0)
                      (if (hash-ref RUNTIME-STRUCT-SYM-SET sym #f) 32 0)
                      (if (hash-ref RUNTIME-LIGHT-BIO-SET sym #f) 64 0)
                      (if (hash-ref RUNTIME-ARMORED-SET sym #f) 128 0)
                      (if (fast-unit-is-flying-sym? sym) 256 0))])
        (hash-set! ENEMY-SYM-FLAGS-CACHE sym flags)
        flags)))

(define (fast-finite-real v default)
  (if (and (real? v) (= (- v v) 0))
      v
      default))

