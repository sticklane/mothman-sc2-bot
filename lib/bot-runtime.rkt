(define (l34-phase4a-hazards-wm! ctx)
  (define ally-disruptor-units (l34-ctx-ally-disruptor-units ctx))
  (define ally-has-detector? (l34-ctx-ally-has-detector? ctx))
  (define ally-units (l34-ctx-ally-units ctx))
  (define base-x (l34-ctx-base-x ctx))
  (define base-y (l34-ctx-base-y ctx))
  (define can-break-siege-line? (l34-ctx-can-break-siege-line? ctx))
  (define combat-units (l34-ctx-combat-units ctx))
  (define disruptor-directive-set (l34-ctx-disruptor-directive-set ctx))
  (define disruptor-handled-tags (l34-ctx-disruptor-handled-tags ctx))
  (define effects (l34-ctx-effects ctx))
  (define enemy-disruptor-units (l34-ctx-enemy-disruptor-units ctx))
  (define enemy-sieged-tanks-near (l34-ctx-enemy-sieged-tanks-near ctx))
  (define enemy-units (l34-ctx-enemy-units ctx))
  (define enemy-widow-mines (l34-ctx-enemy-widow-mines ctx))
  (define frame (l34-ctx-frame ctx))
  (define live-tactics-obs? (l34-ctx-live-tactics-obs? ctx))
  (define nat-x (l34-ctx-nat-x ctx))
  (define nat-y (l34-ctx-nat-y ctx))
  (define obs (l34-ctx-obs ctx))
  (define oledger (l34-ctx-oledger ctx))
  (define prelim-army-cx (l34-ctx-prelim-army-cx ctx))
  (define prelim-army-cy (l34-ctx-prelim-army-cy ctx))
  (define rt (l34-ctx-rt ctx))
  (define siege-line-hold? (l34-ctx-siege-line-hold? ctx))
  (define spell-claims-rt (l34-ctx-spell-claims-rt ctx))
  (define splash-evading-tags (l34-ctx-splash-evading-tags ctx))
  (define splash-st (l34-ctx-splash-st ctx))
  (define splash-wm-disarmed-ht (l34-ctx-splash-wm-disarmed-ht ctx))
  (define tank-lurker-hazards (l34-ctx-tank-lurker-hazards ctx))
  (define any-disruptor-or-nova?
    (or (not (null? ally-disruptor-units))
        (not (null? enemy-disruptor-units))))
  (when any-disruptor-or-nova?
    (define (augment-disruptor-orders u)
      (if (not (hash? u))
          u
          (let* ([ords (hash-ref u 'orders #f)]
                 [ab-id (hash-ref u 'order-ability-id 0)]
                 [ox (hash-ref u 'order-target-x #f)]
                 [oy (hash-ref u 'order-target-y #f)])
            (if (or (list? ords) (not (and (exact-integer? ab-id) (> ab-id 0))))
                u
                (hash-set u 'orders
                          (list (hash 'ability_id ab-id
                                      'tx (or ox (hash-ref u 'x base-x))
                                      'ty (or oy (hash-ref u 'y base-y))
                                      'target_x (or ox (hash-ref u 'x base-x))
                                      'target_y (or oy (hash-ref u 'y base-y)))))))))
    (define enemy-dis-pts
      (for/list ([e (in-list enemy-disruptor-units)])
        (cons (exact->inexact (hash-ref e 'x 9999.0))
              (exact->inexact (hash-ref e 'y 9999.0)))))
    (define ally-dis-pts
      (for/list ([u (in-list ally-disruptor-units)])
        (cons (exact->inexact (hash-ref u 'x base-x))
              (exact->inexact (hash-ref u 'y base-y)))))
    (define (near-any-pt? pts x y r2)
      (and (pair? pts)
           (let ([xf (if (flonum? x) x (exact->inexact x))]
                 [yf (if (flonum? y) y (exact->inexact y))]
                 [r2f (if (flonum? r2) r2 (exact->inexact r2))])
             (for/or ([pt (in-list pts)])
               (define dx (fl- xf (car pt)))
               (define dy (fl- yf (cdr pt)))
               (fl<= (fl+ (fl* dx dx) (fl* dy dy)) r2f)))))
    (define has-live-nova?
      (or (for/or ([ef (in-list effects)])
            (define et (and (hash? ef) (hash-ref ef 'type #f)))
            (or (eq? et 'purification-nova)
                (eq? et 'disruptor-nova)
                (eq? et 'purification-nova-explosion)))
          (for/or ([e (in-list enemy-disruptor-units)])
            (eq? (unit-type-sym e) 'disruptor-phased))))
    (define dis-tr (rt-disruptor-tracker rt))
    (define dis-blink? (l34-has-upgrade? ctx 'blink))
    (define edis-quiet? (and (null? ally-disruptor-units) (not has-live-nova?)))
    (define edis-cnt 0)
    (define edis-id-sum 0)
    (define edis-x-sum 0.0)
    (define edis-y-sum 0.0)
    (define edis-hp-sum 0.0)
    (define edis-sh-sum 0.0)
    (when edis-quiet?
      (for ([e (in-list enemy-disruptor-units)]
            #:break (not edis-quiet?))
        (define eid (hash-ref e 'id -1))
        (define ab-id (hash-ref e 'order-ability-id 0))
        (define ords (hash-ref e 'orders #f))
        (define ex (hash-ref e 'x 9999.0))
        (define ey (hash-ref e 'y 9999.0))
        (define ehp (hash-ref e 'hp 150))
        (define esh (hash-ref e 'shield 150))
        (cond
          [(and (exact-integer? eid) (> eid 0)
                (not (and (exact-integer? ab-id) (> ab-id 0)))
                (not (pair? ords))
                (= (disruptor-tracker-enemy-active-nova-frames dis-tr eid frame) 0)
                (= (disruptor-tracker-enemy-cooldown dis-tr eid frame) 0)
                (real? ex) (real? ey) (real? ehp) (real? esh))
           (set! edis-cnt (add1 edis-cnt))
           (set! edis-id-sum (+ edis-id-sum eid))
           (set! edis-x-sum (fl+ edis-x-sum (if (flonum? ex) ex (exact->inexact ex))))
           (set! edis-y-sum (fl+ edis-y-sum (if (flonum? ey) ey (exact->inexact ey))))
           (set! edis-hp-sum (fl+ edis-hp-sum (if (flonum? ehp) ehp (exact->inexact ehp))))
           (set! edis-sh-sum (fl+ edis-sh-sum (if (flonum? esh) esh (exact->inexact esh))))]
          [else
           (set! edis-quiet? #f)])))
    (define ma-cnt 0)
    (define ma-id-sum 0)
    (define ma-x-sum 0.0)
    (define ma-y-sum 0.0)
    (define ma-hp-sum 0.0)
    (define ma-sh-sum 0.0)
    (define ma-en-sum 0.0)
    (define ma-ab-sum 0)
    (define micro-allies-rev
      (if (and (null? ally-dis-pts) (null? enemy-dis-pts) (not has-live-nova?))
          '()
          (for/fold ([rev '()]) ([u (in-list ally-units)])
            (define ut (unit-type-sym u))
            (define caster? (or (eq? ut 'disruptor) (eq? ut 'disruptor-phased)))
            (cond
              [caster?
               (set! edis-quiet? #f)
               (cons (augment-disruptor-orders u) rev)]
              [(and (or (pair? enemy-dis-pts) has-live-nova?)
                    (or has-live-nova?
                        (not (memq ut '(scv probe drone mule larva egg overlord observer))))
                    (let ([rx (hash-ref u 'x base-x)]
                          [ry (hash-ref u 'y base-y)])
                      (or has-live-nova?
                          (near-any-pt? enemy-dis-pts rx ry 225.0))))
               (when edis-quiet?
                 (define uid (hash-ref u 'id 0))
                 (define ux (hash-ref u 'x base-x))
                 (define uy (hash-ref u 'y base-y))
                 (define uhp (hash-ref u 'hp 45))
                 (define ush (hash-ref u 'shield 0))
                 (define uen (hash-ref u 'energy 0))
                 (define uab (hash-ref u 'order-ability-id 0))
                 (cond
                   [(and (exact-integer? uid) (exact-integer? uab)
                         (real? ux) (real? uy) (real? uhp) (real? ush) (real? uen))
                    (set! ma-cnt (add1 ma-cnt))
                    (set! ma-id-sum (+ ma-id-sum uid))
                    (set! ma-x-sum (fl+ ma-x-sum (if (flonum? ux) ux (exact->inexact ux))))
                    (set! ma-y-sum (fl+ ma-y-sum (if (flonum? uy) uy (exact->inexact uy))))
                    (set! ma-hp-sum (fl+ ma-hp-sum (if (flonum? uhp) uhp (exact->inexact uhp))))
                    (set! ma-sh-sum (fl+ ma-sh-sum (if (flonum? ush) ush (exact->inexact ush))))
                    (set! ma-en-sum (fl+ ma-en-sum (if (flonum? uen) uen (exact->inexact uen))))
                    (set! ma-ab-sum (+ ma-ab-sum uab))]
                   [else
                    (set! edis-quiet? #f)]))
               (cons u rev)]
              [else rev]))))
    (define dis-empty-cv (and edis-quiet? (hash-ref splash-st 'disruptor-empty-cache #f)))
    (define dis-empty-hit?
      (and edis-quiet?
           (vector? dis-empty-cv)
           (>= frame (vector-ref dis-empty-cv 0))
           (<= (- frame (vector-ref dis-empty-cv 0))
               (if (= (modulo frame 16) 8) 23 19))
           (eq? dis-tr (vector-ref dis-empty-cv 1))
           (eq? dis-blink? (vector-ref dis-empty-cv 2))
           (equal? base-x (vector-ref dis-empty-cv 3))
           (equal? base-y (vector-ref dis-empty-cv 4))
           (= edis-cnt (vector-ref dis-empty-cv 5))
           (= edis-id-sum (vector-ref dis-empty-cv 6))
           (fl= edis-x-sum (vector-ref dis-empty-cv 7))
           (fl= edis-y-sum (vector-ref dis-empty-cv 8))
           (fl= edis-hp-sum (vector-ref dis-empty-cv 9))
           (fl= edis-sh-sum (vector-ref dis-empty-cv 10))
           (= ma-cnt (vector-ref dis-empty-cv 11))
           (= ma-id-sum (vector-ref dis-empty-cv 12))
           (fl= ma-x-sum (vector-ref dis-empty-cv 13))
           (fl= ma-y-sum (vector-ref dis-empty-cv 14))
           (fl= ma-hp-sum (vector-ref dis-empty-cv 15))
           (fl= ma-sh-sum (vector-ref dis-empty-cv 16))
           (fl= ma-en-sum (vector-ref dis-empty-cv 17))
           (= ma-ab-sum (vector-ref dis-empty-cv 18))))
    (define d-acts
      (if dis-empty-hit?
          '()
          (let* ([micro-allies (reverse micro-allies-rev)]
                 [micro-enemies
                  (if (null? ally-dis-pts)
                      (for/list ([e (in-list enemy-disruptor-units)])
                        (augment-disruptor-orders e))
                      (for/list ([e (in-list enemy-units)]
                                 #:when (let ([et (unit-type-sym e)])
                                          (or (eq? et 'disruptor)
                                              (eq? et 'disruptor-phased)
                                              (let ([rx (hash-ref e 'x 9999.0)]
                                                    [ry (hash-ref e 'y 9999.0)])
                                                (near-any-pt? ally-dis-pts rx ry 361.0)))))
                        (augment-disruptor-orders e)))]
                 [acts
                  (step-disruptor-tactical-micro! micro-allies
                                                  micro-enemies
                                                  #:tracker dis-tr
                                                  #:current-frame frame
                                                  #:blink-researched? dis-blink?
                                                  #:home-x base-x
                                                  #:home-y base-y)])
            (when (and edis-quiet? (null? acts))
              (define v
                (or (hash-ref splash-st 'disruptor-empty-cache #f)
                    (let ([nv (make-vector 19 #f)])
                      (hash-set! splash-st 'disruptor-empty-cache nv)
                      nv)))
              (vector-set! v 0 frame)
              (vector-set! v 1 dis-tr)
              (vector-set! v 2 dis-blink?)
              (vector-set! v 3 base-x)
              (vector-set! v 4 base-y)
              (vector-set! v 5 edis-cnt)
              (vector-set! v 6 edis-id-sum)
              (vector-set! v 7 edis-x-sum)
              (vector-set! v 8 edis-y-sum)
              (vector-set! v 9 edis-hp-sum)
              (vector-set! v 10 edis-sh-sum)
              (vector-set! v 11 ma-cnt)
              (vector-set! v 12 ma-id-sum)
              (vector-set! v 13 ma-x-sum)
              (vector-set! v 14 ma-y-sum)
              (vector-set! v 15 ma-hp-sum)
              (vector-set! v 16 ma-sh-sum)
              (vector-set! v 17 ma-en-sum)
              (vector-set! v 18 ma-ab-sum))
            acts)))
    (define ally-by-id
      (and (pair? d-acts)
           (let ([ht (make-hasheqv)])
             (for ([u (in-list ally-units)]
                   #:when (hash? u))
               (define uid0 (hash-ref u 'id #f))
               (when (exact-integer? uid0) (hash-set! ht uid0 u)))
             ht)))
    (for ([da (in-list d-acts)]
          #:when (and (pair? da) (>= (length da) 3) (exact-integer? (second da))))
      (define raw-uid (second da))
      (define head (car da))
      (define u-rec (hash-ref ally-by-id raw-uid #f))
      (define u-ab-id (if u-rec (hash-ref u-rec 'order-ability-id 0) 0))
      (define u-prot (and live-tactics-obs? (> u-ab-id 0) (fast-order-protection-class u-ab-id)))
      (define hold-cast-walk? (memq u-prot '(morph channel cast-walk)))
      (define nova-stagger-ok?
        (or (not (eq? head 'purification-nova))
            (not live-tactics-obs?)
            (disruptor-nova-stagger-ready? spell-claims-rt
                                           frame
                                           DISRUPTOR-NOVA-STAGGER-DEFAULT-FRAMES
                                           #:commit? #t)))
      (when nova-stagger-ok?
        (set-add! disruptor-handled-tags raw-uid)
        (unless (and hold-cast-walk? (not (eq? head 'blink)))
          (define translated
            (case head
              [(purification-nova)
               (list 'cast-spell raw-uid 'purification-nova (third da) (fourth da))]
              [(blink)
               (list 'cast-spell raw-uid 'blink (third da) (fourth da))]
              [(move kite)
               (list head raw-uid (third da) (fourth da))]
              [(split)
               (list 'move raw-uid (third da) (fourth da))]
              [(attack-unit)
               (list 'attack-unit raw-uid (third da))]
              [else da]))
          (when (memq head '(purification-nova blink move kite split))
            (set-add! splash-evading-tags raw-uid))
          (set-add! disruptor-directive-set translated)
          (l34-emit! ctx translated)))))
  (hash-set! splash-st 'disruptor-directive-frame frame)
  (hash-set! splash-st 'disruptor-directive-set disruptor-directive-set)

  ;; 1. Emergency Ground-Effect & Purification Nova (`disruptor-phased`) Evasion
  (define hazard-zones
    (append
     (for/list ([eff (in-list effects)]
                #:when (and (hash? eff)
                            (memq (hash-ref eff 'type 'none)
                                  '(psi-storm psionic-storm corrosive-bile blinding-cloud nuke-persistent))))
       (list (hash-ref eff 'x nat-x)
             (hash-ref eff 'y nat-y)
             (safe-finite-real (hash-ref eff 'radius 3.0) 3.0)))
     (if (or any-disruptor-or-nova? (null? enemy-disruptor-units))
         '()
         (for/list ([e (in-list enemy-disruptor-units)]
                    #:when (eq? (unit-type-sym e) 'disruptor-phased))
           (list (hash-ref e 'x nat-x)
                 (hash-ref e 'y nat-y)
                 4.5)))))
  (define base-fx (if (flonum? base-x) base-x (exact->inexact base-x)))
  (define base-fy (if (flonum? base-y) base-y (exact->inexact base-y)))
  (for ([hz (in-list hazard-zones)])
    (define hx (first hz))
    (define hy (second hz))
    (define hrad (third hz))
    (define fhx (if (flonum? hx) hx (if (real? hx) (exact->inexact hx) +nan.0)))
    (define fhy (if (flonum? hy) hy (if (real? hy) (exact->inexact hy) +nan.0)))
    (define fhrad (if (flonum? hrad) hrad (exact->inexact hrad)))
    (define fhrad2 (if (fl>= fhrad 0.0) (fl* fhrad fhrad) -1.0))
    (define affected
      (if (fl< fhrad2 0.0)
          '()
          (let ([rev '()])
            (for ([u (in-list combat-units)])
              (define ux-raw (hash-ref u 'x base-fx))
              (define uy-raw (hash-ref u 'y base-fy))
              (define fux (if (flonum? ux-raw) ux-raw (if (real? ux-raw) (exact->inexact ux-raw) +nan.0)))
              (define fuy (if (flonum? uy-raw) uy-raw (if (real? uy-raw) (exact->inexact uy-raw) +nan.0)))
              (define dx (fl- fux fhx))
              (define dy (fl- fuy fhy))
              (when (fl<= (fl+ (fl* dx dx) (fl* dy dy)) fhrad2)
                (define uid (hash-ref u 'id 101))
                (unless (set-member? splash-evading-tags uid)
                  (define ab-id (hash-ref u 'order-ability-id 0))
                  (define prot (and live-tactics-obs? (> ab-id 0) (fast-order-protection-class ab-id)))
                  (when (and (not (and live-tactics-obs?
                                       (or (memq prot '(morph channel cast-walk))
                                           (snipe-channel-locked? spell-claims-rt uid frame))))
                             (not (order-ledger-unit-in-attack-swing? oledger u)))
                    (set! rev (cons u rev))))))
            (reverse rev))))
    (cond
      [(and live-tactics-obs? (>= (length affected) 4))
       (define hdx (- prelim-army-cx hx))
       (define hdy (- prelim-army-cy hy))
       (define hd (max 1.0 (sqrt (+ (* hdx hdx) (* hdy hdy)))))
       (define hnx (/ (- hdy) hd))
       (define hny (/ hdx hd))
       (define left-ids
         (for/list ([u (in-list affected)] #:when (even? (hash-ref u 'id 0)))
           (define uid (hash-ref u 'id 0))
           (set-add! splash-evading-tags uid)
           uid))
       (define right-ids
         (for/list ([u (in-list affected)] #:when (odd? (hash-ref u 'id 0)))
           (define uid (hash-ref u 'id 0))
           (set-add! splash-evading-tags uid)
           uid))
       (when (not (null? left-ids))
         (l34-emit! ctx (list 'kite left-ids
                      (l34-quantize-cell-2.5 ctx (+ hx (* 4.5 hnx) (* 2.0 (/ hdx hd))) base-x)
                      (l34-quantize-cell-2.5 ctx (+ hy (* 4.5 hny) (* 2.0 (/ hdy hd))) base-y))))
       (when (not (null? right-ids))
         (l34-emit! ctx (list 'kite right-ids
                      (l34-quantize-cell-2.5 ctx (+ hx (* -4.5 hnx) (* 2.0 (/ hdx hd))) base-x)
                      (l34-quantize-cell-2.5 ctx (+ hy (* -4.5 hny) (* 2.0 (/ hdy hd))) base-y))))]
      [else
       (for ([u (in-list affected)])
         (define uid (hash-ref u 'id 101))
         (define ux (hash-ref u 'x base-x))
         (define uy (hash-ref u 'y base-y))
         (define-values (kx ky) (compute-kite-vector ux uy hx hy 3.5))
         (set-add! splash-evading-tags uid)
         (l34-emit! ctx (list 'kite uid (l34-quantize-cell-2.5 ctx kx ux) (l34-quantize-cell-2.5 ctx ky uy))))]))

  ;; 1b. Enemy Siege Tank Deadzone Dive / Radial Split & Lurker Spine Avoidance
  (define lurker-spine-effects
    (if (null? effects)
        '()
        (for/list ([eff (in-list effects)]
                   #:when (and (hash? eff)
                               (memq (or (hash-ref eff 'type #f)
                                         (hash-ref eff 'spell #f)
                                         (hash-ref eff 'kind #f)
                                         (hash-ref eff 'ability #f)
                                         (hash-ref eff 'name 'none))
                                     '(lurker-spines lurker-spine lurker-mp-spines))))
          eff)))
  (define base-splash-hazards
    (let ([colossi
           (for/list ([e (in-list (l34-ctx-enemy-air-or-colossus ctx))]
                      #:when (eq? (unit-type-sym e) 'colossus))
             e)])
      (if (null? colossi)
          tank-lurker-hazards
          (append tank-lurker-hazards colossi))))
  (define splash-tactical-disp
    (or (hash-ref obs 'bo-tactical-disposition #f)
        (hash-ref obs 'tactical-disposition #f)
        (let ([dst (l34-ctx-door-st-tactics ctx)])
          (and (hash? dst) (hash-ref dst 'bo-tactical-disposition #f)))
        (and live-tactics-obs?
             (or (pair? base-splash-hazards) (pair? lurker-spine-effects))
             (bo-active-tactical-plan-disposition (l34-get-bo-tplan ctx)))))
  (define splash-lr (hash-ref obs 'lanchester-ratio #f))
  (define splash-live-combat-sup (l34-ctx-live-combat-supply ctx))
  (define splash-vis-enemy-sup (l34-ctx-visible-enemy-combat-supply ctx))
  (define commit-splash?
    (and (or (pair? base-splash-hazards) (pair? lurker-spine-effects))
         (or (eq? splash-tactical-disp 'execute-timing-attack-commit)
             (>= splash-live-combat-sup (* 0.90 splash-vis-enemy-sup)))
         (should-commit-through-splash?
          combat-units
          enemy-units
          #:tactical-disposition splash-tactical-disp
          #:lanchester-ratio splash-lr
          #:has-detector? ally-has-detector?)))
  (define siege-flank-break?
    (and live-tactics-obs?
         (>= (length enemy-sieged-tanks-near) 2)
         can-break-siege-line?
         (>= (length combat-units) 6)))
  (define suppress-tank-split?
    (or (and siege-line-hold? (not commit-splash?))
        siege-flank-break?))
  (define eff-tank-lurker-hazards
    (if (and suppress-tank-split? (pair? base-splash-hazards))
        (filter (lambda (e) (not (memq (unit-type-sym e) '(siege-tank-sieged siege-tank))))
                base-splash-hazards)
        base-splash-hazards))
  ;; L38-P0-1a + L39-P0-1b (`p15` DT Blink PF 1-Shot Snipe): Run BEFORE Tank/Lurker splash-split
  ;; AND Phase 4b 3-flank break so Siege Tank splash evasion NEVER steals DTs into `splash-evading-tags`!
  ;; `>= 4` Dark Templars cloaked-walk (`move`) until `<= 10.95t` of PF center, then cast coordinated
  ;; `ShadowStride (2700)` directly onto the `3.0..3.5t` PF perimeter ring + focus-fire PF & Turrets!
  (let ([dt-cnt (for/sum ([u (in-list combat-units)]
                          #:when (and (hash? u) (eq? (unit-type-sym u) 'dark-templar)))
                  1)])
    (when (>= dt-cnt 1)
      (define researched-upgs-dt (l34-ctx-researched-upgs ctx))
      (define enemy-bldgs-dt (or (l34-ctx-enemy-bldgs ctx) '()))
      (define ss-ok?
        (or (not (l34-ctx-live-upgrades-tracked? ctx))
            (shadow-stride-researched? researched-upgs-dt)))
      (define excl-ids
        (for/list ([id (in-set splash-evading-tags)]) id))
      ;; L49-W1: When non-Blink DTs (`not ss-ok?`) are paired with `>= 2` ranged/air anti-detector
      ;; allies (`stalker`/`phoenix`/etc.), skip `plan-dt-blink-pf-snipe`'s walk-in so Phase 5
      ;; `[(dark-templar)]` stages DTs safely outside `12.2t` until allies snipe the detectors!
      (define dt-has-ranged-snipers?
        (and (not ss-ok?)
             (>= (count (lambda (au)
                          (and (hash? au)
                               (let ([aut (fast-canonical-unit-sym (unit-type-sym au))])
                                 (and (not (eq? aut 'dark-templar))
                                      (or (fast-can-attack-air? aut)
                                          (and (fast-can-attack-ground? aut)
                                               (let ([st (fast-unit-combat-stats aut)])
                                                 (and (hash? st) (>= (hash-ref st 'ground-range 0.0) 4.0)))))))))
                        combat-units)
                 2)))
      (define dt-dirs
        (if dt-has-ranged-snipers?
            '()
            (plan-dt-blink-pf-snipe
             combat-units enemy-units enemy-bldgs-dt spell-claims-rt frame
             #:researched-upgrades researched-upgs-dt
             #:shadow-stride-ok? ss-ok?
             #:exclude-tags excl-ids)))
      (for ([sd (in-list dt-dirs)])
        (define cid (spell-directive-caster-tag sd))
        (define mode (spell-directive-target-mode sd))
        (set-add! splash-evading-tags cid)
        (cond
          [(eq? mode 'hold) (void)]
          [(eq? mode 'point)
           (l34-emit-preserved!
            ctx
            (list 'cast-spell cid 'shadow-stride
                  (safe-coord (spell-directive-target-x sd) base-x)
                  (safe-coord (spell-directive-target-y sd) base-y)))]
          [(eq? mode 'move)
           (l34-emit-preserved!
            ctx
            (list 'move cid
                  (safe-coord (spell-directive-target-x sd) base-x)
                  (safe-coord (spell-directive-target-y sd) base-y)))]
          [else
           (l34-emit-preserved! ctx (spell-directive->sexp sd))]))
      ;; L45-P0-1b (`p15` 56/60 Draw -> ~1.55x FULL KO WIN): Maintain rolling ground-enemy memory
      ;; (plus optional wire fog-memory obs keys) for surviving cloaked Dark Templars. Once all
      ;; visible detectors & PFs are dead and ZERO visible ground enemies remain (e.g. only unarmed
      ;; flying Medivacs overhead while 1 lone Sieged Tank hides in Fog behind a wall!), sweep
      ;; surviving DTs across unvisited remembered ground positions + an expanding 8-point perimeter
      ;; ring (`r=9t`/`15t`) around the fight centroid so they find & finish the last hidden unit!
      (when (and live-tactics-obs? rt)
        (define ds-dt (rt-door-state rt))
        (define prev-dt-f (hash-ref ds-dt 'l45-dt-mem-last-f -9999))
        (when (or (<= frame 4) (< frame prev-dt-f) (> (- frame prev-dt-f) 600))
          (hash-set! ds-dt 'l45-dt-ground-mem-ht (make-hasheqv))
          (hash-set! ds-dt 'l45-dt-visited-ring (make-hash))
          (hash-remove! ds-dt 'l45-dt-fight-cx)
          (hash-remove! ds-dt 'l45-dt-fight-cy)
          (hash-remove! ds-dt 'l45-dt-fight-f))
        (hash-set! ds-dt 'l45-dt-mem-last-f frame)
        (define gmem-ht
          (or (let ([h (hash-ref ds-dt 'l45-dt-ground-mem-ht #f)]) (and (hash? h) h))
              (let ([h (make-hasheqv)]) (hash-set! ds-dt 'l45-dt-ground-mem-ht h) h)))
        (define dead-dt-tags (or (l34-ctx-dead-tags-rt ctx) '()))
        (for ([did (in-list dead-dt-tags)] #:when (exact-integer? did))
          (hash-remove! gmem-ht did))
        (define active-dts-now
          (for/list ([u (in-list combat-units)]
                     #:when (and (hash? u)
                                 (eq? (unit-type-sym u) 'dark-templar)
                                 (real? (hash-ref u 'x #f))
                                 (real? (hash-ref u 'y #f))))
            u))
        (define (dt-enemy-ground-visible? e)
          (and (hash? e)
               (not (eq? (hash-ref e 'snapshot? #f) #t))
               (eqv? (hash-ref e 'display-type 1) 1)
               (not (eq? (hash-ref e 'hallucination #f) #t))
               (let ([et (unit-type-sym e)])
                 (and (not (eq? (hash-ref e 'flying #f) #t))
                      (not (eq? (hash-ref e 'flying? #f) #t))
                      (not (eq? (hash-ref e 'is-flying #f) #t))
                      (not (fast-unit-is-flying-sym? et))
                      (not (memq et '(creep-tumor creep-tumor-burrowed creep-tumor-queen larva egg
                                      changeling changeling-zealot changeling-zergling
                                      changeling-zergling-wings changeling-marine changeling-marine-shield)))))))
        (define vis-ground-enemies
          (append (filter dt-enemy-ground-visible? enemy-units)
                  (filter dt-enemy-ground-visible? enemy-bldgs-dt)))
        (define any-vis-det-or-pf?
          (or (for/or ([e (in-list enemy-units)])
                (and (hash? e)
                     (not (eq? (hash-ref e 'snapshot? #f) #t))
                     (eqv? (hash-ref e 'display-type 1) 1)
                     (memq (fast-canonical-unit-sym (unit-type-sym e))
                           '(observer observer-siege-mode raven overseer overseer-siege-mode))))
              (for/or ([eb (in-list enemy-bldgs-dt)])
                (and (hash? eb)
                     (not (eq? (hash-ref eb 'snapshot? #f) #t))
                     (eqv? (hash-ref eb 'display-type 1) 1)
                     (memq (fast-canonical-structure-sym (unit-type-sym eb))
                           '(missile-turret photon-cannon spore-crawler planetary-fortress))))))
        ;; Record visible ground enemy positions + fight centroid
        (when (pair? vis-ground-enemies)
          (define-values (gsx gsy gn)
            (for/fold ([sx 0.0] [sy 0.0] [n 0]) ([ge (in-list vis-ground-enemies)])
              (define gid (hash-ref ge 'id 0))
              (define gx0 (hash-ref ge 'x #f))
              (define gy0 (hash-ref ge 'y #f))
              (if (and (real? gx0) (real? gy0))
                  (let ([fgx (exact->inexact gx0)] [fgy (exact->inexact gy0)])
                    (when (and (exact-integer? gid) (> gid 0))
                      (hash-set! gmem-ht gid (vector fgx fgy frame)))
                    (values (fl+ sx fgx) (fl+ sy fgy) (add1 n)))
                  (values sx sy n))))
          (when (> gn 0)
            (hash-set! ds-dt 'l45-dt-fight-cx (fl/ gsx (exact->inexact gn)))
            (hash-set! ds-dt 'l45-dt-fight-cy (fl/ gsy (exact->inexact gn)))
            (hash-set! ds-dt 'l45-dt-fight-f frame)))
        ;; Also ingest wire-supplied visibility-backed fog ground enemy positions (`#1016`)
        (let ([wire-fog (or (hash-ref obs 'remembered-enemy-ground-positions #f)
                            (hash-ref obs 'fog-enemy-ground-positions #f)
                            (hash-ref obs 'last-known-enemy-ground-positions #f))])
          (when (list? wire-fog)
            (for ([entry (in-list wire-fog)] [k (in-naturals 1)])
              (cond
                [(and (hash? entry) (real? (hash-ref entry 'x #f)) (real? (hash-ref entry 'y #f)))
                 (define tid (let ([id0 (hash-ref entry 'id (hash-ref entry 'tag (- k)))])
                               (if (exact-integer? id0) id0 (- k))))
                 (hash-set! gmem-ht tid (vector (exact->inexact (hash-ref entry 'x))
                                                (exact->inexact (hash-ref entry 'y))
                                                frame))]
                [(and (pair? entry) (real? (car entry)) (real? (cdr entry)))
                 (hash-set! gmem-ht (- k) (vector (exact->inexact (car entry))
                                                  (exact->inexact (cdr entry))
                                                  frame))]))))
        ;; Sweep when 0 visible detectors, 0 visible PFs, and 0 visible ground enemies remain!
        (when (and (pair? active-dts-now)
                   (not any-vis-det-or-pf?)
                   (null? vis-ground-enemies))
          (define n-dts (exact->inexact (length active-dts-now)))
          (define dt-cx (/ (for/sum ([u (in-list active-dts-now)]) (exact->inexact (hash-ref u 'x base-x))) n-dts))
          (define dt-cy (/ (for/sum ([u (in-list active-dts-now)]) (exact->inexact (hash-ref u 'y base-y))) n-dts))
          ;; Prune stale (> 700f), far (> 40t), or already-checked (<= 4.0t of any DT) ground memory entries
          (define stale-or-visited
            (for/list ([(gid vec) (in-hash gmem-ht)]
                       #:when (let ([gx (vector-ref vec 0)]
                                    [gy (vector-ref vec 1)]
                                    [gf (vector-ref vec 2)])
                                (or (> (- frame gf) 700)
                                    (> (fast-dist2d dt-cx dt-cy gx gy) 40.0)
                                    (for/or ([u (in-list active-dts-now)])
                                      (<= (fast-dist2d (exact->inexact (hash-ref u 'x base-x))
                                                       (exact->inexact (hash-ref u 'y base-y))
                                                       gx gy)
                                          4.0)))))
              gid))
          (for ([gid (in-list stale-or-visited)]) (hash-remove! gmem-ht gid))
          (define fcx (hash-ref ds-dt 'l45-dt-fight-cx #f))
          (define fcy (hash-ref ds-dt 'l45-dt-fight-cy #f))
          (define ff (hash-ref ds-dt 'l45-dt-fight-f -9999))
          (define recent-fight? (and (real? fcx) (real? fcy) (<= (- frame ff) 700)
                                     (<= (fast-dist2d dt-cx dt-cy (exact->inexact fcx) (exact->inexact fcy)) 36.0)))
          (define mem-pts
            (map cdr
                 (sort (for/list ([(_gid vec) (in-hash gmem-ht)])
                         (define gx (vector-ref vec 0))
                         (define gy (vector-ref vec 1))
                         (cons (fast-dist2d dt-cx dt-cy gx gy) (cons gx gy)))
                       < #:key car)))
          (define ring-pts
            (if (or (pair? mem-pts) recent-fight?)
                (let* ([cx0 (if recent-fight? (exact->inexact fcx) dt-cx)]
                       [cy0 (if recent-fight? (exact->inexact fcy) dt-cy)]
                       [vring (or (let ([h (hash-ref ds-dt 'l45-dt-visited-ring #f)]) (and (hash? h) h))
                                  (let ([h (make-hash)]) (hash-set! ds-dt 'l45-dt-visited-ring h) h))]
                       [raw-ring
                        (for*/list ([rad (in-list '(9.0 15.0))]
                                    [k (in-range 8)])
                          (define ang (* (exact->inexact k) (/ pi 4.0)))
                          (define rx (safe-coord (+ cx0 (* rad (cos ang))) cx0))
                          (define ry (safe-coord (+ cy0 (* rad (sin ang))) cy0))
                          (cons (cons rad k) (cons rx ry)))])
                  (for ([item (in-list raw-ring)])
                    (define pt (cdr item))
                    (when (for/or ([u (in-list active-dts-now)])
                            (<= (fast-dist2d (exact->inexact (hash-ref u 'x base-x))
                                             (exact->inexact (hash-ref u 'y base-y))
                                             (car pt) (cdr pt))
                                4.5))
                      (hash-set! vring (car item) #t)))
                  (define unvisited
                    (for/list ([item (in-list raw-ring)]
                               #:when (not (hash-has-key? vring (car item))))
                      (cdr item)))
                  (if (pair? unvisited)
                      unvisited
                      (begin (hash-clear! vring) (map cdr raw-ring))))
                '()))
          (define sweep-pts (append mem-pts ring-pts))
          (when (pair? sweep-pts)
            (define w3-dt (l34-ctx-wave3-handled-tags ctx))
            (define n-pts (length sweep-pts))
            (for ([u (in-list active-dts-now)]
                  [idx (in-naturals)])
              (define uid (hash-ref u 'id -1))
              (when (and (> uid 0) (not (set-member? splash-evading-tags uid)))
                (define pt (list-ref sweep-pts (modulo idx n-pts)))
                (set-add! splash-evading-tags uid)
                (set-add! w3-dt uid)
                (l34-emit-preserved! ctx (list 'attack-pos uid (car pt) (cdr pt))))))))))

  ;; L39-P0-1e (`z16` Mutalisk Magic-Box vs Thors): When `>= 6` Mutalisks engage enemy `Thor`s,
  ;; spread into non-crossing concentric slots (`>= 1.5t` spacing > Thor 1.0t Javelin splash) directly
  ;; over the Thor via pure `MOVE (16)` then `HOLD_POSITION (18)` — zero boid-clumping!
  (let ([muta-cnt (for/sum ([u (in-list combat-units)]
                            #:when (and (hash? u) (eq? (unit-type-sym u) 'mutalisk)))
                    1)]
        [has-enemy-thor?
         (for/or ([e (in-list enemy-units)])
           (and (hash? e)
                (memq (fast-canonical-unit-sym (unit-type-sym e)) '(thor thor-ap))
                #t))])
    (when (and (>= muta-cnt 2) has-enemy-thor?)
      (define excl-ids
        (for/list ([id (in-set splash-evading-tags)]) id))
      (define muta-dirs
        (plan-mutalisk-magic-box combat-units enemy-units #:exclude-tags excl-ids))
      ;; L47-P0-1a (`z16` HOLD_POSITION 18 Spam Dampening `246 -> ~60-80`):
      ;; Emit `hold-position (18)` immediately upon entering spread-hold (or after any `move`/`kite`),
      ;; then keep `cid` locked in `splash-evading-tags` for `28f` without re-spamming `18` every 4f!
      (define muta-hold-ht
        (hash-ref! (l34-ctx-splash-st ctx) 'muta-magicbox-hold-frame-ht make-hasheqv))
      (for ([sd (in-list muta-dirs)])
        (define cid (spell-directive-caster-tag sd))
        (define mode (spell-directive-target-mode sd))
        (set-add! splash-evading-tags cid)
        (cond
          [(eq? mode 'hold-position)
           (define last-hf (hash-ref muta-hold-ht cid -9999))
           (when (or (< frame last-hf) (>= (- frame last-hf) 28))
             (hash-set! muta-hold-ht cid frame)
             (l34-emit-preserved! ctx (list 'hold-position cid)))]
          [(eq? mode 'kite)
           (hash-remove! muta-hold-ht cid)
           (l34-emit-preserved!
            ctx
            (list 'kite cid
                  (safe-coord (spell-directive-target-x sd) base-x)
                  (safe-coord (spell-directive-target-y sd) base-y)))]
          [else
           (hash-remove! muta-hold-ht cid)
           (l34-emit-preserved!
            ctx
            (list 'move cid
                  (safe-coord (spell-directive-target-x sd) base-x)
                  (safe-coord (spell-directive-target-y sd) base-y)))]))))

  ;; L43-P0-1b + L44-P0-1a (Stalker Blink-Back & Coordinated Blink-Forward High-Value Snipe):
  ;; Runs BEFORE Tank splash-evasion so `>= 5` Blink-ready Stalkers with local parity and safe
  ;; Tank overlap blink straight into Sieged Tank `1.75t` dead-zone / under Colossi/Liberators
  ;; AND lock post-blink focus-fire (`40f` window in `blink-hv-focus-ht`) onto `best-hv`!
  ;; When parity/Tank-overlap rejects forward blink (`#04 PvT`), Tank splash-evasion runs safely!
  (define blink-hv-focus-ht
    (hash-ref! (l34-ctx-splash-st ctx) 'stalker-blink-hv-focus-ht make-hasheqv))
  (let ([has-stalker?
         (for/or ([u (in-list combat-units)])
           (and (hash? u) (eq? (unit-type-sym u) 'stalker)))])
    (when (and has-stalker?
               (pair? enemy-units)
               (l34-has-upgrade? ctx 'blink))
      (define excl-ids (for/list ([id (in-set splash-evading-tags)]) id))
      (define sb-dirs
        (plan-stalker-blink-micro
         combat-units enemy-units spell-claims-rt frame
         #:researched-upgrades (l34-ctx-researched-upgs ctx)
         #:blink-ok? #t
         #:allow-forward? (null? enemy-widow-mines)
         #:exclude-tags excl-ids))
      (for ([sd (in-list sb-dirs)])
        (define cid (spell-directive-caster-tag sd))
        (define hv-tid (spell-directive-target-tag sd))
        (set-add! splash-evading-tags cid)
        ;; Sync cooldown into `cooldown-tracker` so Phase 5b inline `stalker` fallback NEVER
        ;; double-casts Blink during the 157f cooldown (`novel-101`)!
        (refractory-allow-action?! (live-bot-runtime-cooldown-tracker rt)
                                   (list 'stalker-blink cid)
                                   frame
                                   157)
        (when (and (eq? (spell-directive-pattern-name sd) 'stalker-blink-forward-snipe)
                   (exact-integer? hv-tid)
                   (> hv-tid 0))
          (hash-set! blink-hv-focus-ht cid (cons hv-tid (+ frame 112))))
        (l34-emit-preserved!
         ctx
         (list 'cast-spell cid 'blink
               (safe-coord (spell-directive-target-x sd) base-x)
               (safe-coord (spell-directive-target-y sd) base-y))))
      ;; L49-W1 + L49-W2 (Stalker Forward-Blink Close-In): When `>= 6` Blink-ready Stalkers
      ;; (`total-hp >= 85.0`) have an approved `siege-tank-sieged` or `colossus` target just outside
      ;; single-Blink reach (`10.45t..14.5t` Tank / `10.0t..14.5t` Colossus), close directly toward
      ;; it instead of letting Tank splash-evasion push them backward out of Blink range!
      (when (and (null? sb-dirs) (null? enemy-widow-mines))
        (define blink-cd-ht (spell-claims-stalker-blink-ready-frame spell-claims-rt))
        (define ready-st
          (for/list ([u (in-list combat-units)]
                     #:when (and (hash? u)
                                 (eq? (unit-type-sym u) 'stalker)
                                 (not (eq? (hash-ref u 'hallucination #f) #t))
                                 (not (set-member? splash-evading-tags (hash-ref u 'id -1)))
                                 (>= (exact->inexact (unit-total-hp-and-shield u)) 85.0)
                                 (>= frame (hash-ref blink-cd-ht (hash-ref u 'id -1) -10000))))
            u))
        (when (>= (length ready-st) 6)
          (define rn (exact->inexact (length ready-st)))
          (define scx (/ (for/sum ([u (in-list ready-st)]) (exact->inexact (hash-ref u 'x base-x))) rn))
          (define scy (/ (for/sum ([u (in-list ready-st)]) (exact->inexact (hash-ref u 'y base-y))) rn))
          (define close-hv
            (for/fold ([best #f] [best-d +inf.0] #:result best)
                      ([e (in-list enemy-units)]
                       #:when (and (hash? e)
                                   (not (eq? (hash-ref e 'snapshot? #f) #t))
                                   (memq (unit-type-sym e) '(siege-tank-sieged colossus))
                                   (real? (hash-ref e 'x #f)) (real? (hash-ref e 'y #f))))
              (define d (fast-dist2d scx scy (exact->inexact (hash-ref e 'x 9999.0))
                                     (exact->inexact (hash-ref e 'y 9999.0))))
              (define min-close-d (if (eq? (unit-type-sym e) 'siege-tank-sieged) 10.45 10.0))
              (if (and (fl> d min-close-d) (fl<= d 14.5) (fl< d best-d))
                  (values e d)
                  (values best best-d))))
          (when close-hv
            (define hvx (exact->inexact (hash-ref close-hv 'x base-x)))
            (define hvy (exact->inexact (hash-ref close-hv 'y base-y)))
            (define hv-id (hash-ref close-hv 'id 0))
            (define local-ec
              (count (lambda (e)
                       (and (hash? e) (not (eq? (hash-ref e 'snapshot? #f) #t)) (combat-unit-record? e)
                            (not (memq (unit-type-sym e) '(medivac warp-prism warp-prism-phasing)))
                            (real? (hash-ref e 'x #f)) (real? (hash-ref e 'y #f))
                            (fl<= (fast-dist2d hvx hvy (exact->inexact (hash-ref e 'x 9999.0))
                                               (exact->inexact (hash-ref e 'y 9999.0)))
                                  10.0)))
                     enemy-units))
            (define other-tanks
              (count (lambda (e)
                       (and (hash? e) (not (eq? (hash-ref e 'snapshot? #f) #t))
                            (not (eqv? (hash-ref e 'id -1) hv-id))
                            (eq? (unit-type-sym e) 'siege-tank-sieged)
                            (real? (hash-ref e 'x #f)) (real? (hash-ref e 'y #f))
                            (fl<= (fast-dist2d hvx hvy (exact->inexact (hash-ref e 'x 9999.0))
                                               (exact->inexact (hash-ref e 'y 9999.0)))
                                  13.0)))
                     enemy-units))
            (define n-st (length ready-st))
            (when (and (<= local-ec (* n-st 2))
                       (or (< other-tanks 2)
                           (and (>= n-st 7) (<= local-ec (* n-st 2)))))
              (for ([su (in-list ready-st)])
                (define suid (hash-ref su 'id 0))
                (set-add! splash-evading-tags suid)
                (l34-emit-preserved! ctx (list 'move suid (safe-coord hvx base-x) (safe-coord hvy base-y))))))))))

  (when (or (pair? eff-tank-lurker-hazards) (pair? lurker-spine-effects))
    (define ground-splash-cands
      (for/list ([u (in-list combat-units)]
                 #:when (let* ([uid (hash-ref u 'id 101)]
                               [ut (unit-type-sym u)]
                               [ab-id (hash-ref u 'order-ability-id 0)]
                               [prot (and live-tactics-obs? (> ab-id 0) (fast-order-protection-class ab-id))])
                          (and (not (fast-unit-is-flying-sym? ut))
                               ;; L35-P0-3 (`#56` Visual-QA): Never hijack defending/approaching Siege Tanks
                               ;; into ground splash-evasion MOVE away from enemy Tanks (except active Lurker
                               ;; spines) — let Phase 5b counter-siege them cleanly on high ground!
                               (not (and (memq ut '(siege-tank siege-tank-sieged))
                                         (null? lurker-spine-effects)))
                               ;; L44-P0-1a: Keep freshly blink-forward Stalkers focus-firing `best-hv`
                               ;; during their `40f` execution window instead of Tank-evading away!
                               (not (and (eq? ut 'stalker)
                                         (null? lurker-spine-effects)
                                         (let ([bf-rec (hash-ref blink-hv-focus-ht uid #f)])
                                           (and (pair? bf-rec)
                                                (<= frame (cdr bf-rec))))))
                               ;; W4-TAC-4: Never trap landed viking-assault in ground splash-evasion
                               ;; MOVE(16) when enemy Colossus/ground-splash is present so plan-viking-modes lifts to Fighter!
                               (not (and (eq? ut 'viking-assault) (null? lurker-spine-effects)))
                               (not (and (eq? ut 'ghost)
                                         (null? lurker-spine-effects)
                                         (let ([en (hash-ref u 'energy 0)])
                                           (and (real? en) (>= en 50)))))
                               (not (set-member? splash-evading-tags uid))
                               (not (and live-tactics-obs?
                                         (or (memq prot '(morph channel cast-walk))
                                             (snipe-channel-locked? spell-claims-rt uid frame))))
                               (not (order-ledger-unit-in-attack-swing? oledger u)))))
        u))
    (when (pair? ground-splash-cands)
      (define splash-mmstate (live-bot-runtime-mirror-mind rt))
      (define splash-mmtech (and splash-mmstate (mirror-mind-state-last-tech-observation splash-mmstate)))
      (define splash-enemy-upgs
        (or (hash-ref obs 'enemy-upgrades #f)
            (and splash-mmtech (enemy-tech-observation-observed-upgrades splash-mmtech))
            '()))
      (define splash-grooved-spines? (l34-has-upgrade? ctx 'grooved-spines))
      (define splash-etl? (l34-has-upgrade? ctx 'extended-thermal-lance))
      (define cand-by-id-box #f)
      (define (get-cand-by-id)
        (unless cand-by-id-box
          (define ht (make-hasheqv))
          (for ([cu (in-list ground-splash-cands)])
            (define cuid (hash-ref cu 'id #f))
            (when (exact-integer? cuid) (hash-set! ht cuid cu)))
          (set! cand-by-id-box ht))
        cand-by-id-box)
      (define gtxv-box #f)
      (define gtyv-box #f)
      (define gt-cnt-box #f)
      (define (ensure-ground-target-flvs!)
        (unless gt-cnt-box
          (let loop ([rem enemy-units] [xs '()] [ys '()] [n 0])
            (cond
              [(null? rem)
               (define xv (make-flvector n))
               (define yv (make-flvector n))
               (let fill ([i (sub1 n)] [rx xs] [ry ys])
                 (when (>= i 0)
                   (flvector-set! xv i (car rx))
                   (flvector-set! yv i (car ry))
                   (fill (sub1 i) (cdr rx) (cdr ry))))
               (set! gtxv-box xv)
               (set! gtyv-box yv)
               (set! gt-cnt-box n)]
              [else
               (define e (car rem))
               (define et (unit-type-sym e))
               (cond
                 [(and (not (fast-unit-is-flying-sym? et))
                       (not (eq? et 'disruptor-phased))
                       (or ally-has-detector?
                           (and (not (eq? (hash-ref e 'cloaked #f) #t))
                                (not (eq? (hash-ref e 'burrowed #f) #t))
                                (not (memq et '(lurker-burrowed lurker-mp-burrowed widow-mine-burrowed))))))
                  (define ex (hash-ref e 'x #f))
                  (define ey (hash-ref e 'y #f))
                  (if (and (real? ex) (real? ey))
                      (loop (cdr rem)
                            (cons (if (flonum? ex) ex (exact->inexact ex)) xs)
                            (cons (if (flonum? ey) ey (exact->inexact ey)) ys)
                            (add1 n))
                      (loop (cdr rem) xs ys n))]
                 [else (loop (cdr rem) xs ys n)])]))))
      (define (cand-ready-to-fire-in-range? uid [extra-r 1.25] [min-melee-r 0.0])
        (define cu (hash-ref (get-cand-by-id) uid #f))
        (and cu
             (let ([w-cd (hash-ref cu 'weapon-cooldown 0.0)])
               (and (real? w-cd) (<= w-cd SC2-WEAPON-KITE-COOLDOWN-THRESH)))
             (let* ([ut (unit-type-sym cu)]
                    [ux (hash-ref cu 'x #f)]
                    [uy (hash-ref cu 'y #f)]
                    [base-gr (hash-ref cu 'ground-range
                                       (hash-ref (fast-unit-combat-stats ut) 'ground-range 0.0))]
                    [gr (fl+ (if (flonum? base-gr) base-gr (exact->inexact base-gr))
                             (cond
                               [(and (eq? ut 'hydralisk) splash-grooved-spines?) 1.0]
                               [(and (eq? ut 'colossus) splash-etl?) 2.0]
                               [else 0.0]))])
               (and (real? ux) (real? uy) (fl> gr 0.0)
                    (begin
                      (ensure-ground-target-flvs!)
                      (> gt-cnt-box 0))
                    (let ([fux (if (flonum? ux) ux (exact->inexact ux))]
                          [fuy (if (flonum? uy) uy (exact->inexact uy))]
                          [eff-r (if (and (fl<= gr 1.5) (fl> min-melee-r 0.0))
                                     min-melee-r
                                     (fl+ gr extra-r))]
                          [xv gtxv-box]
                          [yv gtyv-box]
                          [n gt-cnt-box])
                      (define eff-r2 (fl* eff-r eff-r))
                      (let iloop ([i 0])
                        (and (< i n)
                             (let ([dx (fl- fux (flvector-ref xv i))])
                               (or (and (fl<= (flabs dx) eff-r)
                                        (let ([dy (fl- fuy (flvector-ref yv i))])
                                          (and (fl<= (flabs dy) eff-r)
                                               (fl<= (fl+ (fl* dx dx) (fl* dy dy)) eff-r2))))
                                   (iloop (add1 i)))))))))))
      (define tank-lurker-cmds
        (plan-avoid-siege-tank-and-lurker-splash-zones ground-splash-cands
                                                       eff-tank-lurker-hazards
                                                       #:effects lurker-spine-effects
                                                       #:home-x base-fx
                                                       #:home-y base-fy
                                                       #:commit-through-splash? commit-splash?
                                                       #:enemy-upgrades splash-enemy-upgs
                                                       #:tactical-disposition splash-tactical-disp
                                                       #:lanchester-ratio (or splash-lr 1.0)))
      (for ([cmd (in-list tank-lurker-cmds)])
        (define uid (hash-ref cmd 'unit-id #f))
        (define tx (hash-ref cmd 'target-x #f))
        (define ty (hash-ref cmd 'target-y #f))
        (define cmd-role (hash-ref cmd 'role #f))
        (define active-dodge?
          (or (memq cmd-role '(dodge-active-disruptor-nova avoid-aoe-splash-effect))
              (and (not commit-splash?)
                   (eq? cmd-role 'avoid-lurker-linear-spine-splash))))
        (define maxed-splash-breakthrough?
          (and commit-splash?
               (>= (safe-nonneg-int (hash-ref obs 'supply-used 0) 0) 185)))
        ;; W7-TAC-4 / W11-P0-4-rt / W16-P0-1-rt / W18-P0-3-rt (`Siege0DPS` / `novel-137` / `w18-tac-3`):
        ;; When facing Sieged Tanks (no PF!) or Colossi with >= 4 combat units (or defending home),
        ;; cover the FULL active shell/thermal-lance zone (`14t` Tank / `11.5t` Colossus) so squads
        ;; trapped inside fire commit ATTACK instead of being hijacked into 0-DPS pure-MOVE splits!
        (define active-tank-shell-commit?
          (and (pair? (or (l34-ctx-enemy-sieged-tanks-near ctx) '()))
               (null? (or (l34-ctx-enemy-pf-list ctx) '()))
               (or (l34-ctx-enemy-within-14-of-th? ctx)
                   (>= (length (or (l34-ctx-combat-units ctx) '())) 4))
               (memq cmd-role '(avoid-siege-tank-splash-split
                                avoid-siege-tank-standoff-edge
                                commit-run-through-splash-concave
                                siege-tank-deadzone-dive))))
        (define active-colossus-sweep-commit?
          (and (or (l34-ctx-enemy-within-14-of-th? ctx)
                   (>= (length (or (l34-ctx-combat-units ctx) '())) 4))
               (memq cmd-role '(avoid-colossus-sweep-standoff
                                colossus-radial-split-dive))))
        (define shoot-extra-r
          (cond
            [active-tank-shell-commit? 8.5]
            [active-colossus-sweep-commit? 6.5]
            [(eq? cmd-role 'commit-run-through-splash-concave) 6.5]
            [(memq cmd-role '(avoid-siege-tank-splash-split avoid-siege-tank-standoff-edge)) 4.5]
            [commit-splash? 2.5]
            [else 1.25]))
        (define melee-engage-r
          (cond
            [active-tank-shell-commit? 14.0]
            [active-colossus-sweep-commit? 11.5]
            [(memq cmd-role '(avoid-siege-tank-splash-split avoid-siege-tank-standoff-edge commit-run-through-splash-concave)) 8.5]
            [else 0.0]))
        (define allow-shoot-instead?
          (and uid
               (not active-dodge?)
               (or maxed-splash-breakthrough?
                   active-tank-shell-commit?
                   active-colossus-sweep-commit?
                   (and (or commit-splash?
                            (memq cmd-role '(commit-run-through-splash-concave
                                             commit-run-through-disruptor-split
                                             siege-tank-deadzone-dive
                                             colossus-radial-split-dive
                                             avoid-siege-tank-splash-split
                                             avoid-siege-tank-standoff-edge
                                             avoid-colossus-sweep-standoff)))
                        (cand-ready-to-fire-in-range? uid shoot-extra-r melee-engage-r)))))
        (when (and uid (real? tx) (real? ty) (not allow-shoot-instead?))
          (set-add! splash-evading-tags uid)
          (l34-emit! ctx (list 'move uid (safe-coord tx base-x) (safe-coord ty base-y)))))))

  ;; 2. Enemy Widow Mine Out-Range Snipe, Lock Pull-Back, Bait & Cooldown Tracking
  ;; L38-P0-1b (`p13` Burrowed Widow Mine Range-6 Snipe):
  ;;   - Verify per-mine detection via `widow-mine-detected-targetable?` (`cloak != 1`)
  ;;   - Assign every range-6+ sniper (`stalker`/`colossus`/etc.) to the nearest/lowest-HP
  ;;     detected burrowed mine safely out of the `5.0t` trigger radius (`> 5.3t` kite guard)
  ;;   - Hold short-range/melee ground units (`zealot`/`zergling`/`adept` with `gr < 5.5`)
  ;;     strictly `> 5.5t` away from un-cleared burrowed mines while snipers clear them
  ;;     (releasing immediately once mines die, or allowing safe melee on enemies > 5.6t from mines!)
  (when (pair? enemy-widow-mines)
    (define ally-bldgs-wm (or (l34-ctx-ally-bldgs ctx) '()))
    (define ally-all-wm (if (null? ally-bldgs-wm) ally-units (append ally-units ally-bldgs-wm)))
    (define (unit-eff-ground-range u)
      (define ut (unit-type-sym u))
      (define base-gr
        (exact->inexact
         (hash-ref u 'ground-range
                   (hash-ref (fast-unit-combat-stats ut) 'ground-range 0.0))))
      (+ base-gr
         (cond
           [(and (eq? ut 'hydralisk) (l34-has-upgrade? ctx 'grooved-spines)) 1.0]
           [(and (eq? ut 'colossus) (l34-has-upgrade? ctx 'extended-thermal-lance)) 2.0]
           [else 0.0])))
    (define active-wms
      (for/list ([wm (in-list enemy-widow-mines)]
                 #:when (let ([wm-id (hash-ref wm 'id 901)])
                          (>= frame (hash-ref splash-wm-disarmed-ht wm-id -1))))
        wm))
    (define-values (detected-active-wms active-burrowed-wms undetected-burrowed-wms)
      (for/fold ([det '()] [burr '()] [undet '()]
                 #:result (values (reverse det) (reverse burr) (reverse undet)))
                ([wm (in-list active-wms)])
        (define wm-burrowed?
          (or (eq? (unit-type-sym wm) 'widow-mine-burrowed)
              (eq? (hash-ref wm 'burrowed #f) #t)
              (eq? (hash-ref wm 'is-burrowed #f) #t)))
        (define targetable?
          (or (not wm-burrowed?)
              (widow-mine-detected-targetable? wm ally-all-wm)
              (and (not live-tactics-obs?)
                   (or (not (eq? (hash-ref wm 'cloaked #f) #t))
                       ally-has-detector?))))
        (values (if targetable? (cons wm det) det)
                (if wm-burrowed? (cons wm burr) burr)
                (if (and wm-burrowed? (not targetable?)) (cons wm undet) undet))))
    ;; Pass A: Range-6+ sniper focus-fire onto closest/weakest detected active mine,
    ;; plus Loop 64 P1 #4 range-5 spread snipers (<= 3/mine when no >= 6.0 sniper within 14.0t)!
    (define any-wm-sniper-assigned? #f)
    (when (pair? detected-active-wms)
      (for ([r (in-list combat-units)])
        (define rid (hash-ref r 'id 101))
        (define gr (unit-eff-ground-range r))
        (when (and (>= gr 6.0)
                   (not (set-member? splash-evading-tags rid)))
          (define rx (exact->inexact (hash-ref r 'x base-x)))
          (define ry (exact->inexact (hash-ref r 'y base-y)))
          (define max-acq (fl+ gr 4.0))
          ;; Pick closest detected mine (preferring burrowed mines & lowest HP within range)
          (define-values (best-wm best-d)
            (for/fold ([bw #f] [bd +inf.0] [bsc +inf.0] #:result (values bw bd))
                      ([wm (in-list detected-active-wms)])
              (define wmx (exact->inexact (hash-ref wm 'x nat-x)))
              (define wmy (exact->inexact (hash-ref wm 'y nat-y)))
              (define d (fast-dist2d rx ry wmx wmy))
              (if (fl<= d max-acq)
                  (let* ([burr? (or (eq? (unit-type-sym wm) 'widow-mine-burrowed)
                                    (eq? (hash-ref wm 'burrowed #f) #t))]
                         [whp (exact->inexact (hash-ref wm 'hp 90.0))]
                         ;; Prioritize closest burrowed mines so snipers never walk past a closer mine!
                         [sc (fl+ d (fl+ (fl* 0.008 whp) (if burr? 0.0 2.0)))])
                    (if (fl< sc bsc)
                        (values wm d sc)
                        (values bw bd bsc)))
                  (values bw bd bsc))))
          (when best-wm
            (set! any-wm-sniper-assigned? #t)
            (set-add! splash-evading-tags rid)
            ;; Check proximity to nearest active burrowed mine (`5.0t` trigger radius!)
            (define-values (near-bm near-bm-d)
              (for/fold ([nb #f] [nd +inf.0])
                        ([bm (in-list active-burrowed-wms)])
                (define d (fast-dist2d rx ry
                                       (exact->inexact (hash-ref bm 'x nat-x))
                                       (exact->inexact (hash-ref bm 'y nat-y))))
                (if (fl< d nd) (values bm d) (values nb nd))))
            (define raw-cd (hash-ref r 'weapon-cooldown (hash-ref r 'weapon_cooldown 0.0)))
            (define on-cd? (and (real? raw-cd) (> raw-cd 0.25)))
            (cond
              [(and near-bm (fl<= near-bm-d 5.3) on-cd?)
               (define-values (kx ky)
                 (compute-kite-vector rx ry
                                      (exact->inexact (hash-ref near-bm 'x nat-x))
                                      (exact->inexact (hash-ref near-bm 'y nat-y))
                                      1.8))
               (l34-emit-preserved! ctx (list 'kite rid (safe-coord kx rx) (safe-coord ky ry)))]
              [else
               (l34-emit-preserved! ctx (list 'attack-unit rid (hash-ref best-wm 'id 901)))]))))
      ;; Loop 64 P1 #4: Range-5 spread snipers (`<= 3`/mine when no `>= 6.0` sniper within `14.0t`)
      (for ([wm (in-list detected-active-wms)])
        (define wm-id (hash-ref wm 'id 901))
        (define wmx (exact->inexact (hash-ref wm 'x nat-x)))
        (define wmy (exact->inexact (hash-ref wm 'y nat-y)))
        (define has-r6-near?
          (for/or ([r (in-list combat-units)])
            (and (>= (unit-eff-ground-range r) 6.0)
                 (fl<= (fast-dist2d (exact->inexact (hash-ref r 'x base-x))
                                    (exact->inexact (hash-ref r 'y base-y))
                                    wmx wmy)
                       14.0))))
        (unless has-r6-near?
          (define r5-cands
            (for/list ([r (in-list combat-units)]
                       #:when (let ([rid (hash-ref r 'id 101)]
                                    [gr (unit-eff-ground-range r)])
                                (and (>= gr 5.0)
                                     (< gr 6.0)
                                     (not (set-member? splash-evading-tags rid))
                                     (fl<= (fast-dist2d (exact->inexact (hash-ref r 'x base-x))
                                                        (exact->inexact (hash-ref r 'y base-y))
                                                        wmx wmy)
                                           (fl+ gr 4.0)))))
              r))
          (define r5-sorted
            (sort r5-cands <
                  #:key (lambda (r)
                          (fast-dist2d (exact->inexact (hash-ref r 'x base-x))
                                       (exact->inexact (hash-ref r 'y base-y))
                                       wmx wmy))))
          (for ([r (in-list (take r5-sorted (min 3 (length r5-sorted))))])
            (define rid (hash-ref r 'id 101))
            (define rx (exact->inexact (hash-ref r 'x base-x)))
            (define ry (exact->inexact (hash-ref r 'y base-y)))
            (set! any-wm-sniper-assigned? #t)
            (set-add! splash-evading-tags rid)
            (define-values (near-bm near-bm-d)
              (for/fold ([nb #f] [nd +inf.0])
                        ([bm (in-list active-burrowed-wms)])
                (define d (fast-dist2d rx ry
                                       (exact->inexact (hash-ref bm 'x nat-x))
                                       (exact->inexact (hash-ref bm 'y nat-y))))
                (if (fl< d nd) (values bm d) (values nb nd))))
            (define raw-cd (hash-ref r 'weapon-cooldown (hash-ref r 'weapon_cooldown 0.0)))
            (define on-cd? (and (real? raw-cd) (> raw-cd 0.25)))
            (cond
              [(and near-bm (fl<= near-bm-d 4.8) on-cd?)
               (define-values (kx ky)
                 (compute-kite-vector rx ry
                                      (exact->inexact (hash-ref near-bm 'x nat-x))
                                      (exact->inexact (hash-ref near-bm 'y nat-y))
                                      1.2))
               (l34-emit-preserved! ctx (list 'kite rid (safe-coord kx rx) (safe-coord ky ry)))]
              [else
               (l34-emit-preserved! ctx (list 'attack-unit rid wm-id))])))))
    ;; Pass B (Lock-On Pull-Back & No-Detector 1-Unit Bait): Run BEFORE Pass C standoff hold
    ;; so explicit lock-on splits and 1-unit sacrificial bait (`Suite 27`, when no detector)
    ;; claim their 1 bait unit first, while Pass C holds all remaining `<= 14.5t` short-range
    ;; and melee units strictly `> 5.8t` away!
    (for ([wm (in-list active-wms)])
      (define wm-id (hash-ref wm 'id 901))
      (define wmx (hash-ref wm 'x nat-x))
      (define wmy (hash-ref wm 'y nat-y))
      (define wm-burrowed?
        (or (eq? (unit-type-sym wm) 'widow-mine-burrowed)
            (eq? (hash-ref wm 'burrowed #f) #t)))
      (define wm-undetected? (and (memq wm undetected-burrowed-wms) #t))
      (define engaged-tag (hash-ref wm 'engaged-target-tag 0))
      (define explicit-target-id
        (cond
          [(and (exact-integer? engaged-tag) (> engaged-tag 0)) engaged-tag]
          [else (hash-ref wm 'target-id #f)]))
      (define targeted-ally
        (or (and explicit-target-id
                 (findf (lambda (u) (equal? (hash-ref u 'id -1) explicit-target-id)) ally-units))
            (and (not any-wm-sniper-assigned?)
                 (let loop ([rem ally-units] [best-u #f] [best-d 5.3])
                   (if (null? rem)
                       best-u
                       (let* ([u (car rem)]
                              [d (fast-dist2d wmx wmy (hash-ref u 'x base-x) (hash-ref u 'y base-y))])
                         (if (< d best-d)
                             (loop (cdr rem) u d)
                             (loop (cdr rem) best-u best-d))))))))
      (cond
        ;; Locked-on Widow Mine (`explicit-target-id` present) ALWAYS pulls back the locked ally
        ;; & splits nearby allies (`<= 2.2t`) BEFORE any undetected-mine bait logic!
        [(and explicit-target-id targeted-ally)
         (define tid (hash-ref targeted-ally 'id 101))
         (define tx (hash-ref targeted-ally 'x base-x))
         (define ty (hash-ref targeted-ally 'y base-y))
         (hash-set! splash-wm-disarmed-ht wm-id (+ frame 620))
         (unless (set-member? splash-evading-tags tid)
           (define-values (kx ky) (compute-kite-vector tx ty wmx wmy 3.5))
           (set-add! splash-evading-tags tid)
           (l34-emit! ctx (list 'kite tid (l34-quantize-cell-2.5 ctx kx tx) (l34-quantize-cell-2.5 ctx ky ty))))
         (for ([ally (in-list ally-units)])
           (define aid (hash-ref ally 'id 101))
           (define ax (hash-ref ally 'x base-x))
           (define ay (hash-ref ally 'y base-y))
           (when (and (not (equal? aid tid))
                      (not (set-member? splash-evading-tags aid))
                      (<= (dist2d tx ty ax ay) 2.2))
             (define-values (sx sy) (compute-kite-vector ax ay tx ty 2.8))
             (set-add! splash-evading-tags aid)
             (l34-emit! ctx (list 'kite aid (l34-quantize-cell-2.5 ctx sx ax) (l34-quantize-cell-2.5 ctx sy ay)))))]
        [(and live-tactics-obs? wm-burrowed? wm-undetected? (not ally-has-detector?))
         (define nearby-pack
           (filter (lambda (u)
                     (and (not (set-member? splash-evading-tags (hash-ref u 'id -1)))
                          (<= (dist2d wmx wmy (hash-ref u 'x base-x) (hash-ref u 'y base-y)) 9.5)))
                   combat-units))
         (when (>= (length nearby-pack) 2)
           (define cheap-pool
             (filter (lambda (u) (memq (unit-type-sym u) '(zergling zealot marine adept)))
                     nearby-pack))
           (define bait-u
             (argmin (lambda (u) (hash-ref u 'hp 100))
                     (if (not (null? cheap-pool)) cheap-pool nearby-pack)))
           (define bait-id (hash-ref bait-u 'id 101))
           (set-add! splash-evading-tags bait-id)
           (hash-set! splash-wm-disarmed-ht wm-id (+ frame 620))
           (l34-emit! ctx (list 'move bait-id (safe-coord wmx base-x) (safe-coord wmy base-y)))
           (for ([u (in-list nearby-pack)]
                 #:when (not (equal? (hash-ref u 'id -1) bait-id)))
             (define uid (hash-ref u 'id 101))
             (define ux (hash-ref u 'x base-x))
             (define uy (hash-ref u 'y base-y))
             (when (and (not (set-member? splash-evading-tags uid))
                        (<= (dist2d wmx wmy ux uy) 7.5))
               (define-values (kx ky) (compute-kite-vector ux uy wmx wmy 4.5))
               (set-add! splash-evading-tags uid)
               (l34-emit! ctx (list 'kite uid (l34-quantize-cell-2.5 ctx kx ux) (l34-quantize-cell-2.5 ctx ky uy))))))]
        [targeted-ally
         (define tid (hash-ref targeted-ally 'id 101))
         (define tx (hash-ref targeted-ally 'x base-x))
         (define ty (hash-ref targeted-ally 'y base-y))
         (when explicit-target-id
           (hash-set! splash-wm-disarmed-ht wm-id (+ frame 620)))
         (unless (set-member? splash-evading-tags tid)
           (define-values (kx ky) (compute-kite-vector tx ty wmx wmy 3.5))
           (set-add! splash-evading-tags tid)
           (l34-emit! ctx (list 'kite tid (l34-quantize-cell-2.5 ctx kx tx) (l34-quantize-cell-2.5 ctx ky ty))))
         (for ([ally (in-list ally-units)])
           (define aid (hash-ref ally 'id 101))
           (define ax (hash-ref ally 'x base-x))
           (define ay (hash-ref ally 'y base-y))
           (when (and (not (equal? aid tid))
                      (not (set-member? splash-evading-tags aid))
                      (<= (dist2d tx ty ax ay) 2.2))
             (define-values (sx sy) (compute-kite-vector ax ay tx ty 2.8))
             (set-add! splash-evading-tags aid)
             (l34-emit! ctx (list 'kite aid (l34-quantize-cell-2.5 ctx sx ax) (l34-quantize-cell-2.5 ctx sy ay)))))]))
    ;; Pass C: Hold all remaining short-range / melee ground units (`gr < 5.5`) strictly `> 5.8t`
    ;; away from un-cleared burrowed Widow Mines while friendly snipers clear them OR while
    ;; undetected burrowed mines await detection/Scan (Loop 64 P1 #4)!
    (when (and (pair? active-burrowed-wms)
               (or any-wm-sniper-assigned? (pair? undetected-burrowed-wms)))
      (define non-mine-ground-enemies
        (for/list ([e (in-list enemy-units)]
                   #:when (and (hash? e)
                               (combat-unit-record? e)
                               (not (memq (unit-type-sym e) '(widow-mine widow-mine-burrowed)))
                               (not (fast-unit-is-flying-sym? (unit-type-sym e)))
                               (let ([cv (hash-ref e 'cloak #f)])
                                 (not (or (eqv? cv 1) (eq? cv 'cloaked))))))
          e))
      (for ([u (in-list combat-units)])
        (define uid (hash-ref u 'id 101))
        (define ut (unit-type-sym u))
        (define gr (unit-eff-ground-range u))
        (when (and (< gr 5.5)
                   (not (fast-unit-is-flying-sym? ut))
                   (not (set-member? splash-evading-tags uid)))
          (define ux (exact->inexact (hash-ref u 'x base-x)))
          (define uy (exact->inexact (hash-ref u 'y base-y)))
          (define-values (near-bm near-bm-d)
            (for/fold ([nb #f] [nd +inf.0])
                      ([bm (in-list active-burrowed-wms)])
              (define d (fast-dist2d ux uy
                                     (exact->inexact (hash-ref bm 'x nat-x))
                                     (exact->inexact (hash-ref bm 'y nat-y))))
              (if (fl< d nd) (values bm d) (values nb nd))))
          (when (and near-bm (fl<= near-bm-d 14.5))
            (define bmx (exact->inexact (hash-ref near-bm 'x nat-x)))
            (define bmy (exact->inexact (hash-ref near-bm 'y nat-y)))
            ;; Allow attacking an enemy ground unit ONLY if it already walked well in front of ALL mines!
            (define safe-close-enemy
              (and (fl> near-bm-d 6.0)
                   (for/fold ([be #f] [bd 3.81] #:result be)
                             ([e (in-list non-mine-ground-enemies)])
                     (define ex0 (exact->inexact (hash-ref e 'x 9999.0)))
                     (define ey0 (exact->inexact (hash-ref e 'y 9999.0)))
                     (define du (fast-dist2d ux uy ex0 ey0))
                     (if (and (fl< du bd)
                              (for/and ([bm (in-list active-burrowed-wms)])
                                (fl> (fast-dist2d ex0 ey0
                                                  (exact->inexact (hash-ref bm 'x nat-x))
                                                  (exact->inexact (hash-ref bm 'y nat-y)))
                                     5.8)))
                         (values e du)
                         (values be bd)))))
            (set-add! splash-evading-tags uid)
            (cond
              [(fl<= near-bm-d 6.2)
               ;; Strictly retreat outside `5.0t` mine trigger radius (`> 6.5t`)
               (define-values (kx ky) (compute-kite-vector ux uy bmx bmy 3.2))
               (l34-emit-preserved! ctx (list 'kite uid (l34-quantize-cell-2.5 ctx kx ux) (l34-quantize-cell-2.5 ctx ky uy)))]
              [safe-close-enemy
               (l34-emit-preserved! ctx (list 'attack-unit uid (hash-ref safe-close-enemy 'id 0)))]
              [(fl< near-bm-d 7.2)
               ;; Step smoothly back to `~7.2t` standoff so Zealot Charge never leaps into the mines!
               (define-values (kx ky) (compute-kite-vector ux uy bmx bmy (flmax 1.0 (fl- 7.5 near-bm-d))))
               (l34-emit-preserved! ctx (list 'move uid (safe-coord kx ux) (safe-coord ky uy)))]
              [else
               ;; Hold safe standoff (`7.2..14.5t`) behind snipers until mines are cleared!
               (l34-emit-preserved! ctx (list 'move uid (safe-coord ux base-x) (safe-coord uy base-y)))]))))))

)

(define (l34-phase4b-baneling-oracle! ctx)
  (define ally-bldgs (l34-ctx-ally-bldgs ctx))
  (define ally-has-detector? (l34-ctx-ally-has-detector? ctx))
  (define ally-units (l34-ctx-ally-units ctx))
  (define base-x (l34-ctx-base-x ctx))
  (define base-y (l34-ctx-base-y ctx))
  (define can-break-siege-line? (l34-ctx-can-break-siege-line? ctx))
  (define combat-units (l34-ctx-combat-units ctx))
  (define enemy-banelings (l34-ctx-enemy-banelings ctx))
  (define enemy-bldgs (l34-ctx-enemy-bldgs ctx))
  (define enemy-exp-x (l34-ctx-enemy-exp-x ctx))
  (define enemy-exp-y (l34-ctx-enemy-exp-y ctx))
  (define enemy-sieged-tanks-near (l34-ctx-enemy-sieged-tanks-near ctx))
  (define enemy-stasis-traps (l34-ctx-enemy-stasis-traps ctx))
  (define enemy-units (l34-ctx-enemy-units ctx))
  (define enemy-x (l34-ctx-enemy-x ctx))
  (define enemy-y (l34-ctx-enemy-y ctx))
  (define frame (l34-ctx-frame ctx))
  (define ft (l34-ctx-ft ctx))
  (define immobile-bile-targets (l34-ctx-immobile-bile-targets ctx))
  (define l34-sc (l34-ctx-l34-sc ctx))
  (define linear-splash-enemies (l34-ctx-linear-splash-enemies ctx))
  (define live-tactics-obs? (l34-ctx-live-tactics-obs? ctx))
  (define nat-x (l34-ctx-nat-x ctx))
  (define nat-y (l34-ctx-nat-y ctx))
  (define oledger (l34-ctx-oledger ctx))
  (define prelim-army-cx (l34-ctx-prelim-army-cx ctx))
  (define prelim-army-cy (l34-ctx-prelim-army-cy ctx))
  (define ravager-cast-tags (l34-ctx-ravager-cast-tags ctx))
  (define rt (l34-ctx-rt ctx))
  (define splash-evading-tags (l34-ctx-splash-evading-tags ctx))
  ;; 3. Enemy Baneling Light-Unit Radial Pre-Split (Armored units hold & focus-fire)
  (define light-split-syms
    '(marine zergling zealot adept hydralisk reaper ghost sentry high-templar))
  (when (not (null? enemy-banelings))
    (for ([u (in-list combat-units)])
      (define uid (hash-ref u 'id 101))
      (define ut (unit-type-sym u))
      (define ux (hash-ref u 'x base-x))
      (define uy (hash-ref u 'y base-y))
      (when (and (memq ut light-split-syms)
                 (not (set-member? splash-evading-tags uid))
                 (not (order-ledger-unit-in-attack-swing? oledger u)))
        (define closest-bane
          (let loop ([rem enemy-banelings] [best-b #f] [best-d 4.5])
            (if (null? rem)
                best-b
                (let* ([b (car rem)]
                       [d (dist2d ux uy (hash-ref b 'x nat-x) (hash-ref b 'y nat-y))])
                  (if (<= d best-d)
                      (loop (cdr rem) b d)
                      (loop (cdr rem) best-b best-d))))))
        (when closest-bane
          (define bx (hash-ref closest-bane 'x nat-x))
          (define by (hash-ref closest-bane 'y nat-y))
          (define-values (kx ky) (compute-kite-vector ux uy bx by 3.0))
          (set-add! splash-evading-tags uid)
          (l34-emit! ctx (list 'kite uid (l34-quantize-cell-2.5 ctx kx ux) (l34-quantize-cell-2.5 ctx ky uy)))))))

  ;; 4. Enemy Hellion & Burrowed Lurker Linear Splash Lateral Scatter (+/- perpendicular n-hat)
  (when (and (pair? linear-splash-enemies) (pair? combat-units) (pair? (cdr combat-units)))
    (define (to-fl v)
      (if (flonum? v) v (real->double-flonum v)))
    (define le-cnt (length linear-splash-enemies))
    (define le-xs (make-flvector le-cnt 0.0))
    (define le-ys (make-flvector le-cnt 0.0))
    (define le-rngs (make-flvector le-cnt 0.0))
    (define le-r2-limit (make-flvector le-cnt 0.0))
    (define le-near (make-vector le-cnt #f))
    (define gmin-x +inf.0)
    (define gmax-x -inf.0)
    (define gmin-y +inf.0)
    (define gmax-y -inf.0)
    (let loop-le ([rem linear-splash-enemies] [k 0])
      (when (pair? rem)
        (define le (car rem))
        (define lex (to-fl (hash-ref le 'x nat-x)))
        (define ley (to-fl (hash-ref le 'y nat-y)))
        (define rng (if (eq? (unit-type-sym le) 'hellion) 6.5 9.5))
        (define pad (+ rng 1.5))
        (flvector-set! le-xs k lex)
        (flvector-set! le-ys k ley)
        (flvector-set! le-rngs k rng)
        (flvector-set! le-r2-limit k (fl+ (fl* rng rng) 1e-6))
        (when (fl< (fl- lex pad) gmin-x) (set! gmin-x (fl- lex pad)))
        (when (fl> (fl+ lex pad) gmax-x) (set! gmax-x (fl+ lex pad)))
        (when (fl< (fl- ley pad) gmin-y) (set! gmin-y (fl- ley pad)))
        (when (fl> (fl+ ley pad) gmax-y) (set! gmax-y (fl+ ley pad)))
        (loop-le (cdr rem) (add1 k))))
    (define-values (cand-cnt rev-u rev-ux rev-uy rev-uid rev-oid)
      (let loop-c ([rem combat-units] [cnt 0] [ru '()] [rx '()] [ry '()] [ruid '()] [roid '()])
        (if (null? rem)
            (values cnt ru rx ry ruid roid)
            (let* ([u (car rem)]
                   [ux (to-fl (hash-ref u 'x base-x))]
                   [uy (to-fl (hash-ref u 'y base-y))])
              (if (and (fl>= ux gmin-x) (fl<= ux gmax-x) (fl>= uy gmin-y) (fl<= uy gmax-y))
                  (let* ([rid (hash-ref u 'id 'missing)]
                         [uid (if (eq? rid 'missing) 101 rid)]
                         [oid (if (eq? rid 'missing) -1 rid)])
                    (loop-c (cdr rem) (add1 cnt)
                            (cons u ru) (cons ux rx) (cons uy ry)
                            (cons uid ruid) (cons oid roid)))
                  (loop-c (cdr rem) cnt ru rx ry ruid roid))))))
    (when (>= cand-cnt 2)
      (define cand-u (make-vector cand-cnt #f))
      (define cand-ux (make-flvector cand-cnt 0.0))
      (define cand-uy (make-flvector cand-cnt 0.0))
      (define cand-uid (make-vector cand-cnt 0))
      (define cand-oid (make-vector cand-cnt 0))
      (define cand-elig (make-vector cand-cnt 'uninit))
      (let fill-c ([i (sub1 cand-cnt)] [ru rev-u] [rx rev-ux] [ry rev-uy] [ruid rev-uid] [roid rev-oid])
        (when (>= i 0)
          (vector-set! cand-u i (car ru))
          (flvector-set! cand-ux i (car rx))
          (flvector-set! cand-uy i (car ry))
          (vector-set! cand-uid i (car ruid))
          (vector-set! cand-oid i (car roid))
          (fill-c (sub1 i) (cdr ru) (cdr rx) (cdr ry) (cdr ruid) (cdr roid))))
      (for ([i (in-range cand-cnt)])
        (define uid (vector-ref cand-uid i))
        (unless (set-member? splash-evading-tags uid)
          (define ux (flvector-ref cand-ux i))
          (define uy (flvector-ref cand-uy i))
          (let loop-k ([k 0])
            (when (and (< k le-cnt) (not (set-member? splash-evading-tags uid)))
              (define lex (flvector-ref le-xs k))
              (define ley (flvector-ref le-ys k))
              (define max-line-range (flvector-ref le-rngs k))
              (define dux (fl- ux lex))
              (define duy (fl- uy ley))
              (define d2 (fl+ (fl* dux dux) (fl* duy duy)))
              (define continue-k? #t)
              (when (and (fl> d2 0.06) (fl<= d2 (flvector-ref le-r2-limit k)))
                (define d (flsqrt d2))
                (when (and (fl> d 0.25) (fl<= d max-line-range))
                  (define elig-val (vector-ref cand-elig i))
                  (when (eq? elig-val 'uninit)
                    (define ui (vector-ref cand-u i))
                    (set! elig-val
                          (and (not (fast-unit-is-flying-sym? (unit-type-sym ui)))
                               (not (order-ledger-unit-in-attack-swing? oledger ui))))
                    (vector-set! cand-elig i elig-val))
                  (cond
                    [(not elig-val)
                     (set! continue-k? #f)]
                    [else
                     (define cached-near (vector-ref le-near k))
                     (unless cached-near
                       (define max-proj (+ max-line-range 1.0))
                       (define max-nr2 (fl+ (fl* max-proj max-proj) 1.25))
                       (define-values (pc r-oids r-odxs r-odys)
                         (for/fold ([pc 0] [ro '()] [rx '()] [ry '()]) ([j (in-range cand-cnt)])
                           (define odx (fl- (flvector-ref cand-ux j) lex))
                           (define ody (fl- (flvector-ref cand-uy j) ley))
                           (if (fl<= (fl+ (fl* odx odx) (fl* ody ody)) max-nr2)
                               (values (add1 pc)
                                       (cons (vector-ref cand-oid j) ro)
                                       (cons odx rx)
                                       (cons ody ry))
                               (values pc ro rx ry))))
                       (define vec-oids (make-vector pc 0))
                       (define flv-odxs (make-flvector pc 0.0))
                       (define flv-odys (make-flvector pc 0.0))
                       (let fill-p ([p (sub1 pc)] [ro r-oids] [rx r-odxs] [ry r-odys])
                         (when (>= p 0)
                           (vector-set! vec-oids p (car ro))
                           (flvector-set! flv-odxs p (car rx))
                           (flvector-set! flv-odys p (car ry))
                           (fill-p (sub1 p) (cdr ro) (cdr rx) (cdr ry))))
                       (set! cached-near (vector pc vec-oids flv-odxs flv-odys))
                       (vector-set! le-near k cached-near))
                     (define pc (vector-ref cached-near 0))
                     (when (>= pc 2)
                       (define vec-oids (vector-ref cached-near 1))
                       (define flv-odxs (vector-ref cached-near 2))
                       (define flv-odys (vector-ref cached-near 3))
                       (define vx (fl/ dux d))
                       (define vy (fl/ duy d))
                       (define max-proj (+ max-line-range 1.0))
                       (define collinear-ally?
                         (let loop-p ([p 0])
                           (cond
                             [(>= p pc) #f]
                             [(equal? (vector-ref vec-oids p) uid) (loop-p (add1 p))]
                             [else
                              (define odx (flvector-ref flv-odxs p))
                              (define ody (flvector-ref flv-odys p))
                              (define proj (fl+ (fl* odx vx) (fl* ody vy)))
                              (if (and (fl> proj 0.5)
                                       (fl<= proj max-proj)
                                       (fl<= (flabs (fl- (fl* odx vy) (fl* ody vx))) 1.1))
                                  #t
                                  (loop-p (add1 p)))])))
                       (when collinear-ally?
                         (define sign (if (even? uid) 1.0 -1.0))
                         (define nx (* sign (- vy)))
                         (define ny (* sign vx))
                         (define lx (+ ux (* 2.5 nx)))
                         (define ly (+ uy (* 2.5 ny)))
                         (set-add! splash-evading-tags uid)
                         (l34-emit! ctx (list 'kite uid (l34-quantize-cell-2.5 ctx lx ux) (l34-quantize-cell-2.5 ctx ly uy)))))])))
              (when continue-k?
                (loop-k (add1 k)))))))))

  ;; 5. Counter-Micro vs. Enemy `oracle-stasis-trap` / `stasis-ward` (`L43-P0-1c`):
  ;; Verify per-trap detection (`cloak != 1` or friendly detector within `<= 11.0t`), pull main group
  ;; strictly `> 4.5t` back, snipe with ranged units from `>= 4.6t` when detected, OR send 1 single
  ;; cheapest ground unit (`trigger-stasis-ward-single-unit`) to safely trigger/defuse undetected traps!
  (for ([trap (in-list enemy-stasis-traps)])
    (define trap-id (hash-ref trap 'id 9001))
    (define tx (hash-ref trap 'x nat-x))
    (define ty (hash-ref trap 'y nat-y))
    (define trap-prog (exact->inexact (hash-ref trap 'build-progress 1.0)))
    (define trap-clk-val (hash-ref trap 'cloak #f))
    (define trap-cloaked?
      (or (eq? (hash-ref trap 'cloaked #f) #t)
          (eqv? trap-clk-val 1)
          (eq? trap-clk-val 'cloaked)))
    (define trap-local-detected?
      (or (eqv? trap-clk-val 2)
          (eq? trap-clk-val 'cloaked-detected)
          (and (not live-tactics-obs?) ally-has-detector?)
          (widow-mine-detected-targetable? trap (append ally-units (or (l34-ctx-ally-bldgs ctx) '())))))
    (define trap-targetable?
      (or (< trap-prog 1.0)
          (not trap-cloaked?)
          trap-local-detected?))
    (define ranged-snipers
      (filter (lambda (u)
                (define ut (unit-type-sym u))
                (define gr (exact->inexact
                            (hash-ref u 'ground-range
                                      (hash-ref (fast-unit-combat-stats ut) 'ground-range 0.0))))
                (and (>= gr 4.5)
                     (<= (fast-dist2d tx ty (hash-ref u 'x base-x) (hash-ref u 'y base-y)) 11.0)))
              combat-units))
    (cond
      [(and trap-targetable? (not (null? ranged-snipers)))
       (for ([r (in-list ranged-snipers)])
         (define rid (hash-ref r 'id 101))
         (define rx (hash-ref r 'x base-x))
         (define ry (hash-ref r 'y base-y))
         (define d-tr (fast-dist2d tx ty rx ry))
         (define r-wcd (hash-ref r 'weapon-cooldown (hash-ref r 'weapon_cooldown 0.0)))
         (set-add! splash-evading-tags rid)
         (if (and (<= d-tr 4.6) (real? r-wcd) (> r-wcd 0.25))
             (let-values ([(kx ky) (compute-kite-vector rx ry tx ty 2.2)])
               (l34-emit-preserved! ctx (list 'kite rid (safe-coord kx rx) (safe-coord ky ry))))
             (l34-emit-preserved! ctx (list 'attack-unit rid trap-id))))
       (for ([u (in-list combat-units)])
         (define uid (hash-ref u 'id 101))
         (define ut (unit-type-sym u))
         (define gr (exact->inexact
                     (hash-ref u 'ground-range
                               (hash-ref (fast-unit-combat-stats ut) 'ground-range 0.0))))
         (define ux (hash-ref u 'x base-x))
         (define uy (hash-ref u 'y base-y))
         (when (and (< gr 4.5)
                    (not (fast-unit-is-flying-sym? ut))
                    (<= (fast-dist2d tx ty ux uy) 6.0))
           (define-values (kx ky) (compute-kite-vector ux uy tx ty 6.8))
           (set-add! splash-evading-tags uid)
           (l34-emit-preserved! ctx (list 'kite uid (l34-quantize-cell-2.5 ctx kx base-x) (l34-quantize-cell-2.5 ctx ky base-y)))))]
      [(>= trap-prog 1.0)
       (define nearby-ground
         (filter (lambda (u)
                   (and (not (fast-unit-is-flying-sym? (unit-type-sym u)))
                        (<= (fast-dist2d tx ty (hash-ref u 'x base-x) (hash-ref u 'y base-y)) 12.0)))
                 combat-units))
       (when (not (null? nearby-ground))
         (define cheap-cands
           (filter (lambda (u) (memq (unit-type-sym u) '(zergling marine zealot adept)))
                   nearby-ground))
         (define sac-unit
           (argmin (lambda (u) (hash-ref u 'hp 100))
                   (if (not (null? cheap-cands)) cheap-cands nearby-ground)))
         (define sac-id (hash-ref sac-unit 'id 101))
         (set-add! splash-evading-tags sac-id)
         (l34-emit! ctx (list 'trigger-stasis-ward-single-unit
                      sac-id trap-id (exact-round tx) (exact-round ty)))
         (l34-emit! ctx (list 'move sac-id (exact-round tx) (exact-round ty)))
         (for ([u (in-list nearby-ground)]
               #:when (not (equal? (hash-ref u 'id -1) sac-id)))
           (define uid (hash-ref u 'id 101))
           (define ux (hash-ref u 'x base-x))
           (define uy (hash-ref u 'y base-y))
           (when (<= (dist2d tx ty ux uy) 6.5)
             (define-values (kx ky) (compute-kite-vector ux uy tx ty 6.8))
             (set-add! splash-evading-tags uid)
             (l34-emit! ctx (list 'kite uid (l34-quantize-cell-2.5 ctx kx base-x) (l34-quantize-cell-2.5 ctx ky base-y))))))]))

  ;; 6. Anti-Siege-Tank-Sieged Line Discipline & 3-Flank Break
  ;; Loop 62/62B Phase 2: Live Corrosive Bile is 100% owned by `plan-zerg-spellcaster-micro`
  ;; (`lib/tactics/pro-spellcaster-micro.rkt`) with `157f` cooldown, `0.85t` FF guard, and stagger.
  (when (and live-tactics-obs?
             (not (l34-ctx-combat-suppress-attack? ctx))
             (>= (length enemy-sieged-tanks-near) 2)
             can-break-siege-line?
             (>= (length combat-units) 6)
             (refractory-allow-action?! (live-bot-runtime-cooldown-tracker rt)
                                        '(siege-flank-wings)
                                        frame
                                        24))
    (define st0 (car enemy-sieged-tanks-near))
    (define stx (hash-ref st0 'x enemy-x))
    (define sty (hash-ref st0 'y enemy-y))
    (define sdx (- stx prelim-army-cx))
    (define sdy (- sty prelim-army-cy))
    (define sd (max 1.0 (sqrt (+ (* sdx sdx) (* sdy sdy)))))
    (define snx (/ (- sdy) sd))
    (define sny (/ sdx sd))
    (define spell-claims-rt-flank (l34-ctx-spell-claims-rt ctx))
    (define bile-ready-ht-flank
      (and spell-claims-rt-flank (spell-claims-ravager-bile-ready-frame spell-claims-rt-flank)))
    (define bile-cast-r-flank (sc2-spell-cast-range 'corrosive-bile 9.0))
    ;; Loop 62B: Ravagers advance naturally with `flank-units` into Bile range (`9.0t`) and when on
    ;; cooldown; only yield Ravagers ALREADY in `<= 9.0t` range with Bile off-cooldown so Phase 5a
    ;; `plan-zerg-spellcaster-micro` fires Corrosive Bile on step 1 without `splash-evading-tags` blocking it!
    (define (ravager-ready-to-bile-siege? u)
      (and (eq? (unit-type-sym u) 'ravager)
           (not (eq? (hash-ref u 'bile-ready? #t) #f))
           (<= (hash-ref u 'corrosive-bile-cooldown 0) 0)
           (let ([uid (hash-ref u 'id 0)])
             (>= frame (if bile-ready-ht-flank (hash-ref bile-ready-ht-flank uid -1) -1)))
           (let ([ux (hash-ref u 'x #f)] [uy (hash-ref u 'y #f)])
             (and (real? ux) (real? uy)
                  (for/or ([st (in-list enemy-sieged-tanks-near)])
                    (define sx (hash-ref st 'x #f))
                    (define sy (hash-ref st 'y #f))
                    (and (real? sx) (real? sy)
                         (<= (fast-dist2d (exact->inexact ux) (exact->inexact uy)
                                          (exact->inexact sx) (exact->inexact sy))
                             bile-cast-r-flank)))))))
    (define flank-units
      (sort (filter (lambda (u)
                      (and (not (set-member? splash-evading-tags (hash-ref u 'id 0)))
                           (not (ravager-ready-to-bile-siege? u))
                           (not (memq (unit-type-sym u)
                                      '(viper infestor infestor-burrowed high-templar
                                        disruptor disruptor-phased raven medivac
                                        warp-prism warp-prism-phasing observer overseer oracle)))))
                    combat-units)
            <
            #:key (lambda (u)
                    (+ (* (- (hash-ref u 'x prelim-army-cx) prelim-army-cx) snx)
                       (* (- (hash-ref u 'y prelim-army-cy) prelim-army-cy) sny)))))
    (define n-flank (length flank-units))
    (define cut1 (quotient n-flank 3))
    (define cut2 (quotient (* 2 n-flank) 3))
    (define spatial-wings
      (if (>= n-flank 3)
          (list (take flank-units cut1)
                (take (drop flank-units cut1) (- cut2 cut1))
                (drop flank-units cut2))
          (list flank-units '() '())))
    (for ([wing-us (in-list spatial-wings)]
          [lat (in-list '(-5.0 0.0 5.0))])
      (define wing-ids (map (lambda (u) (hash-ref u 'id 0)) wing-us))
      (when (not (null? wing-ids))
        (for ([wid (in-list wing-ids)])
          (set-add! splash-evading-tags wid))
        (l34-emit! ctx (list 'attack-pos wing-ids
                     (safe-coord (+ stx (* lat snx)) stx)
                     (safe-coord (+ sty (* lat sny)) sty))))))

  ;; ---------------------------------------------------------------------------
  ;; Friendly Oracle Spell Micro (`stasis-ward` & `pulsar-beam`) - Legacy Synthetic Path
  ;; ---------------------------------------------------------------------------
  (define live-obs? live-tactics-obs?)
  (define oracle-cast-tags (pooled-mutable-seteqv! l34-sc 'oracle-cast-tags))
  (define queen-cast-tags (pooled-mutable-seteqv! l34-sc 'queen-cast-tags))
  (define wave3-thor-morphed-tags (pooled-mutable-seteqv! l34-sc 'wave3-thor-morphed-tags))
  (define wave3-viking-morphed-tags (pooled-mutable-seteqv! l34-sc 'wave3-viking-morphed-tags))
  (define wave3-marauder-target-tags (pooled-mutable-seteqv! l34-sc 'wave3-marauder-target-tags))
  (unless live-obs?
    (define friendly-stasis-traps
      (filter (lambda (u) (memq (unit-type-sym u) '(oracle-stasis-trap stasis-ward)))
              (append ally-units ally-bldgs)))
    (define enemy-townhalls
      (filter (lambda (eb)
                (memq (unit-type-sym eb)
                      '(hatchery lair hive nexus command-center orbital-command planetary-fortress)))
              enemy-bldgs))
    (for ([u (in-list combat-units)]
          #:when (eq? (unit-type-sym u) 'oracle))
      (define uid (hash-ref u 'id 101))
      (define ux (hash-ref u 'x base-x))
      (define uy (hash-ref u 'y base-y))
      (define u-energy (hash-ref u 'energy 0))
      (define u-buffs (hash-ref u 'buffs '()))
      (define nearby-enemy-workers
        (filter (lambda (e)
                  (and (memq (unit-type-sym e) '(drone scv probe))
                       (<= (dist2d ux uy (hash-ref e 'x 9999) (hash-ref e 'y 9999)) 10.0)))
                enemy-units))
      (define nearby-enemy-th
        (findf (lambda (th)
                 (<= (dist2d ux uy (hash-ref th 'x 9999) (hash-ref th 'y 9999)) 10.0))
               enemy-townhalls))
      (define close-enemy-workers
        (filter (lambda (ew)
                  (<= (dist2d ux uy (hash-ref ew 'x 9999) (hash-ref ew 'y 9999)) 5.0))
                nearby-enemy-workers))
      (when (>= u-energy 50)
        (cond
          [(or (>= (length nearby-enemy-workers) 2) nearby-enemy-th)
           (define-values (wx wy)
             (if (not (null? nearby-enemy-workers))
                 (let ([n (length nearby-enemy-workers)])
                   (values (exact-round (/ (for/sum ([w (in-list nearby-enemy-workers)])
                                             (hash-ref w 'x ux))
                                           n))
                           (exact-round (/ (for/sum ([w (in-list nearby-enemy-workers)])
                                             (hash-ref w 'y uy))
                                           n))))
                 (values (exact-round (hash-ref nearby-enemy-th 'x ux))
                         (exact-round (hash-ref nearby-enemy-th 'y uy)))))
           (set-add! oracle-cast-tags uid)
           (l34-emit! ctx (list 'cast-spell uid 'stasis-ward wx wy))
           (when (not (null? close-enemy-workers))
             (define nearest-ew
               (argmin (lambda (ew) (dist2d ux uy (hash-ref ew 'x ux) (hash-ref ew 'y uy)))
                       close-enemy-workers))
             (l34-emit! ctx (list 'cast-spell uid 'pulsar-beam (hash-ref nearest-ew 'id 0))))]
          [(and (<= (dist2d ux uy enemy-exp-x enemy-exp-y) 15.0)
                (not (ormap (lambda (th)
                              (<= (dist2d enemy-exp-x enemy-exp-y
                                          (hash-ref th 'x 9999) (hash-ref th 'y 9999))
                                  5.0))
                            enemy-townhalls))
                (not (ormap (lambda (ft)
                              (<= (dist2d enemy-exp-x enemy-exp-y
                                          (hash-ref ft 'x 9999) (hash-ref ft 'y 9999))
                                  5.0))
                            friendly-stasis-traps)))
           (set-add! oracle-cast-tags uid)
           (l34-emit! ctx (list 'cast-spell uid 'stasis-ward enemy-exp-x enemy-exp-y))]
          [(and (<= (dist2d ux uy nat-x nat-y) 15.0)
                (not (ormap (lambda (ft)
                              (<= (dist2d nat-x nat-y
                                          (hash-ref ft 'x 9999) (hash-ref ft 'y 9999))
                                  5.0))
                            friendly-stasis-traps))
                (or (>= u-energy 75)
                    (ormap (lambda (e)
                             (<= (dist2d ux uy (hash-ref e 'x 9999) (hash-ref e 'y 9999)) 18.0))
                           enemy-units)))
           (set-add! oracle-cast-tags uid)
           (l34-emit! ctx (list 'cast-spell uid 'stasis-ward nat-x nat-y))]))
      (when (and (list? u-buffs)
                 (or (memq 'pulsar-beam u-buffs) (memq 'oracle-weapon u-buffs))
                 (not (ormap (lambda (e)
                               (<= (dist2d ux uy (hash-ref e 'x 9999) (hash-ref e 'y 9999)) 6.5))
                             enemy-units)))
        (l34-emit! ctx (list 'cast-spell uid 'pulsar-beam-off uid)))))

  (set-l34-ctx-live-obs?! ctx live-obs?)
  (set-l34-ctx-oracle-cast-tags! ctx oracle-cast-tags)
  (set-l34-ctx-queen-cast-tags! ctx queen-cast-tags)
  (set-l34-ctx-wave3-marauder-target-tags! ctx wave3-marauder-target-tags)
  (set-l34-ctx-wave3-thor-morphed-tags! ctx wave3-thor-morphed-tags)
  (set-l34-ctx-wave3-viking-morphed-tags! ctx wave3-viking-morphed-tags)
)

