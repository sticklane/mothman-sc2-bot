                           (>= (- (l2-ctx-minerals ctx) zerg-spire-res-min) (sc2-min-cost 'spore-crawler))))
                  (refractory-allow-action?! cd-tracker
                                             (list 'static-detector 'spore-crawler)
                                             frame
                                             SC2-STATIC-DETECTOR-COOLDOWN-FRAMES))
         (if live-game?
             (let-values ([(spc-ax spc-ay)
                           (l2-safe-zerg-build-anchor ctx (safe-coord (+ base-x 3.0)) (safe-coord (+ base-y 3.0)))])
               (l2-emit-build-verified! ctx 'spore-crawler spc-ax spc-ay))
             (l2-emit! ctx (list 'build 'spore-crawler (safe-coord (+ base-x 3.0)) (safe-coord (+ base-y 3.0))))))
       (if live-game?
           (when (and (or (memq 'lair ready-bldg-types) (memq 'hive ready-bldg-types))
                      (or (and (not zerg-holding-for-aa-spire?)
                               (not zerg-holding-for-aa-corruptor?))
                          enemy-cloaked-or-air?)
                      (< (l2-unit-count ctx 'overseer) 2))
             (l2-emit-unit-morph-verified! ctx 'overseer 'overlord 0))
           (when (not (memq 'overseer unit-types))
             (l2-emit! ctx '(morph overseer)))))
  (define-values (overseers active-changelings)
       (let ([ov-rev '()] [ch-cnt 0])
         (for ([u (in-list ally-units)])
           (define ut (unit-type-sym u))
           (cond
             [(eq? (fast-canonical-unit-sym ut) 'overseer)
              (set! ov-rev (cons u ov-rev))]
             [(and live-game?
                   (memq ut '(changeling changeling-zealot changeling-marine
                              changeling-marine-shield changeling-zergling
                              changeling-zergling-wings)))
              (set! ch-cnt (add1 ch-cnt))]))
         (values (reverse ov-rev) ch-cnt)))
  (for ([ov (in-list overseers)])
       (when (and (>= (hash-ref ov 'energy SC2-OVERSEER-CHANGELING-ENERGY) SC2-OVERSEER-CHANGELING-ENERGY)
                  (or (not live-game?)
                      (and (< active-changelings 2)
                           (refractory-allow-action?! cd-tracker 'overseer-changeling frame 336))))
         (l2-emit! ctx (list 'cast (hash-ref ov 'id 190) 'spawn-changeling enemy-x enemy-y))))
  (cond
       [(memq 'lurker-den ready-bldg-types)
        (when (or (not live-game?)
                  (and (not zerg-saving-for-expand?)
                       (< (l2-unit-count ctx 'lurker) 8)
                       (l2-can-spend-by-priority? ctx 'lurker 'combat-unit)))
          (l2-emit-unit-morph-verified! ctx 'lurker 'hydralisk 1))]
       [(and (not live-game?)
             (memq 'spire ready-bldg-types)
             (memq 'hydralisk-den ready-bldg-types))
        (l2-emit! ctx '(morph lurker))])
  (when (and (not live-game?)
                (memq 'spire ready-bldg-types)
                (memq 'hydralisk-den ready-bldg-types)
                (not (l2-building-present-or-pending? ctx 'hive)))
       (l2-emit! ctx '(morph hive)))
  (when (memq 'greater-spire ready-bldg-types)
       (l2-emit-unit-morph-verified! ctx 'brood-lord 'corruptor 2))
  (define zerg-ideal-worker-cap
       (l2-compute-race-ideal-worker-cap ctx hatcheries))
  (define zerg-3base-interleave-drone-ok?
       (and (not under-base-attack?)
            (>= (length hatcheries) 3)
            (< total-workers 55)
            (or (< total-workers 38)
                zerg-larva-mineral-surplus-ok?
                (>= live-army-supply (max 4.0 zerg-vs-tp-or-fog-floor)))
            (>= live-army-supply 4.0)))
  (define zerg-drone-batch
       (cond
         [(and (> live-enemy-threat-supply 0) (>= total-workers 24)) 1]
         [(and live-game?
               (>= total-workers 34)
               (memq effective-enemy-race '(Terran Protoss Unknown Random)))
          2]
         [else 4]))
  (define zerg-hold-for-16hatch?
       (and live-game?
            (not (l2-ctx-worker-rush-active? ctx))
            (not under-early-cheese?)
            (not early-survival-crisis?)
            (not blocked-nat-expanded-early?)
            (not (l2-ctx-natural-blocked? ctx))
            (not (l2-ctx-forward-proxy-detected? ctx))
            (not (l2-ctx-escrow-suppressed-active? ctx))
            (<= (length hatcheries) 1)
            (= (order-ledger-pending-count-for-type (l2-ctx-oledger ctx) 'hatchery frame) 0)
            (< frame 2400)
            (>= total-workers 16)
            (< (l2-ctx-minerals ctx) (+ (sc2-min-cost 'hatchery) (sc2-min-cost 'drone)))))
  (define zerg-hold-for-17pool?
       (and live-game?
            (not (l2-ctx-worker-rush-active? ctx))
            (not (l2-building-present-or-pending? ctx 'spawning-pool))
            (< frame 2400)
            (>= total-workers 16)
            (< (l2-ctx-minerals ctx) (+ (sc2-min-cost 'spawning-pool) (sc2-min-cost 'drone)))))
  (define zerg-drone-priority?
       (and (not crisis-freeze-workers?)
            (not zerg-holding-for-aa-spire?)
            (not zerg-holding-for-aa-corruptor?)
            (not zerg-hold-for-16hatch?)
            (not zerg-hold-for-17pool?)
            (l2-worker-army-curve-satisfied? ctx)
            (or (not zerg-saving-for-expand?)
                (and (< total-workers 16) (< (l2-ctx-minerals ctx) 225))
                blocked-nat-expanded-early?
                (>= cur-escrow-age-frames 336)
                (and live-game? (>= frame 2200) (< total-workers 20)))
            (not urgent-combat-or-intel-need?)
            (or (< total-workers zerg-ideal-worker-cap)
                (l2-can-spend-by-priority? ctx 'drone 'worker))
            (< total-workers (min 70 (max target-workers zerg-ideal-worker-cap)))
            (or (not live-game?)
                (and (not under-base-attack?) (<= live-enemy-threat-supply 0))
                zerg-3base-interleave-drone-ok?
                (< total-workers 19)
                (not (memq 'spawning-pool ready-bldg-types))
                (>= (length ally-combat-units) 4)
                (>= live-army-supply (* 6 (max 1 (length hatcheries)))))
            (>= (l2-ctx-minerals ctx)
                (+ (sc2-min-cost 'drone)
                   (if (and live-game? (>= total-workers 18))
                       (let-values ([(cm _cg) (l2-scheduled-combat-reserve ctx 'drone)]) cm)
                       0)))
            (l2-can-spend-supply? ctx (sc2-supply-cost 'drone))
            (not under-early-cheese?)
            (< (hash-ref pressure-metrics 'threat-pressure 0.0)
               (if zerg-3base-interleave-drone-ok? 2.0 0.75))))
  (when zerg-drone-priority?
       (l2-try-train-unit! ctx 'drone 'larva zerg-drone-batch
                        #:respect-bo-reserve?
                        (and (l2-worker-respect-bo-reserve? ctx)
                             (or (not zerg-3base-interleave-drone-ok?)
                                 zerg-saving-for-expand?
                                 (>= (l2-ctx-bo-reserved-min ctx) 150)
                                 (< total-workers 16)
                                 (enemy-tech-observation-requires-anti-air? tech-obs)))))
  (when (and live-game?
                zerg-saving-for-expand?
                (>= (length hatcheries) 3)
                (enemy-tech-observation-requires-anti-air? tech-obs)
                (< (l2-unit-count ctx 'corruptor) 4))
       (cond
         [(or (memq 'spire ready-bldg-types) (memq 'greater-spire ready-bldg-types))
          (l2-try-train-unit! ctx 'corruptor 'larva 4 #:respect-bo-reserve? #f)]
         [(memq 'hydralisk-den ready-bldg-types)
          (l2-try-train-unit! ctx 'hydralisk 'larva 4 #:respect-bo-reserve? #f)]))
  (unless zerg-saving-for-expand?
       (when (and (memq 'baneling-nest ready-bldg-types)
                  (< (l2-unit-count ctx 'baneling)
                     (max 4 (quotient (max 1 (l2-unit-count ctx 'zergling)) 2)))
                  (l2-can-spend-by-priority? ctx 'baneling 'combat-unit))
         (l2-emit-unit-morph-verified! ctx 'baneling 'zergling 0))
       (define zerg-needs-queen-or-warren-minerals?
         (and live-game?
              (not under-base-attack?)
              (<= live-enemy-threat-supply 0)
              (>= live-army-supply 4)
              (or (< (l2-unit-count ctx 'queen) (length hatcheries))
                  (and (>= (l2-ctx-gas ctx) 80)
                       (not (l2-building-present-or-pending? ctx 'roach-warren))))))
       ;; Endgame Anti-Tie Corner Hunters: maintain >= 2 flying AA hunters (Corruptor / Mutalisk)
       (when (and endgame-corner-hunt?
                  (or (memq 'spire ready-bldg-types) (memq 'greater-spire ready-bldg-types))
                  (< (+ (l2-unit-count ctx 'mutalisk) (l2-unit-count ctx 'corruptor)) 2))
         (when (and (>= (l2-ctx-minerals ctx) (sc2-min-cost 'corruptor))
                    (>= (l2-ctx-gas ctx) (sc2-gas-cost 'corruptor)))
           (l2-try-train-unit! ctx 'corruptor 'larva 4))
         (when (and (< (+ (l2-unit-count ctx 'mutalisk) (l2-unit-count ctx 'corruptor)) 2)
                    (>= (l2-ctx-minerals ctx) (sc2-min-cost 'mutalisk))
                    (>= (l2-ctx-gas ctx) (sc2-gas-cost 'mutalisk)))
           (l2-try-train-unit! ctx 'mutalisk 'larva 4)))
       (define brood-lord-corruptor-target
         (if (or enemy-heavy-ground-siege? (memq 'greater-spire ready-bldg-types)) 5 3))
       ;; T3 Air Siege: Corruptor -> Brood Lord when Greater Spire is ready or morphing (`< 8` cap, `#89` [UNCOVERED-Z3])
       (when (and (or (memq 'greater-spire ready-bldg-types)
                      (l2-building-present-or-pending? ctx 'greater-spire))
                  (< (l2-unit-count ctx 'brood-lord) 8))
         (when (< (l2-unit-count ctx 'corruptor) brood-lord-corruptor-target)
           (l2-try-train-unit! ctx 'corruptor 'larva 4 #:respect-bo-reserve? #t))
         (when (memq 'greater-spire ready-bldg-types)
           (l2-emit-unit-morph-verified! ctx 'brood-lord 'corruptor 2)))
       ;; T3 Hive Caster: Viper (Blinding Cloud / Abduct / Parasitic Bomb)
       (when (and (memq 'hive ready-bldg-types)
                  (< (l2-unit-count ctx 'viper) (if (>= eff-phase-supply 130) 3 2))
                  (or (l2-plan-wants-now? ctx 'viper)
                      enemy-heavy-ground-siege?
                      (and live-game? (>= live-army-supply 34)))
                  (>= (l2-ctx-minerals ctx) (sc2-min-cost 'viper))
                  (>= (l2-ctx-gas ctx) (sc2-gas-cost 'viper)))
         (l2-try-train-unit! ctx 'viper 'larva 4 #:respect-bo-reserve? #t))
       ;; T3 Frontline: Ultralisk (`ultralisk-cavern` protects `200G` ahead of Hydra drain, `#89` [UNCOVERED-Z3])
       (define hold-ultra-gas?
         (and live-game?
              (not crisis-tech-upgrade-deferral?)
              (memq 'hive ready-bldg-types)
              (memq 'ultralisk-cavern ready-bldg-types)
              (< (l2-unit-count ctx 'ultralisk) 6)
              (not zerg-real-anti-air-threat?)))
       (define zerg-ultra-res-gas
         (if hold-ultra-gas? (sc2-gas-cost 'ultralisk) 0))
       (when (and (memq 'ultralisk-cavern ready-bldg-types)
                  (< (l2-unit-count ctx 'ultralisk) 8)
                  (>= (l2-ctx-minerals ctx) (sc2-min-cost 'ultralisk))
                  (>= (l2-ctx-gas ctx) (sc2-gas-cost 'ultralisk))
                  (or (l2-can-spend-by-priority? ctx 'ultralisk 'combat-unit)
                      (and live-game? (< (l2-unit-count ctx 'ultralisk) 4))))
         (l2-try-train-unit! ctx 'ultralisk 'larva 4 #:respect-bo-reserve? #t))
       ;; T2/T3 Caster: Infestor
       (when (and (memq 'infestation-pit ready-bldg-types)
                  (< (l2-unit-count ctx 'infestor) 2)
                  (or (l2-plan-wants-now? ctx 'infestor)
                      (and live-game? (>= live-army-supply 50)))
                  (>= (l2-ctx-minerals ctx) (sc2-min-cost 'infestor))
                  (>= (- (l2-ctx-gas ctx) zerg-ultra-res-gas) (sc2-gas-cost 'infestor)))
         (l2-try-train-unit! ctx 'infestor 'larva 4 #:respect-bo-reserve? #t))
       (define zerg-ground-threats-exist?
         (or (ormap (lambda (e)
                      (and (combat-unit-record? e)
                           (not (fast-unit-is-flying-sym? (unit-type-sym e)))))
                    enemy-units)
             (ormap (lambda (eb)
                      (memq (unit-type-sym eb) '(bunker photon-cannon spine-crawler planetary-fortress)))
                    enemy-bldgs)
             (>= live-enemy-threat-supply 4)
             (and (null? enemy-units) (not zerg-real-anti-air-threat?))))
       (define zergling-heavy-counter?
         (ormap (lambda (e)
                  (memq (unit-type-sym e)
                        '(siege-tank siege-tank-sieged colossus archon planetary-fortress
                          hellbat lurker lurker-burrowed ultralisk)))
                (append enemy-units enemy-bldgs)))
       (define zerg-minerals-now (l2-ctx-minerals ctx))
       (define zergling-standing-cap
         (cond
           [(>= zerg-minerals-now 1500) 999]
           [(>= zerg-minerals-now 900) (if zergling-heavy-counter? 44 72)]
           [(>= zerg-minerals-now 650) (if zergling-heavy-counter? 32 48)]
           [zergling-heavy-counter? 20]
           [else 32]))
       (define zerg-mineral-dump? (and live-game? (>= zerg-minerals-now 750)))
       (define (zergling-under-cap?)
         (or (not live-game?)
             (< (l2-unit-count ctx 'zergling) zergling-standing-cap)))
       (define (try-zerg-roach-core!)
         (define cur-roaches (l2-unit-count ctx 'roach))
         (define min-floor (if (< cur-roaches 8) (sc2-min-cost 'roach) 200))
         (define eff-ultra-gas (if (and live-game? (< cur-roaches 4)) 0 zerg-ultra-res-gas))
         (when (and (memq 'roach-warren ready-bldg-types)
                    zerg-ground-threats-exist?
                    (>= (- (l2-ctx-minerals ctx) zerg-spire-res-min) min-floor)
                    (>= (- (l2-ctx-gas ctx) eff-ultra-gas) (sc2-gas-cost 'roach))
                    (or (not live-game?) (< cur-roaches 24))
                    (or (< cur-roaches 4)
                        (l2-can-spend-by-priority? ctx 'roach 'combat-unit)))
           (l2-try-train-unit! ctx 'roach 'larva 4
                            #:respect-bo-reserve? (and (>= cur-roaches 4) (not under-base-attack?)))))
       (when (and crisis-tech-upgrade-deferral?
                  (not zerg-real-anti-air-threat?)
                  (memq 'roach-warren ready-bldg-types)
                  (>= (l2-ctx-minerals ctx) (sc2-min-cost 'roach))
                  (>= (l2-ctx-gas ctx) (sc2-gas-cost 'roach)))
         (l2-try-train-unit! ctx 'roach 'larva 4 #:respect-bo-reserve? #f))
       (cond
         [(and (or (memq 'spire ready-bldg-types) (memq 'greater-spire ready-bldg-types))
               (or (and (>= (l2-ctx-minerals ctx) (sc2-min-cost 'corruptor))
                        (>= (l2-ctx-gas ctx) (sc2-gas-cost 'corruptor)))
                   (and (>= (l2-ctx-minerals ctx) (sc2-min-cost 'mutalisk))
                        (>= (l2-ctx-gas ctx) (sc2-gas-cost 'mutalisk)))))
          (define zerg-anti-air-now? zerg-real-anti-air-threat?)
          (define hold-mutalisk-for-corruptor?
            (and live-game?
                 zerg-anti-air-now?
                 (< (l2-unit-count ctx 'corruptor) 8)
                 (or (< (l2-ctx-minerals ctx) 250) (< (l2-ctx-gas ctx) 200))))
          (when (and (>= (l2-ctx-minerals ctx) (sc2-min-cost 'corruptor))
                     (>= (- (l2-ctx-gas ctx) (if zerg-anti-air-now? 0 zerg-ultra-res-gas)) (sc2-gas-cost 'corruptor))
                     (or (not live-game?)
                         (and zerg-anti-air-now? (< (l2-unit-count ctx 'corruptor) 8))
                         (and (or (memq 'greater-spire ready-bldg-types)
                                  (l2-building-present-or-pending? ctx 'greater-spire))
                              (or (not live-game?) (< (l2-unit-count ctx 'corruptor) 6)))
                         (and zerg-anti-air-now?
                              (< (l2-unit-count ctx 'corruptor) 10)
                              (l2-plan-wants-now? ctx 'corruptor))))
            (l2-try-train-unit! ctx 'corruptor 'larva 4 #:respect-bo-reserve? (not zerg-anti-air-now?)))
          (when (and (not hold-mutalisk-for-corruptor?)
                     (< (l2-unit-count ctx 'mutalisk) 10)
                     (>= (- (l2-ctx-gas ctx) zerg-ultra-res-gas) (sc2-gas-cost 'mutalisk))
                     (l2-can-spend-by-priority? ctx 'mutalisk 'combat-unit))
            (l2-try-train-unit! ctx 'mutalisk 'larva 4 #:respect-bo-reserve? #t))
          (when (and (memq 'hydralisk-den ready-bldg-types)
                     (>= (- (l2-ctx-gas ctx) zerg-ultra-res-gas) (sc2-gas-cost 'hydralisk))
                     (< (l2-unit-count ctx 'hydralisk) 18))
            (l2-try-train-unit! ctx 'hydralisk 'larva 4
                             #:respect-bo-reserve? (and (>= (l2-unit-count ctx 'hydralisk) 6)
                                                        (not zerg-anti-air-now?))))
          (try-zerg-roach-core!)
          (when (and (memq 'spawning-pool ready-bldg-types)
                     (zergling-under-cap?)
                     (>= (l2-ctx-minerals ctx) 300)
                     (or zerg-mineral-dump? (l2-can-spend-by-priority? ctx 'zergling 'combat-unit)))
            (l2-try-train-unit! ctx 'zergling 'larva (if zerg-mineral-dump? 6 4) #:respect-bo-reserve? (not zerg-mineral-dump?)))]
         [(and (memq 'hydralisk-den ready-bldg-types)
               (>= (l2-ctx-minerals ctx) (sc2-min-cost 'hydralisk))
               (>= (- (l2-ctx-gas ctx) zerg-ultra-res-gas) (sc2-gas-cost 'hydralisk)))
          (when (or (not live-game?)
                    (< (l2-unit-count ctx 'hydralisk) 18))
            (l2-try-train-unit! ctx 'hydralisk 'larva 4
                             #:respect-bo-reserve? (and (>= (l2-unit-count ctx 'hydralisk) 6)
                                                        (not zerg-real-anti-air-threat?))))
          (when (and (memq 'roach-warren ready-bldg-types)
                     (or (not live-game?)
                         (and zerg-ground-threats-exist?
                              (or (< (l2-unit-count ctx 'roach) 8)
                                  (>= (l2-ctx-minerals ctx) 200)
                                  (< (l2-ctx-gas ctx) (sc2-gas-cost 'hydralisk)))
                              (< (l2-unit-count ctx 'roach) 20)))
                     (>= (- (l2-ctx-gas ctx) (if (< (l2-unit-count ctx 'roach) 4) 0 zerg-ultra-res-gas)) (sc2-gas-cost 'roach))
                     (or (< (l2-unit-count ctx 'roach) 4)
                         (l2-can-spend-by-priority? ctx 'roach 'combat-unit)))
            (l2-try-train-unit! ctx 'roach 'larva 4
                             #:respect-bo-reserve? (and (>= (l2-unit-count ctx 'roach) 4) (not under-base-attack?))))
          (when (and (memq 'spawning-pool ready-bldg-types)
                     (zergling-under-cap?)
                     (>= (l2-ctx-minerals ctx) 300)
                     (or zerg-mineral-dump? (l2-can-spend-by-priority? ctx 'zergling 'combat-unit)))
            (l2-try-train-unit! ctx 'zergling 'larva (if zerg-mineral-dump? 6 4) #:respect-bo-reserve? (not zerg-mineral-dump?)))]
         [(and (memq 'roach-warren ready-bldg-types)
               (>= (l2-ctx-minerals ctx) (sc2-min-cost 'roach))
               (>= (- (l2-ctx-gas ctx) (if (< (l2-unit-count ctx 'roach) 4) 0 zerg-ultra-res-gas)) (sc2-gas-cost 'roach)))
          (l2-try-train-unit! ctx 'roach 'larva 4
                           #:respect-bo-reserve? (and (>= (l2-unit-count ctx 'roach) 4) (not under-base-attack?)))
          (when (and (memq 'spawning-pool ready-bldg-types)
                     (zergling-under-cap?)
                     (not zerg-needs-queen-or-warren-minerals?)
                     (or (< (l2-ctx-gas ctx) (sc2-gas-cost 'roach)) (>= (l2-ctx-minerals ctx) 200))
                     (or zerg-mineral-dump? (l2-can-spend-by-priority? ctx 'zergling 'combat-unit)))
            (l2-try-train-unit! ctx 'zergling 'larva (if zerg-mineral-dump? 6 4) #:respect-bo-reserve? (not zerg-mineral-dump?)))]
         [(and (memq 'spawning-pool ready-bldg-types)
               (zergling-under-cap?)
               (or (not zerg-needs-queen-or-warren-minerals?)
                   (>= (l2-ctx-minerals ctx) (+ (sc2-min-cost 'queen) (sc2-min-cost 'zergling))))
               (or zerg-mineral-dump? (l2-can-spend-by-priority? ctx 'zergling 'combat-unit))
               (>= (l2-ctx-minerals ctx) (sc2-min-cost 'zergling))
               (or under-early-cheese?
                   urgent-combat-or-intel-need?
                   (>= (hash-ref pressure-metrics 'threat-pressure 0.0) 0.35)
                   (>= total-workers (add1 SC2-PRIORITY-WORKERS-PER-BASE))
                   (< (length ally-combat-units) SC2-ATTACK-WAVE-MIN-COMBAT-UNITS)
                   (>= (l2-ctx-minerals ctx) (sc2-min-cost 'queen))))
          (l2-try-train-unit! ctx 'zergling 'larva (if zerg-mineral-dump? 6 4) #:respect-bo-reserve? (not zerg-mineral-dump?))]))
  (when (and (not zerg-drone-priority?)
                (not crisis-freeze-workers?)
                (l2-worker-army-curve-satisfied? ctx)
                (not zerg-saving-for-expand?)
                (l2-can-spend-by-priority? ctx 'drone 'worker)
                (< total-workers
                   (if live-game?
                       (min 70 (max target-workers zerg-ideal-worker-cap))
                       target-workers))
                (or (member '(train drone) prio-scheduled-actions)
                    (< (hash-ref pressure-metrics 'threat-pressure 0.0) 1.0)))
       (l2-try-train-unit! ctx 'drone 'larva zerg-drone-batch
                        #:respect-bo-reserve? (l2-worker-respect-bo-reserve? ctx))))

(define (l2-protoss-phase1-chrono-wall! ctx)
  (define allow-exact-wall-slot? (l2-ctx-allow-exact-wall-slot? ctx))
  (define ally-bldgs (l2-ctx-ally-bldgs ctx))
  (define ally-units (l2-ctx-ally-units ctx))
  (define base-x (l2-ctx-base-x ctx))
  (define base-y (l2-ctx-base-y ctx))
  (define blocked-nat-expanded-early? (l2-ctx-blocked-nat-expanded-early? ctx))
  (define cd-tracker (l2-ctx-cd-tracker ctx))
  (define cortex (l2-ctx-cortex ctx))
  (define crisis-freeze-expand-or-gas? (l2-ctx-crisis-freeze-expand-or-gas? ctx))
  (define crisis-tech-upgrade-deferral? (l2-ctx-crisis-tech-upgrade-deferral? ctx))
  (define cur-escrow-age-frames (l2-ctx-cur-escrow-age-frames ctx))
  (define desired-bases (l2-ctx-desired-bases ctx))
  (define early-survival-crisis? (l2-ctx-early-survival-crisis? ctx))
  (define eff-phase-supply (l2-ctx-eff-phase-supply ctx))
  (define endgame-corner-hunt? (l2-ctx-endgame-corner-hunt? ctx))
  (define enemy-units (l2-ctx-enemy-units ctx))
  (define forward-proxy-detected? (l2-ctx-forward-proxy-detected? ctx))
  (define frame (l2-ctx-frame ctx))
  (define hard-supply-lockout-reserve-min (l2-ctx-hard-supply-lockout-reserve-min ctx))
  (define in-base-proxy-detected? (l2-ctx-in-base-proxy-detected? ctx))
  (define leases (l2-ctx-leases ctx))
  (define live-army-supply (l2-ctx-live-army-supply ctx))
  (define live-game-obs? (l2-ctx-live-game-obs? ctx))
  (define live-game? (l2-ctx-live-obs-harvesters? ctx))
  (define macro-plan (l2-ctx-macro-plan ctx))
  (define nat-x (l2-ctx-nat-x ctx))
  (define nat-y (l2-ctx-nat-y ctx))
  (define obs (l2-ctx-obs ctx))
  (define oledger (l2-ctx-oledger ctx))
  (define open-prod-slots (l2-ctx-open-prod-slots ctx))
