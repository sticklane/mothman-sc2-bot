  (define base-y (l34-ctx-base-y ctx))
  (define creep-ally-slice-rev (l34-ctx-creep-ally-slice-rev ctx))
  (define creep-enemy-slice-rev (l34-ctx-creep-enemy-slice-rev ctx))
