       (hash-ref prev-tel-early 'last-seen-main-frame 0)]))
  (set-l2-ctx-last-seen-main-frame! ctx last-seen-main-frame)
  (define last-seen-natural-frame
    (cond
      [(hash-has-key? obs 'last-seen-natural-frame)
       (hash-ref obs 'last-seen-natural-frame 0)]
      [(or (l2-enemy-seen-near? ctx enemy-exp-x enemy-exp-y 22.0)
           (l2-ally-has-vision-of? ctx enemy-exp-x enemy-exp-y))
       frame]
      [else
       (hash-ref prev-tel-early 'last-seen-natural-frame 0)]))
  (set-l2-ctx-last-seen-natural-frame! ctx last-seen-natural-frame)
  (define last-seen-third-frame
