                                             (for/or ([ax (in-list axs)] [ay (in-list ays)])
                                               (define dx (fl- ax fux))
                                               (define dy (fl- ay fuy))
                                               (fl<= (fl+ (fl* dx dx) (fl* dy dy)) r2)))
                                           (for/or ([ax (in-list axs)] [ay (in-list ays)])
                                             (<= (dist2d ux uy ax ay) SC2-OVERLORD-THREAT-RADIUS)))))))
            u))
        '()))
  (for ([ov (in-list threatened-overlords)])
