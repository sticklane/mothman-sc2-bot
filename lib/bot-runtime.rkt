(define UNIT-OPT-SANITIZER-DISPATCH
  (hasheq 'hp-pct (cons sanitized-unit-interval? sanitize-opt-unit-interval-1)
          'shield (cons sanitized-nonneg-int? sanitize-opt-nonneg-0)
