(define (l34-has-upgrade? ctx upg-sym)
  (or (not (l34-ctx-live-upgrades-tracked? ctx))
      (and (memq upg-sym (l34-ctx-researched-upgs ctx)) #t)))

(define (l34-emit! ctx act)
  (unless (runtime-suppressed-live-ability-action? act)
    (order-ledger-record-issued! (l34-ctx-oledger ctx) (l34-ctx-frame ctx) act)
    (set-l34-ctx-actions! ctx (cons act (l34-ctx-actions ctx)))))

(define (l34-emit-preserved! ctx act)
  (unless (runtime-suppressed-live-ability-action? act)
    (set-add! (l34-ctx-wave3-preserved-set ctx) act)
    (l34-emit! ctx act)))

(define (l34-quantize-cell-2.5 ctx v fallback)
  (geo:quantize-cell-2.5 v (if (real? fallback) fallback 32.5) (l34-ctx-live-tactics-obs? ctx)))

(define (l34-stealth-unit-or-bldg? e)
  (define et (unit-type-sym e))
  (or (memq et '(widow-mine-burrowed lurker-burrowed dark-templar banshee ghost
                 roach-burrowed infestor-burrowed oracle-stasis-trap stasis-ward))
      (eq? (hash-ref e 'cloaked #f) #t)
      (eq? (hash-ref e 'burrowed #f) #t)
      (= (hash-ref e 'display-type 1) 2)))

(define (l34-get-bo-tplan ctx)
  (or (l34-ctx-bo-tplan-box ctx)
      (let ()
        (define rt (l34-ctx-rt ctx))
        (define obs (l34-ctx-obs ctx))
        (define raw-obs (l34-ctx-raw-obs ctx))
        (define frame (l34-ctx-frame ctx))
        (define under-tactics-base-attack? (l34-ctx-under-tactics-base-attack? ctx))
        (define ally-units (l34-ctx-ally-units ctx))
        (define ally-bldgs (l34-ctx-ally-bldgs ctx))
        (define enemy-units (l34-ctx-enemy-units ctx))
        (define enemy-bldgs (l34-ctx-enemy-bldgs ctx))
        (define researched-upgs (l34-ctx-researched-upgs ctx))
        (define pending-upgs (l34-ctx-pending-upgs ctx))
        (define live-tactics-obs? (l34-ctx-live-tactics-obs? ctx))
        (define door-st-tactics (l34-ctx-door-st-tactics ctx))
        (define base-x (l34-ctx-base-x ctx))
        (define base-y (l34-ctx-base-y ctx))
        (define nat-x (l34-ctx-nat-x ctx))
        (define nat-y (l34-ctx-nat-y ctx))
        (define enemy-x (l34-ctx-enemy-x ctx))
        (define enemy-y (l34-ctx-enemy-y ctx))
        (define enemy-exp-x (l34-ctx-enemy-exp-x ctx))
        (define enemy-exp-y (l34-ctx-enemy-exp-y ctx))
        (define enemy-third-x (l34-ctx-enemy-third-x ctx))
        (define enemy-third-y (l34-ctx-enemy-third-y ctx))
          (begin
        (let* ([t-our-race
                (let ([r (live-bot-runtime-actual-race rt)])
                  (if (and (symbol? r) (not (eq? r 'Unknown)))
                      r
                      (hash-ref obs 'race 'Zerg)))]
               [prev-tel (live-bot-runtime-last-telemetry rt)]
               [t-enemy-race
                (if (hash? prev-tel)
                    (hash-ref prev-tel 'effective-enemy-race (hash-ref obs 'enemy-race 'Unknown))
                    (hash-ref obs 'enemy-race 'Unknown))]
               [ua-flag (or under-tactics-base-attack? (eq? (hash-ref raw-obs 'under-attack #f) #t))]
               [len-au (length ally-units)]
               [len-ab (length ally-bldgs)]
               [len-eu (length enemy-units)]
               [len-eb (length enemy-bldgs)]
               [ru-len (length researched-upgs)]
               [pu-len (length pending-upgs)]
               [cached (and live-tactics-obs? (hash-ref door-st-tactics 'bo-tactical-cache #f))]
               [plan
                (if (and (vector? cached)
                         (>= frame (vector-ref cached 0))
                         (< (- frame (vector-ref cached 0))
                            (if (= (modulo frame 16) 8) 24 20))
                         (eq? t-our-race (vector-ref cached 1))
                         (eq? t-enemy-race (vector-ref cached 2))
                         (= len-au (vector-ref cached 3))
                         (= len-ab (vector-ref cached 4))
                         (= len-eu (vector-ref cached 5))
                         (= len-eb (vector-ref cached 6))
                         (eq? ua-flag (vector-ref cached 7))
                         (= ru-len (vector-ref cached 8))
                         (= pu-len (vector-ref cached 9)))
                    (vector-ref cached 10)
                    (let ()
                      (define raw-uc (hash-ref raw-obs 'unit-counts #f))
                      (define raw-euc (hash-ref raw-obs 'enemy-unit-counts #f))
                      (define raw-ebc (hash-ref raw-obs 'enemy-building-counts #f))
                      (define raw-sup (hash-ref raw-obs 'supply-used #f))
                      (define raw-prog (hash-ref raw-obs 'in-progress-upgrade-progress #f))
                      (define raw-lr (hash-ref raw-obs 'lanchester-ratio #f))
                      (define need-ally-scan?
                        (or (not (and (hash? raw-uc) (not (hash-empty? raw-uc))))
                            (not (exact-integer? raw-sup))
                            (not (real? raw-lr))))
                      (define u-counts (if (and (hash? raw-uc) (not (hash-empty? raw-uc))) raw-uc (make-hasheq)))
                      (define sup-sum 0.0)
                      (define ally-val 0)
                      (define max-bldg-prog 0.0)
                      (when need-ally-scan?
                        (define add-u? (not (and (hash? raw-uc) (not (hash-empty? raw-uc)))))
                        (for ([u (in-list ally-units)])
                          (define ut (unit-type-sym u))
                          (when add-u?
                            (hash-set! u-counts ut (+ 1 (hash-ref u-counts ut 0))))
                          (set! sup-sum (+ sup-sum (unit-supply-cost ut)))
                          (when (combat-unit-record? u)
                            (set! ally-val (+ ally-val (fast-res-cost-50 ut)))))
                        (for ([b (in-list ally-bldgs)])
                          (define bt (unit-type-sym b))
                          (when add-u?
                            (hash-set! u-counts bt (+ 1 (hash-ref u-counts bt 0))))
                          (when (and (not (real? raw-prog)) (hash? b))
                            (define op (hash-ref b 'order-progress #f))
                            (when (real? op)
                              (set! max-bldg-prog (max max-bldg-prog (exact->inexact op)))))))
                      (define need-eu-scan?
                        (or (not (and (hash? raw-euc) (not (hash-empty? raw-euc))))
                            (not (real? raw-lr))))
                      (define eu-counts (if (and (hash? raw-euc) (not (hash-empty? raw-euc))) raw-euc (make-hasheq)))
                      (define enemy-val 0)
                      (when need-eu-scan?
                        (define add-eu? (not (and (hash? raw-euc) (not (hash-empty? raw-euc)))))
                        (for ([e (in-list enemy-units)])
                          (define et (unit-type-sym e))
                          (when add-eu?
                            (hash-set! eu-counts et (+ 1 (hash-ref eu-counts et 0))))
                          (unless (combat-unit-excluded-sym? et)
                            (set! enemy-val (+ enemy-val (fast-res-cost-50 et))))))
                      (define need-eb-scan?
                        (or (not (and (hash? raw-ebc) (not (hash-empty? raw-ebc))))
                            (not (real? raw-lr))))
                      (define eb-counts (if (and (hash? raw-ebc) (not (hash-empty? raw-ebc))) raw-ebc (make-hasheq)))
                      (when need-eb-scan?
                        (define add-eb? (not (and (hash? raw-ebc) (not (hash-empty? raw-ebc)))))
                        (for ([eb (in-list enemy-bldgs)])
                          (define bt (unit-type-sym eb))
                          (when add-eb?
                            (hash-set! eb-counts bt (+ 1 (hash-ref eb-counts bt 0))))
                          (when (hash-ref RUNTIME-STATIC-DEFVAL-SET bt #f)
                            (set! enemy-val (+ enemy-val (fast-res-cost-100 bt))))))
                      (define eff-sup
                        (if (exact-integer? raw-sup)
                            raw-sup
                            (max 12 (inexact->exact (round sup-sum)))))
                      (define eff-prog
                        (if (real? raw-prog)
                            (safe-finite-real raw-prog 0.0)
                            max-bldg-prog))
                      (define eff-lr
                        (if (real? raw-lr)
                            (safe-finite-real raw-lr 1.0)
                            (if (and (null? enemy-units) (null? enemy-bldgs))
                                (if (>= ally-val 200) 1.05 0.95)
                                (/ (exact->inexact (max 50 ally-val))
                                   (exact->inexact (max 50 enemy-val))))))
                      (define fresh-plan
                        (evaluate-build-order-tactical-plan
                         #:race t-our-race
                         #:enemy-race t-enemy-race
                         #:frame frame
                         #:supply-used eff-sup
                         #:unit-counts u-counts
                         #:researched-upgrades researched-upgs
                         #:pending-upgrades pending-upgs
                         #:in-progress-upgrade-progress eff-prog
                         #:enemy-unit-counts eu-counts
                         #:enemy-building-counts eb-counts
                         #:lanchester-ratio eff-lr
                         #:under-attack? ua-flag
                         #:base-x base-x #:base-y base-y
                         #:nat-x nat-x #:nat-y nat-y
                         #:enemy-main-x enemy-x #:enemy-main-y enemy-y
                         #:enemy-nat-x enemy-exp-x #:enemy-nat-y enemy-exp-y
                         #:enemy-third-x enemy-third-x #:enemy-third-y enemy-third-y))
                      (when live-tactics-obs?
                        (hash-set! door-st-tactics 'bo-tactical-cache
                                   (vector frame t-our-race t-enemy-race len-au len-ab len-eu len-eb
                                           ua-flag ru-len pu-len fresh-plan)))
                      fresh-plan))])
          (set-l34-ctx-bo-tplan-box! ctx plan)
          (hash-set! door-st-tactics 'bo-tactical-plan plan)
          (hash-set! door-st-tactics 'bo-tactical-disposition (bo-active-tactical-plan-disposition plan))
          (hash-set! door-st-tactics 'bo-tactical-phase (bo-active-tactical-plan-phase-id plan))
          (hash-set! door-st-tactics 'bo-micro-directives (bo-active-tactical-plan-micro-directives plan))
          (hash-set! door-st-tactics 'bo-active-tactics (bo-active-tactical-plan-active-tactics plan))
          plan)))))

(define (l34-bo-fork-coords ctx)
  (define enemy-x (l34-ctx-enemy-x ctx))
  (define enemy-y (l34-ctx-enemy-y ctx))
  (define enemy-exp-x (l34-ctx-enemy-exp-x ctx))
  (define enemy-exp-y (l34-ctx-enemy-exp-y ctx))
    (define p (l34-get-bo-tplan ctx))
    (define d (bo-active-tactical-plan-disposition p))
    (define px (safe-coord (bo-active-tactical-plan-primary-target-x p) enemy-x))
    (define py (safe-coord (bo-active-tactical-plan-primary-target-y p) enemy-y))
    (define sx (safe-coord (bo-active-tactical-plan-secondary-fork-x p) enemy-exp-x))
    (define sy (safe-coord (bo-active-tactical-plan-secondary-fork-y p) enemy-exp-y))
    (define dx (- sx px))
    (define dy (- sy py))
    (define fork-on?
      (and (memq d '(execute-timing-bypass-harass-fork execute-timing-attack-commit))
           (or (eq? d 'execute-timing-bypass-harass-fork)
               (> (+ (* dx dx) (* dy dy)) 4.0))))
    (values fork-on? sx sy))

(define (l34-safe-coord-dist2 x1 y1 x2 y2)
  (if (and (flonum? x1) (flonum? y1) (flonum? x2) (flonum? y2)
           (fl= (fl- x1 x1) 0.0) (fl= (fl- y1 y1) 0.0)
           (fl= (fl- x2 x2) 0.0) (fl= (fl- y2 y2) 0.0))
      (let ([dx (fl- x1 x2)] [dy (fl- y1 y2)])
        (fl+ (fl* dx dx) (fl* dy dy)))
      (if (and (real? x1) (= (- x1 x1) 0)
               (real? y1) (= (- y1 y1) 0)
               (real? x2) (= (- x2 x2) 0)
               (real? y2) (= (- y2 y2) 0))
          (let ([dx (fl- (exact->inexact x1) (exact->inexact x2))]
                [dy (fl- (exact->inexact y1) (exact->inexact y2))])
            (fl+ (fl* dx dx) (fl* dy dy)))
          (let ([d (dist2d x1 y1 x2 y2)])
            (* d d)))))
(define (l34-within-r2? x1 y1 x2 y2 r2 r)
  (if (and (flonum? x1) (flonum? y1) (flonum? x2) (flonum? y2)
           (fl= (fl- x1 x1) 0.0) (fl= (fl- y1 y1) 0.0)
           (fl= (fl- x2 x2) 0.0) (fl= (fl- y2 y2) 0.0))
      (let ([dx (fl- x1 x2)] [dy (fl- y1 y2)])
        (fl<= (fl+ (fl* dx dx) (fl* dy dy)) r2))
      (if (and (real? x1) (= (- x1 x1) 0)
               (real? y1) (= (- y1 y1) 0)
               (real? x2) (= (- x2 x2) 0)
               (real? y2) (= (- y2 y2) 0))
          (let ([dx (fl- (exact->inexact x1) (exact->inexact x2))]
                [dy (fl- (exact->inexact y1) (exact->inexact y2))])
            (fl<= (fl+ (fl* dx dx) (fl* dy dy)) r2))
          (<= (dist2d x1 y1 x2 y2) r))))
;; W15-P0-2-rt: Symmetry-Agnostic + Dual Ground-BFS Voronoi Territory Partition & Mobile Unit Classifier
(define SC2-MOBILE-RETREATABLE-BASE-SET
  (hasheq 'reaper #t 'hellion #t 'banshee #t 'medivac #t
          'oracle #t 'phoenix #t 'warp-prism #t 'warp-prism-phasing #t
          'adept #t 'mutalisk #t))

;; W15c: Dedicated solo harass units safe to cross deep under fog suppression even when
;; our slow main ground army holds at home (NEVER detach empty Medivacs or 1–2 Adepts /
;; Hellions / Blink-Stalkers out of a mixed slow army to feed alone!).
(define SC2-DEDICATED-SOLO-HARASS-SET
  (hasheq 'reaper #t 'banshee #t 'oracle #t 'phoenix #t
          'warp-prism #t 'warp-prism-phasing #t 'mutalisk #t))

(define (unit-medivac-loaded? u)
  (and (hash? u)
       (or (pair? (hash-ref u 'passengers '()))
           (> (safe-nonneg-int (hash-ref u 'cargo-space-taken 0) 0) 0))))

(define SC2-POWER-SPIKE-UPGRADE-SET
  (hasheq 'stimpack #t 'combat-shield #t 'combat-shields #t 'shieldwall #t
          'blink #t 'blink-tech #t 'charge #t
          'glaives #t 'resonating-glaives #t 'adept-piercing-attack #t
          'glial-reconstitution #t 'roach-speed #t
          'centrifical-hooks #t 'centrifugal-hooks #t 'grooved-spines #t
          'terran-infantry-weapons-1 #t 'terran-infantry-weapons-level1 #t
          'terran-infantry-armor-1 #t 'terran-infantry-armors-1 #t 'terran-infantry-armors-level1 #t
          'terran-infantry-weapons-2 #t 'terran-infantry-weapons-level2 #t
          'terran-infantry-armor-2 #t 'terran-infantry-armors-2 #t
          'protoss-ground-weapons-1 #t 'protoss-ground-weapons-level1 #t
          'protoss-ground-armor-1 #t 'protoss-ground-armors-1 #t 'protoss-ground-armors-level1 #t
          'protoss-ground-weapons-2 #t 'protoss-ground-weapons-level2 #t
          'zerg-missile-weapons-1 #t 'zerg-missile-weapons-level1 #t
          'zerg-melee-weapons-1 #t 'zerg-melee-weapons-level1 #t
          'zerg-ground-armor-1 #t 'zerg-ground-armors-1 #t 'zerg-ground-armors-level1 #t
          'zerg-missile-weapons-2 #t 'zerg-melee-weapons-2 #t))

(define (bot-runtime-mobile-retreatable-unit? u #:researched-upgrades [researched-upgs '()] #:small-ling-runby? [small-ling-runby? #f])
  (define ut (fast-canonical-unit-sym (if (symbol? u) u (unit-type-sym u))))
  (or (and (eq? ut 'medivac)
           (if (hash? u) (unit-medivac-loaded? u) #t))
      (and (not (eq? ut 'medivac))
           (hash-has-key? SC2-MOBILE-RETREATABLE-BASE-SET ut))
      (and (eq? ut 'stalker)
           (or (memq 'blink researched-upgs)
               (memq 'blink-tech researched-upgs)
               (memv 87 researched-upgs))
           #t)
      (and (eq? ut 'zergling) (and small-ling-runby? #t))))

(define (l34-small-ling-runby-ok? ctx)
  (define sc (l34-ctx-l34-sc ctx))
  (define cu (l34-ctx-combat-units ctx))
  (define cached (and sc (hash-ref sc 'w15-ling-count #f)))
  (define cnt
    (if (and (pair? cached) (eq? (car cached) cu))
        (cdr cached)
        (let ([c (for/sum ([u (in-list cu)])
                   (if (eq? (fast-canonical-unit-sym (unit-type-sym u)) 'zergling) 1 0))])
          (when sc (hash-set! sc 'w15-ling-count (cons cu c)))
          c)))
  (and (> cnt 0) (<= cnt 8)))

(define (l34-mobile-retreatable-unit? ctx u [small-ling-runby? 'auto])
  (define ut (fast-canonical-unit-sym (if (symbol? u) u (unit-type-sym u))))
  (or (and (eq? ut 'medivac)
           (if (hash? u) (unit-medivac-loaded? u) #t))
      (and (not (eq? ut 'medivac))
           (hash-has-key? SC2-MOBILE-RETREATABLE-BASE-SET ut))
      (and (eq? ut 'stalker)
           (or (l34-has-upgrade? ctx 'blink)
               (memq 'blink-tech (l34-ctx-researched-upgs ctx))
               (memv 87 (l34-ctx-researched-upgs ctx)))
           #t)
      (and (eq? ut 'zergling)
           (if (eq? small-ling-runby? 'auto)
               (l34-small-ling-runby-ok? ctx)
               (and small-ling-runby? #t)))))

(define (l34-solo-harass-exempt-unit? ctx u)
  (define ut (fast-canonical-unit-sym (if (symbol? u) u (unit-type-sym u))))
  (or (hash-has-key? SC2-DEDICATED-SOLO-HARASS-SET ut)
      (and (eq? ut 'medivac) (unit-medivac-loaded? u))
      (and (hash-ref (l34-ctx-l34-sc ctx) 'w15-all-mobile-retreatable? #f)
           (l34-mobile-retreatable-unit? ctx u))))

(define (l34-eval-bfs-dist bfs x y)
  (cond
    [(not bfs) +inf.0]
    [(procedure? bfs)
     (define d (if (procedure-arity-includes? bfs 3)
                   (bfs x y 2)
                   (bfs x y)))
     (if (and (real? d) (= (- d d) 0) (< d 1e8))
         (if (flonum? d) d (exact->inexact d))
         +inf.0)]
    [else
     (define d (placement:sc2-ground-bfs-dist-at bfs x y 2))
     (if (and (real? d) (= (- d d) 0) (< d 1e8))
         (if (flonum? d) d (exact->inexact d))
         +inf.0)]))

;; L58 BUG #3b: Verify a flanking wing point is ground-pathable on the live map
;; (`our-ground-bfs` AND `map-grids` `pathing-ref`/`pathing-pred` when present).
(define (l34-wing-point-pathable? ctx px py)
  (define obs (l34-ctx-obs ctx))
  (cond
    [(not (hash? obs)) #t]
    [else
     (define our-bfs (hash-ref obs 'our-ground-bfs #f))
     (define bfs-ok?
       (or (not our-bfs)
           (fl< (l34-eval-bfs-dist our-bfs px py) 1e8)))
     (define mg (hash-ref obs 'map-grids #f))
     (define pref
       (and (hash? mg)
            (or (hash-ref mg 'pathing-ref #f)
                (hash-ref mg 'pathing-pred #f))))
     (define grid-ok?
       (or (not (procedure? pref))
           (let ([v (pref (inexact->exact (floor px)) (inexact->exact (floor py)))])
             (cond
               [(boolean? v) v]
               [(real? v) (> v 0)]
               [else #t]))))
     (and bfs-ok? grid-ok?)]))

(define (build-territory-info obs ally-bldgs enemy-bldgs bx by ex ey)
  (define fbx (exact->inexact (safe-finite-real bx 32.0)))
  (define fby (exact->inexact (safe-finite-real by 32.0)))
  (define fex (exact->inexact (safe-finite-real ex 140.0)))
  (define fey (exact->inexact (safe-finite-real ey 140.0)))
  (define our-bfs (and (hash? obs) (hash-ref obs 'our-ground-bfs #f)))
  (define enemy-bfs (and (hash? obs) (hash-ref obs 'enemy-ground-bfs #f)))
  (define has-dual-bfs? (and our-bfs enemy-bfs #t))
  (define raw-sym-kind (and (hash? obs) (hash-ref obs 'map-symmetry-kind #f)))
  (define sym-kind
    (or raw-sym-kind
        (let ([mw (and (hash? obs) (hash-ref obs 'map-width #f))]
              [mh (and (hash? obs) (hash-ref obs 'map-height #f))])
          (and (real? mw) (real? mh) (> mw 0) (> mh 0)
               (placement:sc2-detect-map-symmetry
                (cons fbx fby) (cons fex fey) mw mh
                (let ([pads (hash-ref obs 'expansion-candidates '())])
                  (if (list? pads) pads '())))))))
  (define raw-ally-ths
    (for/list ([b (in-list ally-bldgs)]
               #:when (and (hash? b)
                           (or (bitwise-bit-set? (fast-ally-bldg-flags (unit-type-sym b)) 2)
                               (memq (fast-canonical-structure-sym (unit-type-sym b))
                                     '(hatchery lair hive nexus command-center orbital-command planetary-fortress)))
                           (real? (hash-ref b 'x #f))
                           (real? (hash-ref b 'y #f))))
      (define tx (exact->inexact (safe-finite-real (hash-ref b 'x fbx) fbx)))
      (define ty (exact->inexact (safe-finite-real (hash-ref b 'y fby) fby)))
      (vector tx ty (if has-dual-bfs? (l34-eval-bfs-dist our-bfs tx ty) 0.0))))
  (define live-th-recs
    (if (pair? raw-ally-ths)
        raw-ally-ths
        (list (vector fbx fby 0.0))))
  (define raw-enemy-ths
    (for/list ([b (in-list enemy-bldgs)]
               #:when (and (hash? b)
                           (memq (fast-canonical-structure-sym (unit-type-sym b))
                                 '(hatchery lair hive nexus command-center orbital-command planetary-fortress))
                           (real? (hash-ref b 'x #f))
                           (real? (hash-ref b 'y #f))))
      (define tx (exact->inexact (safe-finite-real (hash-ref b 'x fex) fex)))
      (define ty (exact->inexact (safe-finite-real (hash-ref b 'y fey) fey)))
      (vector tx ty (if has-dual-bfs? (l34-eval-bfs-dist enemy-bfs tx ty) 0.0))))
  (define has-enemy-main-rec?
    (for/or ([r (in-list raw-enemy-ths)])
      (fl<= (fast-dist2d (vector-ref r 0) (vector-ref r 1) fex fey) 10.0)))
  (define enemy-th-recs
    (if has-enemy-main-rec?
        raw-enemy-ths
        (cons (vector fex fey 0.0) raw-enemy-ths)))
  (define mid-x (fl* 0.5 (fl+ fbx fex)))
  (define mid-y (fl* 0.5 (fl+ fby fey)))
  (define span-dx (fl- fex fbx))
  (define span-dy (fl- fey fby))
  (define span-len (flmax 1.0 (flsqrt (fl+ (fl* span-dx span-dx) (fl* span-dy span-dy)))))
  (vector our-bfs enemy-bfs has-dual-bfs? sym-kind
          fbx fby fex fey
          live-th-recs enemy-th-recs
          mid-x mid-y (fl/ span-dx span-len) (fl/ span-dy span-len) span-len))

(define (l34-get-territory-info ctx)
  (define sc (l34-ctx-l34-sc ctx))
  (define cached (and sc (hash-ref sc 'w15-territory-info #f)))
  (define obs (l34-ctx-obs ctx))
  (define ab (l34-ctx-ally-bldgs ctx))
  (define eb (l34-ctx-enemy-bldgs ctx))
  (if (and (vector? cached)
           (eq? (vector-ref cached 0) obs)
           (eq? (vector-ref cached 1) ab)
           (eq? (vector-ref cached 2) eb))
      (vector-ref cached 3)
      (let ([info (build-territory-info obs ab eb
                                        (l34-ctx-base-x ctx) (l34-ctx-base-y ctx)
                                        (l34-ctx-enemy-x ctx) (l34-ctx-enemy-y ctx))])
        (when sc (hash-set! sc 'w15-territory-info (vector obs ab eb info)))
        info)))

(define (compute-territory-details/info info x y air?)
  (define fx (exact->inexact (safe-finite-real x 0.0)))
  (define fy (exact->inexact (safe-finite-real y 0.0)))
  (define our-bfs (vector-ref info 0))
  (define enemy-bfs (vector-ref info 1))
  (define has-dual-bfs? (vector-ref info 2))
  (define sym-kind (vector-ref info 3))
  (define fbx (vector-ref info 4))
  (define fby (vector-ref info 5))
  (define fex (vector-ref info 6))
  (define fey (vector-ref info 7))
  (define live-th-recs (vector-ref info 8))
  (define enemy-th-recs (vector-ref info 9))
  (define mid-x (vector-ref info 10))
  (define mid-y (vector-ref info 11))
  (define ax-x (vector-ref info 12))
  (define ax-y (vector-ref info 13))
  (define min-eucl-ours
    (for/fold ([best +inf.0]) ([r (in-list live-th-recs)])
      (flmin best (fast-dist2d fx fy (vector-ref r 0) (vector-ref r 1)))))
  (define min-eucl-enemy
    (for/fold ([best +inf.0]) ([r (in-list enemy-th-recs)])
      (flmin best (fast-dist2d fx fy (vector-ref r 0) (vector-ref r 1)))))
  (cond
    [air?
     (values (fl- min-eucl-enemy min-eucl-ours) min-eucl-ours #f)]
    [has-dual-bfs?
     (define d-o0 (l34-eval-bfs-dist our-bfs fx fy))
     (define d-e0 (l34-eval-bfs-dist enemy-bfs fx fy))
     (cond
       [(and (fl< d-o0 1e8) (fl< d-e0 1e8))
        ;; Base-anchored expansion offset for claimed 3rd/4th+ bases with exact
        ;; triangle-inequality cliff guard (`|d_main(p) - d_main(B)| <= dist2d(p, B) + 8.0`)
        ;; so we never cheat across an impassable cliff/wall!
        (define d-o-eff
          (for/fold ([best d-o0]) ([r (in-list live-th-recs)])
            (define db (vector-ref r 2))
            (if (fl< db 1e8)
                (let ([de (fast-dist2d fx fy (vector-ref r 0) (vector-ref r 1))]
                      [dd (flabs (fl- d-o0 db))])
                  (if (fl<= dd (fl+ de 8.0))
                      (flmin best (flmax de dd))
                      best))
                best)))
        (define d-e-eff
          (for/fold ([best d-e0]) ([r (in-list enemy-th-recs)])
            (define db (vector-ref r 2))
            (if (fl< db 1e8)
                (let ([de (fast-dist2d fx fy (vector-ref r 0) (vector-ref r 1))]
                      [dd (flabs (fl- d-e0 db))])
                  (if (fl<= dd (fl+ de 8.0))
                      (flmin best (flmax de dd))
                      best))
                best)))
        ;; W15c (`#443/#446`): Real SC2 main-ramp detours (`eucl=15t, d-o-eff=33t`) are
        ;; walkable own territory, NEVER cliff-blocked! Require `d-o-eff > 46` AND `> eucl + 26`
        ;; so only genuine unpathable cliff chasms (`70-220+` tiles) set `cliff-blocked?`.
        (define cliff-blocked?
          (and (fl> d-o-eff 46.0)
               (fl> d-o-eff (fl+ min-eucl-ours 26.0))))
        (values (fl- d-e-eff d-o-eff) d-o-eff cliff-blocked?)]
       [else
        (compute-territory-details/info
         (vector #f #f #f sym-kind fbx fby fex fey live-th-recs enemy-th-recs
                 mid-x mid-y ax-x ax-y (vector-ref info 14))
         fx fy #f)])]
    [else
     (define voronoi-m (fl- min-eucl-enemy min-eucl-ours))
     (define multi-base-override?
       (and (or (> (length live-th-recs) 1) (> (length enemy-th-recs) 1))
            (or (fl<= min-eucl-ours 28.0) (fl<= min-eucl-enemy 28.0))))
     (define margin
       (if multi-base-override?
           voronoi-m
           (case sym-kind
             [(mirror-horizontal)
              (fl* 2.0 (if (fl< fbx fex) (fl- mid-x fx) (fl- fx mid-x)))]
             [(mirror-vertical)
              (fl* 2.0 (if (fl< fby fey) (fl- mid-y fy) (fl- fy mid-y)))]
             [(mirror-diagonal-main mirror-diagonal-anti)
              (fl* 2.0 (fl+ (fl* (fl- mid-x fx) ax-x) (fl* (fl- mid-y fy) ax-y)))]
             [else voronoi-m])))
     (values margin min-eucl-ours #f)]))

(define (classify-territory-zone margin d-o-eff cliff-blocked?)
  (cond
    [(or (fl>= margin 6.0)
         (and (not cliff-blocked?) (fl<= d-o-eff 28.0)))
     'own-territory]
    [(fl>= margin -8.0)
     'contested-frontline]
    [else
     'deep-enemy-territory]))

(define (l34-point-territory-details ctx x y #:air? [air? #f])
  (compute-territory-details/info (l34-get-territory-info ctx) x y air?))

(define (l34-point-territory-margin ctx x y #:air? [air? #f])
  (define-values (m _do _cb) (l34-point-territory-details ctx x y #:air? air?))
  m)

(define (l34-point-territory-zone ctx x y #:air? [air? #f])
  (define-values (m d-o cb) (l34-point-territory-details ctx x y #:air? air?))
  (classify-territory-zone m d-o cb))

;; L20-P0-3 (`OBRet` / `SuicideKite`): Fast cached check whether `(x, y)` sits inside owned
;; territory (<= 20.0t of any owned TownHall OR <= 14.0t of any friendly home building).
(define (l34-point-in-owned-territory? ctx x y)
  (and (real? x) (real? y)
       (= (- x x) 0) (= (- y y) 0)
       (let* ([sc (l34-ctx-l34-sc ctx)]
              [pts (or (and (hash? sc) (hash-ref sc 'l20-owned-terr-pts #f))
                       (let* ([ally-bldgs (l34-ctx-ally-bldgs ctx)]
                              [ths
                               (for/list ([b (in-list ally-bldgs)]
                                          #:when (and (hash? b)
                                                      (bitwise-bit-set? (fast-ally-bldg-flags (unit-type-sym b)) 2)
                                                      (real? (hash-ref b 'x #f))
                                                      (real? (hash-ref b 'y #f))))
                                 (cons (exact->inexact (hash-ref b 'x 0.0))
                                       (exact->inexact (hash-ref b 'y 0.0))))]
                              [hbldgs
                               (if (null? ths)
                                   '()
                                   (for/list ([b (in-list ally-bldgs)]
                                              #:when (and (hash? b)
                                                          (not (bitwise-bit-set? (fast-ally-bldg-flags (unit-type-sym b)) 2))
                                                          (real? (hash-ref b 'x #f))
                                                          (real? (hash-ref b 'y #f))
                                                          (let ([bx (exact->inexact (hash-ref b 'x 0.0))]
                                                                [by (exact->inexact (hash-ref b 'y 0.0))])
                                                            (for/or ([tc (in-list ths)])
                                                              (define dx (fl- bx (car tc)))
                                                              (define dy (fl- by (cdr tc)))
                                                              (fl<= (fl+ (fl* dx dx) (fl* dy dy)) 1444.0)))))
                                     (cons (exact->inexact (hash-ref b 'x 0.0))
                                           (exact->inexact (hash-ref b 'y 0.0)))))]
                              [res (cons ths hbldgs)])
                         (when (hash? sc) (hash-set! sc 'l20-owned-terr-pts res))
                         res))]
              [fx (exact->inexact x)]
              [fy (exact->inexact y)])
         (or (for/or ([tc (in-list (car pts))])
               (define dx (fl- fx (car tc)))
               (define dy (fl- fy (cdr tc)))
               (fl<= (fl+ (fl* dx dx) (fl* dy dy)) 400.0))
             (for/or ([bc (in-list (cdr pts))])
               (define dx (fl- fx (car bc)))
               (define dy (fl- fy (cdr bc)))
               (fl<= (fl+ (fl* dx dx) (fl* dy dy)) 196.0))))))

(define (bot-runtime-point-territory-margin obs x y #:air? [air? #f])
  (define ally-b (let ([v (hash-ref obs 'ally-buildings '())]) (if (list? v) v '())))
  (define enemy-b (let ([v (hash-ref obs 'enemy-buildings '())]) (if (list? v) v '())))
  (define info (build-territory-info obs ally-b enemy-b
                                     (hash-ref obs 'base-x 32.0) (hash-ref obs 'base-y 32.0)
                                     (hash-ref obs 'enemy-x 140.0) (hash-ref obs 'enemy-y 140.0)))
  (define-values (m _do _cb) (compute-territory-details/info info x y air?))
  m)

(define (bot-runtime-point-territory-zone obs x y #:air? [air? #f])
  (define ally-b (let ([v (hash-ref obs 'ally-buildings '())]) (if (list? v) v '())))
  (define enemy-b (let ([v (hash-ref obs 'enemy-buildings '())]) (if (list? v) v '())))
  (define info (build-territory-info obs ally-b enemy-b
                                     (hash-ref obs 'base-x 32.0) (hash-ref obs 'base-y 32.0)
                                     (hash-ref obs 'enemy-x 140.0) (hash-ref obs 'enemy-y 140.0)))
  (define-values (m d-o cb) (compute-territory-details/info info x y air?))
  (classify-territory-zone m d-o cb))

(define (l34-fast-enemy-near-territory? ctx e ex ey)
  (define enemy-territory-cache (l34-ctx-enemy-territory-cache ctx))
  (define territory-miss (l34-ctx-territory-miss ctx))
  (define fbase-x (l34-ctx-fbase-x ctx))
  (define fbase-y (l34-ctx-fbase-y ctx))
  (define fnat-x (l34-ctx-fnat-x ctx))
  (define fnat-y (l34-ctx-fnat-y ctx))
  (define fthird-x (l34-ctx-fthird-x ctx))
  (define fthird-y (l34-ctx-fthird-y ctx))
  (define combat-th-limit? (l34-ctx-combat-th-limit? ctx))
  (define hit (if enemy-territory-cache (hash-ref enemy-territory-cache e territory-miss) territory-miss))
  (if (eq? hit territory-miss)
      ;; W12-P0-5-rt + W15-P0-2-rt: Symmetry-agnostic + dual ground-BFS Voronoi territory
      ;; defense (adapting to rotational-180, horizontal/vertical/diagonal mirrors & cliff chokes,
      ;; while keeping air distance separate for flying harassers!).
      (let* ([info (l34-get-territory-info ctx)]
             [has-dual-bfs? (vector-ref info 2)]
             [sym-kind (vector-ref info 3)]
             [live-th-recs (vector-ref info 8)]
             [e-flying? (and (hash? e)
                             (or (eq? (hash-ref e 'flying #f) #t)
                                 (eq? (hash-ref e 'flying? #f) #t)
                                 (eq? (hash-ref e 'is-flying #f) #t)
                                 (fast-unit-is-flying-sym? (unit-type-sym e))))]
             [res
              (cond
                [(and has-dual-bfs? (not e-flying?))
                 (define-values (margin d-o-eff _cliff-blocked?)
                   (compute-territory-details/info info ex ey #f))
                 (or (fl<= d-o-eff 38.0)
                     (and (fl>= margin 6.0) (fl<= d-o-eff 52.0)))]
                [else
                 (define-values (margin d-o-eff _cb)
                   (compute-territory-details/info info ex ey e-flying?))
                 (or (l34-within-r2? ex ey fbase-x fbase-y 1296.0 36.0)
                     (l34-within-r2? ex ey fnat-x fnat-y 1296.0 36.0)
                     (and combat-th-limit?
                          (l34-within-r2? ex ey fthird-x fthird-y 1296.0 36.0))
                     (for/or ([r (in-list live-th-recs)])
                       (l34-within-r2? ex ey (vector-ref r 0) (vector-ref r 1) 1296.0 36.0))
                     (and (not e-flying?)
                          (memq sym-kind '(mirror-horizontal mirror-vertical
                                           mirror-diagonal-main mirror-diagonal-anti))
                          (fl>= margin 20.0)
                          (fl<= d-o-eff 48.0)))])])
        (when enemy-territory-cache (hash-set! enemy-territory-cache e res))
        res)
      hit))
(define (l34-get-ground-eng-enemy-recs ctx)
  (or (l34-ctx-ground-eng-enemy-recs-cache ctx)
      (let ([res (for/list ([e (in-list (l34-ctx-engagement-enemies ctx))]
                            #:when (not (fast-unit-is-flying-sym? (unit-type-sym e))))
                   (vector e (hash-ref e 'x #f) (hash-ref e 'y #f)))])
        (set-l34-ctx-ground-eng-enemy-recs-cache! ctx res)
        res)))
(define (l34-any-ally-siege-near? ctx ex ey ux uy)
  (define ally-siege-supporters (l34-ctx-ally-siege-supporters ctx))
  (let loop ([rem ally-siege-supporters])
    (and (pair? rem)
         (let ([tk (car rem)])
           (or (l34-within-r2? ex ey (hash-ref tk 'x ux) (hash-ref tk 'y uy) 240.25 15.5)
               (loop (cdr rem)))))))
(define (l34-find-pf-holding-off ctx etype ex ey ux uy)
  (define enemy-pf-list (l34-ctx-enemy-pf-list ctx))
  (let loop ([rem enemy-pf-list])
    (and (pair? rem)
         (let ([eb (car rem)])
           (if (or (eq? etype 'planetary-fortress)
                   (l34-within-r2? ex ey (hash-ref eb 'x 9999.0) (hash-ref eb 'y 9999.0) 110.25 10.5)
                   (l34-within-r2? ux uy (hash-ref eb 'x 9999.0) (hash-ref eb 'y 9999.0) 110.25 10.5))
               eb
               (loop (cdr rem)))))))
(define (l34-find-sieged-tank-holding-off ctx ex ey ux uy)
  (define enemy-sieged-tanks-near (l34-ctx-enemy-sieged-tanks-near ctx))
  (let loop ([rem enemy-sieged-tanks-near])
    (and (pair? rem)
         (let ([st (car rem)])
           (if (or (l34-within-r2? ex ey (hash-ref st 'x 9999.0) (hash-ref st 'y 9999.0) 196.0 14.0)
                   (l34-within-r2? ux uy (hash-ref st 'x 9999.0) (hash-ref st 'y 9999.0) 240.25 15.5))
               st
               (loop (cdr rem)))))))
(define (l34-find-nearest-sieged-tank ctx ux uy)
  (define enemy-sieged-tanks-near (l34-ctx-enemy-sieged-tanks-near ctx))
  (let loop ([rem enemy-sieged-tanks-near])
    (and (pair? rem)
         (let ([st (car rem)])
           (if (l34-within-r2? ux uy (hash-ref st 'x 9999.0) (hash-ref st 'y 9999.0) 240.25 15.5)
               st
               (loop (cdr rem)))))))
(define (l34-emit-caster-rear-leash! ctx uid ux uy)
  (define fcaster-leash-x (l34-ctx-fcaster-leash-x ctx))
  (define fcaster-leash-y (l34-ctx-fcaster-leash-y ctx))
  (define caster-leash-x (l34-ctx-caster-leash-x ctx))
  (define caster-leash-y (l34-ctx-caster-leash-y ctx))
  (when (not (l34-within-r2? ux uy fcaster-leash-x fcaster-leash-y 4.84 2.2))
    (l34-emit! ctx (list 'move uid caster-leash-x caster-leash-y))))
(define (l34-emit-engage-or-rally! ctx uid ux uy ex ey eid
                               nearest-enemy-tank
                               zergling-hold-off-pf-siege?
                               tank-supporting-vs-static?
                               unit-should-engage-target?
                               [u #f]
                               [ut #f]
                               [can-hit-target? #t]
                               [edist2 +inf.0]
                               [target-enemy #f])
  (define combat-suppress-attack? (l34-ctx-combat-suppress-attack? ctx))
  (define bo-rally-override? (l34-ctx-bo-rally-override? ctx))
  (define fbo-rally-tx (l34-ctx-fbo-rally-tx ctx))
  (define fbo-rally-ty (l34-ctx-fbo-rally-ty ctx))
  (define bo-rally-tx (l34-ctx-bo-rally-tx ctx))
  (define bo-rally-ty (l34-ctx-bo-rally-ty ctx))
  (define fnat-x (l34-ctx-fnat-x ctx))
  (define fnat-y (l34-ctx-fnat-y ctx))
  (define nat-x (l34-ctx-nat-x ctx))
  (define nat-y (l34-ctx-nat-y ctx))
  (define l34-sc-here (l34-ctx-l34-sc ctx))
  (define cv-staging-here?
    (and (hash? l34-sc-here)
         (hash-ref l34-sc-here 'l25-counter-volley-staging? #f)))
  ;; Loop 64 P0 #1 (`#1724`): Replace hardcoded Main/Nat/3rd ternary with precomputed
  ;; generalized situational fallback anchor (`pick-safe-fallback-point`, cached once/step).
  (define-values (regroup-x regroup-y)
    (let ([fx (and (hash? l34-sc-here) (hash-ref l34-sc-here 'l64-fallback-x #f))]
          [fy (and (hash? l34-sc-here) (hash-ref l34-sc-here 'l64-fallback-y #f))])
      (if (and (real? fx) (real? fy))
          (values fx fy)
          (let* ([fb-pt
                  (pick-safe-fallback-point
                   #:domain 'ground
                   #:group-x fnat-x
                   #:group-y fnat-y
                   #:threat-x (exact->inexact (l34-ctx-enemy-x ctx))
                   #:threat-y (exact->inexact (l34-ctx-enemy-y ctx))
                   #:severity (if (or cv-staging-here? (l34-ctx-enemy-within-14-of-th? ctx)) 'severe 'muster)
                   #:ally-buildings (or (l34-ctx-ally-bldgs ctx) '())
                   #:ally-units (or (l34-ctx-combat-units ctx) '())
                   #:enemy-units (or (l34-ctx-enemy-units ctx) '())
                   #:base-x (l34-ctx-base-x ctx)
                   #:base-y (l34-ctx-base-y ctx)
                   #:nat-x nat-x
                   #:nat-y nat-y)])
            (values (car fb-pt) (cdr fb-pt))))))
  (define fregroup-x (exact->inexact regroup-x))
  (define fregroup-y (exact->inexact regroup-y))
  ;; W7-P0-2-rt: Preserve own-main/natural home defense (`enemy-within-14-of-th?`) attack orders
  ;; against `cortex-filter-actions!` truncation behind `econ-acts` macro/camera spam.
  (define home-def-preserve? (l34-ctx-enemy-within-14-of-th? ctx))
  (define (emit-home-safe-atk! act)
    (if home-def-preserve?
        (l34-emit-preserved! ctx act)
        (l34-emit! ctx act)))
  (cond
    [nearest-enemy-tank
     ;; W6-TAC-3: Before kiting away from a Siege Tank line, allow units whose weapon is
     ;; ready to stutter-fire at an enemy ALREADY within weapon range (e.g. Marines screening
     ;; at 3.5t in front of Tanks), preventing 0-DPS `MOVE 16` deaths while preserving
     ;; out-of-range siege-line kiting discipline (`novel-02`).
     (define u-sym-st (or ut (and (hash? u) (unit-type-sym u))))
     (define stats-st (and u-sym-st (fast-unit-combat-stats u-sym-st)))
     (define has-weapon-st?
       (and (hash? stats-st)
            (or (> (hash-ref stats-st 'ground-dps 0.0) 0.0)
                (> (hash-ref stats-st 'air-dps 0.0) 0.0))))
     (define target-flying-st?
       (and (hash? target-enemy)
            (or (eq? (hash-ref target-enemy 'flying #f) #t)
                (eq? (hash-ref target-enemy 'flying? #f) #t)
                (eq? (hash-ref target-enemy 'is-flying #f) #t)
                (fast-unit-is-flying-sym? (unit-type-sym target-enemy)))))
     (define non-free-target-st?
       (not (and (hash? target-enemy)
                 (free-summon-unit-sym? (unit-type-sym target-enemy)))))
     (define fedist2-st
       (cond
         [(flonum? edist2) edist2]
         [(real? edist2) (exact->inexact edist2)]
         [else +inf.0]))
     (define eff-range-st
       (if has-weapon-st?
           (let* ([gr (exact->inexact
                       (or (and (hash? u) (hash-ref u 'ground-range #f))
                           (hash-ref stats-st 'ground-range 0.0)))]
                  [ar (exact->inexact (hash-ref stats-st 'air-range 0.0))]
                  [base-r (let ([r0 (if target-flying-st? ar gr)])
                            (if (fl> r0 0.0) r0 (flmax gr ar)))])
             (fl+ base-r
                  (cond
                    [(and (eq? u-sym-st 'hydralisk) (l34-has-upgrade? ctx 'grooved-spines)) 1.0]
                    [(and (eq? u-sym-st 'colossus) (l34-has-upgrade? ctx 'extended-thermal-lance)) 2.0]
                    [(and (eq? u-sym-st 'phoenix) target-flying-st? (l34-has-upgrade? ctx 'anion-pulse-crystals)) 1.0]
                    [else 0.0])))
           0.0))
     (define raw-w-cd-st (and (hash? u) (hash-ref u 'weapon-cooldown (hash-ref u 'weapon_cooldown 0.0))))
