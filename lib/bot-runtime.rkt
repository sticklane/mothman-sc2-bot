             [enemy-ground-siege-for-lib? 6]
             [else 4]))
         (when (or (not live-game?)
                   (and (or enemy-capital-air? (enemy-tech-observation-requires-anti-air? tech-obs))
                        (< (l2-unit-count ctx 'viking) desired-viking-cap))
                   (and endgame-corner-hunt?
                        (< (l2-unit-count ctx 'viking) 10))
                   (and (< (l2-unit-count ctx 'viking) desired-viking-cap)
                        (>= (l2-unit-count ctx 'medivac) 2)
                        (or (l2-plan-wants-now? ctx 'viking)
                            (not terran-bo-escrow-imminent?)
                            (>= (l2-unit-count ctx 'liberator) desired-liberator-cap))
                        (or (not terran-bo-escrow-imminent?)
                            (l2-can-spend-by-priority? ctx 'viking 'combat-unit))))
           (l2-try-train-unit! ctx 'viking 'starport 6 #:respect-bo-reserve? (and (not enemy-capital-air?) (if live-game? terran-bo-escrow-imminent? #t))))
         (when (and (< (l2-unit-count ctx 'liberator) desired-liberator-cap)
                    (or (l2-plan-wants-now? ctx 'liberator)
                        (and live-game?
                             (>= eff-phase-supply 80)
                             (>= (l2-unit-count ctx 'medivac) (if enemy-ground-siege-for-lib? 1 2))))
                    (or (not terran-bo-escrow-imminent?)
                        (l2-can-spend-by-priority? ctx 'liberator 'combat-unit)))
           (l2-try-train-unit! ctx 'liberator 'starport 6 #:respect-bo-reserve? (if live-game? terran-bo-escrow-imminent? #t)))
         ;; Continuous Starport idle-slot fill when not waiting on an imminent (< 3s) priority escrow
         (when (and live-game?
                    (> (hash-ref open-prod-slots 'starport 0) 0)
                    (not terran-prod-save-hold?)
                    (not terran-bo-escrow-imminent?))
           (when (< (l2-unit-count ctx 'medivac) (if enemy-capital-air? 2 6))
             (l2-try-train-unit! ctx 'medivac 'starport 6 #:respect-bo-reserve? #f))
           (when (> (hash-ref open-prod-slots 'starport 0) 0)
             (l2-try-train-unit! ctx 'viking 'starport 6 #:respect-bo-reserve? #f))
           (when (> (hash-ref open-prod-slots 'starport 0) 0)
             (l2-try-train-unit! ctx 'liberator 'starport 6 #:respect-bo-reserve? #f))))
       ;; Barracks production (Group 5)
       (when (memq 'barracks ready-bldg-types)
         (define has-rax-tl-ready?
           (or (memq 'barracks-techlab ready-bldg-types)
               (not (hash-has-key? raw-obs 'mineral-harvesters))))
         (define rax-tl-open-now (hash-ref open-prod-slots 'barracks-techlab-open 0))
         (define rax-basic-open-now (hash-ref open-prod-slots 'barracks-basic-open 0))
         (define tvp-or-armored-marauder?
           (and live-game?
                (or (memq effective-enemy-race '(Protoss Terran))
                    (ormap (lambda (e)
                             (memq (unit-type-sym e)
                                   '(stalker immortal colossus marauder roach ravager
                                     siege-tank siege-tank-sieged thor ultralisk)))
                           enemy-units))))
         (define desired-marauder-target
           (max 4 (quotient (* 2 (max 3 (l2-unit-count ctx 'marine))) 3)))
         (when (and live-game?
                    (< frame 2600)
                    (= (l2-unit-count ctx 'reaper) 0)
                    (= (length ally-combat-units) 0)
                    (>= (l2-ctx-gas ctx) (sc2-gas-cost 'reaper))
                    (not under-base-attack?)
                    (not under-early-cheese?))
           (when (l2-try-train-unit! ctx 'reaper 'barracks 5)
             (when (> rax-basic-open-now 0)
               (set! rax-basic-open-now (sub1 rax-basic-open-now)))))
         (define enemy-high-value-ghost-tgts?
           (or (>= (count (lambda (e) (eq? (fast-canonical-unit-sym (unit-type-sym e)) 'queen)) enemy-units) 4)
               (ormap (lambda (e)
                        (memq (unit-type-sym e)
                              '(infestor infestor-burrowed viper ultralisk lurker lurker-burrowed
                                high-templar archon)))
                      enemy-units)))
         (define desired-ghost-cap
           (if enemy-high-value-ghost-tgts? 10 6))
         (when (and has-rax-tl-ready?
                    (not crisis-tech-upgrade-deferral?)
                    (memq 'ghost-academy ready-bldg-types)
                    (< (l2-unit-count ctx 'ghost) desired-ghost-cap)
                    (>= (l2-ctx-gas ctx) (sc2-gas-cost 'ghost))
                    (or (l2-plan-wants-now? ctx 'ghost)
                        enemy-high-value-ghost-tgts?
                        (memq effective-enemy-race '(Protoss Zerg))))
           (when (l2-try-train-unit! ctx 'ghost 'barracks 5
                                    #:respect-bo-reserve? (and (not enemy-high-value-ghost-tgts?)
                                                               (if live-game? terran-bo-escrow-imminent? #t)))
             (when (> rax-tl-open-now 0)
               (set! rax-tl-open-now (max 0 (sub1 rax-tl-open-now)))
               (hash-set! open-prod-slots 'barracks-techlab-open rax-tl-open-now))))
         (define marauder-gate-open?
           (and has-rax-tl-ready?
                (or (not enemy-capital-air?)
                    (>= (l2-unit-count ctx 'viking) 16)
                    (>= (l2-ctx-gas ctx) 250))
                (or urgent-combat-or-intel-need?
                    crisis-tech-upgrade-deferral?
                    (and tvp-or-armored-marauder? (< (l2-unit-count ctx 'marauder) (max 6 desired-marauder-target)))
                    (l2-starport-escrow-ok? ctx (sc2-min-cost 'marauder) (sc2-gas-cost 'marauder)))
                (or crisis-tech-upgrade-deferral?
                    (not terran-bo-escrow-imminent?)
                    (l2-can-spend-by-priority? ctx 'marauder 'combat-unit))))
         (when marauder-gate-open?
           (define pre-slots (hash-ref open-prod-slots 'barracks 0))
           (when (and live-game? (> rax-tl-open-now 0) (< rax-tl-open-now pre-slots))
             (hash-set! open-prod-slots 'barracks rax-tl-open-now))
           (define trained-mar?
             (l2-try-train-unit! ctx 'marauder 'barracks 5
                              #:respect-bo-reserve? (and (not tvp-or-armored-marauder?)
                                                         (not crisis-tech-upgrade-deferral?)
                                                         (if live-game? terran-bo-escrow-imminent? #t))))
           (define post-slots (hash-ref open-prod-slots 'barracks 0))
           (define consumed (max 0 (- (if (and live-game? (> rax-tl-open-now 0) (< rax-tl-open-now pre-slots))
                                          rax-tl-open-now
                                          pre-slots)
                                      post-slots)))
           (when (and live-game? (> rax-tl-open-now 0) (< rax-tl-open-now pre-slots))
             (hash-set! open-prod-slots 'barracks (max 0 (- pre-slots consumed))))
           (when trained-mar?
             (set! rax-tl-open-now (max 0 (- rax-tl-open-now consumed)))
             (hash-set! open-prod-slots 'barracks-techlab-open rax-tl-open-now)))
         ;; Reserve TechLab Barracks slots from Marine training ONLY when Marauder training is active & gas >= 25 (no 15-gas deadlock!)
         (define reserve-tl-for-marauder?
           (and live-game?
                marauder-gate-open?
                has-rax-tl-ready?
                (> rax-tl-open-now 0)
                (>= (l2-ctx-gas ctx) (sc2-gas-cost 'marauder))
                (l2-imminent-escrow-needed? ctx (sc2-min-cost 'marauder) (sc2-gas-cost 'marauder))
                (or (and tvp-or-armored-marauder?
                         (< (l2-unit-count ctx 'marauder) desired-marauder-target))
                    (< (l2-unit-count ctx 'marauder) (max 2 (quotient (l2-unit-count ctx 'marine) 3))))
                (not (and under-early-cheese? (= (length ally-combat-units) 0) (< (l2-ctx-minerals ctx) 95)))))
         (when (and (or (not enemy-capital-air?)
                        (not (memq 'starport ready-bldg-types))
                        (< (+ (l2-unit-count ctx 'marine) (l2-unit-count ctx 'marauder)) 18)
                        (>= (l2-ctx-minerals ctx) 200)
                        (>= (l2-unit-count ctx 'viking) 16))
                    (or urgent-combat-or-intel-need?
                        crisis-tech-upgrade-deferral?
                        (< (+ (l2-unit-count ctx 'marine) (l2-unit-count ctx 'marauder)) 4)
                        (l2-starport-escrow-ok? ctx (sc2-min-cost 'marine) 0))
                    (or (not reserve-tl-for-marauder?) (> rax-basic-open-now 0))
                    (or crisis-tech-upgrade-deferral?
                        (not terran-bo-escrow-imminent?)
                        (l2-can-spend-by-priority? ctx 'marine 'combat-unit)))
           (define full-rax-slots (hash-ref open-prod-slots 'barracks 0))
           (when reserve-tl-for-marauder?
             (hash-set! open-prod-slots 'barracks rax-basic-open-now))
           (l2-try-train-unit! ctx 'marine 'barracks 5
                               #:respect-bo-reserve? (and (not crisis-tech-upgrade-deferral?)
                                                          (if live-game? terran-bo-escrow-imminent? #t)))
           (when reserve-tl-for-marauder?
             (define used-basic (max 0 (- rax-basic-open-now (hash-ref open-prod-slots 'barracks 0))))
             (hash-set! open-prod-slots 'barracks (max 0 (- full-rax-slots used-basic)))))))
  (when (and (not terran-scv-priority?)
                (not crisis-freeze-workers?)
                (l2-worker-army-curve-satisfied? ctx)
                (not terran-saving-for-expand?)
                (not terran-saving-for-orbital?)
                (l2-can-spend-by-priority? ctx 'scv 'worker)
                (< total-workers
                   (if live-game?
                       (min 70 (max target-workers terran-ideal-worker-cap))
                       target-workers))
                (or (member '(train scv) prio-scheduled-actions)
                    worker-rush-active?
                    (< total-workers 14)
                    (< (hash-ref pressure-metrics 'threat-pressure 0.0) 1.0)))
       (l2-try-train-unit! ctx 'scv 'townhall 4
                        #:respect-bo-reserve? (l2-worker-respect-bo-reserve? ctx)))
  (define depot-bldgs
       (if (or (eq? race 'Terran)
               (memq 'supply-depot (l2-ctx-bldg-types ctx))
               (memq 'supply-depot-lowered (l2-ctx-bldg-types ctx)))
           (for/list ([b (in-list ally-bldgs)]
                      #:when (memq (unit-type-sym b) '(supply-depot supply-depot-lowered)))
             b)
           '()))
  (when (not (null? depot-bldgs))
       (define door-st (rt-door-state rt))
       (define stuck-tbl (hash-ref! door-st 'terran-stuck-counts (lambda () (make-hasheqv))))
       (define wall-dep1 (and (hash? terran-ramp-wall) (hash-ref terran-ramp-wall 'depot-1 #f)))
       (define wall-dep2 (and (hash? terran-ramp-wall) (hash-ref terran-ramp-wall 'depot-2 #f)))
       (define has-wall-coords? (or (pair? wall-dep1) (pair? wall-dep2)))
       (define front-depots
         (if (not has-wall-coords?)
             depot-bldgs
             (let ([wd (for/list ([d (in-list depot-bldgs)]
                                  #:when (let ([dx (hash-ref d 'x base-x)]
                                               [dy (hash-ref d 'y base-y)])
                                           (or (and (pair? wall-dep1) (<= (fast-dist2d dx dy (car wall-dep1) (cdr wall-dep1)) 6.0))
                                               (and (pair? wall-dep2) (<= (fast-dist2d dx dy (car wall-dep2) (cdr wall-dep2)) 6.0)))))
                         d)])
               (if (null? wd) depot-bldgs wd))))
       (define-values (raised-depots lowered-depots)
         (for/fold ([r-rev '()] [l-rev '()]
                    #:result (values (reverse r-rev) (reverse l-rev)))
                   ([d (in-list front-depots)])
           (if (eq? (unit-type-sym d) 'supply-depot)
               (values (cons d r-rev) l-rev)
               (values r-rev (cons d l-rev)))))
       (define ground-enemy-pts-cache #f)
       (define (get-ground-enemy-pts)
         (unless ground-enemy-pts-cache
           (set! ground-enemy-pts-cache
                 (for/list ([e (in-list enemy-units)]
                            #:when (let ([et (unit-type-sym e)])
                                     (and (not (or (eq? (hash-ref e 'is-flying #f) #t)
                                                   (eq? (hash-ref e 'flying? #f) #t)))
                                          (not (hash-ref NON-COMBAT-AND-SCOUT-ENEMY-HT et #f)))))
                   (define et (unit-type-sym e))
                   (define ex (hash-ref e 'x 9999.0))
                   (define ey (hash-ref e 'y 9999.0))
                   (define fast? (not (not (memq et '(zergling baneling reaper adept hellion hellbat cyclone)))))
                   (vector (if (real? ex) (exact->inexact ex) 9999.0)
                           (if (real? ey) (exact->inexact ey) 9999.0)
                           (if fast? 256.0 196.0)
                           (if fast? 289.0 225.0)))))
         ground-enemy-pts-cache)
       (define raised-enemy-near-ht (pooled-hasheq! (rt-l2-scratch rt) 'door-raised-enemy-near))
       (define (raised-depot-enemy-near? d dx dy)
         (define cached (hash-ref raised-enemy-near-ht d 'miss))
         (if (eq? cached 'miss)
             (let ([res
                    (for/or ([ep (in-list (get-ground-enemy-pts))])
                      (define ddx (fl- dx (vector-ref ep 0)))
                      (define ddy (fl- dy (vector-ref ep 1)))
                      (fl<= (fl+ (fl* ddx ddx) (fl* ddy ddy)) (vector-ref ep 3)))])
               (hash-set! raised-enemy-near-ht d res)
               res)
             cached))
       (define base-x-fl (exact->inexact base-x))
       (define base-y-fl (exact->inexact base-y))
       (define nat-x-fl (exact->inexact nat-x))
       (define nat-y-fl (exact->inexact nat-y))
       (define front-depot-xs (for/list ([fd (in-list front-depots)]) (exact->inexact (hash-ref fd 'x base-x))))
       (define front-depot-ys (for/list ([fd (in-list front-depots)]) (exact->inexact (hash-ref fd 'y base-y))))
       (define raised-depot-xs (for/list ([rd (in-list raised-depots)]) (exact->inexact (hash-ref rd 'x base-x))))
       (define raised-depot-ys (for/list ([rd (in-list raised-depots)]) (exact->inexact (hash-ref rd 'y base-y))))
       (define has-front? (pair? front-depots))
       (define has-raised? (pair? raised-depots))
       (define active-stuck-tags (pooled-mutable-seteqv! (rt-l2-scratch rt) 'door-active-stuck-tags))
       (define seen-transiting-ht (pooled-hasheqv! (rt-l2-scratch rt) 'door-seen-transiting))
       (define transiting-tags-rev '())
       (when (or has-front? has-raised?)
         (for ([u (in-list ally-units)])
           (define uid (hash-ref u 'id #f))
           (when (and (exact-integer? uid)
                      (> uid 0)
                      (not (eq? (hash-ref u 'is-flying #f) #t))
                      (not (eq? (hash-ref u 'flying? #f) #t)))
             (define ux-raw (hash-ref u 'x base-x))
             (define uy-raw (hash-ref u 'y base-y))
             (define ux (if (flonum? ux-raw) ux-raw (exact->inexact ux-raw)))
             (define uy (if (flonum? uy-raw) uy-raw (exact->inexact uy-raw)))
             (when (and has-front?
                        (not (hash-ref seen-transiting-ht uid #f))
                        (for/or ([fx (in-list front-depot-xs)]
                                 [fy (in-list front-depot-ys)])
                          (define ddx (fl- ux fx))
                          (define ddy (fl- uy fy))
                          (fl<= (fl+ (fl* ddx ddx) (fl* ddy ddy)) 17.64)))
               (hash-set! seen-transiting-ht uid #t)
               (set! transiting-tags-rev (cons uid transiting-tags-rev)))
             (when (and has-raised?
                        (not (= (hash-ref u 'order-ability-id 0) 18)))
               (define near-raised #f)
               (define near-dx 0.0)
               (define near-dy 0.0)
               (for ([rd (in-list raised-depots)]
                     [dx (in-list raised-depot-xs)]
                     [dy (in-list raised-depot-ys)]
                     #:break near-raised)
                 (define ddx (fl- ux dx))
                 (define ddy (fl- uy dy))
                 (when (fl<= (fl+ (fl* ddx ddx) (fl* ddy ddy)) 12.25)
                   (set! near-raised rd)
                   (set! near-dx dx)
                   (set! near-dy dy)))
               (when near-raised
               (unless (raised-depot-enemy-near? near-raised near-dx near-dy)
                 (set-add! active-stuck-tags uid)
                 (define cnt (add1 (hash-ref stuck-tbl uid 0)))
                 (hash-set! stuck-tbl uid cnt)
                 (when (>= cnt 2)
                   (define on-base-side?
                     (let ([udx (fl- ux base-x-fl)]
                           [udy (fl- uy base-y-fl)]
                           [ddx (fl- near-dx base-x-fl)]
                           [ddy (fl- near-dy base-y-fl)])
                       (fl<= (fl+ (fl* udx udx) (fl* udy udy))
                             (fl+ (fl* ddx ddx) (fl* ddy ddy)))))
                   (define-values (tx ty)
                     (if on-base-side?
                         (let* ([vx (fl- nat-x-fl near-dx)]
                                [vy (fl- nat-y-fl near-dy)]
                                [vn (flmax 1.0 (flsqrt (fl+ (fl* vx vx) (fl* vy vy))))])
                           (values (safe-coord (fl+ near-dx (fl* 4.5 (fl/ vx vn))) nat-x)
                                   (safe-coord (fl+ near-dy (fl* 4.5 (fl/ vy vn))) nat-y)))
                         (let* ([vx (fl- base-x-fl near-dx)]
                                [vy (fl- base-y-fl near-dy)]
                                [vn (flmax 1.0 (flsqrt (fl+ (fl* vx vx) (fl* vy vy))))])
                           (values (safe-coord (fl+ near-dx (fl* 4.5 (fl/ vx vn))) base-x)
                                   (safe-coord (fl+ near-dy (fl* 4.5 (fl/ vy vn))) base-y)))))
                   (l2-emit! ctx (list 'move uid tx ty))
                   (order-ledger-record-issued! oledger uid 'move 'depot-unstick tx ty frame))))))))
       (define transiting-tags (reverse transiting-tags-rev))
       ;; Raise lowered depots early (<= 14.0 tiles, or <= 16.0 vs fast speedlings/reapers/adepts/hellions)
       (for ([d (in-list lowered-depots)]
             #:when (>= (hash-ref d 'build-progress 1.0) SC2-BUILD-COMPLETE-PROGRESS))
         (define did (hash-ref d 'id 0))
         (define dx (exact->inexact (hash-ref d 'x base-x)))
         (define dy (exact->inexact (hash-ref d 'y base-y)))
         (define breach-threat?
           (for/or ([ep (in-list (get-ground-enemy-pts))])
             (define ddx (fl- dx (vector-ref ep 0)))
             (define ddy (fl- dy (vector-ref ep 1)))
             (fl<= (fl+ (fl* ddx ddx) (fl* ddy ddy)) (vector-ref ep 2))))
         (when breach-threat?
           (define vdx (fl- (exact->inexact base-x) dx))
           (define vdy (fl- (exact->inexact base-y) dy))
           (define vd (flmax 1.0 (flsqrt (fl+ (fl* vdx vdx) (fl* vdy vdy)))))
           (define move-tx (safe-coord (+ dx (* 3.5 (/ vdx vd))) base-x))
           (define move-ty (safe-coord (+ dy (* 3.5 (/ vdy vd))) base-y))
           (define any-blocking? #f)
           (for ([u (in-list ally-units)])
             (define uid (hash-ref u 'id #f))
             (when (and (exact-integer? uid)
                        (> uid 0)
                        (not (or (eq? (hash-ref u 'is-flying #f) #t)
                                 (eq? (hash-ref u 'flying? #f) #t))))
               (define ddx (fl- (exact->inexact (hash-ref u 'x base-x)) dx))
               (define ddy (fl- (exact->inexact (hash-ref u 'y base-y)) dy))
               (when (fl<= (fl+ (fl* ddx ddx) (fl* ddy ddy)) 2.4025)
                 (set! any-blocking? #t)
                 (l2-emit! ctx (list 'move uid move-tx move-ty)))))
           (when (and (not any-blocking?)
                      (> did 0)
                      (refractory-allow-action?! cd-tracker (list 'depot-raise did) frame 12))
             (l2-emit! ctx (list 'cast-spell did 'morph-supply-depot-raise)))))
       ;; Lower raised depots ONLY when friendly units need transit and NO ground enemy is within 15.0 (17.0 vs fast)
       (when (not (null? transiting-tags))
         (for ([rd (in-list raised-depots)]
               #:when (>= (hash-ref rd 'build-progress 1.0) SC2-BUILD-COMPLETE-PROGRESS))
           (define did (hash-ref rd 'id 0))
           (define dx (hash-ref rd 'x base-x))
           (define dy (hash-ref rd 'y base-y))
           (define enemy-within-safe-door? (raised-depot-enemy-near? rd dx dy))
           (when (and (not enemy-within-safe-door?)
                      (> did 0)
                      (refractory-allow-action?! cd-tracker (list 'depot-lower did) frame 24))
             (l2-emit! ctx (list 'cast-spell did 'morph-supply-depot-lower)))))
       (when (positive? (hash-count stuck-tbl))
         (for ([k (in-list (hash-keys stuck-tbl))])
           (unless (set-member? active-stuck-tags k)
             (hash-remove! stuck-tbl k))))
       (hash-set! door-st 'transiting-tags transiting-tags)
       (hash-set! door-st 'state
                  (cond
                    [(and (not (null? lowered-depots)) (null? raised-depots)) 'open]
                    [(and (not (null? lowered-depots)) (= (set-count active-stuck-tags) 0)) 'open]
                    [else 'closed])))
  (void))

