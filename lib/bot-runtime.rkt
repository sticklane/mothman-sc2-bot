;; Checks all SC2 HARVEST_RETURN ability IDs (167 MULE, 296 SCV, 299 Probe, 1184 Drone, 3667 generic);
;; note 295/298/1183/3666 are HARVEST_GATHER so empty-handed miners walking to patches stay non-carrying.
(define HARVEST-RETURN-ABILITY-IDS '(167 296 299 1184 3667))
(define HARVEST-RETURN-ABILITY-SYMS
  '(harvest-return harvest-return-drone harvest-return-scv harvest-return-probe))
(define GAS-TARGET-TYPE-SYMS
  '(vespene-geyser rich-vespene-geyser space-platform-geyser protoss-vespene-geyser
    purifiers-vespene-geyser shakuras-vespene-geyser extractor assimilator refinery))

(define (worker-list-has-set-member? xs st)
  (and (list? xs)
       (for/or ([x (in-list xs)])
         (set-member? st x))))

(define (worker-carrying-minerals-or-gas? w)
  (and (hash? w)
       (or (eq? (hash-ref w 'carrying-minerals? #f) #t)
           (eq? (hash-ref w 'carrying-resource? #f) #t)
           (eq? (hash-ref w 'carrying? #f) #t)
           (eq? (hash-ref w 'carrying-cargo? #f) #t)
           (eq? (hash-ref w 'has-cargo? #f) #t)
           (let ([ab-id (hash-ref w 'order-ability-id 0)])
             (and (exact-integer? ab-id)
                  (memv ab-id HARVEST-RETURN-ABILITY-IDS)
                  #t))
           (let ([ab-sym (hash-ref w 'order-ability-sym #f)])
             (and ab-sym (memq ab-sym HARVEST-RETURN-ABILITY-SYMS) #t))
           (let ([ab-sym2 (hash-ref w 'order-ability #f)])
             (and ab-sym2 (memq ab-sym2 HARVEST-RETURN-ABILITY-SYMS) #t))
           (worker-list-has-set-member? (hash-ref w 'buffs #f) CARRYING-BUFF-SYMS)
           (worker-list-has-set-member? (hash-ref w 'buff-ids #f) CARRYING-BUFF-SYMS)
           (let ([ords (hash-ref w 'orders #f)])
             (and (pair? ords)
                  (hash? (car ords))
                  (let* ([o0 (car ords)]
                         [oid (or (hash-ref o0 'ability_id #f)
                                  (hash-ref o0 'ability-id 0))]
                         [osym (or (hash-ref o0 'ability-sym #f)
                                   (hash-ref o0 'ability #f))])
                    (or (and (exact-integer? oid) (memv oid HARVEST-RETURN-ABILITY-IDS))
                        (and osym (memq osym HARVEST-RETURN-ABILITY-SYMS)))))))))

(define (worker-harvesting-gas? w)
  (and (hash? w)
       (or (eq? (hash-ref w 'on-gas? #f) #t)
           (eq? (hash-ref w 'harvesting-gas? #f) #t)
           (eq? (hash-ref w 'resource-kind #f) 'gas)
           (and (memq (hash-ref w 'role #f) '(gas geyser extractor assimilator refinery gas-harvester)) #t)
           (and (memq (hash-ref w 'order-target-type #f) GAS-TARGET-TYPE-SYMS) #t)
           (worker-list-has-set-member? (hash-ref w 'buffs #f) CARRYING-GAS-BUFF-SYMS)
           (worker-list-has-set-member? (hash-ref w 'buff-ids #f) CARRYING-GAS-BUFF-SYMS))))

(define (select-far-mineral-patch-non-carrying-worker workers base-x base-y [mineral-patches '()])
  (cond
    [(or (not (list? workers)) (null? workers)) #f]
    [(null? (cdr workers)) (car workers)]
    [else
     (define fbx (if (flonum? base-x) base-x (exact->inexact base-x)))
     (define fby (if (flonum? base-y) base-y (exact->inexact base-y)))
     (define non-carrying
       (for/list ([w (in-list workers)]
                  #:when (and (hash? w) (not (worker-carrying-minerals-or-gas? w))))
         w))
     (define pool0 (if (pair? non-carrying) non-carrying workers))
     (define non-gas
       (for/list ([w (in-list pool0)]
                  #:when (and (hash? w) (not (worker-harvesting-gas? w))))
         w))
     (define cands (if (pair? non-gas) non-gas pool0))
     (define near-patches
       (if (or (not (list? mineral-patches)) (null? mineral-patches))
           '()
           (for/list ([mp (in-list mineral-patches)]
                      #:when (and (hash? mp)
                                  (real? (hash-ref mp 'x #f))
                                  (real? (hash-ref mp 'y #f)))
                      #:when (let* ([mx0 (hash-ref mp 'x 0.0)]
                                    [my0 (hash-ref mp 'y 0.0)]
                                    [mx (if (flonum? mx0) mx0 (exact->inexact mx0))]
                                    [my (if (flonum? my0) my0 (exact->inexact my0))]
                                    [dx (fl- mx fbx)]
                                    [dy (fl- my fby)]
                                    [d2 (fl+ (fl* dx dx) (fl* dy dy))])
                               (fl<= d2 156.25)))
             (define mx0 (hash-ref mp 'x 0.0))
             (define my0 (hash-ref mp 'y 0.0))
             (define mx (if (flonum? mx0) mx0 (exact->inexact mx0)))
             (define my (if (flonum? my0) my0 (exact->inexact my0)))
             (define dx (fl- mx fbx))
             (define dy (fl- my fby))
             (define d (flsqrt (fl+ (fl* dx dx) (fl* dy dy))))
             (define pid (or (hash-ref mp 'id #f) (hash-ref mp 'tag 0)))
             (vector mx my d (if (exact-integer? pid) pid 0)))))
     (define far-patches
       (cond
         [(null? near-patches) '()]
         [else
          (define ge71
            (for/list ([p (in-list near-patches)]
                       #:when (fl>= (vector-ref p 2) 7.1))
              p))
          (if (pair? ge71)
              ge71
              (let* ([sorted (sort near-patches fl> #:key (lambda (p) (vector-ref p 2)))]
                     [half-k (max 1 (quotient (add1 (length sorted)) 2))])
                (take sorted half-k)))]))
     (define-values (best-w _best-score)
       (for/fold ([bw #f] [bsc -inf.0]) ([w (in-list cands)] #:when (hash? w))
         (define wx0 (hash-ref w 'x fbx))
         (define wy0 (hash-ref w 'y fby))
         (define wx (if (flonum? wx0) wx0 (exact->inexact wx0)))
         (define wy (if (flonum? wy0) wy0 (exact->inexact wy0)))
         (define bdx (fl- wx fbx))
         (define bdy (fl- wy fby))
         (define db (flsqrt (fl+ (fl* bdx bdx) (fl* bdy bdy))))
         (define within-135? (fl<= db 13.5))
         (define sc
           (if (null? far-patches)
               (if within-135? (fl+ 1000.0 db) (fl- db))
               (let* ([otgt (or (hash-ref w 'order-target-id #f)
                                (hash-ref w 'order-target-tag 0))]
                      [otgt-int (if (exact-integer? otgt) otgt 0)])
                 (define-values (min-fd on-far-tgt?)
                   (for/fold ([md +inf.0] [tgt? #f]) ([fp (in-list far-patches)])
                     (define fdx (fl- wx (vector-ref fp 0)))
                     (define fdy (fl- wy (vector-ref fp 1)))
                     (define fd (flsqrt (fl+ (fl* fdx fdx) (fl* fdy fdy))))
                     (define pid (vector-ref fp 3))
                     (values (flmin md fd)
                             (or tgt? (and (> pid 0) (= otgt-int pid))))))
                 (fl+ (fl+ (if (fl<= min-fd 2.2) 1000.0 0.0)
                           (if on-far-tgt? 200.0 0.0))
                      (fl+ (if within-135? (fl+ 50.0 db) -50.0)
                           (fl- (fl* 20.0 min-fd)))))))
         (if (or (not bw) (fl> sc bsc))
             (values w sc)
             (values bw bsc))))
     (or best-w (car cands))]))

(define (populate-valid-enemy-tags-and-pos! sanitized-obs [pos-cache #f] #:valid-tags-out [valid-out #f])
  (define raw-eu (hash-ref sanitized-obs 'enemy-units '()))
  (define raw-eb (hash-ref sanitized-obs 'enemy-buildings '()))
  (define valid-enemy-tags
    (cond
      [(hash? valid-out) (hash-clear! valid-out) valid-out]
      [else (make-hasheqv)]))
  (define pos-tbl (if (hash? pos-cache) pos-cache (make-hasheqv)))
  (define (record-enemy-list! xs)
    (when (list? xs)
      (for ([e (in-list xs)] #:when (hash? e))
        (define eid (hash-ref e 'id 0))
        (when (and (exact-integer? eid) (> eid 0))
          (define ex (hash-ref e 'x #f))
          (define ey (hash-ref e 'y #f))
          (when (and (real? ex) (real? ey))
            (define fx (if (flonum? ex) ex (exact->inexact ex)))
            (define fy (if (flonum? ey) ey (exact->inexact ey)))
            (define prev (hash-ref pos-tbl eid #f))
            (unless (and (pair? prev) (fl= (car prev) fx) (fl= (cdr prev) fy))
              (hash-set! pos-tbl eid (cons fx fy))))
          (unless (or (eq? (hash-ref e 'snapshot? #f) #t)
                      (not (eqv? (hash-ref e 'display-type 1) 1))
                      (let ([ehp (hash-ref e 'hp 1)])
                        (not (and (real? ehp) (> ehp 0)))))
            (hash-set! valid-enemy-tags eid #t))))))
  (record-enemy-list! raw-eu)
  (record-enemy-list! raw-eb)
  (values valid-enemy-tags pos-tbl))

(define (ensure-rt-valid-enemy-tags! rt sanitized-obs)
  (define cache (rt-valid-tags-cache rt))
  (define step-cnt (live-bot-runtime-step-count rt))
  (define eu (hash-ref sanitized-obs 'enemy-units '()))
  (define eb (hash-ref sanitized-obs 'enemy-buildings '()))
  (if (or (eq? (vector-ref cache 0) sanitized-obs)
          (and (vector-ref cache 0)
               (eqv? (vector-ref cache 4) step-cnt)
               (eq? (vector-ref cache 2) eu)
               (eq? (vector-ref cache 3) eb)))
      (vector-ref cache 1)
      (let ([ht (vector-ref cache 1)])
        (populate-valid-enemy-tags-and-pos! sanitized-obs (rt-enemy-pos-cache rt) #:valid-tags-out ht)
        (vector-set! cache 0 sanitized-obs)
        (vector-set! cache 2 eu)
        (vector-set! cache 3 eb)
        (vector-set! cache 4 step-cnt)
        ht)))

(define (sanitize-stale-target-actions actions obs
                                       #:pos-cache [pos-cache #f]
                                       #:precomputed-valid-tags [given-valid #f])
  (cond
    [(and given-valid (or (not (list? actions)) (null? actions)))
     '()]
    [else
     (define sanitized-obs (if (hash? obs) obs (hash)))
     (define fallback-ex (exact->inexact (hash-ref sanitized-obs 'enemy-x 140.0)))
     (define fallback-ey (exact->inexact (hash-ref sanitized-obs 'enemy-y 140.0)))
     (define-values (valid-enemy-tags pos-tbl)
       (if given-valid
           (values given-valid (if (hash? pos-cache) pos-cache (make-hasheqv)))
           (populate-valid-enemy-tags-and-pos! sanitized-obs pos-cache)))
     (define (resolve-last-known-pos tid [def-x fallback-ex] [def-y fallback-ey])
       (define pt (hash-ref pos-tbl tid #f))
       (if (pair? pt)
           (values (car pt) (cdr pt))
           (values def-x def-y)))
     (for/list ([act (in-list (if (list? actions) actions '()))])
    (if (not (pair? act))
        act
        (case (car act)
          [(attack attack-unit)
           (let ([r1 (cdr act)])
             (if (and (pair? r1) (pair? (cdr r1)) (null? (cddr r1))
                      (exact-integer? (cadr r1)))
                 (let ([tid (cadr r1)])
                   (if (hash-ref valid-enemy-tags tid #f)
                       act
                       (let-values ([(lx ly) (resolve-last-known-pos tid)])
                         (list 'attack-pos (car r1) lx ly))))
                 act))]
          [(focus-fire)
           (let ([r1 (cdr act)])
             (if (and (pair? r1) (pair? (cdr r1)) (exact-integer? (cadr r1))
                      (list? (cddr r1)))
                 (let ([tid (cadr r1)]
                       [rest (cddr r1)])
                   (if (hash-ref valid-enemy-tags tid #f)
                       act
                       (let-values ([(lx ly)
                                     (if (and (pair? rest) (pair? (cdr rest))
                                              (real? (car rest)) (real? (cadr rest)))
                                         (resolve-last-known-pos tid
                                                                 (exact->inexact (car rest))
                                                                 (exact->inexact (cadr rest)))
                                         (resolve-last-known-pos tid))])
                         (list 'attack-pos (car r1) lx ly))))
                 act))]
          [(clear-gas-steal)
           (let ([r1 (cdr act)])
             (if (and (pair? r1) (pair? (cdr r1)) (pair? (cddr r1)) (null? (cdddr r1))
                      (exact-integer? (car r1)) (real? (cadr r1)) (real? (caddr r1)))
                 (if (hash-ref valid-enemy-tags (car r1) #f)
                     act
                     (list 'clear-gas-steal 0 (exact->inexact (cadr r1)) (exact->inexact (caddr r1))))
                 act))]
          [(pull-workers-attack)
           (let ([r1 (cdr act)])
             (if (and (pair? r1) (pair? (cdr r1)) (pair? (cddr r1)) (pair? (cdddr r1))
                      (null? (cddddr r1))
                      (exact-integer? (cadr r1)) (real? (caddr r1)) (real? (cadddr r1)))
                 (let ([tid (cadr r1)])
                   (if (or (<= tid 0) (hash-ref valid-enemy-tags tid #f))
                       act
                       (list 'pull-workers-attack (car r1) 0 (exact->inexact (caddr r1)) (exact->inexact (cadddr r1)))))
                 act))]
