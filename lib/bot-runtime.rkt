    (define wb-min-x (- w-min-x 7.0))
    (define wb-max-x (+ w-max-x 7.0))
    (define wb-min-y (- w-min-y 7.0))
    (define wb-max-y (+ w-max-y 7.0))
    (define raw-harassers
      (for/list ([e (in-list enemy-units)]
                 #:when (and (hash? e)
                             (memq (fast-canonical-unit-sym (unit-type-sym e)) harasser-syms)
                             (not (eq? (hash-ref e 'is-hallucination #f) #t))
                             (not (eq? (hash-ref e 'hallucination #f) #t))
                             (not (eq? (hash-ref e 'hallucination? #f) #t))
                             (not (eq? (hash-ref e 'changeling? #f) #t))
                             (let ([ex (hash-ref e 'x 9999.0)]
                                   [ey (hash-ref e 'y 9999.0)])
                               (or (for/or ([bc (in-list owned-base-coords)])
                                     (within-dist2? (car bc) (cdr bc) ex ey 90.25 9.5))
                                   (and (>= ex wb-min-x) (<= ex wb-max-x)
                                        (>= ey wb-min-y) (<= ey wb-max-y)
